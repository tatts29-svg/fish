# Secrets - the HTTPS server mints its own certificate+key on first run;
# the key must never be committed or carried in an update zip.
01_Reporting_Suite/Updates/gear_https_cert.pem
*.pem
*.key

# The office-only roster (whole site's names + hire IDs). Never in the
# served Gear_Lookup folder, never in git.
01_Reporting_Suite/People_List/
01_Reporting_Suite/Gear_Lookup/People_List.*
01_Reporting_Suite/Gear_Lookup/Needs_An_ID.csv

# Per-machine state
01_Reporting_Suite/SYNC_FOLDER.txt
01_Reporting_Suite/NO_OUTLOOK.txt
__pycache__/
*.pyc

# Gate codes for the stores team page. These are set on site and live in
# 46_APPLY_UPDATE's PROTECTED list, so they survive updates. They are not
# version-controlled: a code belongs on the machine at the counter, not in
# a repo. Missing files are recreated with defaults by 04_BUILD_MY_GEAR.
01_Reporting_Suite/stores_code.txt
01_Reporting_Suite/manager_code.txt

# Names for SiteIQ "MISC" claim lines - site data typed on site, recreated
# with Andrew's seeded lines by 02 if missing. Data, not code.
01_Reporting_Suite/MISC_CLAIM_NAMES.txt

# The store Zebra's IP and label size - belongs to the machine at the
# counter, recreated with instructions by 55 if missing.
01_Reporting_Suite/zebra_printer.txt
01_Reporting_Suite/ZEBRA_PREVIEW.zpl

# Gear pictures - collected on site, thumbnails rebuilt from them by 04.
# Site data, never in git or update zips.
01_Reporting_Suite/Photos/
01_Reporting_Suite/Photo_Hunt.html
01_Reporting_Suite/Gear_Lookup/thumbs/
01_Reporting_Suite/stocktake_log.json

# Ampol suite (Lytton Refinery) - same rules as K2. Data\previous holds
# yesterday's SiteIQ pulls, backed up by button 12 on whichever machine
# ran it. Per-machine state, not code.
02_Ampol_Reporting_Suite/Data/previous/
