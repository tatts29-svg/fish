     surroundings are missing from a build that has them, which is worse than an error. */
  /* ONE CLOCK, READ ONE WAY. The runtime refuses a time that goes backwards, and it is right to: a scene
     clock that can step back is a scene clock that can play a second of the lap twice. It is easy to hand it
     one by accident, and this did — mount called setTheme with now(), then the first animation
     frame arrived carrying ITS OWN timestamp, taken at the start of that frame and therefore slightly EARLIER.
     Two sources, both monotonic, interleaved into something that is not. So the frame timestamp is ignored and
     every call goes through here, in the order the calls are made. */
  function now() { return performance.now(); }

  function pageData() { try { return (typeof DATA !== 'undefined' && DATA) ? DATA : {}; } catch (e) { return {}; } }
  function pageMotionOff() { try { return typeof motionOff === 'function' ? !!motionOff() : false; } catch (e) { return false; } }

  Q.available = function () {
    if (!window.GC500RT) return 'the runtime is not in this build';
    const D = pageData();
