  const CAR_RADIUS_M = 3.4;
  function carSurfaces(S, frame) {
    const car = S.car; if (!car) return [];
    const line = centreline(S); if (!line) return [];
    const RT = window.GC500RT, GC = window.GC3D.geocar;
    const secs = frame.sceneSeconds;
    const eye = Math.max(Q.camera.eye, clearAt(line, secs / LAP_S));
    const u = secs / LAP_S + carGap(Q.camera, eye) / line.total;
    const here = at01(line, u);
    const step = 6 / line.total;                       /* six metres on, to read which way the road goes */
    const next = at01(line, u + step);
    const model = GC.matrix(here, [next[0] - here[0], next[1] - here[1]], GC.RIDE_M);
    const spin = GC.wheelAngle(secs / LAP_S * line.total);
    const out = [];
    car.groups.forEach(g => {
      const m = g.wheel ? GC.wheelMatrix(model, g.wheel, spin, RT.multiply4) : model;
      out.push({mesh: g.mesh, edgeMesh: g.edgeMesh, material: g.material, model: m,
