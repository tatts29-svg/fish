          const ct=1-2*(j+.5)/sprays,st=Math.sqrt(1-ct*ct),phi=j*2.399963+phase+c*.81,
                cp=Math.cos(phi),sp=Math.sin(phi),
                lobe=1+st*(.18*Math.sin(3*phi+phase+c+ct*1.7)+.08*Math.cos(5*phi-phase+c)+.05*Math.sin(8*phi+ct*9+phase)),
                normalLength=Math.hypot(st*cp/rx,ct/ry,st*sp/rz),normal=[st*cp/rx/normalLength,ct/ry/normalLength,st*sp/rz/normalLength],
                center=[cc[0]+rx*st*cp*lobe+normal[0]*r*.025,cc[1]+ry*ct+h*.025*st*st*Math.sin(3*phi+phase+c)+normal[1]*r*.025,cc[2]+rz*st*sp*lobe+normal[2]*r*.025],
                tangent=[-sp,0,cp],across=[normal[1]*cp,-(normal[2]*sp+normal[0]*cp),normal[1]*sp],
                size=r*(.080+.060*shapeHash(x,z,91+c*12+j)),sun=Math.max(0,normal[0]*KEYT[0]+normal[1]*KEYT[1]+normal[2]*KEYT[2]),
                m=tint*(.36+.64*sun)*(.8+.28*shapeHash(x,z,j+c*40+200));
          for(let leaf=0;leaf<2;leaf++){
