      const fork=[x+lean*.32,y0+h*.40,z],NL=8,NB=4,NC=mid?4:3;
      branch([x,y0,z],fork,r*.105,r*.065);
      for(let c=0;c<NC;c++){
        const top=c===NC-1,ang=phase+c*Math.PI*2/(NC-1),spread=top?.13:.43,
              cc=[x+lean+Math.cos(ang)*r*spread,y0+h*(top?.91:.63)+h*.08*Math.sin(phase+c),z+Math.sin(ang)*r*spread],
              rx=r*(top?.55:.65)*(.88+.18*shapeHash(x,z,80+c)),ry=h*(top?.23:.29),rz=rx*(.74+.25*shapeHash(x,z,50+c)),db=dayTR.nv;
        branch(fork,[cc[0],cc[1]-.10*h,cc[2]],r*.057,r*.027);
        const leafVertex=(theta,phi)=>{
          const st=Math.sin(theta),ct=Math.cos(theta),sp=Math.sin(phi),cp=Math.cos(phi),
                lobe=1+st*(.18*Math.sin(3*phi+phase+c+ct*1.7)+.08*Math.cos(5*phi-phase+c)+.05*Math.sin(8*phi+ct*9+phase)),
                px=cc[0]+rx*st*cp*lobe,py=cc[1]+ry*ct+h*.025*st*st*Math.sin(3*phi+phase+c),pz=cc[2]+rz*st*sp*lobe,
                nx=st*cp/rx,ny=ct/ry,nz=st*sp/rz,nl=Math.hypot(nx,ny,nz)||1,
                sun=Math.max(0,(nx*KEYT[0]+ny*KEYT[1]+nz*KEYT[2])/nl),
                shade=(.43+.57*sun)*(.70+.30*(ct*.5+.5)),
                leaf=.81+.13*Math.sin(phi*4+phase+c+ct*3)+.06*Math.cos(phi*7+ct*11+phase),m=shade*tint*leaf,
                warm=.86+.24*shapeHash(x,z,70+c);
