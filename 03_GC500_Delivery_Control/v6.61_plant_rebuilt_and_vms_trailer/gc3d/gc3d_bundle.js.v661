  }

  /* THE WORDMARK ON THE HOARDING.

     The barrier's face is 3.5 m long and about 0.87 m high — call it four to one — and the texture it is drawn
     with is square. So a letter drawn square in the texture comes out four times wider than it is tall on the
     barrier. The word is therefore drawn SQUEEZED along the texture's width by exactly that ratio, so that the
     stretch the mapping applies puts it back to the right proportions on the thing itself.

     A band at each end of the texture is deliberately left plain: the barrier's capping is aimed at one of
     them, because a wordmark sliced lengthways along a top edge reads as a mistake rather than as branding.

     This is Coates's own name on Coates's own barrier. It is drawn here rather than carried as an image so the
     file edition stays self-contained and nothing has to be fetched for it. */
  const PANEL_ASPECT = 3.5 / (1.00 - 0.13);          /* the hoarding's length against its height */
  function stampWordmark(set, text) {
    const m = set.maps.baseColor, w = m.width, h = m.height, d = m.data;
    let cv;
    try { cv = document.createElement('canvas'); } catch (e) { return false; }
    cv.width = w; cv.height = h;
    const g = cv.getContext('2d', {willReadFrequently: true});
    if (!g) return false;
    g.clearRect(0, 0, w, h);
    /* the glyphs are drawn white on nothing; only where they land is the base colour replaced */
    g.fillStyle = '#ffffff';
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    /* size it to the height it should occupy on the barrier, then squeeze it to survive the stretch */
    const capH = Math.round(h * 0.30);
    /* NORMAL, said out loud. The page's own display face is a slanted condensed one — it is what the big
       figures are set in — and without asking for upright the canvas inherited the slant and put an italic
       Coates on the barrier. The name is not italic. */
    g.font = 'normal 700 ' + capH + 'px Arial, Helvetica, "Liberation Sans", sans-serif';
    let wide = 0;
    try { wide = g.measureText(text).width; } catch (e) { wide = capH * text.length * 0.55; }
    if (!(wide > 0)) return false;
    const want = w * 0.62;                              /* how much of the panel the word should take */
    const squeeze = Math.min(want / wide, want / (wide * PANEL_ASPECT) * PANEL_ASPECT);
    g.setTransform(squeeze, 0, 0, 1, w / 2, h / 2);
    g.fillText(text, 0, 0);
    g.setTransform(1, 0, 0, 1, 0, 0);
    let px;
    try { px = g.getImageData(0, 0, w, h).data; } catch (e) { return false; }
    /* the plain bands the capping is aimed at, and a margin so no glyph touches an edge */
    const keepOut = y => (y / h) < 0.12 || (y / h) > 0.88;
    let drawn = 0;
    for (let y = 0; y < h; y++) {
      if (keepOut(y)) continue;
      for (let x = 0; x < w; x++) {
        const i = (y * w + x) * 4, a = px[i + 3];
        if (!a) continue;
        const t = a / 255;
        /* the hoarding's print is white; the orange beneath keeps its own light and shade through the blend */
        /* the print is white paint on the same hoarding, so it reflects like paint rather than glowing: a
           little over twice the orange it sits on, not a channel pinned at 255 */
        d[i]     = Math.round(d[i]     * (1 - t) + 150 * t);
        d[i + 1] = Math.round(d[i + 1] * (1 - t) + 149 * t);
        d[i + 2] = Math.round(d[i + 2] * (1 - t) + 146 * t);
        drawn++;
      }
    }
    cv.width = 1; cv.height = 1;
    return drawn > 0;
  }

  /* The hoarding panel as a picture, for looking at. A wordmark is either right or it is not, and squinting at
     it from a moving camera two hundred metres away is not how you tell. This makes the same panel the scene
     makes and hands it back as an image, so it can be checked on its own. */
  Q.hoardingPanel = function (width) {
    const RT = window.GC500RT; if (!RT) return null;
    const set = RT.generateMaterialTextureSet('barrier-concrete', {width: width || 512, seed: 907});
    tintBaseColour(set, RT.COATES_ORANGE_HEX);
    const ok = stampWordmark(set, 'Coates');
    const m = set.maps.baseColor, cv = document.createElement('canvas');
    cv.width = m.width; cv.height = m.height;
    const g = cv.getContext('2d');
    const im = g.createImageData(m.width, m.height);
    im.data.set(m.data);
    g.putImageData(im, 0, 0);
    return {stamped: ok, url: cv.toDataURL('image/png')};
  };

  /* v5.64 — HOW BIG THE MATERIALS ARE, DECIDED BY THE DEVICE. GC500 Showcase Review, 22 Sep 2026, S5:
     "Add a measured phone texture tier and generate/load only what that tier needs."

     Every material here is generated on the device at mount, synchronously, in the frame the showcase opens
     in. At 512 that is ten sets of six RGBA8 maps — about 60 MiB of plain JavaScript arrays before a single
     byte reaches the GPU — and on a phone that is both the memory and the pause the reader feels.

     So the size is MEASURED rather than assumed. Two numbers the browser actually reports are used, and
     neither is a guess about the model of handset:

       · navigator.deviceMemory — the device's RAM in GiB, rounded by the browser to 0.25, 0.5, 1, 2, 4 or 8.
         Chrome and the Android browsers report it; Safari does not.
       · navigator.hardwareConcurrency — the number of cores. Safari does report this one, on the iPhone as
         well, which is why it is not merely a fallback.

     EITHER number saying small is enough. Not both: they are reported by different browsers, so requiring
     both would mean no phone ever qualified on Safari and none on a machine that reports only memory. Four
     GiB or less, or four cores or fewer, is the smaller tier. Where the browser reports neither, the full tier
     stands — an unknown device is not assumed to be small. A slow machine that reports plenty of memory and
     few cores gets the smaller tier too, which is the right way round: cores are what generate these.

     256 is a quarter of the pixels and therefore a quarter of the bytes — about 16 MiB rather than 61, and
     about a quarter of the time — for material detail seen at a distance from a camera that never stops
     moving. The 1024 tier the runtime ships is still not used here; that belongs with close-up tile residency
     and is listed as its own piece of work. */
  function textureTier() {
    const n = typeof navigator === 'object' ? navigator : null;
    const mem = n && typeof n.deviceMemory === 'number' ? n.deviceMemory : 0;
    const cores = n && typeof n.hardwareConcurrency === 'number' ? n.hardwareConcurrency : 0;
    return (mem > 0 && mem <= 4) || (cores > 0 && cores <= 4) ? 256 : 512;
  }
  Q.textureTier = textureTier;
  /* WHAT IT COST, RECORDED RATHER THAN ESTIMATED. The review could only count the allocation out of the
     source. These are the real numbers from the device that did it, so a phone measurement is a reading and
     not an inference — and so a test can prove that changing appearance no longer repeats the work. */
  Q.stats = {mounts: 0, materialBytes: 0, materialMs: 0, tier: 0, lookChanges: 0};

  Q.mount = function (canvas, look) {
    const why = Q.available();
    if (why) return why;
    const RT = window.GC500RT;
    const c = context(canvas);
    if (c.err) return c.err;
    const gl = c.gl;
    const D = pageData();
    const gf = D.geoFrame;

    let built, tree;
    try {
      built = G.tiles.tree(D.surrounds, gf, (D.circuit && D.circuit.ring) || null);
      tree = built.tree;
    } catch (e) { return 'the surroundings could not be read: ' + (e && e.message || e); }

    const w = Math.max(1, canvas.width | 0), h = Math.max(1, canvas.height | 0);
    let pipeline;
    /* The shadow map at 2048 rather than 1024: at 600 m of covered foreground that is about 0.3 m to a texel,
       which is the difference between a building's shadow having an edge and having a staircase. */
    try { pipeline = new RT.WebGLShowcasePipeline(gl, w, h, 2048); }
    catch (e) { return String(e && e.message || e); }

    /* The materials are generated on the device from the runtime's own generator and seed — the same code that
       made the supplied PNGs — so the look is the supplied one and the page carries no texture bytes for it. */
    const materials = new Map();
    const TIER = textureTier();
    const t0 = now();
    try {
      /* 512 on a device that can carry it, 256 on one the browser says is phone-class — see textureTier
         above. The runtime ships a 1024 tier as well and it is genuinely better close up, but all of these are
         generated here on the device at mount, and 1024 is four times the pixels of the largest tier used here
         for a difference nobody sees at the distance this camera keeps. The 1024 tier belongs with close-up
         tile residency, which is a piece of work in its own right and is listed as one rather than half-done. */
      RT.MATERIAL_KINDS.forEach(k => materials.set(k, RT.generateMaterialTextureSet(k, {width: TIER})));
      /* THE ORANGE ALONG THE TOP OF THE BARRIERS.

         The runtime authors six materials and none of them is painted concrete, which is what the top of a
         barrier at this event is. Rather than invent a material and a microtexture to go with it, the concrete
         one is generated and its BASE COLOUR ALONE is re-tinted — so the roughness, the normal and the
         occlusion are still the runtime's own authored concrete, which is exactly what painted concrete is
         underneath the paint. The hex is the runtime's own COATES_ORANGE_HEX, not a second copy of it kept
         here to drift out of step with it. */
      const capSet = RT.generateMaterialTextureSet('barrier-concrete', {width: TIER, seed: 907});
      tintBaseColour(capSet, RT.COATES_ORANGE_HEX);
      /* and the name on it. If the browser will not draw text into a canvas the hoarding stays plain orange,
         which is what it was before and is no worse than it was. */
      S_WORDMARK = stampWordmark(capSet, 'Coates');
      materials.set('barrier-coates', capSet);
      /* THREE MORE FACADES, SO THE SKYLINE IS NOT ONE BUILDING REPEATED.

         The authored facade lights about seven windows in ten, in a pattern three wide and four high that
         repeats up the whole tower. One material means every tower in the city has the same windows lit in the
         same places — which, along with every floor lining up, is the thing that makes a generated skyline look
         generated. Three more are made at other seeds, and each has some of its window cells switched off
         entirely, so one building is half dark, another nearly full, a third somewhere between. Nothing here
         observes or infers anybody's actual lighting; the runtime's own description of this material says the
         same, and it travels with the material. */
      [['building-facade-b', 2411, 0.55], ['building-facade-c', 7717, 0.30], ['building-facade-d', 5153, 0.80]]
        .forEach(v => {
          const set = RT.generateMaterialTextureSet('building-facade', {width: TIER, seed: v[1]});
          darkenWindows(set, v[1], v[2]);
          materials.set(v[0], set);
        });
      /* THE CAR'S LAMPS. Nothing in the runtime's six emits on its own account — the facade's emission is a
         window mask, which is a pattern of lit rectangles and not a lamp. So two more are made from the facade
         set with the mask turned fully on and the base colour taken to white and to red. Headlights at night
         are half of what makes a picture of a night race look like one. */
      [['car-lamp-white', '#FFF1DC'], ['car-lamp-red', '#FF2D1A']].forEach(v => {
        const set = RT.generateMaterialTextureSet('building-facade', {width: 128, seed: 61});
        const d = set.maps.emissionMask.data;
        for (let i = 0; i < d.length; i += 4) { d[i] = d[i + 1] = d[i + 2] = 255; }
        tintBaseColour(set, v[1]);
        materials.set(v[0], set);
      });
    } catch (e) { pipeline.dispose && pipeline.dispose(); return 'the materials could not be made: ' + (e && e.message || e); }
    /* the reading, taken here rather than reasoned about later */
    let bytes = 0;
    materials.forEach(set => { const m = set.maps;
      for (const k in m) { const map = m[k]; if (map && map.data && map.data.length) bytes += map.data.length; } });
    Q.stats.materialBytes = bytes; Q.stats.materialMs = Math.round(now() - t0); Q.stats.tier = TIER;
    Q.stats.mounts++;

    const S = {gl, canvas, pipeline, built, tree, look: look || 'dark', status: null,
               w, h, line: undefined, thDeg: (gf.registration && gf.registration.th_deg) || 0,
               lost: false, last: 0, paused: false, settled: false};

    const adapter = new RT.WebGLTileAdapter(pipeline, {
      materials,
      onStatus: sel => { S.status = sel; },
      renderOptions: frame => renderOptionsFor(S, frame),
    });

    /* THE CAR GOES IN BESIDE THE CITY, NOT INSIDE IT.

       The tiles are streamed: they come and go as the camera moves, and a car that came and went with them
       would be a car that disappears. It is not a tile. It is uploaded once at mount and drawn every frame
       alongside whatever tiles are resident, which is what the pipeline's surface list is for.

       The adapter assembles that list from the tiles and hands it straight to the pipeline, so its draw is
       replaced here with one that does the same thing and appends the car. Nothing in the runtime is edited —
       this is the page deciding what goes in its own frame, which is the page's business. */
    try { S.car = buildCar(pipeline, materials); }
    catch (e) { S.car = null; console.warn('geospatial circuit backdrop: no car — ' + (e && e.message || e)); }
    try { S.grid = buildGrid(pipeline, materials, {min: built.frame.min, max: built.frame.max}); }
    catch (e) { S.grid = null; console.warn('geospatial circuit backdrop: no grid — ' + (e && e.message || e)); }
    const drawTiles = (frame, resources, selection) => {
      S.status = selection;
      pipeline.render(Object.assign(renderOptionsFor(S, frame), {
        frame, surfaces: resources.flatMap(r => r.surfaces).concat(carSurfaces(S, frame))
          .concat(S.grid && frame.theme.currentVisualTheme === 'TRON' ? [S.grid] : []),
      }));
    };
    adapter.draw = drawTiles;

    const emb = embeddedAssets(built, tree, D.surrounds);
    const requests = emb.requests;
    const loader = new RT.AssetLoader({fetch: emb.fetch, concurrency: 3,
                                       cacheBytes: 24 * 1024 * 1024, timeoutMs: 8000});
    let runtime;
    try {
      runtime = new RT.ShowcaseRuntime({
        root: tree, assets: requests, adapter, site: SITE, loader,
        lod: {maxScreenSpaceError: 18, maxResidentTiles: 24, maxResidentTriangles: 260000, maxNewRequests: 3},
        reducedMotion: pageMotionOff(),
      });
    } catch (e) { pipeline.dispose && pipeline.dispose(); return 'the runtime refused to start: ' + (e && e.message || e); }

    S.adapter = adapter; S.loader = loader; S.runtime = runtime;
    runtime.setTheme(S.look === 'tron' ? 'TRON' : 'REALISTIC', now());
    canvas.addEventListener('webglcontextlost', onLost, false);
    S.onLost = onLost;
    /* A LOST CONTEXT IS NOT A BROKEN DEVICE, and until now it was treated as one.
       The page's retry is deliberate on purpose: a machine that could not hold the scene will not hold it
       because the page asked again, and on a phone that costs battery for nothing. That reasoning is right for
       a CAPABILITY failure — no WebGL2, a frame rate the device cannot keep. It is wrong for a lost context,
       which is a transient event the browser recovers from by itself: a driver reset, a laptop switching from
       its discrete GPU to its integrated one, another application taking the GPU, a tab backgrounded long
       enough to be reclaimed. `webglcontextrestored` is the browser saying it is ready again.
       Before this, that event had no listener at all, so the circuit backdrop went away for the rest of the
       session and only a page reload brought it back. That is the "it stops every now and then". */
    if (!canvas.__geoRestore) {
      canvas.__geoRestore = function () {
        Q.lost = false;
        if (/context was lost/i.test(String(Q.failed || ''))) Q.failed = null;
        try { if (typeof Q.onRestored === 'function') Q.onRestored(); } catch (e) {}
      };
      canvas.addEventListener('webglcontextrestored', canvas.__geoRestore, false);
    }
    Q.S = S; Q.built = built; Q.failed = null;
    /* ONE CLOCK, ONE LOOP. The runtime owns the scene clock — pace, pause, reduced motion and hidden time are
       all its arithmetic, and nothing here keeps a second copy of the time. This loop does one thing: ask for a
       frame. It belongs to the mount, so it starts with the scene and stops with it, and it never outlives the
       canvas it draws into. */
    S.raf = requestAnimationFrame(function tick() {
      if (Q.S !== S) return;                       /* unmounted, or another scene took over: stop, silently */
      S.raf = requestAnimationFrame(tick);
      if (!S.canvas.isConnected) { Q.unmount(); return; }
      Q.frame();                                    /* the frame's own timestamp is deliberately not used */
    });
    return 'mounted';

    /* preventDefault is what asks the browser to restore the context rather than leave it dead. The scene is
       released because everything in it belonged to a context that no longer exists; the canvas keeps its
       restore listener, because the canvas is the page's and outlives the scene. */
    function onLost(ev) {
      ev.preventDefault();
      S.lost = true; Q.lost = true;
      Q.failed = 'the graphics context was lost';
      Q.unmount();
    }
  };

  /* WHERE THE CAMERA IS, and separately, WHAT THE SKY IS DOING.

     They are two functions because the runtime needs them at two different moments: it picks which tiles to
     draw from the camera BEFORE it advances the frame, and it asks for the render options DURING, once it has
     worked out where the sun and moon are. Both are computed from the same scene clock, so they describe the
     same instant and cannot drift apart. The earlier version of this called one function twice and fed the
     first call a made-up sky to get through it, which is the sort of thing that works and then quietly stops
     being true. */

  /* THE CAMERA FLIES THE CIRCUIT.

     The first version orbited the bounding box of the OpenStreetMap download — 6.8 km of coast — from nearly
     three kilometres out. Everything was in frame and nothing was worth looking at: the towers were a thin
     bright strip across the middle of the picture. A backdrop is not a map. It is a shot.

     So the camera runs the lap, low, looking ahead down the road, and lets the city come past it. The line is
     the circuit's own centreline from the key plan — the same ring the flat drawing under it is made from —
     resampled to even spacing so the speed is steady through the corners instead of racing the straights and
     crawling the hairpins. */
  const LAP_S = 78;                  /* seconds for one lap at pace 1 */
  /* Where the camera sits, in one place and adjustable while it runs. The defaults are: high enough to keep the
     towers in frame, low enough that the barriers along the road are something you can see rather than a
     texture. Q.camera is the same three numbers, live, so a look can be judged without a rebuild. */
  /* THE SHOT IS A CHASE, NOT A SURVEY.

     The first arrangement put the camera fifteen metres up and the car ninety metres down the road, which is
     an aerial of a circuit with a car somewhere in it — about fifty pixels of car in a sixteen-hundred pixel
     frame. The reference is a camera sitting just behind and just above the car with the city rising in front
     of it, so that is what this is: four and a half metres up, fifteen metres back, aimed at the roof line.
     The towers are still in the shot — they are two hundred metres tall and the camera is looking along a
     street at them — and the barriers and the fencing are now close enough to be worth having drawn. */
  Q.camera = {eye: 4.5, ahead: 12, look: 0.9};
  /* Exposure and bloom, overridable while it runs. Null means the look decides, which is the normal state;
     a number is somebody judging a look with their own eyes, which is how these were set in the first place. */
  Q.tune = {exposure: null, bloom: null, fog: null, fogDensity: null};
  let S_WORDMARK = false;            /* whether the name actually landed on the hoarding this mount */
  Q.wordmark = () => S_WORDMARK;

  /* The centreline, in the scene's metres, evenly spaced. Built once per mount. */
  function centreline(S) {
    if (S.line) return S.line;
    const D = pageData(), fr = S.built.frame;
    const ring = (D.circuit && D.circuit.ring) || {};
    const toM = p => [(p[0] - fr.cx) * fr.m, (p[1] - fr.cz) * fr.m];
    const outer = (ring.outer || []).map(toM), inner = (ring.inner || []).map(toM);
    let pts = [];
    if (outer.length > 8 && inner.length > 8) {
      /* the middle of the road: each outer point paired with the nearest inner one */
      pts = outer.map(o => {
        let best = inner[0], bd = Infinity;
        for (const q of inner) { const d = (q[0] - o[0]) ** 2 + (q[1] - o[1]) ** 2; if (d < bd) { bd = d; best = q; } }
        return [(o[0] + best[0]) / 2, (o[1] + best[1]) / 2];
      });
    } else if (outer.length > 8) {
      pts = outer;
    }
    if (pts.length < 8) { S.line = null; return null; }
    /* The ring is a traced contour with forty-five corners in three kilometres, so a corner is one point
       carrying the whole turn — and a camera flown straight off that does not corner, it flicks. The same
       rounding the barriers get is applied here, from the same function, so the camera and the barrier it
       flies past are describing the same curve. */
    if (G.tiles && G.tiles.roundLoop) {
      pts = G.tiles.roundLoop(G.tiles.roundLoop(G.tiles.roundLoop(pts, 9), 4.5), 2.25);
    }
    /* even spacing, so the speed does not change with how closely the drawing happened to be drawn */
    const cum = [0];
    for (let i = 1; i <= pts.length; i++) {
      const a = pts[i - 1], b = pts[i % pts.length];
      cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));
    }
    const total = cum[cum.length - 1];
    const N = 512, even = [];
    for (let k = 0; k < N; k++) {
      const want = total * k / N;
      let i = 1; while (i < cum.length && cum[i] < want) i++;
      const a = pts[(i - 1) % pts.length], b = pts[i % pts.length];
      const seg = cum[i] - cum[i - 1] || 1;
      const t = (want - cum[i - 1]) / seg;
      even.push([a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]);
    }
    S.line = {pts: even, total};
    S.line.clear = clearance(S, S.line);
    return S.line;
  }

  /* THE CAMERA MUST NOT END UP STARING AT A WALL, and on this circuit it will unless it is told not to.

     Surfers Paradise is a street circuit. The towers are ON the road — six or eight metres back from where the
     barrier stands — and the corners are square. A camera flown down the centreline at a fixed height, aiming
     a fixed distance ahead, spends a good part of the lap pointed straight into the side of a building across
     a corner, which fills the frame with a wall and puts none of the circuit in the shot. That is what the
     first attempt showed.

     Two things are checked and both come from the same grid of heights. The camera's own spot must be clear —
     it must never be inside a footprint — and the NEAR part of what it is looking at must be clear too, so the
     shot opens onto road rather than onto masonry. Only the near part: something blocking the far end of the
     sightline is a building at the end of a street, which is what a street looks like and is not a fault.

     Where the near view is blocked the eye lifts just enough to see over it, capped, and the lift is smoothed
     over about a hundred metres of road so the camera rises before it arrives rather than jumping when it
     does. What comes out is a camera that runs at street height for most of the lap — which is where the
     barriers and the fencing are worth looking at — and lifts over the few places it has to. */
  const SIGHT_NEAR = 0.9;            /* how far along the sightline has to be clear */
  const SIGHT_MARGIN = 4;            /* and by how much, in metres */
  /* The caps are low now and that is deliberate. With the car fifteen metres ahead, a building further down
     the street is the BACKDROP — it is what the shot is meant to have in it — so the camera has no business
     climbing to see over it. All the lift is still here to do is keep the camera out of masonry, which on a
     road that is eight metres from the nearest wall it almost never has to. */
  const SIGHT_CAP = 20;              /* the highest the camera will climb to see over what is dead ahead */
  const SIGHT_STEPS = 16;
  /* A SHOT IS A CONE, NOT A LINE. Checking only the line to the aim point left the camera standing beside a
     hundred-and-fifty-metre tower with the road perfectly clear ahead of it and the tower filling half the
     frame — technically correct and a bad photograph. So two more rays are checked, twenty degrees off each
     side, which is about the inner half of what a fifty-degree lens actually sees. They are allowed to lift
     the camera less far than the one dead ahead: a tower at the edge of frame is scenery, and it is the one in
     the middle that ruins the shot. */
  const SIGHT_FAN = Math.tan(20 * Math.PI / 180);
  const FAN_SIDE_M = 12;             /* and never narrower than this, or a wall right beside it is missed */
  const FAN_CAP = 14;
  const SMOOTH_M = 90;               /* the road length the climb is spread over */
  function clearance(S, line) {
    const n = line.pts.length, raw = new Float64Array(n);
    const G = window.GC3D;
    if (!(G && G.tiles && G.tiles.heightField && S.built)) return raw;
    const field = G.tiles.heightField(S.built), C = Q.camera;
    const ahead = C.ahead / line.total;
    for (let k = 0; k < n; k++) {
      const u = k / n, here = at01(line, u), aim = at01(line, u + ahead);
      /* its own spot first: whatever it is standing in, it goes above */
      let need = field.at(here[0], here[1]);
      if (need > 0) need += SIGHT_MARGIN;
      const fx = aim[0] - here[0], fz = aim[1] - here[1], fl = Math.hypot(fx, fz) || 1;
      const sx = -fz / fl, sz = fx / fl;                        /* across the direction of travel */
      for (let r = -1; r <= 1; r++) {
        const cap = r === 0 ? SIGHT_CAP : FAN_CAP;
        for (let i = 1; i <= SIGHT_STEPS; i++) {
          const t = SIGHT_NEAR * i / SIGHT_STEPS;
          /* proportional far out, a fixed width close in: a tower fifteen metres to the side at twenty metres
             ahead is a wall across half the frame, and a purely proportional fan walks straight past it */
          const off = Math.max(FAN_SIDE_M, fl * t * SIGHT_FAN) * r;
          const h = field.at(here[0] + fx * t + sx * off, here[1] + fz * t + sz * off);
          if (h <= 0) continue;
          /* the height the eye must be at for the straight line to the aim point to pass over this */
          const e = Math.min(cap, (h + SIGHT_MARGIN - C.look * t) / (1 - t));
          if (e > need) need = e;
        }
      }
      raw[k] = need;
    }
    /* a circular running maximum, then a circular mean: the climb becomes a curve that starts early */
    const w = Math.max(1, Math.round(SMOOTH_M / (line.total / n)));
    const peak = new Float64Array(n);
    for (let i = 0; i < n; i++) {
      let m = 0;
      for (let d = -w; d <= w; d++) { const v = raw[(i + d + n * 2) % n]; if (v > m) m = v; }
      peak[i] = m;
    }
    const out = new Float64Array(n);
    for (let i = 0; i < n; i++) {
      let sum = 0;
      for (let d = -w; d <= w; d++) sum += peak[(i + d + n * 2) % n];
      out[i] = sum / (2 * w + 1);
    }
    return out;
  }
  /* How far up the road the car is. At street height it is the camera's own look-ahead; the higher the camera
     has had to climb, the further out it goes, so the angle down onto it stays a shot rather than a survey. */
  function carGap(C, eye) { return C.ahead * (1 + Math.max(0, eye - C.eye) / 12); }

  /* the clearance at a point on the lap, read the same way the position is */
  function clearAt(line, u) {
    const c = line.clear; if (!c || !c.length) return 0;
    const n = c.length, f = ((u % 1) + 1) % 1 * n, i = Math.floor(f), t = f - i;
    return c[i % n] + (c[(i + 1) % n] - c[i % n]) * t;
  }

  const at01 = (line, u) => {
    const n = line.pts.length;
    const f = ((u % 1) + 1) % 1 * n;
    const i = Math.floor(f), t = f - i;
    const a = line.pts[i % n], b = line.pts[(i + 1) % n];
    return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
  };

  function eyeAt(S, seconds) {
    const b = S.tree.bounds;
    const line = centreline(S);
    if (!line) {
      /* no ring on this page: fall back to an orbit, close in rather than out at the edge of the download */
      const cx = (b.min[0] + b.max[0]) / 2, cz = (b.min[2] + b.max[2]) / 2;
      const a = (seconds / LAP_S) * Math.PI * 2, r = 900;
      return {eye: [cx + Math.cos(a) * r, 220, cz + Math.sin(a) * r], at: [cx, 30, cz], span: 2600, bounds: b};
    }
    const C = Q.camera;
    const u = seconds / LAP_S;
    const here = at01(line, u);
    /* street height where the street is clear, above the roofline where it is not */
    const eye = Math.max(C.eye, clearAt(line, u));
    /* THE CAMERA LOOKS AT THE CAR, and the car is what it is following.

       Aiming at a fixed distance down the road put the car at the very bottom of the frame — correct by the
       arithmetic and wrong as a shot. A chase camera looks at the thing it is chasing. So the aim point is
       where the car is, and when the camera has had to climb over something the car is placed further ahead,
       which brings the shot back towards level instead of turning it into a plan view of a roof. */
    const gap = carGap(C, eye);
    const car = at01(line, u + gap / line.total);
    /* THROUGH A HAIRPIN THE CAR IS BESIDE THE CAMERA, NOT IN FRONT OF IT.

       Twelve metres up the road, at a corner of a hundred and thirty degrees, is twelve metres round the bend —
       so the camera swings sideways and, because it is above the car, steeply down. What that produces is a
       near-plan view of a roof with the towers leaning in at the edges of a ninety-degree lens. It is not a
       fault in the arithmetic; it is the arithmetic being asked for something nobody would shoot.

       Two guards. The aim point is put a little BEYOND the car rather than on it, which keeps the view pointed
       along the road instead of across the corner; and the shot is not allowed to tilt further down than about
       twenty degrees, by lifting the aim rather than dropping the camera — so the horizon stays where a person
       holding a camera would keep it. */
    const past = at01(line, u + (gap + 14) / line.total);
    const aim = [(car[0] + past[0]) / 2, (car[1] + past[1]) / 2];
    let dx = aim[0] - here[0], dz = aim[1] - here[1];
    let horiz = Math.hypot(dx, dz);
    if (horiz < 6) {                          /* doubled back on itself: point along the road, not at the car */
      const ahead = at01(line, u + 0.004);
      dx = ahead[0] - here[0]; dz = ahead[1] - here[1];
      horiz = Math.hypot(dx, dz) || 1;
      aim[0] = here[0] + dx / horiz * 12; aim[1] = here[1] + dz / horiz * 12; horiz = 12;
    }
    let look = C.look + (eye - C.eye) * 0.22;
    const drop = horiz * 0.38;                /* about twenty degrees, which is a shot rather than a survey */
    if (eye - look > drop) look = eye - drop;
    return {eye: [here[0], eye, here[1]], at: [aim[0], look, aim[1]], gap,
            span: Math.max(1200, line.total / 2), bounds: b};
  }

  const FOV = 50 * Math.PI / 180;
  const SHADOW_M = 600;                   /* the shadowed foreground, in metres: about 0.6 m to a texel at 1024 */

  function viewOf(S, seconds) {
    const RT = window.GC500RT, e = eyeAt(S, seconds);
    const view = RT.lookAt(e.eye, e.at, [0, 1, 0]);
    const proj = RT.perspective(FOV, S.w / Math.max(1, S.h), 1.5, Math.max(4000, e.span * 2.5));
    return {e, vp: RT.multiply4(proj, view)};
  }

  /* The camera the tile selector reads. Position and frustum only: no sky, nothing that needs the almanac. */
  function lodCamera(S, seconds) {
    const RT = window.GC500RT, v = viewOf(S, seconds);
    return {position: v.e.eye, verticalFovRadians: FOV, viewportHeight: S.h, near: 2,
            frustum: RT.frustumFromWebGLMatrix(v.vp)};
  }

  /* The render options, with the real sun and moon for this frame. */
  function renderOptionsFor(S, frame) {
    const RT = window.GC500RT;
    const v = viewOf(S, frame.sceneSeconds);
    const b = v.e.bounds;
    const sun = frame.astronomy.sun, moon = frame.astronomy.moon;
    const sunDir = toScene(sun.azimuthDegrees, sun.elevationDegrees, S.thDeg);
    const moonDir = toScene(moon.azimuthDegrees, moon.elevationDegrees, S.thDeg);
    const wts = frame.astronomy.artisticLightWeights;
    /* THE SHADOW FOLLOWS WHICHEVER BODY IS ACTUALLY LIGHTING THE SCENE — the runtime's own rule — and the same
       direction must be used for the shadow as for the light, or the shadows fall somewhere the light is not.

       It is fitted to the FOREGROUND, not to the site. One shadow map spread across 6.8 km of coast is 6.7 m
       to a texel at 1024, which is a building's whole shadow in one step and looks like dirt rather than
       shade. SHADOW_M is the region under the camera's gaze; the rest of the site is lit but unshadowed, which
       at that distance is indistinguishable and costs nothing. */
    const primary = (wts && wts.sun > 0.01) ? sunDir : moonDir;
    const shadowVP = RT.directionalShadowMatrix(v.e.at, primary, SHADOW_M);
    const tron = frame.theme.currentVisualTheme === 'TRON';
    const night = !(wts && wts.sun > 0.01);
    /* SKY AND HAZE, JUDGED AGAINST ANDREW'S OWN REFERENCE PICTURES, 21 Sep 2026.

       Both were wrong in the same way and for the same reason: the haze colour IS the sky, because the
       pipeline clears to it. The day was a pale grey-blue that came out of the tone map almost white, so the
       towers went flat and the type sat on grey — a Gold Coast day is a properly blue sky with the buildings
       dark and bright against it. The night sat at a deep blue that read as dusk rather than night.

       The day is not a guess. sources/brand/coates26_pitlane_run.mp4 is real footage of this pit straight, and
       the sky in it measures 77, 127, 184 in sRGB across four frames — so the scene's sky was rendered at eight
       candidate settings and each one measured the same way, and what is here is the one that came back at
       77, 131, 182. Six counts across three channels, against a photograph of the place. The night was judged
       by eye against Andrew Fisher's reference pictures, there being no night footage to measure.

       The buildings facing the camera are often in shade and that is not a fault: the sun in Queensland is in
       the north, so a south face is shaded all day, and over a lap the camera sees both. */    const fog = tron ? [0.004, 0.004, 0.004] : night ? [0.004, 0.008, 0.024] : [0.044, 0.108, 0.296];
    /* EXPOSURE AND BLOOM ARE THE WHOLE LOOK, and the first pass had both far too high.

       TRON: the pipeline already draws a one-pixel edge with a 2.4-intensity glow. Bloom on top of that at 0.85
       spread the glow across the entire face, so a tower read as a solid orange block instead of a wireframe.
       The reference is a thin bright line on near-black — that is bloom at about a quarter, letting the edge
       shader's own glow do the work it was written to do.

       Lit: at 1.35 exposure the facades came out cream and the lit windows had nothing to stand out against.
       The night should be dark buildings with bright windows, so the exposure comes down below one and the
       bloom is barely there — just enough to let a window bleed a little. */
    return {
      surfaces: [], viewProjection: v.vp, shadowViewProjection: shadowVP,
      sunDirection: sunDir, moonDirection: moonDir,
      fogColourLinear: Q.tune.fog || fog,
      fogDensity: Q.tune.fogDensity != null ? Q.tune.fogDensity : (tron ? 0.00016 : (night ? 0.00030 : 0.00012)),
      /* the ocean is east of the circuit; the haze weighting is a light touch, off entirely in TRON */
      coastalEastDirection: toScene(90, 0, S.thDeg), coastalHaze: tron ? 0 : 0.35,
      /* Night came back cream: every window a bright block and the facades between them lit like day. The
         towers should be dark with the windows burning in them, which is a lower exposure, not a dimmer
         window — the emission is the runtime's and it is right. */
      /* Day at 1.55: judged against the sweep at 0.95, 1.25, 1.6 and 2.0. Below one the facades are black
         silhouettes against a white sky; at two the whole frame goes pale and the type loses its ground. */
      exposure: Q.tune.exposure != null ? Q.tune.exposure : (tron ? 0.72 : (night ? 1.25 : 1.95)),
      bloomStrength: Q.tune.bloom != null ? Q.tune.bloom : (tron ? 0.22 : (night ? 0.15 : 0.10)),
    };
  }

  Q.frame = function () {
    const S = Q.S;
    if (!S || S.lost) return;
    const nowMs = now();
    /* Paused holds the picture, it does not redraw it — but only once there is a picture to hold; see below. */
    if (S.paused && S.settled) return;
    try {
      S.runtime.frame(nowMs, instantFor(S.look), lodCamera(S, S.runtime.sceneSeconds));
      S.last = nowMs;
      /* PAUSED IS NOT THE SAME AS FINISHED.

         Holding the picture when the scene is paused is right — the clock is frozen, so a redraw would produce
         the identical image. It was being decided one frame too early. The tiles are STREAMED: the first frame
         after a pause, or after the look changes and the scene is rebuilt, has asked for its geometry and not
         yet received any of it, so settling on that frame settles on an empty picture and nothing ever draws
         again. Switching backdrop while the deck was paused left the plate blank for exactly this reason.

         So it settles when there is something to settle on: a selection that has been made and has nothing
         still uncovered. Until then it keeps drawing, which is what lets the geometry arrive. */
      const sel = S.status;
      S.settled = S.paused && !!sel && sel.render.length > 0 && sel.uncovered.length === 0;
    } catch (e) {
      Q.failed = 'the scene stopped: ' + (e && e.message || e);
      Q.unmount();
    }
  };

  Q.resize = function (w, h) {
    const S = Q.S; if (!S) return;
    S.w = Math.max(1, w | 0); S.h = Math.max(1, h | 0);
    S.settled = false;
    if (S.pipeline && S.pipeline.resize) { try { S.pipeline.resize(S.w, S.h); } catch (e) {} }
  };
  /* v5.64 — ASK FOR ONE MORE FRAME. The page needs a way to say "something you draw has changed" without
     knowing how this module holds its picture. A paused scene holds the last frame and draws nothing; every
     setter below already clears that hold, and this is the same clearing on its own, for the cases the page
     knows about and the module does not — the plate re-laid under it, a control row moved. */
  Q.nudge = function () { const S = Q.S; if (S) S.settled = false; };
  Q.setPace = function (p) { const S = Q.S; if (S) { S.settled = false; try { S.runtime.setPace(p, now()); } catch (e) {} } };
  Q.setPlaying = function (on) { const S = Q.S; if (S) { S.paused = !on; S.settled = false; try { S.runtime.setPlaying(!!on, now()); } catch (e) {} } };
  Q.setSuspended = function (on) { const S = Q.S; if (S) { try { S.runtime.setSuspended(!!on, now()); } catch (e) {} } };
  /* The camera's three numbers, changed while it runs. The clearance profile is worked out from the
     look-ahead, so changing that has to throw the profile away and let it be worked out again. */
  Q.setCamera = function (c) {
    Object.assign(Q.camera, c || {});
    const S = Q.S; if (S) { S.line = undefined; S.settled = false; }
  };
  Q.setReducedMotion = function (on) { const S = Q.S; if (S) { try { S.runtime.setReducedMotion(!!on, now()); } catch (e) {} } };
  Q.setLook = function (look) {
    const S = Q.S; if (!S) return;
    if (S.look !== look) Q.stats.lookChanges++;
    S.look = look;
    S.settled = false;
    try { S.runtime.setTheme(look === 'tron' ? 'TRON' : 'REALISTIC', now()); } catch (e) {}
  };
  Q.unmount = function () {
    const S = Q.S; if (!S) return;
    Q.S = null;
    if (S.raf) { try { cancelAnimationFrame(S.raf); } catch (e) {} S.raf = 0; }
    try { S.canvas.removeEventListener('webglcontextlost', S.onLost, false); } catch (e) {}
    try { S.runtime && S.runtime.dispose && S.runtime.dispose(); } catch (e) {}
    try { S.loader && S.loader.dispose && S.loader.dispose(); } catch (e) {}
    /* the car is not a tile, so nothing else releases it */
    try { if (S.car) { S.car.groups.forEach(g => S.pipeline.disposeMesh(g.mesh));
                       S.car.mats.forEach(m => S.pipeline.disposeMaterial(m)); S.car = null; } } catch (e) {}
    try { if (S.grid) { S.pipeline.disposeMesh(S.grid.mesh); S.pipeline.disposeMaterial(S.grid.material);
                        S.grid = null; } } catch (e) {}
    try { S.pipeline && S.pipeline.dispose && S.pipeline.dispose(); } catch (e) {}
  };
})(window.GC3D = window.GC3D || {});
