    const h = GRID_W / 2;
    for (let x = Math.ceil(x0 / GRID_M) * GRID_M; x <= x1; x += GRID_M) quad(x, z0, x, z1, h, 0);
    for (let z = Math.ceil(z0 / GRID_M) * GRID_M; z <= z1; z += GRID_M) quad(x0, z, x1, z, 0, h);
