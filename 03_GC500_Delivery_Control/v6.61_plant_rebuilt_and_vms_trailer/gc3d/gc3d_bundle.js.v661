  if(T.maxSparks>0)m.sparks.forEach(q=>{const a=1-(clock-q.c)/.6,t=[q.p[0]-q.v[0]*.035,q.p[1]-q.v[1]*.035,q.p[2]-q.v[2]*.035];ad.seg(q.p,t,[1,.78,.45,a],[1,.5,.2,0],.10,.04,.8);});
  /* v5.66 — the tyre smoke used to be drawn here, as additive dots on the dynAdd batch, and that is exactly
     why nobody could see it: additive can only lighten, and smoke reads by being paler AND softer than what
     is behind it. It is built as alpha-blended camera-facing puffs in buildDynamic now (S.puffs). */
  /* A locator beam is only useful in the optional showcase treatment. */
  if(show('beam')&&S.beam!==false)ad.seg([P.pos[0],H+.55*Sx,P.pos[2]],[P.pos[0],H+5.5,P.pos[2]],[1,.5,.15,.10],[1,.5,.15,0],.30,.07,0);
  /* start gantry: five red lamps, one at a time, then out */
  const gr=S.grid,gy=H+4.4,pa=[gr.p[0]+gr.n[0]*(gr.hw+.4),0,gr.p[1]+gr.n[1]*(gr.hw+.4)],pb=[gr.p[0]-gr.n[0]*(gr.hw+.4),0,gr.p[1]-gr.n[1]*(gr.hw+.4)],gc=[.75,.8,.85,.42];
  co.seg([pa[0],H,pa[2]],[pa[0],gy,pa[2]],gc,gc,.03,.03,.6);co.seg([pb[0],H,pb[2]],[pb[0],gy,pb[2]],gc,gc,.03,.03,.6);co.seg([pa[0],gy,pa[2]],[pb[0],gy,pb[2]],gc,gc,.04,.04,.7);
  for(let i=0;i<5;i++){const f=(i-2)/2*.62,x=gr.p[0]+gr.n[0]*gr.hw*f,z=gr.p[1]+gr.n[1]*gr.hw*f,on=!m.go&&clock>.5+i*.5,p0=[x,gy-.55,z];
    ad.seg(p0,p0,[1,.10,.06,on?1:.10],[1,.10,.06,on?1:.10],on?.62:.3,on?.62:.3,on?3:1.5);if(on)co.seg(p0,p0,[1,.75,.7,1],[1,.75,.7,1],.17,.17,1);}
