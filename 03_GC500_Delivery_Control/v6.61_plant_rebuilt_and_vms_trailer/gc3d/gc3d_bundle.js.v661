  /* v5.49 — THE DAY GROUND IS THE LOOK'S TO SET. v1.8 drew the day land, the streets and the water with the
     mesh's own baked colours and nothing over the top, which is why the day picture went pale concrete from
     edge to edge and the canals stopped reading as water at all. Andrew Fisher, 18 Sep 2026, choosing between
     the look he approved on 17 Sep and the one the port left behind: bring the first one back. So the day
     look carries its own ground and street materials now, exactly as the night look always has, and this
     identity pair is only the fallback for a look that names neither. */
  const groundMat={tint:[1,1,1],lift:[0,0,0]},land=new G.MeshBatch(gl,[3,4,2],false),
        roadSurface=new G.MeshBatch(gl,[3,4,2],false),roadShoulder=new G.MeshBatch(gl,[3,4,2],false);
  let gx0=Infinity,gx1=-Infinity,gz0=Infinity,gz1=-Infinity;
  const bound=p=>{gx0=Math.min(gx0,p[0]-cx);gx1=Math.max(gx1,p[0]-cx);gz0=Math.min(gz0,p[1]-cz);gz1=Math.max(gz1,p[1]-cz);};
  blocks.forEach(b=>b.p.forEach(bound));pk.roads.forEach(r=>pts(r,1).forEach(bound));
  if(Number.isFinite(gx0)){
    const pad=24/pk.mPerPt,put=(x,z)=>land.vert(x,-.025,z,.205,.218,.19,1,0,0);
    const a=put(gx0-pad,gz0-pad),b=put(gx1+pad,gz0-pad),c=put(gx1+pad,gz1+pad),d=put(gx0-pad,gz1+pad);
    land.tri(a,b,c);land.tri(a,c,d);
