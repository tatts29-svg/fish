        if(len<1e-6)continue;
        const nx=-dz/len*hw,nz=dx/len*hw;
        const v0=mk.vert(p0[0]-nx,y,p0[2]-nz,col[0],col[1],col[2],aa,0,0);
        const v1=mk.vert(p0[0]+nx,y,p0[2]+nz,col[0],col[1],col[2],aa,0,1);
        const v2=mk.vert(p1[0]+nx,y,p1[2]+nz,col[0],col[1],col[2],ab,1,1);
        const v3=mk.vert(p1[0]-nx,y,p1[2]-nz,col[0],col[1],col[2],ab,1,0);
