  const r={
    scale_m_per_pt:M, time_compression:tc, car_drawn_times_life_size:T.exag,
    car_length_m:T.carLen_m*T.exag, car_length_real_m:T.carLen_m,
    deck_height_m:T.deckH*M,
    top_speed_kmh_real:T.vmax*M*3.6/tc, top_speed_kmh_on_screen:T.vmax*M*3.6,
    accel_g:T.acc*M/(tc*tc)/9.81, brake_g:T.brk*M/(tc*tc)/9.81, lateral_g:T.aLat*M/(tc*tc)/9.81,
    gravity_g:T.grav*M/(tc*tc)/9.81,
    jump_height_m:T.jumpHigh_m, jump_air_s:T.jumpAir_s, look:(S&&S.look?S.look.name:T.look),
    jump_length_car_lengths:T.vmax*T.jumpAir_s/(T.carLen_m*T.exag/M)
  };
  if(S&&S.CL){r.lap_length_m=S.CL.L*M;
    /* v5.49 — the road the car is standing on, so the car-to-road ratio can be CHECKED and not eyeballed.
       Andrew Fisher, 18 Sep 2026: the car at its correct size, matching the road. */
    const w=[];for(let i=0;i<S.CL.n;i++)w.push(S.CL.at(S.CL.cum?S.CL.cum[i]:i*S.CL.L/S.CL.n)[2]*M);
    w.sort((a,b)=>a-b);const pc=f=>w[Math.max(0,Math.min(w.length-1,Math.round(f*(w.length-1))))];
    r.road_width_m={min:pc(0),median:pc(.5),max:pc(1)};
