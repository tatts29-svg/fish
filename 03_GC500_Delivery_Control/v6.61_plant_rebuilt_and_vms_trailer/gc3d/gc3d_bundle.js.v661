        face(wire,[pa,pb,mb,ma],wireCol,[[u0,0],[u1,0],[u1,v1],[u0,v1]]);
        face(wire,[ma,mb,tb,ta],wireCol,[[u0,v1],[u1,v1],[u1,v2],[u0,v2]]);
