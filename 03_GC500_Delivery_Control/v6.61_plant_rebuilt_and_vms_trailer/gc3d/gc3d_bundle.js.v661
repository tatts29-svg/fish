    const streetMat=L.day?(L.mat.street||L.mat.ground||groundMat):{tint:[.12,.18,.29],lift:[.002,.003,.006]};
    flat(5,streetMat);gl.depthMask(true);S.dayRoadShoulder.draw();flat(4,streetMat);S.dayRoadSurface.draw();gl.depthMask(false);
    if(L.lines.roadGlow>0){lines(true,L.lines.roadGlow,true,0);S.roadGlow.draw();}
    if(!L.day&&L.lines.roadCore>0){lines(false,L.lines.roadCore,true,0);S.roadCore.draw();}
    if(L.lines.cityLights>0){lines(true,L.lines.cityLights,false,.0005);S.cityLights.draw();}
    gl.depthMask(true);flat(0,L.day?(L.mat.ground||groundMat):{tint:[.21,.27,.31],lift:[.002,.004,.007]});
    S.dayTreeTrunks.draw();S.dayTrees.draw();
    gl.depthMask(false);   /* solid, so the car and buildings hide them */
