  });
  /* Road light is a showcase-only treatment; Day Race retains only a small braking reflection. */
  const quad=(c,hx,hz,col)=>{const y=H+.03,f=P.fwd,r=P.rt,v=(sx,sz)=>dc.vert(c[0]+f[0]*hx*sx+r[0]*hz*sz,y,c[2]+f[2]*hx*sx+r[2]*hz*sz,col[0],col[1],col[2],col[3],sx,sz);
    const a=v(-1,-1),b=v(1,-1),d=v(1,1),e=v(-1,1);dc.tri(a,b,d);dc.tri(a,d,e);};
  const idle=idleGlow;
  if(show('roadLight')){
    quad(P.pos,1.35*Sx,.78*Sx,[1,.42,.07,.20*idle]);
    /* v5.79 — the headlamps' pools take the look's word for how hot they are (L.headlamp, 1 as they were): with
