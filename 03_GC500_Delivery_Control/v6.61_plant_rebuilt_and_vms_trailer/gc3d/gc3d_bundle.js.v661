    const r=this.idx(s),i=r[0],f=r[1],a=this.p[i],b=this.p[(i+1)%this.n],m0=this.tan[i],m1=this.tan[(i+1)%this.n];
    const f2=f*f,f3=f2*f,h00=2*f3-3*f2+1,h10=f3-2*f2+f,h01=-2*f3+3*f2,h11=f3-f2;
    const d00=6*f2-6*f,d10=3*f2-4*f+1,d01=-d00,d11=3*f2-2*f,p=[],d=[];
    for(let k=0;k<a.length;k++){p.push(h00*a[k]+h10*m0[k]+h01*b[k]+h11*m1[k]);d.push(d00*a[k]+d10*m0[k]+d01*b[k]+d11*m1[k]);}
