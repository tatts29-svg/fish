  if(t<G.GRID){while(st.lamp<5&&t>=.5+st.lamp*.5){beep(st.lamp,S,ta);st.lamp++;}}
  else if(!st.launched){st.launched=true;st.lamp=5;if(SND.mode==='clips')play('launch',1,S,ta);else{burst(SND.nodes.sum,ta,1.0,1500,2600,1.2,.9,S,'wheelspin');log('launch (designed)',S,ta);}}
