(function (G) {
  'use strict';
  const Q = {S: null, failed: null, built: null};
  G.geo = Q;

  /* The site, for the sun and the moon. The centre of the registered frame, read back through the circuit's
     own georeference — never typed in here. Height above sea level is the Gold Coast strip: a few metres, and
     the runtime is explicit that this is the observer's mean-sea-level height and not an ellipsoidal one. */
  const SITE = {latitudeDegrees: -27.9880, longitudeDegrees: 153.4270, heightMetresAboveSeaLevel: 3};

  /* Turn a compass bearing into the scene's own axes. The drawing is not north-up: the registration rotates it
     by th_deg, and the runtime is explicit that directions must arrive already rotated. Getting this wrong
     puts the sun in the wrong quarter of the sky all day and looks entirely plausible while doing it. */
  function toScene(az, el, thDeg) {
    const RT = window.GC500RT;
    const d = RT.horizontalDirection(az, el);          /* [east, north, up] */
    const th = (thDeg || 0) * Math.PI / 180;
    const c = Math.cos(th), s = Math.sin(th);
    const e = d[0], n = d[1], u = d[2];
    /* scene x is the rotated east, scene z is the rotated north (y is up, as everywhere else on this page) */
    return [e * c - n * s, u, e * s + n * c];
  }

  /* The page's data is a top-level const, not a property of window — the same reason the other scene reads it
