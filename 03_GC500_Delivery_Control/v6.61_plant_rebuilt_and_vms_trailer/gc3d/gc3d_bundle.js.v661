})();
/* GC3D part 6 — the adapter for the GC500 show. It takes over the lap-lights hook and nothing else:
   the record is never read or written here. If WebGL2 is missing, or the frame rate cannot be held,
   the flat scene the show already has stays exactly as it was. */
(function(){
'use strict';
const G=window.GC3D;

/* GC3D.mount(pack) — call once the show's page has DATA.circuit; safe to call again (it replaces itself). */
G.mount=function(pack,look){
  if(typeof DATA==='undefined'||!DATA.circuit||!DATA.circuit.ring)return 'no circuit on this page';
  if(typeof LAPS==='undefined')return 'no lap-lights hook on this page';
  if(G.S&&G.S.unmount)G.S.unmount(true);
  document.querySelectorAll('canvas.gc3d,.gc3d-ui').forEach(e=>e.remove());document.querySelectorAll('.shplate').forEach(e=>{e.__gc3d=false;});

  const C=DATA.circuit,ok=G.init({look:look||'dark',ring:{outer:C.ring.outer,inner:C.ring.inner,box:C.ring.box},roadWidth:C.roadWidth||null,streets:pack?[]:C.streets,buildings:[],
    pit:pack&&pack.pit&&G.packPts?pack.pit.map(r=>G.packPts(pack,r,1)):null});   /* v5.39: the grid goes by the pit lane */
  if(!ok)return 'WebGL2 is not available here — the flat scene stays';
  if(pack)G.loadPack(pack);
  if(G.setStands)G.setStands(C.stands);        /* v5.40: one stand per name the fencing schedule gives, placed by rule */
  const S=G.S,show=document.querySelector('section.show')||document.body,bg=getComputedStyle(show).backgroundColor||'rgb(19,25,27)';
  if(G.setLook)G.setLook((S.look&&S.look.name)||'dark');        /* v5.43 — puts the sky behind the canvas */
  const DAY=!!(S.look&&S.look.day);
  if(G.sound&&typeof DATA!=='undefined')G.sound.setClips(DATA.showSound||null);   /* the generated clips, embedded; sound stays off until its button */
  const mid=a=>bg.replace('rgb(','rgba(').replace(')',','+a+')'),clear=mid(0);
  /* (v0.4 injected .shscene{overflow-x:hidden} here; from v5.34 the showcase's own stylesheet carries it) */

  const dress=plate=>{
    if(plate.__gc3d)return;plate.__gc3d=true;
    plate.querySelectorAll('svg.shcircuit,svg.shhalo').forEach(e=>{e.style.visibility='hidden';});
    /* the scene sits above the show's own scrim (z 3), which is tuned for photographs; this fade keeps the words readable instead */
    const fade=document.createElement('div');fade.className='gc3d-ui';fade.style.cssText='position:absolute;inset:0;pointer-events:none;z-index:5';
    /* v5.43 — what sits under the credit changes shot to shot: light water on the wide view, charcoal asphalt on
       the chase. Dark type was tried first and disappeared on the road. Pale type with a dark halo reads on
       both, because the halo travels with the letters. The night credit is unchanged. */
    const cap=document.createElement('div');cap.className='gc3d-ui';cap.style.cssText='position:absolute;right:1.2%;bottom:2.2%;z-index:6;pointer-events:none;font:500 11px Inter,system-ui,sans-serif;letter-spacing:.03em;text-align:right;'+(DAY?'color:rgba(238,243,245,.92);text-shadow:0 1px 2px rgba(6,10,12,.85),0 0 8px rgba(6,10,12,.55)':'color:rgba(200,212,216,.55)');
    S.credit=(DAY?'Day race look from GC500_3D_Scene v1.3 · ':'')+'Circuit: iEDM key plan K220-K231-26003-02 · '+(S.pack?S.pack.credit+' · ':'')+(S.pitStats&&S.pitStats.ways?'pit lane from OpenStreetMap, its garages a nominal row · ':'')+'the backdrop is decoration, the figures are the record';
    /* v5.39 — on a phone the plate is 400 px tall and the words reach almost to its foot, so the long credit ran
       into them. A narrow plate gets the short one: the two sources credited (the licence asks for OpenStreetMap's)
       and the word decoration, in two lines; the line under the plate carries the rest, and the wide plate the lot. */
    S.creditShort='iEDM key plan K220-K231-26003-02 · © OpenStreetMap contributors (ODbL) · decoration, not the record';
    if(S.standStats&&S.standStats.drawn)S.credit=S.credit.replace('the backdrop is decoration','grandstands named by the fencing schedule, placed by rule · the backdrop is decoration');
    if(S.kerbStats&&S.kerbStats.blocks)S.credit=S.credit.replace('the backdrop is decoration','kerbs a nominal rule, not a drawn line · the backdrop is decoration');   /* v5.42 */
    S.creditNow=()=>(S.cv.clientWidth||0)<700?S.creditShort:S.credit;
    cap.textContent=S.creditNow();
    plate.appendChild(fade);plate.appendChild(cap);S.fadeEl=fade;S.capEl=cap;S.fadeTr=-1;
  };
  /* how far across the words of this scene reach, so the fade and the framing can make room for them */
  const textRight=()=>{const sc=document.querySelector('.shscene'),pr=S.cv.getBoundingClientRect();if(!sc||!pr.width)return .48;let right=pr.left;
    const tw=document.createTreeWalker(sc,NodeFilter.SHOW_TEXT),rg=document.createRange();let nd;
    while((nd=tw.nextNode())){if(!nd.nodeValue.trim())continue;const pe=nd.parentElement;if(!pe)continue;const cs=getComputedStyle(pe);if(cs.visibility==='hidden'||+cs.opacity<.05)continue;
      rg.selectNodeContents(nd);const r=rg.getBoundingClientRect();if(r.width>0&&r.left<pr.right&&r.top<pr.bottom&&r.bottom>pr.top)right=Math.max(right,Math.min(r.right,pr.right));}
    return Math.max(.2,Math.min(.8,(right-pr.left)/pr.width));};
  /* v5.41 — THE SCENE IS BEHIND THE WORDS, NOT BESIDE THEM. Andrew Fisher, 17 Sep 2026, on a 1128-point window:
     the car could not be seen, half of everything was missing, and the car sounded like a fly.
     He was right, and one thing caused all three. The words are up to 1,000 points wide, so on any window under
     about 1,600 they reach 80-90% of the way across; the old rule read that as "no room" and walled the scene off
     behind a block of background (half the picture gone), locked the drone to the quiet wide shot (the car a
     speck) and left the engine at wide-shot distance (the fly). Now the scene fills the whole plate at every
     shape, dimmed evenly with a little more weight under the words so they stay readable, the drone flies its own
     sequence, and the lens is centred. Only a genuinely wide plate with short words still gets the side-by-side
     framing it was drawn for. */
  const makeRoom=()=>{
    const focus=show.classList.contains('car-focus');
    if(focus){if(S.fadeEl)S.fadeEl.style.background='none';S.fadeTr=-1;S.textRight=0;S.beside=false;S.shiftGoal=0;S.distGoal=1;S.calm=false;return;}
    const tr=textRight();S.textRight=tr;
    const r=S.cv.getBoundingClientRect(),asp=(r.width||1)/Math.max(1,r.height);
    const beside=asp>1.5&&tr<=.60;S.beside=beside;
    if(S.fadeEl&&(Math.abs(tr-S.fadeTr)>.01||S.fadeB!==beside)){S.fadeTr=tr;S.fadeB=beside;const pc=v=>(Math.max(0,Math.min(1,v))*100).toFixed(1)+'%';
      /* v5.43 — daylight needs the scrim shaped differently, NOT heavier. The first cut simply raised every
         stop and turned a sunlit circuit into dusk: the sky went grey, the concrete went dark, and the whole
         point of the day look was lost (seen in the render before it went anywhere). What the words actually
         need is contrast where the words ARE. So by day the wash is strong at the left, where the headline and
         the paragraph sit, and falls away to almost nothing on the open side — the sky, the water and the far
         side of the circuit stay daylit. The type carries a shadow of its own under this backdrop as well, so
         the figures that reach across the plate hold up without the scrim having to cover them.
         This is deliberately not the v5.41 side-by-side wall: the scene is drawn across the whole plate and is
         visible through the wash at every point. The night figures are unchanged. */
      const W=DAY?[.88,.74,.34,.08]:[.86,.78,.52,.34];
      S.fadeEl.style.background=beside
        ? 'linear-gradient(to right,'+bg+' 0%,'+bg+' '+pc(tr-.14)+','+mid(.9)+' '+pc(tr-.05)+','+mid(.62)+' '+pc(tr+.02)+','+mid(.25)+' '+pc(tr+.09)+','+clear+' '+pc(tr+.17)+')'
        : 'linear-gradient(to right,'+mid(W[0])+' 0%,'+mid(W[1])+' '+pc(tr*.55)+','+mid(W[2])+' '+pc(tr*.92)+','+mid(W[3])+' 100%)';}
    /* v5.42 — CALM IS OFF, and this line now says so instead of pretending. It read `beside && tr > .6`, and
       `beside` is itself `asp > 1.5 && tr <= .60` — the two cannot both hold, so calm has been dead since
       v5.41 and the scene has never once ducked to the quiet wide shot. Leaving a line that looks live and is
       not is worse than not having it. It is deliberately not revived: ducking the drone and the engine on a
       wordy scene is exactly what Andrew Fisher scored 2 out of 10 on 17 Sep (nothing could be seen, and the car
       sounded like a fly), and every scene in this deck is wordy. The calmK machinery stays — the showcase or a
       test can still set S.calm, and the camera and the engine both honour it — so this is a default, not a
       removal. */
    S.calm=false;
    S.shiftGoal=beside?Math.max(.2,Math.min(.8,2*(tr+(1-tr)*.52)-1)):0;
    S.distGoal=beside?Math.max(1,Math.min(1.9,.40/Math.max(.1,1-tr-.04))):1;};

  S.syncLayout=makeRoom;
  /* v5.48 — the ladder is a function of its own so it can be PROVED rather than waited for. Under a software
     renderer a frame takes so long that the frame-rate counter never completes a reading, so a test that sat and
     watched would learn nothing; a test can call this five times and read what it gave up, in order. */
  G.stepDown=function(){
    const S=G.S;if(!S)return null;
    const Q=S.quality||{};
    /* v5.48 — the first rung is now Ultra back to High, which costs only the extra pixels and the bigger
       shadow map and keeps every feature. Only below that does anything get switched off. */
    if(Q.name==='ultra'){if(G.setQuality)G.setQuality('high',true);S.qualityStep='detail High';}
    else if(S.reflOff!==true&&Q.name!=='balanced'){S.reflOff=true;S.qualityStep='reflections off';if(G.setQuality)G.setQuality('balanced',true);}
    else if(S.shadowOff!==true){S.shadowOff=true;S.qualityStep='shadow map off';if(S.sunShadow)S.sunShadow.ok=false;}
    else if(S.bloom!==false){S.bloom=false;S.bloomWhy=S.qualityStep='glow off';if(G.freeTarget&&S.gl)[S.rt,S.b1,S.b2,S.c1,S.c2].forEach(t=>G.freeTarget(S.gl,t));S.rt=S.b1=S.b2=S.c1=S.c2=null;}
    else{const ss=S.o.ss||1;if(ss>.55){S.o.ss=Math.max(.5,ss*.8);S.qualityStep='drawn at '+Math.round(S.o.ss*100)+'%';}
      else{G.failed='frame rate';S.qualityStep='handed back to the flat circuit';S.unmount();}}
    return S.qualityStep;
  };
  /* v5.49 — AND IT HAS TO GIVE UP A RUNG BEFORE SIXTY FRAMES, OR IT NEVER GIVES UP ONE AT ALL. The reading
     below is taken every 60 frames and needs two of them, which is 120 frames before the first step down. That
     is fine at 30 fps (four seconds) and useless at half a frame a second, which is exactly the machine the
     ladder exists for: measured here on a software renderer at 4745 x 1896, the scene managed FOUR FRAMES IN
     TWO MINUTES and sat on Ultra the whole time, because the guard was waiting for frames that were never
     going to arrive. An hour would have passed before it dropped its first rung. So a frame that is hopeless
     on its own face — over 400 ms, under two and a half a second — counts immediately, and two of those in a
     row take a rung. Two rather than one so a single hitch (a tab coming back, a long pause for memory) does
     not cost anything; there is no averaging because there is nothing to average when a frame takes a third of
     a minute. The 60-frame reading below still handles the marginal case, where the picture is nearly holding
     and only a careful average can tell. */
  let lastT=-1,acc=0,n=0,slow=0,stalled=0,sampledActive=false,layoutDone=false;const STALL_MS=250;
  const gen=window.__gc3dGen=(window.__gc3dGen||0)+1,orig=G.origFrame=G.origFrame||window.lapsFrame;
  const frame=function(t){
    if(gen!==window.__gc3dGen)return;            /* an older copy: stand down, and do NOT ask for another
                                                    frame \u2014 a newer scene owns the loop now */
    /* THE LOOP CONTINUES FROM HERE, WHATEVER ELSE HAPPENS.
       22 Sep 2026, Andrew Fisher on the live service: it had bugs and stopped every now and then.
       This is it. The re-arm used to sit a dozen lines further down, AFTER `if(t===lastT)return`. Two
       animation-frame callbacks arriving with the same timestamp is a thing browsers do \u2014 they coalesce
       callbacks, and a tab resume or a frame-boundary hiccup is enough \u2014 and when it happened this
       function returned without asking for another frame. The whole showcase stopped: no error, no console
       message, nothing in the picture to explain it, and only closing and reopening it brought it back.
       Intermittent, invisible, and impossible to reproduce on demand, which is exactly how it was described.
       Every early return below this line is now a reason to SKIP A FRAME rather than to end the loop. */
    LAPS.raf=requestAnimationFrame(window.lapsFrame);
    /* v5.71 — THE LOOP'S OWN HEARTBEAT, stamped here because here is the one place that proves the loop is
       alive. A RENDERED FRAME does not prove it: a frame is skipped whenever the scene is paused, hidden or
       between canvases, and a slow machine can take twenty seconds over one. A CALLBACK proves it. The
       watchdog outside reads this, and it also reads the worst gap ever seen between two live callbacks, so
       the silence it treats as a fault is always measured against what this machine actually manages rather
       than against a number picked on a fast one. Gaps are only counted when both ends were visible and
       running, because the pause either side of a hidden tab is not a slow frame. */
    {const nw=(window.performance&&performance.now)?performance.now():Date.now();
     const live=!S.paused&&!document.hidden;
     if(live&&S.beatLive&&S.beatAt!=null){const g=nw-S.beatAt;if(g>(S.beatWorst||0)&&g<60000)S.beatWorst=g;}
     S.beatAt=nw;S.beatLive=live;S.beatN=(S.beatN||0)+1;}
    if(t===lastT)return;let dtm=lastT<0?16:t-lastT;lastT=t;
    const active=!S.paused&&!document.hidden;
    /* The first callback after a pause is not a slow frame. show3dSync clears S.last
       when stopping the loop, including pauses with no intervening callback. Long
       visible frames, however, are real samples: discarding every >1500 ms frame
       made the slowest renderers report no FPS and never reach the quality guard. */
    if(!active||!sampledActive||S.last==null){dtm=16;acc=0;n=0;slow=0;stalled=0;}
    sampledActive=active;
    const cv=LAPS.cv;if(!cv||!cv.isConnected||S.lost){sampledActive=false;return;}
    const plate=cv.parentNode;dress(plate);
    if(S.cv.parentNode!==plate){plate.querySelectorAll('canvas.gc3d').forEach(c=>{if(c!==S.cv)c.remove();});plate.insertBefore(S.cv,plate.querySelector('.gc3d-ui'));S.cv.style.zIndex='4';}
    if(LAPS.ctx&&LAPS.dirty!==0){LAPS.ctx.clearRect(0,0,cv.width,cv.height);LAPS.dirty=0;}
    if(!layoutDone||(active&&n%30===0)||S.needsLayout){makeRoom();layoutDone=true;S.needsLayout=false;}
    if(S.shiftGoal!=null){S.tune.shiftX+=(S.shiftGoal-S.tune.shiftX)*.05;S.distK=(S.distK||1)+((S.distGoal||1)-(S.distK||1))*.05;}
    G.frame(t);
    if(!active)return;
    // G.frame ticks the engine once. A second tick here distorted interpolation and duplicated audio work.
    acc+=dtm;n++;
    /* v5.49 — the immediate rung, before the averaged one gets a chance */
    /* v5.49 — MEASURING IS NOT GUARDING. noGuard says "do not take quality away from me", which is a fair
       thing for a test or a person to ask; it was also stopping the frame rate being WRITTEN DOWN, so on a slow
       machine with the guard off there was never a reading at all, the caption never got its figure, and
       anything waiting for one waited for ever. The reading is taken either way; only the step down is held. */
    if(dtm>STALL_MS){stalled++;
      if(stalled>=2){stalled=0;acc=0;n=0;S.fps=Math.max(1,Math.round(1000/dtm));
        S.stalledAt=Math.round(dtm);if(!G.noGuard)G.stepDown();
        if(S.capEl&&S.creditNow)S.capEl.textContent=S.creditNow()+(S.cv.clientWidth<700?'':' \u00b7 '+S.cv.width+' \u00d7 '+S.cv.height+' \u00b7 '+S.fps+' fps'+(S.qualityStep?' \u00b7 '+S.qualityStep+' to hold the frame rate':''));
        return;}}
    else stalled=0;
    if(n>=60||(acc>=1500&&n>=8)){S.fps=Math.round(1000/(acc/n));acc=0;n=0;
      /* the truth about the picture, in the caption: the pixels it is drawn at and the frame rate measured here */
      if(S.capEl)S.capEl.textContent=S.creditNow()+(S.cv.clientWidth<700?'':' · '+S.cv.width+' × '+S.cv.height+' · '+S.fps+' fps'+(S.qualityStep?' · '+S.qualityStep+' to hold the frame rate':''));
      /* v5.48 — QUALITY THAT STEPS DOWN ON ITS OWN. Andrew Fisher's choice, 17 Sep 2026, when this scene became
         the backdrop: open at full quality and drop a step at a time if the frame rate cannot hold.
         This scene is far heavier than the one before it — a 174,446-triangle car, reflection proxies, a shadow
         map — and it runs BEHIND THE WORDS on whatever he opens, a phone included. So it opens at High and
         gives things up in the order of what costs most and matters least, one rung at a time, waiting to see
         whether that was enough before giving up the next:
            1  reflections          the proxies the car mirrors; the paint keeps its shine without them
            2  the shadow map       the sun's cast shadow; contact shading under the car stays
            3  the glow             bloom, the most expensive pass on the frame
            4  pixels               render smaller and let the browser scale it, down to half
            5  hand back            the flat circuit, which has always been the fallback
         It never climbs back on its own — a scene that flickers between qualities is worse than one that
         settled low — and S.qualityStep says which rung it stopped on, in the caption and in the report. */
      if(S.fps<26&&!G.noGuard){slow++;if(slow>=2){slow=0;G.stepDown();}}else slow=0;}
  };
  window.lapsFrame=frame;try{lapsFrame=frame;}catch(e){}
  S.unmount=function(quiet){
    window.__gc3dGen=(window.__gc3dGen||0)+1;
    if(G.sound)G.sound.close();
    document.querySelectorAll('canvas.gc3d,.gc3d-ui').forEach(e=>e.remove());
    document.querySelectorAll('.shplate').forEach(p=>{p.__gc3d=false;p.querySelectorAll('svg.shcircuit,svg.shhalo').forEach(e=>{e.style.visibility='';});});
    if(orig){window.lapsFrame=orig;try{lapsFrame=orig;}catch(e){}}
    if(!quiet&&LAPS.cv&&LAPS.raf){cancelAnimationFrame(LAPS.raf);if(typeof lapsSize==='function')lapsSize();LAPS.raf=requestAnimationFrame(window.lapsFrame);}
    if(S.gl&&G.freeTarget)[S.rt,S.b1,S.b2,S.c1,S.c2].forEach(t=>G.freeTarget(S.gl,t));   /* v5.44 — the bloom buffers go with the scene */
    const ex=S.gl&&S.gl.getExtension('WEBGL_lose_context');if(ex)try{ex.loseContext();}catch(e){}
    G.S=null;
  };
  S.cv.addEventListener('webglcontextlost',e=>{e.preventDefault();S.lost=true;});
  S.cv.addEventListener('webglcontextrestored',()=>{if(G.S===S)G.mount(pack,look);});
  if(LAPS.cv&&LAPS.raf){cancelAnimationFrame(LAPS.raf);LAPS.raf=requestAnimationFrame(window.lapsFrame);}   /* running: hand the loop over; paused: stay paused */
  return 'mounted · '+(S.bCount||0)+' buildings';
};

/* GC3D.auto(pack) — the one-line integration: mount the first time the show starts its lap lights. */
G.auto=function(pack,look){
  if(G.autoOn||typeof lapsStart!=='function')return;G.autoOn=true;const start=lapsStart;
  const wrapped=function(cv){if(!G.S&&!G.failed){try{const r=G.mount(pack,typeof G.wantLook==='function'?G.wantLook():look);if(!/^mounted/.test(r))G.failed=r;}catch(e){G.failed=String(e&&e.message||e);}}return start(cv);};
  window.lapsStart=wrapped;try{lapsStart=wrapped;}catch(e){}
};
})();
/* GC3D part 7 — sound. Andrew Fisher, 17 Sep 2026: sound matters; then, a car that sounds like a supercar
   V8 — the car is right there on the screen, so the sound is designed for it. So the sound is DESIGNED for the
   car on the screen, in the page, from first principles — no recording, no broadcast audio, no sample: a V8 as a
   firing pulse train (eight cylinders, four-stroke, a cross-plane pattern) through fixed exhaust resonances, driven
   every frame by the same simulation that moves the car — its speed, six gears with shifts and blips, throttle and
   overrun pops, wheelspin at the launch, the limiter while the lights count — and placed for the camera: louder and
   brighter close, duller and quieter far, panned to where the car is on the screen, a little Doppler as it passes.
   The engine is heard in every shot because the car is on the screen in every shot; it fades when the words take the
   scene (calm). His generated takes stay embedded (DATA.showSound) and GC3D.sound.setMode('clips') plays them the
   old way — the whoosh into the chase shot uses his take when it is there, a swept noise when not.
   The frame of the received handover's section 10 still holds: OFF by default; one button; no AudioContext until
   that button or Start showcase is pressed; quiet when still or hidden; nothing read or written on the record.
   GC3D.sound.log says what was scheduled and when, so a test can assert it without listening; GC3D.sound.ctxFactory
   lets a test render the same graph offline and measure it. Coates Industrial Solutions · GC500 — Author: Andrew Fisher. */
(function(){
'use strict';
const G=window.GC3D;if(!G)return;
const KEY='gc500.showsound',R0=3000,IDLE=G.IDLE||1300,REDLINE=G.REDLINE||7500,LIMIT=G.LIMIT||7150;
const SND=G.sound={ctx:null,active:false,log:[],clips:null,bufs:{},g:{},nodes:{},mode:'engine',master:.5,post:4.5,engineGain:0,rate:1,rpm:IDLE,gear:0,pan:0,dist:0,ctxFactory:null,
  st:{lamp:0,launched:false,shot:null,lastT:-1,go:false,goAt:0,shiftAt:-9,cutUntil:-9,blipUntil:-9,thr:0,popAt:-9,nextRpmLog:0}};
const now=()=>SND.ctx?SND.ctx.currentTime:0;
function log(what,S,at){SND.log.push({what:what,clock:S?+S.clock.toFixed(2):null,at:+(at!=null?at:now()).toFixed(3)});if(SND.log.length>600)SND.log.shift();}
SND.isOn=function(){return SND.active;};
SND.remembered=function(){try{return localStorage.getItem(KEY)==='on';}catch(e){return false;}};
SND.setClips=function(c){
  const next=c||null,old=SND.clips||{};
  for(const k of CLIP_KEYS)if(old[k]!==((next||{})[k])){
    delete SND.bufs[k];delete SND.bufs[k+'_pending'];
  }
  SND.clips=next;if(SND.ctx)decodeAll();
};
/* v6.51 - THE V8 FROM THREE GENERATED LOOPS (Andrew Fisher, 26 Sep 2026: "Improve the v8 sound"). Idle, mid and high
   loops made on his ElevenLabs account and treated by the sound pipeline; each is pitched from its own note by the revs
   the gearbox reports and the three are crossfaded by rpm (equal power over a trapezoid each), so the engine climbs
   through the gears with real exhaust texture. Everything designed around the engine - intake, scrub, cut, blip, pops,
   distance, pan, Doppler - rides on them unchanged. 'loops' is the default once the three have decoded; 'engine' is the
   designed V8, one pick away and kept on the device; 'clips' is the old single-clip way, still there for a test. */
const CLIP_KEYS=['launch','engine','whoosh','engine_lo','engine_mid','engine_hi','crowd'];
const LOOPS=[['engine_lo',1300,[0,1300,3000,3700]],['engine_mid',4000,[2500,3500,5200,5900]],['engine_hi',6800,[4700,5700,9000,9000]]];
function loopWeight(rpm,w){const a=w[0],b=w[1],c=w[2],d=w[3];if(rpm<=a||rpm>=d)return 0;if(rpm<b)return (rpm-a)/(b-a);if(rpm<=c)return 1;return (d-rpm)/(d-c);}
const loopsReady=()=>!!(SND.bufs.engine_lo&&SND.bufs.engine_mid&&SND.bufs.engine_hi);
SND.modePref=function(){try{return localStorage.getItem('gc500.showengine')==='engine'?'engine':'loops';}catch(e){return 'loops';}};
SND.autoMode=function(){if(SND.mode==='clips')return;const want=SND.modePref();const m=want==='loops'&&loopsReady()?'loops':'engine';if(m!==SND.mode){SND.mode=m;engineStop();log('mode '+m+(m==='loops'?' (three generated loops)':' (designed V8)'));}};
SND.setMode=function(m){const want=m==='clips'?'clips':m==='loops'?'loops':'engine';try{if(want!=='clips')localStorage.setItem('gc500.showengine',want);}catch(e){}SND.mode=want==='loops'&&!loopsReady()?'engine':want;engineStop();log('mode '+SND.mode+(want==='loops'&&SND.mode!=='loops'?' (loops not decoded yet)':''));};
function crowdStart(t){if(SND.nodes.crowd||!SND.bufs.crowd||!SND.g.crowd)return;const src=SND.ctx.createBufferSource();src.buffer=SND.bufs.crowd;src.loop=true;src.connect(SND.g.crowd);src.start(t);SND.nodes.crowd=src;log('crowd start',null,t);}
const isOffline=()=>!!(SND.ctx&&typeof OfflineAudioContext!=='undefined'&&SND.ctx instanceof OfflineAudioContext);
/* ---- buffers made in the page: the V8's firing cycle, and plain noise for the intake, the wheelspin and the pops ---- */
/* v5.42 — THE V8 GETS ITS TWO BANKS. Andrew Fisher, 17 Sep 2026: the car sounded like a fly; then, sending
   his own GC500_3D_Scene_v0.9, any or all of its detail could be used.
   The finding in his package's generator is the one that matters, and it condemns what was here: this buffer
   fired eight evenly spaced puffs through one pipe. Eight even firings down one pipe is a FLAT-PLANE V8 — the
   engine in a Ferrari, which screams. A Supercars Gen3 car has a cross-plane crank, and the point of a
   cross-plane V8 is that the eight firings are even at the CRANK but lopsided down each of the two exhausts:
     bank A fires at   0 180 450 630  ->  gaps of 180 270 180  90
     bank B fires at  90 270 360 540  ->  gaps of 180  90 180 270
   That lopsided grouping down each pipe is the burble. Measured on the two patterns through the same pipe at
   3000 rpm, energy below the firing rate — which is what a burble IS — against the firing rate itself:
     what was here (no banks at all)  0.33, thin and spread
     a flat-plane V8                  0.45, all of it one clean sub-octave
     a cross-plane V8                 0.93, carried on the odd steps 3/8, 5/8, 7/8
   So the buffer now assigns each firing to a bank and gives the two banks different pipes: bank B a little
   quieter, a little duller, and 1.1 ms further down the exhaust, which is what makes them beat against each
   other. The trim is drawn once and repeated every cycle, and the puffs wrap, so the buffer still joins itself
   exactly — a loop that clicks is worse than a loop that is plain.
   Honest about one thing: playbackRate stretches the whole buffer, so bank B's 1.1 ms shortens as the revs
   rise, where a real pipe's length does not change. It is far below the grouping in what you hear.
   The finding is from Andrew Fisher's GC500_3D_Scene_v0.9 (pipeline/build_v8_clips.py). Its three clips are
   modelled from this same firing pattern, not recordings — v0.9's part 7 header calls them recordings, and its
   part 8 and its generator both say otherwise. Nothing here is a sample: this is the pattern, built in the page,
   driven by the same simulation that moves the car, so it revs continuously instead of pitching a fixed take. */
function pulseBuffer(ctx){
  /* v5.44 — the firing train, now STEREO: bank A on the left channel, bank B on the right, so each can be sent
     down its own exhaust by the convolver. The puffs themselves are bare impulses with only a little shaping —
     the pipe does the work now, where before this buffer had to carry the tone as well as the timing. */
  const sr=ctx.sampleRate,cyc=Math.round(sr*120/R0),N=cyc*16,A=new Float32Array(N),B=new Float32Array(N),rnd=G.rng(26);
  const BANK=[0,1,0,1,1,0,1,0];                                    /* firing k at k*90 deg: which pipe it leaves by */
  const trim=[];for(let k=0;k<8;k++)trim.push(1+(rnd()-.5)*.09);    /* drawn once, so every cycle is identical and the loop is exact */
  const jit=[];for(let k=0;k<8;k++)jit.push((rnd()-.5)*sr*.0004);
  const puffN=Math.max(2,Math.round(sr*.00009));                    /* v5.44: near a bare impulse — a wider puff rolled the top off above 4.5 kHz, and it is the pipe's job to shape this, not the train's */
  for(let c=0;c<16;c++)for(let k=0;k<8;k++){
    const b=BANK[k],amp=trim[k]*(b?.92:1),d=b?B:A;
    const j0=Math.round(c*cyc+k*cyc/8+jit[k]);
    for(let i=0;i<puffN;i++){const w=Math.sin(Math.PI*i/puffN);d[((j0+i)%N+N)%N]+=w*w*amp;}   /* wraps, so the buffer joins itself */
  }
  const buf=ctx.createBuffer(2,N,sr);buf.copyToChannel(A,0);buf.copyToChannel(B,1);return buf;
}
/* v5.44 — THE EXHAUST, AS A PIPE RATHER THAN AS THREE FILTERS. Andrew Fisher, 17 Sep 2026: the car sounded poor,
   and has to sound like a V8 supercar, not a fly. The bank fix in v5.42 put the burble in, but the tone was still
   three bandpass filters standing in for a header, a collector and a tailpipe, and three filters do not sound
   like a pipe. His own GC500_3D_Scene_v1.3 generator models it properly — a bank of damped resonators as an
   impulse response, convolved with the firing train — and that is what happens here now, built in the page and
   fed to a ConvolverNode. Same physics as his clips; but the train is the live one, so it revs continuously with
   the car instead of pitch-stretching a take recorded at one speed.
   The resonator list, the valve crack at the head of the impulse and the .022 s envelope are his figures. The
   two banks get slightly different pipes — B detuned 3.1%, duller, and 1.1 ms longer — which is what makes them
   beat against each other, and each rides its own channel so the convolver keeps them apart.
   Deliberately NOT sampled: nothing is embedded and nothing is downloaded. */
function pipeIR(ctx){
  const sr=ctx.sampleRate,N=Math.max(64,Math.round(sr*.055)),L=new Float32Array(N),R=new Float32Array(N);
  /* Tuned by measurement against his own v8_hi clip, band by band — the sound he approved is the reference, not
     a judgement about what a V8 "should" be. His figures are the starting point; 470 and 660 are up a little to
     fill the 480-960 band where this sat at four fifths of his, and the top two are down because a near-impulse
     train through this pipe came out at nearly three times his energy above 3.8 kHz. */
  const MODES=[[72,.013,.62],[145,.010,.58],[225,.0080,.54],[330,.0065,.58],[470,.0052,.70],[660,.0040,.62],
               [940,.0030,.44],[1400,.0024,.40],[2150,.0018,.32],[3300,.0013,.20],[5000,.0009,.10],[6800,.0006,.035]];
  [[L,1.000,1.00,0,41],[R,1.031,0.93,Math.round(sr*.0011),77]].forEach(([d,detune,bright,dly,seed])=>{
    const rnd=G.rng(seed);
    for(let m=0;m<MODES.length;m++){
      const f=MODES[m][0]*detune*(1+(rnd()-.5)*.008),tau=MODES[m][1];
      const a=MODES[m][2]*(MODES[m][0]>1000?bright:1),ph=rnd()*.6;
      for(let i=0;i<N-dly;i++){const t=i/sr;d[i+dly]+=a*Math.exp(-t/tau)*Math.sin(2*Math.PI*f*t+ph);}
    }
    d[dly]+=1.6;                                                   /* the crack of the valve opening */
    for(let i=0;i<N;i++)d[i]*=Math.exp(-(i/sr)/.022);              /* nothing rings longer than the pipe does */
  });
  /* normalise the pair together, so the two banks keep their balance */
  let pk=0;for(let i=0;i<N;i++){pk=Math.max(pk,Math.abs(L[i]),Math.abs(R[i]));}
  if(pk>0)for(let i=0;i<N;i++){L[i]/=pk;R[i]/=pk;}
  const b=ctx.createBuffer(2,N,sr);b.copyToChannel(L,0);b.copyToChannel(R,1);return b;
}
function noiseBuffer(ctx){const sr=ctx.sampleRate,N=sr*2,d=new Float32Array(N),rnd=G.rng(7);for(let i=0;i<N;i++)d[i]=rnd()*2-1;const b=ctx.createBuffer(1,N,sr);b.copyToChannel(d,0);return b;}
function shaperCurve(drive){const n=2048,c=new Float32Array(n);for(let i=0;i<n;i++){const x=(i/(n-1))*2-1;c[i]=Math.tanh(x*drive)/drive;}return c;}
/* the graph: sources → per-part gain → master → a compressor as a limiter → out. Every change goes through
   setTargetAtTime so nothing zips or clicks. */
function make(){
  let ctx=null;
  try{ctx=SND.ctxFactory?SND.ctxFactory():null;}catch(e){ctx=null;}
  if(!ctx){const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return false;ctx=new AC();}
  SND.ctx=ctx;
  const master=ctx.createGain();master.gain.value=SND.master;
  const comp=ctx.createDynamicsCompressor();comp.threshold.value=-12;comp.knee.value=18;comp.ratio.value=8;comp.attack.value=.004;comp.release.value=.18;
  master.connect(comp);comp.connect(ctx.destination);
  SND.nodes.master=master;SND.nodes.comp=comp;
  ['beep','launch','engine','whoosh','crowd'].forEach(k=>{const g=ctx.createGain();g.gain.value=(k==='engine'||k==='crowd')?0:1;g.connect(master);SND.g[k]=g;});   /* v6.51 - the crowd has its own gain, quiet, straight to the master */
  /* the engine's own chain: pan (where the car is on the screen) ← engine gain ← lowpass (throttle, distance) ← shaper ← sum */
  const pan=ctx.createStereoPanner?ctx.createStereoPanner():null;
  if(pan){SND.g.engine.disconnect();SND.g.engine.connect(pan);pan.connect(master);SND.nodes.pan=pan;}
  const lp=ctx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=900;lp.Q.value=.7;lp.connect(SND.g.engine);SND.nodes.lp=lp;
  const shaper=ctx.createWaveShaper();shaper.curve=shaperCurve(2.2);shaper.oversample='2x';const post=ctx.createGain();post.gain.value=SND.post;shaper.connect(post);post.connect(lp);SND.nodes.shaper=shaper;SND.nodes.post=post;
  const sum=ctx.createGain();sum.gain.value=1;sum.connect(shaper);SND.nodes.sum=sum;
  /* v5.44 — the exhaust is a PIPE now: the firing train convolved with the two banks' impulse responses. The
     four bandpasses, the growl lowpass, the crack and the rasp that stood in for it are gone — a pipe is not
     three filters, and that is what made it sound like a fly with a filter on it rather than a V8.
     The convolver runs at unity (normalize off: the impulse is already normalised, and letting the node
     re-normalise per its own rules would undo the balance between the two banks). A little of the raw train
     goes round it, which is the hard edge you hear standing beside the car and which a pipe alone loses. */
  const conv=ctx.createConvolver();conv.normalize=false;conv.buffer=pipeIR(ctx);
  /* v5.44 — the pipe's lowest modes ring straight through the gaps between firings at racing revs and pile up
     into a boom: measured against his own v8_hi, this carried 27 times his energy at 60-120 Hz. A gentle
     high-pass takes the pile-up without touching the 120-480 Hz body the note actually lives in. */
  const boom=ctx.createBiquadFilter();boom.type='highpass';boom.frequency.value=96;boom.Q.value=.6;
  const convG=ctx.createGain();convG.gain.value=.30;conv.connect(boom);boom.connect(convG);convG.connect(sum);
  const dry=ctx.createGain();dry.gain.value=.045;                 /* the crack of the valves, straight through */
  const dryHp=ctx.createBiquadFilter();dryHp.type='highpass';dryHp.frequency.value=900;dryHp.Q.value=.7;dry.connect(dryHp);dryHp.connect(sum);
  const pulseIn=ctx.createGain();pulseIn.gain.value=1;pulseIn.connect(conv);pulseIn.connect(dry);
