                p=put([a[0]-sn*wa,a[1],a[2]+cs*wa],u),q=put([a[0]+sn*wa,a[1],a[2]-cs*wa],u),
                s=put([b[0]+sn*wb,b[1],b[2]-cs*wb],v),t=put([b[0]-sn*wb,b[1],b[2]+cs*wb],v);
