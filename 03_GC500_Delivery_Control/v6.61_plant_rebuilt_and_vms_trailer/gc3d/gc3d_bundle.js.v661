      gl.stencilFunc(gl.ALWAYS,0,255);gl.stencilOp(gl.KEEP,gl.KEEP,gl.INVERT);S.fills[0].m.draw();
      flat(0,L.day?(L.mat.ground||groundMat):{tint:[.10,.15,.22],lift:[.002,.003,.006]});
      gl.colorMask(true,true,true,true);gl.enable(gl.DEPTH_TEST);gl.stencilFunc(gl.EQUAL,0,255);gl.stencilOp(gl.KEEP,gl.KEEP,gl.KEEP);
      gl.depthMask(true);S.dayLand.draw();gl.depthMask(false);gl.clear(gl.STENCIL_BUFFER_BIT);
    }
    S.fills.forEach(F=>{
      flat(9,null,false);
      gl.colorMask(false,false,false,false);gl.disable(gl.DEPTH_TEST);gl.stencilFunc(gl.ALWAYS,0,255);gl.stencilOp(gl.KEEP,gl.KEEP,gl.INVERT);F.m.draw();
      flat(L.day?(F.kind==='park'?6:F.kind==='beach'?7:F.mode):F.mode,L.mat[F.kind]);
      gl.colorMask(true,true,true,true);gl.enable(gl.DEPTH_TEST);gl.stencilFunc(gl.NOTEQUAL,0,255);gl.stencilOp(gl.ZERO,gl.ZERO,gl.ZERO);F.q.draw();
    });
