  if(shot!==st.shot){if(shot==='chase'&&st.shot!=null){if(!play('whoosh',.5,S,ta))burst(SND.g.whoosh,ta,1.0,300,3200,.8,.35,S,'whoosh (designed)');}st.shot=shot;}
  /* where the car is for the camera: distance, screen position, approach */
  const P=S.pose,cam=S.cam,car=P.pos;let dist=30,pan=0,dop=0;
  if(cam){const V=G.V,toCar=V.sub(car,cam.eye);dist=V.len(toCar)||1;const fwd=V.norm(V.sub(cam.tgt,cam.eye)),rt=V.norm(V.cross(fwd,[0,1,0]));
    pan=Math.max(-.8,Math.min(.8,V.dot(V.norm(toCar),rt)*2.2));
    const dtc=st.prevEye?Math.max(1e-3,t-st.prevT):0,camVel=st.prevEye&&dtc<.5?V.mul(V.sub(cam.eye,st.prevEye),1/dtc):[0,0,0];st.prevEye=cam.eye.slice();st.prevT=t;
    const cv=[camVel[0],0,camVel[2]];                                             /* the drone's own moves count (a chase camera hears no shift); a lift is not a fly-past */
    const rel=V.sub(V.mul(P.fwd,S.sim.v),cv),approach=-V.dot(rel,V.norm(toCar)),want=Math.max(-.15,Math.min(.15,approach/(S.tune.vmax*3.7)));
    st.dop=(st.dop||0)+(want-(st.dop||0))*Math.min(1,dtc>0?dtc*4:1);dop=st.dop;}
  SND.dist=dist;SND.pan=pan;
  /* full within a chase camera's distance of the car, falling off past it: 32 points for the 3.4-point car the law
     was set for, scaled with the car (v5.39 — the chase and helicopter cameras scale with it too).
     v5.41 — the fall was steep enough (^.9) that from the wide shot the engine was a thread of top end — a thin
     buzz, not a V8 (Andrew Fisher, 17 Sep 2026). A distant V8 is quieter and DEEPER, not thinner, so the
     fall is gentler and never goes below a fifth — and the tone it keeps is the bottom, not the rasp. */
  const near=Math.max(.20,Math.min(1,Math.pow(32*(S.tune.carS/3.4)/dist,.62))),calm=1-(S.calmK||0);
  /* the engine, designed for the car on the screen */
  if(SND.mode==='clips'){
    const W={chase:1,heli:0,wide:0,top:0},wCur=W[shot]||0,wPrev=S.forceShot?wCur:(W[S.prevShot]||0),blend=(S.camT<G.BLEND&&S.prevShot)?G.smooth(S.camT/G.BLEND):1;
    const w=(wPrev+(wCur-wPrev)*blend)*calm*(S.sim.go?1:0),sp=Math.max(0,Math.min(1,S.sim.v/S.tune.vmax)),gear=Math.min(4,Math.floor(sp*5)),frac=sp*5-gear;
    SND.rate=.72+.82*frac+gear*.04;const gain=w*(1-.45*S.sim.brake);SND.engineGain=gain;
    if(gain>.001){engineStart(S,ta);if(SND.nodes.engine){set(SND.nodes.engine.playbackRate,SND.rate,ta);set(SND.nodes.lp.frequency,600+3800*sp,ta);set(SND.g.engine.gain,gain,ta);}}
    else if(SND.nodes.engine)set(SND.g.engine.gain,0,ta);
    return;
  }
  const r=revs(S,ta);SND.rpm=r.rpm;SND.thr=r.thr;
  /* v5.79 — the overrun pops follow the scene's own ratios. This asked for 4,800 rpm at the moment the throttle
     shuts, which was right for the six close ratios the sound grew up with and wrong for the four wide audible
     ratios v5.48 gave it: in fourth the car reaches most braking zones at 3,500–4,500 rpm on this ladder, so the
     pops that were heard on every lap in v5.4x had not fired once in a 24-second chase since. A race V8 pops on
     the overrun from well below the top of its band — the condition is a hot exhaust and a shut throttle at
     speed — so the bar is the upper three fifths of the band, whatever the ladder. */
  if(r.braking&&r.thr<.3&&st.thr>=.5&&r.rpm>IDLE+(LIMIT-IDLE)*.38&&t-st.popAt>1.2){   /* the overrun: pops as the throttle shuts for a braking zone */st.popAt=t;if(!st.popRnd)st.popRnd=G.rng(19);const n=2+Math.floor(st.popRnd()*3);for(let i=0;i<n;i++)burst(SND.nodes.sum,ta+.12+i*(.16+.07*i),.06,700,300,.9,.7,S,i===0?'overrun pops ×'+n:null);}
