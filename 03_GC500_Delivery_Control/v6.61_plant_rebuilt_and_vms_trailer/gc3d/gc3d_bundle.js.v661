/* ear clipping for a simple polygon; returns index triples */
G.earclip=function(P){
  const n=P.length;if(n<3)return [];const idx=[];for(let i=0;i<n;i++)idx.push(i);
  if(area(P)<0)idx.reverse();
  const cr=(a,b,c)=>(b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0]);
  const inT=(p,a,b,c)=>cr(a,b,p)>=0&&cr(b,c,p)>=0&&cr(c,a,p)>=0;
  const tri=[];let guard=0;
  while(idx.length>3&&guard++<n*n){
    let cut=false;
    for(let i=0;i<idx.length;i++){
      const m=idx.length,i0=idx[(i+m-1)%m],i1=idx[i],i2=idx[(i+1)%m],a=P[i0],b=P[i1],c=P[i2];
      if(cr(a,b,c)<=1e-12)continue;
