  closeShake:.20,       /* close camera impact cue as a fraction of the broadcast shake */
  /* --- the look --- */
  look:'day',
  deckH_m:.18,            /* a thin road layer, not a floating stage                            */
  winGain:.5, shiftX:.38, shiftY:-.04, fov:32, bloom:1.75, bloomCut:.30
};};
/* Day Race is the production default. After Dark Showcase keeps the earlier neon treatment as a
