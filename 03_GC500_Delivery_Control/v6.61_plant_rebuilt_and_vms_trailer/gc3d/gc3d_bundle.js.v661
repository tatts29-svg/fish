    add([[.28,.33,q*.320],[0,.475,q*.220]],false,'body');
    add([[-.70,.36,q*.305],[-.47,.475,q*.205]],false,'body');
    add(curve([[.42,.168,q*.383],[.22,.19,q*.389],[-.22,.193,q*.390],[-.36,.205,q*.385]]),false,'dim',.65);
    /* Window seal, door shut line and a small mirror identify the coupe in a side/quarter view.
       These secondary lines have no glow, so the see-through body stays legible. */
