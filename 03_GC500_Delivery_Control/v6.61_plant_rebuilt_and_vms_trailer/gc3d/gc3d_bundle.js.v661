  patch('windscreen-26','number',(u,v)=>{
    const along=mix(.88,.59,v),w=mix(-.36,-.80,u),x=mix(.268,-.042-.014*Math.pow(w,4),along),half=mix(.324,.258,along);
    return [x+.017*(1-w*w)*Math.sin(along*Math.PI),mix(.332,.478,along)+(.010+.025*along)*(1-w*w),w*half];
