      for(let j=0;j<TS;j++)branch(trunkPoint(j/TS),trunkPoint((j+1)/TS),r*(.064-.030*j/TS),r*(.064-.030*(j+1)/TS),near?8:6,.9+.15*Math.sin(j*2.8));
      const crown=trunkPoint(1),leafCol=(u,s)=>{
