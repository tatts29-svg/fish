     the straights is right — a straight is one segment and should be — and at the turns is a single point
     carrying the whole change of direction, up to a hundred and thirty-five degrees of it. Barrier built
     straight off that has a crease at every corner, and no barrier on earth has a crease, because the units are
     laid to a radius.

     So each corner is cut back along both of its edges and the cut is done twice, which rounds it. The cut is
     capped at a third of the shorter edge, so a long straight loses nine metres at each end and stays a
     straight, while a tight corner made of ten-metre segments rounds without collapsing. This is a statement
     about how barrier is laid, not a correction to the drawing: the drawn corner stays where it was drawn. */
  function roundLoop(pts, cut) {
    const n = pts.length;
    if (n < 4) return pts;
    const out = [];
    for (let i = 0; i < n; i++) {
      const q = pts[i], a = pts[(i - 1 + n) % n], b = pts[(i + 1) % n];
      const la = Math.hypot(q[0] - a[0], q[1] - a[1]), lb = Math.hypot(b[0] - q[0], b[1] - q[1]);
      if (la < 1e-6 || lb < 1e-6) { out.push([q[0], q[1]]); continue; }
      const ta = Math.min(cut, la / 3) / la, tb = Math.min(cut, lb / 3) / lb;
      out.push([q[0] + (a[0] - q[0]) * ta, q[1] + (a[1] - q[1]) * ta]);
      out.push([q[0] + (b[0] - q[0]) * tb, q[1] + (b[1] - q[1]) * tb]);
    }
    return out;
  }

  /* An evenly spaced closed line. The drawing's corners are wherever the draughtsman put them, which down a
     straight can be sixty metres apart and in a hairpin two, and a barrier built straight off them has panels
     of both lengths. Resampling first gives every panel the same length, which is what the real ones have. */
  function evenLoop(pts, step) {
    const n = pts.length;
    if (n < 4) return [];
    const cum = [0];
    for (let i = 1; i <= n; i++) {
      const a = pts[i - 1], b = pts[i % n];
      cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));
    }
    const total = cum[n];
    if (!(total > step * 8)) return [];
    const N = Math.max(8, Math.round(total / step)), out = [];
    for (let k = 0; k < N; k++) {
      const want = total * k / N;
      let i = 1; while (i < cum.length && cum[i] < want) i++;
      const a = pts[(i - 1) % n], b = pts[i % n];
      const seg = cum[i] - cum[i - 1] || 1, t = (want - cum[i - 1]) / seg;
      out.push([a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]);
    }
    return out;
  }

  /* One panel of barrier: two faces and a top, split at the orange band so the concrete and the paint come out
     as separate parts with their own material. Mitreless, like the roads — at seven-metre panels the notch on
     the outside of a corner is millimetres, and no join has to be reasoned about. */
  /* WHAT A BARRIER AT THIS EVENT ACTUALLY LOOKS LIKE.

     It was grey concrete with an orange band along the top, which is what a barrier looks like in general and
     is not what one looks like here. Andrew Fisher sent an onboard lap of the circuit on 21 Sep 2026 — a
     simulator rather than a camera, and treated as such, but consistent and detailed — and what stands beside
     this road is an ORANGE HOARDING WITH COATES ACROSS IT, repeating the length of it, on a dark plinth, with
     the catch fencing standing behind. Our own name, on our own barrier, at our own event, and it was not in
     the scene.

     So: a plinth, a hoarding face carrying the wordmark, and the capping on top. The face's UVs run one panel
     every three and a half metres along it and top to bottom across it, which is what lets the wordmark land
     the right way up and the right size however long the panel is. */
  function barrier(low, cap, a, b) {
    let dx = b[0] - a[0], dz = b[1] - a[1];
    const len = Math.hypot(dx, dz);
    if (len < 0.2) return;
    dx /= len; dz /= len;
    const px = -dz * (BAR_W / 2), pz = dx * (BAR_W / 2);
    /* the plinth takes its UVs from the material's own two-metre tile; the hoarding takes a panel of its own */
    const bands = [
      {m: low, y0: 0, y1: BAR_BASE, u: len / 2, v0: 0, v1: BAR_BASE / 2},
      {m: cap, y0: BAR_BASE, y1: BAR_H, u: len / PANEL_M, v0: 0, v1: 1},
    ];
    bands.forEach(bd => {
      const m = bd.m, y0 = bd.y0, y1 = bd.y1, u1 = bd.u, v0 = bd.v0, v1 = bd.v1;
      if (!(y1 > y0)) return;
      /* right of travel: outward normal (dz, -dx), the same construction the building walls use */
      let q0 = m.vert(a[0] - px, y0, a[1] - pz, dz, 0, -dx, 0, v0, dx, 0, dz, 1);
      let q1 = m.vert(b[0] - px, y0, b[1] - pz, dz, 0, -dx, u1, v0, dx, 0, dz, 1);
      let q2 = m.vert(b[0] - px, y1, b[1] - pz, dz, 0, -dx, u1, v1, dx, 0, dz, 1);
      let q3 = m.vert(a[0] - px, y1, a[1] - pz, dz, 0, -dx, 0, v1, dx, 0, dz, 1);
      m.tri(q0, q1, q2); m.tri(q0, q2, q3);
      /* and left of travel, walked the other way about so its normal faces out too. The wordmark is drawn the
         way round the traveller sees it on each side, which is why this face runs b to a rather than a to b. */
      q0 = m.vert(b[0] + px, y0, b[1] + pz, -dz, 0, dx, 0, v0, -dx, 0, -dz, 1);
      q1 = m.vert(a[0] + px, y0, a[1] + pz, -dz, 0, dx, u1, v0, -dx, 0, -dz, 1);
      q2 = m.vert(a[0] + px, y1, a[1] + pz, -dz, 0, dx, u1, v1, -dx, 0, -dz, 1);
      q3 = m.vert(b[0] + px, y1, b[1] + pz, -dz, 0, dx, 0, v1, -dx, 0, -dz, 1);
      m.tri(q0, q1, q2); m.tri(q0, q2, q3);
    });
    /* The capping, across the top. It is aimed at a strip of the texture the wordmark is kept out of — v
       between 0.02 and 0.08, which the material leaves plain on purpose — because nobody reads a wordmark edge
       on and a letter sliced lengthways looks like a mistake. */
    const uT = len / 2;
    const t0 = cap.vert(a[0] + px, BAR_H, a[1] + pz, 0, 1, 0, 0, 0.02, dx, 0, dz, 1);
    const t1 = cap.vert(a[0] - px, BAR_H, a[1] - pz, 0, 1, 0, 0, 0.08, dx, 0, dz, 1);
    const t2 = cap.vert(b[0] - px, BAR_H, b[1] - pz, 0, 1, 0, uT, 0.08, dx, 0, dz, 1);
    const t3 = cap.vert(b[0] + px, BAR_H, b[1] + pz, 0, 1, 0, uT, 0.02, dx, 0, dz, 1);
    cap.tri(t0, t1, t2); cap.tri(t0, t2, t3);
  }


  /* Catch fencing. The mesh itself is not drawn: it would need transparency, and a transparent surface in a
     pass that has none is worse than no surface at all. What is drawn is what the eye actually reads at this
     distance — the posts, and the horizontal members running between them. */
  function fenceRails(m, a, b) {
    let dx = b[0] - a[0], dz = b[1] - a[1];
    const len = Math.hypot(dx, dz);
    if (len < 0.2) return;
    dx /= len; dz /= len;
    for (let k = 0; k < FEN_RAILS; k++) {
      const y = BAR_H + FEN_H * (k + 0.6) / FEN_RAILS, y0 = y - FEN_R, y1 = y + FEN_R;
      const q0 = m.vert(a[0], y0, a[1], dz, 0, -dx, 0, 0, dx, 0, dz, 1);
      const q1 = m.vert(b[0], y0, b[1], dz, 0, -dx, len / 2, 0, dx, 0, dz, 1);
      const q2 = m.vert(b[0], y1, b[1], dz, 0, -dx, len / 2, 1, dx, 0, dz, 1);
      const q3 = m.vert(a[0], y1, a[1], dz, 0, -dx, 0, 1, dx, 0, dz, 1);
      m.tri(q0, q1, q2); m.tri(q0, q2, q3);
    }
  }
  function fencePost(m, at, dx, dz) {
    const r = FEN_POST / 2;
    const ax = dx * r, az = dz * r, bx = -dz * r, bz = dx * r;     /* along, and across */
    const y0 = BAR_H, y1 = BAR_H + FEN_H, vh = FEN_H / 2;
    /* walked so that each face's normal comes out pointing away from the post's middle */
    const c = [[ax + bx, az + bz], [-ax + bx, -az + bz], [-ax - bx, -az - bz], [ax - bx, az - bz]];
    for (let i = 0; i < 4; i++) {
      const p = c[i], q = c[(i + 1) % 4];
      let ex = q[0] - p[0], ez = q[1] - p[1];
      const l = Math.hypot(ex, ez); if (l < 1e-6) continue;
      ex /= l; ez /= l;
      const nx = ez, nz = -ex;
      const v0 = m.vert(at[0] + p[0], y0, at[1] + p[1], nx, 0, nz, 0, 0, ex, 0, ez, 1);
      const v1 = m.vert(at[0] + q[0], y0, at[1] + q[1], nx, 0, nz, 1, 0, ex, 0, ez, 1);
      const v2 = m.vert(at[0] + q[0], y1, at[1] + q[1], nx, 0, nz, 1, vh, ex, 0, ez, 1);
      const v3 = m.vert(at[0] + p[0], y1, at[1] + p[1], nx, 0, nz, 0, vh, ex, 0, ez, 1);
      m.tri(v0, v1, v2); m.tri(v0, v2, v3);
    }
  }

  /* WHY THE RINGS ARE CLEANED BEFORE ANYTHING IS BUILT FROM THEM.

     OpenStreetMap closes a way by repeating its first node as its last, and mappers leave corners that sit on
     top of each other or in a dead straight line. None of that is wrong as map data and all of it is wrong as
     geometry: a repeated corner makes a triangle with no area, and the runtime refuses a mesh containing one —
     correctly, because a zero-area triangle has no normal, so its shading and its silhouette edge are both
     undefined. The answer is to give it geometry that is right, not to ask it to accept geometry that is not.

     So: coincident corners are merged, the repeated closing corner is dropped, and corners that lie on the
     straight line between their neighbours are removed. What is left is the same shape with nothing in it that
     cannot be shaded. */
  const EPS_M = 0.02;                   /* two corners closer than 2 cm are the same corner */
  const FLAT_M2 = 0.01;                 /* a corner this close to the line through its neighbours is on it */

  function readPts(r, from, fr) {
    const o = [];
    for (let i = from; i + 1 < r.length; i += 2) o.push([fr.toX(r[i]), fr.toZ(r[i + 1])]);
    return o;
  }
  function dedupe(pts) {
    const o = [];
    for (const p of pts) {
      const q = o[o.length - 1];
      if (!q || Math.hypot(p[0] - q[0], p[1] - q[1]) > EPS_M) o.push(p);
    }
    return o;
  }
  function cleanRing(pts) {
    let r = dedupe(pts);
    /* the repeated closing corner */
    while (r.length > 1 && Math.hypot(r[0][0] - r[r.length - 1][0], r[0][1] - r[r.length - 1][1]) <= EPS_M) r.pop();
    /* corners on the straight line between their neighbours, until none is left */
    let changed = true;
    while (changed && r.length > 3) {
      changed = false;
      for (let i = 0; i < r.length; i++) {
        const a = r[(i + r.length - 1) % r.length], b = r[i], c = r[(i + 1) % r.length];
        const cross = Math.abs((b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]));
        if (cross <= FLAT_M2) { r.splice(i, 1); changed = true; break; }
      }
    }
    return r;
  }

  /* ---------------------------------------------------------------- the features, read once */

  /* The pack's rows, turned into the few numbers a tile needs: where the thing is, how big it is, and its
     points in metres. Read once per pack and kept, because every tile asks the same questions of it. */
  function readFeatures(pk, fr, ring) {
    const bs = [], rs = [];
    (pk.b || []).forEach(r => {
      const top = r[0] * fr.U * fr.m, base = r[1] * fr.U * fr.m;
      const ring = cleanRing(readPts(r, 2, fr));
      if (ring.length < 3) return;
      let cx = 0, cz = 0;
      ring.forEach(p => { cx += p[0]; cz += p[1]; });
      bs.push({ring, base, top, h: top - base, cx: cx / ring.length, cz: cz / ring.length});
    });
    (pk.roads || []).forEach((r, i) => {
      const w = Math.max(3, (r[0] || 2) * 3.2);            /* the pack's class number, as a width in metres */
      const line = dedupe(readPts(r, 1, fr));
      if (line.length < 2) return;
      const mid = line[Math.floor(line.length / 2)];
      /* WHY EACH ROAD SITS AT ITS OWN HEIGHT.

         Two ribbons at exactly the same height fight for the same pixels wherever they overlap, and in a city
         they overlap constantly — a carriageway drawn twice, a service road along a main one, every junction.
         What that looks like on screen is pale stripes flickering down the road, which is what the first shots
         down the main straight showed. A centimetre or two of separation, decided by the road rather than by
         the order it happens to be drawn in, settles it for good. Nobody can see two centimetres from a camera
         four metres up; everybody can see the stripes. */
      rs.push({line, w, cx: mid[0], cz: mid[1], lift: ((i * 2654435761) >>> 28) * 0.015});
    });
    return {buildings: bs, roads: rs, furniture: readFurniture(ring, fr)};
  }

  /* The circuit edges, as a flat list of panels. Each one carries its own midpoint so it falls into a tile the
     same way a building or a road does — by where its middle is, not by where it happens to reach. */
  function readFurniture(ring, fr) {
    if (!ring) return [];
    const toM = p => [(p[0] - fr.cx) * fr.m, (p[1] - fr.cz) * fr.m];
    const out = [];
    [['outer', ring.outer || []], ['inner', ring.inner || []]].forEach(pair => {
      const side = pair[0], raw = pair[1];
      if (!Array.isArray(raw) || raw.length < 12) return;
      /* three passes: the first takes the bulk off, the next two turn what is left into an arc. A hairpin
         drawn as one point carries a hundred and thirty-five degrees, and two passes still left a visible
         crease in it. */
      let loop = dedupe(raw.map(toM));
      loop = roundLoop(roundLoop(roundLoop(loop, BAR_CUT), BAR_CUT / 2), BAR_CUT / 4);
      loop = evenLoop(loop, BAR_STEP);
      const n = loop.length;
      for (let i = 0; i < n; i++) {
        const a = loop[i], b = loop[(i + 1) % n];
        if (Math.hypot(b[0] - a[0], b[1] - a[1]) < 0.2) continue;
        /* the fencing goes on the outside, which is the side the crowd is on and the side the camera sees */
        out.push({a, b, fence: side === 'outer', post: side === 'outer' && i % POST_EVERY === 0,
                  cx: (a[0] + b[0]) / 2, cz: (a[1] + b[1]) / 2});
      }
    });
    return out;
  }

  /* ---------------------------------------------------------------- the tree */

  function cellOf(root, level, ix, iz) {
    const n = 1 << level;
    const w = (root.max[0] - root.min[0]) / n, d = (root.max[2] - root.min[2]) / n;
    return {x0: root.min[0] + ix * w, x1: root.min[0] + (ix + 1) * w,
            z0: root.min[2] + iz * d, z1: root.min[2] + (iz + 1) * d};
  }
  const inCell = (c, x, z) => x >= c.x0 && x < c.x1 && z >= c.z0 && z < c.z1;

  /* What a tile holds. The same function answers "how many triangles" and "give me the geometry", so the
     number the tree advertises and the number the payload delivers can never disagree — the adapter refuses
     the tile if they do, and it is right to. */
  function buildTile(F, root, level, ix, iz) {
    const c = cellOf(root, level, ix, iz);
    const minH = MIN_H[Math.min(level, MIN_H.length - 1)], minW = MIN_W[Math.min(level, MIN_W.length - 1)];
    const walls = [new Mesh(), new Mesh(), new Mesh(), new Mesh()], road = new Mesh();
    let top = 0;
    F.buildings.forEach(b => {
      if (b.h < minH || !inCell(c, b.cx, b.cz)) return;
      const off = shuffle(b.cx, b.cz);
      building(walls[off.pick], b.ring, b.base, b.top, off);
      if (b.top > top) top = b.top;
    });
    F.roads.forEach(r => {
      if (r.w < minW || !inCell(c, r.cx, r.cz)) return;
      ribbon(road, r.line, r.w, r.lift);
    });
    /* The barriers and the fencing, on every level but the highest one. They are what tells a reader this is a
       race circuit rather than a city, so they are drawn wherever they would be seen. */
    const bar = new Mesh(), cap = new Mesh(), fen = new Mesh();
    if (level >= FURN_FROM) {
      (F.furniture || []).forEach(f => {
        if (!inCell(c, f.cx, f.cz)) return;
        barrier(bar, cap, f.a, f.b);
        if (!f.fence) return;
        fenceRails(fen, f.a, f.b);
        if (!f.post) return;
        let dx = f.b[0] - f.a[0], dz = f.b[1] - f.a[1];
        const l = Math.hypot(dx, dz) || 1;
        fencePost(fen, f.a, dx / l, dz / l);
      });
    }
    const parts = [];
    walls.forEach((m, i) => { if (m.triangles()) parts.push(m.part(FACADES[i])); });
    if (road.triangles()) parts.push(road.part('asphalt'));
    if (bar.triangles()) parts.push(bar.part('barrier-concrete'));
    if (cap.triangles()) parts.push(cap.part('barrier-coates'));
    if (fen.triangles()) parts.push(fen.part('kerb'));
    /* THE BOUNDS ARE THE GEOMETRY'S, NOT THE CELL'S.

       A feature belongs to the cell its centre falls in, and a building straddles a cell edge as happily as a
       road runs clean across four of them. Bounds drawn tight to the cell would therefore describe a box the
       geometry sticks out of — which the runtime refuses, and is right to: the selector culls by these bounds
       and would cull away geometry that is on screen. Sibling tiles overlapping each other is normal and
       costs nothing; a tile lying about its own extent is not. */
    const lo = [Infinity, Infinity, Infinity], hi = [-Infinity, -Infinity, -Infinity];
    walls.concat([road, bar, cap, fen]).forEach(m => {
      if (!m.triangles()) return;
      for (let i = 0; i < 3; i++) { if (m.lo[i] < lo[i]) lo[i] = m.lo[i]; if (m.hi[i] > hi[i]) hi[i] = m.hi[i]; }
    });
    const empty = !(lo[0] <= hi[0]);
    const bounds = empty
      ? {min: [c.x0, 0, c.z0], max: [c.x1, 1, c.z1]}          /* nothing in it: the cell, so it is still a box */
      : {min: [lo[0], Math.min(0, lo[1]), lo[2]], max: [hi[0], Math.max(1, hi[1]), hi[2]]};
    /* counted off the parts themselves, so the number the tree advertises cannot drift from the number the
       payload delivers however many meshes get added here later */
    const triangles = parts.reduce((n, p) => n + p.indices.length / 3, 0);
    return {cell: c, parts, triangles, top, bounds};
  }

  /* the corner rounding is shared: the camera flies the same traced ring and has the same creases in it */
  T.roundLoop = roundLoop;

  /* HOW TALL THINGS ARE, ANYWHERE, IN ONE LOOKUP.

     The camera has to know what is in front of it, and asking two and a half thousand footprints that question
     twelve thousand times a lap is not a thing to do at mount. So the footprints are stamped once into a coarse
     grid of heights — eight metres to a cell, the width of a lane — and after that it is one array read.

     A cell counts as built on when its CENTRE is inside a footprint, so the grid never claims ground that is
     not built on. It can miss a sliver at a corner, which for deciding how high a camera flies is the harmless
     direction to be wrong in. */
  const HF_CELL = 8;
  function inPoly(px, pz, ring) {
    let c = false;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const a = ring[j], b = ring[i];
      if ((b[1] > pz) !== (a[1] > pz) && px < (a[0] - b[0]) * (pz - b[1]) / (a[1] - b[1]) + b[0]) c = !c;
    }
    return c;
  }
  T.heightField = function (built) {
    if (built.field) return built.field;
    const B = built.features.buildings;
    let x0 = Infinity, z0 = Infinity, x1 = -Infinity, z1 = -Infinity;
    B.forEach(b => b.ring.forEach(q => {
      if (q[0] < x0) x0 = q[0]; if (q[0] > x1) x1 = q[0];
      if (q[1] < z0) z0 = q[1]; if (q[1] > z1) z1 = q[1];
    }));
    if (!(x0 <= x1)) return (built.field = {at: () => 0});
    const nx = Math.ceil((x1 - x0) / HF_CELL) + 1, nz = Math.ceil((z1 - z0) / HF_CELL) + 1;
    const H = new Float32Array(nx * nz);
    B.forEach(b => {
      let bx0 = Infinity, bz0 = Infinity, bx1 = -Infinity, bz1 = -Infinity;
      b.ring.forEach(q => {
        if (q[0] < bx0) bx0 = q[0]; if (q[0] > bx1) bx1 = q[0];
        if (q[1] < bz0) bz0 = q[1]; if (q[1] > bz1) bz1 = q[1];
      });
      const i0 = Math.max(0, Math.floor((bx0 - x0) / HF_CELL)), i1 = Math.min(nx - 1, Math.ceil((bx1 - x0) / HF_CELL));
      const j0 = Math.max(0, Math.floor((bz0 - z0) / HF_CELL)), j1 = Math.min(nz - 1, Math.ceil((bz1 - z0) / HF_CELL));
      for (let i = i0; i <= i1; i++) for (let j = j0; j <= j1; j++) {
        if (b.top <= H[j * nx + i]) continue;
        if (inPoly(x0 + (i + 0.5) * HF_CELL, z0 + (j + 0.5) * HF_CELL, b.ring)) H[j * nx + i] = b.top;
      }
    });
    built.field = {at: (px, pz) => {
      const i = Math.round((px - x0) / HF_CELL - 0.5), j = Math.round((pz - z0) / HF_CELL - 0.5);
      return (i < 0 || j < 0 || i >= nx || j >= nz) ? 0 : H[j * nx + i];
    }};
    return built.field;
  };

  T.idOf = (level, ix, iz) => 'gc500/' + level + '/' + ix + '/' + iz;
  T.parseId = id => { const m = /^gc500\/(\d+)\/(\d+)\/(\d+)$/.exec(String(id || '')); 
    return m ? {level: +m[1], ix: +m[2], iz: +m[3]} : null; };

  /* The tree, with real bounds, a real triangle count and a geometric error that falls with depth. The error
     is the height of the shortest building the level leaves out — the size of the thing you would notice
     missing — rather than a number picked to make the selector behave. */
  T.tree = function (pk, reg, ring) {
    const fr = frameOf(pk, reg);
    const F = readFeatures(pk, fr, ring);
    const root = {min: fr.min.slice(), max: fr.max.slice()};
    /* BOTTOM UP, because a parent has to CONTAIN its children.

       A coarse tile holds only the tall buildings, so the extent of what it draws is smaller than the extent of
       what its children draw — and a parent box that does not enclose its children is a box the selector can
       cull while the region behind it is still on screen. The runtime checks for exactly this and refuses the
       tree, which is the check doing its job. So each node's bounds are the union of its own geometry and
       everything below it. */
    const union = (a, b) => ({
      min: [Math.min(a.min[0], b.min[0]), Math.min(a.min[1], b.min[1]), Math.min(a.min[2], b.min[2])],
      max: [Math.max(a.max[0], b.max[0]), Math.max(a.max[1], b.max[1]), Math.max(a.max[2], b.max[2])],
    });
    const node = (level, ix, iz) => {
      const t = buildTile(F, root, level, ix, iz);
      const err = level >= T.LEVELS - 1 ? 0 : MIN_H[Math.min(level, MIN_H.length - 1)];
      const out = {id: T.idOf(level, ix, iz), triangles: t.triangles, geometricError: err, bounds: t.bounds};
      if (level + 1 < T.LEVELS) {
        out.children = [node(level + 1, ix * 2, iz * 2), node(level + 1, ix * 2 + 1, iz * 2),
                        node(level + 1, ix * 2, iz * 2 + 1), node(level + 1, ix * 2 + 1, iz * 2 + 1)];
        out.children.forEach(c => { out.bounds = union(out.bounds, c.bounds); });
