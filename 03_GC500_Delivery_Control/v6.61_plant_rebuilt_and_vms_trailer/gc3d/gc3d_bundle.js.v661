/* GC3D part 1 — core: maths, WebGL2 helpers, shaders, batches.
   GC500 show scene in 3D. Author: Andrew Fisher · Coates Industrial Solutions · GC500 */
(function(){
'use strict';
const G = window.GC3D = {ver:'1.8',origFrame:(window.GC3D&&window.GC3D.origFrame)||null,noGuard:!!(window.GC3D&&window.GC3D.noGuard)};

/* ---------- maths (column-major 4x4) ---------- */
const V = G.V = {
  add:(a,b)=>[a[0]+b[0],a[1]+b[1],a[2]+b[2]], sub:(a,b)=>[a[0]-b[0],a[1]-b[1],a[2]-b[2]],
  mul:(a,s)=>[a[0]*s,a[1]*s,a[2]*s], dot:(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2],
  cross:(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]],
  len:a=>Math.hypot(a[0],a[1],a[2]),
  norm:a=>{const l=Math.hypot(a[0],a[1],a[2])||1;return [a[0]/l,a[1]/l,a[2]/l];},
  lerp:(a,b,t)=>[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t]
};
G.persp = function(fovy,asp,n,f,sx,sy){
  const t=1/Math.tan(fovy/2),o=new Float32Array(16);
  o[0]=t/asp;o[5]=t;o[10]=(f+n)/(n-f);o[11]=-1;o[14]=2*f*n/(n-f);
  o[8]=-(sx||0);o[9]=-(sy||0);            /* lens shift: the target sits off-centre, clear of the text */
  return o;
};
G.lookAt = function(e,c,u){
  const f=V.norm(V.sub(c,e)),s=V.norm(V.cross(f,u)),up=V.cross(s,f),o=new Float32Array(16);
  o[0]=s[0];o[4]=s[1];o[8]=s[2];o[12]=-V.dot(s,e);
  o[1]=up[0];o[5]=up[1];o[9]=up[2];o[13]=-V.dot(up,e);
  o[2]=-f[0];o[6]=-f[1];o[10]=-f[2];o[14]=V.dot(f,e);o[15]=1;
  return o;
};
G.matMul = function(a,b){
  const o=new Float32Array(16);
  for(let c=0;c<4;c++)for(let r=0;r<4;r++){let s=0;for(let k=0;k<4;k++)s+=a[k*4+r]*b[c*4+k];o[c*4+r]=s;}
  return o;
};
G.smooth = t=>{t=Math.max(0,Math.min(1,t));return t*t*t*(t*(t*6-15)+10);};
G.rng = function(seed){let s=seed>>>0||1;return ()=>((s=(s*16807)%2147483647)/2147483647);};

/* ---------- shaders ---------- */
const LINE_VS = `#version 300 es
precision highp float;
layout(location=0) in vec2 aC;
layout(location=1) in vec3 aA;
layout(location=2) in vec3 aB;
layout(location=3) in vec4 aColA;
layout(location=4) in vec4 aColB;
layout(location=5) in vec3 aW;
uniform mat4 uVP; uniform vec2 uView; uniform float uPx; uniform float uNear; uniform vec2 uFog; uniform float uGain; uniform float uBias;
/* v5.65 — one colour for every line in the scene, so a look can say what the city is drawn in. uTintMix 0
   leaves every authored colour exactly as it was, which is what all three earlier looks pass. At 1 the line
   keeps its own BRIGHTNESS and takes the look's colour: the street grid, the building edges, the route and
   the car's trail all become one wireframe world in that colour, which is what the Coates orange look is. */
uniform vec3 uTint; uniform float uTintMix;
vec3 tinted(vec3 c){ return mix(c, vec3(dot(c, vec3(.299,.587,.114))) * uTint, uTintMix); }
/* v5.79 — HOW MUCH LIGHT A LINE KEEPS ONCE IT IS THINNER THAN A PIXEL. A line is drawn no thinner than its
   pixel floor (aW.z) and dimmed by how far it fell short of that, so a lit edge seen from the air does not
   burn as bright as it does from the car. The dimming stops at uThin, and a look sets it: .3 is what every
   look had, and the day keeps it — by day the city's lines are meant to fade into the distance. After Dark
   asks for the opposite (see G.LOOKS.showcase): a value above 1 means a line that has gone thinner than a
   pixel is drawn BRIGHTER than its width would make it, easing back to its own brightness as it reaches a
   pixel wide — the way a small bright light reads to a camera from far off — because a lit circuit seen from
   1.7 km up IS a bright ribbon through the city and at .3, with the night no longer lifted by a display curve,
   it was a thread nobody could see. Below 1 the old clamp is kept exactly, so the day is drawn as it was. */
uniform float uThin;
flat out vec4 vColA; flat out vec4 vColB; flat out vec2 vSA; flat out vec2 vSB; flat out vec2 vR;
void main(){
  vec4 pa=uVP*vec4(aA,1.), pb=uVP*vec4(aB,1.);
  vColA=vec4(0.);vColB=vec4(0.);vSA=vec2(0.);vSB=vec2(0.);vR=vec2(1.);
  if(pa.w<uNear&&pb.w<uNear){gl_Position=vec4(0.,0.,2.,1.);return;}
  if(pa.w<uNear){float t=(uNear-pa.w)/(pb.w-pa.w);pa=mix(pa,pb,t);}
  else if(pb.w<uNear){float t=(uNear-pb.w)/(pa.w-pb.w);pb=mix(pb,pa,t);}
  vec2 sa=(pa.xy/pa.w*.5+.5)*uView, sb=(pb.xy/pb.w*.5+.5)*uView;
  float wa=aW.x*uPx/pa.w, wb=aW.y*uPx/pb.w;
  float ra=max(wa,aW.z), rb=max(wb,aW.z);
  float ta=wa/max(aW.z,1e-3), tb=wb/max(aW.z,1e-3);
  float fa=(1.-smoothstep(uFog.x,uFog.y,pa.w))*(uThin<=1.?clamp(ta,uThin,1.):mix(uThin,1.,smoothstep(0.,1.,ta)));
  float fb=(1.-smoothstep(uFog.x,uFog.y,pb.w))*(uThin<=1.?clamp(tb,uThin,1.):mix(uThin,1.,smoothstep(0.,1.,tb)));
  vColA=vec4(tinted(aColA.rgb),aColA.a*fa*uGain); vColB=vec4(tinted(aColB.rgb),aColB.a*fb*uGain);
  vSA=sa; vSB=sb; vR=vec2(ra,rb);
  vec2 d=sb-sa; float L=length(d); vec2 dir=L>1e-3?d/L:vec2(1.,0.); vec2 n=vec2(-dir.y,dir.x);
  float r=mix(ra,rb,aC.x)+1.;
  vec2 s=mix(sa,sb,aC.x)+n*aC.y*r+dir*(aC.x*2.-1.)*r;
  vec4 p=mix(pa,pb,aC.x);
  /* A bounded world-space lift stays small even with the close camera's short near plane. */
  p.z-=min(uBias,.015)*2.*uNear/max(p.w,.01);
  gl_Position=vec4((s/uView*2.-1.)*p.w,p.z,p.w);
}`;
const LINE_FS = `#version 300 es
precision highp float;
flat in vec4 vColA; flat in vec4 vColB; flat in vec2 vSA; flat in vec2 vSB; flat in vec2 vR;
uniform float uSoft; uniform float uAlpha;
out vec4 o;
void main(){
  vec2 p=gl_FragCoord.xy, d=vSB-vSA; float L2=dot(d,d);
  float t=L2>1e-4?clamp(dot(p-vSA,d)/L2,0.,1.):0.;
  float r=max(mix(vR.x,vR.y,t),.35);
  float x=length(p-(vSA+d*t))/r;
  float a=uSoft>.5?exp(-x*x*3.2)*(1.-smoothstep(.75,1.,x)):1.-smoothstep(max(0.,1.-1.2/r),1.,x);
  vec4 c=mix(vColA,vColB,t);
  o=vec4(c.rgb*(c.a*a),c.a*a*uAlpha);
}`;
/* The same filtered visibility function serves the city and ground. The depth texture stores
   ordinary light-space depth, with NEAREST filtering and no comparison sampler state required. */
const SHADOW_SAMPLE = `
uniform highp sampler2D uShadow; uniform mat4 uLightVP; uniform float uShadowOn; uniform vec2 uShadowTexel;
float sunlight(vec3 world,vec3 normal){
  if(uShadowOn<.5)return 1.;
  vec4 p=uLightVP*vec4(world,1.);
  if(p.w<=0.)return 1.;
  vec3 q=p.xyz/p.w*.5+.5;
  if(q.x<=0.||q.x>=1.||q.y<=0.||q.y>=1.||q.z<=0.||q.z>=1.)return 1.;
  float slope=1.-max(dot(normalize(normal),normalize(vec3(.45,.80,.40))),0.);
  float bias=.00032+.0011*slope;
  float lit=0.;
  for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
    vec2 uv=q.xy+vec2(float(x),float(y))*uShadowTexel;
    /* Samples beyond the map must not borrow a dark clamped edge. */
    if(uv.x<=0.||uv.x>=1.||uv.y<=0.||uv.y>=1.)lit+=1.;
    else lit+=step(q.z-bias,texture(uShadow,uv).r);
  }
  return lit/9.;
}`;
const MESH_VS = `#version 300 es
precision highp float;
layout(location=0) in vec3 aPos; layout(location=1) in vec3 aNrm; layout(location=2) in vec3 aUVH; layout(location=3) in float aGlow;
uniform mat4 uVP;
out vec3 vN; out vec3 vUVH; out float vGlow; out float vW; out float vY; out vec3 vWorld; flat out float vSeed;
void main(){vec4 p=uVP*vec4(aPos,1.);gl_Position=p;vN=aNrm;vUVH=aUVH;vGlow=aGlow;vW=p.w;vY=aPos.y;vWorld=aPos;vSeed=aUVH.z;}`;
const MESH_FS = `#version 300 es
precision highp float;
in vec3 vN; in vec3 vUVH; in float vGlow; in float vW; in float vY; in vec3 vWorld; flat in float vSeed;
uniform vec2 uFog; uniform vec3 uSun; uniform vec2 uWin; uniform float uWinGain; uniform float uDay; uniform vec3 uEye;
/* v5.65 — THE BUILDINGS TAKE THE LOOK'S WORD FOR IT, LIKE EVERY OTHER SURFACE.
   Every other surface in this scene is drawn through a look's own tint and lift; the city was the one thing
   that was not, so no look could say how bright its buildings were. It was found from the Coates orange look,
   where the whole picture was supposed to go to near black under an orange wireframe and the beachfront simply
   stayed lit: blacking out all eleven of the look's materials changed the ground and left the city exactly as
   it was. Default is 1 and 0, so the three looks that pass nothing are drawn byte for byte as they were. */
uniform vec3 uBTint; uniform vec3 uBLift;
out vec4 o;
${SHADOW_SAMPLE}
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float pane(float x,float lo,float hi,float aa){return smoothstep(lo-aa,lo+aa,x)*(1.-smoothstep(hi-aa,hi+aa,x));}
float facadeNoise(vec2 p){
  vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
  return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.)),f.x),f.y);
}
vec3 facadeReflection(vec3 R){
  /* One continuous, analytic environment for every facade. The soft skyline is generic
     reflected colour, not a reconstruction or a claim of scene-correct reflections. */
  vec3 sky=mix(vec3(.36,.54,.65),vec3(.055,.215,.42),smoothstep(0.,.82,R.y));
  vec2 cp=R.xz/(.48+max(R.y,0.))*2.2+vec2(8.,13.);
  float cloud=facadeNoise(cp)*.65+facadeNoise(cp*2.1)*.25+facadeNoise(cp*4.3)*.10;
  float clouds=smoothstep(.53,.73,cloud)*smoothstep(-.04,.22,R.y);
  sky=mix(sky,vec3(.76,.78,.75),clouds*.66);
  float az=atan(R.z,R.x)*4.7,cell=floor(az),u=fract(az);
  float angularAA=max(fwidth(az),.012);
  float crown=.025+.19*hash(vec2(cell,17.));
  float skyline=pane(u,.055,.94,angularAA)*(1.-smoothstep(crown-.025,crown+.025,R.y));
  skyline*=smoothstep(-.38,-.055,R.y);
  skyline*=1.-smoothstep(.25,.70,angularAA);
  sky=mix(sky,vec3(.095,.145,.17),skyline*.77);
  return mix(vec3(.055,.07,.07),sky,smoothstep(-.40,.015,R.y));
}
void main(){
  vec3 N=normalize(vN);
  float top=step(.5,N.y);
  float sun=max(dot(N,uSun),0.);
  float lam=.55+.45*sun;
  vec3 nightBase=mix(vec3(.066,.086,.098),vec3(.105,.132,.146),top);
  vec3 col=nightBase*lam*(.85+.45*clamp(vY/14.,0.,1.));
  if(uDay<.5){
    col+=vec3(1.,.42,.08)*vGlow*(1.-top)*exp(-vY*.5)*.5;
    col+=vec3(1.,.42,.08)*vGlow*top*.06;
    if(top<.5){
    vec2 q=vec2(vUVH.x/uWin.x,vY/uWin.y); vec2 c=floor(q), f=fract(q);
    float fw=max(fwidth(q.x),fwidth(q.y));
    float vis=1.-smoothstep(.22,.55,fw);
    float lit=step(.80,hash(c+vSeed*37.));
    float m=smoothstep(.16,.26,f.x)*(1.-smoothstep(.74,.84,f.x))*smoothstep(.2,.3,f.y)*(1.-smoothstep(.7,.8,f.y));
    float cool=step(.78,hash(c*1.7+vSeed));
    col+=mix(vec3(1.,.64,.30),vec3(.72,.84,1.),cool)*lit*m*vis*uWinGain;
    col+=vec3(.018,.026,.030)*(1.-lit)*m*vis;
    col+=vec3(1.,.68,.35)*.085*uWinGain*(1.-vis);
    }
  }else{
    /* Generic coastal materials are anchored to the existing facade UVs and building seed.
       They describe surface finish only: no extra storeys, balconies or landmark geometry. */
    /* Material IDs must not be perspective interpolated: tiny rounding differences entering a
       high-gain hash can flip the facade style between adjacent pixels, even on one triangle. */
    float seed=vSeed,variation=hash(vec2(seed*37.19,seed*83.71));
    float curtain=step(.56,variation);
    vec3 concrete=mix(vec3(.36,.40,.405),vec3(.62,.565,.445),variation);
    /* Roof fragments at the same source elevation share a finish, even when OSM podium shells
       overlap. Their coincident pixels must not fight between two different material colours. */
    float roofSeed=hash(vec2(floor(vY*20.+.5),41.3));
    vec3 roof=mix(vec3(.255,.28,.285),vec3(.47,.445,.365),roofSeed);
    float visibility=sunlight(vWorld,N);
    float ambient=.26+.10*max(N.y,0.);
    vec3 litConcrete=concrete*(ambient+.80*sun*visibility);
    litConcrete+=vec3(.010,.023,.038)*(1.-sun*.7);
    float foot=.74+.26*smoothstep(0.,2.3,vY);
    col=mix(litConcrete,roof*(.37+.73*sun*visibility),top)*foot;
    if(top<.5){
      vec2 q=vec2(vUVH.x/max(uWin.x,.01),vY/max(uWin.y,.01));
      vec2 c=floor(q),f=fract(q),aa=max(fwidth(q),vec2(.002));
      float detail=1.-smoothstep(.22,.68,max(aa.x,aa.y));
      float margin=mix(.115,.021,curtain);
      float sillY=mix(.10,.036,curtain),headY=mix(.88,.958,curtain);
      float window=pane(f.x,margin,1.-margin,aa.x)*pane(f.y,sillY,headY,aa.y);
      /* Average coverage replaces subpixel windows, so fine panes do not sparkle at distance. */
      window=mix(mix(.60,.88,curtain),window,detail);
      vec3 view=normalize(uEye-vWorld),R=reflect(-view,N);
      float fres=.075+.80*pow(1.-clamp(dot(N,view),0.,1.),5.);
      vec3 sky=facadeReflection(R);
      float room=hash(c+vec2(seed*79.,seed*31.));
      float cell=mix(1.,.91+.16*room,detail);
      vec3 glass=mix(vec3(.015,.036,.046),vec3(.025,.060,.073),variation);
      glass=mix(glass,sky,.29+fres*.60)*cell;
      glass*=.72+.28*visibility;
      /* Quiet blinds sit behind the glazing. Their shade and top-down coverage are coherent
         inside a pane, and disappear into average coverage before becoming subpixel noise. */
      float blind=step(.73,room)*smoothstep(mix(.38,.82,room)-aa.y,mix(.38,.82,room)+aa.y,f.y)*detail;
      glass=mix(glass,glass*.68+vec3(.035,.033,.025),blind*.55*(1.-fres));
      float jamb=pane(f.x,margin,margin+.033,aa.x)*detail;
      float head=pane(f.y,headY-.062,headY,aa.y)*detail;
      glass*=1.-.24*max(jamb,head)*(1.-curtain*.42);
      vec3 halfV=normalize(view+uSun);
      float shine=pow(max(dot(N,halfV),0.),76.)*.28*visibility;
      glass+=vec3(1.,.91,.74)*shine;
      col=mix(col,glass,window);
      /* A shallow storey band adds perceived depth without changing the source envelope. */
      float band=pane(f.y,.005,sillY*.7,aa.y)*detail*(1.-curtain*.6);
      col*=1.-band*.27;
      float sill=pane(f.y,sillY-.022,sillY+.010,aa.y)*detail;
      col+=concrete*sill*.115*(.4+.6*sun*visibility);
    }
  }
  /* the look's word, applied to the finished facade rather than to one of its ingredients, so windows,
     glass, roofs and concrete all come down together and the building keeps its own shading */
  col=col*uBTint+uBLift;
  float haze=smoothstep(uFog.x*.62,uFog.y,vW)*uDay;
  col=mix(col,vec3(.67,.76,.80),haze*.22);
  float a=1.-smoothstep(uFog.x,uFog.y,vW);
  o=vec4(col*a,a);
}`;
const FLAT_VS = `#version 300 es
precision highp float;
layout(location=0) in vec3 aPos; layout(location=1) in vec4 aCol; layout(location=2) in vec2 aUV;
uniform mat4 uVP;
out vec4 vCol; out vec2 vUV; out float vW; out vec2 vP; out vec3 vWorld;
void main(){vec4 p=uVP*vec4(aPos,1.);gl_Position=p;vCol=aCol;vUV=aUV;vW=p.w;vP=aPos.xz;vWorld=aPos;}`;
const FLAT_FS = `#version 300 es
precision highp float;
in vec4 vCol; in vec2 vUV; in float vW; in vec2 vP; in vec3 vWorld;
uniform float uMode; uniform vec2 uFog; uniform float uTime; uniform vec3 uTint; uniform vec3 uLift; uniform vec3 uEye; uniform float uDay;
out vec4 o;
${SHADOW_SAMPLE}
float hash21(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float noise21(vec2 p){
  vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
  return mix(mix(hash21(i),hash21(i+vec2(1.,0.)),f.x),mix(hash21(i+vec2(0.,1.)),hash21(i+vec2(1.,1.)),f.x),f.y);
}
float surfaceDetail(vec2 p){return 1.-smoothstep(.22,.85,max(fwidth(p.x),fwidth(p.y)));}
void main(){
  float fg=1.-smoothstep(uFog.x,uFog.y,vW); float a=vCol.a*fg; vec3 base=vCol.rgb*uTint+uLift;
  /* v5.48 — A FRAGMENT THAT HAS FADED TO NOTHING MUST NOT STILL WRITE DEPTH. Every mode below multiplies
     its colour by fg (or by a, which carries fg), so once the atmosphere has taken a fragment to zero it
     contributes no colour at all - but it was still being depth-tested and written, and so it went on
     OCCLUDING whatever stood behind it. The facade detail added in v1.7 sits about half a metre proud of
     the wall it decorates, so at distance its invisible ledges punched a hole clean through their own
     building and the empty sky showed through as a hard-edged dark slab across the skyline. It only
     showed in Day Race, where there is a bright facade to lose; at night there was nothing there to miss.
     Found by measuring the approved look (docs/look_baseline): the day chase frame went from every pixel
     drawn to 5% of it empty. Discarding on distance alone is safe for every mode, additive ones included,
     because a fragment at fg 0 adds nothing under either blend equation. */
  /* v5.50 — MODE 9 IS A STENCIL MASK AND IS NEVER DISCARDED. The water, beach and park rings are drawn
     once with colour writes off purely to set the stencil, and their vertices carry alpha 0 because they
     are never meant to be seen. The discard below, added in v5.48 for depth, threw those fragments away
     before they could write the stencil - so no hole was cut in the city floor and not one of the three
     fills drew, by day or by night: the Broadwater, the Nerang and the canals were grey land from 1.8 km
     up. Measured by holding the water quad back (nothing changed), then read here. */
  if(uMode>8.5&&uMode<9.5){o=vec4(0.);return;}
  if(a<=.002&&(uMode<.5||uMode>2.5)) discard;   /* a carries both the vertex alpha and the fog. Modes 1 and 2
     are additive and are left alone, since they read a as brightness rather than as coverage. */
  if(uMode<.5){
    float lit=uDay>.5?mix(.60,1.,sunlight(vWorld,vec3(0.,1.,0.))):1.;
    o=vec4(base*lit*a,a);
  }                                                                                   /* 0: plain, alpha-blended */
  else if(uMode<1.5){float f=max(0.,1.-length(vUV));o=vec4(base*(a*f*f),0.);}           /* 1: a pool of light, added */
  else if(uMode<2.5){o=vec4(base*a,0.);}                                                /* 2: plain light, added */
  else if(uMode<3.5){                                                                   /* 3: water, with a slow glint */
    vec2 q=vP*.9, c=floor(q), f=fract(q)-.5; float hs=fract(sin(dot(c,vec2(127.1,311.7)))*43758.5453);
    float g=step(.94,hs)*(.5+.5*sin(uTime*1.6+hs*50.))*(1.-smoothstep(.04,.34,length(f)))*clamp(50./max(vW,.01),0.,1.)*(1.-smoothstep(.3,.7,fwidth(q.x)));
    vec3 water=base+vec3(.10,.16,.22)*g;
    if(uDay>.5){
      /* Two small, continuous wave slopes supply a quiet reflected sky; no animated noise. */
      float w1=dot(vP,vec2(.71,.38))*2.2+uTime*.62;
      float w2=dot(vP,vec2(-.31,.83))*3.4-uTime*.44;
      float ripple=1.-smoothstep(.4,1.3,max(fwidth(w1),fwidth(w2)));
      vec3 N=normalize(vec3((cos(w1)*.030-cos(w2)*.018)*ripple,1.,(cos(w1)*.020+cos(w2)*.027)*ripple));
      vec3 view=normalize(uEye-vWorld),R=reflect(-view,N),sun=normalize(vec3(.45,.80,.40));
      float fres=.025+.62*pow(1.-clamp(dot(N,view),0.,1.),5.);
      vec3 sky=mix(vec3(.65,.78,.83),vec3(.22,.46,.65),smoothstep(0.,.8,R.y));
      water=mix(base*.94,sky,fres);
      float spec=pow(max(dot(N,normalize(view+sun)),0.),150.);
      water+=vec3(1.,.92,.76)*(spec*.20+g*.032);
      water*=mix(.66,1.,sunlight(vWorld,N));
    }
    o=vec4(water*a,a);
  }
  else if(uMode<4.5){                                                                    /* 4: asphalt in both lighting modes, static material */
    /* One scene point is 5.9376 m. Fine aggregate belongs at centimetre scale, not the
       broad billowy noise of the previous surface. Every high frequency fades before aliasing. */
    vec2 grainP=vP*220.,aggregateP=vP*68.;
    float grain=(noise21(grainP)-.5)*(1.-smoothstep(.18,.80,max(fwidth(grainP.x),fwidth(grainP.y))));
    float aggregate=(noise21(aggregateP)-.5)*(1.-smoothstep(.20,.85,max(fwidth(aggregateP.x),fwidth(aggregateP.y))));
    float grade=noise21(vP*1.7)-.5;
    float stone=smoothstep(.63,.87,noise21(aggregateP*1.73))*surfaceDetail(aggregateP*1.73);
    float lit=mix(.60,1.,sunlight(vWorld,vec3(0.,1.,0.)));
    vec3 asphalt=(base*(1.+grain*.30+aggregate*.18+grade*.065)+vec3(.012,.013,.014)*stone)*lit;
    /* An opaque road still fades with the same distant atmosphere as the city. */
    o=vec4(asphalt*fg,fg);
  }                                                                                    /* end 4 */
  else if(uMode<5.5){                                                                  /* 5: dry cast concrete */
    vec3 raw=cross(dFdx(vWorld),dFdy(vWorld)),N=raw/max(length(raw),.000001);
    if(dot(N,uEye-vWorld)<0.)N=-N;
    vec3 an=abs(N);
    vec2 p=an.y>max(an.x,an.z)?vWorld.xz:(an.x>an.z?vWorld.zy:vWorld.xy);
    vec2 poresP=p*110.,gritP=p*31.;
    float pores=smoothstep(.61,.84,noise21(poresP))*surfaceDetail(poresP);
    float grit=(noise21(gritP)-.5)*surfaceDetail(gritP);
    float casting=noise21(p*3.4)-.5;
    float vertical=1.-abs(N.y);
    float weather=(noise21(vec2(p.x*13.,p.y*.7))-.5)*vertical;
    float foot=1.-smoothstep(.03,.16,vWorld.y);
    float direct=max(dot(N,normalize(vec3(.45,.80,.40))),0.);
    float lit=.39+.61*direct*sunlight(vWorld,N);
    vec3 concrete=base*(1.+casting*.105+grit*.15+weather*.12-pores*.18);
    concrete=mix(concrete,concrete*vec3(.73,.72,.66),foot*.21*vertical);
    o=vec4(concrete*lit*a,a);
  }
  else if(uMode<6.5){                                                                  /* 6: quiet coastal grass */
    vec2 bladeP=vP*140.,thatchP=vP*26.;
    float blades=(noise21(bladeP)-.5)*surfaceDetail(bladeP);
    float thatch=(noise21(thatchP)-.5)*surfaceDetail(thatchP);
    float clump=noise21(vP*1.2),dry=smoothstep(.59,.79,noise21(vP*.61+vec2(12.,7.)));
    vec3 grass=base*(.86+clump*.26+blades*.23+thatch*.13);
    grass=mix(grass,grass*vec3(1.24,.96,.66)+vec3(.015,.007,0.),dry*.27);
    float lit=mix(.55,1.,sunlight(vWorld,vec3(0.,1.,0.)));
    o=vec4(grass*lit*a,a);
  }
  else if(uMode<7.5){                                                                  /* 7: dry coastal sand */
    vec2 grainP=vP*180.;
    float grain=(noise21(grainP)-.5)*surfaceDetail(grainP);
    float dune=noise21(vP*.72)-.5;
    float phase=dot(vP,vec2(42.,13.))+noise21(vP*3.)*1.4;
    float ripple=sin(phase)*(1.-smoothstep(.35,1.3,fwidth(phase)));
    vec3 sand=base*(1.+grain*.14+dune*.09+ripple*.025);
    float lit=mix(.64,1.,sunlight(vWorld,vec3(0.,1.,0.)));
    o=vec4(sand*lit*a,a);
  }
  else if(uMode>9.5&&uMode<10.5){
    /* v5.66 — 10: RUBBER ON THE ROAD. Andrew Fisher, 22 Sep 2026: on the day and night looks, smoke and
       rubber marks when drifting round corners.

       A strip laid flat where a rear tyre actually slid. vUV.x runs along it and vUV.y across it, so the edges
       fade rather than ending in a straight line, and a little noise along its length breaks up the even
       darkness a plain quad would give — hot rubber does not lay down at one weight. It is alpha, not
       additive: rubber DARKENS the road, and an additive mark can only ever lighten it, which is the reason
       the smoke that was already here could not be seen against daylight. */
    /* ACROSS ONLY. Feathering along the strip as well was wrong and it showed: vUV.x runs 0 to 1 within each
       SEGMENT, not along the whole slide, so an end-fade on x took every segment to nothing at both ends and
       turned a continuous mark into a row of fading dots. A tyre lays rubber evenly along its path and stops
       where it stops; only the sides of the contact patch feather. */
    float across=1.-smoothstep(.62,1.,abs(vUV.y*2.-1.));
    float mottle=.72+.28*noise21(vec2(vUV.x*70.,vUV.y*6.));
    float cover=across*mottle;
    a*=cover;
    if(a<=.004) discard;
    o=vec4(base*a,a);
  }
  else if(uMode>10.5){
    /* v5.66 — 11: TYRE SMOKE. A round, soft, alpha-blended puff, drifting and thinning with age. The falloff
       is squared so the middle carries the body and the rim goes to nothing, and a slow turn of noise across
       it keeps a cluster of puffs from reading as a row of circles. */
    float d=length(vUV*2.-1.);
    float f=1.-smoothstep(.0,1.,d); f*=f;
    float curl=.74+.26*noise21(vUV*3.4+vec2(uTime*.11,uTime*.07));
    a*=f*curl;
    if(a<=.003) discard;
    o=vec4(base*a,a);
  }
  else{ /* 8: catch fencing, derivative-filtered physical wire spacing in metres. */
    vec2 period=vec2(.10,.15),p=vUV/period,fw=max(fwidth(p),vec2(.00001));
    vec2 dist=abs(fract(p+.5)-.5),halfWire=vec2(.0035)/period*.5;
    vec2 wire=1.-smoothstep(halfWire-fw*.65,halfWire+fw*.65,dist);
    vec2 unresolved=smoothstep(vec2(.45),vec2(1.3),fw);
    wire=mix(wire,vec2(.0035)/period,unresolved);
    float coverage=1.-(1.-wire.x)*(1.-wire.y);a*=coverage;
    if(a<.006)discard;
    o=vec4(base*mix(.35,1.,uDay)*a,a);
  }
}`;

const SHADOW_VS = `#version 300 es
precision highp float;
layout(location=0) in vec3 aPos;
uniform mat4 uVP;
void main(){gl_Position=uVP*vec4(aPos,1.);}`;
const SHADOW_FS = `#version 300 es
precision highp float;
void main(){}`;


/* ---------- post: a real bloom, so the neon glows instead of being drawn wide and soft ---------- */
const POST_VS = `#version 300 es
precision highp float;
out vec2 vUV;
void main(){vec2 p=vec2(float((gl_VertexID<<1)&2),float(gl_VertexID&2));vUV=p;gl_Position=vec4(p*2.-1.,0.,1.);}`;
const BRIGHT_FS = `#version 300 es
precision highp float;
in vec2 vUV; uniform sampler2D uTex; uniform vec2 uTexel; uniform float uThresh;
out vec4 o;
void main(){
  vec3 c=vec3(0.);
  c+=texture(uTex,vUV+uTexel*vec2(-1.,-1.)).rgb; c+=texture(uTex,vUV+uTexel*vec2(1.,-1.)).rgb;
  c+=texture(uTex,vUV+uTexel*vec2(-1.,1.)).rgb;  c+=texture(uTex,vUV+uTexel*vec2(1.,1.)).rgb;
  c*=.25;
  float l=max(c.r,max(c.g,c.b));
  o=vec4(c*(max(0.,l-uThresh)/max(l,1e-4)),1.);
}`;
const BLUR_FS = `#version 300 es
precision highp float;
in vec2 vUV; uniform sampler2D uTex; uniform vec2 uDir;
out vec4 o;
void main(){
  vec3 c=texture(uTex,vUV).rgb*.2270270;
  c+=(texture(uTex,vUV+uDir*1.3846153).rgb+texture(uTex,vUV-uDir*1.3846153).rgb)*.3162162;
  c+=(texture(uTex,vUV+uDir*3.2307692).rgb+texture(uTex,vUV-uDir*3.2307692).rgb)*.0702702;
  o=vec4(c,1.);
}`;
const COMP_FS = `#version 300 es
precision highp float;
in vec2 vUV; uniform sampler2D uScene; uniform sampler2D uBloom; uniform sampler2D uBloom2; uniform highp sampler2D uDepth; uniform float uK; uniform float uDay;
uniform vec4 uProjection; uniform vec2 uClip; uniform vec2 uPixel; uniform float uAO; uniform float uNightGain; uniform float uNightGamma; uniform float uNightKnee;
uniform vec3 uCamRight; uniform vec3 uCamUp; uniform vec3 uCamForward;
out vec4 o;
float depthAt(vec2 uv){float z=texture(uDepth,uv).r*2.-1.;return 2.*uClip.x*uClip.y/(uClip.y+uClip.x-z*(uClip.y-uClip.x));}
vec3 viewAt(vec2 uv){float d=depthAt(uv);return vec3((uv*2.-1.+uProjection.zw)*d/uProjection.xy,-d);}
/* Depth-based ambient contact shade in scene units. Fixed sample directions and no
   time/noise input keep held views still. Balanced disables this extra sampling. */
float ambientContact(vec3 p){
  if(uAO<.5||-p.z>90.||texture(uDepth,vUV).r>.999995)return 1.;
  /* Wider, one-sided depth differences avoid 24-bit quantisation stripes at the very short
     near plane used by close cameras. Choose the side least likely to cross an object edge. */
  vec2 stepUV=uPixel*5.;
  vec3 left=p-viewAt(vUV-vec2(stepUV.x,0.)),right=viewAt(vUV+vec2(stepUV.x,0.))-p;
  vec3 down=p-viewAt(vUV-vec2(0.,stepUV.y)),up=viewAt(vUV+vec2(0.,stepUV.y))-p;
  vec3 dx=abs(left.z)<abs(right.z)?left:right,dy=abs(down.z)<abs(up.z)?down:up;
  vec3 n=normalize(cross(dx,dy));
  if(n.z<0.)n=-n;
  /* Contact-scale radius: the previous 6.5 m reach stamped separated car silhouettes
     onto the road in distant Grid views. Keep this local to surface junctions. */
  float radius=.20,occlusion=0.,weight=0.;
  vec2 reach=min(radius*uProjection.xy/max(-p.z*2.,.01),vec2(.015));
  for(int i=0;i<12;i++){
    float fi=float(i),angle=fi*2.39996323;
    vec2 uv=vUV+vec2(cos(angle),sin(angle))*reach*sqrt((fi+.5)/12.);
    if(uv.x<0.||uv.y<0.||uv.x>1.||uv.y>1.)continue;
    vec3 delta=viewAt(uv)-p;float d=length(delta);
    float valid=step(.012,d)*(1.-smoothstep(radius*.72,radius,d));
    occlusion+=max(dot(n,delta/max(d,.0001))-.14,0.)*valid;
    weight+=1.;
  }
  return 1.-clamp(occlusion/max(weight,1.)*2.5,0.,.34)*smoothstep(1.,3.,-p.z)*(1.-smoothstep(55.,90.,-p.z));
}
float skyHash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float skyNoise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(skyHash(i),skyHash(i+vec2(1.,0.)),f.x),mix(skyHash(i+vec2(0.,1.)),skyHash(i+vec2(1.,1.)),f.x),f.y);}
vec3 daylightSky(){
  vec2 xy=(vUV*2.-1.+uProjection.zw)/uProjection.xy;
  vec3 ray=normalize(uCamForward+uCamRight*xy.x+uCamUp*xy.y);
  float y=max(ray.y,0.);
  vec3 sky=mix(vec3(.32,.53,.70),vec3(.075,.235,.48),pow(clamp(y,0.,1.),.48));
  vec2 q=ray.xz/max(ray.y+.12,.12)*.62+vec2(14.2,6.7);
  float cloud=skyNoise(q)*.55+skyNoise(q*2.07)*.28+skyNoise(q*4.13)*.12+skyNoise(q*8.1)*.05;
  cloud=smoothstep(.53,.75,cloud)*smoothstep(.015,.16,y)*.68;
  sky=mix(sky,vec3(.91,.94,.95),cloud);
  float angle=max(dot(ray,normalize(vec3(.45,.80,.40))),0.);
  return sky+vec3(1.,.82,.58)*pow(angle,60.)*.11;
}
void main(){
  vec4 s=texture(uScene,vUV);
  vec3 b=texture(uBloom,vUV).rgb*.62+texture(uBloom2,vUV).rgb*.85;
  vec3 col=s.rgb+b*uK;
  float a=clamp(s.a+max(b.r,max(b.g,b.b))*uK*.55,0.,1.);
  if(uDay>.5){
    col=s.rgb*ambientContact(viewAt(vUV))+b*uK;
    /* Camera-direction sky is part of the engine frame and PNG export. */
    col+=daylightSky()*(1.-a);a=1.;
    /* Day materials are linear light. Tone-map the unassociated colour and convert to display
       sRGB, then restore premultiplication. Shadows keep contrast without crushing the city. */
    vec3 x=max(col/max(a,.001),vec3(0.));
    x=clamp((x*(2.51*x+.03))/(x*(2.43*x+.59)+.14),0.,1.);
    vec3 srgb=mix(x*12.92,1.055*pow(x,vec3(1./2.4))-.055,step(vec3(.0031308),x));
    o=vec4(srgb*a,a);
  }else{
    /* Both profiles carry physical linear-light surfaces. The night is exposed by its look: a gain on the
       linear frame, a roll-off whose knee the look sets, then a display curve whose exponent the look sets.
       The defaults (gain 1, knee .60, exponent 2.4) are the v1.8 port's sRGB night as it stood from v5.50 to
       v5.78; the build Andrew Fisher approved on 17 Sep 2026 (hosted-52) had no display curve at all and a
       .30 knee, and G.LOOKS.showcase asks for that again — v5.79, where the night went, and came back. */
    vec3 x=max(col/max(a,.001),vec3(0.))*uNightGain;x=clamp(x/(1.+x*uNightKnee),0.,1.);
    vec3 srgb=pow(x,vec3(1./max(uNightGamma,.2)));
    o=vec4(srgb*a,a);
  }
}`;
G.makeTarget=function(gl,w,h,depth){
  /* v5.47, and again after the v1.8 port put this file back to its cached form — AN EXTENSION IS ENABLED PER
     CONTEXT, NOT ONCE. The answer used to be cached on G, so after a backdrop switch tore the scene down and
     built a new context, the new one was told it had a float buffer it had never asked for: RGBA16F then
     failed, the framebuffer came back incomplete, and BLOOM SILENTLY TURNED ITSELF OFF on whichever of the two
     looks was mounted second. Caught both times by measuring the approved look frame by frame
     (docs/look_baseline) rather than by looking at it — the picture just quietly lost its glow.
     The answer is now asked of the context in front of us and cached on that context, so it travels with it. */
  if(gl.__gc3dHdr===undefined)gl.__gc3dHdr=!!(gl.getExtension('EXT_color_buffer_float')||gl.getExtension('EXT_color_buffer_half_float'));
  G.hdr=gl.__gc3dHdr;                                        /* kept for anything that reads it, but the context decides */
  const t={tex:gl.createTexture(),fb:gl.createFramebuffer(),w:w,h:h};
  gl.bindTexture(gl.TEXTURE_2D,t.tex);
  if(gl.__gc3dHdr)gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA16F,w,h,0,gl.RGBA,gl.HALF_FLOAT,null);
  else gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA8,w,h,0,gl.RGBA,gl.UNSIGNED_BYTE,null);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
  gl.bindFramebuffer(gl.FRAMEBUFFER,t.fb);
  gl.framebufferTexture2D(gl.FRAMEBUFFER,gl.COLOR_ATTACHMENT0,gl.TEXTURE_2D,t.tex,0);
  if(depth){t.depthTex=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,t.depthTex);
    gl.texImage2D(gl.TEXTURE_2D,0,gl.DEPTH24_STENCIL8,w,h,0,gl.DEPTH_STENCIL,gl.UNSIGNED_INT_24_8,null);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.NEAREST);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
    gl.framebufferTexture2D(gl.FRAMEBUFFER,gl.DEPTH_STENCIL_ATTACHMENT,gl.TEXTURE_2D,t.depthTex,0);}
  const ok=gl.checkFramebufferStatus(gl.FRAMEBUFFER)===gl.FRAMEBUFFER_COMPLETE;
  gl.bindFramebuffer(gl.FRAMEBUFFER,null);gl.bindTexture(gl.TEXTURE_2D,null);
  if(!ok){gl.deleteTexture(t.tex);if(t.depthTex)gl.deleteTexture(t.depthTex);gl.deleteFramebuffer(t.fb);return null;}return t;
};
G.freeTarget=function(gl,t){if(!t)return;gl.deleteTexture(t.tex);gl.deleteFramebuffer(t.fb);if(t.rb)gl.deleteRenderbuffer(t.rb);if(t.depthTex)gl.deleteTexture(t.depthTex);};

/* ---------- GL helpers ---------- */
function compile(gl,type,src){
  const s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);
  if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw new Error('GC3D shader: '+gl.getShaderInfoLog(s));
  return s;
}
function program(gl,vs,fs,names){
  const p=gl.createProgram();gl.attachShader(p,compile(gl,gl.VERTEX_SHADER,vs));gl.attachShader(p,compile(gl,gl.FRAGMENT_SHADER,fs));
  gl.linkProgram(p);if(!gl.getProgramParameter(p,gl.LINK_STATUS))throw new Error('GC3D link: '+gl.getProgramInfoLog(p));
  const u={};names.forEach(n=>u[n]=gl.getUniformLocation(p,n));return {p,u};
}
G.makePrograms = function(gl){
  return {
    line:program(gl,LINE_VS,LINE_FS,['uVP','uView','uPx','uNear','uFog','uGain','uBias','uSoft','uAlpha','uTint','uTintMix','uThin']),
    mesh:program(gl,MESH_VS,MESH_FS,['uVP','uFog','uSun','uWin','uWinGain','uDay','uEye','uShadow','uLightVP','uShadowOn','uShadowTexel','uBTint','uBLift']),
    flat:program(gl,FLAT_VS,FLAT_FS,['uVP','uFog','uMode','uTime','uTint','uLift','uEye','uDay','uShadow','uLightVP','uShadowOn','uShadowTexel']),
    shadow:program(gl,SHADOW_VS,SHADOW_FS,['uVP']),
    bright:program(gl,POST_VS,BRIGHT_FS,['uTex','uTexel','uThresh']),
    blur:program(gl,POST_VS,BLUR_FS,['uTex','uDir']),
    comp:program(gl,POST_VS,COMP_FS,['uScene','uBloom','uBloom2','uK','uDay','uDepth','uProjection','uClip','uPixel','uAO','uCamRight','uCamUp','uCamForward','uNightGain','uNightGamma','uNightKnee'])
  };
};

/* A batch of glowing line segments: one instance per segment, 17 floats each. */
const LS=17;
G.LineBatch = class{
  constructor(gl,quad,cap,dynamic){
    this.gl=gl;this.cap=cap||256;this.n=0;this.data=new Float32Array(this.cap*LS);this.dynamic=!!dynamic;
    this.vao=gl.createVertexArray();this.buf=gl.createBuffer();
    gl.bindVertexArray(this.vao);
    gl.bindBuffer(gl.ARRAY_BUFFER,quad);gl.enableVertexAttribArray(0);gl.vertexAttribPointer(0,2,gl.FLOAT,false,0,0);
    gl.bindBuffer(gl.ARRAY_BUFFER,this.buf);gl.bufferData(gl.ARRAY_BUFFER,this.data.byteLength,dynamic?gl.DYNAMIC_DRAW:gl.STATIC_DRAW);
    const at=(loc,size,off)=>{gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,size,gl.FLOAT,false,LS*4,off*4);gl.vertexAttribDivisor(loc,1);};
    at(1,3,0);at(2,3,3);at(3,4,6);at(4,4,10);at(5,3,14);
    gl.bindVertexArray(null);this.size=this.data.byteLength;
  }
  clear(){this.n=0;}
  /* a,b: [x,y,z]; ca,cb: [r,g,b,a]; ra,rb: world radius at each end; mp: minimum radius in pixels */
  seg(a,b,ca,cb,ra,rb,mp){
    if(this.n>=this.cap){const d=new Float32Array(this.cap*2*LS);d.set(this.data);this.data=d;this.cap*=2;}
    const d=this.data,o=this.n++*LS;
    d[o]=a[0];d[o+1]=a[1];d[o+2]=a[2];d[o+3]=b[0];d[o+4]=b[1];d[o+5]=b[2];
    d[o+6]=ca[0];d[o+7]=ca[1];d[o+8]=ca[2];d[o+9]=ca[3];d[o+10]=cb[0];d[o+11]=cb[1];d[o+12]=cb[2];d[o+13]=cb[3];
    d[o+14]=ra;d[o+15]=rb;d[o+16]=mp||0;
  }
  poly(pts,col,r,mp,closed){const n=pts.length;for(let i=0;i<(closed?n:n-1);i++)this.seg(pts[i],pts[(i+1)%n],col,col,r,r,mp);}
  upload(){
    const gl=this.gl;gl.bindBuffer(gl.ARRAY_BUFFER,this.buf);
    if(this.data.byteLength>this.size){gl.bufferData(gl.ARRAY_BUFFER,this.data.byteLength,this.dynamic?gl.DYNAMIC_DRAW:gl.STATIC_DRAW);this.size=this.data.byteLength;}
    gl.bufferSubData(gl.ARRAY_BUFFER,0,this.data,0,this.n*LS);
  }
  draw(){if(!this.n)return;const gl=this.gl;gl.bindVertexArray(this.vao);gl.drawArraysInstanced(gl.TRIANGLE_STRIP,0,4,this.n);}
};

/* An indexed triangle batch; stride and attribute layout given by the caller. */
G.MeshBatch = class{
  constructor(gl,layout,dynamic){
    this.gl=gl;this.layout=layout;this.stride=layout.reduce((s,l)=>s+l,0);this.dynamic=!!dynamic;
    this.v=[];this.i=[];this.nv=0;this.ni=0;this.vao=gl.createVertexArray();this.vb=gl.createBuffer();this.ib=gl.createBuffer();
    gl.bindVertexArray(this.vao);gl.bindBuffer(gl.ARRAY_BUFFER,this.vb);gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,this.ib);
    let off=0;layout.forEach((sz,loc)=>{gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,sz,gl.FLOAT,false,this.stride*4,off*4);off+=sz;});
    gl.bindVertexArray(null);
  }
  clear(){this.v.length=0;this.i.length=0;this.nv=0;}
  vert(){for(let k=0;k<arguments.length;k++)this.v.push(arguments[k]);return this.nv++;}
  tri(a,b,c){this.i.push(a,b,c);}
  upload(){
    const gl=this.gl,use=this.dynamic?gl.DYNAMIC_DRAW:gl.STATIC_DRAW;
    gl.bindVertexArray(this.vao);
    gl.bindBuffer(gl.ARRAY_BUFFER,this.vb);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(this.v),use);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,this.ib);gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,new Uint32Array(this.i),use);
    gl.bindVertexArray(null);this.ni=this.i.length;
  }
  draw(){if(!this.ni)return;const gl=this.gl;gl.bindVertexArray(this.vao);gl.drawElements(gl.TRIANGLES,this.ni,gl.UNSIGNED_INT,0);}
};
})();
/* GC3D — render quality, multisample resolve and cached directional sunlight.
   These are rendering resources only: no path, speed, sound or director state is changed. */
(function(){
'use strict';
const G=window.GC3D;
G.QUALITY={
  balanced:{name:'balanced',label:'Balanced',samples:2,shadow:1024,scale:1,ao:false,dpr:1.5,pixels:1800000},
  high:{name:'high',label:'High',samples:4,shadow:2048,scale:1,ao:true,dpr:2,pixels:3200000},
  ultra:{name:'ultra',label:'Ultra',samples:4,shadow:3072,scale:1.25,ao:true,dpr:2,pixels:6000000}
};
G.setQuality=function(name,automatic){
  const S=G.S,Q=G.QUALITY[name==='auto'?(G.openingQuality?G.openingQuality():'high'):name];if(!S||!Q)return false;
  S.quality=Q;S.needsRender=true;
  if(!automatic){S.qualityChoice=name;S.reflOff=false;S.shadowOff=false;S.bloom=true;S.o.ss=1;S.qualityStep=null;
    if(S.sunShadow&&!S.sunShadow.ok)S.sunShadow.size=0;}
  return G.graphicsReport();
};
/* Bound the actual GPU workload before allocating five render targets. The car geometry is retained. */
G.renderSize=function(width,height,dpr,Q,ss,max,exportSize){
  const scale=Math.min(Math.max(1,dpr||1),Q.dpr||2)*(ss||1)*Q.scale;
  let w=exportSize?exportSize[0]:Math.max(2,width*scale),h=exportSize?exportSize[1]:Math.max(2,height*scale);
  const limit=Math.min(1,max/w,max/h,Math.sqrt((exportSize?9000000:Q.pixels||3200000)/(w*h)));
