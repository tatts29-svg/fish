  /* v5.66 — THE RUBBER, BUILT FROM WHAT THE STEP RECORDED. Two strips, one per rear tyre, each segment a
     quad between two recorded contact points with its own across-the-strip UV so the shader can feather the
     edges. Only points from the same run are joined; a new run starts a new strip. Everything fades on age,
     so a long showcase cleans itself up rather than ending with the circuit scribbled over. */
  const mk=S.marks;
  if(mk){
    mk.clear();
    const list=m.marks||[],hw=(T.markWide||.092)*Sx,y=H+.0035,col=[.040,.036,.034];
    for(let i=1;i<list.length;i++){
      const a2=list[i-1],b2=list[i];
      if(a2.run!==b2.run)continue;
      const fa=1-(clock-a2.c)/T.markLife_s,fb=1-(clock-b2.c)/T.markLife_s;
      if(fa<=0&&fb<=0)continue;
      const aa=Math.min(1,Math.max(0,fa)*a2.w*T.markDark),ab=Math.min(1,Math.max(0,fb)*b2.w*T.markDark);
      if(aa<=.004&&ab<=.004)continue;
