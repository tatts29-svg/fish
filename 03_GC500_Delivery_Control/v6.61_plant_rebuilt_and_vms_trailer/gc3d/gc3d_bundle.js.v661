  };
  const tree=(x,z,scale,decorative=false,source='mapped tree point')=>{
    if(S.distToTrack(x,z)<3.2)return;                       /* never on the racing surface */
    const r=(.62+trnd()*.42)*scale,h=(1.15+trnd()*.75)*scale,y0=.06,lean=(trnd()-.5)*.18;
    const tint=.78+trnd()*.44,phase=shapeHash(x,z,1)*Math.PI*2,
