      for(let i=1;i<L.length;i++){const a=L[i-1],b=L[i],d=Math.hypot(b[0]-a[0],b[1]-a[1]);s+=d;
        const w=.5+.5*Math.sin(s*.09-clock*1.15),f=Math.pow(w,3.2);
