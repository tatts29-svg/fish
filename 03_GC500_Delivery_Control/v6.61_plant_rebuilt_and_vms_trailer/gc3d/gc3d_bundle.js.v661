  const ribbon=(mesh,P,width,y,col)=>{
    if(P.length<2)return;const base=mesh.nv,half=width/(2*pk.mPerPt);
    for(let i=0;i<P.length;i++){
      const prev=P[Math.max(0,i-1)],next=P[Math.min(P.length-1,i+1)],cur=P[i];
      let ax=cur[0]-prev[0],az=cur[1]-prev[1],bx=next[0]-cur[0],bz=next[1]-cur[1];
      let al=Math.hypot(ax,az),bl=Math.hypot(bx,bz);
      if(al<1e-6){ax=bx;az=bz;al=bl;}if(bl<1e-6){bx=ax;bz=az;bl=al;}
      ax/=al||1;az/=al||1;bx/=bl||1;bz/=bl||1;
      let nx=-az-bz,nz=ax+bx,nl=Math.hypot(nx,nz);
      if(nl<1e-6){nx=-bz;nz=bx;nl=1;}nx/=nl;nz/=nl;
      const miter=Math.min(half*1.7,half/Math.max(.30,nx*(-bz)+nz*bx));
      mesh.vert(cur[0]-cx+nx*miter,y,cur[1]-cz+nz*miter,...col,0,0);
      mesh.vert(cur[0]-cx-nx*miter,y,cur[1]-cz-nz*miter,...col,1,0);
    }
    for(let i=0;i<P.length-1;i++){const a=base+2*i;mesh.tri(a,a+1,a+3);mesh.tri(a,a+3,a+2);}
  };
  pk.roads.forEach(r=>{const P=pts(r,1),w=[12,8,5.6][Math.min(2,r[0])];
    ribbon(roadShoulder,P,w+3.6,-.009,[.30,.295,.265,1]);
    ribbon(roadSurface,P,w,-.006,[.095,.11,.115,1]);
  });
  land.upload();roadShoulder.upload();roadSurface.upload();
  S.dayLand=land;S.dayRoadShoulder=roadShoulder;S.dayRoadSurface=roadSurface;

  /* Showcase keeps restrained road-light accents over the same physical street surfaces. */
  const rg=new G.LineBatch(gl,S.quad,4096,false),rc=new G.LineBatch(gl,S.quad,8192,false);
  pk.roads.forEach(r=>{const P=pts(r,1).map(p=>[p[0]-cx,.012,p[1]-cz]);
    if(r[0]===0){rg.poly(P,[1,.72,.42,.26],.55,0,false);rc.poly(P,[1,.86,.66,.50],.10,.7,false);}
    else if(r[0]===1){rg.poly(P,[1,.76,.50,.11],.38,0,false);rc.poly(P,[.95,.85,.70,.38],.07,.6,false);}
    else{rc.poly(P,[.60,.72,.80,.38],.05,.5,false);}});
  (pk.coast||[]).forEach(c=>rg.poly(pts(c).map(p=>[p[0]-cx,.012,p[1]-cz]),[.70,.84,.95,.34],.8,0,false));
  rg.upload();rc.upload();S.roadGlow=rg;S.roadCore=rc;
  /* the city's own lights: street lamps along the main roads, a warm point for most low buildings */
  const lt=new G.LineBatch(gl,S.quad,8192,false),rnd=G.rng(23);
  pk.roads.forEach(r=>{if(r[0]>1)return;const P=pts(r,1);let acc=0;for(let i=1;i<P.length;i++){const a=P[i-1],c=P[i],L=Math.hypot(c[0]-a[0],c[1]-a[1]);let d=5-acc;
    while(d<L){const x=a[0]+(c[0]-a[0])*d/L-cx,z=a[1]+(c[1]-a[1])*d/L-cz,q=[x,.25,z];lt.seg(q,q,[1,.80,.50,.85],[1,.80,.50,.85],.30,.30,1.3);d+=5;}acc=(acc+L)%5;}});
  pk.b.forEach(r=>{if(r[0]*.05>2.2||rnd()>.62)return;let x=0,z=0,k=0;for(let i=2;i+1<r.length;i+=2){x+=r[i];z+=r[i+1];k++;}   /* v5.48 — from 2, and never past the end: see the note on blocks above */const q=[x/k*U+ox-cx,r[0]*.05+.1,z/k*U+oy-cz],w=rnd()>.8;
    lt.seg(q,q,w?[.8,.9,1,.55]:[1,.74,.42,.65],w?[.8,.9,1,.55]:[1,.74,.42,.65],.17,.17,1.15);});
  lt.upload();S.cityLights=lt;
  S.streets.clear();S.streets.upload();

  /* flat fills on the ground, drawn through the stencil so rings with islands need no triangulation */
  const fill=(rings,col,mode,kind)=>{const m=new G.MeshBatch(gl,[3,4,2],false),q=new G.MeshBatch(gl,[3,4,2],false);let x0=1e9,x1=-1e9,z0=1e9,z1=-1e9;
    rings.forEach(r=>{const P=pts(r),b=m.nv;P.forEach(p=>{const x=p[0]-cx,z=p[1]-cz;m.vert(x,0,z,0,0,0,0,0,0);if(x<x0)x0=x;if(x>x1)x1=x;if(z<z0)z0=z;if(z>z1)z1=z;});for(let i=1;i<P.length-1;i++)m.tri(b,b+i,b+i+1);});
