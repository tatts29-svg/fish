uniform vec3 uEye;uniform vec3 uColor;uniform float uRough;uniform float uMetal;uniform float uKind;uniform float uPanel;uniform float uDay;uniform float uBrake;uniform float uOpacity;uniform vec2 uFog;uniform sampler2D uAtlas;
