/* GC3D v1.7 — restrained physical facade depth on the existing OSM building shells.
   These are generic architectural details, not surveyed landmark reconstructions. The source
   footprints, top heights and placement remain authoritative. No signage or event sites added. */
(function(){
'use strict';
const G=window.GC3D,load=G.loadPack;
G.loadPack=function(pk){
  const result=load.call(G,pk),S=G.S,mesh=new G.MeshBatch(S.gl,[3,4,2],false),
        U=pk.unit,unit=pk.mPerPt,cx=S.cx,cz=S.cz,seen=new Set(),floorSeen=new Set(),
        stats={buildings:0,floorLedges:0,balconyFronts:0,facadeDividers:0,triangles:0,source:'generic facade detail on existing OSM footprints'};
  const hash=(x,z,k)=>{const q=Math.sin(x*12.9898+z*78.233+k*37.719)*43758.5453;return q-Math.floor(q);};
  const candidates=[];
  for(const [rows,part] of [[pk.b||[],false],[pk.bp||[],true]])for(const row of rows){
    /* v5.48 — every row of a version-2 pack is [top, base, x,y, ...], so the corners start at index 2 for
       both lists, and i+1 is guarded so the ring can never read past the end of its row. */
    const P=[];for(let i=2;i+1<row.length;i+=2)P.push([row[i]*U+pk.ox-cx,row[i+1]*U+pk.oy-cz]);
    if(P.length>2&&Math.hypot(P[0][0]-P[P.length-1][0],P[0][1]-P[P.length-1][1])<1e-5)P.pop();
    const top=row[0]*.05,base=row[1]*.05;              /* v5.48 — the base is in the row for both lists */
    if(P.length<3||top-base<3.1)continue;
    let x=0,z=0,area=0;P.forEach((p,i)=>{x+=p[0];z+=p[1];const q=P[(i+1)%P.length];area+=p[0]*q[1]-q[0]*p[1];});
    x/=P.length;z/=P.length;if(Math.abs(area)<.6)continue;if(area<0)P.reverse();
    const d=Math.min(S.distToTrack(x,z),...P.map(p=>S.distToTrack(p[0],p[1])));
    if(d>36)continue;
    /* Identical shells/parts must not receive competing facade geometry. */
    const key=[Math.round(x*20),Math.round(z*20),Math.round(top*20),Math.round(base*20),Math.round(Math.abs(area)*10)].join(',');
    if(seen.has(key))continue;seen.add(key);
    candidates.push({P,top,base,x,z,d,score:d-Math.min(8,(top-base)*.15)});
  }
  candidates.sort((a,b)=>a.score-b.score);
  const quad=(P,col)=>{const b=mesh.nv;P.forEach(p=>mesh.vert(...p,...col,1,0,0));mesh.tri(b,b+1,b+2);mesh.tri(b,b+2,b+3);};
  /* An oriented small solid at an existing facade: longitudinal range, outward depth and Y. */
  const solid=(a,t,n,u0,u1,d0,d1,y0,y1,col)=>{
    const at=(u,d,y)=>[a[0]+t[0]*u+n[0]*d,y,a[1]+t[1]*u+n[1]*d],
          p=[at(u0,d0,y0),at(u1,d0,y0),at(u1,d1,y0),at(u0,d1,y0),at(u0,d0,y1),at(u1,d0,y1),at(u1,d1,y1),at(u0,d1,y1)];
    for(const ix of [[0,3,2,1],[4,5,6,7],[0,1,5,4],[1,2,6,5],[2,3,7,6],[3,0,4,7]])quad(ix.map(i=>p[i]),col);
  };
  const budget=155000;
  for(const b of candidates.slice(0,72)){
    if(mesh.i.length/3>budget-1000)break;
    const floor=3.1/unit,first=Math.ceil((b.base+.6)/floor)*floor,
          floors=Math.max(1,Math.floor((b.top-first)/floor)),step=Math.max(1,Math.ceil(floors/36)),
          warm=hash(b.x,b.z,8),col=[.43+warm*.09,.45+warm*.065,.43+warm*.04],
          edges=b.P.map((p,i)=>{const q=b.P[(i+1)%b.P.length],dx=q[0]-p[0],dz=q[1]-p[1],len=Math.hypot(dx,dz);return {p,len,t:[dx/len,dz/len],n:[dz/len,-dx/len],i};})
            .filter(e=>e.len>.65&&e.len<24).sort((a,b)=>b.len-a.len).slice(0,10);
    let added=false;
    for(const e of edges){
      const margin=Math.min(.09,e.len*.07),depth=(.52+.30*hash(b.x,b.z,e.i))/unit,
            balcony=hash(b.x,b.z,e.i+30)>.48&&e.len>1.1,thickness=.18/unit;
      for(let f=0;f<floors;f+=step){
        if(mesh.i.length/3>budget-120)break;
