      });
    }
    pf.upload();
  }
  /* Legacy debugging hull. The current surfaced car uses gc3d_3_solid_render.js, which
     suppresses this older hull and the wire construction while preserving drive effects. */
  if(S.solidBody&&!S.hull)S.hull=G.carHull();
  const HU=S.hull,cb=S.solidBody?S.carBody:null,cg=S.solidBody?S.carGlass:null;
  if(S.carBody&&!S.solidBody){S.carBody.clear();S.carBody.upload();S.carGlass.clear();S.carGlass.upload();}
  if(cb&&cg&&HU){
    cb.clear();cg.clear();
    const K=G.V.norm([.40,.80,.45]);
    /* v5.63 — the hull's own base follows the livery above: orange car, black wing. */
    const SK={body:[[.62,.115,.020],1,.30,.13],glass:[[.014,.019,.026],.55,.42,.42],
              wing:[[.030,.031,.034],1,.24,.16],tyre:[[.015,.015,.017],1,.07,.06],driver:[[.055,.058,.065],1,.16,.10]};
    for(let i=0;i<HU.V.length;i++){
      const wp=W(HU.V[i]),n=HU.N[i];let nx0=n[0],ny0=n[1],nz0=n[2];
      const cp=Math.cos(m.pitch),sp=Math.sin(m.pitch),cr=Math.cos(m.roll),sr=Math.sin(m.roll);
      [nx0,ny0]=[nx0*cp+ny0*sp,-nx0*sp+ny0*cp];[ny0,nz0]=[ny0*cr+nz0*sr,-ny0*sr+nz0*cr];
      const nx=P.fwd[0]*nx0+P.rt[0]*nz0,ny=ny0,nz=P.fwd[2]*nx0+P.rt[2]*nz0;
      let vx=eye[0]-wp[0],vy=eye[1]-wp[1],vz=eye[2]-wp[2];const vl=Math.hypot(vx,vy,vz)||1;vx/=vl;vy/=vl;vz/=vl;
      const K4=HU.kind[i],S4=SK[K4]||SK.body;
      const base=(K4==='body'||K4==='wing')?livery(HU.V[i][0],HU.V[i][1],HU.V[i][2]):S4[0];
      const lam=Math.max(0,nx*K[0]+ny*K[1]+nz*K[2]);
      const fres=Math.pow(1-Math.max(0,nx*vx+ny*vy+nz*vz),5.2)*S4[3];
      const hx=K[0]+vx,hy=K[1]+vy,hz=K[2]+vz,hl=Math.hypot(hx,hy,hz)||1;
      const spec=Math.pow(Math.max(0,(nx*hx+ny*hy+nz*hz)/hl),58)*S4[2];
      const up=Math.max(0,-ny);                                   /* the underglow bouncing off the road */
      const sky=Math.max(0,ny);                                   /* a cool sheen where the panels look up */
      const r=base[0]*(.20+1.55*lam)+fres*0.80+spec*0.85+up*.085+sky*.016+.008*idleGlow;
      const g=base[1]*(.20+1.55*lam)+fres*0.31+spec*0.80+up*.034+sky*.026+.003*idleGlow;
      const b=base[2]*(.20+1.55*lam)+fres*0.08+spec*0.74+up*.008+sky*.044;
      cb.vert(wp[0],wp[1],wp[2],r,g,b,1,0,0);
      cg.vert(wp[0],wp[1],wp[2],r*1.15,g*1.15,b*1.25,S4[1],0,0);
    }
    for(let t=0;t<HU.To.length;t+=3)cb.tri(HU.To[t],HU.To[t+1],HU.To[t+2]);
    for(let t=0;t<HU.Tg.length;t+=3)cg.tri(HU.Tg[t],HU.Tg[t+1],HU.Tg[t+2]);
    cb.upload();cg.upload();
  }
  const KIND={body:[[1,.40,.06],.85,[1,.86,.70],1],dim:[[1,.40,.06],.35,[1,.80,.62],.5],wing:[[1,.46,.10],.8,[1,.96,.90],1],num:[[1,.82,.62],.55,[1,1,1],1],mark:[[1,.88,.74],.40,[1,1,1],.95],trim:[[1,.40,.06],0,[1,.53,.21],.68],metal:[[.5,.58,.62],0,[.50,.57,.60],.70],cockpit:[[.5,.58,.62],0,[.66,.70,.72],.54],lens:[[.5,.65,.7],0,[.72,.85,.9],.80]};
  if(L.day){KIND.body[2]=[1,.105,.005];KIND.wing[2]=[1,.135,.010];KIND.dim[2]=[.58,.055,.003];KIND.dim[3]=.74;}
  if(L.day){KIND.trim[2]=[.75,.074,.006];KIND.metal[2]=[.20,.265,.29];}
  const gR=(L.day?.016:.034)*Sx,cR=(L.day?.0042:.0062)*Sx,tR=(L.day?.008:.016)*Sx;
  const detailFade=G.smooth((64-Math.hypot(eye[0]-cc[0],eye[1]-cc[1],eye[2]-cc[2])/Sx)/44);
  const closeDetail=G.smooth((12-Math.hypot(eye[0]-cc[0],eye[1]-cc[1],eye[2]-cc[2])/Sx)/8);
  S.car.tubes.forEach(t=>{
    const K=KIND[t.k],w=t.p.map(W),n=w.length,secondary=t.k==='trim'||t.k==='metal',alpha=t.k==='cockpit'||t.k==='lens'?closeDetail:secondary?detailFade:1,width=t.width||1;
    if(alpha<.01)return;
    for(let i=0;i<(t.closed?n:n-1);i++){const a=w[i],b=w[(i+1)%n],f=face(a,b),g=[K[0][0],K[0][1],K[0][2],K[1]*f*.8],tu=[1,.47,.10,Math.min(1,K[1]*f*1.15)],c=[K[2][0],K[2][1],K[2][2],K[3]*f*alpha];
      if(K[1]>0){gl_.seg(a,b,g,g,gR*width,gR*width,1.0);gl_.seg(a,b,tu,tu,tR*width,tR*width,.7);}
      co.seg(a,b,c,c,cR*width,cR*width,.48);}
  });
  /* The moving shoulder highlight belongs to the optional After Dark Showcase, not Day Race. */
  const sp=m.v/T.vmax,belt=S.car.belt,nb=belt.length,u0=(clock*(.35+.9*sp))%1;
  if(show('shoulder')&&!S.raceCarEnabled)[0,.5].forEach(o=>{const i0=Math.floor(((u0+o)%1)*nb);for(let k=0;k<5;k++){const a=W(belt[(i0+k)%nb]),b=W(belt[(i0+k+1)%nb]),f=1-Math.abs(k-2)/3;
    gl_.seg(a,b,[1,.95,.85,.9*f],[1,.95,.85,.9*f],gR*1.3,gR*1.3,1.6);co.seg(a,b,[1,1,1,f],[1,1,1,f],cR*2.4,cR*2.4,.8);}});
  const br=m.brake;
