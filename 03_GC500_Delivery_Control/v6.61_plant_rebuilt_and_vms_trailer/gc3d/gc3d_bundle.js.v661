    mk.upload();
  }
  /* v5.66 — THE SMOKE, as camera-facing puffs rather than additive dots. Each one grows and thins with age;
     the shader gives it its round falloff and its slow curl. Pale rather than white, because tyre smoke is
     dirty, and lifted a little at night where there is less behind it to read against. */
  const pf=S.puffs;
  if(pf){
    pf.clear();
    if(!reduced&&(m.smoke||[]).length){
      const up=[0,1,0];
      let rx=ev[1]*up[2]-ev[2]*up[1],ry=ev[2]*up[0]-ev[0]*up[2],rz=ev[0]*up[1]-ev[1]*up[0];
      const rl=Math.hypot(rx,ry,rz)||1;rx/=rl;ry/=rl;rz/=rl;
      const ux=ev[1]*rz-ev[2]*ry,uy=ev[2]*rx-ev[0]*rz,uz=ev[0]*ry-ev[1]*rx;
      const dim=L.day?T.smokeDimDay:T.smokeDimNight,tint=L.day?[.80,.79,.77]:[.62,.63,.66];
      /* where the tail lights are, how hard they are lit, and how far their light reaches into the smoke */
      /* v5.71 — AND THE CAMERA CANNOT SIT INSIDE AN OPAQUE CLOUD. Also from the brief, and it is the right
         priority: a readable car first, effects second. A puff within a couple of car lengths of the eye is
         faded out, so a close rig passing through the plume shows the car through it rather than a grey wall. */
      const eyeP=eye;
      const lampOn=!L.day&&m.brake>.15;
      const lamp=lampOn?[P.pos[0]-P.fwd[0]*.95*Sx,P.pos[1],P.pos[2]-P.fwd[2]*.95*Sx,Math.min(.85,m.brake*.9)]:null;
      const lampR2=6.0*Sx*Sx;
      (m.smoke||[]).forEach(s2=>{
        /* v5.71 — each puff carries its own life, size and weight now, because a burnout puff and a wisp off
           one tyre in a corner are not the same puff drawn twice. */
        const age=(clock-s2.c)/(s2.l||T.smokeLife_s);
        if(age<0||age>=1)return;
        /* a steeper falloff than the first pass: at 1.15 the oldest puffs were still carrying enough
           weight that, grown to full size and stacked, they merged into a solid pale bar at the end of the
           plume rather than dissolving. Smoke thins as it spreads. */
        const rr=(.22+age*T.smokeGrow)*Sx*(.60+s2.r*.85)*(s2.k||1),p0=s2.p;
        let a2=Math.min(.95,Math.pow(1-age,1.55)*T.smokeAlpha*(s2.a||1)*dim);
        /* THE CAMERA CANNOT SIT INSIDE AN OPAQUE CLOUD, measured against each puff's OWN size rather than a
           fixed distance. A burnout puff grows to about six car-lengths across, so a fixed radius either does
           nothing to the big ones or guts the small ones — the first attempt used 2.6 to 6.2 car-lengths and
           took the drift plume from 14.5% of the picture down to 3.8%, because the nearest puffs are also the
           largest on screen. Fading only where the eye is within a puff's own radius leaves every plume you
           are looking AT alone and only quiets the one you are looking THROUGH. */
        {const ex=p0[0]-eyeP[0],ey=p0[1]-eyeP[1],ez=p0[2]-eyeP[2],d=Math.sqrt(ex*ex+ey*ey+ez*ez);
         if(d<rr*1.35)a2*=Math.max(0,Math.min(1,(d-rr*.35)/Math.max(1e-6,rr)));}
        if(a2<=.004)return;
