  const startTreeExclusions=[[-15.074751342450993,-44.665812575370495],[-9.906892395583771,-44.86049257797915]];
  S.treeRemovalReport={count:0,removed:[],reason:'Clear the automatic start-line camera sightline',physicalInAllModes:true};
  /* Geometry variation uses a position hash, never the placement RNG. This leaves the mapped
