  const kerb=S.kerb=new G.MeshBatch(gl,[3,4,2],false),bar=S.barrier=new G.MeshBatch(gl,[3,4,2],false);
  const atC=k=>C[(k%N+N)%N];
  const quadOn=(m,a,b,off0,off1,w0,w1,y,col)=>{
    const dir=[b[0]-a[0],b[1]-a[1]],dl=Math.hypot(dir[0],dir[1])||1,nx=-dir[1]/dl,nz=dir[0]/dl;
    const v=(pt,o,w)=>m.vert(pt[0]+nx*(o),y,pt[1]+nz*(o),col[0],col[1],col[2],col[3],0,0);
    const p0=v(a,off0,w0),p1=v(a,off0+w0,w0),p2=v(b,off1+w1,w1),p3=v(b,off1,w1);
    m.tri(p0,p1,p2);m.tri(p0,p2,p3);
  };
  let kn=0;
  for(let i=0;i<N;i+=2){
    const k=Math.abs(kap[i]); if(k<.010) continue;
    const a=atC(i),b=atC(i+2),side=kap[i]>0?1:-1,red=((i/2)|0)%2===0;
    const col=red?[.42,.030,.022,.95]:[.60,.60,.62,.95];
    const hw=a[2]/2,hw2=atC(i+2)[2]/2;
    quadOn(kerb,a,b, side*(hw-1.05), side*(hw2-1.05), side*0.95, side*0.95, H+.012, col);   /* the apex side */
    quadOn(kerb,a,b,-side*(hw-0.75),-side*(hw2-0.75),-side*0.65,-side*0.65, H+.012, red?[.50,.50,.52,.75]:[.36,.026,.02,.75]);
    kn++;
  }
  /* v5.49 — SAY HOW MANY. The kerbs have been drawn all along, but the v1.8 port dropped the line that
     recorded the count, so S.kerbStats was undefined and every surface that reads it — the credit line,
     which only names the kerbs as "a nominal rule, not a drawn line" when there are some, and the check that
     holds the backdrop to still having them — read zero and believed they had gone. A thing that is drawn
     and not counted is a thing nobody can check. */
  S.kerbStats={blocks:kn,rule:'a corner sharper than 0.010 of curvature, every second centre-line point, both sides'};
  /* Restrained non-emissive grid paint. The old solid rectangles were ~6.5 × 10 m;
     outline widths and lengths are now metre-based while their original slot centres
     and the start location stay fixed. This remains illustrative event furniture. */
  {
    const metre=1/G.M_PER_PT,paintY=H+.005*metre,white=[.62,.63,.64,.86],
          gridStart=kerb.nv,slotL=5.2*metre,slotW=2.5*metre,stroke=.10*metre;
    for(let r=0;r<10;r++){
      const oldS=S.gridS+T.carS+1.2-2.6-r*3.4,centre=oldS+.85,a=CL.at(centre-slotL/2),b=CL.at(centre+slotL/2),
            oldHalfWidth=CL.at(oldS)[2]/2,head=CL.at(centre+slotL/2-stroke),tail=CL.at(centre-slotL/2+stroke);
      for(const side of [-1,1]){
        const offset=side*(oldHalfWidth*.30+.55),left=offset-slotW/2,right=offset+slotW/2;
        quadOn(kerb,a,b,left,left,stroke,stroke,paintY,white);
        quadOn(kerb,a,b,right-stroke,right-stroke,stroke,stroke,paintY,white);
        quadOn(kerb,head,b,left+stroke,left+stroke,slotW-2*stroke,slotW-2*stroke,paintY,white);
        quadOn(kerb,a,tail,left+stroke,left+stroke,slotW-2*stroke,slotW-2*stroke,paintY,white);
      }
    }
    const gridEnd=kerb.nv,checkerStart=kerb.nv,half=Math.max(0,S.grid.hw-.30*metre),depth=.60*metre,
          columns=Math.max(2,Math.round(2*half/(.40*metre))),cell=2*half/columns;
    const checkerPoint=(along,across)=>kerb.vert(g[0]+S.grid.t[0]*along+nx*across,paintY,g[1]+S.grid.t[1]*along+nz*across,...white,0,0);
    for(let row=0;row<2;row++)for(let col=0;col<columns;col++){
      if((row+col)%2)continue; // Asphalt forms the dark squares; no luminous tube remains.
      const a=-depth/2+row*depth/2,b=a+depth/2,l=-half+col*cell,r=l+cell,
            p=checkerPoint(a,l),q=checkerPoint(a,r),s=checkerPoint(b,r),t=checkerPoint(b,l);
      kerb.tri(p,q,s);kerb.tri(p,s,t);
    }
    S.startMarkings={gridVertices:[gridStart,gridEnd],checkerVertices:[checkerStart,kerb.nv],
      slotCount:20,strokeM:.10,slotLengthM:5.2,slotWidthM:2.5,checkerDepthM:.60,checkerColumns:columns,
      nonEmissive:true,paintHeightM:.005,startPosition:g.slice(0,2)};
  }
  /* the markings: a white line down each edge of the racing surface, and the rubber laid on the line */
  for(let i=0;i<N;i+=2){
    const a=atC(i),b=atC(i+2),hw=a[2]/2,hw2=atC(i+2)[2]/2;
    [-1,1].forEach(q2=>quadOn(kerb,a,b,q2*(hw-.30),q2*(hw2-.30),q2*.13,q2*.13,H+.011,[.62,.62,.64,.50]));
    const rl=Math.max(-1,Math.min(1,kap[i]*7)),rl2=Math.max(-1,Math.min(1,kap[(i+2)%N]*7));
    quadOn(kerb,a,b,rl*(hw-1.5)-.85,rl2*(hw2-1.5)-.85,1.7,1.7,H+.009,[.014,.013,.013,.16]);
  }
  kerb.upload();
  /* the barrier wall: concrete on the outside, lower on the inside, set just off the racing surface */
  const wallRun=(loop,sgn,hgt,col)=>{
    const P=dens(loop,2.2),n2=P.length;
    for(let i=0;i<n2;i++){
      const a=P[i],b=P[(i+1)%n2],dir=[b[0]-a[0],b[1]-a[1]],dl=Math.hypot(dir[0],dir[1])||1;
      const nx=-dir[1]/dl*sgn*0.45,nz=dir[0]/dl*sgn*0.45;
      const v=(pt,y,sh)=>bar.vert(pt[0]+nx,y,pt[1]+nz,col[0]*sh,col[1]*sh,col[2]*sh,col[3],0,0);
      const A0=v(a,H,.55),B0=v(b,H,.55),B1=v(b,H+hgt,1),A1=v(a,H+hgt,1);
      bar.tri(A0,B0,B1);bar.tri(A0,B1,A1);
      const A2=v(a,H+hgt,1.25),B2=v(b,H+hgt,1.25);                       /* the capping, catching the light */
      bar.tri(A1,B1,B2);bar.tri(A1,B2,A2);
    }
  };
  wallRun(O,1,.30,[.130,.120,.112,1]);wallRun(I,-1,.22,[.115,.106,.100,1]);
  bar.upload();S.kerbCount=kn;

  /* where the crowd stands: points just outside the barrier, for camera flashes through the fence */
  {const cw=[],Od2=dens(O,3.4),crowdRnd=G.rng(31);
   for(let i=0;i<Od2.length;i++){const a=Od2[i],b=Od2[(i+1)%Od2.length],dx=b[0]-a[0],dz=b[1]-a[1],L=Math.hypot(dx,dz)||1;
     cw.push([a[0]-dz/L*1.6,H+.55+crowdRnd()*.5,a[1]+dx/L*1.6]);}
   S.crowd=cw;}

  /* dynamic batches, refilled every frame */
  S.dynGlow=new G.LineBatch(gl,S.quad,2048,true);S.dynCore=new G.LineBatch(gl,S.quad,2048,true);S.dynAdd=new G.LineBatch(gl,S.quad,1024,true);
  S.decals=new G.MeshBatch(gl,[3,4,2],true);
  /* v5.66 — rubber on the road and smoke off the tyres, both dynamic and both alpha-blended */
  S.marks=new G.MeshBatch(gl,[3,4,2],true);S.puffs=new G.MeshBatch(gl,[3,4,2],true);
  S.carBody=new G.MeshBatch(gl,[3,4,2],true);S.carGlass=new G.MeshBatch(gl,[3,4,2],true);S.shade=new G.MeshBatch(gl,[3,4,2],true);
  S.edgeLoops={o:new G.Loop(dens(O,1)),i:new G.Loop(dens(I,1))};
  G.setBuildings(o.buildings||[]);
  if(G.simReset)G.simReset();
  return true;
};

/* buildings: [{p:[[x,z],...] in key-plan units, h: height in key-plan units}] */
G.setBuildings=function(list){
  const S=G.S,gl=S.gl,mesh=new G.MeshBatch(gl,[3,3,3,1],false),edges=new G.LineBatch(gl,S.quad,4096,false),rnd=G.rng(11);
  /* OSM building shells and their parts can contain the very same facade. Drawing each shell
     gives those coplanar pixels different window materials and produces visible depth fighting.
     Keep the union of their exact wall rectangles, including every uncovered podium/tower span.
     No footprint, top height or part minimum height is moved by this deconfliction. */
  const planes=new Map(),roofs=new Set(),EPS=1e-7;
  const stats={sourceBuildings:0,sourceWallFaces:0,emittedWallFaces:0,suppressedWallFaces:0,trimmedWallFaces:0,
    coplanarGroups:0,duplicateRoofs:0,sourceWallArea:0,renderedWallArea:0};
  const polygonKey=P=>{
    const points=P.map(p=>Math.round(p[0]*1e6)+','+Math.round(p[1]*1e6));
    let first=0;for(let k=1;k<points.length;k++)if(points[k]<points[first])first=k;
    return points.slice(first).concat(points.slice(0,first)).join(';');
  };
  const difference=(a,b)=>{
    const x0=Math.max(a[0],b[0]),x1=Math.min(a[1],b[1]),y0=Math.max(a[2],b[2]),y1=Math.min(a[3],b[3]);
    if(x1-x0<=EPS||y1-y0<=EPS)return [a];
    const out=[];
    if(x0-a[0]>EPS)out.push([a[0],x0,a[2],a[3]]);
    if(a[1]-x1>EPS)out.push([x1,a[1],a[2],a[3]]);
    if(y0-a[2]>EPS)out.push([x0,x1,a[2],y0]);
    if(a[3]-y1>EPS)out.push([x0,x1,y1,a[3]]);
    return out;
  };
  S.beacons=[];let count=0;
  list.forEach(b=>{
    let P=b.p.map(S.toWorld);if(P.length<3)return;
    const f=P[0],l=P[P.length-1];if(Math.hypot(f[0]-l[0],f[1]-l[1])<1e-6)P.pop();
    if(P.length<3)return;
    if(area(P)<0)P.reverse();
    const y0=b.y0||0,h=Math.max(y0+.25,b.h),hash=rnd();
    let mx=0,mz=0;P.forEach(p=>{mx+=p[0];mz+=p[1];});mx/=P.length;mz/=P.length;
    const glow=Math.exp(-Math.max(0,S.distToTrack(mx,mz)-3)/7);
    let u=0;
    for(let i=0;i<P.length;i++){
      const a=P[i],c=P[(i+1)%P.length],dx=c[0]-a[0],dz=c[1]-a[1],len=Math.hypot(dx,dz);
      if(len<=EPS)continue;
      const nx=dz/len,nz=-dx/len,sign=dx>EPS||(Math.abs(dx)<=EPS&&dz>0)?1:-1,tx=dx/len*sign,tz=dz/len*sign;
      const sa=a[0]*tx+a[1]*tz,sb=c[0]*tx+c[1]*tz,offset=-tz*a[0]+tx*a[1];
      const key=[Math.round(tx*1e7),Math.round(tz*1e7),Math.round(offset*1e6),sign].join(',');
      const rect=[Math.min(sa,sb),Math.max(sa,sb),y0,h],entry={rect,a,dx,dz,sa,sb,nx,nz,sign,u,hash,glow,area:len*(h-y0)};
      if(!planes.has(key))planes.set(key,[]);
      planes.get(key).push(entry);stats.sourceWallFaces++;stats.sourceWallArea+=entry.area;u+=len;
    }
    const roofKey=Math.round(h*1e6)+'|'+polygonKey(P);
    if(!roofs.has(roofKey)){
      roofs.add(roofKey);
      const base=mesh.nv;P.forEach(p=>mesh.vert(p[0],h,p[1],0,1,0,0,h,hash,glow));
      const t=G.earclip(P);for(let k=0;k<t.length;k+=3)mesh.tri(base+t[k],base+t[k+1],base+t[k+2]);
    }else stats.duplicateRoofs++;
    const tall=Math.min(1,h/16),ec=[1,.62,.34,.16+.40*tall+.25*glow],e0=[ec[0],ec[1],ec[2],ec[3]*.2];
    for(let i=0;i<P.length;i++){
      const a=P[i],c=P[(i+1)%P.length],pr=P[(i+P.length-1)%P.length];
      edges.seg([a[0],h,a[1]],[c[0],h,c[1]],ec,ec,.04,.04,.55);
      const ax=a[0]-pr[0],az=a[1]-pr[1],bx=c[0]-a[0],bz=c[1]-a[1],turn=Math.abs(Math.atan2(ax*bz-az*bx,ax*bx+az*bz));
      if(turn>.45&&h-y0>1.2)edges.seg([a[0],y0,a[1]],[a[0],h,a[1]],e0,ec,.03,.03,.45);
    }
    if(h>20)S.beacons.push([mx,h+.4,mz,hash]);
    count++;
  });
  planes.forEach(faces=>{
    /* The largest existing face supplies one stable UV origin/material for that physical plane.
       Smaller stacked parts still contribute their uncovered geometry without a finish seam. */
    faces.sort((a,b)=>b.area-a.area);
    const material=faces[0],covered=[];
    if(faces.length>1)stats.coplanarGroups++;
    faces.forEach(face=>{
      let pieces=[face.rect];
      covered.forEach(rect=>{const next=[];pieces.forEach(p=>difference(p,rect).forEach(q=>next.push(q)));pieces=next;});
      if(!pieces.length){stats.suppressedWallFaces++;return;}
      const remain=pieces.reduce((sum,p)=>sum+(p[1]-p[0])*(p[3]-p[2]),0);
      if(remain<face.area-EPS)stats.trimmedWallFaces++;
      const vertex=(s,y)=>{
        const t=(s-face.sa)/(face.sb-face.sa),x=face.a[0]+face.dx*t,z=face.a[1]+face.dz*t;
        const uu=material.u+(s-material.sa)*material.sign;
        return mesh.vert(x,y,z,face.nx,0,face.nz,uu,y,material.hash,material.glow);
      };
      pieces.forEach(p=>{
        const a=vertex(p[0],p[2]),b=vertex(p[1],p[2]),c=vertex(p[1],p[3]),d=vertex(p[0],p[3]);
        if(face.sign>0){mesh.tri(a,b,c);mesh.tri(a,c,d);}else{mesh.tri(b,a,d);mesh.tri(b,d,c);}
        covered.push(p);stats.emittedWallFaces++;stats.renderedWallArea+=(p[1]-p[0])*(p[3]-p[2]);
      });
    });
  });
  stats.sourceBuildings=count;S.buildingGeometry=stats;
  mesh.upload();edges.upload();S.bMesh=mesh;S.bEdges=edges;S.bCount=count;
  /* a coarse height map of the buildings, so the drone can keep its line of sight */
  const CELL=1.5,R=420,NG=Math.ceil(2*R/CELL),grid=new Float32Array(NG*NG);
  list.forEach(b=>{const P=b.p.map(S.toWorld);if(P.length<3)return;let x0=1e9,x1=-1e9,z0=1e9,z1=-1e9;P.forEach(p=>{x0=Math.min(x0,p[0]);x1=Math.max(x1,p[0]);z0=Math.min(z0,p[1]);z1=Math.max(z1,p[1]);});
    for(let gx=Math.max(0,Math.floor((x0+R)/CELL)-1);gx<=Math.min(NG-1,Math.floor((x1+R)/CELL)+1);gx++)for(let gz=Math.max(0,Math.floor((z0+R)/CELL)-1);gz<=Math.min(NG-1,Math.floor((z1+R)/CELL)+1);gz++){
      const x=(gx+.5)*CELL-R,z=(gz+.5)*CELL-R;let inside=false;
      for(let i=0,j=P.length-1;i<P.length;j=i++){const a=P[i],c=P[j];if((a[1]>z)!==(c[1]>z)&&x<(c[0]-a[0])*(z-a[1])/(c[1]-a[1])+a[0])inside=!inside;}
      if(!inside){let dm=1e9;for(const q of P){const d=Math.hypot(q[0]-x,q[1]-z);if(d<dm)dm=d;}inside=dm<CELL*.9;}
      if(inside&&b.h>grid[gz*NG+gx])grid[gz*NG+gx]=b.h;}});
  S.heightAt=(x,z)=>{const gx=Math.floor((x+R)/CELL),gz=Math.floor((z+R)/CELL);return gx<0||gz<0||gx>=NG||gz>=NG?0:grid[gz*NG+gx];};
  return count;
};
})();
/* GC3D part 2b — physical track-edge detail, shared by Day Race and Showcase.
   These illustrative modules follow the existing barrier line exactly. They are not a survey
   of the event's temporary works, and do not change the circuit, driving line or road width. */
(function(){
'use strict';
const G=window.GC3D;

G.buildTrackDetail=function(S){
  S=S||G.S;if(!S||!S.gl||!S.outer||!S.inner)return null;
  const gl=S.gl,M=G.M_PER_PT,H=S.tune.deckH;
  const concrete=new G.MeshBatch(gl,[3,4,2],false),posts=new G.MeshBatch(gl,[3,4,2],false),
        wire=new G.MeshBatch(gl,[3,4,2],false),scuffs=new G.MeshBatch(gl,[3,4,2],false);
  const stats={barrierModules:0,fencePanels:0,posts:0,source:'existing illustrative barrier line',
    maxModuleLength_m:4,concreteThickness_m:.58,fenceAboveCap_m:2.85,wireSpacing_m:[.10,.15],
    surveyedEventEquipment:false};
  const vertex=(mesh,p,c,u,v)=>mesh.vert(p[0],p[1],p[2],c[0],c[1],c[2],c[3],u||0,v||0);
  const face=(mesh,points,c,uv)=>{
    const n=mesh.nv;
    points.forEach((p,i)=>vertex(mesh,p,c,uv?uv[i][0]:0,uv?uv[i][1]:0));
    for(let i=1;i<points.length-1;i++)mesh.tri(n,n+i,n+i+1);
  };
  const add=(a,b,s)=>[a[0]+b[0]*s,a[1]+b[1]*s,a[2]+b[2]*s];
  const sub=(a,b)=>[a[0]-b[0],a[1]-b[1],a[2]-b[2]];
  const unit=a=>{const k=Math.hypot(a[0],a[1],a[2])||1;return a.map(v=>v/k);};
  const cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];
  const scale=(c,f)=>[c[0]*f,c[1]*f,c[2]*f,c[3]];
  /* Hexagonal tubes provide real silhouette/lighting. Their radius remains physical, without a
     minimum pixel width that would turn hundreds of distant posts into a bright picket wall. */
  const tube=(a,b,r,c,sides=6,caps=true)=>{
    const axis=unit(sub(b,a)),basis=unit(cross(axis,Math.abs(axis[1])>.9?[1,0,0]:[0,1,0])),other=cross(axis,basis);
    const A=[],B=[];
    for(let k=0;k<sides;k++){
      const t=k*Math.PI*2/sides,n=basis.map((v,j)=>v*Math.cos(t)+other[j]*Math.sin(t));
      A.push(add(a,n,r));B.push(add(b,n,r));
    }
    for(let k=0;k<sides;k++){const j=(k+1)%sides;face(posts,[A[k],A[j],B[j],B[k]],c);}
    if(caps){face(posts,A.slice().reverse(),scale(c,.82));face(posts,B,c);}
  };
  const metal=[.29,.34,.365,1],darkMetal=[.12,.15,.165,1],wireCol=[.19,.23,.25,.92];
  const run=(loop,sgn,height,runIndex)=>{
    /* Same subdivision and face offset as the old wallRun: corners remain registered to the
       supplied drawing. Additional splits only add module joints along those existing faces. */
    const P=G.dens(loop,2.2),thick=.58/M,bevel=.075/M,gap=.012/M;
    /* Adjacent offset faces used to stop at unrelated endpoints, leaving holes at each street
       corner. Their bounded miter intersections close those holes along the same offset lines. */
    const joins=P.map((p,k)=>{
      const a=P[(k+P.length-1)%P.length],b=P[(k+1)%P.length],
            before=unit([p[0]-a[0],0,p[1]-a[1]]),after=unit([b[0]-p[0],0,b[1]-p[1]]),
            n0=[-before[2]*sgn,0,before[0]*sgn],n1=[-after[2]*sgn,0,after[0]*sgn],
            divisor=Math.max(.08,1+n0[0]*n1[0]+n0[2]*n1[2]);
      const n=n0.map((v,i)=>(v+n1[i])/divisor),length=Math.hypot(n[0],n[2]);
      return length>2.6?n.map(v=>v*2.6/length):n;
    });
    let distance=0,moduleIndex=0;
    for(let k=0;k<P.length;k++){
      const p=P[k],q=P[(k+1)%P.length],na=joins[k],nb=joins[(k+1)%P.length],
            a=[p[0]+na[0]*.45,p[1]+na[2]*.45],b=[q[0]+nb[0]*.45,q[1]+nb[2]*.45],
            dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz);
      if(len<1e-7)continue;
      const tangent=[dx/len,0,dz/len];
      const count=Math.max(1,Math.ceil(len*M/4));
      for(let j=0;j<count;j++){
        const f0=j/count,f1=(j+1)/count,section=len/count;
        const A=[a[0]+dx*f0,H,a[1]+dz*f0],B=[a[0]+dx*f1,H,a[1]+dz*f1];
        const na0=na.map((v,i)=>v+(nb[i]-v)*f0),nb0=na.map((v,i)=>v+(nb[i]-v)*f1);
        const aj=add(A,tangent,gap),bj=add(B,tangent,-gap);
        /* The original wall is the track-facing front face. Thickness grows away from it, so
           the rendered racing clearance is preserved. A small real bevel catches the sun. */
        const sectionPoints=[[0,0],[thick,0],[thick,height-bevel],[thick-bevel,height],
                             [bevel,height],[0,height-bevel]];
        const ring=(p,n)=>sectionPoints.map(q=>[p[0]+n[0]*q[0],H+q[1],p[2]+n[2]*q[0]]);
        const qa=ring(aj,na0),qb=ring(bj,nb0),orange=(Math.floor(moduleIndex/4)+runIndex)%3!==0;
        const paint=orange?[.86,.125,.016,1]:[.66,.665,.635,1];
        for(let m=0;m<sectionPoints.length;m++){
          const n=(m+1)%sectionPoints.length;
          face(concrete,[qa[m],qb[m],qb[n],qa[n]],scale(paint,m===0?.66:1));
        }
        face(concrete,qa.slice().reverse(),scale(paint,.72));face(concrete,qb,scale(paint,.72));
        /* Local dirt and tyre rub are low contrast and static; they never animate or float
           above the road. Every mark is on the existing concrete face, not an invented decal. */
        const front=add(A,na0,-.0025/M),frontB=add(B,nb0,-.0025/M);
        const sy=H+.12/M,sh=.095/M;
        face(scuffs,[[front[0],sy,front[2]],[frontB[0],sy,frontB[2]],
          [frontB[0],sy+sh,frontB[2]],[front[0],sy+sh,front[2]]],[.045,.041,.036,.26]);
        if(moduleIndex%3===1){
          const q0=add(front,tangent,section*.22),q1=add(front,tangent,section*.75),y=H+.45/M;
