    add(curve([[-.29,.349,q*.369],[-.33,.267,q*.387],[-.35,.165,q*.387],[-.30,.102,q*.377]]),false,'trim',.50);
    add(curve([[-.30,.102,q*.377],[-.15,.096,q*.390],[.14,.095,q*.393],[.32,.107,q*.385]]),false,'trim',.50);
    add([[.32,.107,q*.385],[.34,.279,q*.365],[.27,.331,q*.320]],false,'trim',.50);
    add([[-.205,.315,q*.380],[-.125,.315,q*.380]],false,'metal',.55);
    add([[.10,.354,q*.324],[.08,.369,q*.393]],false,'trim',.60);
    add(curve([[.038,.372,q*.383],[.035,.399,q*.409],[.145,.401,q*.418],[.150,.376,q*.389]],12),true,'trim',.70);
    /* Hood creases and a slim rear-deck crease reinforce the existing front/rear silhouette. */
    add(curve([[.31,.334,q*.155],[.47,.332,q*.175],[.85,.255,q*.177],[.972,.210,q*.133]]),false,'trim',.60);
    add(curve([[-.70,.36,q*.16],[-.79,.351,q*.19],[-.90,.338,q*.20],[-1.0,.308,q*.19]]),false,'trim',.50);
    const ze=q*(WZ+.006);
    add([[-1.008,.405,ze],[-1.008,.475,ze],[-.982,.491,ze],[-.827,.480,ze],[-.792,.458,ze],[-.802,.405,ze]],true,'wing',.78);
    add([[-.955,.345,q*.150],[-.938,.414,q*.150],[-.920,.469,q*.150]],false,'wing');
    [.58,-.53].forEach(xw=>{const a=[],lip=[];for(let k=0;k<=28;k++){const t=Math.PI*k/28;
      a.push([xw+Math.cos(t)*.174,.130+Math.sin(t)*.174,q*.410]);
      lip.push([xw+Math.cos(t)*.187,.130+Math.sin(t)*.187,q*.393]);}
