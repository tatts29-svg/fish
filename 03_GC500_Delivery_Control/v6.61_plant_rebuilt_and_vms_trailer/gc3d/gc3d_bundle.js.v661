    if(br>.02&&show('brakeWash'))quad([P.pos[0]-P.fwd[0]*1.6*Sx,0,P.pos[2]-P.fwd[2]*1.6*Sx],1.1*Sx,.85*Sx,[1,.10,.06,.6*br]);
  }else if(br>.04&&show('brakeWash'))quad([P.pos[0]-P.fwd[0]*1.45*Sx,0,P.pos[2]-P.fwd[2]*1.45*Sx],.55*Sx,.42*Sx,[.85,.06,.03,.16*br]);
