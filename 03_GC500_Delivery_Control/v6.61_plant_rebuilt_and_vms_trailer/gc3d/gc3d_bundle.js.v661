const textures=new WeakMap();
function unpack(){
  const alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/',lookup=new Int16Array(128);lookup.fill(-1);
  for(let i=0;i<alphabet.length;i++)lookup[alphabet.charCodeAt(i)]=i;
