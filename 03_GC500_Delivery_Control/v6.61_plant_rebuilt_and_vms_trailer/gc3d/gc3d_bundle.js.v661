  cv.style.cssText='position:absolute;left:0;top:0;width:100%;height:100%;display:block;pointer-events:none';
  G.setLook(S.look.name);
  const gl=S.gl=cv.getContext('webgl2',{alpha:true,premultipliedAlpha:true,antialias:true,stencil:true,preserveDrawingBuffer:!!o.test,powerPreference:'high-performance'});
