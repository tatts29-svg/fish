    this.L=this.cum[this.n];
    this.tan=pts.map((p,i)=>{const a=pts[(i+this.n-1)%this.n],b=pts[(i+1)%this.n];return p.map((_,k)=>(b[k]-a[k])*.5);});
  }
  idx(s){const L=this.L;s=((s%L)+L)%L;let lo=0,hi=this.n;while(hi-lo>1){const m=(lo+hi)>>1;if(this.cum[m]<=s)lo=m;else hi=m;}return [lo,(s-this.cum[lo])/Math.max(1e-6,this.cum[lo+1]-this.cum[lo])];}
