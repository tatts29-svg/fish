         while the spoke pattern can be sampled cleanly. No rapidly flashing drilled holes. */
      const disc=[.29,.34,.36,.34*f*closeDetail];outline(ring(.070,rimZ-q*.012),disc,.31);outline(ring(.039,rimZ-q*.012),disc,.25);
    }
    /* A fixed caliper remains behind the turning spokes, with a restrained braking response. */
    if(detailFade>.01){const a=W([wh[0]-.067,.119,rimZ-q*.008]),b=W([wh[0]-.077,.158,rimZ-q*.008]),c=[.48+.35*br,.045,.014,(.55+.35*br)*f*detailFade];co.seg(a,b,c,c,cR*.95,cR*.95,.4);}
    /* At the compressed race speed, sharp rotating spokes alias. Blend the split-spoke detail
