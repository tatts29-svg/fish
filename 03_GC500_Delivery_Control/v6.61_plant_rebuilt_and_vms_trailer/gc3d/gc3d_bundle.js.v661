    if(g!==SND.gear){if(g>SND.gear){st.cutUntil=clock+.12;log('shift up to '+(g+1),S,t);}
      else{st.blipUntil=clock+.09;log('shift down to '+(g+1)+' (blip)',S,t);}SND.gear=g;}
    rpm=IDLE+(LIMIT-IDLE)*f;
  }else{
    if(m.shiftAt!==st.lastShiftAt){st.lastShiftAt=m.shiftAt;
      if(m.shift==='up'){st.cutUntil=clock+.12;log('shift up to '+(m.gear+1),S,t);}
      else{if(m.shift==='blip')st.blipUntil=clock+.09;log('shift down to '+(m.gear+1)+(m.shift==='blip'?' (blip)':''),S,t);}}
    SND.gear=m.gear;rpm=m.rpm;
  }
  if(!isFinite(rpm))rpm=IDLE;
  if(clock<st.cutUntil)thr=0;                                /* the cut on an upshift */
  if(clock<st.blipUntil)thr=1;                               /* the blip on a downshift under braking */
  if(spin>0){rpm=Math.max(rpm,LIMIT-1400*(1-spin));thr=1;}
  return {rpm:rpm,thr:thr,spin:spin,braking:braking};
