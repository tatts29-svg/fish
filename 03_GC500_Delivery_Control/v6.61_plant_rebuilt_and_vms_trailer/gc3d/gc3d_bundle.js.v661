              ids.push(dayTR.vert(center[0]+size*(dir[0]*along+side[0]*cross+normal[0]*lift),
                center[1]+size*(dir[1]*along+side[1]*cross+normal[1]*lift),
                center[2]+size*(dir[2]*along+side[2]*cross+normal[2]*lift),.087*m*shade,.198*m*shade,.046*m*shade,1,0,0));
            }
            dayTR.tri(ids[0],ids[1],ids[2]);dayTR.tri(ids[0],ids[2],ids[3]);
          }
        }
      }
    }
    const c0=[x+lean*.6,y0+h*.72,z];
    tg.seg(c0,c0,[.12,.42,.18,.045],[.12,.42,.18,.045],r*.62,r*.62,.7);   /* the canopy catching the street light */
    nTree++;
  };
  (pk.trees||[]).forEach(r=>{const x=r[0]*U+ox-cx,z=r[1]*U+oy-cz,hm=(r[2]||0)/10;
    tree(x,z,hm>2?Math.max(.7,Math.min(1.8,hm/7)):1.05);});                 /* the trees the map actually records */
  (pk.park||[]).forEach(rg2=>{const R=pts(rg2).map(q=>[q[0]-cx,q[1]-cz]);
    let x0=1e9,x1=-1e9,z0=1e9,z1=-1e9;R.forEach(q=>{x0=Math.min(x0,q[0]);x1=Math.max(x1,q[0]);z0=Math.min(z0,q[1]);z1=Math.max(z1,q[1]);});
    for(let x=x0;x<x1;x+=2.6)for(let z=z0;z<z1;z+=2.6){const jx=x+(trnd()-.5)*2.0,jz=z+(trnd()-.5)*2.0;
      if(inRing(jx,jz,R)&&trnd()<.45)tree(jx,jz,.92,true,'procedural park planting');}});
  (pk.roads||[]).forEach(r=>{if(r[0]>1)return;const P=pts(r,1);let acc=0;
    for(let i=1;i<P.length;i++){const a=P[i-1],c=P[i],L=Math.hypot(c[0]-a[0],c[1]-a[1]);if(L<1e-6)continue;
      const nx=-(c[1]-a[1])/L,nz=(c[0]-a[0])/L;let d=9-acc;
      while(d<L){const s=(trnd()<.5?-1:1)*(1.5+trnd()*.7);
        tree(a[0]+(c[0]-a[0])*d/L-cx+nx*s,a[1]+(c[1]-a[1])*d/L-cz+nz*s,.66,true,'procedural roadside planting');d+=11;}
      acc=(acc+L)%9;}});
