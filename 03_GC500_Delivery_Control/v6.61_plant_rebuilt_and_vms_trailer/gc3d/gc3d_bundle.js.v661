/* GC3D part 3 — the car: a supercar drawn in light, its dynamics, and everything that moves. */
(function(){
'use strict';
const G=window.GC3D;
const pl=(x,t)=>{if(x<=t[0][0])return t[0][1];for(let i=1;i<t.length;i++)if(x<=t[i][0]){const a=t[i-1],b=t[i];return a[1]+(b[1]-a[1])*(x-a[0])/(b[0]-a[0]);}return t[t.length-1][1];};
const HW=.395,PLAN=[[-1.03,.70],[-.74,.90],[-.28,.79],[.30,.94],[.71,.86],[.98,.51],[1.10,.16]];
/* a smooth closed plan outline from a half control polygon (rear to nose), mirrored */
function loopFrom(ctl,zs,yf){
  const full=ctl.map(p=>[p[0],p[1]*zs]).concat(ctl.slice().reverse().map(p=>[p[0],-p[1]*zs])),out=[],n=full.length;
  for(let i=0;i<n;i++){
    const p0=full[(i+n-1)%n],p1=full[i],p2=full[(i+1)%n],m0=[(p0[0]+p1[0])/2,(p0[1]+p1[1])/2],m1=[(p1[0]+p2[0])/2,(p1[1]+p2[1])/2];
    for(let k=0;k<8;k++){const t=k/8,a=(1-t)*(1-t),b=2*t*(1-t),c=t*t,x=a*m0[0]+b*p1[0]+c*m1[0],z=a*m0[1]+b*p1[1]+c*m1[1];out.push([x,yf(x),z]);}
  }
  return out;
}


/* v5.63 — THE COATES 26, THE WAY ANDREW'S OWN PHOTOGRAPH HAS IT: an ORANGE car with black graphics,
   not a black car with an orange nose. The note that stood here said "as it is actually painted: black,
   with the nose and front guards in orange", and every shot this package has taken since has agreed with
   that note rather than with the car. Andrew supplied the reference on 20 Sep 2026: orange body, black
   bonnet panel and roof, the Coates wordmark in white along the bonnet and the flank, 26 on the door.
   So the base and the accent swap places here, and the orange is lifted — [.215,.072,.012] rendered as a
   muddy brick against a dark track, which is part of why the car read as "not bright" in every measured
   chase shot. Painted by position on the body, so it still needs no texture. */
const LIV_BLACK=[.026,.027,.030],LIV_ORANGE=[.62,.115,.020],LIV_WHITE=[.235,.235,.240];
function livery(x,y,z){
  const az=Math.abs(z),hw=Math.max(.001,HALFW(x));
  /* the roof and the screen surround are black, as they are in the photograph */
  if(x>-.64&&x<.18&&y>.43) return LIV_BLACK;
  /* the bonnet panel: black down the centre, orange left showing along the guards */
  if(x>.12&&y>.24&&az<hw*.64) return LIV_BLACK;
  /* the sill flash, only on the flanks — white over black, so it still reads on an orange car */
  if(az>.30&&x>-.78&&x<.52){
    const band=y-(.150+x*.030);
    if(band>-.028&&band<.030) return LIV_WHITE;
    if(band>-.070&&band<=-.028) return LIV_BLACK;
  }
  if(y<.085) return LIV_BLACK;                      /* the valance and rocker below the sill */
  if(x<-.90&&y>.34) return LIV_BLACK;               /* the rear deck under the wing */
  return LIV_ORANGE;
}

/* ---- the body: a solid hull lofted from the same plan the neon edges follow, so the light sits on a
   real shape instead of shining through it. Built once in the car's own frame; lit on the CPU each
   frame, because the whole car is only a few hundred vertices. ---- */
const HALFW = x=>HW*pl(x,[[-1.10,.80],[-1.0,.95],[-.66,1.06],[-.30,.92],[-.12,.90],[.34,.94],[.60,1.06],[.9,.86],[1.03,.62],[1.10,.30]]);
const YBELT = x=>pl(x,[[-1.10,.322],[-.72,.352],[.30,.330],[.9,.262],[1.05,.238],[1.10,.226]]);
const YFLOOR= x=>pl(x,[[-1.10,.090],[-.6,.052],[.5,.048],[1.03,.052],[1.10,.085]]);
const CABW  = x=>.292*pl(x,[[-.60,.50],[-.50,.90],[-.32,1.0],[-.06,1.0],[.04,.92],[.12,.76]]);
const YROOF = x=>pl(x,[[-.60,.356],[-.46,.500],[-.30,.516],[0,.516],[.06,.430],[.12,.352]]);
function ringPt(w,yc,hh,t,px,pz){
  const c=Math.cos(t),s=Math.sin(t);
  return [yc+hh*Math.sign(s)*Math.pow(Math.abs(s),pz), w*Math.sign(c)*Math.pow(Math.abs(c),px)];
}
function loft(V,T,x0,x1,ns,nr,wf,loF,hiF,px,pz,cap){
  const base=V.length;
  for(let i=0;i<ns;i++){
    const f=i/(ns-1),x=x0+(x1-x0)*f,w=Math.max(.004,wf(x)),lo=loF(x),hi=hiF(x),yc=(lo+hi)/2,hh=Math.max(.004,(hi-lo)/2);
    for(let k=0;k<nr;k++){const q=ringPt(w,yc,hh,2*Math.PI*k/nr,px,pz);V.push([x,q[0],q[1]]);}
  }
  for(let i=0;i<ns-1;i++)for(let k=0;k<nr;k++){
    const a=base+i*nr+k,b=base+i*nr+(k+1)%nr,c=base+(i+1)*nr+(k+1)%nr,d=base+(i+1)*nr+k;
    T.push(a,b,c,a,c,d);
  }
  if(cap){
    for(const e of [0,ns-1]){
      let cx=0,cy=0,cz=0;for(let k=0;k<nr;k++){const v=V[base+e*nr+k];cx+=v[0];cy+=v[1];cz+=v[2];}
      const ci=V.length;V.push([cx/nr,cy/nr,cz/nr]);
      for(let k=0;k<nr;k++){const a=base+e*nr+k,b=base+e*nr+(k+1)%nr;if(e===0)T.push(ci,b,a);else T.push(ci,a,b);}
    }
  }
}
function plate(V,T,pts){                                   /* a flat quad, both faces */
  const b=V.length;pts.forEach(p=>V.push(p));
  T.push(b,b+1,b+2,b,b+2,b+3,b,b+2,b+1,b,b+3,b+2);
}
function tube(V,T,x,z,r,hw,n){                              /* a wheel: a short cylinder on the z axis */
  const b=V.length;
  for(let s=0;s<2;s++)for(let k=0;k<n;k++){const t=2*Math.PI*k/n;V.push([x+Math.cos(t)*r,r+Math.sin(t)*r*.98,z+(s?hw:-hw)]);}
  for(let k=0;k<n;k++){const a=b+k,c=b+(k+1)%n,d=b+n+(k+1)%n,e=b+n+k;T.push(a,c,d,a,d,e);}
  for(const s of [0,1]){const ci=V.length;V.push([x,r,z+(s?hw:-hw)]);
    for(let k=0;k<n;k++){const a=b+s*n+k,c=b+s*n+(k+1)%n;if(s)T.push(ci,a,c);else T.push(ci,c,a);}}
}
function box(V,T,x0,x1,y0,y1,z0,z1){
  const b=V.length;
  [[x0,y0,z0],[x1,y0,z0],[x1,y0,z1],[x0,y0,z1],[x0,y1,z0],[x1,y1,z0],[x1,y1,z1],[x0,y1,z1]].forEach(q=>V.push(q));
  const F=[[0,1,2,3],[7,6,5,4],[0,4,5,1],[3,2,6,7],[0,3,7,4],[1,5,6,2]];
  F.forEach(f=>{T.push(b+f[0],b+f[1],b+f[2]);T.push(b+f[0],b+f[2],b+f[3]);});
}
/* a wing or splitter with real thickness, given its four plan corners and a depth */
function slab(V,T,c,th){
  const b=V.length;
  c.forEach(q=>V.push([q[0],q[1],q[2]]));
  c.forEach(q=>V.push([q[0],q[1]-th,q[2]]));
  const F=[[0,1,2,3],[7,6,5,4],[0,4,5,1],[1,5,6,2],[2,6,7,3],[3,7,4,0]];
  F.forEach(f=>{T.push(b+f[0],b+f[1],b+f[2]);T.push(b+f[0],b+f[2],b+f[3]);});
}
/* a tyre: an outer wall, an inner wall and the two sidewalls, so it reads as rubber not a disc */
function wheel(V,T,x,z,R,W,n){
  const Ri=R*.60,b=V.length;
  for(const r of [R,Ri])for(const s of [-1,1])for(let k=0;k<n;k++){const t=2*Math.PI*k/n;
    V.push([x+Math.cos(t)*r,R+Math.sin(t)*r,z+s*W]);}
  const ring=(i)=>b+i*n;
  for(let k=0;k<n;k++){const j=(k+1)%n;
    T.push(ring(0)+k,ring(1)+k,ring(1)+j); T.push(ring(0)+k,ring(1)+j,ring(0)+j);   /* tread */
    T.push(ring(3)+k,ring(2)+k,ring(2)+j); T.push(ring(3)+k,ring(2)+j,ring(3)+j);   /* inner wall */
    T.push(ring(0)+k,ring(0)+j,ring(2)+j); T.push(ring(0)+k,ring(2)+j,ring(2)+k);   /* sidewall out */
    T.push(ring(3)+k,ring(3)+j,ring(1)+j); T.push(ring(3)+k,ring(1)+j,ring(1)+k);   /* sidewall in */
  }
  /* the rim face, set in from the sidewall */
  for(const s of [-1,1]){const c=V.length;V.push([x,R,z+s*W*.82]);
    const f=V.length;
    for(let k=0;k<n;k++){const t=2*Math.PI*k/n;V.push([x+Math.cos(t)*Ri*.97,R+Math.sin(t)*Ri*.97,z+s*W*.82]);}
    for(let k=0;k<n;k++){const j=(k+1)%n;if(s>0)T.push(c,f+k,f+j);else T.push(c,f+j,f+k);}
  }
}
G.WING={y:.465,x0:-.990,x1:-.820,z:.340};
G.WHEELZ=.352;
G.carHull=function(){
  const V=[],T=[],kindV=[];let v0=0,t0=0;const spans=[];
  const mark=k=>{while(kindV.length<V.length)kindV.push(k);spans.push([k,t0,T.length]);v0=V.length;t0=T.length;};
  loft(V,T,-1.10,1.10,34,18,HALFW,YFLOOR,YBELT,.34,.30,true);        mark('body');
  loft(V,T,-.60,.12,15,12,CABW,x=>YBELT(x)-.012,YROOF,.50,.58,true); mark('glass');
  /* splitter and diffuser, grown out of the bodywork rather than parked beside it */
  slab(V,T,[[1.02,.062,-.42],[1.14,.054,-.32],[1.14,.054,.32],[1.02,.062,.42]],.030);
  slab(V,T,[[-.88,.092,-.36],[-1.12,.128,-.30],[-1.12,.128,.30],[-.88,.092,.36]],.032);
  /* The rear wing. It sits AT roof height, not above it: on a Supercar the top of the wing is
     level with the roof or just under. Two swan-neck stanchions grow out of the decklid and the
     endplates are thin plates that hug the wing, not a box parked behind the car. */
  const WY=G.WING.y,WX0=G.WING.x0,WX1=G.WING.x1,WZ=G.WING.z,WB=YBELT(-.94);
  slab(V,T,[[WX0,WY+.012,-WZ],[WX1,WY-.004,-WZ],[WX1,WY-.004,WZ],[WX0,WY+.012,WZ]],.030);
  [-1,1].forEach(q=>{
    box(V,T,WX0+.034,WX1-.028,WB-.014,WY-.006,q*.150-.024,q*.150+.024);          /* stanchion  */
    box(V,T,WX0-.028,WX1+.046,WB-.004,WY+.052,q*WZ-.009,q*WZ+.009);               /* end plate  */
  });
  mark('wing');
  /* the tyres sit under the guards, not proud of them: the body half-width at the front axle is
     about .440, so the outside of the tread lands just inside it. */
  G.WHEELZ=.352;
  [[.60,-1],[.60,1],[-.54,-1],[-.54,1]].forEach(w=>wheel(V,T,w[0],w[1]*G.WHEELZ,.142,.070,20));
  mark('tyre');
  /* the driver: a helmet and shoulders, seen through the glass */
  const b=V.length,R=.098;
  for(let i=0;i<=5;i++)for(let k=0;k<10;k++){const u=Math.PI*i/5,t=2*Math.PI*k/10;
    V.push([-.13+Math.sin(u)*Math.cos(t)*R,.404+Math.cos(u)*R,Math.sin(u)*Math.sin(t)*R*.92]);}
  for(let i=0;i<5;i++)for(let k=0;k<10;k++){const a=b+i*10+k,c=b+i*10+(k+1)%10,d=b+(i+1)*10+(k+1)%10,e=b+(i+1)*10+k;T.push(a,c,d,a,d,e);}
  box(V,T,-.34,-.26,.27,.40,-.21,.21);
  mark('driver');
  const N=V.map(()=>[0,0,0]);
  for(let i=0;i<T.length;i+=3){
