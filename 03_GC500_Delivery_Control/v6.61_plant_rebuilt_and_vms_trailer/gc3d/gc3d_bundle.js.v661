  S.car.wheels.forEach(wh=>{const q=wh[1],z=q*.399,n=48,ring=(r,z1=z)=>{const a=[];
      for(let k=0;k<n;k++){const t=2*Math.PI*k/n;a.push(W([wh[0]+Math.cos(t)*r,.142+Math.sin(t)*r,z1]));}return a;};
    const outer=ring(.142),f=face(outer[0],outer[n/2]),rimZ=z-q*.006;
    const rubber=L.day?[.16,.195,.205,.87*f]:[.52,.31,.16,.67*f];
    const alloy=L.day?[.52,.61,.65,.92*f]:[1,.83,.65,.90*f];
    const outline=(points,col,width)=>{for(let k=0;k<n;k++)co.seg(points[k],points[(k+1)%n],col,col,cR*width,cR*width,.40);};
    outline(outer,rubber,.72);outline(ring(.129),rubber,.40);
    outline(ring(.139,q*.322),[rubber[0],rubber[1],rubber[2],rubber[3]*.40*detailFade],.45);
    outline(ring(.098,rimZ),alloy,.70);outline(ring(.087,rimZ),[alloy[0],alloy[1],alloy[2],alloy[3]*.65],.40);
    outline(ring(.023,rimZ+q*.002),alloy,.53);
    if(closeDetail>.01){
