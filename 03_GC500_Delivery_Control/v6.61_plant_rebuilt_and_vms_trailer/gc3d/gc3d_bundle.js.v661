      const a=mix(.60,.88,side>0?1-u:u),b=mix(.47,.28,v),A=[.268,.332,side*.324],B=[-.056,.478,side*.258],C=[-.435,.478,side*.258],D=[-.714,.351,side*.336];
      const lo=A.map((x,k)=>mix(x,D[k],a)),hi=B.map((x,k)=>mix(x,C[k],a));
      return lo.map((x,k)=>mix(x,hi[k],b)+(k===2?side*.005*Math.sin(b*Math.PI)*Math.sin(a*Math.PI):0)+(k===1?.004*Math.sin(a*Math.PI)*Math.sin(b*Math.PI):0));
    },[0,.1,side],28,6);
  }
