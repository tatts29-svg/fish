  return {V:V,N:N,kind:kindV,To:To,Tg:Tg};
};

/* local frame: x forward, y up, z to the driver's right; half-length = 1 */
G.carModel=function(){
  /* The car as it was in v0.4 -- the version that worked. Nothing here is a surface: it is a set of
     glowing edges, and the reason it reads well is that you can see the track through it. Resist
     adding panels. That is what went wrong the first four times. */
  const yBelt=x=>pl(x,[[-1.05,.335],[-.72,.365],[.30,.330],[.90,.225],[1.05,.185]]);
  const m={tubes:[]},add=(p,closed,k,width=1)=>m.tubes.push({p:p,closed:!!closed,k:k||'body',width:width});
  /* Cubic curves are sampled once, in local space. Close cameras see rounded panel transitions
     without any interpolation-dependent movement of the body itself. */
  const curve=(p,n=16)=>Array.from({length:n+1},(_,i)=>{const t=i/n,u=1-t;return [0,1,2].map(k=>u*u*u*p[0][k]+3*u*u*t*p[1][k]+3*u*t*t*p[2][k]+t*t*t*p[3][k]);});
