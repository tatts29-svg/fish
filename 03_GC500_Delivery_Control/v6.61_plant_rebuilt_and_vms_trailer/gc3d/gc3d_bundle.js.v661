                span=r*(.36+.15*Math.sin(u*Math.PI))*Math.sin(Math.PI*(u*.83+.1)),
                end=[a[0]-sn*span*side+cs*length*.18,a[1]-h*(.07+.18*u),a[2]+cs*span*side+sn*length*.18],
                mid=[a[0]*.40+end[0]*.60,a[1]*.46+end[1]*.54+h*.035,a[2]*.40+end[2]*.60],
                wide=r*(.027+.010*Math.sin(u*Math.PI)),rootWidth=r*.005,
                p=put([a[0]-cs*rootWidth,a[1],a[2]-sn*rootWidth],u,.85),
                q=put([a[0]+cs*rootWidth,a[1],a[2]+sn*rootWidth],u,1.05),
                t=put([mid[0]-cs*wide,mid[1],mid[2]-sn*wide],u,.88),
                v=put([mid[0]+cs*wide,mid[1]+h*.008,mid[2]+sn*wide],u,1.06),s=put(end,u,.78);
          dayTR.tri(p,q,v);dayTR.tri(p,v,t);dayTR.tri(t,v,s);
        }
      }
