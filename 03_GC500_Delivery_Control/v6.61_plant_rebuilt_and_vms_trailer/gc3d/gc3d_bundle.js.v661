        };
        for(let j=1;j<NB;j++)for(let k=0;k<NL;k++)leafVertex(Math.PI*j/NB,Math.PI*2*k/NL);
        for(let j=0;j<NB-2;j++)for(let k=0;k<NL;k++){
          const a=db+j*NL+k,b=db+j*NL+(k+1)%NL,d=a+NL;dayTR.tri(a,b,b+NL);dayTR.tri(a,b+NL,d);
        }
        const dt=leafVertex(0,0),dd=leafVertex(Math.PI,0);
        for(let k=0;k<NL;k++){dayTR.tri(dt,db+k,db+(k+1)%NL);dayTR.tri(dd,db+(NB-2)*NL+(k+1)%NL,db+(NB-2)*NL+k);}
        /* Folded leaf sprays break the edge of the underlying crown mass. Equal triangle
