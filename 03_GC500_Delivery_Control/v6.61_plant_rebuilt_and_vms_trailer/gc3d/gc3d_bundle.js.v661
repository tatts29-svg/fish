    const hot=L.headlamp==null?1:L.headlamp,lampCol=hot>1?[1,.965,.91]:[1,.94,.82];
    [-1,1].forEach(q=>quad([P.pos[0]+P.fwd[0]*3.5*Sx+P.rt[0]*q*.24*Sx,0,P.pos[2]+P.fwd[2]*3.5*Sx+P.rt[2]*q*.24*Sx],2.7*Sx,.8*Sx,[lampCol[0],lampCol[1],lampCol[2],.26*hot]));
