/* v5.49 — what to open at, decided before a single frame is drawn, from the only thing knowable up front:
   how many pixels this screen is going to ask for. Deliberately coarse and deliberately cautious — the ladder
   can still take rungs away, but it should rarely have to, and it can never hand back a first impression. */
/* v5.57 — A PHONE IS NOT A SMALL DESKTOP.
   This picked the opening setting from the pixel count alone, and a phone has FEW pixels, so a phone opened on
   'ultra' — four-sample multisampling, a 3,072 shadow map, ambient occlusion AND the picture drawn at 125% —
   while a laptop with a big screen opened on 'balanced'. Exactly backwards: the small screen is attached to the
   small graphics chip. The ladder in the show adapter then had to climb down three rungs while somebody watched,
   so the first seconds of the showcase were the worst it ever looked.

   The device decides first, the pixel count second. A touch-first device with a coarse pointer and a viewport
   the size of a phone's opens on 'balanced'; a tablet on 'high'. The ladder is untouched — it still steps down
   if the frame rate asks, and nothing here caps what a person chooses by hand. */
G.openingQuality=function(){
  try{
    const dpr=Math.min(3,Math.max(1,window.devicePixelRatio||1));
    const w=(window.innerWidth||1280)*dpr,h=(window.innerHeight||720)*dpr,px=w*h;
    const mm=window.matchMedia?window.matchMedia.bind(window):null;
    const coarse=!!(mm&&mm('(pointer: coarse)').matches);
    const noHover=!!(mm&&mm('(hover: none)').matches);
    const shortest=Math.min(window.innerWidth||1280,window.innerHeight||720);
    const touchFirst=coarse&&noHover;
    if(touchFirst&&shortest<=520)return 'balanced';   /* a phone */
    if(touchFirst)return 'high';                      /* a tablet */
    if(px>5.0e6)return 'balanced';
    if(px>2.6e6)return 'high';
    return 'ultra';
  }catch(e){return 'high';}
};
/* Change the pace without rebuilding anything. GC3D.setPace(1) is a real-time lap. */
G.setPace=function(tc){
  const S=G.S,value=Number(tc);if(!S||!Number.isFinite(value))return null;
  const previous=S.tune.tc||1,next=Math.max(.25,Math.min(2,value)),ratio=next/previous;
  S.tune.tc=next;G.units(S.tune);
  // Change the playback clock, not the route or real-world speed. The current state scales too,
  // otherwise selecting slow motion leaves the car racing until braking finally catches up.
  if(S.sim){for(const key of ['v','vy'])if(Number.isFinite(S.sim[key]))S.sim[key]*=ratio;
    if(Number.isFinite(S.sim.accel))S.sim.accel*=ratio*ratio;}
