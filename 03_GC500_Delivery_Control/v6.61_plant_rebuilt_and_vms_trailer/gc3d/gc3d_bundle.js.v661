    const spokeFade=Math.max(0,Math.min(1,(.34-sp)/.16))*detailFade;
    if(spokeFade>.01)for(let k=0;k<5;k++)for(const side of [-1,1]){const t=-m.wheel+2*Math.PI*k/5;
      const a=W([wh[0]+Math.cos(t)*.022,.142+Math.sin(t)*.022,rimZ]),b=W([wh[0]+Math.cos(t+side*.11)*.086,.142+Math.sin(t+side*.11)*.086,rimZ]);
      const col=[alloy[0],alloy[1],alloy[2],.83*f*spokeFade];co.seg(a,b,col,col,cR*.53,cR*.53,.4);}
    if(spokeFade*closeDetail>.01)for(let k=0;k<6;k++){const t=-m.wheel+2*Math.PI*k/6,u=t+2*Math.PI/6;
      const a=W([wh[0]+Math.cos(t)*.011,.142+Math.sin(t)*.011,rimZ+q*.003]),b=W([wh[0]+Math.cos(u)*.011,.142+Math.sin(u)*.011,rimZ+q*.003]),col=[.78,.82,.82,.70*f*spokeFade*closeDetail];
