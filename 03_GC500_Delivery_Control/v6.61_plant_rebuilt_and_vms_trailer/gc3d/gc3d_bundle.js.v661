        const base=H+height-.025/M,vertical=2.25/M,rise=.60/M,lean=.36/M;
        const anchor=(p,y,n,dir)=>[p[0]+dir[0]*n,y,p[2]+dir[2]*n];
        const offset=thick*.62,pa=anchor(A,base,offset,na0),pb=anchor(B,base,offset,nb0),
              ma=anchor(A,base+vertical,offset,na0),mb=anchor(B,base+vertical,offset,nb0),
