function decodeAll(){
  const c=SND.clips,ctx=SND.ctx;if(!c||!ctx)return;
  CLIP_KEYS.forEach(k=>{
    const source=c[k];if(!source||SND.bufs[k]||SND.bufs[k+'_pending'])return;
    const pending={source,ctx};SND.bufs[k+'_pending']=pending;
    const current=()=>SND.ctx===ctx && SND.clips && SND.clips[k]===source && SND.bufs[k+'_pending']===pending;
    const bytes=async()=>{
      if(/^data:audio\/[^;,]+;base64,/.test(source)){
        const bin=atob(source.split(',')[1]),arr=new Uint8Array(bin.length);
        for(let i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);return arr.buffer;
      }
      const u=new URL(source,location.href);
      if(u.origin!==location.origin || !/^\/m\/[^/]+\/[a-f0-9]{64}\.[a-z0-9]+$/.test(u.pathname))throw new Error('invalid audio source');
      const response=await fetch(u.href,{credentials:'same-origin',redirect:'error'});
      if(!response.ok)throw new Error('audio download failed');return response.arrayBuffer();
    };
    // No request runs until a context exists (Sound/Start). A retry can follow a lost mobile signal.
    bytes().then(arr=>{
      if(!current())return;
      ctx.decodeAudioData(arr.slice(0),buf=>{if(!current())return;SND.bufs[k]=buf;delete SND.bufs[k+'_pending'];log('decoded '+k+' '+buf.duration.toFixed(2)+'s');SND.autoMode();},
        ()=>{if(current()){delete SND.bufs[k+'_pending'];log('could not decode '+k);}});
    }).catch(()=>{if(current()){delete SND.bufs[k+'_pending'];log('could not load '+k);}});
  });
