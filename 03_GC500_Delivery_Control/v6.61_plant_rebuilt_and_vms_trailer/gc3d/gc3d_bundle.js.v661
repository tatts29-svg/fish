    gl_.seg(a.p,b.p,[1,.42,.07,.8*Math.pow(ga,1.5)],[1,.42,.07,.8*Math.pow(gb,1.5)],.05+.95*ga,.05+.95*gb,0);
    co.seg(a.p,b.p,[1,.80,.55,.9*Math.pow(ga,2.4)],[1,.80,.55,.9*Math.pow(gb,2.4)],.015+.06*ga,.015+.06*gb,.5);}
  /* tail-lamp ribbons */
  const hs=m.hist;if(show('tailRibbons'))['l','r'].forEach(sd=>{for(let i=2;i<hs.length;i+=2){const a=hs[i-2],b=hs[i],ga=1-(clock-a.c)/.9,gb=1-(clock-b.c)/.9;
    gl_.seg(a[sd],b[sd],[1,.08+.2*a.b,.05,.8*ga*ga*(.55+.45*a.b)],[1,.08+.2*b.b,.05,.8*gb*gb*(.55+.45*b.b)],.04+.16*ga,.04+.16*gb,0);}});
  /* pulses racing along both barriers */
  const dir=G.area(S.outer)>0?-1:1;
  if(show('barrierPulse'))[['o',1],['i',.7]].forEach(e=>{const lp=S.edgeLoops[e[0]],n=9;for(let i=0;i<n;i++){const s0=dir*(clock*T.vmax*1.45)+i*lp.L/n;
    for(let k=0;k<3;k++){const a=lp.at(s0+dir*k*2),b=lp.at(s0+dir*(k+1)*2),fa=k/3,fb=(k+1)/3;
      ad.seg([a[0],H+.05,a[1]],[b[0],H+.05,b[1]],[1,.85,.68,.75*fa*e[1]],[1,.85,.68,.75*fb*e[1]],.30,.30,0);
      co.seg([a[0],H+.05,a[1]],[b[0],H+.05,b[1]],[1,.97,.92,fa*e[1]],[1,.97,.92,fb*e[1]],.07,.07,.6);}}});
