  [-1,1].forEach(q=>add([[-.48,.325,q*.244],[-.38,.442,q*.196],[-.10,.447,q*.193],[.19,.317,q*.252]],false,'metal',.44));
  add([[-.47,.292,-.214],[-.38,.438,.192]],false,'cockpit',.45);
  add([[-.47,.292,.214],[-.38,.438,-.192]],false,'cockpit',.45);
  /* A single outlined bucket seat and steering wheel. These are generic race-cockpit details,
     not a claim that an original manufacturer's cockpit or homologation model was supplied. */
  add(curve([[-.29,.261,.031],[-.41,.348,.033],[-.43,.426,.041],[-.385,.433,.060]],16)
    .concat(curve([[-.385,.433,.060],[-.39,.446,.105],[-.39,.446,.165],[-.385,.433,.190]],12).slice(1))
    .concat(curve([[-.385,.433,.190],[-.43,.426,.209],[-.41,.348,.217],[-.29,.261,.219]],16).slice(1)),false,'cockpit',.66);
  add([[-.29,.261,.031],[-.13,.245,.038],[-.055,.254,.066],[-.055,.254,.184],[-.13,.245,.212],[-.29,.261,.219]],false,'cockpit',.55);
  for(const z of [.078,.172])add([[-.375,.402,z],[-.286,.271,z],[-.115,.253,z]],false,'cockpit',.32);
  add(curve([[.202,.325,-.260],[.150,.352,-.100],[.150,.352,.100],[.202,.325,.260]],24),false,'cockpit',.55);
  add([[.184,.335,.069],[.170,.367,.069],[.170,.367,.183],[.184,.335,.183]],true,'cockpit',.40);
  const steeringPoint=t=>[.043+.020*Math.cos(t),.351+.050*Math.cos(t),.125+.052*Math.sin(t)];
  const steering=Array.from({length:40},(_,i)=>steeringPoint(i*Math.PI*2/40));
  add(steering,true,'cockpit',.70);
  for(const angle of [Math.PI/2,Math.PI,Math.PI*1.5])add([[.043,.351,.125],steeringPoint(angle)],false,'cockpit',.45);
  add([[.043,.351,.125],[.153,.325,.125]],false,'cockpit',.40);
  /* Five fine net strands on the driver's side read only in a detail camera. */
  for(const x of [-.20,-.11,-.02])add([[x,.363,.293],[x,.439,.232]],false,'cockpit',.24);
  for(const y of [.386,.412]){const z=.293-(y-.363)/(.439-.363)*.061;add([[-.231,y,z],[.022,y,z]],false,'cockpit',.24);}
  const dg=(pts,z0)=>pts.map(p=>[-.40+p[1]*.29,.482,z0+p[0]*.105]);
  add(dg([[0,1],[1,1],[1,.5],[0,.5],[0,0],[1,0]],-.15),false,'num');
  add(dg([[1,1],[0,1],[0,0],[1,0],[1,.5],[0,.5]],.04),false,'num');
  m.wheels=[[.58,-1],[.58,1],[-.53,-1],[-.53,1]];
  m.head=[[.997,.200,.122],[.846,.244,.282]];m.tail=[[-.995,.305,.16],[-.99,.305,.31]];
  return m;
};

/* The hull is still here, and still off. true puts the solid body back. */
G.solid=function(on){const S=G.S;if(!S)return false;S.solidBody=!!on;
  S.hull=on?G.carHull():null;S.car=G.carModel();return S.solidBody;};

G.simReset=function(){
  const S=G.S;S.clock=0;S.last=null;S.camT=0;S.shotI=0;S.cam=null;S.camBase=null;S.camAnchor=null;S.camAnchorShot=null;S.camYaw=null;S.camShake=[0,0,0];S._forceShotPrev=null;S._forceShotSide=null;
  /* v5.48 — TELL THE SOUND, do not leave it to infer a rewound clock. This was found and fixed once already
     (v5.42): the engine only learned of a reset by noticing the clock jump backwards more than half a second,
     which silently misses a reset early in a lap and leaves the running engine node and the gearbox state
     behind. Taking this scene's car module brought the old behaviour back with it, so the hook goes back in. */
  if(G.sound&&G.sound.sceneReset)G.sound.sceneReset();
  /* Reset the director's own random stream too, so a chosen moment always gets the same sequence
     of broadcast shots.  Landing shake now has its own deterministic signal and never consumes it. */
  {let sd=7;S.dirRnd=()=>((sd=(sd*16807)%2147483647)/2147483647);}
  /* Rendering-only particles must never advance the director stream. A different render cadence
     may alter how many motes are sampled, but it must not change the next camera decision. */
  S.fxRnd=G.rng(29);
  S.dir=null;S.sceneBeat=null;S.lastSceneBeat=null;S.sceneBeatAt=0;S.beatCounts={};S.lastCueCutAt=-99;
  S.shake=0;S.shakePhase=0;S.shakeSeed=0;S.shookAt=0;S.accum=0;S.paused=false;
  S.sim={s:S.gridS,v:0,brake:0,throttle:0,accel:0,landings:0,lap:0,jumpLap:-1,heroPending:0,slideExitUntil:0,brakeCueUntil:0,hardBraking:false,hist:[],path:[],sparks:[],smoke:[],marks:[],markRun:0,nextSmokeAt:0,smokeSide:0,wheel:0,wheelR:0,burn:0,pitch:0,roll:0,lat:0,slip:0,air:0,vy:0,squash:0,lastHit:-99,go:false,rnd:G.rng(5)};
  if(!S.car)S.car=G.carModel();
  G.pose();
};
G.pose=function(){
  const S=G.S,m=S.sim,CL=S.CL,T=S.tune,p=CL.at(m.s),d=CL.tangent?CL.tangent(m.s):[CL.at(m.s+2.2)[0]-CL.at(m.s-2.2)[0],CL.at(m.s+2.2)[1]-CL.at(m.s-2.2)[1]];
  const path=Math.atan2(d[1],d[0]),hd=path+m.slip;                  /* under power the nose points inside the line it travels */
  const fwd=[Math.cos(hd),0,Math.sin(hd)],rt=[-Math.sin(hd),0,Math.cos(hd)];
  const pr=[-Math.sin(path),0,Math.cos(path)];
  S.pose={hd:hd,path:path,fwd:fwd,rt:rt,w:p[2],pos:[p[0]+pr[0]*m.lat,T.deckH+m.air,p[1]+pr[2]*m.lat]};
};
G.GRID=3.4;
const P0x=S=>S.pose.pos[0],P0z=S=>S.pose.pos[2];
G.step=function(dt){
  const S=G.S,T=S.tune,m=S.sim;S.clock+=dt;
  const go=m.go=S.clock>G.GRID,pv=m.v;
  if(go){const tg=S.vAt(m.s+1.5);m.v=tg>m.v?Math.min(tg,m.v+T.acc*1.25*dt):Math.max(tg,m.v-T.brk*1.15*dt);m.s+=m.v*dt;
    /* Completing a lap arms one clean, moving finish pass for the director.  It is only a cue;
       the car's path, speed and direction stay exactly as the physics step computed them. */
    if(!S.calmDrive&&S.CL&&S.CL.L){const lap=Math.floor(Math.max(0,m.s-S.gridS)/S.CL.L);if(lap>m.lap){m.lap=lap;m.heroPending=lap;}}
  }
  /* v5.71 — THE REARS TURNING AGAINST THE ROAD, nought to one, and the one number the whole effect reads.
     On the grid it is the burnout, on the circuit it is a genuine slide; never both, because a car standing
     still is not sliding. It is chased rather than set, faster up than down, so the tyres light up sharply
     and the cloud trails off the way smoke does. */
  {const want=S.calmDrive?0:(!go
      ? Math.max(0,Math.min(1,(S.clock-T.burnFrom_s)/T.burnRamp_s))*Math.max(0,Math.min(1,(T.burnTo_s-S.clock)/T.burnHook_s))
      : Math.max(0,Math.min(1,(Math.abs(m.slip)-T.markSlip)/Math.max(.02,T.driftFull))));
   m.burn+=(want-m.burn)*(1-Math.exp(-dt*(want>m.burn?11:4.5)));}
  /* A BURNOUT THAT DOES NOT MOVE LAYS NO RUBBER. It creeps, the way a real one does, so what it leaves on
     the grid is a pair of black strips rather than a single smudge. */
  if(!go){m.v=S.calmDrive?0:T.burnCreep_ms*m.burn;m.s+=m.v*dt;}
  const acc=dt>0?(m.v-pv)/dt:0,/* v5.71 — and the brake is ON during a burnout, because that is how you hold one: the fronts are
       stood on while the rears are lit up. It is not a decoration — it puts the tail lights on, and at night
       they are what the smoke behind the car is lit by. */
  braking=go?S.vAt(m.s+5)<m.v-1.5:(!S.calmDrive&&m.burn>.15),k=S.kAt(m.s+1);
  m.accel=acc;
  m.throttle=go?Math.max(0,Math.min(1,acc/Math.max(.001,T.acc*1.25))):0;
  m.brake+=((braking?1:0)-m.brake)*Math.min(1,dt*12);
  const w=S.CL.at(m.s)[2],trackLat=Math.max(0,w/2-T.carS*HW-.35),maxLat=Math.min(trackLat,T.lineOffset);
  const lineT=S.calmDrive?0:Math.max(-1,Math.min(1,k*4.2))*maxLat;
  m.lat+=(lineT-m.lat)*(1-Math.exp(-dt*T.lineResponse));
  /* power oversteer: out of the hairpin and turn 11 the V8 lights up the rears and the tail steps out */
  const onPower=acc>2.5&&m.v<T.vmax*.90&&!S.calmDrive;
  /* v5.71 — and NOT while it is on the line. The creep through the burnout gave the slip model a road speed
     to work with, so the car picked up nearly two degrees of angle while it was supposed to be sitting still.
     A burnout is held straight — a tail stepping out on the line is a donut, which is a different thing and
     not what was asked for. So the grid is square, and the slide model starts when the car is released. */
  const slipT=(S.calmDrive||!go)?0:Math.max(-T.slipMax,Math.min(T.slipMax,k*T.slipGain*Math.min(1,m.v/(T.vmax*.50))*(onPower?1:.22)));
  m.slip+=(slipT-m.slip)*(1-Math.exp(-dt*(onPower?4.0:1.9)));
  /* These are short-lived evidence ledgers for the director, not extra vehicle forces.  They let
     it catch the exit of a genuine power-slide and a hard-brake approach without inventing either. */
  if(!S.calmDrive&&Math.abs(m.slip)>.17)m.slideExitUntil=S.clock+3.2;
  const hardBrake=!S.calmDrive&&m.brake>.58&&m.v>T.vmax*.38;
  if(hardBrake&&!m.hardBraking)m.brakeCueUntil=S.clock+1.55;
  m.hardBraking=hardBrake;
  /* Derived kerb cue: a low lift, no more than once on each completed lap. The trigger remains
     tied to the existing curvature signal; this does not claim a particular real-world chicane. */
  const hit=S.hitAt?S.hitAt(m.s):0;
  if(m.air<=0&&!S.calmDrive){
    const fast=m.v>T.vmax*.60;
    if(m.jumpLap!==m.lap&&hit>T.jumpTrig&&fast&&S.clock-m.lastHit>T.jumpEvery_s){m.lastHit=S.clock;m.jumpLap=m.lap;
      m.vy=T.jumpVy*(.72+.28*hit)*(m.v/T.vmax);m.air=.001;
      m.kickRoll=(k>=0?1:-1)*T.jumpRoll*.35;}
  }
  /* v5.71 — THE CAP IS NOT ONE NUMBER ANY MORE. A burnout needs a wall of it; a wisp off one tyre in a
     corner does not. And the whole budget rides the quality rung, so the machine that had to give up
     reflections gives up smoke before it gives up the frame rate. This is read when a puff is pushed, not
     when the step starts, so it follows m.burn within the same frame. */
  const smokeCap=()=>{const q=S.quality&&S.quality.name;
    let k=q==='balanced'?.42:q==='high'?.82:1;
    /* AND IT DOES NOT WAIT FOR THE LADDER. The quality ladder needs two slow readings before it gives up a
       rung, and the burnout happens in the first three and a half seconds — before there is a reading at all.
       So a frame rate already known to be under the guard's own threshold cuts the budget straight away. This
       is the cheapest thing in the scene to give up and the most expensive thing to keep: five hundred large
       alpha quads over each other is fill rate, and fill rate is what a phone runs out of first. */
    if(S.fps&&S.fps<26)k=Math.min(k,.42);
    if(S.fps&&S.fps<15)k=Math.min(k,.22);
    return Math.round((m.burn>.45?T.maxSmokeBurn:T.maxSmoke)*k);};
  const pushSmoke=x=>{const cap=smokeCap();if(m.smoke.length>=cap)m.smoke.shift();m.smoke.push(x);};
  if(m.air>0){
    m.vy-=T.grav*dt;m.air+=m.vy*dt;                    /* real gravity, on the same fast-forward as everything else */
    if(m.air<=0){m.squash=Math.min(1,-m.vy/Math.max(1e-6,T.jumpVy)*1.15);m.air=0;m.vy=0;m.landings++;   /* and then it slams back down */
      for(let i=0;i<2;i++){const o=[P0x(S)+(m.rnd()-.5)*1.1,T.deckH+.04,P0z(S)+(m.rnd()-.5)*1.1];
        pushSmoke({p:o,v:[(m.rnd()-.5)*1.6,.35+m.rnd()*.35,(m.rnd()-.5)*1.6],c:S.clock,r:m.rnd()});}}
  }
  m.squash*=Math.max(0,1-dt*4.2);
  const roTgt=S.calmDrive?0:Math.max(-.07,Math.min(.07,k*m.v*m.v*.00085))+(m.air>0?(m.kickRoll||0)*Math.min(1,m.air*2.2):0);
  const pitchT=S.calmDrive?0:Math.max(-.028,Math.min(.075,-acc*.0009))+(m.air>0?Math.max(-.085,Math.min(.085,m.vy*.24)):0)-m.squash*.045;
  m.pitch+=(pitchT-m.pitch)*(1-Math.exp(-dt*6));
  m.roll+=(roTgt-m.roll)*(1-Math.exp(-dt*5));
  /* v5.71 — ONE EMITTER FOR BOTH, because a burnout and a drift are the same thing at two road speeds: a
     rear tyre turning faster than the ground under it. m.burn sets the rate, the size, how long it hangs and
     whether both tyres are alight or only the loaded one, so nothing has to decide which of the two it is
     looking at. The smoke leaves the tyre BACKWARDS and OUTWARDS and low, then lifts — which is the shape of
     the real thing, and the reason it used to read as a row of dots when it went straight up. */
  /* v5.71 — AND A TYRE IN THE AIR MAKES NO SMOKE. Raised in Andrew Fisher's own tyre-effects brief, 22 Sep
     2026: the emitter had no ground-contact guard, so a slide that carried over a kerb lift went on boiling
     smoke off a wheel that was not touching anything, at deck height, under a car in the air. m.air is the
     height off the deck the jump model already keeps; nought means the tyres are down. */
  if(!S.calmDrive&&m.air<=0&&m.burn>.04&&S.clock>=m.nextSmokeAt){
    const b=m.burn,R2=m.rnd,P1=S.pose,Sx1=T.carS;
    m.nextSmokeAt=S.clock+T.smokeEvery_s/(.35+b*1.95);
    m.smokeSide=m.smokeSide? -m.smokeSide:1;
    const sides=b>.45?[-1,1]:[m.smokeSide];      /* both patches boil on a burnout; a slide lights the loaded one */
    const per=b>.72?2:1;
    for(const sd of sides)for(let i=0;i<per;i++){
      const o=[P1.pos[0]+(P1.fwd[0]*-.57+P1.rt[0]*sd*(.38+R2()*.18))*Sx1,
               T.deckH+.03+R2()*.09*Sx1,
               P1.pos[2]+(P1.fwd[2]*-.57+P1.rt[2]*sd*(.38+R2()*.18))*Sx1];
      const kick=1.1+R2()*2.3,out=.5+R2()*1.25;
      pushSmoke({p:o,c:S.clock,r:R2(),
        v:[(-P1.fwd[0]*kick+P1.rt[0]*sd*out)*b-P1.fwd[0]*m.v*.05+(R2()-.5)*.75,
           .24+R2()*.40,
           (-P1.fwd[2]*kick+P1.rt[2]*sd*out)*b-P1.fwd[2]*m.v*.05+(R2()-.5)*.75],
        k:1+b*(T.burnSize-1),a:.85+b*(T.burnAlpha-.85),l:T.smokeLife_s+b*(T.burnLife_s-T.smokeLife_s),
        /* a tone and a spin of its own. Without the tone a cloud is one flat white mass; without the spin
           every quad faces the camera the same way up and a cluster reads as a row of soft rectangles,
           which is exactly what the first pass looked like. */
        t:.66+R2()*.34,w:(R2()-.5)*1.5});
    }
  }
  m.smoke=m.smoke.filter(s2=>S.clock-s2.c<(s2.l||T.smokeLife_s));
  /* v5.71 — IT RISES. Tyre smoke boils out sideways and then lifts as it thins, and the first pass had it
     dragging to a stop at deck height, which is why the cloud sat in a flat bar behind the car. Sideways
     motion is dragged out; upward motion is fed. */
  m.smoke.forEach(s2=>{s2.p=[s2.p[0]+s2.v[0]*dt,s2.p[1]+s2.v[1]*dt,s2.p[2]+s2.v[2]*dt];
    s2.v[0]*=1-dt*1.35;s2.v[2]*=1-dt*1.35;s2.v[1]=s2.v[1]*(1-dt*.30)+dt*.55;});
  m.wheel+=m.v*dt/(.135*T.carS);
  /* v5.71 — and the rears turn faster than the road whenever they are lit up. This is what the smoke is
     coming off, so it has to be visible in the wheel itself or the effect reads as fog round a rolling car. */
  m.wheelR+=(m.v+T.burnSpin_ms*m.burn)*dt/(.135*T.carS);
  G.pose();
  const P=S.pose,Sx=T.carS,at=(x,y,z)=>[P.pos[0]+(P.fwd[0]*x+P.rt[0]*z)*Sx,P.pos[1]+y*Sx,P.pos[2]+(P.fwd[2]*x+P.rt[2]*z)*Sx];
  if(go&&m.v>1){m.hist.push({l:at(-1,.335,-.26),r:at(-1,.335,.26),c:S.clock,b:m.brake});m.path.push({p:at(-.9,.06,0),c:S.clock});}
  /* v5.66 — RUBBER GOES DOWN WHERE THE TYRE SLID. The two rear contact patches, sampled by distance travelled
     rather than by frame, so the mark is the same on a 120 Hz machine and a 30 Hz one. A slide that stops and
     starts again is a NEW run: without that, the end of one slide and the start of the next were joined by a
     straight band of rubber across ground the car crossed without sliding at all. */
  /* v5.71 — `go` is gone from this condition on purpose: the burnout happens BEFORE the car is released,
     and a burnout that leaves no rubber on the grid is the one thing everybody would notice. */
  {const sl=Math.abs(m.slip),laying=!S.calmDrive&&m.air<=0&&m.v>.30&&(sl>T.markSlip||m.burn>.12);
   if(laying){
     const l=at(-.55,.012,-.42),r=at(-.55,.012,.42),last=m.marks.length?m.marks[m.marks.length-1]:null;
     const far=!last||last.run!==m.markRun||Math.hypot(l[0]-last.l[0],l[2]-last.l[2])>T.markStep_pt;
     if(far){
       m.marks.push({l:l,r:r,c:S.clock,run:m.markRun,
                     /* full weight a little past the threshold rather than at the physical slip limit, which
                        the car reaches only in the very hardest corner: measured against the frame, ramping all
                        the way to slipMax left the average mark at about a sixth opacity and the whole trail
                        darkened the road by 7% at its strongest — there, but not something you would notice */
                     w:Math.min(1,Math.max(m.burn,(sl-T.markSlip)/Math.max(.02,T.markFull)))});
       while(m.marks.length>T.maxMarks)m.marks.shift();
     }
   } else if(m.marks.length&&m.marks[m.marks.length-1].run===m.markRun) m.markRun++;
   while(m.marks.length&&S.clock-m.marks[0].c>T.markLife_s)m.marks.shift();}
  while(m.hist.length&&S.clock-m.hist[0].c>.9)m.hist.shift();
  while(m.path.length&&S.clock-m.path[0].c>1.7)m.path.shift();
  /* There are no theatrical braking/high-speed sparks. If a future verified effect is enabled,
     retain the defensive cap rather than letting particles accumulate between close shots. */
  if(T.maxSparks<=0)m.sparks.length=0;
  else if(m.sparks.length>T.maxSparks)m.sparks.splice(0,m.sparks.length-T.maxSparks);
  m.sparks=m.sparks.filter(q=>S.clock-q.c<.6);
  m.sparks.forEach(q=>{q.p=[q.p[0]+q.v[0]*dt,Math.max(T.deckH+.02,q.p[1]+q.v[1]*dt),q.p[2]+q.v[2]*dt];q.v[1]-=T.grav*.42*dt;});
  if(G.camStep)G.camStep(dt);
};

/* everything that is rebuilt each frame: the car, its light, trails, pulses, sparks, gantry, beacons */
G.buildDynamic=function(){
  const S=G.S,T=S.tune,m=S.sim,P=S.pose,Sx=T.carS,H=T.deckH,gl_=S.dynGlow,co=S.dynCore,ad=S.dynAdd,dc=S.decals,clock=S.clock;
  const L=S.look||G.LOOKS.day,FX=L.effects,reduced=!!S.reducedMotion,fxRnd=S.fxRnd||(S.fxRnd=G.rng(29));
  const show=n=>!reduced&&(n==='brakeWash'?FX[n]!==false:!!FX[n]);   /* brakeWash: on unless a look says false (v5.79) */
  gl_.clear();co.clear();ad.clear();dc.clear();
  const eye=S.cam?S.cam.eye:[0,200,200];
  /* Pitch and roll are rotations about the wheel-centre height, not a vertical shear.  A shear
     leaves x/z behind while y moves, visibly pulling wings and wheels out of shape in close-ups. */
  const W=q=>{let x=q[0],y=q[1]-.142,z=q[2];
    const cp=Math.cos(m.pitch),sp=Math.sin(m.pitch);[x,y]=[x*cp+y*sp,-x*sp+y*cp];
    const cr=Math.cos(m.roll),sr=Math.sin(m.roll);[y,z]=[y*cr+z*sr,-y*sr+z*cr];y+=.142;
    return [P.pos[0]+(P.fwd[0]*x+P.rt[0]*z)*Sx,P.pos[1]+y*Sx,P.pos[2]+(P.fwd[2]*x+P.rt[2]*z)*Sx];};
  const cc=W([0,.3,0]),ev=G.V.norm(G.V.sub(eye,cc));
  const idleGlow=m.go?1:.72+.28*Math.sin(clock*10);
  const face=(a,b)=>{const mx=(a[0]+b[0])/2-cc[0],my=(a[1]+b[1])/2-cc[1],mz=(a[2]+b[2])/2-cc[2],l=Math.hypot(mx,my,mz)||1,d=(mx*ev[0]+my*ev[1]+mz*ev[2])/l;return .42+.58*G.smooth((d+.35)/.95);};
  /* A small sun-directional contact shadow stops the transparent car reading as if it floats.
     It reacts only to the simulated air height; it does not create new track geometry or FX. */
  const sh=S.shade;
  if(sh){
    sh.clear();
    const sy=H+.002,f=P.fwd,r2=P.rt,LX=1.34*Sx,LZ=.57*Sx,N2=32;
    const lift=Math.max(.05,1-m.air*5.0),LXa=LX*(1+m.air*1.1),LZa=LZ*(1+m.air*1.1);
    const shadowX=P.pos[0]-f[0]*.12*Sx-.45/.80*m.air*.55,shadowZ=P.pos[2]-f[2]*.12*Sx-.40/.80*m.air*.55;
    const c=sh.vert(shadowX,sy,shadowZ,0,0,0,.68*lift,0,0);
    const inner=[],rim=[];
    for(let k=0;k<N2;k++){const t=2*Math.PI*k/N2;
      const ex2=Math.cos(t)*LXa,ez2=Math.sin(t)*LZa;
      inner.push(sh.vert(shadowX+(f[0]*ex2+r2[0]*ez2)*.74,sy,shadowZ+(f[2]*ex2+r2[2]*ez2)*.74,0,0,0,.48*lift,0,0));
      rim.push(sh.vert(shadowX+f[0]*ex2+r2[0]*ez2,sy,shadowZ+f[2]*ex2+r2[2]*ez2,0,0,0,0,0,0));}
    for(let k=0;k<N2;k++){const j=(k+1)%N2;sh.tri(c,inner[k],inner[j]);sh.tri(inner[k],rim[k],rim[j]);sh.tri(inner[k],rim[j],inner[j]);}
    /* v6.61 - the trailer's own contact shadow */
    if(S.towVms&&G.trailerStep){const T=G.trailerStep(S);if(T){const c2=Math.cos(T.hd),s2=Math.sin(T.hd),tf=[c2,0,s2],tr=[-s2,0,c2],cx=T.ax+tf[0]*.3*Sx,cz=T.az+tf[2]*.3*Sx,LX2=1.05*Sx,LZ2=.74*Sx;
      const c0=sh.vert(cx,sy,cz,0,0,0,.55,0,0),ring=[];for(let k=0;k<N2;k++){const t=2*Math.PI*k/N2,ex=Math.cos(t)*LX2,ez=Math.sin(t)*LZ2;ring.push(sh.vert(cx+tf[0]*ex+tr[0]*ez,sy,cz+tf[2]*ex+tr[2]*ez,0,0,0,0,0,0));}
