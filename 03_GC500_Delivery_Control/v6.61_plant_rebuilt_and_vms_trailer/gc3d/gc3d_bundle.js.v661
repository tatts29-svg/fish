/* Convert the real-world figures into the key-plan points per second the engine runs on.
   Called at init and again whenever tc or exag changes. */
G.units=function(T){
  const M=G.M_PER_PT, tc=T.tc, q=tc*tc/M;
  T.vmax  = T.vtop_kmh/3.6*tc/M;          /* points per second                */
  T.vmin  = T.vfloor_kmh/3.6*tc/M;
  T.acc   = T.gAcc*9.81*q;                /* points per second per second     */
  T.brk   = T.gBrk*9.81*q;
  T.aLat  = T.gLat*9.81*q;
  /* The solid coupe spans about 2.20 local units including its aero. The default now uses
     nominal life size, retaining exag only as an explicit integrator setting. */
  T.carS  = T.carLen_m*T.exag/(2.20*M);   /* one local model unit, in points   */
  T.lineOffset=Math.max(0,T.lineOffsetMax_m||0)/M;
  T.deckH = T.deckH_m/M;
