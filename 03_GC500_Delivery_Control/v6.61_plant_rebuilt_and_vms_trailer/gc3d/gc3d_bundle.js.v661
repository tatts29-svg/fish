    /* v6.51 - the three loops, each through its own gain into the same lowpass the designed engine uses, so distance dulls them the same way */
    SND.nodes.loops=LOOPS.map(L=>{const s=ctx.createBufferSource();s.buffer=SND.bufs[L[0]];s.loop=true;s.playbackRate.value=1;const g=ctx.createGain();g.gain.value=0;s.connect(g);g.connect(SND.nodes.lp);s.start(t);return {src:s,g:g,name:L[0],native:L[1],win:L[2]};});
    SND.nodes.engine=SND.nodes.loops[0].src;
    const n2=ctx.createBufferSource();n2.buffer=SND.bufs.noise;n2.loop=true;n2.connect(SND.nodes.intakeBp);n2.start(t);SND.nodes.intake=n2;
    const sc2=ctx.createBufferSource();sc2.buffer=SND.bufs.noise;sc2.loop=true;sc2.connect(SND.nodes.scrubBp);sc2.start(t);SND.nodes.scrub=sc2;
    log('engine start (three generated loops)',S,t);return;
  }
  const src=ctx.createBufferSource();src.buffer=SND.bufs.pulse;src.loop=true;src.playbackRate.value=SND.rpm/R0;src.connect(SND.nodes.pulseIn);src.start(t);SND.nodes.engine=src;
  const n=ctx.createBufferSource();n.buffer=SND.bufs.noise;n.loop=true;n.connect(SND.nodes.intakeBp);n.start(t);SND.nodes.intake=n;
  const sc=ctx.createBufferSource();sc.buffer=SND.bufs.noise;sc.loop=true;sc.connect(SND.nodes.scrubBp);sc.start(t);SND.nodes.scrub=sc;   /* the tyres (v5.40) */
  log('engine start (designed V8)',S,t);
}
function engineStop(t){['engine','intake','scrub','crowd'].forEach(k=>{const src=SND.nodes[k];if(!src)return;try{src.stop(t!=null?t:undefined);}catch(e){}SND.nodes[k]=null;});if(SND.nodes.loops){SND.nodes.loops.forEach(L=>{try{L.src.stop(t!=null?t:undefined);}catch(e){}});SND.nodes.loops=null;}if(SND.g.engine)set(SND.g.engine.gain,0,t!=null?t:now());SND.engineGain=0;}
/* revs from the car: the sim's own gearbox (part 3 — one gearbox for the sound and the exhaust flames), the limiter
   while the lights count, wheelspin off the line */
function revs(S,t){
  const m=S.sim,st=SND.st,v=Math.max(0,m.v),clock=S.clock;
  let rpm,thr;
  if(!m.go){SND.gear=0;const lamps=clock>.5;rpm=lamps?Math.min(LIMIT,IDLE+(LIMIT-IDLE)*Math.min(1,(clock-.5)/.7))+(clock>1.2?150*Math.sin(clock*2*Math.PI*9):0):IDLE+80*Math.sin(clock*3);thr=lamps?1:.1;
    /* v5.71 — AND THE BURNOUT IS HEARD, NOT JUST SEEN. spin is what drives the tyre scrub down at line 342,
       and on the grid it was hard nought: the car lit both rears up, filled the screen with smoke, and made
       no tyre noise whatever. It is the same number the smoke, the rubber and the rear wheel speed all read,
       so the sound now says exactly what the picture says. The engine above was already sitting on the
       limiter and fluttering off it from 1.2 s, which is what a car about to do this actually sounds like. */
    return {rpm:rpm,thr:thr,spin:Math.max(0,Math.min(1,m.burn||0))};}
  if(!st.go){st.go=true;st.goAt=clock;SND.gear=0;st.lastShiftAt=m.shiftAt;log('go — clutch',S,t);}
  const since=clock-st.goAt,spin=since<.9?1-since/.9:0;
  const ahead=S.vAt(m.s+1.5),accel=ahead>v+.3,braking=m.brake>.12;
  thr=braking?0:accel?1:.55;
  /* v5.48 — THE GEARBOX IS THE ENGINE'S OWN NOW. This used to read m.rpm, m.gear and m.shiftAt straight off the
     simulation, because the scene it grew up in kept one gearbox for the sound and the exhaust flames. Andrew
     Fisher's v1.8 simulation does not carry those fields at all, so every one of them came back undefined and
     the whole chain went to NaN — a browser refuses a non-finite AudioParam, which is exactly how it surfaced.
     So the gears are worked out here, from road speed, which every simulation has. Real gearing would change up
     roughly every half second at this scene's 4.6x time compression and machine-gun rather than sound like a
     car, so the audible ratios are widened and given hysteresis — it will not drop back until well under the
     change-up speed. That is a departure from a real gearbox and it is stated rather than hidden. The figures
     are from Andrew Fisher's own part 7. */
  if(m.rpm==null){
