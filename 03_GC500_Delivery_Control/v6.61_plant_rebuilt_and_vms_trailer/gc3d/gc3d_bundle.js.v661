        return [.082*m,.182*m,.034*m,1];
      };
      const NF=near?11:mid?9:8,NP=near?8:mid?6:5,NS=near?5:4;
      for(let f=0;f<NF;f++){
        const ang=phase+f*Math.PI*2/NF+.11*Math.sin(f*2.3+phase),cs=Math.cos(ang),sn=Math.sin(ang),
              upright=f%4===0,length=r*(1.48+.40*shapeHash(x,z,10+f))*(upright?.72:1),
              sag=(upright?.12:.25)+.17*shapeHash(x,z,30+f),arch=upright?.60:.22+.12*shapeHash(x,z,40+f),
              curve=u=>[crown[0]+cs*length*u,crown[1]+h*(arch*Math.sin(u*Math.PI)-sag*u*u),crown[2]+sn*length*u],
              put=(p,u,shade=1)=>{const col=leafCol(u,ang);return dayTR.vert(...p,col[0]*shade,col[1]*shade,col[2]*shade,1,0,0);};
        /* The rachis is a slim continuous ribbon; staggered leaflets define the broken edge. */
        for(let j=0;j<NS;j++){
