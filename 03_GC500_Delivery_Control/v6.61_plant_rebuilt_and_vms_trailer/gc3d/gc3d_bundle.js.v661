const smoothLoop=(arr,w)=>arr.map((_,i)=>{const o=new Array(arr[0].length).fill(0);for(let j=-w;j<=w;j++){const p=arr[(i+j+arr.length)%arr.length];for(let k=0;k<o.length;k++)o[k]+=p[k];}return o.map(v=>v/(2*w+1));});

/* A closed loop with arc-length lookup.  The original version interpolated straight from point to
   point.  That is fine for drawing a line, but a vehicle sees the tiny heading change at every
   point.  Cubic Hermite interpolation keeps position and tangent continuous, so the car holds a
   clean arc through the tightly sampled chicanes instead of twitching at their joins. */
G.Loop=class{
  constructor(pts){
    this.p=pts;this.n=pts.length;this.cum=[0];
