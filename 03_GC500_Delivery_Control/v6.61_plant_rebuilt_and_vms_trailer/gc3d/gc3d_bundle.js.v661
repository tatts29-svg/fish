        tube(add(pa,[0,1,0],.11/M),add(pb,[0,1,0],.11/M),.021/M,darkMetal,4,false);
        tube(add(pa,[0,1,0],1.10/M),add(pb,[0,1,0],1.10/M),.019/M,metal,4,false);
        tube(ma,mb,.024/M,metal,4,false);tube(ta,tb,.025/M,metal,4,false);
