};
G.raceCarLiveryInfo={width:W,height:H,format:'R8 / RED / UNSIGNED_BYTE',labels:['Coates','INDUSTRIAL SOLUTIONS','26','Fisher'],source:'Typeset DejaVu Sans Bold, not an official logo artwork'};
G.raceCarDecals=function(){
  if(G._raceCarDecals)return G._raceCarDecals;
