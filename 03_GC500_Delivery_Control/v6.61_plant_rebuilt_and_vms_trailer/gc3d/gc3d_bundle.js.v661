    winGain:.9,nightGain:1.4,nightGamma:1,nightKnee:.30,nightFar:{from:60,to:200,gain:2},headlamp:3.2,
    fogScale:1,fogNear:40,fogFar:520,
    /* v5.65 — AND THIS LOOK IS LEFT ALONE, ON PURPOSE. The pit wall behaves here exactly as it does in the
       other dark looks: at track level it is a sheet of light rather than a wall, and pulling it back to .20
