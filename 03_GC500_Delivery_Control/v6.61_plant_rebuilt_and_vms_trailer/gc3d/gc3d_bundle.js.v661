        trunks=new G.MeshBatch(gl,[3,4,2],false),tg=new G.LineBatch(gl,S.quad,4096,false),trnd=G.rng(91);
  const inRing=(x,z,R)=>{let c=false;for(let i=0,j=R.length-1;i<R.length;j=i++){const a=R[i],b=R[j];
    if((a[1]>z)!==(b[1]>z)&&x<(b[0]-a[0])*(z-a[1])/(b[1]-a[1])+a[0])c=!c;}return c;};
