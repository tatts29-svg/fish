  const parts=[],mix=(a,b,t)=>a+(b-a)*t,white=[.96,.96,.96],yellow=[1,.79,.008];
  const cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];
  function patch(name,label,fn,expected,nu,nv,color){
    const p={name,material:'decal',vertices:[],indices:[],color:color||white},r=rects[label],step=1e-4;let reversed=false;
    for(let i=0;i<=nu;i++)for(let j=0;j<=nv;j++){
      const u=i/nu,v=j/nv,q=fn(u,v),ua=fn(u-step,v),ub=fn(u+step,v),va=fn(u,v-step),vb=fn(u,v+step);
      let n=cross(ub.map((x,k)=>x-ua[k]),vb.map((x,k)=>x-va[k]));
      const flip=n.reduce((s,x,k)=>s+x*expected[k],0)<0;if(flip)n=n.map(x=>-x);
      const len=Math.hypot(...n);n=n.map(x=>x/len);if(i===0&&j===0)reversed=flip;
      p.vertices.push(q[0]+n[0]*.0015,q[1]+n[1]*.0015,q[2]+n[2]*.0015,...n,(r[0]+.5+u*(r[2]-1))/W,(r[1]+.5+v*(r[3]-1))/H);
    }
    for(let i=0;i<nu;i++)for(let j=0;j<nv;j++){
      const a=i*(nv+1)+j,b=a+nv+1;
      if(reversed)p.indices.push(a,b+1,b,a,a+1,b+1);else p.indices.push(a,b,b+1,a,b+1,a+1);
    }
    parts.push(p);
  }
  function sideLabel(side,name,label,x0,x1,y0,y1,nu=36,nv=8,color){
    patch((side>0?'right-':'left-')+name,label,(u,v)=>{
      const x=mix(x0,x1,side>0?u:1-u),y=mix(y1,y0,v);return[x,y,side*G.raceCarSideZ(x,y)];
    },[0,0,side],nu,nv,color);
  }
  for(const side of [-1,1]){
    sideLabel(side,'door-Coates','coates',-.37,.16,.212,.303);
    sideLabel(side,'door-Industrial-Solutions','industrial',-.37,.16,.181,.202,42,3);
    sideLabel(side,'door-26','number',.195,.328,.198,.303,12,12);
    // Same bilinear window definition as the body model, so lettering stays attached.
