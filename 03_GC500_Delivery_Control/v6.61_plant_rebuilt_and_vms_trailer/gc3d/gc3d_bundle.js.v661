const ID={tint:[1,1,1],lift:[0,0,0]};
G.LOOKS={
  day:{name:'day',label:'Day Race',day:1,
    sky:'linear-gradient(to bottom,#62a5ce 0%,#bcdde9 58%,#e9eeea 100%)',bloom:.16,bloomCut:.88,winGain:0,
    fogScale:1.35,fogNear:65,fogFar:680,
    lines:{streets:.20,halo:0,edgeGlow:0,edgeCore:0,bEdges:0,dynGlow:.20,dynAdd:.38,dynCore:1,roadGlow:0,roadCore:.30,cityLights:0,treeGlow:0},
    /* v5.49 — the day ground, brought back to the look Andrew Fisher approved on 17 Sep 2026. v1.8 drew the
