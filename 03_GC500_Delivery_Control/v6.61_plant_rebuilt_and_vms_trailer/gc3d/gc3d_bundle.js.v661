    return h.toString(36);
  }

  function embeddedAssets(built, tree, pack) {
    const RT = window.GC500RT, enc = new TextEncoder();
    const bytes = new Map();                       /* tile id -> {bytes, mimeType}, filled on demand */
    const serve = RT.createEmbeddedFetch(bytes);
    const requests = new Map();
    /* what this pack IS, in a few characters: its own credit line and the counts it reports */
    const mark = fnv1a([pack.credit || '', pack.mPerPt, (pack.b || []).length, (pack.roads || []).length].join('|'));

    (function collect(node) {
