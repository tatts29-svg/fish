        /* letters, digits, dot, slash and dash only — the loader's own rule for a key */
        key: node.id + '.' + mark + '.t' + node.triangles,
        url: 'gc500-embedded:' + node.id, kind: 'json', validate: RT.isTileMeshPayload,
      });
