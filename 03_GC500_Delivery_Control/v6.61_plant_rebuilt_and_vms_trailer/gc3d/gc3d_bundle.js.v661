const tau=.08,set=(p,v,t,tc)=>{try{p.setTargetAtTime(v,t,tc||tau);}catch(e){p.value=v;}};
SND.on=function(){
  if(!SND.ctx&&!make())return false;
  SND.active=true;decodeAll();try{localStorage.setItem(KEY,'on');}catch(e){}
  if(!isOffline()){try{SND.ctx.resume();}catch(e){}}
  log('on');return true;
};
SND.off=function(){
  SND.active=false;try{localStorage.setItem(KEY,'off');}catch(e){}
  engineStop();
  if(SND.ctx&&!isOffline()){try{SND.ctx.suspend();}catch(e){}}
  log('off');
};
/* v5.42 — THE SCENE NOW TELLS THE SOUND IT HAS BEEN RESET, instead of the sound inferring it.
   Until now the only way the sound learned of a reset was `tick` noticing the clock had gone BACKWARDS by more
   than half a second. That works for a reset mid-lap and fails silently for one early in it: reset at a clock
   under 0.5 s and the test never trips, so the running engine node, the gearbox state, the shift and pop timers
   and the camera's previous eye all survive into a lap that has just started. Caught by a check that passed
   twice and failed the third time (verify-gc3d, 17 Sep 2026) — the engine was sounding correctly but had never
   been restarted, so the log had no record of it. A record that depends on how far the previous lap happened to
   get is not a record. `G.simReset` calls this directly now; the clock test stays as a fallback for anything
   that rewinds the clock without going through it. */
SND.sceneReset=function(at){
  if(!SND.ctx)return false;                       /* nothing to reset if the sound was never switched on */
  const st=SND.st,ta=at!=null?at:now();
  st.lamp=0;st.launched=false;st.shot=null;st.go=false;st.lastShiftAt=-9;st.cutUntil=-9;st.blipUntil=-9;st.popAt=-9;st.nextRpmLog=0;st.prevEye=null;st.dop=0;st.lastT=-1;
  SND.gear=0;SND.rpm=IDLE;engineStop(ta);log('scene reset',null,ta);return true;
};
SND.suspend=function(){if(SND.ctx&&SND.ctx.state==='running'){try{SND.ctx.suspend();}catch(e){}log('suspended');}};
SND.resume=function(){if(SND.active&&SND.ctx&&SND.ctx.state==='suspended'&&!isOffline()){try{SND.ctx.resume();}catch(e){}log('resumed');}};
SND.close=function(){engineStop();if(SND.ctx){try{if(!isOffline())SND.ctx.close();}catch(e){}log('closed');}SND.ctx=null;SND.active=false;SND.bufs={};SND.g={};SND.nodes={};
  SND.st={lamp:0,launched:false,shot:null,lastT:-1,go:false,goAt:0,shiftAt:-9,cutUntil:-9,blipUntil:-9,thr:0,popAt:-9,nextRpmLog:0,tickedAt:-1};SND.rpm=IDLE;SND.gear=0;};   /* the preference stays in storage; the live state does not outlive the scene */
function beep(i,S,t){
  const ctx=SND.ctx,o=ctx.createOscillator(),g=ctx.createGain();
  o.type='sine';o.frequency.value=i<4?1180:1480;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.16,t+.008);g.gain.exponentialRampToValueAtTime(.0008,t+.11);
  o.connect(g);g.connect(SND.g.beep);o.start(t);o.stop(t+.13);log('beep '+(i+1),S,t);
}
function play(k,gain,S,t){
  const b=SND.bufs[k];if(!b){log(k+' (no clip)',S,t);return false;}
  const ctx=SND.ctx,src=ctx.createBufferSource(),g=ctx.createGain();src.buffer=b;g.gain.value=gain;src.connect(g);g.connect(SND.g[k]);src.start(t);log(k,S,t);return true;
}
/* a burst of shaped noise into a node: the wheelspin, the pops, the whoosh when there is no take */
function burst(dest,t,len,f0,f1,q,peak,S,name){
  const ctx=SND.ctx,src=ctx.createBufferSource(),bp=ctx.createBiquadFilter(),g=ctx.createGain();
  src.buffer=SND.bufs.noise;src.loop=true;bp.type='bandpass';bp.Q.value=q;bp.frequency.setValueAtTime(f0,t);bp.frequency.exponentialRampToValueAtTime(Math.max(20,f1),t+len);
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(peak,t+Math.min(.02,len*.25));g.gain.exponentialRampToValueAtTime(.0005,t+len);
  src.connect(bp);bp.connect(g);g.connect(dest);src.start(t);src.stop(t+len+.02);if(name)log(name,S,t);
