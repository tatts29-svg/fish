    const dotF=((eye[0]-P.pos[0])*P.fwd[0]+(eye[2]-P.pos[2])*P.fwd[2])/(Math.hypot(eye[0]-P.pos[0],eye[1]-P.pos[1],eye[2]-P.pos[2])||1);
    const hF=G.smooth(dotF*2.6+.10),tF=G.smooth(-dotF*2.6+.20);
