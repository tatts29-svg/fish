        const ax=rx*ca+ux*sa,ay=ry*ca+uy*sa,az=rz*ca+uz*sa;
        const bx=ux*ca-rx*sa,by=uy*ca-ry*sa,bz=uz*ca-rz*sa;
        const tn=s2.t||1;
        let cr=tint[0]*tn,cg=tint[1]*tn,cb=tint[2]*tn;
        /* v5.71 — LIT BY THE TAIL LIGHTS. At night the smoke immediately behind the car is sitting in two red
           lamps under brake, and drawing it as flat grey fog is the one thing that gives away that a puff is a
           sprite rather than something in the scene. Warmth is mixed in by how close the puff still is to the
           back of the car and taken out again as it drifts off and thins, which is what light actually does and
           is cheap enough to work out per puff. Daylight gets none of it: in daylight the lamps lose. */
        if(lamp){const dx=p0[0]-lamp[0],dz=p0[2]-lamp[2],near=Math.max(0,1-(dx*dx+dz*dz)/lampR2);
          const wl=near*near*(1-age)*lamp[3];
          if(wl>.012){cr+=(1.00-cr)*wl;cg+=(.20-cg)*wl;cb+=(.11-cb)*wl;}}
        const q=(sx,sy)=>pf.vert(p0[0]+ax*sx*rr+bx*sy*rr,p0[1]+ay*sx*rr+by*sy*rr,p0[2]+az*sx*rr+bz*sy*rr,
