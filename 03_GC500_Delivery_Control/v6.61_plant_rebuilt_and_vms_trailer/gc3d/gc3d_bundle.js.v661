       Because this look has an APPROVED BASELINE. Andrew Fisher signed off these four drone stills on
       17 Sep 2026 and tests/test_gc3d.py measures every fresh render against them — not emptier, not darker,
       not flatter, not less detailed. Pulled back to .20 the dark heli shot came in at .00646 of edge detail
       against a floor of .01154, because from a drone the pit wall and the stands' treads ARE much of the
       visible circuit even while, from the car, they are a wall of light.

       So the improvement goes where he asked for it — LED and Coates orange, the two he called short — and
       his approved night look stays his. Changing it is a decision for him with the pictures in front of him,
       not one to take on the way past. */
    lines:{streets:.55,halo:.45,edgeGlow:.30,edgeCore:.55,bEdges:.60,dynGlow:.55,dynAdd:.65,dynCore:.85,roadGlow:.45,roadCore:.70,cityLights:.75,treeGlow:.08,thinFloor:2.4},
    mat:{building:{tint:[.62,.62,.66],lift:[0,0,0]},deck:{tint:[.50,.57,.70],lift:[.004,.006,.009]},walls:{tint:[.08,.15,.23],lift:[.008,.012,.02]},kerb:{tint:[.45,.48,.55],lift:[.004,.006,.009]},barrier:ID,water:ID,beach:ID,park:ID,tree:ID},
    /* v5.79 — NOTHING GLOWS BEHIND THE CAR. Andrew Fisher, 23 Sep 2026, with the restored night in front of him:
       no glow behind the car. The orange trail along the path, the red ribbons off the
       tail lamps and the red wash on the road under brake are all off here; the headlamps' pools ahead of the car
       stay. The other looks keep what they had. */
    effects:{shoulder:true,roadLight:true,energyTrail:false,tailRibbons:false,brakeWash:false,barrierPulse:true,beam:true,beacons:true,motes:true,crowdFlashes:true,roadGlow:true,cityLights:true,treeGlow:true,surf:true}},
  /* v5.63 — THE LED CIRCUIT. Andrew Fisher approved a premium look: a dark presentation surface, the route
     drawn in saturated Coates orange with a crisp bright core, controlled glow, and the surroundings pulled
     right back so the circuit is the subject rather than one bright thing among many.

     It is a LOOK, not a second scene, and that is the whole point of building it this way. The orange edge
     geometry it lights up is the same S.edgeGlow/S.edgeCore already built from iEDM's key-plan centreline
     (see buildEdges below) — the same single registered geometry that carries the track surface, the car,
     the trail and the camera targets. Nothing here traces the concept image, and nothing here keeps a second
     guessed path that could drift away from the record.

     Why the night look reads cream and this does not. After Dark draws that same orange core at edgeCore .60,
     which takes [1,.62,.26] down to about [153,95,40] — below any sensible reading of orange — and then puts
     bloom .95 at a .30 threshold over the top, which spreads what is left and pulls it toward white. Measured
     on 20 Sep 2026 across twelve night shots at Ultra, the orange fraction came out between 0.00000 and
     0.00041 against a 0.0006 floor: the circuit was there and its colour was not. So here the core runs at
     full and the bloom is halved and raised to a .62 threshold, which is what keeps the glow around the line
     instead of turning the route into a fuzzy tube. */
  /* v5.63b — THE SURFACES ARE COOL ON PURPOSE. The first cut of this look used neutral tints and the whole
     frame went amber at track level: this scene is lit warm after dark, so a neutral surface simply takes that
     warmth and the picture turns to brown soup — the circuit stopped being the subject and the glow had nothing
     to sit against. After Dark avoids it by tinting its deck BLUE ([.50,.57,.70]); this does the same thing
     darker. Cool, dark surfaces are also what the approved reference actually shows: the orange reads as orange
     because everything around it is not. */
  /* v5.63c — THE GLOW IS THE THIN ONE, NOT THE WIDE ONE. Running BOTH edge batches at full was what turned
     the near field amber: S.edgeGlow is a .80-wide soft band, and at gain 1 with bloom over it, the post pass
     smears that band across the whole frame — the route becomes the fuzzy tube the brief warns about and the
     orange washes toward cream, which is the very fault being fixed. What actually reads as an LED is the
     CORE: S.edgeCore, .085 wide, kept at full. So the core stays at 1, the soft band comes down to a hint,
     and the bloom threshold is raised until only those cores are bright enough to bloom at all. */
  led:{name:'led',label:'LED Circuit',day:0,sky:'transparent',bloom:.22,bloomCut:.78,winGain:.07,
    fogScale:1,fogNear:60,fogFar:640,
    /* v5.65 — and the same here. This look runs its route core at full on purpose; the pit wall was carried
       along with it and washed out the near field the premium look exists to keep clean. */
    lines:{streets:.07,halo:.10,edgeGlow:.30,edgeCore:1,trackside:.22,bEdges:.10,dynGlow:.45,dynAdd:.55,dynCore:1,roadGlow:.05,roadCore:.08,cityLights:.10,treeGlow:0},
    /* v5.65 — the city comes down with everything else. This look's brief is "the surroundings pulled right
       back so the circuit is the subject", and every surface honoured that except the buildings, which had no
       way to be told: the beachfront sat there at full brightness, a tan wall down one side of every shot,
       while the road, the barrier and the ground around it were all at a tenth. Cooled as well as darkened,
       for the same reason the surfaces are cool here — orange reads as orange because what surrounds it is not. */
    mat:{building:{tint:[.255,.280,.335],lift:[.002,.003,.005]},
      track:{tint:[.105,.120,.150],lift:[.003,.004,.006]},
      ground:{tint:[.075,.090,.125],lift:[.002,.003,.005]},street:{tint:[.085,.100,.135],lift:[.002,.003,.005]},
      deck:{tint:[.130,.160,.215],lift:[.003,.004,.007]},walls:{tint:[.040,.055,.090],lift:[.003,.004,.008]},
      kerb:{tint:[.400,.445,.540],lift:[.005,.005,.006]},barrier:{tint:[.245,.275,.350],lift:[.008,.009,.012]},
      water:{tint:[.055,.080,.150],lift:[.002,.004,.010]},beach:{tint:[.090,.100,.130],lift:[.003,.003,.004]},
      park:{tint:[.070,.130,.105],lift:[.002,.005,.004]},tree:{tint:[.085,.170,.130],lift:[.002,.008,.006]}},
    effects:{shoulder:true,roadLight:true,energyTrail:true,tailRibbons:true,barrierPulse:false,beam:true,beacons:false,motes:false,crowdFlashes:false,roadGlow:false,cityLights:true,treeGlow:false,surf:false}},
  /* v5.65 — COATES ORANGE. Andrew Fisher, 22 Sep 2026, asked for it back as a fourth appearance after the six
     were merged to three: Coates orange as the fourth.

     The version he saw before was a separate renderer drawing a separate world, and his verdict on it was that
     it missed — the picture was striking and it was not a circuit: the car was an outline you could not read
     and the track was not there. This is the same idea built where the circuit already is. The whole city is
     drawn as one wireframe in Coates orange — the street grid, every building edge, the route, the car's
     trail — over surfaces taken nearly to black, and the REAL #26 car is driven through the middle of it with
     its livery, its wheels and its lamps intact. That contrast is the point: an orange world and one solid
     car in it reads far better than an orange world and an orange car.

     Nothing here is a second copy of anything. The lines are the same registered geometry the other three
     looks light — iEDM's key-plan centreline, the OpenStreetMap building footprints, the street network — and
     the colour is the runtime's own Coates orange, carried as a luminance tint so each line keeps the
     brightness it was authored with and only its hue changes.

     LED is not this. LED puts an orange ROUTE on a cool dark city, which is the premium presentation look.
     This puts the whole CITY in orange. They answer different briefs and both are offered. */
  /* v5.65b — AND THE GLOW IS THE THIN ONE HERE TOO. The first cut of this look ran the soft bands at the
     values After Dark uses and put bloom over the top, and the near field filled with a wall of cream light
     that hid the barrier, the fence and half the city behind it — measured by turning every line gain and the
     bloom off, at which point the wall vanished and the geometry was all still there. It is the same fault the
     LED look was fixed for on 20 Sep 2026, arriving by the same road: S.edgeGlow is a .80-wide soft band, and
     a wide band under bloom becomes a fog rather than a line.

     But the edge CORE turned out to be the worse half of it here, which is the opposite of the LED look's
     answer and worth writing down. Zeroing each family of lines in turn, in the browser, against the same
     frame: the wall of cream light collapsed the moment edgeCore went to nothing and nothing else touched it.
     At gain 1 under an orange tint that .085-wide core runs the entire length of the track edge, right at the
     foot of the barrier, and bloom turns a continuous bright line into a lit wall — it was drowning the
     barrier, the catch fence and half the city behind them. LED can run its core at full because its city is
     cool and dim around it; this look has the whole city lit in the same colour as the core, so the core has
     to give way. It comes down to under a half, and the CITY carries the look instead: building edges and the
     street grid at full, which is what an orange wireframe city is meant to be made of. */
  orange:{name:'orange',label:'Coates Orange',day:0,sky:'transparent',bloom:.20,bloomCut:.80,winGain:0,
    fogScale:1,fogNear:70,fogFar:760,
    /* #FF6A13, scaled so a tinted line keeps roughly the luminance it was authored with (.299R+.587G+.114B
       comes to .95) rather than arriving brighter than the line it replaced */
    lines:{tint:[1.55,.78,.22],tintMix:1,
      streets:.62,halo:.04,edgeGlow:.10,edgeCore:1,trackside:.12,bEdges:.85,dynGlow:.20,dynAdd:.42,dynCore:1,
      roadGlow:0,roadCore:.05,cityLights:0,treeGlow:0},
    /* the surfaces go to almost nothing so the wireframe is the picture; the track keeps just enough of
       itself that the car has a road under it rather than sitting on a void */
    /* the city itself goes to almost nothing so that what you see of it is its orange edges — this is the
       one look that names a building material, and it is why the tint exists */
    mat:{building:{tint:[.075,.062,.055],lift:[.002,.001,0]},
      cityDetail:{tint:[.060,.050,.044],lift:[.002,.001,0]},
      track:{tint:[.055,.050,.048],lift:[.004,.002,.001]},
      ground:{tint:[.030,.026,.024],lift:[.002,.001,.001]},street:{tint:[.038,.032,.028],lift:[.002,.001,.001]},
      deck:{tint:[.060,.052,.046],lift:[.003,.002,.001]},walls:{tint:[.028,.022,.018],lift:[.002,.001,.001]},
      kerb:{tint:[.230,.150,.075],lift:[.006,.003,.001]},barrier:{tint:[.150,.100,.055],lift:[.005,.003,.001]},
      water:{tint:[.030,.026,.030],lift:[.001,.001,.003]},beach:{tint:[.040,.034,.028],lift:[.002,.001,.001]},
      park:{tint:[.032,.030,.026],lift:[.001,.002,.001]},tree:{tint:[.040,.036,.028],lift:[.002,.002,.001]}},
    effects:{shoulder:true,roadLight:false,energyTrail:true,tailRibbons:true,barrierPulse:false,beam:true,beacons:false,motes:false,crowdFlashes:false,roadGlow:false,cityLights:false,treeGlow:false,surf:false}}
};
G.lookReport=function(){
  const S=G.S,L=(S&&S.look)||G.LOOKS.day;
  return {name:L.name,label:L.label,day:!!L.day,bloom:L.bloom,bloomCut:L.bloomCut,
    effects:Object.assign({},L.effects)};
};
/* v5.48 — this scene calls its night look 'showcase'; the deck's Backdrop list calls it 'dark', because the
   deck offers "the circuit in 3D — after dark" beside "— day race". Rather than rename his look and break his
   own demo, the two names are the same thing here. */
G.LOOKS.dark=G.LOOKS.showcase;
/* v5.48 — THE GRANDSTANDS, carried across when this scene became the deck's backdrop. Andrew Fisher, 17 Sep
   2026: the grandstands too, without anything looking silly or over the top. One stand for every name the
   FENCING SCHEDULE gives — that is where the names come from, not from a drawing — placed by rule outside the
   track, clear of the pit lane, and NOMINAL: their real positions are on iEDM's drawings, which are not on this
   record, and the credit line on the scene says so. This scene draws far more than the one it came from, so the
   stands keep out of the way of everything the pack already puts down. */
G.setStands=function(stands){
  const S=G.S;if(!S||!S.CL)return 0;
  const names=(stands&&stands.names)||[];S.standStats={named:names.length,drawn:0,outside:0,inside:0,skipped:0};S.stands=[];
  if(!names.length)return 0;
  const gl=S.gl,CL=S.CL,N=CL.n,H=S.tune.deckH,rnd=G.rng(17);
  const LEN=6.7,DEP=2.1,HT=1.3,GAP=.9,TIERS=6;                     /* 40 m × 12.5 m × 7.7 m in key-plan points */
  const mesh=S.standMesh=new G.MeshBatch(gl,[3,4,2],false),ed=S.standEdge=new G.LineBatch(gl,S.quad,2048,false),cw=S.crowd=new G.LineBatch(gl,S.quad,4096,false);
  /* v6.52 - the people (bodies and heads, drawn like the trackside edges so they read solid by day and lit at night), the
     stands' decoration in its own mesh so its colours are not tinted as walls, and the points the night flashes come from */
  const pp=S.people=new G.LineBatch(gl,S.quad,8192,false),dec=S.standDecor=new G.MeshBatch(gl,[3,4,2],false),crowdPts=S.crowdPts=[];
  const SHIRTS=[[.95,.95,.95,.95],[.16,.20,.26,.95],[1,.42,.08,.95],[1,.42,.08,.95],[.22,.42,.75,.95],[.85,.15,.12,.95],[.18,.55,.32,.95],[.93,.86,.30,.95],[.40,.24,.55,.95],[.62,.62,.66,.95]];
  const SKIN=[[.93,.78,.64,1],[.76,.58,.42,1],[.55,.38,.26,1],[.98,.86,.74,1]];
  const person=(p,rnd,scale)=>{const s=scale||1,shirt=SHIRTS[(rnd()*SHIRTS.length)|0],skin=SKIN[(rnd()*SKIN.length)|0],h=.26*s*(.9+rnd()*.2);
    const foot=[p[0],p[1],p[2]],neck=[p[0],p[1]+h,p[2]],head=[p[0],p[1]+h+.055*s,p[2]];
    pp.seg(foot,neck,shirt,shirt,.052*s,.046*s,.9);pp.seg(head,head,skin,skin,.048*s,.048*s,.9);
    if(rnd()<.08){const top=[p[0]+(rnd()-.5)*.06,p[1]+h+.30*s,p[2]+(rnd()-.5)*.06],F=[1,.42,.08,.95];pp.seg(neck,top,[.6,.6,.6,.9],[.6,.6,.6,.9],.012,.012,.6);pp.seg([top[0],top[1]-.05,top[2]],top,F,F,.07,.02,.8);}
    if(crowdPts.length<1500&&rnd()<.5)crowdPts.push(head);};
  const dv=(p,c)=>dec.vert(p[0],p[1],p[2],c[0],c[1],c[2],c[3],0,0);
  const dquad=(A,B,C,D,c)=>{const a=dv(A,c),b=dv(B,c),cc=dv(C,c),d=dv(D,c);dec.tri(a,b,cc);dec.tri(a,cc,d);dec.tri(a,cc,b);dec.tri(a,d,cc);};   /* both faces: seen from the track and from above */
  const COL=[.105,.112,.128,1],RAIL=[1,.62,.30,.75],BACK=[.62,.72,.85,.45],TIER=[.45,.55,.68,.30];
  const clearOf=(c,t,n)=>{                                          /* the stand's floor, sampled: no building, no pit lane, off the track */
    for(let a=-.5;a<=.5;a+=.25)for(let b=0;b<=1;b+=.25){
      const x=c[0]+t[0]*a*LEN+n[0]*b*DEP,z=c[1]+t[1]*a*LEN+n[1]*b*DEP;
      if(S.heightAt&&S.heightAt(x,z)>.3)return false;
      if(S.distToTrack(x,z)<CL.at(0)[2]*.5+.4)return false;
      if(S.pitPts)for(const P of S.pitPts)for(const p of P)if(Math.hypot(p[0]-x,p[1]-z)<2.2)return false;
    }
    return true;};
  names.forEach((name,i)=>{
    const s0=(S.gridS+(i+.5)*CL.L/names.length)%CL.L;
    let placed=null;
    for(let step=0;step<28&&!placed;step++){                        /* walk along the track until there is room */
      const s=(s0+step*1.1)%CL.L,p=CL.at(s),q=CL.at(s+1.2),tx=q[0]-p[0],tz=q[1]-p[1],tl=Math.hypot(tx,tz)||1,t=[tx/tl,tz/tl];
      for(const sg of [1,-1]){                                      /* the outside of the loop first, then the infield */
        const n=[-t[1]*sg,t[0]*sg],c=[p[0]+n[0]*(p[2]/2+GAP),p[1]+n[1]*(p[2]/2+GAP)];
        const out=!G.inPoly(c,S.outer);
        if(!clearOf(c,t,n))continue;
        placed={c:c,t:t,n:n,out:out};if(out)S.standStats.outside++;else S.standStats.inside++;break;
      }
    }
    if(!placed){S.standStats.skipped++;return;}
    const {c,t,n}=placed,V=(a,b,y)=>[c[0]+t[0]*a*LEN+n[0]*b*DEP,H+y,c[1]+t[1]*a*LEN+n[1]*b*DEP];
    const yAt=b=>.18+(HT-.18)*b,v=p=>mesh.vert(p[0],p[1],p[2],COL[0],COL[1],COL[2],COL[3],0,0);
    const quad=(A,B,C,D)=>{const a=v(A),b=v(B),cc=v(C),d=v(D);mesh.tri(a,b,cc);mesh.tri(a,cc,d);};
    for(let r=0;r<TIERS;r++){
      const b0=r/TIERS,b1=(r+1)/TIERS,y0=yAt(b0),y1=yAt(b1);
      quad(V(-.5,b0,y0),V(.5,b0,y0),V(.5,b1,y0),V(-.5,b1,y0));      /* the tread */
      quad(V(-.5,b1,y0),V(.5,b1,y0),V(.5,b1,y1),V(-.5,b1,y1));      /* the riser */
      ed.seg(V(-.5,b1,y0),V(.5,b1,y0),TIER,TIER,.035,.035,.55);      /* the nose of the tread, so the rake reads from the track */
      for(let k=0;k<5;k++){                                           /* a few warm lamps along the tread, for the night glow */
        const a=(rnd()-.5)*.94,cy=y0+.07,cp=V(a,b0+(b1-b0)*(.3+rnd()*.5),cy),wm=rnd()<.22,
              c=wm?[.78,.88,1,.62]:[1,.80,.55,.68],r=.055+rnd()*.03;
        cw.seg(cp,cp,c,c,r,r,1.2);
      }
      for(let k=0;k<28;k++){                                          /* v6.52 - the crowd: a person a seat, standing on the tread */
        const a=(rnd()-.5)*.96,cp=V(a,b0+(b1-b0)*(.25+rnd()*.5),y0+.02);
        person(cp,rnd,1);
      }
    }
    [-.5,.5].forEach(e=>{                                            /* the ends, closing the rake */
      const A=V(e,0,yAt(0)),B=V(e,1,yAt(1)),C=V(e,1,0),D=V(e,0,0),a=v(A),b=v(B),cc=v(C),d=v(D);mesh.tri(a,b,cc);mesh.tri(a,cc,d);});
    quad(V(-.5,1,yAt(1)),V(.5,1,yAt(1)),V(.5,1,0),V(-.5,1,0));       /* the back */
    ed.seg(V(-.5,0,.20),V(.5,0,.20),RAIL,RAIL,.055,.055,.8);         /* the rail the crowd leans on */
    ed.seg(V(-.5,1,HT),V(.5,1,HT),BACK,BACK,.05,.05,.7);             /* the top of the back wall */
    /* v6.52 - a roof on four posts, a Coates orange band along the back wall, and a flag at each end */
    {const RY=HT+.95,ROOF=[.16,.18,.21,1],POST=[.55,.60,.66,.9],ORANGE=[1,.42,.08,1],WHITE=[.96,.96,.95,1];
     [[-.48,.18],[.48,.18],[-.48,1],[.48,1]].forEach(([a,b])=>ed.seg(V(a,b,b>.5?HT:yAt(b)),V(a,b,RY+(b>.5?0:-.12)),POST,POST,.045,.045,.8));
     dquad(V(-.52,.12,RY-.14),V(.52,.12,RY-.14),V(.52,1.06,RY+.02),V(-.52,1.06,RY+.02),ROOF);
     dquad(V(-.52,1.06,RY+.02),V(.52,1.06,RY+.02),V(.52,1.06,RY-.06),V(-.52,1.06,RY-.06),ROOF);
     dquad(V(-.5,1.001,HT*.62),V(.5,1.001,HT*.62),V(.5,1.001,HT*.80),V(-.5,1.001,HT*.80),ORANGE);
     dquad(V(-.5,1.001,HT*.80),V(.5,1.001,HT*.80),V(.5,1.001,HT*.86),V(-.5,1.001,HT*.86),WHITE);
     [-.5,.5].forEach(e=>{const base=V(e,1,RY),top=V(e,1,RY+.55);ed.seg(base,top,POST,POST,.02,.02,.6);pp.seg([top[0],top[1]-.16,top[2]],top,ORANGE,ORANGE,.16,.03,.9);});}
    S.stands.push({name:name,at:c,out:placed.out});S.standStats.drawn++;
  });
  /* v6.52 - spectators along the fence either side of every stand, standing behind the outer barrier */
  {const fr=G.rng(23),O=S.outer;
   S.stands.forEach(st=>{const s0=(()=>{let best=0,bd=1e9;for(let s=0;s<CL.L;s+=.8){const p=CL.at(s),d=Math.hypot(p[0]-st.at[0],p[1]-st.at[1]);if(d<bd){bd=d;best=s;}}return best;})();
     for(let ds=-9;ds<=9;ds+=.34){const s=(s0+ds+CL.L)%CL.L,p=CL.at(s),q=CL.at(s+.6),tx=q[0]-p[0],tz=q[1]-p[1],tl=Math.hypot(tx,tz)||1,t=[tx/tl,tz/tl];
       let done=false;
       for(const sg of [1,-1]){const n=[-t[1]*sg,t[0]*sg],gapB=p[2]/2+1.35+fr()*.5,c=[p[0]+n[0]*gapB,p[1]+n[1]*gapB];
         if(G.inPoly(c,O))continue;if(S.heightAt&&S.heightAt(c[0],c[1])>.3)continue;
         if(S.pitPts&&S.pitPts.some(P=>P.some(pt=>Math.hypot(pt[0]-c[0],pt[1]-c[1])<2.2)))continue;
         if(fr()<.72)person([c[0]+(fr()-.5)*.12,H,c[1]+(fr()-.5)*.12],fr,1);done=true;break;}
       if(!done)continue;}});}
  /* v6.52 - marshal posts at the six sharpest corners: a white hut with an orange top and a yellow flag, outside the barrier */
  {const mr=G.rng(29),picks=[];const step=.6;
   for(let s=0;s<CL.L;s+=step){const k=Math.abs(S.kAt(s));let peak=true;for(let d=-6;d<=6;d+=step)if(d!==0&&Math.abs(S.kAt((s+d+CL.L)%CL.L))>k)peak=false;if(peak&&k>.03)picks.push([s,k]);}
   picks.sort((a,b)=>b[1]-a[1]);const chosen=[];for(const [s]of picks){if(chosen.every(c=>Math.min(Math.abs(c-s),CL.L-Math.abs(c-s))>12))chosen.push(s);if(chosen.length>=6)break;}
   S.marshals=[];
   chosen.forEach(s=>{const p=CL.at(s),q=CL.at(s+.6),tx=q[0]-p[0],tz=q[1]-p[1],tl=Math.hypot(tx,tz)||1,t=[tx/tl,tz/tl];
     for(const sg of [1,-1]){const n=[-t[1]*sg,t[0]*sg],gap=p[2]/2+1.6,c=[p[0]+n[0]*gap,p[1]+n[1]*gap];
       if(G.inPoly(c,S.outer))continue;if(S.heightAt&&S.heightAt(c[0],c[1])>.3)continue;
       const W=(a,b,y)=>[c[0]+t[0]*a+n[0]*b,H+y,c[1]+t[1]*a+n[1]*b],WH=[.95,.95,.93,1],OR=[1,.42,.08,1],YEL=[1,.86,.1,.95],POLE=[.7,.7,.7,.9];
       const bx=(x0,x1,z0,z1,y0,y1,col)=>{dquad(W(x0,z0,y0),W(x1,z0,y0),W(x1,z0,y1),W(x0,z0,y1),col);dquad(W(x0,z1,y0),W(x1,z1,y0),W(x1,z1,y1),W(x0,z1,y1),col);
         dquad(W(x0,z0,y0),W(x0,z1,y0),W(x0,z1,y1),W(x0,z0,y1),col);dquad(W(x1,z0,y0),W(x1,z1,y0),W(x1,z1,y1),W(x1,z0,y1),col);dquad(W(x0,z0,y1),W(x1,z0,y1),W(x1,z1,y1),W(x0,z1,y1),col);};
       bx(-.28,.28,0,.5,0,.42,WH);bx(-.3,.3,-.02,.52,.42,.5,OR);
       const pb=W(.34,.1,0),pt=W(.34,.1,1.05);ed.seg(pb,pt,POLE,POLE,.018,.018,.6);pp.seg([pt[0],pt[1]-.2,pt[2]],pt,YEL,YEL,.2,.03,.9);
       person(W(-.1,.62,0),mr,1);person(W(.12,.66,0),mr,1);
       S.marshals.push({s:s,at:c});break;}});}
  /* v6.52 - the start gantry over the grid: two posts, a beam, five lamps the scene lights from the clock */
  {const s=(S.gridS+(S.tune.carS||3.4)*.9)%CL.L,p=CL.at(s),q=CL.at(s+.6),tx=q[0]-p[0],tz=q[1]-p[1],tl=Math.hypot(tx,tz)||1,t=[tx/tl,tz/tl],n=[-t[1],t[0]],hw=p[2]/2+.55,GY=H+2.05,MET=[.62,.66,.72,.95];
   const L1=[p[0]+n[0]*hw,H,p[1]+n[1]*hw],R1=[p[0]-n[0]*hw,H,p[1]-n[1]*hw],L2=[L1[0],GY,L1[2]],R2=[R1[0],GY,R1[2]];
   ed.seg(L1,L2,MET,MET,.06,.05,.9);ed.seg(R1,R2,MET,MET,.06,.05,.9);ed.seg(L2,R2,MET,MET,.07,.07,.9);ed.seg([L2[0],GY-.22,L2[2]],[R2[0],GY-.22,R2[2]],MET,MET,.035,.035,.7);
   S.gantry={lamps:[0,1,2,3,4].map(i=>{const f=(i+1)/6;return [L2[0]+(R2[0]-L2[0])*f,GY-.11,L2[2]+(R2[2]-L2[2])*f];}),goAt:null};
   dquad([L2[0],GY-.30,L2[2]],[R2[0],GY-.30,R2[2]],[R2[0],GY+.02,R2[2]],[L2[0],GY+.02,L2[2]],[.09,.10,.12,1]);
   const band=(y0,y1,col)=>dquad([L2[0]+n[0]*.01,y0,L2[2]+n[1]*.01],[R2[0]+n[0]*.01,y0,R2[2]+n[1]*.01],[R2[0]+n[0]*.01,y1,R2[2]+n[1]*.01],[L2[0]+n[0]*.01,y1,L2[2]+n[1]*.01],col);
