+  const set = (id, v) => { const x = $(id); if (x) x.textContent = v; };
+  set('#hzcdLab', lab); set('#hzcdN', String(n)); set('#hzcdU', unit); set('#hzcdSub', sub);
+  const rail = $('#hzrail');
+  if (rail) {
+    rail.style.setProperty('--p', p.toFixed(1) + '%');
+    const f = rail.querySelector('.flag'); if (f) f.style.left = fp == null ? '-99px' : 'calc(' + fp.toFixed(1) + '% - 6px)';
+    const ws = rail.querySelector('.wks'); if (ws && span) ws.innerHTML = W.map(w => `<i style="left:${(days(start, w.start) / span * 100).toFixed(1)}%"></i>`).join('');
+    const a = rail.querySelector('.lb.s'), b = rail.querySelector('.lb.e');
