+def hz_car_uri() -> str:
+    """v5.87 - the #26 cut-out for the banner, as the page carries it (print/web/car_26.webp, 1000 px wide for a 230 px slot)."""
+    f = WEB / 'car_26.webp'
+    return 'data:image/webp;base64,' + base64.b64encode(f.read_bytes()).decode() if f.exists() else ''
+
+
+def hz_backdrop_uri() -> str:
+    """v5.87 - the circuit at dusk behind the bar: sources/brand/hero_circuit.png cropped to the band, graded darker and
+    cooler, a touch of depth of field, cached as print/web/hz_backdrop.jpg. The foreground stays sharp; this is the one
+    thing meant to be soft."""
+    out = WEB / 'hz_backdrop.jpg'
+    src = ROOT / 'sources/brand/hero_circuit.png'
+    if not out.exists() and src.exists():
+        from PIL import Image, ImageEnhance, ImageFilter
+        im = Image.open(src).convert('RGB'); w, h = im.size
+        im = im.crop((0, int(h * 0.18), w, int(h * 0.78)))
+        im = ImageEnhance.Color(im).enhance(0.75); im = ImageEnhance.Brightness(im).enhance(0.6); im = ImageEnhance.Contrast(im).enhance(1.15)
+        im = im.filter(ImageFilter.GaussianBlur(0.8))
+        im.save(out, quality=92)
+    return 'data:image/jpeg;base64,' + base64.b64encode(out.read_bytes()).decode() if out.exists() else ''
+
+
