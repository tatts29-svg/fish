<script>
const DATA = /*__DATA__*/;
/* v5.57 — A PICTURE HELD IN TWO PLACES IS WRITTEN ONCE AND POINTED AT TWICE.
   The aerial photograph was in this page twice, 2.72 MB each time, because the high-resolution aerial and the
   aerial map sheet are the same file; six document thumbnails were doubled the same way. A repeat now carries
   {"media":"m1"} and the bytes sit once in DATA.media.

   IT IS A MARKER, NOT A null. A null at a field that HAS a picture would be a page that lies about itself to
   anything reading it without running it — an export, a check, a person in a text editor. "Blank means unknown"
   is the rule this package is built on, and a blank standing for a picture that exists breaks it. A marker names
   where the picture is; anybody can follow it, in any language, without a browser.

   This runs in the same statement list as the declaration, before one line of app code reads DATA, so nothing
   downstream ever meets a marker. After it, every field holds the string it always held. */
(function shareMedia(){
  const M = DATA.media; if (!M) return;
  let n = 0;
  const walk = o => {
    if (!o || typeof o !== 'object') return;
    if (Array.isArray(o)) {
      for (let i = 0; i < o.length; i++) {
        const v = o[i];
        if (v && typeof v === 'object' && !Array.isArray(v) && typeof v.media === 'string'
            && Object.keys(v).length === 1) { o[i] = M[v.media]; n++; } else walk(v);
      }
      return;
    }
    for (const k of Object.keys(o)) {
      if (k === 'media' && o === DATA) continue;            // the table itself is not walked
      const v = o[k];
      if (v && typeof v === 'object' && !Array.isArray(v) && typeof v.media === 'string'
          && Object.keys(v).length === 1) { o[k] = M[v.media]; n++; } else walk(v);
    }
  };
  walk(DATA);
  DATA.media_shared = n;      // what it resolved, so a check can read it rather than take it on trust
})();
const STORE = 'gc500.assets.v1';
const $ = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => [...(r || document).querySelectorAll(s)];
/* A link this page will put in front of a person — a drop card a driver opens. It is http or https, with nobody's
   name and password buried in it, or it is not a link. Andrew Fisher's audit, 12 Sep 2026: a record that came from
   a file could carry a javascript: address, and pressing it would run in this page. */
function webLink(u){
  if (typeof u !== 'string' || !u.trim()) return false;
  try { const x = new URL(u, location.href);
    return (x.protocol === 'http:' || x.protocol === 'https:') && !x.username && !x.password; } catch (e) { return false; }
}
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => (
  {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
/* v5.94 - the formatters are made once; toLocaleString with options built one per call, thousands of times a draw */
const MONEY_FMT = new Intl.NumberFormat('en-AU', {style:'currency', currency:'AUD', maximumFractionDigits:2});
const MONEY0_FMT = new Intl.NumberFormat('en-AU', {style:'currency', currency:'AUD', maximumFractionDigits:0});
const money = v => (v == null || v === '' || !Number.isFinite(Number(v))) ? null : MONEY_FMT.format(Number(v));
/* a running total to the dollar — the cents on a figure that is already rounded are noise */
const money0 = v => (v == null || v === '' || !Number.isFinite(Number(v))) ? null : MONEY0_FMT.format(Math.round(Number(v)));
/* A set of figures printed in a column with a total under it: round each one to the dollar so the parts add up
   to exactly the rounded whole, instead of each being rounded on its own and the column finishing a dollar out.
   Andrew Fisher, 12 Sep 2026: the numbers must add up. Largest remainder: every figure is its own
   value to the nearest dollar, and the few cents the rounding leaves over go to the figures that lost the most. */
function dollarSplit(vals, to){
  const v = (vals || []).map(x => Number(x) || 0);
  /* v5.83 — to: the whole the parts must come to (a total rounded once elsewhere), so a table's rows and the figure
     printed above it are the same dollars */
  const whole = to != null && Number.isFinite(Number(to)) ? Math.round(Number(to)) : Math.round(v.reduce((s, x) => s + x, 0));
  const out = v.map(x => Math.floor(x));
  let left = whole - out.reduce((s, x) => s + x, 0);
  const order = v.map((x, i) => [x - Math.floor(x), i]).sort((a, b) => b[0] - a[0] || a[1] - b[1]);
  for (let k = 0; left > 0 && k < order.length; k++, left--) out[order[k][1]]++;
  for (let k = order.length - 1; left < 0 && k >= 0; k--, left++) out[order[k][1]]--;
  return out;
}

/* ------------------------------------------------------------------ local state
   Everything a person types lives here. It is saved in this browser only — never sent anywhere, never shared
   with another viewer. Export writes it to a JSON file; Import reads one back. */
const blank = () => ({schema:'gc500-as-supplied-1', saved:null, operator:'', added:[], accessories:{}, notes:{},
                      assetNumbers:{}, rates:{}, accRates:{}, fenceRates:{}, fenceCosts:{}, weeks:{},
                      /* Where a thing actually goes, when that is not where the schedule said. Keyed by GC500
                         reference, the words a person typed. The schedule's own wording is never overwritten —
                         it stays in the build and is shown beside this one, so the change can always be read
                         against what was originally asked for. Andrew Fisher, 13 Sep 2026: everything is editable,
                         line by line, because things change every day — location, asset, number, date and
                         day. */
                      locations:{},
                      /* What a thing IS, when somebody has typed over the schedule's own wording. Keyed by GC500
                         reference, exactly like locations, and the schedule's words are never overwritten — they
                         stay in the build and are shown beside this one, so a description can always be read
                         against what was originally asked for. Andrew Fisher, 16 Sep 2026: an edit page where people
                         can edit or add — the date, the description, the map location; descriptions change. */
                      descs:{},
                      /* THE MASTER EDIT (Andrew Fisher, 16 Sep 2026: the quantity is separate from the description,
                         and the description is picked from a list of every description possible, so everything
                         matches). Two more things a person can type OVER
                         the schedule, keyed by reference exactly like descs and locations, with the schedule's
                         own answer kept in the build and shown underneath:
                           items — the item TYPE the rate card knows ("Building 6m", "50kva"), chosen from a
                                   list of every type on the job so a typed one always matches a rate line;
                           qtys  — how many the reference asks for, a whole number a named person typed.
                         Both are folded in allAssets(), so the count on every plate, the rate line on Pricing
                         and every printed sheet read the one value. Blank means the schedule's own. */
                      items:{}, qtys:{},
                      /* THE THREE HE APPROVED ON 17 Sep 2026 (asked 16 Sep):
                           moves     — a reference whose RECORD was moved to another reference: {to, at, by},
                                       keyed by the reference it left. What was recorded against P19 (the light,
                                       the ticks, what was supplied, the numbers, what is inside, the note, the
                                       branch, the Rental ID, the weeks, the hire start) is copied to P20 and P19
                                       says "moved to P20 — who, when". A reference is never renamed: the
                                       schedule's, the drawing's and the rental system's links stay whole. The way
                                       back is the same move the other way;
                           hireStart — the day the hire is charged from, when that is not the day it lands — the
                                       commercial clock, typed by a named person, blank = unknown. Drives the hire
                                       days on Pricing; the rental system's own start is shown beside it;
                           mapRef    — a map attached to a reference: a drawing from the Documents library or a
                                       file uploaded to the service, {id, name, kind, by, at}. */
                      moves:{}, hireStart:{}, mapRef:{},
                      /* LABOUR PER PIECE OF EQUIPMENT (Andrew Fisher, 17 Sep 2026: labour is charged per piece
                         of equipment, and per building; the only hourly labour charged is over the event. Each
                         labour line is a tick on the item, like an approval: ticked, it charges that line's rate —
                         install at the install rate, the steps at the steps rate.)

                         A tick, keyed "REF|discipline|item|line" — "P36|Portable buildings|Building 6m|install".
                         Ticked charges that line's rate on the card, multiplied by the quantity on the
                         reference. Nothing is ticked until a person ticks it, and an unticked line reads "not
                         ticked" rather than nought, because a labour charge nobody has recorded is unknown, not
                         zero. Who ticked it and when are in `by` and `stamps`, keyed "labour/<that key>", like
                         every other typed value.

                         No rate lives here. Install, Steps, Levelling, Cleaning, Fire Ext. and Demob are the
                         card's own columns, read through rate_match; where the card writes "Included" (furniture,
                         fencing) or "N/A" (forklifts and the rest of the ACCESS block) there is nothing to tick
                         and the page says which. */
                      labour:{},
                      /* HOURLY LABOUR OVER THE EVENT (Andrew Fisher, 17 Sep 2026: the only hourly labour charged
                         is over the event; hours per day per role, asked and answered the same day).

                         Hours keyed "role|day" — "Project Manager (per hr)|2026-10-23" — against the card's own
                         EVENT TEAM rates. This is the whole event's labour, not a reference's, so it is keyed by
                         role and day and by nothing else. No hours entered means nothing charged and the page
                         says so; it never shows a total of nought as though the hours were known to be none. */
                      eventHours:{},
                      /* A NEGOTIATED MINIMUM HIRE, per item type, keyed "discipline|item" — a number of days a named
                         person typed over the card's own minimum (the period the line's hire rate is written for).
                         Blank means the card's minimum stands; nought means no minimum at all. Andrew Fisher, 17 Sep
                         2026: the buildings probably carry minimum hire days — the card's are used until he says a
                         different one, and the different one is typed here with his name on it. */
                      minDays:{},
                      /* SET ASIDE, NEVER DELETED. Andrew Fisher, 16 Sep 2026: anything done can be edited, changed or
                         removed — nothing is ever deleted, only set aside with a way back. A cost line, a variance, a
                         docket, a breakdown or an added asset that somebody
                         removes is moved HERE whole — {coll, rec, at, by} keyed by the record's own id — and
                         its id is tombstoned exactly as before, so every list, total and merge keeps leaving
                         it out. What is new is the way back: Put back re-writes the tombstone's undo, moves
                         the record out of here into its list, and the Journal shows both events with names. */
                      aside:{},
                      /* Who last set each stamped field, keyed exactly as `stamps` is — "descs/P19",
                         "locations/P19", "branch/GN01". The stamp says when and settles which copy is later;
                         this says who, so a change typed on the edit table carries a name the way a light and
                         a tick always have. Written only where the caller has a name; never inferred. */
                      by:{},
                      /* Photographs of a drop AFTER it has gone in, keyed by GC500 reference. Up to two of them:
                         the unit in position, and the access and surrounds around it. Andrew Fisher, 13 Sep 2026: two
                         photos added to a location once a thing is dropped there, taken by him.

                         Only the POINTER lives here — {id, name, by, at, caption}. The image itself goes to the
                         same document library the service already keeps, so the record stays small enough to
                         travel between phones in a fraction of a second and a photograph never has to be folded
                         into a JSON export. A photograph on a drop is evidence of what was actually done, and it
                         is captioned as such everywhere it appears: it is never shown in the same words as a
                         product reference photograph, which pictures the product and not this one. */
                      dropPhotos:{},
                      /* The individual things INSIDE a reference, each with its own site name, its own asset
                         number and — where the drawing numbers them — its own callout on a sheet.

                         Andrew Fisher, 14 Sep 2026: on the VMS maps, pressing a number shows the asset number
                         assigned to that location and all its other details.

                         The schedule counts. It has ONE row for the eight VMS boards — T0001, VMS x 8 — with no
                         positions on it at all. The drawing does the opposite: D025 carries twenty-seven
                         numbered board LOCATIONS and not one asset number. Nothing in any source joins the two,
                         because the join only exists on the ground: which board is standing at which number.
                         That is what this holds, and it is why a person has to put it there.

                         Keyed by reference: {units: [{label, asset_no, sheet, callout, by, at}]}. `label` is the
                         site's own name for the thing (vms1), `callout` is the drawing's own number for the
                         place (01). Keeping them apart is the point — a board moves, a location does not, and
                         the schedule's own Relocate rows say plainly that they do move. */
                      units:{},
                      /* What actually turned up, and where it differs. Keyed by GC500 reference. The asked-for
                         side is never stored here — it is read from the schedule so nothing typed on site can
                         quietly rewrite what was originally ordered. */
                      supplied:{}, variances:[], fenceDockets:[], docketPapers:{}, fenceQuote:null, fenceDone:{}, deleted:{},
                      /* anything that broke, failed or needs attention, tied to an asset or a fencing area */
                      breakdowns:[],
                      /* Things somebody has to do, and who has to do them. Andrew Fisher asks for an issue, a
                         root cause, an action, an owner, a deadline and a measure of success on anything that is
                         being run rather than watched, and until now the record could show what HAPPENED but
                         not what was OWED. Each is
                         {id, at, by, what, why, ref, owner, due, priority, state, note, done_at, done_by} —
                         `state` is open | doing | done | dropped, and a dropped one keeps its reason. Nothing
                         here is generated: an action exists because a person typed it. */
                      actions:[],
                      /* The traffic light and the planned time to site, keyed by GC500 reference:
                         {state, eta, set_at, by, note, history}. */
                      delivery:{},
                      /* Rental contracts from the Coates rental system, typed in by a person — {rental_id, contract_no,
                         contract_type, customer_code, customer_name, site, po_no, customer_ref, note, …} keyed by
                         Rental ID — and which contract each asset belongs to, keyed by GC500 reference. */
                      contracts:{}, rental:{},
                      /* Which references each of the carrier's loads carries, and where that load drops — a
                         pairing a person makes, keyed by the load's day and number ("2026-09-14#3"), because the
                         carrier's list names neither. Also the drop card made from it, if one has been. */
                      loads:{},
                      /* The Coates branch each asset belongs to, keyed by GC500 reference — the code as a person
                         typed it, with who typed it and when in stamps. Blank means nobody has recorded one; the
                         page never guesses a branch from a discipline, a depot or a drawing. */
                      branch:{},
                      /* Costs, one line each, against the eight categories the expectation names — {id, date, category,
                         description, amount (AUD ex GST), hours, overtime_hours, supplier, reference (the docket,
                         invoice or timesheet number), ref, area, note, recorded_by/on, updated_at/by}. v5.79: nothing
                         is typed on the Costs tab any more (Andrew Fisher, 23 Sep 2026) — the lines on the tab are
                         worked out from the record (the fencing dockets) and given to the build; this list carries
                         only what an older copy of the record recorded before then, untouched. */
                      costs:[],
                      /* Purchase orders, keyed by PO number — {number, supplier_code, supplier_name, branch, period,
                         programme_sheet, invoice_no, amount, note, confirmed, by, at, updated_at}. The eight Andrew
                         Fisher supplied are in the build (DATA.purchase_orders); a row here overlays one of those or
                         adds a new one. Andrew Fisher, 12 Sep 2026: somewhere for an invoice number too. */
                      purchaseOrders:{},
                      /* Who the day's email goes to — [{name, email}], typed by a person and kept with the record
                         so it is typed once and travels with it. Andrew Fisher, 12 Sep 2026: an email he can add to,
                         sending to Brendan Gill, Krystal Stephens and Brendan Meeks; and the same day, that he does the
                         emails on the day and the day before — so the
                         page writes the email and he sends it. No address is ever guessed or carried in the
                         build: an empty list means nobody has typed one, and the email opens with an empty To. */
                      crew:[],
                      /* when each typed value was last set (notes/KEY, weeks/KEY, rates/KEY, eta/KEY …), so two copies merge by time */
                      stamps:{}});
let S = blank();
/* the time a value was set — what lets two copies of the record agree on which is the later */
/* WHEN, AND WHO. A stamp settles which of two copies is later; it never said who made the change, so the
   Journal and the edit table both printed "unnamed" beside a description or a destination somebody had typed
   with their name in the box at the top of the screen. Andrew Fisher, 16 Sep 2026: the record has to be the hard
   truth, and correct. A change with no name on it is not a hard truth.

   So `by` sits beside `stamps`, keyed identically, and travels the same way. It is written only when the caller
   has a name to give — the stamp is never withheld for want of one, because the stamp is what keeps two copies
   in order and that must not depend on anybody remembering to type their name. */
function stampIt(field, key, who){
  S.stamps = S.stamps || {}; S.stamps[field + '/' + key] = new Date().toISOString();
  /* The master edit, 16 Sep 2026: every change carries a name. A caller that passes no name at all gets the
     person recording on this device — the same name whoAmI() has already checked and saved to S.operator
     before any write is allowed. A caller that passes an empty string on purpose still writes no name. */
  const w = String(who === undefined ? (S.operator || '') : (who || '')).trim();
  if (w) { S.by = S.by || {}; S.by[field + '/' + key] = w; }
}
/* who last set a stamped field, or null — never a guess, and never the operator currently at the keyboard */
function stampBy(field, key){ return ((S.by || {})[field + '/' + key]) || null; }
let DAMAGED = null;            // the bytes of a record this browser could not read, kept rather than thrown away
try {
  const raw = localStorage.getItem(STORE);
  if (raw) {
    const j = JSON.parse(raw);                                    // throws on damage — that is the point
    if (!j || typeof j !== 'object' || Array.isArray(j)) throw new Error('the saved record is not a record');
    S = Object.assign(blank(), j);
  }
} catch (e) {
  /* Keep the original bytes under their own name, leave the record's own key untouched, and refuse to write
     over it. A damaged record is a thing to recover, not a thing to replace. */
  try {
    const raw = localStorage.getItem(STORE);
    if (raw) { DAMAGED = {at: new Date().toISOString(), why: String((e && e.message) || e), bytes: raw.length};
      try { localStorage.setItem(STORE + '.damaged.' + Date.now(), raw); } catch (e2) { /* no room; the original is still there */ } }
  } catch (e3) { /* storage itself is unreadable */ }
  S = blank();
}
/* Nothing is written over a record this browser could not read. The person is told, and decides. */
/* v5.58 — THE LAST RECORD THIS BROWSER ACTUALLY KEPT. The 19 Sep 2026 audit, SYNC-03: save A succeeded and
   scheduled its send; edit B came 100 ms later and the browser refused to keep it; the page said "nothing was
   sent to the shared record" — and then A's timer fired, staged the whole of S, and sent B anyway. The team got
   work the browser had just told the person it would lose. So the string that was successfully written is kept,
   and a send that runs after a refused save stages from THAT, not from memory: A goes, B does not, and the
   message on the screen is true. */
let PERSISTED_JSON = null;
function persist(){
  if (DAMAGED) return false;
  try { const j = JSON.stringify(S); localStorage.setItem(STORE, j); PERSISTED_JSON = j; SYNC.unkept = false; return true; }
  catch (e) { SYNC.unkept = true; return false; }
}
/* Let go of the damaged copy on purpose — the original bytes stay under their own key either way. */
function damagedRelease(){ DAMAGED = null; return persist(); }
/* The banner. It does not fade, because the thing it is telling you about does not fade: this browser is
   holding a record it could not read, and nothing new is being written down until you say what to do with it. */
function damagedBanner(){
  const el = document.getElementById('damaged');
  if (!el) return;
  if (!DAMAGED) { el.hidden = true; el.innerHTML = ''; return; }
  el.hidden = false;
  el.innerHTML = `<b>This browser has a saved record it could not read.</b>
    It has been kept exactly as it was (${esc(String(DAMAGED.bytes))} characters, found ${esc(fmtStamp(DAMAGED.at))}) and
    <b>nothing is being saved over it</b>. Export it to a file and send it to Andrew Fisher, or start again here —
    the shared record on the service is not affected either way.
    <button class="btn" id="dmgSave">Save the damaged copy to a file</button>
    <button class="btn ghost" id="dmgGo">Start again in this browser</button>`;
  const dl = document.getElementById('dmgSave');
  if (dl) dl.onclick = () => {
    let raw = '';
    try { const k = Object.keys(localStorage).filter(x => x.indexOf(STORE + '.damaged.') === 0).sort().pop();
          raw = (k && localStorage.getItem(k)) || ''; } catch (e) { raw = ''; }
    if (!raw) return flash('The damaged copy could not be read back. Do not start again — ring Andrew Fisher.');
    const b = new Blob([raw], {type: 'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(b); a.download = 'gc500_damaged_record.json';
    document.body.appendChild(a); a.click(); a.remove();
    flash('Saved. Send that file on before you start again.');
  };
  const go = document.getElementById('dmgGo');
  if (go) go.onclick = () => {
    if (!confirm('Start again in this browser? The damaged copy stays saved under its own name, and the shared '
      + 'record is untouched. Anything only in the damaged copy stays only there.')) return;
    damagedRelease(); damagedBanner(); render();
    flash('Started again. The damaged copy is still here under its own name.');
  };
}
function save(){
  if (SYNC.readonly) {
    /* a view-only link: the change is not kept — the record is re-read so the screen shows what everyone sees */
    flash('View only — this link shows the record but cannot change it. Ask Andrew Fisher for the editing link.');
    if (SYNC.backend && SYNC.backend.redeliver) setTimeout(() => SYNC.backend.redeliver(), 50);
    return false; }
  S.saved = new Date().toISOString(); S.changes = (S.changes || 0) + 1;
  /* Andrew Fisher's audit, 12 Sep 2026: this used to flash the failure and carry straight on into the shared
     record and the folder file. That publishes to the team work that this browser is about to lose on the next
     reload. A save that the browser would not keep goes nowhere else, and says so. */
  if (!persist()) {
    flash('Could not save in this browser — nothing was sent to the shared record. Use Export to keep your work.');
    try { renderTabs(); } catch (e) {}
    try { syncFooter(); } catch (e) {}
    return false;
  }
  /* the dots on the tabs, the Export button and the footer's count follow every save, so they can never be stale */
  try { renderTabs(); } catch (e) {}
  try { syncFooter(); } catch (e) {}
  /* the hosted edition: every save goes to the shared record as well; the folder edition: to my file */
  try { syncPush(); } catch (e) {}
  try { folderWrite(); } catch (e) {}
  return true; }
/* A deletion is a record too. Without it, a docket deleted here would come straight back from the next copy
   merged in — so every delete leaves an id and a time, and merge drops anything wearing one. */
/* TWO PRESSES IN THE SAME MILLISECOND ARE STILL TWO PRESSES. A removal and a putting-back are settled by which
   is later, and a tie stands as removed (see below) — which is right when two devices meet with clocks a
   hair apart, and wrong when one person takes a number off and puts it straight back on the same phone. The
   browser clock only counts milliseconds, so those two taps can carry the same stamp, and the putting-back
   loses to a tie it should never have been in. On THIS device the order is not in doubt, so a stamp that would
   tie or go backwards is carried one millisecond past the thing it follows. The record still says what
   happened and in what order; nothing is rubbed out; and a real tie between two devices still stands as
   removed. Found by the verify of 15 Sep 2026, which put one back and watched it stay off. */
function afterStamp(prev){
  const now = new Date().toISOString();
  if (!prev || now > String(prev)) return now;
  const t = Date.parse(String(prev));
  return Number.isFinite(t) ? new Date(t + 1).toISOString() : now;
}
/* A REMOVAL CARRIES A NAME. Andrew Fisher, 16 Sep 2026: every change carries a name and a time. The time
   settles the merge (below); the name is written beside it under the same key in `by` — "deleted/<id>" for a
   removal, "deleted/back/<id>" for a putting-back — so the Journal can say who took a thing off and who put it
   back. Written only when there is a name to give; the tombstone is never withheld for want of one. */
function tomb(id, who){ if (!id) return; S.deleted = S.deleted || {}; S.deleted[id] = afterStamp(S.deleted[UNDO + id]);
  const w = String(who == null ? (S.operator || '') : who).trim(); if (w) { S.by = S.by || {}; S.by['deleted/' + id] = w; } }
function tombBy(id){ return ((S.by || {})['deleted/' + id]) || null; }
/* v5.76 — A WRONG NUMBER LEAVES NO SCAR. Andrew Fisher, 22 Sep 2026: an asset number entered wrongly can be
   removed for good, leaving no record of it having been there.

   Taking a number off writes a tombstone on purpose, and that is right for a number that WAS on the reference
   and went somewhere else: the removal has to survive a merge or an older copy puts it straight back and it
   ends up printed on a drop sheet.

   A typo was never on the reference. Recording that somebody set aside 1327123 on P04 records an event that
   did not happen, and leaves the next person reading the drawer to work out whether a machine moved or a thumb
   slipped. So a number that exists only because it was typed or recorded HERE is erased outright — out of the
   store, out of its stamp, and its tombstone and any putting-back with it, so nothing anywhere carries the
   shape of it having been there.

   IT IS OFFERED ONLY WHERE IT IS TRUE. A number the schedule carries, one already recorded on site and
   committed, or one the rental system holds does not live in this page. Deleting our copy of it would erase
   nothing and the next merge would hand it straight back — so for those the tombstone is the only thing that
   makes a removal stick, and Take off stays the answer. The drawer says which of the two each number is
