def barriers_payload(D: dict) -> dict:
    """v5.56 — the water barriers as the three sources say them (pipeline/water_barriers.py): iEDM’s drawing
    K220–K231 read off the PDF, the schedule’s WB rows, and iEDM’s installation table TP02-26003-02 where it
    has been read. Nothing reconciled; every difference carried. Absent → the page says so and shows nothing in
    its place."""
    bz = D.get('barrier_zones') or {}
    # What the page has always read off the drawing — the one reading, from the print dataset. These travel
    # whether or not the fold below was built, so a barrier count is never shown as settled.
    drawing = {k: bz.get(k) for k in
               ('coates_wfb_master_total', 'coates_wfb_master_total_every_box', 'detail_coates_total',
                'contractor_wfb_master_total', 'contractor_wfb_master_total_every_box',
                'detail_contractor_total', 'master_vs_detail_conflicts', 'repeated_zone_boxes',
                'pointer_conflicts', 'total_basis', 'note')}
    f = ROOT / 'print/water_barriers.json'
    if not f.exists():
        return {**drawing, 'present': False, 'why': 'the barriers have not been folded for this build'}
    d = json.loads(f.read_text(encoding='utf-8'))
    # the page needs the readings and the differences, not every callout coordinate
    return {
        **drawing,
        'present': True,
        'what_this_is': d['what_this_is'],
        'no_zone_to_reference_join': d['no_zone_to_reference_join'],
        'read_in': d['drawing']['read_in'],
        'totals': d['totals'],
        'zones': d['drawing']['zones'],
        'refs': d['schedule']['refs'],
        'on_hire': {'peak': d['on_hire']['peak'], 'peak_first_reached': d['on_hire']['peak_first_reached'],
                    'series': d['on_hire']['series'], 'rows_not_counted': d['on_hire']['rows_not_counted']},
        'iedm_table': ({'document': d['iedm_install_table']['document'],
                        'supplied_on': d['iedm_install_table']['supplied_on'],
                        'transcription_state': d['iedm_install_table']['transcription_state'],
                        'what_is_needed': d['iedm_install_table']['what_is_needed'],
                        'columns': d['iedm_install_table']['columns_as_headed'],
                        'row_order': d['iedm_install_table']['row_order_as_printed'],
                        'cell_readings': d['iedm_install_table']['cell_readings'],
                        'whole_column_readings': d['iedm_install_table']['whole_column_readings'],
                        'rows_not_legible': d['iedm_install_table']['rows_not_legible'],
                        'rows_without_a_wb_reference': d['iedm_install_table']['rows_without_a_wb_reference']}
                       if d.get('iedm_install_table') else None),
        'questions': d['questions'],
    }


def workforce_payload() -> dict:
    """v5.81 — Andrew Fisher's labour, accommodation, meals and expense tracker, read as written by
    pipeline/workforce_expenses.py (print/workforce_expenses.json). Absent → the page says so and shows nothing
    in its place; no figure is worked out here."""
    f = ROOT / 'print/workforce_expenses.json'
    if not f.exists():
        return {'present': False, 'why': 'no workforce and expense tracker has been read for this build'}
    d = json.loads(f.read_text(encoding='utf-8'))
    # the page works from `lines` (editable, by id); the per-shift, per-night and per-line copies are the build's record
    d['labour'] = {k: v for k, v in d['labour'].items() if k != 'shifts'}
    d['accommodation'] = {k: v for k, v in d['accommodation'].items() if k != 'nights'}
    d['meals'] = {k: v for k, v in d['meals'].items() if k != 'lines'}
    d['expenses'] = {k: v for k, v in d['expenses'].items() if k != 'lines'}
    return d


