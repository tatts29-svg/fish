  bump();
  tell((DROP_SLOTS[slot] || {}).lab + (u ? ' for asset ' + u : '') + ' on the drop sheet for ' + key + ' is now this photograph — linked by ' + who + ', not uploaded again. The file stays where it is on the service.');
}
/* The block in the drawer, under where the thing goes — because that is the question the photograph answers. */
/* The things inside this reference, as a list a person can read at arm's length: the board's own name, its
