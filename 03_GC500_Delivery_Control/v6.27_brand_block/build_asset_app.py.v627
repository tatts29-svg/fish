   "Photo of a location" carries the reference it shows on its card on the service — P09 — and the service
   checks that reference against the list this page put in its own head. Nothing about it is in the record:
   the file index IS the filing, which is why it shows for everyone the moment it lands and needs no name to
   have been typed in this page. The two places on the drop sheet are different: they are the record's, and
   putting a filed picture into one of them is a person's act, in their name — "Use as drop photo". */
function filedPhotosOf(key){
  const ix = photoIndex();
  if (ix.state !== 'ready') return {state: ix.state, error: ix.error || null, files: []};
  const files = Object.values(ix.files || {}).filter(f => f && f.kind === 'photo' && String(f.ref || '') === String(key))
    .sort((x, y) => String(x.uploaded || '').localeCompare(String(y.uploaded || '')));
  return {state: 'ready', error: null, files};
}
function filedPhotoBlock(a){
  const hosted = !!(SYNC.backend && SYNC.backend.fileUrl);
  if (!hosted) return '';
  const key = a.key, r = filedPhotosOf(key);
  const head = n => `<div class="sect filedhead">Photographs filed against ${esc(key)}${n ? ' (' + n + ')' : ''}</div>`;
  if (r.state === 'loading' || r.state === 'none') return head() + `<p class="norate filedsay">Checking the service for photographs filed against ${esc(key)}…</p>`;
  if (r.state === 'failed') return head() + `<p class="norate filedsay">The service did not answer, so whether any photographs are filed against ${esc(key)} could not be checked${r.error ? ' (' + esc(String(r.error).slice(0, 80)) + ')' : ''}. That is not the same as none.</p>`;
  /* v5.58 — this counts ONE kind of file: pictures uploaded on the admin page as "Photo of a location". The drop
     photographs taken in this page are a different kind and are shown above it. "None yet" under a reference
     with four photographs showing read as a contradiction (the 19 Sep 2026 audit), so it now says what it is
     counting and what it is not. */
  const dropN = dropPhotosOf(key).length;
  /* v5.81 — one line when there is nothing (management, 24 Sep 2026); the how is the line's title */
  if (!r.files.length) return head() + `<p class="norate filedsay" title="Pictures uploaded on the admin page as Photo of a location, with ${esc(key)} in the Location box, land here for everyone. The drop photographs above are a different kind of file and are not counted here.">None filed on the admin page${dropN ? ` — the ${dropN} drop photograph${dropN === 1 ? '' : 's'} above ${dropN === 1 ? 'is' : 'are'} not counted here` : ''}.</p>`;
  const can = !SYNC.readonly;
  const free = dropPhotoSlots(key, '').filter(x => !x).length;
  const placed = new Set(dropPhotosOf(key).map(x => String(x.id)));
  return head(r.files.length) + `<div class="filedgrid">${r.files.map(f => {
    const url = SYNC.backend.fileUrl(f.id), nm = String(f.name || f.id);
    const pic = DOC_IMG.test(nm)
      ? `<a class="filedpic" href="${esc(url)}" target="_blank" rel="noopener" aria-label="Open the original photograph"><img src="${esc(url)}" alt="${esc(f.title || nm)}" loading="lazy" decoding="async"></a>`
      : `<a class="filedpic filedfile" href="${esc(url)}" target="_blank" rel="noopener">${esc((nm.split('.').pop() || 'file').toUpperCase())}</a>`;
    const on = placed.has(String(f.id));
    return `<figure class="filed" data-filed="${esc(f.id)}">${pic}<figcaption>
      <b>${esc(f.title || nm)}</b>
      <span class="w">${f.uploaded ? 'uploaded ' + esc(fmtStamp(f.uploaded)) : 'upload time not recorded'}${f.by ? ' by ' + esc(f.by) : ''}${f.refiled ? ' · re-filed' : ''}</span>
      ${on ? '<span class="chip act">on the drop sheet</span>'
          : can ? (free ? `<button type="button" class="btn ghost sm" data-fileduse="${esc(f.id)}">Use as drop photo</button>`
                        : '<span class="chip cand">both drop-sheet places are taken</span>')
          : ''}</figcaption></figure>`;
  }).join('')}</div>
  <p class="norate">Filed on the service against ${esc(key)} — the card on the service says so, and the Documents tab lists it under Photographs. The drop sheet prints only the ${DROP_MAX} places above; <b>Use as drop photo</b> puts one there, in your name, and the file stays filed where it is.</p>`;
}
/* MAPS FILED AGAINST A REFERENCE on the service — the second half of "attach a map" (17 Sep 2026). A file
