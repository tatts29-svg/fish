def fence_sheets() -> list:
    """Sheets a fencing docket can be written against — the 2026 set, and nothing older.

    It used to be the fencing family in any year, which meant the only choices were last year's sheets: a docket
    written today named a 2025 drawing and read on the page as if that were this year's line. Andrew Fisher,
    12 Sep 2026: the D007-26003-02 prints and 2025 come off, to clear the confusion. So the list is the 2026
    drawings — the same sheets the map shows — with the barrier family kept to its master sheet.
    """
    reg = json.loads((ROOT / 'pipeline/drawing_register.json').read_text(encoding='utf-8'))
    out, seen = [], set()
    for d in reg.get('sheets', []):
        if str(d.get('project_no')) != '26003':
            continue
        dwg = str(d.get('dwg_no', '')).upper()
        if dwg.startswith('K2') and dwg != 'K220':
            continue
        if dwg in seen:
            continue
        seen.add(dwg)
        out.append({'sheet_id': d['sheet_id'], 'title': (d.get('title') or '').split(' (')[0], 'year': d.get('year'),
                    'map_key': next((k for k, v in SHEET_IMAGES.items() if v[2] == d['sheet_id']), None)})
    return out


def loadjs(p: Path):
    t = p.read_text(encoding='utf-8')
    return json.loads(re.search(r'=\s*(\{.*\}|\[.*\])\s*;?\s*$', t, re.S).group(1))


