PRODUCT_CARD_W = 900          # 2x a 420px card on a high-density phone, with room to grow


def ensure_product_cards() -> None:
    """Reduce each source picture to the card webp the page embeds. Reproducible: the webps used to be made by
    hand and lived only in the tree, so a clean checkout could not rebuild them."""
    from PIL import Image
    PRODUCT_DIR.mkdir(parents=True, exist_ok=True)
    for name, rel in PRODUCT_SOURCES.items():
        src, dest = ROOT / 'sources' / rel, PRODUCT_DIR / name
        if not src.is_file():
            continue
        if dest.exists() and dest.stat().st_mtime >= src.stat().st_mtime:
            continue
        im = Image.open(src).convert('RGB')
        if im.width > PRODUCT_CARD_W:
            im = im.resize((PRODUCT_CARD_W, round(im.height * PRODUCT_CARD_W / im.width)), Image.LANCZOS)
        im.save(dest, 'WEBP', quality=78, method=5)


# ---------------------------------------------------------- race-weekend closures, for the fencing crew
CLOSURES_FILE = ROOT / 'sources/closures/race_weekend_closures.json'
CLOSURE_PLATE = PRINT / 'out/_closures_plate.webp'
CLOSURE_PLATE_W = 1800


def closures() -> dict:
    """The race-weekend closure windows and closure order Andrew Fisher marked on iEDM's master layout, plus the
    marked plan itself reduced to a plate the page can carry. Read as supplied; nothing here is reconciled."""
    if not CLOSURES_FILE.is_file():
        return {}
    out = json.loads(CLOSURES_FILE.read_text(encoding='utf-8'))
    ph = (out.get('photograph') or {}).get('file')
    src = ROOT / ph if ph else None
    if src and src.is_file():
        from PIL import Image
        CLOSURE_PLATE.parent.mkdir(parents=True, exist_ok=True)
        if not CLOSURE_PLATE.exists() or CLOSURE_PLATE.stat().st_mtime < src.stat().st_mtime:
            im = Image.open(src).convert('RGB')
            if im.width > CLOSURE_PLATE_W:
                im = im.resize((CLOSURE_PLATE_W, round(im.height * CLOSURE_PLATE_W / im.width)), Image.LANCZOS)
            im.save(CLOSURE_PLATE, 'WEBP', quality=80, method=5)
        out['plate'] = data_uri(CLOSURE_PLATE)
        out['plate_bytes'] = CLOSURE_PLATE.stat().st_size
    return out


def product_photos() -> dict:
    ensure_product_cards()
    out = {}
    for key, name, kind, says in PRODUCT_PHOTOS:
        f = PRODUCT_DIR / name
        if not f.is_file():
            continue
        out[key] = {'src': 'data:image/webp;base64,' + base64.b64encode(f.read_bytes()).decode(),
                    'kind': kind, 'says': says}
    return out


def stand_names(ds: dict) -> dict:
    """The grandstands the 2026 fencing schedule names — added at Andrew Fisher's request, 17 Sep 2026.

    THE NAMES ARE THE RECORD'S; THE PLACES ARE NOT. The schedule says which stands the job fences (S01 … S23,
    counted here off its own location and description columns), but nothing in this package says where any of
    them stands: the key plan carries no stand outline, the drawing callouts are label positions and say so
    themselves, and OpenStreetMap has none (its one `building=grandstand` near by is the Nathan Sharpe stand at
    a football field). So the scene draws one stand per name, spaced round the outside of the circuit BY RULE,
    and says on its face that their places are nominal. The stand drawing would put them where they really are."""
    found: dict[str, int] = {}
    pat = re.compile(r'\bS(\d{2})([AB])?\b')
    fen = ds.get('fencing') or {}
    for sheet in (fen.get('week_sheets') or []) + (fen.get('coordination_sheets') or []):
        texts = list(sheet.get('locations') or [])
        for r in (sheet.get('sample_rows') or []):
            texts += [r.get('location'), r.get('description')]
        for text in texts:
            for m in pat.finditer(text if isinstance(text, str) else ''):
                k = 'S' + m.group(1) + (m.group(2) or '')
                found[k] = found.get(k, 0) + 1
    return {'names': sorted(found), 'mentions': found,
            'source': 'the stands the 2026 fencing schedule names, counted off its own location and description columns (%s)'
                      % (fen.get('source_file') or 'the fencing schedule'),
            'places': 'NOMINAL — nothing in this package says where a stand is; the scene spaces them round the outside of the circuit by rule'}


def circuit_payload(ds: dict | None = None) -> dict | None:
    """The real circuit, off iEDM's K220 key plan (pipeline/circuit_keyplan.py). Rebuilt on demand if missing.
    The real track, not a made-up one — Andrew Fisher, 17 Sep 2026. """
    f = ROOT / 'print/circuit_keyplan.json'
    if not f.exists():
        subprocess.run([sys.executable, str(ROOT / 'pipeline/circuit_keyplan.py')], check=True)
    out = json.loads(f.read_text(encoding='utf-8'))
    # v5.49 — THE ROAD'S REAL WIDTH, MEASURED. The key plan says of itself "not a survey, not to scale": its
    # ring is a schematic drawn with a fat stroke, and scaled to a 2,910 m lap that stroke read as a 35 m road,
    # which is why the 4.98 m car looked like a toy standing on it. Andrew Fisher, 18 Sep 2026: the car at its
    # correct size, matching the road. pipeline/gc3d/measure_road_width.py measures the real carriageway
    # off the registered 2022 aerial. Missing (no aerial in the package) is not fatal: the scene falls back to
    # the ring and says so.
    rw = ROOT / 'print/circuit_road_width.json'
    if not rw.exists() and (ROOT / 'print/out/GC500_Aerial_QLD2022_frame_3x.jpg').exists():
        subprocess.run([sys.executable, str(ROOT / 'pipeline/gc3d/measure_road_width.py')], check=True)
    if rw.exists():
        w = json.loads(rw.read_text(encoding='utf-8'))
        out['roadWidth'] = {k: w[k] for k in ('what', 'why', 'method', 'imagery', 'registration', 'samples',
                                              'measured', 'clamp_m', 'profile_median_m', 'profile_min_m',
                                              'profile_max_m', 'was_key_plan_median_m', 'open', 'width_m')}
    if ds:
        out['stands'] = stand_names(ds)
    return out


