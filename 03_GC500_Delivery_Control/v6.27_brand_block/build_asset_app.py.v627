function dropPhotoName(key, slot, unit, ext){
  const clean = String(key).replace(/[^A-Za-z0-9._-]+/g, '_')
              + (unitKey(unit) ? '_u' + unitKey(unit).replace(/[^A-Za-z0-9._-]+/g, '_') : '');
