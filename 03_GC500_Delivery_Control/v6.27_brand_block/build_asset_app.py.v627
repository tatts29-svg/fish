    const a = (A.actions || []).find(x => x.id === id), b = (B.actions || []).find(x => x.id === id);
    const r = pick(`${id} (action)`, a, a && a.updated_at, b, b && b.updated_at, 'actions'); if (r.v) out.actions.push(r.v); });
