<!-- the showcase: a surface of its own, over everything, closing back to exactly where it opened from -->
<section id="showcase" class="show" hidden role="dialog" aria-modal="true" aria-label="GC500 showcase">
  <header class="shtop">
    <div><p class="shbrand">Coates Industrial Solutions · GC500</p>
      <p class="shchap"><span id="showChapter"></span> <i id="showCount"></i></p></div>
    <div class="shtopr">
      <div class="shlamps" id="showLaunch" role="img" aria-label="Launch sequence">
        <i data-lamp="r"></i><i data-lamp="a"></i><i data-lamp="g"></i>
        <span class="shlampw">decoration · not the state of the job</span>
      </div>
      <button class="shbtn" id="showFull">Full screen</button>
      <button class="shbtn back" id="showBack">Back ↓</button>
    </div>
  </header>
  <div class="shstage"><div class="shplate" id="showPlate" aria-hidden="true"></div><div class="shscene" id="showBody"></div></div>
  <footer class="shfoot">
    <div class="shbar" id="showBar" aria-hidden="true"></div>
    <div class="shctl">
      <div class="shctlg">
        <button class="shbtn" id="showPrev">← Previous</button>
        <button class="shbtn" id="showPause">Pause</button>
        <button class="shbtn" id="showSound" aria-pressed="false" hidden title="Sound for the 3D circuit — off unless you turn it on, on this device only">Sound off</button>
        <button class="shbtn" id="showBroadcast" aria-pressed="false" hidden title="The commentary — two voices over the scenes, on this device only">Broadcast</button>
        <button class="shbtn" id="showNext">Next →</button>
        <label class="shloop"><input type="checkbox" id="showLoop"> Loop</label>
        <label class="shloop shbackl">Backdrop <select id="showBackdrop" class="shbtn shsel" aria-label="Backdrop — decoration only">
          <option value="black">Black</option><option value="circuit">The circuit — K220</option><option value="circuit3d_day">The circuit in 3D — day</option><option value="circuit3d">The circuit in 3D — night</option>
          <optgroup label="From the service" id="showBackSvc" hidden></optgroup></select></label>
        <label class="shloop shbackl" id="showViewL" hidden>View <select id="showView" class="shbtn shsel" aria-label="Camera — which view of the circuit">
          </select></label>
        <label class="shloop shbackl" id="showPaceL" hidden>Speed <select id="showPace" class="shbtn shsel" aria-label="Car playback speed">
          <option value="0.25">0.25× · inspect</option><option value="0.5">0.5× · slow</option><option value="0.75">0.75×</option><option value="1" selected>1× · real time</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label>
        <label class="shloop shbackl" id="showQualityL" hidden>Detail <select id="showQuality" class="shbtn shsel" aria-label="Car graphics detail">
          <option value="auto">Auto</option><option value="balanced">Balanced</option><option value="high">High</option><option value="ultra">Ultra</option></select></label>
        <button class="shbtn" id="showCarFocus" hidden aria-pressed="false">Car focus</button>
      </div>
      <p class="shstate" id="showState"></p>
      <p class="sh3dnote" id="show3dNote" hidden></p>
    </div>
    <p class="shsrc">Every figure on these scenes is read from this record as it stands, at the day Where we are
      is set to. Planned work is labelled planned. The backdrop is decoration. Nothing here sends, saves or changes anything.</p>
  </footer>
  <p id="showSay" class="vh" aria-live="polite"></p>
</section>
<!-- v5.77 — the Coates Way machine, opened from the Coates Way tab, over the page, closing back to it -->
<section id="machine" class="machine" hidden role="dialog" aria-modal="true" aria-label="The Coates Way machine">
