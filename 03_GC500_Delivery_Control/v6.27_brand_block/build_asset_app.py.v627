      if (!COST_CATS.includes(x.category)) bad.push('cost line ' + x.id + ' has a category that is not one of the eight: ' + JSON.stringify(x.category).slice(0, 60));
      if (!day(x.date) || x.date == null) bad.push('cost line ' + x.id + ' has a date that is not a day');
      if (!nonneg(x.amount)) bad.push('cost line ' + x.id + ' has an amount that is not a non-negative number');
      if (!nonneg(x.hours) || !nonneg(x.overtime_hours)) bad.push('cost line ' + x.id + ' has hours that are not a non-negative number');
      if (!iso(x.updated_at) || !iso(x.recorded_on)) bad.push('cost line ' + x.id + ' has a time that is not a timestamp'); } }));
