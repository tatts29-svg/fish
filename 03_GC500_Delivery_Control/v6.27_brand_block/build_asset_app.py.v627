function applyImport(j, mode, fromName){
  /* Andrew Fisher's audit, 12 Sep 2026: this used to import without checking that the copy-before-import was
     written, on a view-only link, and to say "Imported" even when the browser refused to keep the result. */
  if (SYNC.readonly) { flash('View only — this link shows the record but cannot change it. Nothing was imported.'); return false; }
  const theirs = recordsFrom(j);
  if (!backupBeforeImport()) { flash('Nothing was imported — this browser could not keep a copy of the record as it is now, so there would be no way back. Export first, then import.'); return false; }
  const before = JSON.parse(JSON.stringify(S));
  let summary;
  if (mode === 'merge') {
    const {merged, report} = mergeRecords(S, theirs);
    S = merged; summary = report.summary;
    S.lastImport = {at: new Date().toISOString(), from: fromName || theirs.operator || null, summary, clashes: report.clashes};
  } else {
    S = Object.assign(blank(), theirs);
    /* a file may carry a part as null. blank() gave every part its empty shape; put that shape back rather than
       let null reach the page, where the first thing that reads it throws and the tab goes blank. */
    const shape = blank();
    Object.keys(shape).forEach(k => { if (S[k] == null && shape[k] != null) S[k] = Array.isArray(shape[k]) ? [] : (typeof shape[k] === 'object' ? {} : shape[k]); });
    summary = 'replaced everything here with the file';
    S.lastImport = {at: new Date().toISOString(), from: fromName || theirs.operator || null, summary, clashes: []};
  }
  const w = $('#who'); if (w) w.value = S.operator || '';
  if (!save()) {
    /* the browser would not keep the imported record. Put back what was here, so the screen and the storage agree. */
    S = before; if (w) w.value = S.operator || '';
    try { persist(); } catch (e) {}
    render();
    flash('Nothing was imported — this browser would not keep the result, so the record is as it was.');
    return false;
  }
  render();
  flash('Imported — ' + summary + '.');
  if (S.lastImport.clashes && S.lastImport.clashes.length) clashDialog(S.lastImport.clashes);
  return true;
}
function clashDialog(clashes){
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', 'Import clashes');
  d.innerHTML = `<div class="dh"><div><h2>Two records disagreed</h2><div class="sub">Nothing was dropped. This is what was decided, so you can check it.</div></div>
    <button class="close" id="cClose" aria-label="Close" title="Close">&times;</button></div>
    <div class="db"><ul style="padding-left:18px;font-size:13px;line-height:1.6">${clashes.map(c => '<li>' + esc(c) + '</li>').join('')}</ul></div>
    <div class="df"><button class="btn primary" id="cOk">OK</button></div>`;
  mounted(document.body.appendChild(d));
  const shut = () => d.remove();
  $('#cClose', d).onclick = shut; $('#cOk', d).onclick = shut;
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  $('#cOk', d).focus();
}
function importDialog(j, fromName){
  const theirs = recordsFrom(j);
  const counts = {lights: Object.keys(theirs.delivery || {}).length, supplied: Object.keys(theirs.supplied || {}).length,
                  variances: (theirs.variances || []).length, dockets: (theirs.fenceDockets || []).length,
                  notes: Object.keys(theirs.notes || {}).length, added: (theirs.added || []).length,
                  breakdowns: (theirs.breakdowns || []).length, contracts: Object.keys(theirs.contracts || {}).length, 'cost lines': (theirs.costs || []).length};
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', 'Import');
  d.innerHTML = `<div class="dh"><div><h2>Import ${esc(fromName || '')}</h2><div class="sub">${theirs.operator ? 'recorded by ' + esc(theirs.operator) + ' · ' : ''}${
      Object.entries(counts).filter(([, n]) => n).map(([k, n]) => n + ' ' + k).join(', ') || 'no records'}</div></div>
    <button class="close" id="iClose">&times;</button></div>
    <div class="db">
      <div class="notice info"><b>You already have records in this browser</b>Merge keeps everything from both — union by id, the later
        light wins, notes are appended, and any disagreement is listed for you afterwards. Replace throws yours away.</div>
    </div>
    <div class="df"><button class="btn primary" id="iMerge">Merge into mine</button>
      <button class="btn" id="iReplace">Replace everything here</button>
      <button class="btn ghost" id="iCancel">Cancel</button></div>`;
  mounted(document.body.appendChild(d));
  const shut = () => d.remove();
  $('#iClose', d).onclick = shut; $('#iCancel', d).onclick = shut;
  $('#iMerge', d).onclick = () => { shut(); applyImport(j, 'merge', fromName); };
  $('#iReplace', d).onclick = () => { if (confirm('Replace every record in this browser with the file? Export first if you want to keep yours.')) { shut(); applyImport(j, 'replace', fromName); } };
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  $('#iMerge', d).focus();
}

/* The file is written in the shape the build reads, so it can be dropped straight into sources/ops/ under
   the name as_supplied.json and rebuilt. The full working state rides along under `records` for Import;
   the build ignores that key. One file, one button, both jobs. The test calls this same function, so what
   is checked is what the button writes, not a copy of it. */
function exportRecord(){
  const today = todayIso();                    // the local calendar day, not the UTC one — Brisbane is ten hours ahead
  return {
    schema: 'gc500-as-supplied-1',
    _about: 'Captured in GC500_Delivery_Control.html. Drop this into sources/ops/as_supplied.json and rebuild.',
    committed_by: S.operator || null,
    committed_on: today,
    exported: new Date().toISOString(),
    source: DATA.build_version,
    dataset_sha256: DATA.dataset_sha256,
    register_sha256: DATA.register_sha256,
    supplied: S.supplied || {},
    variances: S.variances || [],
    delivery: S.delivery || {},
    fence_dockets: S.fenceDockets || [],
    fence_quote: S.fenceQuote || null,
    breakdowns: S.breakdowns || [],
    actions: S.actions || [],
    fence_done: S.fenceDone || {},
    contracts: S.contracts || {},
    rental: S.rental || {},
    costs: S.costs || [],
    purchaseOrders: S.purchaseOrders || {},
    /* branch codes and carrier loads are read back by recordsFrom, so they belong in the committed envelope too —
       without them a file with its records stripped came back with every branch and every load gone. */
    branch: S.branch || {},
    loads: S.loads || {},
    crew: S.crew || [],
    locations: S.locations || {},
    descs: S.descs || {},
    items: S.items || {},
    qtys: S.qtys || {},
    aside: S.aside || {},
    moves: S.moves || {},
    fixes: S.fixes || {},
    entries: S.entries || {},
    places: S.places || {},
    givenRefs: S.givenRefs || {},
    hireStart: S.hireStart || {},
    labour: S.labour || {}, eventHours: S.eventHours || {}, minDays: S.minDays || {},
    mapRef: S.mapRef || {},
    by: S.by || {},
    dropPhotos: S.dropPhotos || {},
    units: S.units || {},
    /* A records-less import must keep the same values, merge stamps and removals. */
    deleted: S.deleted || {},
    stamps: S.stamps || {},
    added: S.added || [],
    accessories: S.accessories || {},
    assetNumbers: S.assetNumbers || {},
    notes: S.notes || {},
    rates: S.rates || {},
    accRates: S.accRates || {},
    fenceRates: S.fenceRates || {},
    fenceCosts: S.fenceCosts || {},
    weeks: S.weeks || {},
    /* the whole record — less the live map's key (v5.51), which is a credential for the hosted address and not a
       site record: an export is dropped into the build and handed round, and the key stays on the service */
    records: (() => { const r = Object.assign({}, S); delete r.mapKeys; return r; })(),
  };
}
let EXPORT_SEQ = 0;
$('#exportBtn').onclick = () => {
  const out = exportRecord(), today = out.committed_on;
  const text = JSON.stringify(out, null, 1), name = 'as_supplied_' + today + '.json';
  /* Andrew Fisher's audit, 12 Sep 2026: the count of unexported changes was set to nought whenever an export
     finished. Anything typed while the save dialog was open was in no file and the footer said everything was
     exported. Only what was in the file is exported; whatever was typed after it keeps its count. And only the
     most recent export may move the bookkeeping, so a slow earlier one cannot overwrite a later one. */
  const seq = ++EXPORT_SEQ, at0 = S.changes || 0;
  const done = () => { if (seq !== EXPORT_SEQ) return;
    const since = Math.max(0, (S.changes || 0) - at0);
    S.lastExport = out.exported; S.changes = since - 1; save(); renderTabs();
    flash('Exported. Rename to as_supplied.json, put it in sources/ops/, then rebuild.'); };
  if (SYNC.dl) {                              // hosted: the viewer confirms the save; a plain link is inert here
    SYNC.dl.save({filename: name, data: text}).then(done, e => {
      const code = (e && e.code) || 'unavailable';
      flash(code === 'declined' ? 'Export cancelled.' : 'Could not offer the file here (' + code + ') — open the page on a laptop and try again.'); });
    return;
  }
  const blob = new Blob([text], {type:'application/json'});
  const u = URL.createObjectURL(blob), a = document.createElement('a');
  a.href = u; a.download = name;
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(u), 1000);
  done();
};
$('#importBtn').onclick = () => $('#importFile').click();
/* The primary bar's More menu holds the name box, the record actions and every view. It is one menu, it is
   labelled, and everything inside it is reachable from the keyboard — Escape closes it and puts the focus back
   on the button that opened it. */
/* ------------------------------------------------------------------ Motion: Subtle or Off
   V11 audit: `data-motion="off"` was in the stylesheet and nothing in the page ever set it, so it was not a
   delivered setting. It is one now — and it combines with the operating system's own preference rather than
   replacing it: choosing Subtle does not override somebody who has asked their phone for less motion.

   The OS preference is watched LIVE, so turning it on while this page is open takes effect without a reload. */
const MOTION_MQ = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
function motionPref(){ try { return localStorage.getItem('gc500.motion') === 'off' ? 'off' : 'subtle'; } catch (e) { return 'subtle'; } }
function motionOff(){ return motionPref() === 'off' || !!(MOTION_MQ && MOTION_MQ.matches); }
function motionApply(){
  document.documentElement.setAttribute('data-motion', motionOff() ? 'off' : 'subtle');
  const b = $('#motionBtn');
  if (b) { const off = motionPref() === 'off';
    b.textContent = 'Motion: ' + (off ? 'Off' : 'Subtle');
    b.setAttribute('aria-pressed', String(off));
    b.title = (MOTION_MQ && MOTION_MQ.matches)
      ? 'This device already asks for reduced motion, and that is honoured whatever is chosen here.'
      : off ? 'Decorative motion is off. Press to allow short, quiet transitions.' : 'Short, quiet transitions. Press to stop decorative motion.'; }
  document.dispatchEvent(new Event('gc500motionchange'));
}
function motionToggle(){
  try { localStorage.setItem('gc500.motion', motionPref() === 'off' ? 'subtle' : 'off'); } catch (e) {}
  motionApply();
}
if (MOTION_MQ) { try { MOTION_MQ.addEventListener('change', motionApply); } catch (e) { try { MOTION_MQ.addListener(motionApply); } catch (e2) {} } }
/* a function declaration, not a const: openAsset() calls this to put the menu away when a drawer takes the
   front, and a hoisted declaration is safe to call from anywhere in the file rather than only from below here */
function moreClose(){ const m = $('#moreMenu'); if (m && !m.hidden) { m.hidden = true; const b = $('#moreBtn'); if (b) b.setAttribute('aria-expanded', 'false'); } }
/* "Recording as" lives in the Tools menu, and every prompt that asks for a name has to be able to reach it —
   otherwise the page asks for something a person cannot see. Opens the menu, focuses the box, marks it. */
function whoFocus(){
  const m = $('#moreMenu'), b = $('#moreBtn'), w = $('#who');
  if (m && m.hidden && b) { m.hidden = false; b.setAttribute('aria-expanded', 'true'); moreMenuPlace(); }
  if (w) { try { w.focus(); w.select(); } catch (e) {} w.classList.add('need'); }
}
$('#motionBtn').onclick = () => motionToggle();
motionApply();
function moreMenuPlace(){ const m = $('#moreMenu'), b = $('#moreBtn'); if (!m || !b || m.hidden) return; const r = b.getBoundingClientRect();
  m.style.top = Math.round(r.bottom + 8) + 'px'; m.style.right = Math.max(8, Math.round(innerWidth - r.right)) + 'px'; m.style.left = 'auto'; m.style.maxHeight = Math.max(200, Math.round(innerHeight - r.bottom - 20)) + 'px'; }
window.addEventListener('resize', moreMenuPlace);
$('#moreBtn').onclick = () => { const m = $('#moreMenu'); m.hidden = !m.hidden; $('#moreBtn').setAttribute('aria-expanded', String(!m.hidden)); moreMenuPlace(); if (!m.hidden) { const f = m.querySelector('input, button'); if (f) f.focus(); } };
$('#moreMenu').addEventListener('click', e => { const b = e.target.closest('[data-goto]'); if (b) { moreClose(); go(b.dataset.goto); } });
$('#moreMenu').addEventListener('keydown', e => {
  if (e.key === 'Escape') { moreClose(); $('#moreBtn').focus(); e.preventDefault(); return; }
  if (!['ArrowDown','ArrowUp','Home','End'].includes(e.key)) return;
  const items = [...$('#moreMenu').querySelectorAll('input, button')].filter(x => !x.hidden && x.offsetParent !== null);
  const at = items.indexOf(document.activeElement);
  const to = e.key === 'Home' ? 0 : e.key === 'End' ? items.length - 1
           : (at + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
  e.preventDefault(); if (items[to]) items[to].focus();
});
document.addEventListener('click', e => { const m = $('#moreMenu'); if (m && !m.hidden && !e.target.closest('#moreMenu, #moreBtn')) moreClose(); });
/* Escape also works after Tab leaves Tools. An open modal retains its own Escape action. */
document.addEventListener('keydown', e => {
  if (e.key !== 'Escape' || e.defaultPrevented || document.querySelector('body > .drawer.on')) return;
  const m = $('#moreMenu');
  if (m && !m.hidden) { moreClose(); $('#moreBtn').focus(); e.preventDefault(); }
});
document.addEventListener('click', e => { const m = $('#tabMoreMenu');
  if (m && !m.hidden && !e.target.closest('#tabMoreMenu, #tabMore')) { m.hidden = true; const b = $('#tabMore'); if (b) b.setAttribute('aria-expanded', 'false'); } });
/* F03, the second half: resolving a pointer against the service's file list catches a pointer that is not
   listed, but not a file that is listed and then refuses to load — a half-finished upload, a service that has
   lost its volume. An image that FAILS is replaced in place with the same words, so no surface on this page can
   ever show a photograph's frame with nothing in it. Capture phase: an img's error event does not bubble. */
function photoImageReady(t){
  if (!t || t.tagName !== 'IMG' || (!t.hasAttribute('data-dphimg') && !t.hasAttribute('data-photo-preview')) || t.dataset.photoDecoded) return;
  t.dataset.photoDecoded = 'pending';
  const done = () => { if (t.naturalWidth > 0) { t.classList.add('is-ready'); t.dataset.photoDecoded = 'ready';
    const shell = t.closest('.docpreview-shell'), status = shell && shell.querySelector('.docpreview-status'); if (status) status.remove(); } };
  if (t.decode) { try { t.decode().then(done).catch(() => photoImageFailed(t)); } catch (e) { done(); } }
  else done();
}
document.addEventListener('load', e => photoImageReady(e.target), true);
document.querySelectorAll('img[data-dphimg], img[data-photo-preview]').forEach(t => { if (t.complete) photoImageReady(t); });
function photoImageFailed(t){
