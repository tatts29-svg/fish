    const pa = typeof a.steps === 'boolean' ? {steps: a.steps, steps_by: a.steps_by, steps_at: a.steps_at} : null;
    const pb = typeof b.steps === 'boolean' ? {steps: b.steps, steps_by: b.steps_by, steps_at: b.steps_at} : null;
    const pw = !pa ? pb : !pb ? pa : (String(pb.steps_at || '') > String(pa.steps_at || '') ? pb : pa);
    if (pw) Object.assign(m, pw);
    const db = typeof b.done === 'boolean' ? {done: b.done, done_by: b.done_by, done_at: b.done_at} : null;
    const rd = pick(`${k} complete tick`, da, a.done_at, db, b.done_at, 'delivery'); if (rd.v) Object.assign(m, rd.v);
    const re = pick(`${k} planned time`, a.eta, st(A, 'eta/' + k), b.eta, st(B, 'eta/' + k), 'delivery'); if (re.v) m.eta = re.v;
    const rn = pick(`${k} delivery note`, a.note, st(A, 'dnote/' + k), b.note, st(B, 'dnote/' + k), 'delivery'); if (rn.v) m.note = rn.v;
    const hist = (la, lb, keyOf) => { const seen = new Map(); (la || []).concat(lb || []).forEach(h => { if (h && !seen.has(keyOf(h))) seen.set(keyOf(h), h); });
