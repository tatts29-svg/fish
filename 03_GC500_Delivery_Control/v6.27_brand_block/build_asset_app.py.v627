    if (addedKeys.has(a.key)) bad.push('added asset ' + a.key + ' appears twice'); addedKeys.add(a.key);
    if (registerKeys.has(a.key)) bad.push('added asset ' + a.key + ' carries the reference of an asset already on the schedule');
    text(a.name, a.key + ' name');
