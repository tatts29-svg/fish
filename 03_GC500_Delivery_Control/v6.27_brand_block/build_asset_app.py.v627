# WHEN a thing is charged for, in Andrew Fisher's own words (sources/pricing/charge_basis.json, 17 Sep 2026).
# It carries no rates: every figure still comes from the card. Without it the page prices the way it did before
# and says on its face that no charge basis has been supplied.
CHARGE_BASIS = (json.loads((ROOT / 'sources/pricing/charge_basis.json').read_text(encoding='utf-8'))
                if (ROOT / 'sources/pricing/charge_basis.json').is_file() else None)
REHIRE_QUOTES = (json.loads((ROOT / 'sources/pricing/rehire_toilets/quotes.json').read_text(encoding='utf-8'))
                 if (ROOT / 'sources/pricing/rehire_toilets/quotes.json').is_file() else None)


def toilet_servicing_at_card():
    """v5.83 — THE TOILET SERVICING, PRICED THE WAY COATES WOULD PRICE ITS OWN. Andrew Fisher, 25 Sep 2026: the
    rehire toilets work like the fencing — the V8s are charged at Coates's own rates, as if the gear were Coates's,
    Event Portables are paid for it, and whatever is between the two is the margin. The hire is on the contracts at
    the card's own hire rate; the servicing is on no contract line at all. So each servicing line on the Event
    Portables quotes is set beside the nearest line of the 2026 street card's pump-out block, and the same quantity
    is priced at the card — a comparison, never added to a total, because nobody has billed it. Where the card has no
    such line (the water truck, the pre-fill, water deliveries, the drinking-water tank) it says so and prices
    nothing. The pairing is this build's reading of two documents, named as such on the page."""
    rc_p = ROOT / 'print/rate_card_2026.json'
    if REHIRE_QUOTES is None or not rc_p.is_file():
        return None
    rc = json.loads(rc_p.read_text(encoding='utf-8'))
    card = (rc.get('cards') or {}).get('street_2026') or {}
    pump = {}
    for blk in card.get('blocks') or []:
        if 'pump out' in str(blk.get('block') or '').lower():
            for ln in blk.get('lines') or []:
                v = (ln.get('values') or {}).get('Price 2026')
                if isinstance(v, (int, float)):
                    pump[ln['description']] = round(float(v), 2)
    if not pump:
        return None
    # the quote's servicing words → the card's line, by what the work is
    pairs = [(r'fresh water flush.*service', 'FWF Pump out & Clean & Restock'),
             (r'holding tank pump out', 'Tank Pump Out & Clean & Restock'),
             (r'toilet block cleaning', 'Sewer Connect Units Clean & Restock')]
    lines, off = [], []
    for q in REHIRE_QUOTES.get('quotes') or []:
        for g in q.get('groups') or []:
            for ln in g.get('lines') or []:
                desc, qty, up = str(ln.get('description') or ''), ln.get('qty'), ln.get('unit_price')
                if not isinstance(qty, (int, float)) or not isinstance(up, (int, float)):
                    continue
                group = str(g.get('group') or '')
                if not re.search(r'service|pump|clean|water|attendant|tank', desc + ' ' + group, re.I) or re.search(r'toilet$|pan toilet|combo toilet|flush toilet$', desc, re.I):
                    continue
                card_line = next((c for rx, c in pairs if re.search(rx, desc, re.I) and c in pump), None)
                row = {'quote': q.get('quote'), 'description': desc, 'qty': qty, 'their_rate': round(float(up), 2),
                       'their_amount': round(qty * float(up), 2)}
                if card_line:
                    row.update(card_line=card_line, card_rate=pump[card_line], at_card=round(qty * pump[card_line], 2))
                    lines.append(row)
                else:
                    off.append(row)
    if not lines:
        return None
    return {'lines': lines, 'not_on_the_card': off,
            'their_total': round(sum(r['their_amount'] for r in lines), 2),
            'their_total_all': round(sum(r['their_amount'] for r in lines + off), 2),
            'at_card_total': round(sum(r['at_card'] for r in lines), 2),
            'card': 'the 2026 street card, Pump Out Rates block (print/rate_card_2026.json)',
            'basis': ('Each servicing line on the Event Portables quotes beside the nearest line of the street card\'s pump-out '
                      'block, the same quantity priced at the card: a comparison of what the V8s would be charged for the same '
                      'work at Coates\'s own rates — never added to any total, because it is on no contract and no invoice. '
                      'The pairing is this build\'s reading of the two documents (a block clean is set against the card\'s sewer '
                      'connect clean and restock); the water truck, the pre-fill, water deliveries and the drinking-water '
                      'tank have no line on the card and are priced at nothing here.')}


TOILET_SERVICING = toilet_servicing_at_card()

