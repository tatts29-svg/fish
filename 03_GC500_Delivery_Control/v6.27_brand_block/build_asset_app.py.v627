function recordState(waiting, since){
  const at = SYNC.at ? hhmm(new Date(SYNC.at)) : null;
  if (SYNC.status === 'live' && SYNC.readonly)
    return {k: 'view', word: 'View only', sub: at ? 'last confirmed ' + at : 'this link cannot change the record',
            title: 'This link shows the shared record and cannot change it' + (at ? ' · last confirmed ' + at : '')};
  if (SYNC.status === 'live' && waiting)
    return {k: 'pending', word: 'Changes pending', sub: waiting + ' waiting to send',
            title: waiting + ' change' + (waiting === 1 ? '' : 's') + ' saved here and not yet on the shared record'};
  if (SYNC.status === 'live')
    return {k: 'shared', word: 'Shared record', sub: at ? 'last confirmed ' + at : 'up to date',
            title: 'Connected to the shared record' + (at ? ' · the service last answered at ' + at : '')};
  if (FOLDER.status === 'live')
    return {k: 'shared', word: 'Shared folder', sub: 'kept in the synced folder',
