  'microwave': 'Microwave', 'hydration station': 'Hydration station', 'urn': 'Urn', 'whiteboard': 'Whiteboard',
  'folding table': 'Folding table', 'table': 'Folding table', 'swivel chair': 'Swivel chair', 'stackable chair': 'Stackable chair',
  'chair': 'Chair', 'desk': 'Desk', 'air conditioner': 'Air conditioner', 'aircon': 'Air conditioner', 'air con': 'Air conditioner',
  'a/c': 'Air conditioner', 'heater': 'Heater', 'water cooler': 'Water cooler',
