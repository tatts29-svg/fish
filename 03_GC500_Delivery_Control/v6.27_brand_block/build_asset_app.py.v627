  return `<div class="sect filedhead">Maps filed against ${esc(key)} (${r.files.length})</div><div class="filedgrid">${r.files.map(f => {
    const url = SYNC.backend.fileUrl(f.id), nm = String(f.name || f.id);
    const pic = DOC_IMG.test(nm)
      ? `<a class="filedpic" href="${esc(url)}" target="_blank" rel="noopener" aria-label="Open the map"><img src="${esc(url)}" alt="${esc(f.title || nm)}" loading="lazy" decoding="async"></a>`
      : `<a class="filedpic filedfile" href="${esc(url)}" target="_blank" rel="noopener">${esc((nm.split('.').pop() || 'file').toUpperCase())}</a>`;
    const on = cur && cur.kind === 'file' && String(cur.id) === String(f.id);
    return `<figure class="filed"><${'div'}>${pic}</${'div'}><figcaption><b>${esc(f.title || nm)}</b>
      <span class="w">${f.uploaded ? 'uploaded ' + esc(fmtStamp(f.uploaded)) : 'upload time not recorded'}${f.by ? ' by ' + esc(f.by) : ''}</span>
      ${on ? '<span class="chip act">the map attached</span>' : ''}</figcaption></figure>`; }).join('')}</div>`;
}
/* every photograph the service holds for this reference — linked in any group here, or filed on the admin
