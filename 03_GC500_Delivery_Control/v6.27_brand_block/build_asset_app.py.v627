const ASIDE_COLLS = {costs: 'id', variances: 'id', fenceDockets: 'id', breakdowns: 'id', actions: 'id', added: 'key'};
function setAside(coll, id, who){
  const idf = ASIDE_COLLS[coll]; if (!idf || !id) return false;
  const list = S[coll] || [];
  const i = list.findIndex(x => x && x[idf] === id); if (i < 0) return false;
  const rec = list[i];
  S.aside = S.aside || {};
  S.aside[id] = {coll, rec: JSON.parse(JSON.stringify(rec)), at: new Date().toISOString(), by: String(who || S.operator || '').trim() || null};
