}
function sameType(a, b){ return (contentsType(a) || String(a || '').trim().toLowerCase()) === (contentsType(b) || String(b || '').trim().toLowerCase()); }
/* the contents of one reference, each physical thing once, from the accessories (schedule + added here) and the
