     would be the kind of half-truth this page exists to avoid. labourPart() is the in-between. */
  const a = asset || allAssets().find(x => x.key === ref), us = a ? labourUnits(a) : [];
  return us.length ? us.every(u => !!L[labourKey(ref, disc, item, line, u)]) : false;
}
/* how many of a reference's buildings carry this tick, for anything that needs the in-between */
function labourPart(ref, disc, item, line){
  const a = allAssets().find(x => x.key === ref), us = a ? labourUnits(a) : [];
  if (!us.length) return {of: 1, on: labourTicked(ref, disc, item, line) ? 1 : 0};
  return {of: us.length, on: us.filter(u => labourTicked(ref, disc, item, line, u)).length};
}
function labourWho(ref, disc, item, line, unit){
  const k = 'labour/' + labourKey(ref, disc, item, line, unit);
  const legacy = unit ? 'labour/' + labourKey(ref, disc, item, line) : null;
  const by = (S.by || {})[k] || (legacy ? (S.by || {})[legacy] : null) || null;
  const at = (S.stamps || {})[k] || (legacy ? (S.stamps || {})[legacy] : null) || null;
  return {by: by, at: at};
}
/* Every labour line the card PRICES on one item type, for one building or for the reference.

   v5.55 offered every line the card had a column for, priced or not (Andrew Fisher, 19 Sep 2026: every line, just
   in case). v5.81 withdraws the unpriced ones on his word of 24 Sep 2026 — see labourOffered —
   so a line here always carries a figure; a tick records that the work happened and the figure is the card's. */
function labourLinesFor(ref, disc, item, key, unit, asset){
  const c = cardRate(disc, item, key), lp = c && c.labour_per_piece;
  if (!lp) return {state: 'no rate line', lines: [], note: 'this item type is not matched to a line on the card, so the card says nothing about labour on it'};
  const lines = (lp.lines || []).map(L => {
    const w = labourWho(ref, disc, item, L.key, unit);
    return {key: L.key, name: L.name, heading: L.heading, rate: L.rate, year: L.year, of_this_year: L.of_this_year,
            money: L.money || (typeof L.rate === 'number' && L.rate > 0 ? 'rate' : 'absent'), money_note: L.money_note,
            as_written: L.as_written, year_note: L.year_note,
            ticked: labourTicked(ref, disc, item, L.key, unit, asset), by: w.by, at: w.at};
  });
  /* v5.81 — THE LABOUR RULE (see labourOffered): only the lines the card carries a figure for on this item are
     on the reference. What the card leaves at nought, marks "Included" or has no column for is not mentioned, so
     it is not added — and a tick somebody recorded against such a line before this stays in the record, unread. */
  const kept = lines.filter(L => L.money === 'rate');
