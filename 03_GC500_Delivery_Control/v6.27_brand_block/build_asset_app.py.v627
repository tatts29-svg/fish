  const list = Array.isArray(a._unitsNotContents) ? a._unitsNotContents : unitsOf(a.key);
  const can = !SYNC.readonly;
  const hit = state.unit ? String(state.unit).toLowerCase() : null;
  const sheets = [...new Set(list.map(u => u.sheet).filter(Boolean))];
  const pre = state.unitPrefill && state.unitPrefill.ref === a.key ? state.unitPrefill : null;
  state.unitPrefill = null;
  const form = can ? `<details class="uadd"${!list.length || pre ? ' open' : ''}><summary>${list.length ? 'Record another one' : 'Record what is inside it — a name, an asset number, its place on a drawing'}</summary>
      ${unitForm(a.key, pre)}</details>` : '';
  /* v5.58 — the sentence "The schedule counts this as one row of N" was wrong and the audit said so: HRP is ONE
     building, 1189410, and its two air conditioners are inside it. N here is how many things a person has
     recorded inside the reference — never a count of buildings, and never a hire line. */
  if (!list.length) return `<p class="hint" style="margin:10px 0 6px"><b>Units recorded on site</b> — none yet. If there is more than one
      thing on the ground under ${esc(a.key)} — two toilet blocks, eight boards — each can be written down here with its own
      asset number and the numbered place on the drawing where it stands, and the map lights that place up.</p>
  <div class="form unitform">
    ${form}
  </div>`;
  return `<p class="hint" style="margin:10px 0 6px"><b>Units recorded on site</b> — ${list.length} inside ${esc(a.key)}.</p>
  <div class="form unitform">
    <p class="sub">${list.length === 1 ? 'The one thing' : 'The ' + list.length + ' things'} somebody has recorded standing under this reference —
      each with the name it goes by on site, its own asset number, and the numbered place
      ${sheets.length ? 'on <b>' + esc(sheets.join(', ')) + '</b> ' : ''}where it stands. Press a numbered place
      on the map and it opens here with that one marked.</p>
    <ul class="unitlist">${list.map((u, i) => {
      const on = hit && String(u.label || '').toLowerCase() === hit;
      return `<li${on ? ' class="on"' : ''}>
        <b class="unitlab">${esc(u.label || '—')}</b>
        <span class="mono unitno">${u.asset_no ? assetNo(u.asset_no) : '<span class="chip">no asset number</span>'}</span>
        <span class="unitwhere">${u.callout
          ? 'at <b>' + esc(u.callout) + '</b>' + (u.sheet ? ' <span class="w">on ' + esc(u.sheet) + '</span>' : '')
          : '<span class="chip cand">no place recorded</span>'}</span>
        ${on ? '<span class="chip act">the one you pressed</span>' : ''}
        ${can ? `<button type="button" class="btn ghost sm" data-udel="${esc(u.label || '')}" data-udelno="${esc(u.asset_no || '')}" title="Take this unit out of ${esc(a.key)}">Remove</button>` : ''}
      </li>`; }).join('')}</ul>
    <p class="norate">A name is a THING and a number is a PLACE, and they are kept apart because things move
      between places — the schedule's own Relocate row on 19 Oct moves five of them. Recorded by
      ${esc((list.find(u => u.by) || {}).by || 'nobody named')}${(list.find(u => u.at) || {}).at
        ? ' ' + esc(fmtStamp((list.find(u => u.at) || {}).at)) : ''}.</p>
    ${form}
  </div>`;
}
function dropPhotoBlock(a){
  const key = a.key, hosted = !!(SYNC.backend && SYNC.backend.fileUrl);
  const units = dropPhotoUnits(a);
  const all = dropPhotosOf(key), got = all.length;
  /* the places this drawer offers: two per asset number, or two on the reference where it has no number yet;
     a many-number reference that already holds site-level photographs shows those two places as well */
  const refHeld = all.filter(x => !unitKey(x.unit)).length;
  const places = units.length ? DROP_MAX * units.length + (units.length > 1 && refHeld ? DROP_MAX : 0) : DROP_MAX;
  const can = hosted && !SYNC.readonly;
  const head = `<div class="sect">Photographs of this drop${!got ? '' : got <= places ? ' (' + got + ' of ' + places + ')' : ' (' + got + ' photographs)'}</div>
  <p class="dphabout">Three from the ground, then two from the air for the drone — the same places on every building. A place stays empty until somebody stands there, or flies.</p>`;
  if (!hosted) {
    return head + `<div class="notice"><b>Photographs need the shared record</b>This copy of the page keeps
      everything in the browser it is open in, and a photograph is too big to live there. Open the record’s own
      link and the slots below fill from your phone.</div>`;
  }
  /* one group of DROP_MAX places: the reference itself (unit ''), or one unit by its asset number */
  const grid = (unit, opts) => {
    const u = unitKey(unit), id = 'dphf' + (u ? 'u' + u.replace(/[^A-Za-z0-9]/g, '') : '');
    const ua = u ? ` data-dphunit="${esc(u)}"` : '';
    return `<div class="dphgrid"${ua}>${dropPhotoSlots(key, u, opts).map((ph, i) => {
      const s = DROP_SLOTS[i] || {lab: 'Photo ' + (i + 1), hint: ''};
      const what = key + (u ? ' · asset ' + u : '');
      if (!ph) {
        /* v5.58 — USE A PHOTOGRAPH THE SERVICE ALREADY HAS, BY ITS FILE ID. The 19 Sep 2026 audit: the only way
           into a unit's slot was a new upload, so the same picture went up again for each building it showed,
           and a filed photograph could only ever land on the reference-level pair. A photograph is a file on the
           service; a slot is a LINK to it. This lists every file already linked anywhere on this reference, and
           every file filed against it on the admin page, and links the chosen one here — nothing is uploaded
           twice, and a wide shot that shows two units can be linked from both, on purpose, by a person. */
        const have = existingPhotosFor(key).filter(x => !dropPhotoSlots(key, u, opts).some(y => y && String(y.id) === String(x.id)));
        return `<div class="dph dphnone${s.aerial ? ' dphair' : ''}">
          <div class="dphslot" data-lab="${esc(s.lab)}">${esc(s.lab)}${s.aerial ? '<i class="dphdrone" title="a drone shot — Andrew\'s DJI">drone</i>' : ''}</div>
          <p class="dphhint">${esc(s.hint)}</p>
          ${can ? `<input class="dphin" type="file" id="${id}${i}" accept="image/jpeg,image/png,image/webp" data-dphadd="${i}"${ua}>
            <label class="btn primary dphpick" for="${id}${i}">Add a photo</label>${
            have.length ? `<div class="dphreuse"><select data-dphreuse="${i}"${ua} aria-label="Use a photograph the service already has for ${esc(what)}">
              <option value="">Use an existing photo…</option>${have.map(x => `<option value="${esc(x.id)}">${esc(x.label)}</option>`).join('')}</select></div>` : ''}`
                : `<p class="norate">This link can view the record but not add to it.</p>`}
        </div>`;
      }
      const r = photoFor(ph), url = r.state === 'ready' ? r.url : null;
      /* a photograph folded in from the reference level keeps its real home for its own controls */
      const hu = ph._fromReference ? '' : u, hi = ph._fromReference && typeof ph.slot === 'number' ? ph.slot : i;
      const hua = hu ? ` data-dphunit="${esc(hu)}"` : '', hid = 'dphf' + (hu ? 'u' + hu.replace(/[^A-Za-z0-9]/g, '') : '');
      return `<div class="dph">
        <div class="dphpic">
          ${url ? `<img src="${esc(url)}" alt="${esc(dropPhotoSays(key, ph))}" loading="lazy" data-dphopen="${esc(url)}" data-dphimg>`
                : photoBlock(r, ph, key)}
          ${url ? `<span class="dphl">On site</span>${u ? `<span class="dphu">asset ${esc(u)}</span>` : ''}` : ''}
        </div>
        <div class="dphslot" data-lab="${esc(s.lab)}">${esc(s.lab)}${s.aerial ? '<i class="dphdrone" title="a drone shot — Andrew\'s DJI">drone</i>' : ''}</div>
        <p class="dphsays">${esc(dropPhotoSays(key, ph))}</p>
        ${can ? `<div class="dphcap"><input type="text" maxlength="80" value="${esc(ph.caption || '')}"
            placeholder="${esc(s.lab)}" data-dphcap="${hi}"${hua} aria-label="What this photograph of ${esc(what)} shows"></div>
          <div class="dphacts">
            <input class="dphin" type="file" id="${hid}${hi}" accept="image/jpeg,image/png,image/webp" data-dphadd="${hi}"${hua}>
            <label class="btn ghost sm dphpick" for="${hid}${hi}">Replace</label>
            <button class="btn ghost sm" data-dphdel="${hi}"${hua}>Remove</button></div>`
              : `<p class="norate">${esc(ph.caption || s.lab)}</p>`}
      </div>`;
    }).join('')}</div>`;
  };
  /* The units. Each asset number known against the reference gets its own pair — WC16 is two toilet blocks,
     and a photograph of one is not a photograph of the other. Folded when there are many, open when the group
     already holds a picture. */
  /* v5.59 — A PHOTOGRAPH GOES WHERE THE ASSET NUMBER IS. Andrew Fisher, 19 Sep 2026: photographs are added where
     the asset number is shown; options that did not line up with any asset number made a mess everywhere.
     He was right: a nameless pair for "the reference" was drawn
     above the pair for each asset number, on every reference — so a building with one number had two places to
     put a photograph, one of them labelled with nothing. Photographs of a thing belong against the thing's
     number.

     So: where a reference carries asset numbers, the places are the asset numbers' places and nothing else.
     The nameless pair exists only where there is no number yet — because then the reference IS the only name
     the thing has. Photographs already recorded at reference level on a one-number reference are shown under
     that number, because that is the building they are photographs of; on a many-number reference they are
     shown as "the site, not one unit" so nobody has to guess which building a wide shot is. */
  const refPhotos = dropPhotoSlots(key, '').filter(Boolean);
  const oneNumber = units.length === 1;
  const unitBlocks = units.map(u => {
    const n = dropPhotoSlots(key, u, {foldReference: oneNumber}).filter(Boolean).length;
    return `<details class="dphunit" open>
      <summary><span class="dphuh">${assetNo(u)}</span><span class="w">${!n ? 'no photograph yet' : n <= DROP_MAX ? n + ' of ' + DROP_MAX : n + ' photographs'}</span></summary>
      ${grid(u, {foldReference: oneNumber})}</details>`; }).join('');
  const siteBlock = !oneNumber && units.length && refPhotos.length
    ? `<details class="dphunit" open><summary><span class="dphuh">The site, not one unit</span><span class="w">${refPhotos.length} photograph${refPhotos.length === 1 ? '' : 's'}</span></summary>${grid('')}</details>` : '';
  return head + `<div class="form dphform">
    <p class="sub">Taken after it went in. These are <b>${esc(key)}</b> itself, not the product, and they say so
      wherever they appear.${can ? ' Everyone on the record sees them.' : ''}${units.length > 1
      ? ` Each of the ${units.length} units inside it has its own two places, by asset number.` : ''}</p>
    ${units.length ? '' : grid('')}
    ${unitBlocks}
    ${siteBlock}
    <p class="norate" id="dphMsg">${can ? 'Your phone offers the camera or your library. Each one is shrunk to '
      + DROP_PX + ' px before it is sent, so it opens quickly at the circuit.'
      : 'Photographs are added from a link that can change the record.'}</p>
  </div>`;
}
function satelliteBlock(a){
  if (!DATA.aerial_hi) return '';
  const pt = aerialPointFor(a);
  if (!pt) {
    /* Four different reasons, and they are not interchangeable — one is a gap in the schedule, one is a sheet
       we were never given, one is a callout drawn somewhere on the page the registration does not cover, and
       one is a callout that is genuinely not on the photograph. */
    const links = a.drawing_links || [];
    const carried = links.filter(l => DATA.sheets.some(s => s.sheet_id === l.sheet));
    const op = offPlanFor(a), mv = movedFor(a);
    let why;
    if (mv) {
      why = '<b>Location changed — the pin needs checking.</b> ' + esc(movedWords(mv))
          + ' The drawing callout is kept as the PREVIOUS plan, and it is not offered as a destination: '
          + 'no coordinate, no Navigate, no QR. Confirm the new spot with the site supervisor. '
          + 'Putting the schedule\'s own wording back restores the old point with it.';
    } else if (op) {
      why = esc(offPlanWords(op)) + ' The drawing is still right — it is the only part of this that is — '
          + 'so the callout is shown on the sheet on the map tab and under the drop sheet. '
          + 'A position on the ground has to come from the site supervisor, and nothing here has invented one.';
    } else if (!links.length) {
      why = 'No drawing callout matches this reference, so there is no point to centre on. '
          + 'Assigning it a reference on a sheet is what closes this.';
    } else if (!carried.length) {
      const sheets = [...new Set(links.map(l => l.sheet))].join(', ');
      why = 'Its only match is on ' + esc(sheets) + ', which this file does not carry — '
          + 'no file for that sheet has been supplied, so there is nothing to show a location against.';
    } else {
      why = 'Its callout sits on the sheet but outside the aerial photograph — a legend key or a '
          + 'title-block reference rather than a point on the circuit.';
    }
    return `<div class="sat none"><div class="sath">What this location looks like</div>
      <p class="satmsg">${why}</p></div>`;
  }
  const z = satZoom();
  const live = liveMapPossible() && satLiveOn();
  const btns = SAT_ZOOM.map(x =>
    `<button class="satz${x.k === z.k && !live ? ' on' : ''}" data-satz="${x.k}">${x.label}</button>`).join('')
    /* v5.51 — the live map, on the hosted link only: a file opened from storage never shows the button, because
       there is no address for Mapbox to trust and nothing honest for it to do (see LIVEMAP) */
    + (liveMapPossible() ? `<button class="satz live${live ? ' on' : ''}" data-satlive="1" title="A live satellite map with street names under this position, from Mapbox — pans and zooms past the edge of the drawing">Live</button>` : '');
  const stale = pt.year !== 2026;
  const o = DATA.orientation;
  /* North, rotated onto the photograph. There is no north arrow on any supplied sheet, so this is derived from
     the drawings' own landmark labels and says so. */
  const northDeg = o ? o.north_deg_clockwise_from_sheet_top : null;
  const rose = o ? `<div class="rose" title="${esc(o.confidence)}">
      <div class="needle" style="transform:rotate(${northDeg}deg)"><i></i></div>
      <span class="rn" style="transform:translate(-50%,-50%) rotate(${northDeg}deg) translateY(-19px) rotate(${-northDeg}deg)">N</span>
    </div>` : '';
  /* N, E, S and W around the edge of the picture, turned to the derived orientation. Landmark labels are
     scattered across the sheet for legibility — three NERANG RIVER labels, four MAIN BEACH — so averaging them
     into a point and quoting a bearing to it would be reading more into the drawing than it says. The rotation
     itself is robust: it only needs the ocean to be above the river and Main Beach left of Surfers Paradise. */
  const edge = o ? ['N', 'E', 'S', 'W'].map((c, i) => {
    const ang = ((i * 90 - o.sheet_top_bearing_deg) % 360 + 360) % 360;   // clockwise from the top of the box
    return `<span class="edgec${c === 'N' ? ' n' : ''}"
      style="transform:translate(-50%,-50%) rotate(${ang}deg) translateY(-78px) rotate(${-ang}deg)">${c}</span>`;
  }).join('') : '';
  return `<div class="sat">
   <div class="sath"><span>What this location looks like</span><span class="satzs">${btns}</span></div>
   <div class="satbox" id="satbox">
     <img id="satimg" src="${DATA.aerial_hi}" alt="Aerial photograph centred on callout ${esc(pt.label)}" loading="lazy" decoding="async">
     <span class="satx"></span>
     <span class="edgewrap">${edge}</span>
     ${rose}
   </div>
   <p class="satcap">
     ${pt.fromArrow
       ? `Centred on <b>where callout ${esc(pt.label)}'s arrow points</b> on <b>${esc(pt.sheet.sheet_id || pt.sheet.key)}</b>`
       : `Centred on <b>callout ${esc(pt.label)}</b> on <b>${esc(pt.sheet.sheet_id || pt.sheet.key)}</b>`}${
       stale ? ' — <span class="chip crit">a 2025 sheet</span>' : ''}.
     ${pt.fromArrow
       ? `The bubble sits ${Math.round(pt.arrowPt)} points away where it reads clearly on a crowded sheet; the
          leader line is followed to what it points at, which is the better answer. Still a drawing, not a survey.`
       : `This callout has no leader line, so this is the <b>bubble</b> — where the number is printed, not
          necessarily where the thing goes.`}${
       stale ? ' The circuit is re-set every year, so a 2025 callout is a weaker guide again.' : ''}
   </p>
   ${(() => { const ll = lonLatOf(pt.ax, pt.ay); const g = DATA.georef; return ll ? `<p class="satcap pos">
     <b>Approx. position</b> <span class="mono">${ll.text}</span> (WGS84, lat, lon)
     <button class="btn ghost tiny" data-copypos="${ll.text}" title="Copy the coordinates">Copy</button>
     ${(() => { const t = navTargetFor(a); return t && t.pinned
       ? `<a class="btn ghost tiny out" href="${esc(navUrl(t.ll))}" target="_blank" rel="noopener" title="${esc(navSays(a))}">Navigate ↗ <span class="navpinned">pinned</span></a>`
       : `<a class="btn ghost tiny out" href="${esc(navUrl(ll))}" target="_blank" rel="noopener" title="Opens Google Maps outside this page, at these coordinates — nothing is contacted until you tap it">Navigate ↗</a>`; })()}
     <a class="btn ghost tiny out" href="${esc(streetViewUrl(ll))}" target="_blank" rel="noopener" title="Opens Google Street View outside this page, at these coordinates — the nearest street photo, not the callout itself">Street View ↗</a>
     <a class="btn ghost tiny out" href="${esc(earthUrl(ll))}" target="_blank" rel="noopener" title="Opens Google Earth outside this page, tilted over these coordinates — for seeing the shape of the place before anybody has been to it">Google Earth ↗</a>
     ${depotUrl(ll) ? `<a class="btn ghost tiny out" href="${esc(depotUrl(ll))}" target="_blank" rel="noopener" title="Opens directions from ${esc(DATA.depot.name)} to this spot, outside this page — the run time shown there is the maps app's live estimate, not this page's">From ${esc(DATA.depot.name)} ↗</a>` : ''}
     ${(() => { const r = depotRun(ll); return r ? `<span class="run" title="${esc(r.detail)}"><b>From ${esc(DATA.depot.name)}:</b> ${esc(r.text)} <span class="chip ${r.routed ? 'ref' : 'cand'}" title="${esc(r.detail)}">${r.routed ? 'TomTom route · planning figure' : 'planning figure'}</span></span>` : ''; })()}
     ${(() => { const n = nearestStreet(a.key); return n ? `<span class="run" title="TomTom's nearest address to the drawn spot, ${esc(n.distance_m != null ? 'about ' + n.distance_m + ' m from it' : 'within ' + String((DATA.tomtom.nearest || {}).radius_m || 60) + ' m')}, taken ${esc(fmtWhen(n.taken_at))} — for saying where it is, not the site's address"><b>Nearest street:</b> ${esc(n.address.replace(/, QLD, \d{4}$/, ''))}${n.distance_m != null ? ` <span class="w" style="color:var(--mute)">about ${esc(String(n.distance_m))} m from the drawn spot</span>` : ''} <span class="chip cand">TomTom · nearest address</span>${snapAgeChip(n.taken_at)}</span>` : ''; })()}
     <span class="sub">— the callout's spot on the drawing through a ±${esc(String(g.fit_worst_m))} m registration:
     for finding the area with a satnav, not for setting out. The ↗ links open outside this page in your own maps app${
     DATA.depot ? `; the live run time from ${esc(DATA.depot.name)} (${esc(DATA.depot.address || '')}) is that app's. ${(() => {
       /* ONE FIGURE, ONE EXPLANATION. 21 Sep 2026, from the live review: this sentence always printed the
          straight-line assumptions — distance times 1.25, sixty km/h, plus ten minutes — while the figure a
          few words above it was labelled "TomTom route". Two explanations for one number, one of them wrong,
          and a reader has no way to tell which. The figure knows its own provenance: depotRun returns a routed
          result with its source, its departure and when it was captured, or a calculated one with the
          assumptions it was calculated from. So the explanation is taken from the result rather than written
          alongside it, and a page carrying no snapshot says so honestly instead of claiming a route. */
       const r = depotRun(ll);
       if (!r) return '';
       return r.routed
         ? `The figure above is a provider route, not this page's arithmetic: ${esc(r.detail)}`
         : `The figure above is this page's own arithmetic, not a route anybody drove: ${esc(r.detail)}`;
     })()} ${esc(DATA.depot.name)} as most loads' origin, stated ${esc(DATA.depot.stated_on)}` : ''}.</span></p>` : ''; })()}
   ${o ? `<p class="satcap sub"><b>Which way is which.</b> ${esc(o.derivation)}</p>` : ''}
   ${gettingThere(pt)}
   <p class="satcap sub">${esc(DATA.aerial_note || '')}${DATA.georef ? ' The bar on the picture is the scale.' : ' Do not scale distances off it.'}</p>
   <div class="satacts">
     ${mapSheetFor(a) ? '<button class="btn ghost" id="satToMap">Open the drawing here</button>' : ''}
     ${(() => { const sp = spotOf(a), ll = sp ? {lat: sp.lat, lon: sp.lon} : lonLatOf(pt.ax, pt.ay); if (!ll || !sat3dPossible()) return '';
        /* v5.81 — WHERE IT IS, PUSHED FURTHER (Andrew Fisher, 24 Sep 2026: photographs, where it is on the map, aerial
           shots, pushed further, with his Google key): a fly-around of the spot in Google's photorealistic 3D, and the nearest
           street photograph, drawn in this page — each on a press, because each press is billed to his account. The key is
           the one on About → 3D satellite, kept in the shared record and never in an export. */
        return `<button class="btn ghost" id="satFly" data-lat="${ll.lat}" data-lon="${ll.lon}" title="A slow circle round this spot in Google's photorealistic 3D (Maps JavaScript 3D, beta), drawn here on this press — billed to Andrew's Google account per opening">Fly around · Google 3D</button>
     <button class="btn ghost" id="satSv" data-lat="${ll.lat}" data-lon="${ll.lon}" title="Google's nearest Street View panorama to this spot, turned to face it and free to look round — drawn here on this press, billed per opening; the street, not the thing itself">Street View · here</button>`; })()}
   </div>
   <div id="satgoogle"></div>
  </div>`;
}

/* Centre a crop of the aerial on a point. The drawer's satellite window and the driver's drop sheet both do
   this; two copies of it would drift the first time somebody changed one. */
function placeCrop(box, img, pt, f){
  if (!box || !img || !pt) return;
  const place = () => {
    const W = box.clientWidth, H = box.clientHeight;
    if (!W || !img.naturalWidth) return;
    const iw = W / f;
    const ih = iw * (img.naturalHeight / img.naturalWidth);
    img.style.width = iw + 'px';
    img.style.height = ih + 'px';
    img.style.left = Math.round(-(pt.ax * iw - W / 2)) + 'px';
    img.style.top = Math.round(-(pt.ay * ih - H / 2)) + 'px';
    scaleBar(box, W, f);
  };
  if (img.complete && img.naturalWidth) place(); else img.onload = place;
}

/* A scale bar for a window that shows a fraction f of the frame's width across W CSS pixels. Only drawn when
   the frame is georeferenced; a bar on an unscaled picture would be a lie. */
function scaleBar(box, W, f){
  const g = DATA.georef;
  let bar = box.querySelector('.sbar');
  if (!g) { if (bar) bar.remove(); return; }
  const mPerPx = (f * g.frame_m_ground[0]) / W;                 // ground metres per CSS pixel in this window
  const nice = [5, 10, 20, 25, 50, 100, 200, 250, 500, 1000];
  const target = Math.min(W * 0.3, 140) * mPerPx;
  const m = nice.reduce((a, b) => Math.abs(Math.log(b / target)) < Math.abs(Math.log(a / target)) ? b : a, nice[0]);
  if (!bar) { bar = document.createElement('span'); bar.className = 'sbar'; box.appendChild(bar); }
  bar.style.width = (m / mPerPx).toFixed(1) + 'px';
  bar.textContent = m >= 1000 ? (m / 1000) + ' km' : m + ' m';
  bar.title = 'Scale bar — ' + bar.textContent + ' on the ground';
}
function positionSat(){ placeCrop($('#satbox'), $('#satimg'), state.satPt, satZoom().f); }

function mapSheetFor(a){
  for (const l of (a.drawing_links||[])) {
    const sh = DATA.sheets.find(s => s.sheet_id === l.sheet);
    if (sh) return sh;
  }
  return null;
}
function offhireChip(a){
  if (a.origin === 'drawing') return '<span class="chip cand" title="drawn on the sheet; no schedule row puts it on site or takes it off">no schedule row</span>';
  const st = (a.hire||{}).offhire || (a.demob_covered ? 'demob row' : 'none');
  if (st === 'stated') return '<span class="chip ok">removed ' + esc(String((a.hire||{}).offhire_date || '')) + '</span>';
  if (st === 'demob row') return '<span class="chip ok">demob row</span>';
  if (st === 'rental off-hire') return '<span class="chip ok" title="no schedule row takes it off site; the rental system carries an off-hire date">off hire ' + esc(String((a.hire||{}).offhire_date || '')) + '</span>';
  return '<span class="chip crit">nothing removes it</span>';
}
function assetWeeks(a){
  const stored = movedAway(a.key) ? null : S.weeks[a.key];
  if (stored != null && stored !== '') {
    const w = safeWeeks(stored);
    if (w != null) return {w, basis:'entered by hand', firm:true, assumed:false};
    return {w:null, basis:'the weeks entered by hand ("' + String(stored).slice(0,20) +
            '") is not a number between 0 and ' + MAX_WEEKS + ' — nothing on this asset can be priced until it is',
            firm:false, assumed:false, invalid:true};
  }
  const h = a.hire || {weeks:null, basis:'no dates in the source', assumed:false};
  /* a typed hire start moves the start of the charged span; the end is the one the register uses — the stated
     off-hire day, else the end of the programme — and the span never goes below nought */
  const hs = hireStartOf(a.key);
  if (hs) {
    const end = h.offhire_date || (DATA.summary && DATA.summary.programme_end) || a.last_date || null;
    if (end) {
      const d = (new Date(end + 'T00:00:00') - new Date(hs.iso + 'T00:00:00')) / 86400000;
      return {w: Math.max(0, d) / 7, basis: 'from the hire start ' + fmtDate(hs.iso) + ' typed by ' + (hs.by || 'unnamed') + ' to ' + (h.offhire_date ? 'the stated off-hire day ' + fmtDate(end) : 'the end of the programme ' + fmtDate(end)),
              firm: true, assumed: !h.offhire_date, hireStart: hs.iso};
    }
  }
  if (h.weeks == null && a._added) {
    /* An asset added in this page has no schedule behind it, so its weeks come from the dates the person typed
       into the form. Saying "no dates in the source" about a date they just entered is simply untrue. */
    if (a.first_date && a.last_date) {
      const d = (new Date(a.last_date) - new Date(a.first_date)) / 86400000;
      /* Andrew Fisher's audit, 12 Sep 2026: a one-day hire was charging 0.7 of a day. The weeks were rounded to
         one decimal HERE and then multiplied back by seven for a daily rate, so 1/7 of a week became 0.1, and
         0.1 × 7 = 0.7 days. The arithmetic keeps the exact fraction; rounding belongs on the face, not in the
         money. This does not decide whether the last day is billed — the end-minus-start convention is unchanged. */
      if (d > 0) return {w:d / 7, basis:'from the on-site and off-site dates entered here',
                         firm:true, assumed:false};
    }
    return {w:null, basis:'added in this page with no on-site and off-site dates — enter them to price it',
            firm:false, assumed:false};
  }
  return {w:h.weeks, basis:h.basis, firm:false, assumed:!!h.assumed};
}
/* Every item type on the asset, each at its own quantity. Pricing only the first type at quantity 1 undercharged
   WC01 (a toilet AND two FWF) and WB06 (154 barriers billed as one). A line with no readable quantity is not
   priced and says why — it is never quietly treated as 1. */
function chargeLines(a){
  if (a.charge_lines && a.charge_lines.length) return a.charge_lines;
  /* An asset added in this page carries no charge_lines from the register, and treating that as "nothing to
     price" put it in neither the priced nor the blocked bucket: 141 + 9 = 150 under a headline of 151, and the
     asset billed nothing at any rate. Build its lines from what the person actually entered. */
  if (a._added) return (a.item_types||[]).map((it, i) => ({
    item:it, discipline:a.discipline,
    quantity: (i === 0 && a._qtyTyped) ? a._qtyTyped.to : Math.max(1, safeNum(a._qty, 9999) || 1),
    quantity_state: (i === 0 && a._qtyTyped) ? 'typed over' + (a._qtyTyped.by ? ' by ' + a._qtyTyped.by : '') : 'entered here', priceable:true}));
  return [];
}
/* ------------------------------------------------------------------ labour per piece of equipment
