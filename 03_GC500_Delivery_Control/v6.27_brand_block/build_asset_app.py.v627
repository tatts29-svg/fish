    doc: path => { const [coll, id] = path.split('/'); return { id, path,
      set: async body => { const r = await fetch(api(coll, id), {method: 'PUT', headers: headers({'Content-Type': 'application/json'}), body: JSON.stringify(body)});
        if (!r.ok) throw {code: r.status === 403 ? 'not_writer' : r.status === 401 ? 'revoked' : 'unavailable', message: String(r.status)};
        (docs[coll] = docs[coll] || {})[id] = body; ackVersion((await r.json()).version); },
      delete: async () => { const r = await fetch(api(coll, id), {method: 'DELETE', headers: headers()});
        if (!r.ok) throw {code: r.status === 403 ? 'not_writer' : r.status === 401 ? 'revoked' : 'unavailable', message: String(r.status)};
        if (docs[coll]) delete docs[coll][id]; ackVersion((await r.json()).version); } }; },
    start: () => { pull(true); clearInterval(timer);
      timer = setInterval(() => { if (document.visibilityState === 'visible') pull(false); }, 4000);
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') pull(false); });
      window.addEventListener('focus', () => pull(false)); },
    redeliver: deliverAll,
    /* V11 audit, F04: the one backend that has a capability to LEARN — it asks /api/version what this link may
       do, so until it answers the capability is unknown rather than assumed to be edit. */
    rest: true,
    /* WHAT THE LINK ITSELF SAYS, which is not the same as what the service has said.
       An address of the form /e/<token> is an edit link and /v/<token> is a view link; a token this browser
       kept from an earlier visit says the same thing. That claim is not authority — the service can still
       answer not_writer and take the page read-only in front of the person — but it IS what the link was
       handed out as, and it is the only thing there is to go on while the service is not answering. Null when
       a hosted page carries no token at all: then nothing claims anything and unknown is the honest answer. */
    claims: (ls('gc500.edit') || (m && m[1] === 'e')) ? 'edit'
          : (ls('gc500.view') || (m && m[1] === 'v')) ? 'view' : null,
    /* the document library the same service keeps: /api/files lists it, /f/<token>/<id> opens one */
    fileUrl: id => '/f/' + encodeURIComponent(tok()) + '/' + encodeURIComponent(id),
    thumbUrl: (id, sha256) => '/f/' + encodeURIComponent(tok()) + '/' + encodeURIComponent(id) + '/thumb' + (sha256 ? '?v=' + encodeURIComponent(sha256) : ''),
    /* v5.77 — the Coates Way machine the same service keeps: /api/machine says whether it is there, /w/<key>/
       opens it, under whichever key this browser holds — the view link is enough */
    machineUrl: () => '/w/' + encodeURIComponent(tok()) + '/',
    machine: async () => { const r = await fetch('/api/machine', {headers: headers(), cache: 'no-store'}); if (!r.ok) throw new Error('machine ' + r.status); return r.json(); },
    files: async () => { const r = await fetch('/api/files', {headers: headers(), cache: 'no-store'}); if (!r.ok) throw new Error('files ' + r.status); return r.json(); },
    upload: (file, meta) => {
      if (fileUploads.has(file)) return fileUploads.get(file);
      const work = (async () => {
      let preview = null, previewError = '';
      try { preview = await makeFileThumbnail(file); } catch (e) { previewError = String(e && e.message || e); }
      const h = headers({'Content-Type': file.type || 'application/octet-stream', 'x-file-name': encodeURIComponent(file.name),
        'x-file-kind': (meta && meta.kind) || 'swms', 'x-file-title': encodeURIComponent((meta && meta.title) || ''), 'x-file-note': encodeURIComponent((meta && meta.note) || '')});
      /* what it is filed against — the reference of a photograph, the branch and number of an invoice — checked
         by the service against the lists this very page carries in its head */
      if (meta && meta.ref) h['x-file-ref'] = encodeURIComponent(String(meta.ref).trim().toUpperCase());
      if (meta && meta.branch) h['x-file-branch'] = encodeURIComponent(String(meta.branch).trim().toUpperCase());
      if (meta && meta.invoice_no) h['x-file-invoice'] = encodeURIComponent(String(meta.invoice_no).trim());
      const r = await fetch('/api/files', {method: 'POST', headers: h, body: file});
      if (!r.ok) { let j = {}; try { j = await r.json(); } catch (e) {} throw new Error(j.error || (r.status === 403 ? 'this link can view but not add files' : 'upload refused (' + r.status + ')')); }
      const saved = await r.json();
      if (preview && saved && saved.id) {
        try {
          if (!saved.sha256) throw new Error('The service did not return the original checksum.');
          const tr = await fetch('/api/files/' + encodeURIComponent(saved.id) + '/thumb', {method: 'POST',
            headers: headers({'Content-Type': 'image/webp', 'x-file-sha256': saved.sha256}), body: preview});
          if (!tr.ok) throw new Error('Preview upload refused (' + tr.status + ').');
          saved.thumb = true;
        } catch (e) { previewError = String(e && e.message || e); }
      }
      if (previewError && saved) { saved.previewPending = true; saved.previewError = previewError; }
      return saved;
      })();
      fileUploads.set(file, work);
      work.then(() => fileUploads.delete(file), () => fileUploads.delete(file));
      return work; },
    removeFile: async id => { const r = await fetch('/api/files/' + encodeURIComponent(id), {method: 'DELETE', headers: headers()});
      if (!r.ok) throw new Error(r.status === 403 ? 'this link cannot remove files' : 'refused (' + r.status + ')'); return r.json(); },
    /* the driver drop cards the same service keeps: posted whole, served from their own token at /d/<token> */
    makeCard: async card => {
      const r = await fetch('/api/cards', {method: 'POST', headers: headers({'Content-Type': 'application/json'}), body: JSON.stringify(card)});
      let j = {}; try { j = await r.json(); } catch (e) {}
      if (!r.ok) throw new Error(j.error || (r.status === 403 ? 'this link can view but not make drop cards' : 'the service refused the card (' + r.status + ')'));
      return j; },
    cards: async () => { const r = await fetch('/api/cards', {headers: headers(), cache: 'no-store'});
      if (!r.ok) throw new Error('cards ' + r.status); return r.json(); },
    withdrawCard: async token => { const r = await fetch('/api/cards/' + encodeURIComponent(token), {method: 'DELETE', headers: headers()});
      if (!r.ok) throw new Error(r.status === 403 ? 'this link cannot withdraw drop cards' : 'refused (' + r.status + ')'); return r.json(); },
    /* v5.56 — what the people on the ground have reported back off their cards. Behind the edit link, because a
       report carries somebody's name and photographs of a site. Read only: nothing here writes to the record. */
    reports: async () => { const r = await fetch('/api/reports', {headers: headers(), cache: 'no-store'});
      if (!r.ok) throw new Error(r.status === 403 ? 'this link can view the record but not the card reports' : 'reports (' + r.status + ')');
      return r.json(); },
    /* texting, through the same service. The ClickSend details are Railway variables Andrew Fisher sets himself —
       they are not in this page, and this page never sees them. The service counts the day and refuses past it. */
    sms: async n => { const r = await fetch('/api/sms?n=' + (n || 40), {headers: headers(), cache: 'no-store'});
      if (r.status === 501) return Object.assign({configured: false}, await r.json());
      if (!r.ok) throw new Error(r.status === 403 ? 'this link can view the record but not send texts' : 'texts (' + r.status + ')');
      return r.json(); },
    sendSms: async body => { const r = await fetch('/api/sms', {method: 'POST', headers: headers({'Content-Type': 'application/json'}), body: JSON.stringify(body)});
      let j = {}; try { j = await r.json(); } catch (e) {}
      /* a part-send comes back with the list and an error together — hand both on rather than throwing the list away */
      if (!r.ok && !j.messages) throw new Error(j.error || 'the service refused the send (' + r.status + ')');
      return j; },
  };
}
/* the hosted page reaches its capabilities through window.claude.use; a plain file has no window.claude */
function syncBoot(){
  const c = window.claude;
  if (!c || typeof c.use !== 'function') {
    const rest = restBackend();
    if (rest) { SYNC.backend = rest; syncStart(rest); rest.start(); docsRedraw(); return; }
    syncFooter(); folderBoot(); return; }
  SYNC.status = 'connecting'; syncFooter();
  c.use('db').then(db => { if (db) syncStart(db); else syncStop('revoked'); }).catch(() => syncStop('revoked'));
  c.use('downloads').then(dl => { SYNC.dl = dl || null; }).catch(() => {});
}

/* ------------------------------------------------------------------ the shared folder (SharePoint / OneDrive)
   The file edition, opened from a folder that OneDrive keeps in step with a SharePoint library: this page writes
   its records to ONE file of its own in that folder (gc500_records_<name>_<id>.json) after every save, and reads
   everyone else's files every half minute and whenever the window comes back to the front. Others' records are
   merged in with the same rules Import uses — later change wins, deletions honoured, disagreements written
   down — and the merged picture is written back to this page's own file, so the files converge. No server, no
   database: OneDrive carries the files, Edge or Chrome reads the folder (the File System Access API), and a
   phone or another browser simply stays on Export/Import. The folder is chosen once and remembered. */
const FOLDER = {dir: null, status: 'off', mine: null, seen: {}, skipped: {}, people: {}, timer: null, wtimer: null, last: null, writing: false, again: false, clashes: [], lastRead: null, supported: !!(window.showDirectoryPicker && window.indexedDB)};
function folderIdb(mode, fn){
  return new Promise((res, rej) => {
    const rq = indexedDB.open('gc500.sync', 1);
    rq.onupgradeneeded = () => rq.result.createObjectStore('kv');
    rq.onerror = () => rej(rq.error);
    rq.onsuccess = () => { try { const tx = rq.result.transaction('kv', mode); const st = tx.objectStore('kv');
      const r = fn(st); tx.oncomplete = () => res(r && r.result); tx.onerror = () => rej(tx.error); } catch (e) { rej(e); } };
  });
}
function folderSlug(){
  const base = (S.operator || 'unnamed').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'unnamed';
  if (!S.syncId) { S.syncId = Math.random().toString(36).slice(2, 8); persist(); }
  return 'gc500_records_' + base + '_' + S.syncId + '.json';
}
async function folderConnect(){
  if (!FOLDER.supported) { flash('This browser cannot read a folder — use Edge or Chrome on a laptop, or Export/Import.'); return false; }
  try {
    const dir = await window.showDirectoryPicker({mode: 'readwrite', id: 'gc500-shared'});
    try { await folderIdb('readwrite', st => st.put(dir, 'folder')); }
    catch (e) { flash('The folder is connected for this visit but could not be remembered — you will be asked for it again next time.'); }
    return folderStart(dir);
  } catch (e) { if (e && e.name !== 'AbortError') flash('Could not open that folder (' + (e.name || e) + ').'); return false; }
}
async function folderBoot(){
  if (!FOLDER.supported) { folderButton(); return; }
  try {
    const dir = await folderIdb('readonly', st => st.get('folder'));
    if (!dir) { folderButton(); return; }
    FOLDER.dir = dir; FOLDER.status = 'ask';                     // permission needs a click — the button asks for it
    const p = await dir.queryPermission({mode: 'readwrite'});
    if (p === 'granted') await folderStart(dir); else folderButton();
  } catch (e) { folderButton(); }
}
async function folderStart(dir){
  try {
    const p = await dir.requestPermission({mode: 'readwrite'});
    if (p !== 'granted') { FOLDER.status = 'ask'; folderButton(); return false; }
  } catch (e) { FOLDER.status = 'ask'; folderButton(); return false; }
  FOLDER.dir = dir; FOLDER.status = 'live'; FOLDER.mine = folderSlug();
  folderButton(); syncFooter();
  await folderRead(); folderWrite();
  clearInterval(FOLDER.timer);
  FOLDER.timer = setInterval(() => { if (document.visibilityState === 'visible') folderRead(); }, 30000);
  if (!FOLDER.wired) { FOLDER.wired = true;
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') folderRead(); });
    window.addEventListener('focus', () => folderRead()); }
  return true;
}
async function folderDisconnect(){
  clearInterval(FOLDER.timer); FOLDER.dir = null; FOLDER.status = 'off'; FOLDER.people = {}; FOLDER.seen = {};
  try { await folderIdb('readwrite', st => st.delete('folder')); } catch (e) {}
  folderButton(); syncFooter(); flash('Shared folder disconnected — records stay in this browser; Export to hand them on.');
}
/* my file: the same shape Export writes, so a file from the folder can also be Imported anywhere */
function folderWrite(){
  if (FOLDER.status !== 'live' || !FOLDER.dir) return;
  clearTimeout(FOLDER.wtimer);
  FOLDER.wtimer = setTimeout(async () => {
    /* Andrew Fisher's audit, 12 Sep 2026: when the name on this copy changed, the old file was deleted BEFORE the
       new one was written. A write that then failed left the folder with neither — this operator's records gone
       from the shared folder under both names. The new file is written and closed first; only then is the old
       name removed. And one write at a time: a change arriving mid-write is queued and written after it. */
    if (FOLDER.writing) { FOLDER.again = true; return; }
    FOLDER.writing = true;
    try {
      const name = folderSlug();
      const text = JSON.stringify(Object.assign(exportRecord(), {_shared_folder: true, _file: name}), null, 1);
      if (text !== FOLDER.last) {
        const fh = await FOLDER.dir.getFileHandle(name, {create: true});
        const w = await fh.createWritable(); await w.write(text); await w.close();
        FOLDER.last = text;
        const old = FOLDER.mine;
        FOLDER.mine = name;
        if (old && old !== name) { try { await FOLDER.dir.removeEntry(old); } catch (e) {} }
      }
    } catch (e) { flash('Could not write to the shared folder (' + (e.name || e) + ') — records are still saved in this browser.'); }
    FOLDER.writing = false;
    if (FOLDER.again) { FOLDER.again = false; folderWrite(); }
  }, 1000);
}
/* everyone else's files: merged in when they have changed since last time */
async function folderRead(){
  if (FOLDER.status !== 'live' || !FOLDER.dir) return;
  let changed = false, clashes = [];
  try {
    const mine = folderSlug();
    const names = [];
    for await (const [name, h] of FOLDER.dir.entries()) {
      if (h.kind !== 'file' || !/^gc500_records_.*\.json$/i.test(name) || name === mine) continue;
      names.push(name);
      const f = await h.getFile();
      const stamp = f.lastModified + ':' + f.size;
      if (FOLDER.seen[name] === stamp) continue;
      /* Andrew Fisher's audit, 12 Sep 2026: anything in the folder with the right name was parsed and merged
         straight in. A file picked by hand is size-checked and validated first; a file from the folder is the
         same file from the same kind of person, so it goes through the same door. A file that fails is skipped
         by name and said out loud, never merged. */
      if (f.size > IMPORT_MAX_BYTES) { FOLDER.seen[name] = stamp; FOLDER.skipped[name] = 'larger than ' + Math.round(IMPORT_MAX_BYTES / 1048576) + ' MB'; continue; }
      let j; try { j = JSON.parse(await f.text()); } catch (e) { FOLDER.seen[name] = stamp; FOLDER.skipped[name] = 'not readable as a record file'; continue; }
      FOLDER.seen[name] = stamp;
      if (!j || typeof j !== 'object' || Array.isArray(j)) { FOLDER.skipped[name] = 'not a record file'; continue; }
      const theirs = recordsFrom(j);
      const wrong = validateRecords(theirs).filter(x => !/^note: /.test(x));
      if (wrong.length) { FOLDER.skipped[name] = wrong[0]; continue; }
      delete FOLDER.skipped[name];
      FOLDER.people[name] = {who: theirs.operator || j.committed_by || name, at: j.exported || null};
      const {merged, report} = mergeRecords(S, theirs);
      const before = JSON.stringify(S);
      const keep = {operator: S.operator, syncId: S.syncId, changes: S.changes, lastExport: S.lastExport, saved: S.saved};
      S = Object.assign(merged, keep);
      if (JSON.stringify(S) !== before) { changed = true; persist(); }
      if (report.clashes.length) clashes = clashes.concat(report.clashes.map(c => (theirs.operator || name) + ': ' + c));
    }
    Object.keys(FOLDER.people).forEach(n => { if (!names.includes(n)) delete FOLDER.people[n]; });
    FOLDER.lastRead = new Date().toISOString();
  } catch (e) { FOLDER.status = 'ask'; folderButton(); syncFooter(); return; }
  if (clashes.length) FOLDER.clashes = (FOLDER.clashes.concat(clashes)).slice(-20);
  if (changed) { folderWrite(); syncRedraw(); }
  folderButton();
}
function folderButton(){
  const b = $('#folderBtn'); if (!b) return;
  if (SYNC.on) { b.hidden = true; return; }                     // the hosted edition has the shared record instead
  b.hidden = false;
  const n = Object.keys(FOLDER.people).length;
  b.textContent = FOLDER.status === 'live' ? '● Shared folder' + (n ? ' · ' + (n + 1) : '') : FOLDER.status === 'ask' ? 'Reconnect shared folder' : 'Shared folder';
  b.title = FOLDER.status === 'live' ? 'Records are kept in the shared folder — everyone syncing it sees them'
          : FOLDER.status === 'ask' ? 'The folder is remembered; click to let this page read it again'
          : 'Keep the records in a folder OneDrive syncs to SharePoint, so the team shares them';
}
function folderDialog(){
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', 'Shared folder');
  const people = Object.entries(FOLDER.people);
  d.innerHTML = `<div class="dh"><div><h2>Shared folder</h2><div class="sub">${FOLDER.status === 'live' ? 'connected' : FOLDER.status === 'ask' ? 'remembered — needs your OK to read it' : 'not connected'}</div></div>
    <button class="close" id="fClose">&times;</button></div>
    <div class="db">
      ${FOLDER.status === 'live' ? `<p class="sub">This page writes its records to <b class="mono">${esc(FOLDER.mine || folderSlug())}</b> in the folder after every change, and reads the others' files every half minute and whenever this window comes to the front. Last read ${FOLDER.lastRead ? esc(fmtStamp(FOLDER.lastRead)) : '—'}.</p>
        <h3 style="margin:12px 0 6px">Files in the folder</h3>
        ${people.length ? `<ul class="tlhist">${people.map(([n, p]) => `<li><span><b>${esc(p.who)}</b> <span class="w" style="color:var(--mute)">${esc(n)}${p.at ? ' · ' + esc(fmtStamp(p.at)) : ''}</span></span></li>`).join('')}</ul>`
          : '<p class="norate">Only this page\'s file so far. When the others open their copy from the same synced folder and connect it, their files appear here.</p>'}
        ${FOLDER.clashes.length ? `<h3 style="margin:12px 0 6px">Disagreements decided</h3><ul style="padding-left:18px;font-size:12.5px;line-height:1.5">${FOLDER.clashes.slice(-8).map(c => '<li>' + esc(c) + '</li>').join('')}</ul>` : ''}
        <p class="norate">How it stays honest: later change wins, a deletion carries, every disagreement is written down above. OneDrive carries the files, so "live" means within a minute or so, and a laptop that is offline catches up when it is back. Names are typed, not signed in.</p>`
      : `<p class="sub">Keep the records in a folder that OneDrive syncs to your SharePoint library. Everyone who opens this page from their synced copy of that folder and connects it shares one picture — no export, no import.</p>
        <ol style="padding-left:18px;font-size:13px;line-height:1.6">
          <li>In SharePoint, open the library this file lives in and press <b>Sync</b> (once per laptop).</li>
          <li>Open this page from the synced folder in Edge or Chrome.</li>
          <li>Press <b>Connect</b> below and pick that folder. Your browser remembers it.</li></ol>
        <p class="norate">${FOLDER.supported ? 'Laptops only — a phone cannot reach a synced folder; it stays on Export and Import.' : 'This browser cannot read a folder. Use Edge or Chrome on a laptop.'}</p>`}
    </div>
    <div class="df">${FOLDER.status === 'live' ? '<button class="btn" id="fRead">Read now</button><button class="btn ghost" id="fOff">Disconnect</button>'
      : FOLDER.status === 'ask' ? '<button class="btn primary" id="fOn">Reconnect</button><button class="btn ghost" id="fPick">Choose another folder</button>'
      : `<button class="btn primary" id="fPick"${FOLDER.supported ? '' : ' disabled'}>Connect a shared folder</button>`}
      <button class="btn" id="fOk">Close</button></div>`;
  mounted(document.body.appendChild(d));
  const shut = () => d.remove();
  $('#fClose', d).onclick = shut; $('#fOk', d).onclick = shut;
  const on = $('#fOn', d); if (on) on.onclick = async () => { shut(); if (FOLDER.dir) await folderStart(FOLDER.dir); };
  const pick = $('#fPick', d); if (pick) pick.onclick = async () => { shut(); await folderConnect(); };
  const rd = $('#fRead', d); if (rd) rd.onclick = async () => { await folderRead(); shut(); flash('Read the shared folder.'); };
  const off = $('#fOff', d); if (off) off.onclick = async () => { shut(); await folderDisconnect(); };
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  $('#fOk', d).focus();
}

/* the classes the print rules read instead of :has() — every card says whether it holds a table or the strip */
function markCards(){
  document.querySelectorAll('.card').forEach(c => { c.classList.toggle('has-table', !!c.querySelector('.tblwrap')); c.classList.toggle('has-race', !!c.querySelector('.pgm')); });
}
window.addEventListener('beforeprint', markCards);
/* the showcase's controls are wired once, against the shell rather than a pane, because the showcase is not
   inside any pane — it opens over all of them and closes back to the one that opened it */
(function wireShowcase(){
  const on = (id, fn) => { const el = $('#' + id); if (el) el.onclick = fn; };
  on('showBack', () => showClose());
  on('showPrev', () => showMove(-1));
  on('showNext', () => showMove(1));
  on('showPause', () => showPause());
  on('showSound', () => showSoundToggle());
  on('machineClose', () => machineClose());
  on('showBroadcast', () => { const b = $('#showBroadcast'); const on = bcToggle();
    if (b) { b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.textContent = bcLabel(on); } });
  on('showFull', async () => { const el = $('#showcase'); if (!el) return;
    try { if (document.fullscreenElement) { await document.exitFullscreen(); }
          else if (el.requestFullscreen) { await el.requestFullscreen(); }
          else { flash('Full screen is not available in this browser — the showcase still runs at this size.'); } }
    catch (e) { flash('Full screen was refused — the showcase still runs at this size.'); } });
  const lp = $('#showLoop'); if (lp) lp.onchange = () => { SHOW.loop = !!lp.checked; showSyncControls(); showSchedule(); };
  const bk = $('#showBackdrop'); if (bk) bk.onchange = () => showSetBack(bk.value);
  let t = null;
  /* v5.64 — the geospatial scene joins the things that are re-measured when the box changes (S3). geoRefit is
     a no-op unless that scene is up, so the older backdrops pay nothing for it. */
  /* EACH ON ITS OWN. These five are independent pieces of work on the same event and they were in one
     unguarded line, so the first one to throw took the rest with it — and the renderer, last but one, was the
     one that lost. A scene stretched out of shape because the footer could not be measured is not a fault
     anybody could find from the picture. The renderer is re-measured AFTER the fit, because the fit is what
     settles the plate's box, and separately from it, because it must not depend on the fit having worked. */
  const step = fn => { try { fn(); } catch (e) { console.warn('showcase refit: ' + (e && e.message || e)); } };
  const refit = () => { if (!SHOW.open) return; clearTimeout(t);
    t = setTimeout(() => { step(showFit); step(fxSize); step(lapsSize); step(geoRefit); step(showDriveDraw); }, 60); };
  window.addEventListener('resize', refit);
  window.addEventListener('orientationchange', refit);
  document.addEventListener('fullscreenchange', refit);
  /* A window that does not change can still hand the plate a different box — full screen on a browser that
     reports no resize, a control row wrapping, a rotation reported late. The observer is the honest signal
     and it is cheap; where it is missing the two events above still carry the common cases. */
  try {
    if (window.ResizeObserver) {
      const plate = $('#showPlate');
      if (plate) new ResizeObserver(refit).observe(plate);
    }
  } catch (e) {}
})();
/* ==================================================================================================
   THE BACKDROP. Andrew Fisher, 17 Sep 2026, with the showcase on the television in the site office: black
   works; more visuals, more animation, more V8 Supercar material in the showcase; the real track, not a
   made-up one; and not the Coates car, which is already shown.

   Everything here is decoration, chosen on the device and kept there (gc500.showback), and the footer says so.
   Nothing is made up by this page and nothing is fetched from anywhere but the page itself and Andrew's own
   service:

     · CIRCUIT — the real one: iEDM's key plan off sheet K220, read from the PDF's vectors at build time
               (pipeline/circuit_keyplan.py) — the Surfers Paradise street circuit with the street grid round it,
               in the sheet's own orientation, the sheet's north drawn in the corner. A point of light laps it.
     · CARBON — a weave with an orange rake, drawn in code, with light streaks on a canvas at the screen's own
               pixel density, so a 4K television gets 4K.
     · FROM THE SERVICE — any clip or picture somebody has put on the Railway service under a name beginning
               "showcase-backdrop-" (the admin page, any kind): the generated V8 clips Andrew picks, or anything
               else he approves. A clip plays muted on a loop with a short dip at the join; a picture drifts. The
               page never carries them, so a phone never downloads one it did not choose, and adding one needs
               no rebuild — the label is the file's title, else its name.

   The Coates 26 — his still and his clip — is on Today, Where we are and the Timeline already and, at his
   word, is not repeated here. One motion setting: Motion: Off, or the device asking for less, stops every one
   of these dead; a hidden tab pauses them; closing the showcase tears them down. None of it writes a byte.
   ================================================================================================== */
/* THE CIRCUIT IN 3D. Andrew Fisher, 17 Sep 2026, sent GC500_3D_Scene_v0.4 (docs/gc3d/): iEDM's key-plan ring
   lifted off the ground, the real buildings, roads, water, beach and parks of Surfers Paradise and Main Beach
   from OpenStreetMap (his two downloads of 17 Sep, sources/osm/), a supercar drawn in light lapping it, and a
   drone camera. It is offered as its own backdrop, 'circuit3d', only when the page carries DATA.surrounds and
   the engine; it mounts on top of the flat circuit when that backdrop is chosen and motion is on, and when
   WebGL2 is missing or the frame rate cannot be held it hands back to the flat circuit (GC3D.failed says why).
   Its credit line — iEDM's key plan, OpenStreetMap contributors (ODbL) — is drawn by the engine on the plate. */
/* v5.43 — two 3D backdrops off one scene. Andrew Fisher chose Day Race as a SECOND choice on 17 Sep 2026, with
   after dark staying the default, so nothing that works today changes and he picks with his own eyes. */
/* v5.65 — ONE DAY, ONE NIGHT, ONE LED. Andrew Fisher, 22 Sep 2026, looking at all six side by side: the day
   circuit in 3D looked great but the graphics could be much better with what he had supplied; the same for the
   after-dark circuit; the LED circuit was good but could be much better; the lit, lit-night and orange circuits
   all missed their marks. Merge them into one day, one night and one LED — a better one from both.

   He is right and the photographs say so. The two families drew the SAME OpenStreetMap buildings through two
   different renderers; the older one puts the real #26 car on grey asphalt with the painted grid, the kerbs,
   the striped barriers, the catch fencing and the grandstands, and the newer one put a car you cannot read on
   a road that came out black. Six choices where three belong, two of everything on a phone, and a reader asked
   to tell apart two Days and two Nights.

   So the list is three, on the renderer that won: day, night, LED. The geospatial engine is NOT deleted — it
   stays in the build and its good ideas come across one at a time, the Coates name on the barrier hoarding
   first — but it is no longer offered, which means a phone allocates one GL context and one set of materials
   instead of two. That is the review's S5 answered outright rather than mitigated.

   A device that remembers one of the six it chose before is MOVED to the matching one of the three, never
   dumped back to the flat drawing: whoever chose a night look keeps a night look. */
/* v5.65b — and Coates orange back as a FOURTH, at his word the same day: yes to Coates orange as the fourth.
   Not the retired renderer's version of it — the same idea rebuilt where the circuit already is, as a look on
   this scene: the whole city drawn as one orange wireframe with the real #26 car driven through it. */
/* v5.86 - the Coates orange, LED and carbon looks are off the list; day and night stay (Andrew Fisher, 25 Sep 2026). A
   choice a device made against the old list is carried to its nearest: the two lit looks to night, carbon to black. */
const SHOW_BACKS = ['black', 'circuit', 'circuit3d_day', 'circuit3d'];
const BACK_MOVED = {geo: 'circuit3d_day', geo_night: 'circuit3d', geo_tron: 'circuit3d', circuit3d_led: 'circuit3d', circuit3d_orange: 'circuit3d', carbon: 'black'};
const is3dBack = v => v === 'circuit3d' || v === 'circuit3d_day' || v === 'circuit3d_led' || v === 'circuit3d_orange';
const back3dLook = v => v === 'circuit3d_day' ? 'day' : v === 'circuit3d_led' ? 'led'
                      : v === 'circuit3d_orange' ? 'orange' : 'dark';
function show3dAvailable(){ return !!(window.GC3D && DATA.surrounds && DATA.circuit && DATA.circuit.ring); }
/* v5.63 — THE GEOSPATIAL BACKDROP. A second engine beside the first, not a replacement: the scene above stays
   exactly as it is and stays the fallback, so a device that cannot run the new one keeps what it had. Two
   looks, the same geometry — a lit, physically based one and the Coates orange TRON one.

   v5.65 — and none of them is offered any more; see the merge above. The engine, its lifecycle, its failure
   note and its controls all stay exactly as they are, because they are what the next idea comes across on and
   because a half-removed renderer is worse than either keeping it or taking it out. Nothing reaches it: no
   value in SHOW_BACKS answers true below, so it is never mounted, never allocates and never appears. */
const isGeoBack = v => v === 'geo' || v === 'geo_night' || v === 'geo_tron';
const geoLook = v => v === 'geo_tron' ? 'tron' : v === 'geo_night' ? 'night' : 'real';
/* Empty string means it can run; anything else is the reason it cannot, in words fit to show somebody. */
function geoWhyNot(){ return (window.GC3D && GC3D.geo) ? GC3D.geo.available() : 'the runtime is not in this build'; }
function geoAvailable(){ return geoWhyNot() === ''; }
const SVC_BACK = /^showcase-backdrop-/i;
const FX = {raf: 0, cv: null, ctx: null, parts: [], w: 0, h: 0, dpr: 1, last: 0};
const CLIP = {v: null, gap: null, asked: false};
function showBackPref(){
  try { let v = localStorage.getItem('gc500.showback');
    /* v5.65 — the six became three, so a choice made against the old list is carried to its equivalent rather
       than quietly ignored: whoever chose a day keeps a day, a night keeps a night, the orange one becomes LED */
    if (BACK_MOVED[v]) v = BACK_MOVED[v];
    if (is3dBack(v) && !show3dAvailable()) return 'circuit';   /* a device that chose 3D on a page without it gets the flat circuit */
    if (SHOW_BACKS.includes(v)) return v;
    if (/^svc:/.test(v || '') && svcBackdrops().some(f => 'svc:' + f.id === v)) return v;
  } catch (e) {}
  return 'black';
}
function showSetBack(v){
  if (BACK_MOVED[v]) v = BACK_MOVED[v];
  const ok = SHOW_BACKS.includes(v) || (/^svc:/.test(v || '') && svcBackdrops().some(f => 'svc:' + f.id === v));
  v = ok ? v : 'black';
  try { localStorage.setItem('gc500.showback', v); } catch (e) {}
  showApplyBack();
}
/* the backdrops on the service: files named showcase-backdrop-…, pictures or clips, by name */
function svcBackdrops(){
  if (!(SYNC.backend && SYNC.backend.fileUrl && SYNC.backend.files) || !DOCS.files) return [];
  return Object.values(DOCS.files).filter(f => SVC_BACK.test(String(f.name || '')) && /\.(mp4|webm|jpe?g|png|webp)$/i.test(String(f.name || '')))
    .map(f => ({id: f.id, name: String(f.name || ''), title: String(f.title || '').trim() || String(f.name || '').replace(SVC_BACK, '').replace(/\.[a-z0-9]+$/i, '').replace(/[-_]+/g, ' ').trim(),
                video: /\.(mp4|webm)$/i.test(String(f.name || '')), url: SYNC.backend.fileUrl(f.id)}))
    .sort((a, b) => a.title.localeCompare(b.title));
}
function showApplyBack(){
  const el = $('#showcase'), plate = $('#showPlate'); if (!el || !plate) return;
  /* the service's list is asked for once per opening, so a clip uploaded today is offered today */
  if (SYNC.backend && SYNC.backend.files && !CLIP.asked && (DOCS.state === 'unrequested' || DOCS.state === 'failed')) {
    CLIP.asked = true; try { docsRefresh(true).then(() => { if (SHOW.open) showApplyBack(); }); } catch (e) {}
  }
  const svc = svcBackdrops();
  const grp = $('#showBackSvc');
  if (grp) { grp.innerHTML = svc.map(f => `<option value="svc:${esc(f.id)}">${esc(f.title)}</option>`).join(''); grp.hidden = !svc.length; }
  ['circuit3d', 'circuit3d_day', 'circuit3d_led', 'circuit3d_orange'].forEach(v => { const o = $('#showBackdrop option[value="' + v + '"]'); if (o) o.hidden = !show3dAvailable(); });
  const v = showBackPref();
  const was = plate.dataset.built;
  el.setAttribute('data-back', /^svc:/.test(v) ? 'svc' : v);
  const sel = $('#showBackdrop'); if (sel) sel.value = v;
  if (was === v) { showPlateMotion(); return; }
  /* v5.64 — DAY, NIGHT AND COATES ORANGE ARE ONE SCENE WEARING THREE LOOKS. GC500 Showcase Review, 22 Sep
     2026, S5: "retain the renderer when changing only its appearance; use its theme transition."

     Changing between them used to empty the plate, which threw away the canvas the scene was mounted on, which
     forced a full teardown and remount: a new GL context, the tile tree read again, the shadow map allocated
     again, and every material generated again from scratch — ten sets of six RGBA8 maps, tens of megabytes of
     plain arrays, synchronously, in the frame the reader had just clicked in. All of it to arrive at the
     identical scene with a different sun.

     The three put exactly the same things on the plate — the flat circuit drawing and one canvas — so there is
     nothing to rebuild. The plate is left alone, the canvas survives, and geoSync finds its scene still
     mounted on it and calls the runtime's own theme transition instead. Same GL context, same tiles, same
     materials, one changed look.

     The three older 3D backdrops are deliberately NOT included: that engine remounts on a look change on
     purpose, for the reason written above show3dSyncInner, and that is its own decision to revisit. */
  if (isGeoBack(was) && isGeoBack(v)) { plate.dataset.built = v; showPlateMotion(); return; }
  plate.dataset.built = v;
  showPlateBuild(v, svc.find(f => 'svc:' + f.id === v) || null);
}
/* what sits on the plate for each backdrop — built when it is chosen, torn down when it changes */
function showPlateBuild(v, svcFile){
  const plate = $('#showPlate'); if (!plate) return;
  showPlateStop();
  plate.innerHTML = '';
  if (v === 'black') return;
  if (v === 'circuit' || is3dBack(v) || isGeoBack(v)) plate.insertAdjacentHTML('beforeend', showCircuitSvg());   /* 3D mounts over the flat circuit, which stays as its fallback */
  if (isGeoBack(v)) {
    /* the geospatial scene draws into its own canvas over that drawing; if it never starts, the drawing is
       what stays on the plate, which is the same fallback the other scene has always had */
    const cv = document.createElement('canvas');
    cv.className = 'gc3dgeo'; cv.setAttribute('aria-hidden', 'true');
    /* z-index 2, with the other canvases and UNDER the plate's scrim at 3. It mounted at 4 to begin with,
       which put the whole city over the type that scrim exists to protect — the reason the first shots had the
       figures fighting the skyline. */
    cv.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;display:block;z-index:2';
    plate.appendChild(cv);
  }
  if (is3dBack(v) && window.GC3D) GC3D.failed = null;                                                  /* chosen afresh: try again */
  if (v === 'carbon' || v === 'circuit') plate.insertAdjacentHTML('beforeend', '<i class="shglide"></i>');
  if (v === 'carbon') plate.insertAdjacentHTML('beforeend', '<canvas class="shfx"></canvas>');
  if (svcFile) { if (svcFile.video) showClipBuild(plate, svcFile); else { const im = document.createElement('img'); im.className = 'shpic'; im.alt = ''; im.decoding = 'async'; im.src = svcFile.url; plate.appendChild(im); } }
  showPlateMotion();
}
/* ---- the circuit, as drawn: DATA.circuit is the K220 key plan off the PDF; the page only scales it */
function showCircuitSvg(){
  const C = DATA.circuit; if (!C || !C.ring) return '';
  const [bx0, by0, bx1, by1] = C.ring.box;
  const pad = Math.max(bx1 - bx0, by1 - by0) * 0.22;
  const vx = bx0 - pad, vy = by0 - pad, vw = (bx1 - bx0) + pad * 2, vh = (by1 - by0) + pad * 2;
  const P = pts => pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(2) + ' ' + p[1].toFixed(2)).join('') + 'Z';
  const streets = (C.streets || []).map(sg => 'M' + sg[0] + ' ' + sg[1] + 'L' + sg[2] + ' ' + sg[3]).join('');
  const outer = P(C.ring.outer), inner = P(C.ring.inner);
  /* the sheet's north, from the drawings themselves (pipeline/site_orientation.py); no arrow if it is not known */
  const O = DATA.orientation || {}, deg = typeof O.north_deg_clockwise_from_sheet_top === 'number' ? O.north_deg_clockwise_from_sheet_top : null;
  const nx = vx + vw - pad * 0.55, ny = vy + pad * 0.6, r = pad * 0.22;
  const rad = deg == null ? 0 : deg * Math.PI / 180, tipX = nx + Math.sin(rad) * (r + 3.2), tipY = ny - Math.cos(rad) * (r + 3.2);
  const north = deg == null ? '' : `<g class="north"><g transform="translate(${nx.toFixed(2)} ${ny.toFixed(2)}) rotate(${deg.toFixed(2)})">
      <path d="M0 ${(-r).toFixed(2)} L${(r * 0.38).toFixed(2)} ${(r * 0.55).toFixed(2)} L0 ${(r * 0.25).toFixed(2)} L${(-r * 0.38).toFixed(2)} ${(r * 0.55).toFixed(2)} Z"/></g>
      <text x="${tipX.toFixed(2)}" y="${(tipY + 1.6).toFixed(2)}" text-anchor="middle">N</text></g>`;
  const vb = `${vx.toFixed(2)} ${vy.toFixed(2)} ${vw.toFixed(2)} ${vh.toFixed(2)}`;
  return `<svg class="shcircuit" viewBox="${vb}" preserveAspectRatio="xMaxYMid meet" aria-hidden="true">
    <defs><linearGradient id="shroad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#46545a"/><stop offset="1" stop-color="#2f3a3d"/></linearGradient></defs>
    <path class="streets" d="${streets}"/>
    <path class="road" d="${outer}${inner}"/>
    <path class="edge" d="${outer}"/><path class="edge in" d="${inner}"/>
    ${north}
    <text class="note" x="${(vx + pad * 0.3).toFixed(2)}" y="${(vy + vh - pad * 0.3).toFixed(2)}">${esc((C.source && C.source.sheet) || 'K220')} key plan, as drawn by iEDM · not to scale</text>
  </svg>
  <svg class="shhalo" viewBox="${vb}" preserveAspectRatio="xMaxYMid meet" aria-hidden="true">
    <defs><filter id="shbloom" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="5"/></filter></defs>
    <path class="halo" d="${outer}"/>
  </svg>
  <canvas class="shlaps" data-vb="${vb}"></canvas>`;
}
/* ---- the lights that lap the ring: drawn on a canvas at the screen's pixel density, the only thing that moves
   each frame. The ring is the outer edge from DATA.circuit, sampled along its length; the canvas maps the SVG's
   viewBox to its own pixels the same way the SVG does (xMaxYMid meet), so the light sits on the drawn line. */
const LAPS = {raf: 0, cv: null, ctx: null, pts: [], cum: [], L: 0, map: null, t0: 0, observer: null, sizeKey: '', distance: 0, last: null};
function lapsStart(cv){
  const C = DATA.circuit; if (!C || !C.ring || !cv) return;
  if (LAPS.observer) LAPS.observer.disconnect();
  if (LAPS.cv !== cv) LAPS.distance = 0;
  LAPS.cv = cv; LAPS.ctx = cv.getContext('2d'); LAPS.last = null; LAPS.sizeKey = '';
  const pts = C.ring.outer.concat([C.ring.outer[0]]);
  const cum = [0]; for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  LAPS.pts = pts; LAPS.cum = cum; LAPS.L = cum[cum.length - 1];
  lapsSize(); LAPS.t0 = performance.now();
  /* Footer controls and fonts can resize the flex stage without a window resize. The SVG responds
     immediately; the canvas mapping must follow that same box rather than its previous aspect ratio. */
  if (typeof ResizeObserver !== 'undefined') {
    LAPS.observer = new ResizeObserver(() => { if (LAPS.cv === cv) lapsSize(); }); LAPS.observer.observe(cv);
  }
  cancelAnimationFrame(LAPS.raf); LAPS.raf = requestAnimationFrame(lapsFrame);
}
function lapsSize(){
  const cv = LAPS.cv; if (!cv) return;
  const r = cv.getBoundingClientRect(), dpr = Math.min(window.devicePixelRatio || 1, 2);
  const key = [r.width, r.height, dpr, cv.dataset.vb].join('|');
  if (LAPS.sizeKey === key) return;
  LAPS.sizeKey = key;
  cv.width = Math.max(1, Math.round(r.width * dpr)); cv.height = Math.max(1, Math.round(r.height * dpr)); LAPS.dirty = [];
  const [vx, vy, vw, vh] = (cv.dataset.vb || '0 0 1 1').split(' ').map(Number);
  const sc = Math.min(cv.width / vw, cv.height / vh);             /* meet */
  const ox = cv.width - vw * sc, oy = (cv.height - vh * sc) / 2;   /* xMax, YMid */
  LAPS.map = {sc, ox, oy, vx, vy, dpr};
}
function lapsPoint(s){
  const {pts, cum, L} = LAPS; s = ((s % L) + L) % L;
  let i = 1; while (i < cum.length - 1 && cum[i] < s) i++;
  const a = pts[i - 1], b = pts[i], f = (s - cum[i - 1]) / Math.max(1e-6, cum[i] - cum[i - 1]);
  const m = LAPS.map;
  return [(a[0] + (b[0] - a[0]) * f - m.vx) * m.sc + m.ox, (a[1] + (b[1] - a[1]) * f - m.vy) * m.sc + m.oy];
}
function lapsAdvance(t){
  const dt = LAPS.last == null ? 0 : Math.max(0, Math.min(.1, (t - LAPS.last) / 1000));
  LAPS.last = t;
  LAPS.distance = (LAPS.distance + dt * LAPS.L / 8 * showPaceGet()) % Math.max(1, LAPS.L);
  return LAPS.distance;
}
function lapsFrame(t){
  /* RE-ARM FIRST, for the same reason as fxFrame: one frame without a map or a context is a frame to skip,
     not the end of the lap lights. */
  LAPS.raf = requestAnimationFrame(window.lapsFrame || lapsFrame);
  const g = LAPS.ctx, cv = LAPS.cv, m = LAPS.map; if (!g || !cv || !m) return;
  /* only what the last frame painted is cleared — a 4K canvas wiped edge to edge every frame is the expensive
     part of the whole plate, and the lights cover a corner of it */
  g.globalCompositeOperation = 'source-over';
  (LAPS.dirty || []).forEach(d => g.clearRect(d[0], d[1], d[2], d[3]));
  g.globalCompositeOperation = 'lighter'; g.lineCap = 'round';
  const u = m.sc;                                              /* one SVG unit in canvas pixels */
  const s0 = lapsAdvance(t);                                 /* 8-second lap at 1x, continuous across pace changes */
  const comets = [{s: s0, tail: 260, w: 3.2, core: '255,248,238', glow: '255,140,60', outer: '255,106,19'},
                  {s: s0 + LAPS.L / 2, tail: 150, w: 2.4, core: '236,246,255', glow: '160,210,255', outer: '120,180,255'}];
  const dirty = [];
  comets.forEach(c => {
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    const grow = pt => { if (pt[0] < x0) x0 = pt[0]; if (pt[0] > x1) x1 = pt[0]; if (pt[1] < y0) y0 = pt[1]; if (pt[1] > y1) y1 = pt[1]; };
    /* the tail is a few continuous strokes laid over each other, each shorter and brighter than the last, so it
       tapers smoothly — one stroke per segment with round caps beads up where the caps overlap */
    const J = 7, N = 28;
    const trail = (len, width, colour, alpha) => {
      g.strokeStyle = 'rgba(' + colour + ',' + alpha.toFixed(3) + ')'; g.lineWidth = width; g.lineJoin = 'round';
      g.beginPath();
      for (let i = 0; i <= N; i++) { const pt = lapsPoint(c.s - len + len * i / N); grow(pt); if (i) g.lineTo(pt[0], pt[1]); else g.moveTo(pt[0], pt[1]); }
      g.stroke();
    };
    for (let j = 0; j < J; j++) {
      const f = j / (J - 1);                                  /* 0 = the long faint end, 1 = the bright head */
      const len = c.tail * (1 - 0.85 * f);
      trail(len, (c.w * (3.4 - 2.2 * f) + 1.5) * u, c.outer, 0.035 + 0.05 * f);
      trail(len, (c.w * (1.4 - 0.9 * f) + 0.4) * u, c.glow, 0.08 + 0.11 * f);
    }
    const h = lapsPoint(c.s), R = c.w * 2.4 * u;
    const rg = g.createRadialGradient(h[0], h[1], 0, h[0], h[1], R);
    rg.addColorStop(0, 'rgba(' + c.core + ',1)'); rg.addColorStop(0.35, 'rgba(' + c.glow + ',.7)'); rg.addColorStop(1, 'rgba(' + c.outer + ',0)');
    g.fillStyle = rg; g.beginPath(); g.arc(h[0], h[1], R, 0, 6.2832); g.fill();
    grow([h[0] - R, h[1] - R]); grow([h[0] + R, h[1] + R]);
    const padPx = c.w * 3.5 * u + 4;
    dirty.push([Math.floor(x0 - padPx), Math.floor(y0 - padPx), Math.ceil(x1 - x0 + 2 * padPx), Math.ceil(y1 - y0 + 2 * padPx)]);
  });
  LAPS.dirty = dirty;
  /* the next frame was asked for at the top of this one — asking again here would run two loops */
}
function lapsStop(){
  cancelAnimationFrame(LAPS.raf); LAPS.raf = 0; LAPS.last = null;
  if (LAPS.observer) LAPS.observer.disconnect(); LAPS.observer = null;
  /* v5.62 held the lights here so a Pause would freeze them mid-lap rather than wipe them, which is the right
     feel for Pause. The lap ring is decoration, though, so Pause no longer stops it at all — this is now
     reached only by Motion: Off, a hidden tab, or the showcase closing. Motion: Off is an accessibility
     setting: it should leave nothing half-drawn behind, so the canvas is cleared, as it always was. */
  LAPS.dirty = [];
  if (LAPS.ctx && LAPS.cv) { LAPS.ctx.globalCompositeOperation = 'source-over'; LAPS.ctx.clearRect(0, 0, LAPS.cv.width, LAPS.cv.height); }
}
/* the lap needs the ring's length in the SVG's own units, which only the browser knows */
function showLapSize(){
  const plate = $('#showPlate'); if (!plate) return;
  plate.querySelectorAll('.shcircuit .edge').forEach(el => { try { el.style.setProperty('--lap', el.getTotalLength().toFixed(1) + 'px'); } catch (e) {} });
}
/* ---- the light streaks: a canvas at the screen's own pixel density, thin lines of warm light drifting across */
function fxStart(cv){
  FX.cv = cv; FX.ctx = cv.getContext('2d'); fxSize(); FX.parts = [];
  for (let i = 0; i < 34; i++) FX.parts.push(fxNew(true));
  FX.last = performance.now(); cancelAnimationFrame(FX.raf); FX.raf = requestAnimationFrame(fxFrame);
}
function fxSize(){
  if (!FX.cv) return;
  const r = FX.cv.getBoundingClientRect();
  FX.dpr = Math.min(window.devicePixelRatio || 1, 2);
  FX.w = Math.max(1, Math.round(r.width * FX.dpr)); FX.h = Math.max(1, Math.round(r.height * FX.dpr));
  FX.cv.width = FX.w; FX.cv.height = FX.h;
}
function fxNew(anywhere){
  const len = (140 + Math.random() * 560) * FX.dpr;
  return {x: anywhere ? Math.random() * (FX.w + len) : -Math.random() * FX.w * 0.5 - len, y: Math.random() * FX.h, len,
          v: (0.10 + Math.random() * 0.34) * FX.dpr, a: 0.12 + Math.random() * 0.26, warm: Math.random() < 0.55, th: (0.9 + Math.random() * 1.8) * FX.dpr};
}
function fxFrame(t){
  /* RE-ARM FIRST. A frame that cannot draw is a reason to skip a frame, not to end the loop — and returning
     here without asking for another one killed the streaks permanently the first time the context was missing
     for a single frame, which a canvas being resized or re-created is enough to cause. */
  FX.raf = requestAnimationFrame(fxFrame);
  const dt = Math.min(50, t - FX.last); FX.last = t;
  const g = FX.ctx; if (!g) return;
  g.clearRect(0, 0, FX.w, FX.h); g.globalCompositeOperation = 'lighter'; g.lineCap = 'round';
  FX.parts.forEach(p => {
    p.x += p.v * dt;
    if (p.x - p.len > FX.w) Object.assign(p, fxNew(false));
    const grad = g.createLinearGradient(p.x - p.len, 0, p.x, 0), c = p.warm ? '255,140,60' : '255,236,210';
    grad.addColorStop(0, 'rgba(' + c + ',0)'); grad.addColorStop(0.82, 'rgba(' + c + ',' + p.a.toFixed(3) + ')'); grad.addColorStop(1, 'rgba(' + c + ',0)');
    g.strokeStyle = grad; g.lineWidth = p.th; g.beginPath(); g.moveTo(p.x - p.len, p.y); g.lineTo(p.x, p.y); g.stroke();
  });
}
function fxStop(){ cancelAnimationFrame(FX.raf); FX.raf = 0; if (FX.ctx) FX.ctx.clearRect(0, 0, FX.w, FX.h); }
/* ---- a clip from the service: muted, looping, a short dip to dark at the join so the cut is never seen */
function showClipBuild(plate, f){
  const v = document.createElement('video');
  v.muted = true; v.defaultMuted = true; v.playsInline = true; v.setAttribute('playsinline', ''); v.preload = 'auto'; v.loop = true;
  v.setAttribute('aria-hidden', 'true'); v.dataset.file = f.id; v.src = f.url;
  v.addEventListener('timeupdate', () => {
    if (!v.duration || !isFinite(v.duration)) return;
    const left = v.duration - v.currentTime;
    if (left < 0.75 && v.classList.contains('on')) v.classList.remove('on');
    else if (left >= 0.75 && v.currentTime > 0.05 && !v.paused && !v.classList.contains('on')) v.classList.add('on');
  });
  plate.appendChild(v); CLIP.v = v;
}
function showClipPlay(){
  const v = CLIP.v; if (!v) return;
  v.play().then(() => v.classList.add('on')).catch(() => { /* a browser that will not start it leaves the plate dark — nothing else to do */ });
}
function showClipPause(){ const v = CLIP.v; if (!v) return; try { v.pause(); } catch (e) {} }
/* start or stop whatever moves on the plate, by the one motion setting and whether anybody can see it */
function showPlateMotion(){
  const plate = $('#showPlate'); if (!plate) return;
  /* TWO RULES, NOT ONE, BECAUSE THE PLATE HOLDS TWO DIFFERENT THINGS.
     Andrew Fisher asked that Pause stop the car, the video and the sound together, and it does — those are the show.
     The backdrop behind them is decoration: the lap ring on the circuit plate and the streaks on carbon. The
     rule for decoration was already written down, in the comment above showMotionChanged's last lines —
     "the backdrop, being decoration and not the show, does move again". Folding `!SHOW.playing` into one
     condition for both broke exactly that: turning Motion off sets playing false, so turning it back on left
     the backdrop dead, and a tab you came back to sat frozen. So the show honours Pause and the decoration
     honours motion, visibility and whether the showcase is open — which is what each was always meant to do. */
  const stillDecor = motionOff() || document.hidden || !SHOW.open;
  const still = stillDecor || !SHOW.playing;
  const cv = plate.querySelector('canvas.shfx');
  if (cv) { if (stillDecor) fxStop(); else if (!FX.raf || FX.cv !== cv) fxStart(cv); }
  const lc = plate.querySelector('canvas.shlaps');
  if (lc) { if (stillDecor) lapsStop(); else if (!LAPS.raf || LAPS.cv !== lc) lapsStart(lc); }
  /* the backdrop clip is chosen from the Backdrop list beside carbon and the circuit — wallpaper, and it
     follows the decoration rule with them. The video Pause stops is the one in the show itself. */
  if (CLIP.v) { if (stillDecor) showClipPause(); else if (CLIP.v.paused) showClipPlay(); }
  showLapSize();
  show3dSync(still);
  showViewSync();          /* v5.43 — the View chooser follows the backdrop */
  showSoundSync(still);
  { const bb = $('#showBroadcast');
    if (bb) { const offer = SHOW.open && bcTurns().length > 0 && !motionOff();
      bb.hidden = !offer;
      bb.title = !bcHave()
        ? 'The commentary — the takes are not in this build yet, so the scenes run to the programme\u2019s own timing in silence'
        : bcStandins() === 0
          ? 'The commentary — two voices over the scenes, on this device only'
          : 'The commentary over the scenes, on this device only — some turns read by a STAND-IN voice, not the takes';
      bb.setAttribute('aria-pressed', BC.on ? 'true' : 'false');
      bb.textContent = bcLabel(BC.on); } }
  lapsSize();               /* controls above can change the footer height after lapsStart measured it */
}

/* the 3D circuit: mounted the first time its backdrop runs, held while the show is still, torn down with the
   plate. The engine takes over the lap lights' frame loop (lapsFrame) and hands it back on unmount. */
function show3dSync(still){
  /* v5.63 — the note is refreshed on EVERY exit, including the early returns, so the flat circuit is never
     left sitting there with no explanation for why it is what you are looking at. */
  try { return show3dSyncInner(still); } finally { show3dNote(); }
}
/* v5.63 — WHY THE 3D WENT, SOMEWHERE IT CAN STILL BE READ, AND A WAY BACK.
   The quality caption lived inside .gc3d-ui. unmount() removes .gc3d-ui along with the canvas, so at the
   exact moment the scene had something to explain, it took the explanation away with it: the person was
   left with a flat circuit, no reason and no way back short of reloading the page. This sits with the
   controls — outside #showPlate (emptied on every backdrop rebuild) and outside .gc3d-ui (removed on
   unmount) — so it survives both.
   The retry is DELIBERATE and never automatic. A device that could not hold the scene will not hold it
   because the page asked again by itself; it will just fail again, more expensively, and on a phone that
   costs battery and data. So the page offers the choice and the person makes it. */
/* 22 Sep 2026, from the live review, and it is the worst kind of fault: a SILENT one. On a browser with no
   WebGL2 the older 3D backdrops said so — "3D paused — this browser cannot run the 3D scene" with a button to
   try again — and the Coates orange one said nothing at all. It left the flat drawing on the plate with the
   reason in the console where nobody looks, so a person could choose the new showcase, be shown the old flat
   circuit, and have no way of knowing they were not looking at what they asked for.

   One note, both renderers. Whichever one the chosen backdrop belongs to is the one asked whether it failed
   and why, and the retry clears that renderer's failure rather than the other one's. */
function showFailure(){
  const back = $('#showcase') && $('#showcase').getAttribute('data-back');
  const G = window.GC3D; if (!G) return null;
  if (isGeoBack(back)) {
    if (G.geo && G.geo.S) return null;                 /* running: nothing to explain */
    const why = (G.geo && G.geo.failed) || geoWhyNot();
    return why ? {which: 'geo', why: String(why)} : null;
  }
  if (is3dBack(back) && G.failed && !G.S) return {which: '3d', why: String(G.failed)};
  return null;
}
function show3dNote(){
  const n = $('#show3dNote'); if (!n) return;
  const f = showFailure();
  n.hidden = !f;
  if (!f) { n.innerHTML = ''; return; }
  const raw = f.why;
  const why = /frame rate/.test(raw) ? 'this device could not keep up'
            : /webgl2/i.test(raw)    ? 'this browser cannot run the 3D scene'
            : /graphics context was lost/i.test(raw) ? 'the graphics context was lost'
            : raw;
  n.innerHTML = '<span>' + (f.which === 'geo' ? 'This backdrop is not running' : '3D paused') + ' \u2014 ' + esc(why)
              + '. What you are looking at is the flat circuit drawing, not the 3D scene.</span>'
              + '<button type="button" class="shbtn" id="show3dRetry">Try again</button>';
  const b = n.querySelector('#show3dRetry');
  if (b) b.addEventListener('click', show3dRetry);
}
function show3dRetry(){
  if (!window.GC3D) return;
  const f = showFailure();
  const b = $('#show3dRetry'); if (b) { b.disabled = true; b.textContent = 'Starting\u2026'; }
  /* release anything the last attempt left before asking for another one — one scene, one loop. The retry is
     DELIBERATE and happens once: a device that could not hold the scene will not hold it because the page
     asked again by itself, and on a phone that costs battery for nothing. */
  if (f && f.which === 'geo') {
    if (GC3D.geo) { try { GC3D.geo.unmount(); } catch (e) {} GC3D.geo.failed = null; }
  } else {
    if (GC3D.S && GC3D.S.unmount) { try { GC3D.S.unmount(true); } catch (e) {} }
    GC3D.failed = null;
  }
  GC3D.retries = (GC3D.retries || 0) + 1;
  show3dSync(!SHOW.playing);
}
/* THE PAGE'S HALF OF THE CONTEXT RECOVERY. The scene tells the page the browser has given the context back;
   the page decides what to do about it, which is: come back, quietly, if the showcase is still open on a
   backdrop that wants it. It does NOT retry a scene that failed for any other reason — that stays a
   deliberate choice, for the reasons in show3dRetry above. */
let GEO_WIRED = false;
function geoWireRecovery(){
  if (GEO_WIRED || !window.GC3D || !GC3D.geo) return;
  GEO_WIRED = true;
  GC3D.geo.onRestored = () => {
    const back = $('#showcase') && $('#showcase').getAttribute('data-back');
    if (!SHOW.open || !isGeoBack(back)) { show3dNote(); return; }
    flash('The graphics context came back \u2014 restarting the circuit.');
    show3dSync(!SHOW.playing);
    show3dNote();
  };
}
function show3dSyncInner(still){
  geoWireRecovery();
  const back = $('#showcase') && $('#showcase').getAttribute('data-back');
  /* ONE RENDERER AND ONE CONTEXT. Whichever engine is not wanted is stopped before the other is asked to
     start, so the two can never hold a GL context at the same time on a phone that has one to spare. */
  const wantGeo = isGeoBack(back) && geoAvailable();
  if (!wantGeo) geoStop(); else show3dStop();
  if (wantGeo) { geoSync(back, still); return; }
  const want = is3dBack(back) && show3dAvailable();
  if (!want) { show3dStop(); return; }
  /* v5.43 — the same scene, a different look. Switching between the two backdrops re-mounts it rather than
     re-tinting in place: the two are separate choices in the list, and a remount is a clean, testable state. */
  /* v5.48 — the scene calls its night look 'showcase'; this list calls it 'dark'. They are the same look, so
     they must compare equal — otherwise every motion change and every plate rebuild decided the look had changed
     and tore down a 174,446-triangle scene to build the identical one again. That is what Motion: Off was doing:
     not holding the frame, but unmounting the whole thing. Caught by a check that expected the frame to be held. */
  const lookNow = GC3D.S && GC3D.S.look ? (GC3D.S.look.name === 'showcase' ? 'dark' : GC3D.S.look.name) : null;
  if (lookNow && lookNow !== back3dLook(back)) { show3dStop(); GC3D.failed = null; }
  if (GC3D.S) { GC3D.S.paused = !!still; if (still) GC3D.S.last = null; }
  /* Pause holds time, not the backdrop chooser. A new look must mount and paint its first still frame;
     otherwise choosing Day or Night while paused leaves only the flat fallback until Resume. Hidden,
     closed and reduced-motion shows still avoid allocating a new 3D scene. */
  if (!GC3D.S) {
    if (GC3D.failed || motionOff() || document.hidden || !SHOW.open) return;
    let r = '';
    try { r = GC3D.mount(DATA.surrounds, back3dLook(back)); } catch (e) { r = String(e && e.message || e); }
    if (!/^mounted/.test(r)) { GC3D.failed = r; console.warn('3D circuit backdrop: ' + r + ' — the flat circuit stays'); return; }
    GC3D.S.paused = !!still;
    GC3D.S.last = null;
    GC3D.S.needsRender = true;
    if (GC3D.setView) GC3D.setView(showViewGet());
    showDriveApply();
  }
  if (!still && GC3D.sound && GC3D.sound.remembered() && !GC3D.sound.isOn() && SHOW.gesture) GC3D.sound.on();
}
/* ---- THE SHOWCASE PICKS ITSELF UP -----------------------------------------------------------------------
   Andrew Fisher, 22 Sep 2026, on the live service: it had bugs and stopped every now and then.

   v5.70 fixed the reason it stopped. Every animation loop in this page now asks the browser for its next
   frame BEFORE anything that can return, so a frame that goes wrong costs a frame instead of the showcase.
   That is the fix, and it is tested.

   This is the belt to go with those braces, because a browser animation loop has one property nothing in a
   page can change: if the chain is ever broken it does not start itself again, and there is nothing on
   screen to say so. A throw in a place nobody predicted, a dropped callback, an extension, a frame delivered
   to a scene torn down mid-callback — any of them and the picture is simply still. So something OUTSIDE the
   loop watches the frame counter, and when the picture ought to be moving and has not moved for twelve
   seconds, it hands the loop back.

   It is deliberately dumb and deliberately cheap. One look every four seconds. The repair is the same two
   lines show3dSync already uses — cancel the frame that is pending, ask for one — and cancelling first is
   what keeps it to a single chain, so a wrong guess costs nothing and cannot compound into two loops running.
   It never re-mounts the scene, never changes quality and never clears a failure: those are decisions, and
   this is not making decisions. Every reason for the picture to be still ON PURPOSE — paused, hidden tab,
   Motion off, reduced motion, a lost context, the showcase closed — is checked first.

   AND IT COUNTS OUT LOUD. A thing that heals itself silently hides the fault it is healing. GC3D.S.revived
   carries how many times and when, the console says so each time, and the rendering report prints it. If
   that number is ever above nought on a real machine, that is a bug to come back to — not a thing that is
   fine now because the picture is moving again.
   ---------------------------------------------------------------------------------------------------------- */
const WATCH = {timer: 0};
const WATCH_EVERY = 4000;     /* how often to look */
const WATCH_FLOOR = 12000;    /* the shortest silence that can ever count as a fault */
const WATCH_ROOF  = 120000;   /* and the longest, so a single monstrous frame cannot disarm it for ever */
const WATCH_WARM  = 12;       /* callbacks the loop must have reported before its own pace is trusted */
function showWatchdogStop(){ if (WATCH.timer) clearInterval(WATCH.timer); WATCH.timer = 0; }
function showWatchdogStart(){ showWatchdogStop(); WATCH.timer = setInterval(showWatchdogTick, WATCH_EVERY); }
function showWatchdogTick(){
  const S = window.GC3D && GC3D.S;
  /* every reason the picture is allowed to be still */
  if (!SHOW.open || !S || S.paused || S.lost || document.hidden || SHOW.reduced || motionOff()) return;
  if (S.beatAt == null) return;                      /* the loop has not reported in once yet */
  const now = (window.performance && performance.now) ? performance.now() : Date.now();
  /* MEASURED AGAINST WHAT THIS MACHINE MANAGES, not against a number picked on a fast one. The first
     attempt at this fired after a flat twelve seconds and cried wolf three times in two minutes on a
     software rasteriser taking fifteen seconds a frame — which would have made every revival it reported
     worthless. The bar is now six times the worst gap the loop has ever had between two live callbacks,
     with a floor so it still means something on a fast machine and a roof so one monstrous frame cannot
     switch it off for good. */
  /* AND IT DOES NOT JUDGE A SCENE IT HAS NOT WATCHED YET. beatWorst starts at nought, so for the first few
     callbacks the bar would be the floor — and the first few callbacks are the slowest there are, because
     that is when the scene is compiling shaders and uploading a 174,446-triangle car. Measured on a software
     rasteriser: two false revivals inside the first forty-five seconds and none at all afterwards. Until the
     loop has reported in enough times to have calibrated, the bar is the roof. */
  const bar = (S.beatN || 0) < WATCH_WARM
    ? WATCH_ROOF
    : Math.max(WATCH_FLOOR, Math.min(WATCH_ROOF, 6 * (S.beatWorst || 0)));
  const quiet = now - S.beatAt;
  if (quiet < bar) return;
  try {
    if (LAPS.cv) { cancelAnimationFrame(LAPS.raf); LAPS.raf = requestAnimationFrame(window.lapsFrame); }
    S.revived = (S.revived || 0) + 1;
    S.revivedAt = new Date().toISOString();
    S.revivedAfterMs = Math.round(quiet);
    S.beatAt = now;                                  /* the restart gets its own chance before it is judged again */
    console.warn('The showcase had not asked for a frame in ' + (quiet / 1000).toFixed(1) + 's (the bar on this '
               + 'machine is ' + (bar / 1000).toFixed(1) + 's); the loop was handed back (' + S.revived + ').');
  } catch (e) {}
}
function show3dStop(){ if (window.GC3D && GC3D.S && GC3D.S.unmount) { try { GC3D.S.unmount(true); } catch (e) {} } }
function geoStop(){ if (window.GC3D && GC3D.geo && GC3D.geo.S) { try { GC3D.geo.unmount(); } catch (e) {} } }
/* The geospatial scene's whole lifecycle, on the page's terms rather than the runtime's.

   NOTHING IS BUILT UNTIL THE SHOWCASE IS OPEN. Today allocates no context, reads no pack and builds no tile —
   the same rule the other scene keeps, and the reason a phone that never opens the Showcase pays nothing for
   it. Hidden tab, closed showcase and Motion: Off hold the picture rather than tear the scene down, because a
   teardown of a scene this size to rebuild the identical one is what Motion: Off used to do by accident.

   A refusal is a sentence, not a crash. WebGL2 or float colour buffers missing, a lost context, a pack that no
   longer matches the registration: each says so once in the console and leaves the flat circuit drawing on the
   plate, which is exactly what the reader had before. */
function geoSync(back, still){
  const G = window.GC3D && GC3D.geo; if (!G) return;
  const look = geoLook(back);
  const cv0 = $('#showPlate .gc3dgeo');
  /* THE SCENE IS TIED TO THE CANVAS IT WAS MOUNTED ON.

     Changing backdrop rebuilds the plate, which throws that canvas away and makes a new one — and at the
     moment this runs, the old scene is still mounted on the old canvas. Left alone, it was told to change its
     look, said yes, and only afterwards did its own frame loop notice the canvas had gone and tear itself
     down; by then nothing was left to start the new one. While the deck was playing something came round and
     asked again, so it recovered and the fault looked like a flicker. While the deck was PAUSED nothing came
     round at all, and the plate simply stayed empty until somebody pressed something.

     So the check belongs here, before anything else: a scene whose canvas is no longer the plate's is finished
     with, and the new one starts in the same breath. */
  if (G.S && (G.S.canvas !== cv0 || !G.S.canvas.isConnected)) { try { G.unmount(); } catch (e) {} }
  if (G.S && G.S.look !== look) G.setLook(look);
  if (G.S) {
    G.setPlaying(!still);
    G.setSuspended(!!document.hidden || !SHOW.open);
    G.setReducedMotion(motionOff());
    G.setPace(showPaceGet());
    return;
  }
  if (G.failed || document.hidden || !SHOW.open) return;
  const cv = $('#showPlate .gc3dgeo'); if (!cv) return;
  geoResize(cv);
  let r = '';
  try { r = G.mount(cv, look); } catch (e) { r = String(e && e.message || e); }
  if (r !== 'mounted') {
    G.failed = r;
    console.warn('geospatial circuit backdrop: ' + r + ' — the flat circuit stays');
    return;
  }
  G.setPlaying(!still);
  G.setReducedMotion(motionOff());
  G.setPace(showPaceGet());
}
/* The canvas is sized in device pixels, capped, because a phone at 3x on a wide plate asks for more pixels
   than it can shade and the first thing anybody notices is the frame rate, not the sharpness.

   v5.64 — ONE SCALE, NOT TWO CAPS. GC500 Showcase Review, 22 Sep 2026, S3: "Preserve aspect ratio when
   applying pixel limits; avoid independent width/height caps distorting the result."

   The width and the height used to be clamped separately. On any box wider than 16:10 that quietly changed
   the SHAPE of the drawing buffer — a 3,000 x 900 plate on a 2x screen asked for 6,000 x 1,800, got 2,560 x
   1,600, and the camera, which takes its aspect from those two numbers, then drew a 1.6:1 picture into a
   3.33:1 box. The car came out fat. A television in the site office is exactly that shape.

   So there is one budget and one scale factor now: the longest edge, the tallest edge and the total number of
   pixels each give a limit, the smallest of the three wins, and BOTH edges are multiplied by it. The shape of
   the buffer is the shape of the box at every size, and the pixel budget is no worse than the old cap at 16:9. */
const GEO_MAX_W = 2560, GEO_MAX_H = 1600, GEO_MAX_PIX = 2560 * 1440;
function geoResize(cv){
  if (!cv || !cv.isConnected) return;
  const r = cv.getBoundingClientRect();
  const rw = r.width, rh = r.height;
  /* a box with no size yet — the plate mid-rebuild, or a hidden showcase — is left alone rather than
     collapsed to 1 x 1, which would have to be undone on the next frame anyway */
  if (!(rw > 0) || !(rh > 0)) return;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w0 = rw * dpr, h0 = rh * dpr;
  const k = Math.min(1, GEO_MAX_W / w0, GEO_MAX_H / h0, Math.sqrt(GEO_MAX_PIX / (w0 * h0)));
  const w = Math.max(1, Math.round(w0 * k)), h = Math.max(1, Math.round(h0 * k));
  if (cv.width === w && cv.height === h) return;
  cv.width = w; cv.height = h;
  const G = window.GC3D && GC3D.geo;
  if (G && G.S && G.S.canvas === cv) G.resize(w, h);
}
/* v5.64 — THE SCENE FOLLOWS ITS BOX. Same review, S3: the scene was measured once, at mount, and never again.
   Full screen, a phone turned sideways and the responsive layout all change the plate without changing the
   drawing buffer or the camera's aspect, so the picture stretched and the pixels went stale.

   This is called from the showcase's own refit — the one that already re-lays the scene on resize and full
   screen — and from a ResizeObserver on the plate, which is the only thing that catches a container that
   changes without the window changing: a control row wrapping, the footer growing, a rotation a browser
   reports late. Resizing is enough to make it redraw while paused: GC3D.geo.resize unsettles the scene and
   its own loop takes the next frame. */
function geoRefit(){
  const G = window.GC3D && GC3D.geo;
  if (!G || !G.S) return;
  geoResize(G.S.canvas);
}
/* SOUND. Andrew Fisher, 17 Sep 2026: sound matters. Off by default; one button beside Pause, only while the
   3D circuit is the backdrop; remembered on this device (gc500.showsound); nothing exists until the button or Start
   showcase is pressed — a browser will not start sound without a click, and neither does this page; quiet when the
   show is still or hidden; closed when the scene is torn down. The engine keeps the log (GC3D.sound.log). */
/* v5.43 — WHICH VIEW. Andrew Fisher, 17 Sep 2026, on his own GC500_3D_Scene_v1.3: even its views — driver and
   drone — were a 7 out of 10; ours had to be a 10.
   The list comes from the engine (GC3D.VIEWS), so the page never holds a second copy of it that can drift.
   Auto is the default and is the round the drone already flew, so anyone who does not touch it sees exactly
   what they saw before. Kept on this device like the backdrop and the sound, and written nowhere near the
   record. Only offered while a 3D backdrop is up, because the flat circuit has no camera to choose. */
const VIEW_KEY = 'gc500.showview';
function showViewGet(){
  try { const view = localStorage.getItem(VIEW_KEY); return view && window.GC3D && GC3D.VIEWS.some(v => v[0] === view) ? view : 'hero'; }
  catch (e) { return 'hero'; }
}
function showPaceGet(){
  try { const raw = localStorage.getItem('gc500.showpace'), n = raw == null ? 1 : Number(raw);
    return Number.isFinite(n) && n >= .25 && n <= 2 ? n : 1; } catch (e) { return 1; }
}
function showQualityGet(){
  try { const q = localStorage.getItem('gc500.showquality'); return ['balanced','high','ultra'].includes(q) ? q : 'auto'; } catch (e) { return 'auto'; }
}
function showCarFocusGet(){ try { return localStorage.getItem('gc500.showcarfocus') !== 'off'; } catch (e) { return true; } }
/* v5.64 — a redraw asked of WHICHEVER scene is up. The older engine renders on demand, so it is handed a
   frame directly; the geospatial one runs its own loop and only needs telling that its held picture is stale.
   Before this, every control that ended in showDriveDraw silently did nothing on the three new backdrops. */
function showDriveDraw(){
  const G = window.GC3D; if (!G) return;
  if (G.geo && G.geo.S) { if (G.geo.nudge) G.geo.nudge(); return; }
  if (G.S && G.S.paused) { G.S.needsRender = true; G.frame(performance.now()); }
}
function showDriveApply(){
  if (window.GC3D && GC3D.geo && GC3D.geo.S) { GC3D.geo.setPace(showPaceGet()); return; }
  if (!(window.GC3D && GC3D.S)) return;
  if (GC3D.setPace) GC3D.setPace(showPaceGet());
  if (GC3D.setQuality) GC3D.setQuality(showQualityGet());
}
/* v5.64 — WHICH ENGINE IS ON THE PLATE. GC500 Showcase Review, 22 Sep 2026, S2: "bind available controls to
   the active renderer. Pace, pause and camera behaviour must have one visible meaning across Day, Night and
   Coates Orange. Do not expose an audio button until audio is actually implemented for that renderer."

   One name for what is running, read from the backdrop AND from the engine that answered for it, because a
   backdrop that wants a scene it could not start is still the flat drawing:

     · '3d'   the older lit circuit
     · 'geo'  the geospatial scene — Day, Night, Coates orange
     · 'flat' the key-plan drawing, whether chosen or fallen back to
     · ''     anything else on the Backdrop list: black, carbon, a clip from the service

   Pace was the control this got wrong in the field. The geospatial scene reads pace on every frame and honours
   it, but the row was hidden the moment one of its three backdrops was chosen, so the reader had a speed
   control on the flat drawing, lost it on Day, and got it back on the older LED look. Now the row means the
   same thing on all of them. Quality, Car focus, the View chooser and Sound stay with the engine that
   implements them: the geospatial scene has no quality tier to pick, no car-focus layout, no named views and
   no audio path at all, and a Sound button that does nothing is worse than no Sound button. */
function showRenderer(){
  const show = $('#showcase'); const back = show ? show.getAttribute('data-back') : '';
  const G = window.GC3D;
  if (G && G.geo && G.geo.S && isGeoBack(back)) return 'geo';
  if (G && G.S && is3dBack(back)) return '3d';
  return back === 'circuit' || isGeoBack(back) || is3dBack(back) ? 'flat' : '';
}
function showDriveControls(which){
  if (which === true) which = '3d';
  if (which === false || which == null) { const r = showRenderer(); which = r === '3d' ? '' : r; }
  const pace = $('#showPace'), quality = $('#showQuality'), focus = $('#showCarFocus'), show = $('#showcase');
  const on = which === '3d';
  /* every engine that moves a car round the ring takes a pace, including the flat drawing's point of light */
  const hasPace = on || which === 'geo' || which === 'flat';
  const paceLabel = $('#showPaceL'); if (paceLabel) paceLabel.hidden = !hasPace;
  for (const id of ['showQualityL','showCarFocus']) { const el = $('#' + id); if (el) el.hidden = !on; }
  const carFocus = on && showCarFocusGet(); if (show) show.classList.toggle('car-focus', carFocus);
  if (focus) { focus.textContent = carFocus ? 'Show figures' : 'Car focus'; focus.setAttribute('aria-pressed', String(carFocus));
    focus.onclick = () => { try { localStorage.setItem('gc500.showcarfocus', carFocus ? 'off' : 'on'); } catch (e) {}
      showDriveControls(which); if (window.GC3D && GC3D.S) { GC3D.S.tune.shiftX = 0; GC3D.S.distK = 1; GC3D.S.needsLayout = true; if (GC3D.S.syncLayout) GC3D.S.syncLayout(); } showDriveDraw(); }; }
  /* the chosen pace is written down first and applied from the record, so a pace set before an appearance
     change is the pace the next scene starts at — showDriveApply is what every mount already calls */
  if (pace && hasPace) { pace.value = String(showPaceGet()); pace.onchange = () => { const n = Number(pace.value);
    try { localStorage.setItem('gc500.showpace', String(n)); } catch (e) {}
    showDriveApply(); showDriveDraw(); }; }
  if (!on) return;
  if (quality) { quality.value = showQualityGet(); quality.onchange = () => {
    try { localStorage.setItem('gc500.showquality', quality.value); } catch (e) {} GC3D.setQuality(quality.value); showDriveDraw(); }; }
}

function showViewFill(){
  const sel = $('#showView'); if (!sel || !window.GC3D || !GC3D.VIEWS || sel.options.length) return;
  GC3D.VIEWS.forEach(([v, label]) => { const o = document.createElement('option'); o.value = v; o.textContent = label; sel.appendChild(o); });
  sel.value = showViewGet();
  sel.addEventListener('change', () => {
    try { localStorage.setItem(VIEW_KEY, sel.value); } catch (e) {}
    if (window.GC3D && GC3D.setView) GC3D.setView(sel.value);
    showDriveDraw();
  });
}
function showViewSync(){
  const l = $('#showViewL'); if (!l) return;
  const which = showRenderer();
  const on = which === '3d';
  l.hidden = !on;                       /* named views belong to the engine that has them */
  showDriveControls(which);
  if (!on) return;
  showViewFill();
  const sel = $('#showView'); if (sel && GC3D.setView) GC3D.setView(sel.value || 'hero');
}
/* Sound exists for one engine and is offered for that one only — not because the geospatial scene is quiet
   today and might not be tomorrow, but because the button must never be on screen without an engine behind it. */
function showSoundAvailable(){ return !!(window.GC3D && GC3D.sound && showRenderer() === '3d'); }
function showSoundSync(still){
  const b = $('#showSound'); if (!b) return;
  const avail = showSoundAvailable();
  b.hidden = !avail;
  if (!avail) return;
  const S = GC3D.sound;
  if (still) S.suspend(); else S.resume();
  const on = S.isOn();
  b.textContent = on ? 'Sound on' : 'Sound off'; b.setAttribute('aria-pressed', on ? 'true' : 'false');
}
function showSoundToggle(){
  if (!showSoundAvailable()) return;
  const S = GC3D.sound;
  if (S.isOn()) S.off(); else if (!S.on()) flash('This browser has no sound output for the page.');
  showSoundSync(motionOff() || document.hidden || !SHOW.open || !SHOW.playing);
}
function showPlateStop(){
  show3dStop();
  fxStop(); FX.cv = null; FX.ctx = null;
  lapsStop(); LAPS.cv = null; LAPS.ctx = null; LAPS.map = null;
  showClipPause(); if (CLIP.v) { try { CLIP.v.removeAttribute('src'); CLIP.v.load(); } catch (e) {} } CLIP.v = null;
}
/* ---------------- the fit: a scene is measured after it is drawn and zoomed down until the whole of it is on
   the screen, whatever the screen — a browser zoomed up on a television, a laptop with its bars, a phone held
   sideways. Never up: type is never made bigger than the stylesheet asks for. */
/* THE SCENE IS SIZED BY ITS OWN BOX, NOT BY THE WINDOW. Andrew Fisher, 17 Sep 2026, on a 1,128-point window:
   the presentation was poor — all over the place, making no sense, two out of ten.
   Every size on a scene was either a fixed number of pixels (13 px rows, 26 px dates) or a clamp on vw and vh —
   so on a window that was not the 1920-point television the headline grew while the rows stayed small, the block
   floated in the middle of a tall plate, and each scene started somewhere different. Now one unit, --u, is
   measured from the plate the scene is drawn in, every size on the scene is a multiple of it, and every scene
   starts at the same place with the slack falling at the foot. u is the smaller of the box's width over 78 and
   its height over 46 — the sizes that follow are then right at any shape from a phone to a wall. */
function showUnit(){
  const scene = $('#showBody'); if (!scene) return;
  const w = scene.clientWidth || 0, h = scene.clientHeight || 0;
  if (!w || !h) return;
  const u = Math.max(6.4, Math.min(30, Math.min(w / 78, h / 46)));
  scene.style.setProperty('--u', u.toFixed(2) + 'px');
  SHOW.u = u;
}
/* AND IT FILLS THE PLATE. A scene that ends a third of the way down a tall window reads as a mistake, which is
   what it was. The unit is grown until the scene's own block stands about nine tenths of the height of the box
   it is in, and shrunk if it runs over — so the same scene is large on a wall, comfortable on a laptop and still
   whole on a phone, and every one of the twelve fills its frame the same way (v5.41). */
function showFill(){
  const scene = $('#showBody'), wrap = scene && scene.querySelector('.shwrap'); if (!scene || !wrap) return;
  const cs = getComputedStyle(scene), box = scene.clientHeight - parseFloat(cs.paddingTop || 0) - parseFloat(cs.paddingBottom || 0);
  if (!(box > 0)) return;
  const H = () => wrap.getBoundingClientRect().height;
  const set = u => { SHOW.u = u; scene.style.setProperty('--u', u.toFixed(2) + 'px'); };
  let u = SHOW.u || 14;
  for (let i = 0; i < 16 && u < 30; i++) { if (H() > box * 0.90) break; set(Math.min(30, u *= 1.07)); }
  for (let i = 0; i < 16 && u > 6.4; i++) { if (H() <= box - 2 && wrap.scrollWidth <= wrap.clientWidth + 1) break; set(u = Math.max(6.4, u * 0.94)); }
}
function showFit(){
  const scene = $('#showBody'), wrap = scene && scene.querySelector('.shwrap'); if (!scene || !wrap) return;
  showUnit();
  wrap.style.zoom = '';
  showFill();
  let z = 1;
  /* the words' own box, not the scene's scrollable width — a decoration parked outside the box must never shrink a scene */
  const over = () => scene.scrollHeight > scene.clientHeight + 1 || wrap.scrollWidth > wrap.clientWidth + 1;
  /* down to six tenths and no further: type smaller than that is not readable from across a site office, and
     a scene that still does not fit is left to scroll from its top rather than shrunk into a smear */
  const floor = (window.innerWidth < 700 || window.innerHeight < 480) ? 1 : 0.6;   /* a phone scrolls at full size; a wall shrinks to fit */
  for (let i = 0; i < 8 && over() && z > floor; i++) { z = Math.round((z - 0.05) * 100) / 100; wrap.style.zoom = String(z); }
  scene.scrollTop = 0;
  SHOW.zoom = z;
}
(function watchTabWidth(){
  const redraw = () => { try { renderTabs(); } catch (e) {} };
  if (TAB_WIDE.addEventListener) TAB_WIDE.addEventListener('change', redraw);
  else if (TAB_WIDE.addListener) TAB_WIDE.addListener(redraw);
})();
/* ON A PHONE THE FIRST SCREEN IS THE WORK (Andrew Fisher, 23 Sep 2026, on scrolling). Measured at 390 px
   before this: the Timeline's day list began 1,400 px down, under a picture, four tiles, a 394 px paragraph
   on what a day shows, the filters and the light bar; the Register's first row began 3,300 px down, under
   the contracts card and the branch card; Fencing's first table sat under 1,700 px of explanation. None of it
   is wrong on a laptop, where it sits beside the work. On a phone it is a page of reading before the first
   row, every time the tab is opened. So under 640 px a long explanation (.notice) and a card marked
   .foldphone fold to one line — the notice's own first words, the card's own heading — and open with a
   press; a fold a person has opened stays open through every redraw of the page. Nothing is removed and
   nothing moves on a laptop. */
const TAB_PHONE = (() => { try { return matchMedia('(max-width: 640px)'); } catch (e) { return {matches: false}; } })();
const PFOLD_OPEN = new Set();
function foldForPhone(pane){
  if (!pane) return;
  const phone = TAB_PHONE.matches;
  const title = el => { const h = el.querySelector('h3, h2, b, strong'); const t = (h ? h.textContent : el.textContent).replace(/\s+/g, ' ').trim();
    return t.length > 64 ? t.slice(0, 61).replace(/\s+\S*$/, '') + '…' : t || 'About this page'; };
  /* v5.81 — a long notice at the top of a tab folds on EVERY screen now (management, 24 Sep 2026: too much information
     on the face of the page); a card marked .foldphone still folds on a phone only */
  const cands = [...pane.querySelectorAll(':scope > .notice, :scope > .card.foldphone')].filter(el => !el.closest('details.pfold') && !el.classList.contains('nofold') && (phone || el.matches('.notice')));
  cands.forEach(el => {
    if (el.matches('.notice') && (el.matches('.crit') || (el.textContent || '').replace(/\s+/g, ' ').trim().length < SFOLD_MIN)) return;   /* a short notice, or a warning that must be read, stays on the face */
    const t = title(el);
    const d = document.createElement('details'); d.className = 'pfold' + (el.matches('.card') ? ' pfold-card' : ''); d.dataset.pfold = t;
    if (PFOLD_OPEN.has(t)) d.open = true;
    const sm = document.createElement('summary'); sm.innerHTML = `<span class="pfw">${esc(t)}</span><span class="pfh" aria-hidden="true"></span>`;
    d.addEventListener('toggle', () => { if (d.open) PFOLD_OPEN.add(t); else PFOLD_OPEN.delete(t); });
    el.parentNode.insertBefore(d, el); d.appendChild(sm); d.appendChild(el);
  });
}
/* v5.81 — THE STORIES FOLD. Management, through Andrew Fisher on 24 Sep 2026: good work, but too much information
   — overstated; keep the wow factor, but costs are what matter; take the stories out, or fold them into a drop-down
   that opens for the
   details. So after every draw, every card and plate on the page is walked and its explanatory paragraphs —
   the ones longer than a line or two — are moved, in their order, under one Details fold at the foot of the card,
   closed. The numbers, the headings, the buttons, the tables and the short status lines stay exactly where they
   were. A fold a person has opened stays open through the page's redraws (the record syncs every few seconds).
   Nothing is deleted: the words are one press away, and the printed page prints without the folds. */
const SFOLD_OPEN = new Set();
const SFOLD_MIN = 120;                         /* characters — under this a paragraph is a status line and stays */
/* v5.81 — "More info". Andrew Fisher, 25 Sep 2026, with five photographs of Where we are on his tablet: a More info
   that hides the stories — all unnecessary data hidden, for a visual read by the people at the top.
   So a card on Where we are carries its figures on its face and every
   story, note and secondary count under ONE "More info" at its foot, closed; opened, it stays open through the
   page's redraws on this device. The same words the stories fold uses everywhere else. Nothing is deleted. */
function moreInfo(key, inner){
  const body = String(inner || '').trim();
  if (!body) return '';
  return `<details class="sfold more" data-sfold="${esc(key)}"${SFOLD_OPEN.has(key) ? ' open' : ''}><summary title="the working behind this card, in words">More info</summary><div class="sfoldbody">${body}</div></details>`;
}
/* a fold drawn in the page's HTML remembers itself the same way a fold made after the draw does */
document.addEventListener('toggle', e => { const d = e.target;
  if (d && d.matches && d.matches('details.sfold[data-sfold], details.oday[data-sfold]')) { if (d.open) SFOLD_OPEN.add(d.dataset.sfold); else SFOLD_OPEN.delete(d.dataset.sfold); } }, true);
function foldStories(root){
  if (!root) return;
  const cards = [...root.querySelectorAll('.card, .dsn .grp, .mcard, .hubcard, .clocard, .dcard')].filter(c => !c.closest('details.sfold') && !c.classList.contains('nosfold'));
  cards.forEach((card, ci) => {
    if (card.querySelector(':scope > details.sfold')) return;
    const heading = (card.querySelector('h2, h3, h4, .hubtitle, .brtitle') || {}).textContent || '';
    const key = (root.id || 'page') + '|' + ci + '|' + heading.replace(/\s+/g, ' ').trim().slice(0, 60);
    const isStory = el => {
      if (el.closest('details.sfold, table, form, .form, .kpis, .daystrip, summary, label, .acts, .hubbig, .money, .mtot')) return false;
      if (el.matches('.notice.crit, .crit, .todo')) return false;
      const t = (el.textContent || '').replace(/\s+/g, ' ').trim();
      if (t.length < SFOLD_MIN) return false;
      if (el.querySelector('input, select, textarea')) return false;
      return true;
    };
    const stories = [...card.querySelectorAll('p.norate, p.sub, p.hint, p.maphint, p.fine, p.mnote, p.src, .notice.info, .notice.warn, p.pnote, .about, .story')].filter(el => el.closest('.card, .dsn .grp, .mcard, .hubcard, .clocard, .dcard') === card && isStory(el));
    if (!stories.length) return;
    const d = document.createElement('details'); d.className = 'sfold'; d.dataset.sfold = key; if (SFOLD_OPEN.has(key)) d.open = true;
    const sm = document.createElement('summary'); sm.textContent = 'More info'; sm.title = 'the working behind this card, in words';
    const body = document.createElement('div'); body.className = 'sfoldbody';
    d.appendChild(sm); d.appendChild(body);
    d.addEventListener('toggle', () => { if (d.open) SFOLD_OPEN.add(key); else SFOLD_OPEN.delete(key); });
    stories.forEach(el => body.appendChild(el));
    card.appendChild(d);
  });
}
function render(){ return holdAssets(renderPass); }
/* v5.94 - what a draw works out once it keeps for that draw: emptied at the start of every pass */
const RENDER_MEMO = new Map();
function renderPass(){
  RENDER_MEMO.clear();
  LAMP_GEN++;
  const pn = $('#printnote');
  if (pn) pn.textContent = DATA.brand.footer + ' · ' + DATA.event.name + ' · asset map printed '
    + todayIso() + ' · dataset ' + (DATA.register_sha256||'').slice(0,12)
    + (SYNC.on ? ' · records shown are the shared record as at printing' : ' · records shown are saved in this browser only and may not match anyone else\'s copy');
  if (state.tab === 'today') renderToday();
  else if (state.tab === 'progress') renderProgress();
  else if (state.tab === 'map') renderMap();
  else if (state.tab === 'docs') renderDocs();
  else if (state.tab === 'register') renderRegister();
  else if (state.tab === 'plant') renderPlant();   /* v5.95 - the register's facts are on the plant rows themselves */
  else if (state.tab === 'variances') renderVariances();
  else if (state.tab === 'fencing') renderFencing();
  else if (state.tab === 'prestarts') renderPrestarts();
  else if (state.tab === 'coatesway') renderCoatesWay();
  else if (state.tab === 'journal') renderJournal();
  else if (state.tab === 'breakdowns') renderBreakdowns();
  else if (state.tab === 'costs') renderCosts();
  else if (state.tab === 'add') renderAdd();
  else if (state.tab === 'edit') renderEdit();
  else if (state.tab === 'pricing') renderPricing();
  else if (state.tab === 'timeline') renderTimeline();
  else renderAbout();
  hzTodayPod();   /* v6.10 - the banner's day pod reads the same record this pass drew */
  applyCapability();
  markCards();
  fitKpis();
  foldStories($('#pane-' + state.tab));
  foldForPhone($('#pane-' + state.tab));
}
/* A FIGURE ON A TILE IS NEVER BROKEN IN TWO. The tester audit of 16 Sep 2026 read the Fencing tab on a 1366 px
   laptop: "$23,276.00" did not fit its tile and overflow-wrap broke it as "$23,276.0" over "0" — a figure that
   reads as a different number. A tile's value now never wraps inside itself; when it is wider than the tile it
   is stepped down in size until it fits, and the tile's own words are the only thing that wrap. */
function fitKpis(){
  /* v5.93 - read everything, then write once: the loop of shrink-and-measure forced a layout per step per figure */
  const els = [...document.querySelectorAll('.pane.on .kpi .v')]; if (!els.length) return;
  els.forEach(v => { v.style.fontSize = ''; });
  const m = els.map(v => ({v, sw: v.scrollWidth, cw: v.clientWidth, px: parseFloat(getComputedStyle(v).fontSize) || 38}));
  m.forEach(({v, sw, cw, px}) => { if (sw > cw + 1) v.style.fontSize = Math.max(16, Math.floor(px * cw / sw) - 1) + 'px'; });
}
window.addEventListener('resize', () => { try { fitKpis(); } catch (e) {} });
/* ------------------------------------------------------------------ ONE capability value
   Superior Audit, 15 Sep 2026, F07. "Use one capability value throughout the UI."

   canEdit() is it. Everything that can change the record asks this and nothing else. applyCapability() then
   carries the answer to every control that has already been drawn, by RULE rather than by a list: under a
   view-only link every field in the work area and the drawer is disabled unless it is marked data-ro — a
   control that only changes what is SHOWN, like the map's sheet picker. A field added next month is read-only
   in a view link without anybody remembering to add it anywhere.

   This is an honest interface, not a security boundary. A person with the browser console can re-enable any of
   it; what stops a write reaching the shared record is the service, which refuses one without the edit token
   and always has. What this fixes is a page that invited somebody to type a rate into 47 boxes and press a
   Save that was never going to work. */
/* V11 audit, F04. `canEdit()` was `!SYNC.readonly`, and `SYNC.readonly` starts FALSE — so between the page
   loading and the service answering, an unresolved capability read as "yes, you may edit". On a slow
   connection that is a window where a person can type into a link that will refuse everything they do.

   Three states, named, and "unknown" is not "edit":

     unknown   a service is behind this page and has not yet said what this link may do
     view      it has said view only
     edit      it has said edit, or there is no service and the record is this browser's own

   A file on a laptop and a shared folder are 'edit' immediately — nothing is pending, there is nothing to
   wait for. Only a hosted link with a service it has not heard from is unknown. */
function capability(){
  if (SYNC.readonly) return 'view';                /* something has already said so, on any edition */
  if (SYNC.level === 'view') return 'view';
  if (SYNC.level === 'edit') return 'edit';
  /* THE SERVICE HAS NOT SAID YET — SO WHAT DOES THE LINK SAY?

     Corrected 15 Sep 2026, and the correction matters more than the original rule. F04 was right that a page
     must not accept work a service will refuse. But "has not said yet" is not a moment on this job: a phone in
     a dead spot on the circuit, or a service that is down for ten minutes, sits in it indefinitely — and while
     it did, an EDIT link refused every light, every date and every note, with the footer underneath saying
     "records are saved in this browser and go up when it answers". That is the page promising one thing and
     doing another, to the person standing at the gate with the truck.

     So: a link handed out as an edit link is treated as edit until the service says otherwise. The claim is
     not authority — the moment /api/version answers, SYNC.level is set from what it says, and a not_writer on
     any write takes the page read-only and clears the queue in front of the person. A view link is view
     straight away and never becomes anything else. Only a hosted page carrying no token at all is genuinely
     unknown, which is the case F04 was actually about. */
  if (SYNC.claims === 'view') return 'view';
  if (SYNC.claims === 'edit') return 'edit';
  /* a service is behind this page, nothing claims anything, and it has not said yet — that is not permission */
  if (SYNC.on || SYNC.status === 'connecting' || SYNC.status === 'unreachable') return 'unknown';
  return 'edit';                                   /* this browser's own record, or a synced folder */
}
function canEdit(){ return capability() === 'edit'; }
/* V11 audit, F04: "Check it before every mutation of local state." Hiding a control is a courtesy; refusing
   the change is the rule. Called at the top of everything that writes to S, so a control reached any other way
   — a keyboard, a script, a stale handler on a page whose capability changed while it was open — is refused
   with words rather than quietly succeeding into a record the service will never accept. */
function mayWrite(what){
  const cap = capability();
  if (cap === 'edit') return true;
  flash(cap === 'unknown'
    ? 'Still checking what this link may do — ' + (what || 'that change') + ' has not been made. Try again in a moment.'
    : 'View only — this link shows the shared record and cannot change it. ' + (what ? what.charAt(0).toUpperCase() + what.slice(1) : 'That change') + ' was not made.');
  return false;
}
function applyCapability(root){
  const cap = capability(), ro = cap !== 'edit';
  document.body.classList.toggle('viewonly', ro);
  document.body.setAttribute('data-cap', cap);
  /* every pane, not only the one on screen: a pane drawn while the link was view-only must not stay locked
     when the link turns out to be a writer after all (the service answers late, and it does answer late).
     V11 audit, F04: and whatever `root` is given — a drawer or a dialog that has just been put into the page
     after the last render, whose twelve fields were being left enabled. */
  const scopes = root ? [root] : [$('main'), $('#drawer')].filter(Boolean);
  scopes.forEach(sc => {
    sc.querySelectorAll('input, select, textarea').forEach(el => {
      if (el.hasAttribute('data-ro') || el.closest('[data-ro]')) return;
      if (ro) {
        if (!el.disabled) { el.disabled = true; el.dataset.roLocked = '1'; }
        el.setAttribute('aria-disabled', 'true');
        if (!el.title) el.title = 'View only — this link shows the record and cannot change it';
      } else if (el.dataset.roLocked) {
        el.disabled = false; delete el.dataset.roLocked; el.removeAttribute('aria-disabled');
      }
    });
  });
  if (root) return;                                /* a mounted dialog: the fields, and nothing else to redraw */
  /* said once at the top of the pane, instead of leaving a footer to explain a Save that will fail */
  const say = cap === 'unknown'
    ? '<i aria-hidden="true"></i><span><b>Checking what this link may do.</b> Until the service answers, nothing here can be changed — it stops a change being typed into a link that would refuse it.</span>'
    : '<i aria-hidden="true"></i><span><b>View only.</b> This link shows the shared record and cannot change it — everything here can be read, searched, printed and exported.</span>';
  document.querySelectorAll('main .pane').forEach(pane => {
    const has = pane.querySelector(':scope > .rochip');
    if (ro && pane.children.length) {
      if (has) { has.className = 'rochip ' + cap; has.innerHTML = say; }
      else { const n = document.createElement('p'); n.className = 'rochip ' + cap; n.innerHTML = say; pane.insertBefore(n, pane.firstChild); }
    } else if (!ro && has) { has.remove(); }
  });
}
/* V11 audit, F04: whenever a dialog is put into the page AFTER the last render — an asset drawer, the map's
   picker, the empty-callout form — its fields have to be told what this link may do. render() cannot do it
   because render() has already run. */
function mounted(el){ if (el) { try { applyCapability(el); } catch (e) {} } return el; }
$('#bOrg').textContent = DATA.brand.org;
$('#bSub').textContent = DATA.event.race_dates_as_supplied + ' · Surfers Paradise';
/* the name every record carries. Typed once, kept with the records, shown back on reopen. */
$('#who').value = S.operator || '';
$('#who').onchange = () => { S.operator = $('#who').value.trim(); $('#who').classList.remove('need'); save();
  /* The name is the one thing people open Tools for mid-job. Once it is in, the menu gets out of the way of
     whatever they were about to press underneath it — on Documents the Upload button sits right there, and a
     tap meant for it landed on the menu's Import instead (16 Sep 2026). */
  if (S.operator) { moreClose(); flash('Recording as ' + S.operator + '.'); } };
$('#footL').textContent = DATA.brand.footer + ' · built ' + DATA.built + ' · ' + DATA.build_version;
renderTabs(); route();
/* A record this browser could not read is said at the top of the page the moment it opens, not the first time
   somebody happens to change something. Nothing is written over it until a person chooses. */
damagedBanner();
$('#folderBtn').onclick = () => folderDialog();
syncBoot();
window.addEventListener('popstate', onPop);
/* Native hash links and pasting a new fragment are navigation too. popstate may already have handled it. */
window.addEventListener('hashchange', () => { if (!routing && location.hash !== NAV.cur) route(); });
/* Menus use the real wrapped header height on narrow or enlarged-text screens. One observer for the page. */
(() => {
  const header = document.querySelector('header.top'); if (!header) return;
  const measure = () => document.documentElement.style.setProperty('--barH', Math.ceil(header.getBoundingClientRect().height) + 'px');
  measure();
  if (window.ResizeObserver) new ResizeObserver(measure).observe(header);
  else window.addEventListener('resize', measure);
})();
</script>
