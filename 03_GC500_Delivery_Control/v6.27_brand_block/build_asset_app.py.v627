def share_repeated_media(payload: dict) -> tuple[dict, dict]:
    """The same picture embedded twice is embedded once, and every place that wants it SAYS where it is.

    19 Sep 2026. The hosted page carried 112 embedded pictures, videos and sounds — 105 of them different. The
    aerial photograph was in it TWICE, 2.72 MB each time, because `aerial_hi` and the aerial map sheet are the
    same file and each was encoded on its own. Six document thumbnails were doubled the same way. 2.85 MB of a
    25 MB page was one picture written out a second time.

    HOW A SHARED PICTURE IS WRITTEN, AND WHY NOT null. The bytes go in `DATA.media` under a key, and every place
    that holds that picture carries {"media": "m1"} — a marker naming the entry. It does NOT become null. A null
    would say the field has no picture, which is false, and anything reading the page's DATA as it stands — an
    export, a check, a person with a text editor — would read a lie. A marker says "the picture is over there",
    which is true, and can be resolved by anybody, in any language, without running the page. DATA stays valid
    JSON throughout, and the page resolves every marker in one pass before a line of app code reads DATA, so
    nothing downstream ever sees a marker either.

    Only pictures held in more than one place are moved. A picture held once stays exactly where it was, so the
    table never becomes a second copy of the file, and small strings are left alone because the indirection
    would cost more than it saves.
    """
    MIN = 4096
    counts: dict[str, int] = {}

    def count(o):
        if isinstance(o, str):
            if o.startswith('data:') and len(o) >= MIN:
                counts[o] = counts.get(o, 0) + 1
        elif isinstance(o, dict):
            for v in o.values():
                count(v)
        elif isinstance(o, list):
            for v in o:
                count(v)
    count(payload)

    repeated = [v for v, n in counts.items() if n > 1]
    if not repeated:
        return payload, {'entries': 0, 'bytes_saved': 0, 'references': 0}
    # longest first, so the keys read in the order a person would care about
    repeated.sort(key=len, reverse=True)
    key_of = {v: 'm%d' % (i + 1) for i, v in enumerate(repeated)}
    refs = [0]

    def mark(o):
        if isinstance(o, str):
            k = key_of.get(o)
            if k is None:
                return o
            refs[0] += 1
            return {'media': k}
        if isinstance(o, dict):
            return {kk: mark(vv) for kk, vv in o.items()}
        if isinstance(o, list):
            return [mark(vv) for vv in o]
        return o

    out = mark(payload)
    out['media'] = {key_of[v]: v for v in repeated}
    saved = sum(len(v) * (counts[v] - 1) for v in repeated)
    return out, {'entries': len(repeated), 'bytes_saved': saved, 'references': refs[0]}


def data_uri(p: Path) -> str:
    return 'data:image/webp;base64,' + base64.b64encode(p.read_bytes()).decode()


def mp4_uri(p: Path) -> str:
    return 'data:video/mp4;base64,' + base64.b64encode(p.read_bytes()).decode()


def webm_uri(p: Path) -> str:
    return 'data:video/webm;base64,' + base64.b64encode(p.read_bytes()).decode()


# --------------------------------------------------------------------------- the two typefaces
# Andrew Fisher, 14 Sep 2026: Barlow Condensed bold italic for the large date numeral, and Inter for the
# operational figures and labels.
#
# They are EMBEDDED, not linked. This page opens from a file on a laptop with no network, from a phone in a
# carpark, and from a service whose egress may allow nothing at all — a stylesheet fetched from a font host
# would silently fall back to whatever the device had, and the date numerals would stop being the thing Andrew
# asked for at exactly the moment somebody was using them on site. Embedding costs about 120 kB in a 19 MB file.
#
# Both are under the SIL Open Font License 1.1, which permits this. The licences travel with the package in
# print/fonts/, and the notice below goes into the page itself, as the licence requires.
FONT_DIR = Path(__file__).resolve().parent / 'fonts'
FONTS = [
    ('Barlow Condensed', 700, 'italic', 'barlow-condensed-latin-700-italic.woff2'),
    ('Inter', 400, 'normal', 'inter-latin-400-normal.woff2'),
    ('Inter', 600, 'normal', 'inter-latin-600-normal.woff2'),
    ('Inter', 700, 'normal', 'inter-latin-700-normal.woff2'),
    ('Inter', 800, 'normal', 'inter-latin-800-normal.woff2'),
]
FONT_NOTICE = (
    'Barlow Condensed: Copyright 2017 The Barlow Project Authors (https://github.com/jpt/barlow). '
    'Inter: Copyright 2016 The Inter Project Authors (https://github.com/rsms/inter). '
    'Both licensed under the SIL Open Font License, Version 1.1 — the full text travels with this package in '
    'print/fonts/LICENSE-Barlow-OFL.txt and print/fonts/LICENSE-Inter-OFL.txt.'
)


def hz_car_uri() -> str:
    """v5.87 - the #26 cut-out for the banner, as the page carries it (print/web/car_26.webp, 1000 px wide for a 230 px slot)."""
    f = WEB / 'car_26.webp'
    return 'data:image/webp;base64,' + base64.b64encode(f.read_bytes()).decode() if f.exists() else ''


def hz_backdrop_uri() -> str:
    """v5.87 - the circuit at dusk behind the bar: sources/brand/hero_circuit.png cropped to the band, graded darker and
    cooler, a touch of depth of field, cached as print/web/hz_backdrop.jpg. The foreground stays sharp; this is the one
    thing meant to be soft."""
    out = WEB / 'hz_backdrop.jpg'
    src = ROOT / 'sources/brand/hero_circuit.png'
    if not out.exists() and src.exists():
        from PIL import Image, ImageEnhance, ImageFilter
        im = Image.open(src).convert('RGB'); w, h = im.size
        im = im.crop((0, int(h * 0.18), w, int(h * 0.78)))
        im = ImageEnhance.Color(im).enhance(0.75); im = ImageEnhance.Brightness(im).enhance(0.6); im = ImageEnhance.Contrast(im).enhance(1.15)
        im = im.filter(ImageFilter.GaussianBlur(0.8))
        im.save(out, quality=92)
    return 'data:image/jpeg;base64,' + base64.b64encode(out.read_bytes()).decode() if out.exists() else ''


def font_faces() -> str:
    """@font-face rules with the font bytes in them, so the page carries its own type wherever it is opened."""
    out = ['/* ' + FONT_NOTICE + ' */']
    for family, weight, style, name in FONTS:
        f = FONT_DIR / name
        if not f.is_file():
            continue
        b = base64.b64encode(f.read_bytes()).decode()
        out.append("@font-face{font-family:'%s';font-style:%s;font-weight:%d;font-display:swap;"
                   "src:url(data:font/woff2;base64,%s) format('woff2')}" % (family, style, weight, b))
    return '\n'.join(out)


# --------------------------------------------------------------------------- the product photographs
# Andrew Fisher supplied these on 11 Sep 2026 with his own mapping of which photograph stands for which product
# SIZE — one picture for the 4.8 m x 3 m and 6 m x 3 m buildings, another for the 12 m x 3 m and 9.6 m x 3 m, and one
# male-and-female toilet block picture that does the 6 m x 3 m too. That mapping is what PRODUCT_PHOTOS carries, and nothing else is
# inferred from it.
#
# Two rules the pictures are under, and they are the whole reason this is a short list rather than a long one:
#
#   1. A photograph stands for the PRODUCT, never for the individual asset. It is not a picture of P33. Every
#      card that shows one says so, because a driver who takes it for a photograph of the thing they are
#      collecting will look for the wrong object in the yard.
#   2. A product Andrew did not supply a photograph for gets NO picture. Not a near-enough one from the same
#      discipline, and never one of the AI-generated cards in sources/brand/generated — those are marked
#      "illustrative": true in their own provenance, and an illustration captioned "reference photo" is a lie
#      with a driver on the other end of it. The card says a photograph is missing instead, which is worth
#      knowing: the biggest gap is FWF, the single most-scheduled product on the job.
