  /* the build settles one contract per asset (pipeline/baseplan_contracts.py); the lines are the evidence */
  const ids = asg && asg.rental_contract ? [String(asg.rental_contract)] : r.contracts.slice().sort();
  const detail = ids.map(id => (ONHIRE && (ONHIRE.contracts || []).find(c => String(c.rental_contract) === String(id))) || null);
  return {id: ids.join(' · '), ids, c: {rental_id: ids.join(' · '), contract_type: null, customer_code: null, customer_name: null, site: null,
          branch_code: [...new Set(detail.filter(Boolean).map(c => c.branch_code).filter(Boolean))].join(', ') || null, _rental: true}, where: 'rental'};
}
function contractOf(key){
  const loc = movedAway(key) ? null : ((S.rental || {})[key] || null);
  const com = movedAway(key) ? null : ((CROW.get(key) || {}).contract || null);
  if (loc) return {id: loc, c: (S.contracts || {})[loc] || (com && com.rental_id === loc ? com : null), where: 'local'};
  if (com && com.rental_id) return {id: com.rental_id, c: com, where: 'committed'};
  const rent = rentalContractOf(key); if (rent) return rent;
  return {id: null, c: null, where: null};
}
function contractLine(c, id){
  if (!c) return id ? `Rental ID <b class="mono">${esc(id)}</b> <span class="chip cand" title="the Rental ID is recorded but no contract details are held for it">details not held</span>` : '';
  return `Rental ID <b class="mono">${esc(c.rental_id)}</b>${c.contract_type ? ' · ' + esc(c.contract_type) : ''}${c.customer_code ? ' · <span class="mono">' + esc(c.customer_code) + '</span>' : ''}${c.customer_name ? ' · ' + esc(c.customer_name) : ''}${c.site ? ' · ' + esc(c.site) : ''}`;
}
function contractShort(c, id){
  if (!c) return id ? esc(id) : '';
  return `<span class="mono">${esc(c.rental_id)}</span>${c.customer_code ? ` <span class="w" style="color:var(--mute)">${esc(c.customer_code)}</span>` : ''}`;
}
function contractCount(id){ return allAssets().filter(a => contractOf(a.key).id === id).length; }
function allContracts(){
  const out = Object.assign({}, S.contracts || {});
  (COMMITTED.contracts || []).forEach(c => { if (c && c.rental_id && !out[c.rental_id]) out[c.rental_id] = Object.assign({}, c, {_committed: true}); });
  return Object.values(out).sort((a, b) => String(a.rental_id).localeCompare(String(b.rental_id)));
}
function setRental(keys, id, quiet){
  if (!mayWrite('the Rental ID')) return false;
  const who = whoAmI(); if (!who) return false;
  keys.forEach(k => { if (id) S.rental[k] = id; else delete S.rental[k]; stampIt('rental', k); });
  save();
  if (!quiet) flash(id ? `${keys.length} asset${keys.length === 1 ? '' : 's'} put on Rental ID ${id}.` : `${keys.length} asset${keys.length === 1 ? '' : 's'} taken off their contract.`);
