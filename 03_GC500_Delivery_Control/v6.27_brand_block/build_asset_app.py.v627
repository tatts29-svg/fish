/* The word for where an unexported record lives: one browser, or the shared record everyone opens. */
const LW = () => SYNC.on ? 'shared record' : (typeof FOLDER !== 'undefined' && FOLDER.status === 'live') ? 'shared folder' : 'this browser only';

/* merged view: supplied assets + anything added in the page */
