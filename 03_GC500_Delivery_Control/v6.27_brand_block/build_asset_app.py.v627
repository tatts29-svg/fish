                       'that still, so the board does not move when it ends' if run.is_file() else None),
            'run_sound': ('his own sound, kept — the page carries the clip twice, VP9/Opus and H.264/AAC, so every browser finds one it can play' if run.is_file() else None),
            'supplied_by': 'Andrew Fisher', 'supplied_on': '12 Sep 2026',
            'note': ('sized for the web and its sound dropped, never redrawn, recoloured, cropped or painted on; '
                     'every word on the board is HTML over the picture, read from this record when it is shown')}


# The sheet rasters and the two aerials the page embeds. Nothing else in the tree produced these, so a clean
# checkout could not rebuild the map — the same trap that left four zoom plates surviving from an old run.
SHEET_W = 2600            # wide enough to read a callout at full-screen zoom, small enough to embed seven of them
AERIAL_W = 4760           # the map tab's aerial — the drawing frame at 1×
AERIAL_HI_W = 7140        # the close-up aerial — 1.5× the frame. With the registered Queensland imagery that is real
                          # detail (0.23 m per pixel on the ground); with the drawing's own photograph it is smoothing.
AERIAL_HI_H = round(2994 * AERIAL_HI_W / 4760)

# The map tab's sheet pictures. When the A1 aerial plates exist (print/make_a1_aerial.py) the tab shows the
# LABELS_CLEAR plate — the drawing as issued with a legible aerial under it — otherwise the sheet as issued.
A1_AERIAL_FOR_SHEET = {
    'D025': 'GC500_A1_Aerial_Street_Map_LABELS_CLEAR.pdf',
    'D022': 'GC500_A1_Aerial_Portable_Buildings_LABELS_CLEAR.pdf',
    'D023': 'GC500_A1_Aerial_Toilets_LABELS_CLEAR.pdf',
    'D024': 'GC500_A1_Aerial_Generators_Light_Towers_LABELS_CLEAR.pdf',
    # D007 has no aerial plate and must not get one, for the same reason D016 has none: it is drawn over a
    # wider photograph of the coast at the same page rectangle, so the plate that used to sit here had the
    # circuit's ground under it. 21 Sep 2026; pipeline/sheet_frames.py.
    # D016 has no aerial plate and must not get one: it is the Cypress carpark at 1 : 200, a different frame
    # entirely, and the plate that used to sit here had the circuit aerial under it. pipeline/sheet_frames.py.
    'K220': 'GC500_A1_Aerial_Water_Barriers_K220_LABELS_CLEAR.pdf',
}


def ensure_web_images() -> None:
    """Render every image the page embeds, from the sources, if it is missing or older than what makes it."""
    from PIL import Image
    WEB.mkdir(parents=True, exist_ok=True)
    src_by_key = {k: (ROOT / next((d['file'] for d in D['drawings']
                                   if d['sheet_id'] == sid and d.get('file')), ''))
                  for k, (_, _, sid) in SHEET_IMAGES.items() if sid}

    def stale(dest: Path, src: Path) -> bool:
        return not dest.exists() or not src.exists() or dest.stat().st_mtime < src.stat().st_mtime

    for key, src in src_by_key.items():
        dest = WEB / f'{key}.webp'
        plate = OUT / A1_AERIAL_FOR_SHEET.get(key, '')
        if key in A1_AERIAL_FOR_SHEET and plate.is_file():
            src = plate                                  # the same sheet with a legible aerial under it
        if not src.is_file() or not stale(dest, src):
            continue
        png = dest.with_suffix('.tmp.png')
        subprocess.run(['pdftoppm', '-r', '150', '-png', '-singlefile', str(src),
                        str(png.with_suffix(''))], check=True)
        im = Image.open(png).convert('RGB')
        im = im.resize((SHEET_W, round(im.height * SHEET_W / im.width)), Image.LANCZOS)
        im.save(dest, 'WEBP', quality=72, method=5)
        png.unlink(missing_ok=True)
        print(f'  rendered {dest.name}  {im.width}x{im.height}  {dest.stat().st_size / 1e6:.2f} MB')

    aerial = OUT / 'GC500_A1_Aerial_full_resolution.jpg'
    if aerial.is_file():
        for dest, width, q in ((WEB / 'AERIAL.webp', AERIAL_W, 62),
                               (WEB / 'AERIAL_HI.webp', AERIAL_HI_W, 62)):
            if not stale(dest, aerial):
                continue
            im = Image.open(aerial).convert('RGB')
            im = im.resize((width, round(im.height * width / im.width)), Image.LANCZOS)
            im.save(dest, 'WEBP', quality=q, method=5)
            print(f'  rendered {dest.name}  {im.width}x{im.height}  {dest.stat().st_size / 1e6:.2f} MB')


_MARKERS_CACHE: dict = {}


def build_markers():
    """Callout positions per sheet, in fractions of the page so the page can scale the image freely.

    Each marker also carries ax/ay — the same point expressed as a fraction of the aerial photograph the sheet is
    drawn over, worked out from that sheet's own placement rectangle. That is what lets the page show what a
    location looks like. A callout in the title block or a legend key sits on the page but not on the photograph,
    so it gets no ax/ay rather than a made-up one.
    """
    # A sheet's placement rectangle registers ONE thing to the photograph: the main plan. Text drawn anywhere
    # else on the page is not on that plan, so running its page position through the placement gives a point on
    # the photograph that means nothing. The extraction already records which region of the page each callout
    # was found in — Legend, Cypress inset, Off-site reference note, or the main plan — and that record is what
    # is obeyed here.
    #
    # This is the CP1 fault, which Andrew Fisher reported on 13 Sep 2026: the CP1 drop-off point was in the wrong
    # place. CP1 is drawn in the Cypress Avenue carpark inset in the bottom-right corner of D022, at its
    # own scale; read through the main plan's registration it came out in the Broadwater. The drawing crop was
    # right the whole time — the ring sits on the printed bubble — and the ground position was the invention.
    # It is not invented any more: where the callout sits on the sheet is shown, where it sits on the ground is
    # not claimed, and the page says which.
    if 'v' in _MARKERS_CACHE:                    # asked for twice a build; the walk is the same both times
        return _MARKERS_CACHE['v']
    sys.path.insert(0, str(ROOT / 'pipeline'))
    from aerial_placement import to_aerial
    # WHICH SHEETS ARE ON THE CIRCUIT IS A STATED FACT, NOT ONE THIS FUNCTION WORKS OUT. pipeline/sheet_frames.py
    # holds it, written on 11 Sep 2026 after Andrew Fisher found the Cypress carpark registered to the circuit —
    # Cypress Park did not look like Cypress Park. The imagery pipeline and the A1 plates have obeyed it since.
    # This function never asked it, and worked from the page placement instead, which is exactly the thing that
    # file exists to stop trusting. So the same fault walked back in through a different door: D016's WC81 and
    # P68 were given circuit positions 1.4 km out, with a reverse-geocoded Main Beach address printed beside the
    # wrong point, while the limitations document correctly said they had none. Both tests must now agree.
    import sheet_frames
    dd = loadjs(ROOT / 'app/data/source_drawings.js')
    # The bubble is not the thing. iEDM run a leader from each callout to the spot it means, and following it is
    # worth 20 to 100 points on this sheet — a good part of a compound. Where a leader was found the marker
    # points at its end; where none was, the bubble stands and the page says which it is using.
    lf = ROOT / 'extracts/drawings/leaders.json'
    leaders = json.loads(lf.read_text(encoding='utf-8')) if lf.exists() else {}
    # The regions each sheet declares, so a point that is not a callout — the end of a leader arrow — can be
    # asked which part of the page it is on. The extraction answers this for callouts; nothing was asking it
    # for arrow ends.
    _reg = json.loads((ROOT / 'pipeline/drawing_register.json').read_text(encoding='utf-8'))
    _regions = {sh['sheet_id']: (sh.get('rules') or {}).get('regions') or [] for sh in _reg['sheets']}

    def region_of(px, py, sheet_id):
        for r in _regions.get(sheet_id) or []:
            x0, y0, x1, y1 = r['rect']
            if x0 <= px <= x1 and y0 <= py <= y1:
                return r['name']
        return ON_PLAN
    place = {d['sheet_id']: d.get('aerial_placement') for d in D['drawings']}
    # Every ax/ay is a fraction of the photograph the page actually displays, which is D024's. A sheet drawn over
    # a different basemap — the K220–K231 strip is one — gets no ax/ay rather than a point on the wrong picture.
    ref = place.get(AERIAL_SOURCE_SHEET)
    by_sheet = {}
    for s in dd['sheets']:
        pts = s.get('page_points') or PAGE_PT
        w, h = float(pts[0]), float(pts[1])
        # a sheet not stated to be on the circuit gets no placement here, whatever its page numbers look like
        pl = place.get(s['sheet_id']) if sheet_frames.shares_circuit_frame(s['sheet_id']) else None
        out = []
        for kind, items in (('label', s.get('labels') or []), ('note', s.get('notes') or [])):
            for l in items:
                if l.get('x') is None:
                    continue
                fx, fy = round(l['x'] / w, 5), round(l['y'] / h, 5)
                m = {
                    'label': l.get('label'), 'kind': l.get('kind'), 'marker_kind': kind,
                    'fx': fx, 'fy': fy,
                    'context': l.get('context'), 'tag': l.get('tag_id'),
                }
                # How wide the callout bubble is drawn, as a fraction of the sheet's width. iEDM set every
                # callout in a circle about 2.2 times the height of the number inside it — measured off D022,
                # where a 26.1 pt number sits in a 57 pt circle. The ring the drop sheet draws has to sit OUTSIDE
                # that circle: Andrew Fisher, 13 Sep 2026, reading a ring drawn across the digits, pointed out that
                # P01 had been read as P61. A ring whose stroke lands on the number turns 001 into 081 on paper.
                th = l.get('text_height_pt')
                if th:
                    m['bub'] = round(2.2 * float(th) / w, 5)
                # A note obeys its region exactly as a callout does. It used to be exempt — the reasoning was
                # that a note is grouped drawing text and had no region recorded — but a region IS recorded for
                # it, and a legend note run through the main plan's registration lands on the photograph just as
                # wrongly as a legend callout would. Nothing moves today: no sheet that shares the photograph
                # carries a note. It closes the door before one does.
                ctx = l.get('context')
                on_plan = not ctx or ctx == ON_PLAN
                if not on_plan:
                    m['off_plan'] = ctx
                a = to_aerial(fx, fy, pl, ref) if on_plan else None
                if a:
                    m['ax'], m['ay'] = a
                # The point the callout's arrow actually reaches — which has to be on the main plan in its own
                # right, not merely start there. A leader can run off the plan: CP1's arrow on D022 ends at
                # (2160, 1285), inside the Cypress inset. CP1 is caught today because its bubble is in the inset
                # too, so nothing was ever placed from that end; a callout printed on the plan with its arrow
                # reaching into the inset would not have been caught, and its end is at the inset's scale, not
                # the plan's.
                ld = (leaders.get(s['sheet_id']) or {}).get(l.get('label')) if kind == 'label' else None
                if ld and on_plan:
                    t_ctx = region_of(ld['x'], ld['y'], s['sheet_id'])
                    if t_ctx != ON_PLAN:
                        m['t_off_plan'] = t_ctx
                    else:
                        tfx, tfy = ld['x'] / w, ld['y'] / h
                        t = to_aerial(tfx, tfy, pl, ref)
                        if t:
                            m['tx'], m['ty'] = t
                            m['t_from_label_pt'] = ld['from_label_pt']
                            m['t_bends'] = ld['bends']
                out.append(m)
        by_sheet[s['sheet_id']] = out
    _MARKERS_CACHE['v'] = by_sheet
    return by_sheet


from datetime import date as _date                               # noqa: E402

# The year the D007 day-by-day access block belongs to. The block writes "MON 19 OCT" with no year; the race
# dates on the event record carry one, and that is the only place it is stated.
EV_YEAR = int(re.search(r'(20\d\d)', EV['race_dates_as_supplied']).group(1))
MONTHS = {m: i for i, m in enumerate(['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT',
                                      'NOV', 'DEC'], start=1)}
DAY_HEAD = re.compile(r'^(MON|TUE|WED|THU|FRI|SAT|SUN)\s+(\d{1,2})\s+([A-Z]{3})$')
TIME_LINE = re.compile(r'^(\d{1,2}):(\d{2})\s*(am|pm):\s*(.*)$', re.I)


def track_access_days(lines: list, year: int) -> list:
    """D007's "Track access details" block, as one entry per calendar date.

    Wording is kept exactly as printed. The weekday is kept as written too, but the key is the calendar date,
    because the sheet's weekdays are not all this year's — "Tue 28 Oct" is 2025's Tuesday — and the existing
    date_warning tells the reader to trust the date, not the day.
    """
    days, cur, item = [], None, None
    for raw in lines:
        s = str(raw).strip()
        if not s or s.upper() == 'TRACK ACCESS DETAILS':
            continue
        m = DAY_HEAD.match(s.upper())
        if m and m.group(3) in MONTHS:
            try:
                iso = _date(year, MONTHS[m.group(3)], int(m.group(2))).isoformat()
            except ValueError:
                continue
            cur = {'date': iso, 'as_written': s, 'items': []}
            days.append(cur)
            item = None
            continue
        if cur is None:
            continue
        t = TIME_LINE.match(s)
        if t:
            hh, mm, ap, text = int(t.group(1)), t.group(2), t.group(3).lower(), t.group(4).strip()
            hh = hh % 12 + (12 if ap == 'pm' else 0)
            item = {'time': f'{hh:02d}:{mm}', 'time_as_written': f'{t.group(1)}:{mm}{ap}', 'text': text,
                    'bullets': []}
            cur['items'].append(item)
            continue
        if s == '·' or item is None:
            continue
        if s.startswith('(') and item['bullets']:
            item['bullets'][-1] += ' ' + s                       # a wrapped continuation of the bullet above
        else:
            item['bullets'].append(s)
    return days


def _derived_orientation():
    f = ROOT / 'extracts/drawings/orientation.json'
    return json.loads(f.read_text(encoding='utf-8')).get(AERIAL_SOURCE_SHEET) if f.exists() else None


def build_docs() -> dict:
    """The document register for the Documents tab, thumbnails inlined. Rebuilt on demand if it is missing."""
    f = OUT / 'doc_register.json'
    if not f.exists():
        subprocess.run([sys.executable, str(PRINT / 'build_doc_register.py')], check=True)
    reg = json.loads(f.read_text(encoding='utf-8'))
    docs = []
    for d in reg['docs']:
        e = {k: v for k, v in d.items() if k not in ('thumb', 'modified')}
        t = ROOT / d['thumb'] if d.get('thumb') else None
        e['thumb'] = data_uri(t) if t and t.is_file() else None
        # the page opens a file from beside itself: print/out/<name> or ../../sources/...
        rel = Path(d['file'])
        e['href'] = (rel.name if rel.parts[:2] == ('print', 'out') and len(rel.parts) == 3
                     else '/'.join(rel.parts[2:]) if rel.parts[:2] == ('print', 'out')
                     else '../../' + d['file'])
        docs.append(e)
    return {'built': reg['built'], 'counts': reg['counts'], 'doc_types': reg.get('doc_types'), 'swms_note': reg.get('swms_note'),
            'swms_dir': reg.get('swms_dir'), 'docs': docs}


def build_orientation():
    """Which way is north on the photograph. Measured from the registration when the Queensland imagery is in;
    otherwise the orientation derived from the drawings' own labels (pipeline/site_orientation.py)."""
    derived = _derived_orientation()
    cur = AS.current()
    if cur['kind'] != 'qld2022':
        return derived
    top = cur['up_is_bearing_deg']
    return {
        'north_deg_clockwise_from_sheet_top': round(cur['north_deg_clockwise_from_sheet_top'], 2),
        'sheet_top_bearing_deg': round(top, 2),
        'compass_at_top_of_sheet': 'east', 'compass_at_left_of_sheet': 'north',
        'compass_at_right_of_sheet': 'south', 'compass_at_bottom_of_sheet': 'west',
        'derivation': (f'Measured: the drawing frame was registered to the Queensland Government 2022 aerial '
                       f'(georeferenced) at {cur["fit_rms_m_ground"]:.2f} m RMS, which fixes the frame\'s rotation — '
                       f'the top of the sheet is bearing {top:.1f}°, so north is to the left. Read it against the '
                       f'compass on the picture. It is a bearing for finding your way, not a survey bearing.'),
        'confidence': f'measured from the registration (±{cur["fit_worst_m_ground"]:.1f} m worst residual)',
        'derived_from_labels': derived,
    }


def build_georef():
    """The frame's scale and position, so the page can say metres and coordinates truthfully — or nothing."""
    cur = AS.current()
    if cur['kind'] != 'qld2022':
        return None
    return {
        'm_per_frame_px_ground': cur['m_per_frame_px_ground'],          # at the 4760-px frame
        'frame_px': [4760, 2994],
        'frame_m_ground': cur['frame_m_ground'],
        'basemap_px_to_epsg3857': cur['basemap_px_to_epsg3857'],       # 2×3 affine, frame px → Web Mercator metres
        'fit_rms_m': round(cur['fit_rms_m_ground'], 2),
        'fit_worst_m': round(cur['fit_worst_m_ground'], 2),
        'captured': cur['captured'],
        'dataset': cur['name'],
        'licence': cur['licence'],
        'attribution': cur['attribution'],
        'short': cur['short'],
        'detail_m_per_px_ground': cur['detail_m_per_px_ground'],
        'up_is_bearing_deg': round(cur['up_is_bearing_deg'], 2),
    }


def build_aerial_note():
    cur = AS.current()
    if cur['kind'] == 'qld2022':
        return (f'{cur["title"]}: {cur["name"]}, captured {cur["captured"]}, {cur["resolution_native"]} native, '
                f'{cur["licence"]} — {cur["attribution"]}. Registered to the drawing frame at '
                f'{cur["fit_rms_m_ground"]:.2f} m RMS (worst {cur["fit_worst_m_ground"]:.2f} m), so it is to scale: '
                f'{cur["m_per_frame_px_ground"]:.2f} m per frame pixel, north to the left. The pixels are embedded '
                f'in this file; nothing is fetched from any map service. {cur["limits"]}')
    return ('The aerial photograph embedded in the supplied 26003 drawings, restored. '
            '4,760 px across the plotted width — 144 dpi at A1, which is all the detail that '
            'exists. It is undated, not georeferenced, and carries no scale bar. No external map '
            'provider or tile service was used and none is required.')


def build_access():
    """Where you get in and which gate is which — positions from D001, wording from D007.

    The heavy-vehicle entry matters most: eleven Week 5 loads arrive before the site opens and a driver needs to
    know which gate is theirs before they are on the highway. Which is exactly why this stopped taking positions
    from D007.

    D007 is not drawn over the photograph the satellite views use. It carries a wider view of the coast, placed
    at the same page origin, size and points-per-pixel, so every placement number agreed and the ground under a
    given fraction did not. Every access marker this returned until 21 Sep 2026 was read against the wrong
    picture and could be a kilometre or more from the street it named.

    D001 IS on that photograph, and carries the positions in its own right: 23 green ENTRY POINT boxes drawn AT
    the entry, and the nine gates. Those are what is placed now, and two of them were checked back against the
    ground — G8 reads as 31 Pacific Street, Main Beach and G4 as 3321 Surfers Paradise Boulevard.

    D007's wording is kept, and kept as wording. Its notes are text callouts positioned for legibility: carried
    onto D001's page through the nine-gate registration they sit 12 to 721 m from the nearest entry point, with
    no clear nearest in most cases. So the sheet still says what it says, and nothing here turns a sentence into
    a pin. Andrew Fisher, 21 Sep 2026: a placed thing is placed exactly where it is — never somewhere near
    it.
    """
    sys.path.insert(0, str(ROOT / 'pipeline'))
    from sheet_registration import registration
    dd = loadjs(ROOT / 'app/data/source_drawings.js')
    sheet = next((x for x in dd['sheets'] if x['sheet_id'] == 'D007-26003-02'), None)
    master = next((x for x in dd['sheets'] if x['sheet_id'] == ACCESS_POSITION_SHEET), None)
    if not sheet:
        return None
    KIND = [('HEAVY VEHICLE ENTRY', 'heavy'), ('ENTRY POINT', 'entry'), ('EXIT POINT', 'exit'),
            ('ACCREDITATION', 'accreditation'), ('PARK ON', 'parking'), ('TRACK ACCESS', 'track')]
    marks = (build_markers().get(ACCESS_POSITION_SHEET) or []) if master else []
    # Where D001 draws the gates and the entries. The gate tag inside the gate symbol on the fence run is the
    # closer of the two readings, so it wins where a gate carries both; the road label stands where it does not.
    drawn = {}
    for m in marks:
        if m.get('ax') is None:
            continue
        if m.get('kind') == 'gate_on_fence':
            drawn[str(m.get('label'))] = dict(m, on='the gate symbol on the fence run')
        elif m.get('kind') == 'gate_approach' and str(m.get('label')) not in drawn:
            drawn[str(m.get('label'))] = dict(m, on='the road label beside the entry point')
    entries = [dict(m, on='the entry itself') for m in marks
               if m.get('kind') == 'entry_point' and m.get('ax') is not None]

    # Which gate each named access point on D007 is, read off the two sheets and recorded in the register —
    # not worked out here by proximity, which does not answer it: D007's notes sit where they read clearly.
    named = {}
    try:
        _dreg = json.loads((ROOT / 'pipeline/drawing_register.json').read_text(encoding='utf-8'))
        _sh = next((x for x in _dreg['sheets'] if x['sheet_id'] == ACCESS_POSITION_SHEET), None)
        named = {k: v for k, v in ((_sh or {}).get('access_named') or {}).items() if not k.startswith('_')}
    except Exception:                                        # noqa: BLE001 — a register without the block is fine
        named = {}

    out = []
    for n in sheet.get('notes') or []:
        text = str(n.get('label') or '')
        kind = next((k for word, k in KIND if word in text.upper()), None)
        if not kind:
            continue
        rec = {'text': text, 'kind': kind, 'sheet': 'D007-26003-02'}
        hit = next((v for k, v in named.items() if k.upper() in text.upper()), None)
        g = drawn.get((hit or {}).get('gate')) if hit else None
        if g:
            # the position is the gate D001 draws, not where D007 sets the sentence
            rec.update({'ax': g['ax'], 'ay': g['ay'], 'fx': g['fx'], 'fy': g['fy'],
                        'gate': hit['gate'], 'position_from': ACCESS_POSITION_SHEET, 'position_on': g['on'],
                        'position_basis': hit.get('evidence')})
        else:
            rec.update({'ax': None, 'ay': None,
                        'no_position': ('D007 is drawn over a different photograph, and this note is a text '
                                        'callout placed to read clearly, not a marked point. No gate on '
                                        + ACCESS_POSITION_SHEET + ' has been followed to it.')})
        out.append(rec)
    reg = registration('D007-26003-02', ACCESS_POSITION_SHEET, ROOT / 'extracts/drawings')
    d7 = next((d for d in D['drawings'] if d['sheet_id'] == 'D007-26003-02'), None)
    blocks = (d7 or {}).get('text_blocks', [])
    return {
        'points': out,
        'points_note': ('D007 names the access points; it cannot place them, because it is drawn over a '
                        'different photograph from the one the satellite views use \u2014 a wider view of the '
                        'coast at the same page origin, size and points-per-pixel. Until 21 Sep 2026 these '
                        'notes WERE placed through it, up to 1.4 km from the street they name. A note is now '
                        'given a position only where a gate on ' + ACCESS_POSITION_SHEET + ' has been followed '
                        'to it and recorded; otherwise it keeps its words and says it has no position.'),
        'drawn_gates': list(drawn.values()),
        'drawn_entries': entries,
        'drawn_note': ('Every gate and entry ' + ACCESS_POSITION_SHEET + ' draws, on the photograph the '
                       'satellite views use. Twelve gates \u2014 G5A, G5B and G10 are set on two lines and were '
                       'missing from every reading of these sheets until 21 Sep 2026 \u2014 and 23 entry '
                       'boxes. Where a gate carries a tag inside the gate symbol on the fence run as well as '
                       'the road label, the fence tag is used: they are 10 to 15 m apart and the fence one is '
                       'the gate.'),
        'registration': reg,
        'sheet': 'D007-26003-02',
        # Andrew Fisher, 12 Sep 2026, asked for the D007-26003-02 prints and 2025 to be removed, to clear the confusion.
        # Two of this sheet's general notes set the one-way circuit direction by weekday AND date, and the pairs
        # are 2025's (it prints MONDAY 20 OCTOBER; in 2026 that is a Tuesday). Printed on our page beside 2026
        # work they read as this year's instruction. They are not shown. Nothing is corrected and nothing is
        # invented: the sheet still says what it says, and `date_note` below says why the line is not here.
        'general_notes': [ln for ln in next((b['lines'] for b in blocks if b.get('name') == 'General notes'), [])
                          if not WRONG_YEAR_DATE.search(str(ln))],
        'notes_withheld': [ln for ln in next((b['lines'] for b in blocks if b.get('name') == 'General notes'), [])
                           if WRONG_YEAR_DATE.search(str(ln))],
        'date_note': 'Two general notes on D007-26003-02 set the circuit direction by weekday and date, and those '
                     'pairs are 2025\u2019s — the sheet prints MONDAY 20 OCTOBER, which in 2026 is a Tuesday. They '
                     'are not shown here. iEDM own the sheet and the question is with them (Q26).',
        # The sheet's own day-by-day access times — gate closures, track opening laps, when contractors may get
        # back into Macintosh Park — keyed by calendar date so the per-day timeline can show them on the day.
        'day_notes': track_access_days(
            next((b['lines'] for b in blocks if b.get('name') == 'Track access details'), []), EV_YEAR),
        'date_warning': ('D007 general note 1 sets the one-way circuit direction by weekday and date, and the '
                         'weekdays are 2025\u2019s. Read the calendar date, not the weekday, until iEDM confirm '
                         '(question Q26).'),
        'authority': 'Access points and rules are read from D007-26003-02 as printed. iEDM own site access; this '
                     'is a copy of what their sheet says, not a Coates instruction.',
    }


def week_columns():
    return [{'sheet': w['sheet'], 'phase': w['phase'], 'start': w['start'], 'end': w['end'],
             'start_display': w['start_display'], 'rows': w['row_count']} for w in D['programme']['weeks']]


def theme_aware(css: str) -> str:
    """Make the dark palette answer the viewer's explicit theme as well as the OS setting.

    The page's own CSS switches on prefers-color-scheme only. claude.ai stamps data-theme="dark"/"light" on the
    root when a viewer chooses, and stamps nothing on "system" — so every dark block is kept under the media
    query but guarded against an explicit light choice, and repeated under :root[data-theme="dark"].
    """
    import re
    out, i = [], 0
    pat = re.compile(r'@media \(prefers-color-scheme:\s*dark\)\s*\{')
    while True:
        m = pat.search(css, i)
        if not m:
            out.append(css[i:]); break
        out.append(css[i:m.start()])
        depth, j = 1, m.end()
        while j < len(css) and depth:
            depth += {'{': 1, '}': -1}.get(css[j], 0); j += 1
        body = css[m.end():j - 1]
        # split the block into top-level rules
        rules, k, d, start = [], 0, 0, 0
        while k < len(body):
            ch = body[k]
            if ch == '{': d += 1
            elif ch == '}':
                d -= 1
                if d == 0: rules.append(body[start:k + 1]); start = k + 1
            k += 1
        guarded, explicit = [], []
        for r in rules:
            sel, _, decl = r.partition('{')
            sel = sel.strip()
            if not sel: continue
            if sel == ':root':
                guarded.append(':root:not([data-theme="light"]){' + decl)
                explicit.append(':root[data-theme="dark"]{' + decl)
            else:
                parts = [x.strip() for x in sel.split(',')]
                guarded.append(', '.join(':root:not([data-theme="light"]) ' + x for x in parts) + '{' + decl)
                explicit.append(', '.join(':root[data-theme="dark"] ' + x for x in parts) + '{' + decl)
        out.append('@media (prefers-color-scheme: dark){' + ''.join(guarded) + '}' + ''.join(explicit))
        i = j
    return ''.join(out)


def motion_off_twins(css: str) -> str:
    """Motion: Off means off. Outside audit, 17 Sep 2026 (B05): the Tools setting wrote html[data-motion="off"]
    and four rules read it, while some twenty @media (prefers-reduced-motion) blocks — the needle, the finder, the
    cut buttons, the day cards, the showcase, the signal lamps, the board's clip — answered only to the operating
    system. A setting that says "decorative motion is off" and leaves most of it running is not a setting.

    Rather than hand-copy twenty blocks and let them drift, every reduced-motion block in the stylesheet is
    followed by its twin, the same declarations under html[data-motion="off"]. motionApply() already sets that
    attribute for EITHER request (the Tools choice or the device's), so the twin covers both and the media block
    still covers the first paint before the script runs. The source keeps one copy; this writes the other."""
    out, pos = [], 0
    pat = re.compile(r'@media \(prefers-reduced-motion:\s*reduce\)\s*\{')
    for m in pat.finditer(css):
        start, depth, i = m.end(), 1, m.end()
        while i < len(css) and depth:
            depth += {'{': 1, '}': -1}.get(css[i], 0)
            i += 1
        body = css[start:i - 1]
        # rules of the block: selector{declarations}, no nesting inside these blocks
        twins, j = [], 0
        while True:
            o = body.find('{', j)
            if o < 0:
                break
            c = body.find('}', o)
            sels = body[j:o].strip()
            decl = body[o + 1:c].strip()
            j = c + 1
            if not sels or not decl:
                continue
            parts, buf, par = [], '', 0
            for ch in sels:
                par += {'(': 1, ')': -1}.get(ch, 0)
                if ch == ',' and par == 0:
                    parts.append(buf.strip()); buf = ''
                else:
                    buf += ch
            parts.append(buf.strip())
            twins.append(', '.join('html[data-motion="off"] ' + p.replace('\n', ' ').strip() for p in parts if p.strip()) + '{' + decl + '}')
        out.append(css[pos:i])
        if twins:
            out.append('\n/* Motion: Off twin (written by motion_off_twins) */ ' + ' '.join(twins) + '\n')
        pos = i
    out.append(css[pos:])
    return ''.join(out)


def as_fragment(html: str) -> str:
    """The hosted edition: no doctype/html/head/body of its own (the Artifact skeleton supplies them), a
    product-style title, and a theme-aware stylesheet. Everything else is byte-for-byte the same page."""
    head_end = html.index('</head>')
    head = html[:head_end]
    body = html[head_end + len('</head>'):]
    # keep the title and the stylesheet from the head; drop doctype, html, meta
    style_start = head.index('<style>')
    style = head[style_start:]
    body = body.strip()
    if body.startswith('<body>'):
        body = body[len('<body>'):]
    if body.endswith('</body></html>'):
        body = body[:-len('</body></html>')]
    css_open, css_close = style.index('<style>') + len('<style>'), style.rindex('</style>')
    style = '<style>' + theme_aware(style[css_open:css_close]) + '</style>'
    return f'<title>{APP_TITLE}</title>\n' + style + '\n' + body.strip() + '\n'


def main() -> int:
    ensure_web_images()
    global OPS
    OPS = json.loads(OPSFILE.read_text(encoding='utf-8')) if OPSFILE.is_file() else ops_layer.build()
    global FENCE
    FENCE = json.loads(FENCEFILE.read_text(encoding='utf-8')) if FENCEFILE.is_file() else {'columns': [], 'rate_gaps': [], 'week_sheets': []}
    markers = build_markers()
    cur = AS.current()
    place = {d['sheet_id']: d.get('aerial_placement') for d in D['drawings']}
    sheets = []
    for key, (title, sub, sheet_id) in SHEET_IMAGES.items():
        img = WEB / f'{key}.webp'
        if not img.exists():
            continue
        # Ground metres across the whole picture, so the map can draw a scale bar at any zoom. The aerial IS the
        # frame; a sheet picture is the page, and the frame sits on a known fraction of the page width.
        m_across = None
        # A scale bar only means something on a sheet drawn at the frame's scale. D016 is the Cypress Avenue
        # carpark at 1 : 200 — the same figure there would say the sheet is more than a kilometre across when it
        # is about two hundred metres. No bar is drawn rather than a wrong one.
        circuit = sheet_frames.shares_circuit_frame(sheet_id) if sheet_id else (key == 'AERIAL')
        own = sheet_frames.own_frame(sheet_id) if sheet_id else None
        if cur['kind'] == 'qld2022' and circuit:
            pl = place.get(sheet_id) if sheet_id else None
            if key == 'AERIAL':
                m_across = cur['frame_m_ground'][0]
            elif pl and pl.get('w') and pl.get('points_per_pixel') and pl.get('image_px'):
                frame_ppp = place.get(AERIAL_SOURCE_SHEET, {}).get('points_per_pixel') or pl['points_per_pixel']
                # metres per page point = frame metres per frame px / points per frame px
                m_per_pt = cur['m_per_frame_px_ground'] / frame_ppp
                m_across = m_per_pt * pl['page_points'][0]
        # The picture's own pixel size. The drop sheet crops the drawing round one callout, and to slide the
        # picture so the callout lands in the middle of the crop — and to stop sliding at the edge of the sheet,
        # so a crop is never half blank paper — it has to know how tall the picture is against how wide it is.
        from PIL import Image as _Im
        with _Im.open(img) as _i:
            px = [int(_i.width), int(_i.height)]
        sheets.append({
            'key': key, 'title': title, 'subtitle': sub, 'sheet_id': sheet_id,
            'src': data_uri(img),
            'px': px,
            'markers': markers.get(sheet_id, []) if sheet_id else [],
            'm_across': m_across,
            # Whether this sheet is drawn on the circuit. False means its picture is iEDM's own, its callouts sit
            # on their own ground, and nothing here may be read as a position on the circuit map.
            'circuit_frame': bool(circuit),
            'own_frame': ({'is': own['is'], 'read_from': own['read_from'], 'so': own['so'],
                           'found_by': own['found_by']} if own else None),
        })

    # trim the register to what the page needs, keeping every caveat
    assets = []
    for a in A['assets']:
        assets.append({k: a[k] for k in (
            'key', 'discipline', 'product', 'name', 'item_types', 'drawing', 'asset_numbers', 'asset_notes',
            'accessories', 'unparsed_notes', 'events', 'locations', 'customers', 'first_date', 'last_date',
            'days_between_first_and_last', 'weeks_between_first_and_last', 'duration_state', 'placements',
            'removals', 'movements_stated', 'demob_covered', 'demob_state', 'phases', 'asset_no_state',
            'accessory_count', 'drawing_links', 'position_state', 'pricing',
            'linked_to_2026_sheet', 'link_year_note',
            'hire', 'charge_lines', 'priceable', 'not_priceable_because',
            'offhire_state', 'offhire_note')}
            | {k: a[k] for k in ('reference_state', 'asset_number_caveats', 'origin', 'schedule_state', 'schedule_note', 'shared_row_note', 'tower_series', 'series_note', 'key_location') if k in a})

    car_uri = car_data_uri()
    car_run = car_run_data()
    race = re.search(r'(\d{1,2})\s*[–-]\s*(\d{1,2})\s+([A-Za-z]{3})\w*\s+(\d{4})', EV.get('race_dates_as_supplied') or '')
    MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
    race_days = ([f'{race.group(4)}-{MONTHS.index(race.group(3).lower()) + 1:02d}-{int(race.group(1)):02d}',
                  f'{race.group(4)}-{MONTHS.index(race.group(3).lower()) + 1:02d}-{int(race.group(2)):02d}']
                 if race and race.group(3).lower() in MONTHS else None)
    carrier_dates = sorted({l['date'] for l in D['transport']['carrier'].get('loads', [])})
    payload = {
        'brand': BR, 'event': EV,
        # The programme strip: race days read from the supplied dates, the first truck from the carrier's list,
        # and the car — the supplied photograph, embedded in the stylesheet — with where it came from.
        'race_days': race_days,
        'first_truck': carrier_dates[0] if carrier_dates else None,
        'car': ({'source': str(car_asset.source().relative_to(ROOT)) if car_asset.source() else None,
                 'is': ('the Coates #26 as a Chevrolet Camaro ZL1 — a rendering Andrew Fisher chose on 11 Sep 2026, made on his '
                        'ElevenLabs account from the #26 livery; it replaced the Mustang photograph he supplied that morning'
                        if car_asset.source() == car_asset.CAR else
                        'the photograph of the Coates #26 Mustang supplied by Andrew Fisher on 11 Sep 2026'),
                 'chosen_by': 'Andrew Fisher', 'chosen_on': '11 Sep 2026',
                 'illustrative': car_asset.source() == car_asset.CAR,
                 'note': 'sized for the web, never redrawn, recoloured or traced',
                 # The car running — frames of footage made from that photograph (see sources/brand/README.md and
                 # pipeline/car_run.py), which the page steps through while it carries the car along the strip. The
                 # sheet itself goes into the stylesheet; this is what it holds and where it came from. Without it
                 # the photograph is parked at the day and nothing pretends to move.
                 'run': ({'made_on': '11 Sep 2026',
                          'made_with': 'ElevenLabs image-to-video from the supplied photograph on a flat green field, keyed to transparency and cut into frames — nothing drawn',
                          **{k: v for k, v in car_run.items() if k != 'sheet'}} if car_run else None)}
                if car_uri else None),
        # Andrew Fisher's pit-lane picture, and the clip that drives into it. Where we are draws its board on this.
        'board': board_payload(),
        'raceBanners': race_banner_payload(),
        # v5.54 — one illustrative banner under each page heading but Today's (pipeline/page_banners.py)
        'pageBanners': page_banner_payload(),
        'circuit': circuit_payload(D),
        'surrounds': surrounds_payload(),
        # the constants that put the surroundings into the geospatial runtime's metres (see geo_frame_payload)
        'geoFrame': geo_frame_payload(),
        'tomtom': tomtom_payload(),
        # v5.81 — his labour, accommodation, meals and expense tracker: hours by his rule, never a dollar on an hour
        'workforce': workforce_payload(),
        # v5.56 — the water barriers: iEDM's drawing against the schedule and against iEDM's own installation
        # table, every difference named. The drawing's own totals travel inside it (pipeline/water_barriers.py).
        'barriers': barriers_payload(D),
        'holidays': holidays_payload(),
        'showSound': sound_payload(),
        'broadcast': broadcast_payload(),
        'machine': machine_payload(),
        'built': date.today().isoformat(), 'sources_taken': A['built'], 'build_version': A['build_version'],
        'dataset_sha256': D['content_sha256'],
        'register_sha256': A['content_sha256'],
        # The photograph on its own, at the resolution it actually holds, so a marker can be shown against what
        # the place looks like. Same image the map tab uses, four times the width.
        # The approved design's imagery (GC500_Claude_Design_Lock_Pack_v1, 11 Sep 2026). The hero is the
        # text-free daytime circuit Andrew Fisher chose on the ElevenLabs asset sheet — illustrative, never a
        # photograph of the site as it stands. The card pictures are his own Coates product photographs where he
        # supplied one; where he did not, the card carries its icon and no picture rather than a stand-in.
        'design': {
            'hero': data_uri(WEB / 'dsn_hero.webp') if (WEB / 'dsn_hero.webp').exists() else None,
            'hero_is': 'an illustrative daytime rendering of a street circuit, chosen by Andrew Fisher on 11 Sep '
                       '2026 — not a photograph of the Surfers Paradise circuit and not a setting-out map',
            'cards': {k: (data_uri(WEB / f'dsn_{k}.webp') if (WEB / f'dsn_{k}.webp').exists() else None)
                      for k in ('fencing', 'buildings', 'toilets')},
            'cards_are': "Coates product photographs supplied by Andrew Fisher on 11 Sep 2026, except fencing "
                         "which is an illustrative rendering made on his ElevenLabs account the same day",
            'master': 'GC500_Claude_Design_Lock_Pack_v1 · 01_APPROVED_DASHBOARD_MASTER.png (1672 × 941), approved '
                      'by Andrew Fisher 11 Sep 2026',
        },
        'aerial_hi': (data_uri(WEB / 'AERIAL.webp') if LIGHT and (WEB / 'AERIAL.webp').exists()
                      else data_uri(WEB / 'AERIAL_HI.webp') if (WEB / 'AERIAL_HI.webp').exists() else None),
        'aerial_hi_px': [AERIAL_W, round(2994 * AERIAL_W / 4760)] if LIGHT else [AERIAL_HI_W, AERIAL_HI_H],
        'edition': 'shared' if SHARED else 'hosted' if HOSTED else 'file',
        # The Documents tab: every SWMS, drawing, plate and pack the page can open or print (print/build_doc_register.py).
        # Thumbnails travel inline; the files themselves are opened from beside the page (file edition) or from the
        # service (hosted edition, matched by id). Nothing is listed that was not on disk at build time.
        'docs': build_docs(),
        # Where the hosted record lives — stated on the About tab so nobody has to guess. Andrew Fisher's call.
        'hosting_note': ('This copy is served by a small service on Railway under Andrew Fisher\'s account '
                         '(hosting/railway/server.js). The shared record is kept on that service\'s disk, with hourly '
                         'snapshots and a log of every write. A link is a key: the view link shows everything, the '
                         'edit link changes it; names are typed, not signed in.') if HOSTED else None,
        'orientation': build_orientation(),
        # Andrew Fisher's own product photographs, by the size class HE mapped them to — see product_photos()
        'product_photos': product_photos(),
        'georef': build_georef(),
        'access': build_access(),
        'aerial_note': build_aerial_note(),
        # The page stated "differ on seven rows" as prose. It is right today and would have gone stale the moment
        # the data moved, so the figures travel with the payload instead.
        'boq': {'row_differences': len(D['boq_reconciliation']['row_differences']),
                'substantive_differences': D['boq_reconciliation']['substantive_differences'],
                'boq_tab_rows': D['boq_reconciliation']['boq_tab_rows']},
        'authority': A['authority'],
        'accessory_authority': A['accessory_authority'],
        'pricing_authority': A['pricing_authority'],
        'summary': A['summary'],
        # How many barriers, as opposed to how many places barriers go. The register holds fifteen WB rows and
        # every one is a work front; the quantity is a note on the K sheets, and the master sheet and the detail
        # sheets disagree on two zones. Both totals travel, with the disagreement, so the page can never show a
        # barrier count as settled. Andrew Fisher pulled this up on 11 Sep 2026 — the page had been reading its
        # own row count as a quantity.
        # v5.56 — the drawing totals now travel inside the one barriers object, built by barriers_payload()
        # above, so there is one place the page reads barriers from and not two.
        'assets': assets,
        'orphan_rows': A['orphan_rows'],
        # Schedule rows that carry no GC500 reference (print/build_asset_register.py's orphan rows: eight VMS on a day,
        # five light towers to Molendinar, a forklift for Phillip Park). The register cannot hold them as assets, so
        # the page shows them on the day they are scheduled — as the schedule's words, never as a delivery confirmed
        # or a place on the map — and the Add tab can give one a reference, naming the row it came from. The
        # customer column stays out: it is Coates commercial detail, and the day view does not need it.
        # v5.83 — less the schedule's fencing rows (T0235–T0245, semis of fencing to Phillip Park): they are not
        # deliveries, and Andrew Fisher took them off the Timeline on 25 Sep 2026. They are held apart, named, in
        # plant_lines.fencing_rows_not_plant, and the Fencing tab says where they went.
        'unreferenced': [{**{k: o.get(k) for k in ('task_id', 'sheet', 'date', 'product', 'item', 'quantity_display', 'location',
                                                   'notes', 'asset_numbers', 'accessories', 'why', 'date_as_written', 'date_correction')},
                          **{k: r.get(k) for k in ('phase', 'discipline', 'activity', 'source_range', 'quantity_flag',
                                                   'transport_cost_text', 'transport_cost')}}   # v5.85 - the carrier charge, counted as Coates transport
                         for o in A['orphan_rows'] for r in [next((x for x in D['roster'] if x['task_id'] == o['task_id']), {})]
                         if (r.get('discipline') or '') != 'Fencing'],
        # What the Coates rental system holds against this event, as Andrew Fisher supplied it on 11 Sep 2026
        # (sources/rental/): branch code, rental contract, plant number, delivery number, hire start and off-hire
        # day, matched to the schedule only where both documents name the same number or plainly describe the same
        # movement. Andrew Fisher, 11 Sep 2026: on hire IS on site — the gear is there before he is, and he is
        # on site from Monday 14 Sep. So a rental start date puts a thing on site, credited to the rental system,
        # and a light a person sets on the ground overrides it. The client export strips the commercial detail:
        # branch codes, contract numbers and delivery numbers (see the internal keys in the export).
        'rental_on_hire': A.get('rental_on_hire'),
        # The schedule rows with no drawing reference, as plant in their own right — every VMS board, forklift,
        # the track mat and the tynes — keyed by the schedule's task id and shaped like an asset so everything
        # that counts, lights or prices an asset does the same to them (pipeline/plant_lines.py).
        # v5.85 - the fencing semis' rows carry the schedule's TPORT COST too: Coates organises the transport, so it is a
        # delivery cost Coates pays and stays with Coates transport (Andrew Fisher, 25 Sep 2026). From the roster, never typed.
        'plant_lines': (lambda pl: pl if not pl or not pl.get('fencing_rows_not_plant') else {**pl, 'fencing_rows_not_plant': [
            {**row, **{k: r.get(k) for k in ('transport_cost_text', 'transport_cost')}}
            for row in pl['fencing_rows_not_plant'] for r in [next((x for x in D['roster'] if x['task_id'] == row['task_id']), {})]]})(A.get('plant_lines')),
        'rate_card': A['rate_card'],
        'accessory_rate_card': A['accessory_rate_card'],
        # The 2026 circuit card matched to every item type on the job, by hand, with the reason on every line
        # (pipeline/rate_match.py). This is what the page prices with unless somebody types a rate over it.
        'rate_match': RATE_MATCH,
        # Andrew Fisher, 17 Sep 2026, on which days are charged and how labour is charged — his rules, in the record's words,
        # with no rate in it — the rates stay on the card.
        'charge_basis': CHARGE_BASIS,
        # The supplier's quotes for the rehire toilets — what Coates pays Event Portables, never what the customer
        # is charged (sources/pricing/rehire_toilets/, sent by Andrew Fisher on 17 Sep 2026).
        'rehire_quotes': REHIRE_QUOTES,
        # v5.83 — the same servicing at the card's pump-out rates, for comparison (toilet_servicing_at_card above)
        'toilet_servicing': TOILET_SERVICING,
        # v5.83 — the event labour scope, as transcribed; the page works it out and lays a person's changes over it
        'event_scope': EVENT_SCOPE,
        'sheets': sheets,
        'weeks': week_columns(),
        'states_legend': D['states_legend'],
        'transport': {'loads': D['transport']['loads_total'], 'early': D['transport']['early_total'],
                      'window_start': D['transport']['window_start'],
                      # The carrier's times are LOAD times at Coates Kingston — when the truck is loaded and leaves —
                      # not arrivals on site (Andrew Fisher, 11 Sep 2026). Each load carries the projected on-site
                      # time from the print dataset: load time + the Kingston run, a planning figure, never live.
                      'time_meaning': D['transport'].get('time_meaning'),
                      'times_are': D['transport'].get('times_are'),
                      'kingston_run': D['transport'].get('kingston_run'),
                      'site_eta_basis': D['transport'].get('site_eta_basis'),
                      # What Andrew Fisher says actually happens, which governs every arrival time on this page.
                      'arrival': D['transport'].get('arrival'),
                      'arrival_consequence': D['transport'].get('arrival_consequence'),
                      # The carrier's own day-by-day list, as written, so the per-day view can put the loads
                      # the carrier says are coming beside the assets the schedule says are due. The two are
                      # not paired here: a load names a building size, not a GC500 reference.
                      'carrier': {
                          'supplied_by': D['transport']['carrier'].get('supplied_by'),
                          'received': D['transport']['carrier'].get('received'),
                          'authority': D['transport']['carrier'].get('authority'),
                          'time_reading_note': D['transport']['carrier'].get('time_reading_note'),
                          'loads': [{'n': l['n'], 'date': l['date'], 'time': l['time_24h'],
                                     'time_as_written': l['time_as_written'], 'product': l['product'],
                                     'item': l['item'], 'early': l['early'],
                                     'site_eta': l.get('site_eta_planning'), 'early_on_site': l.get('early_on_site')}
                                    for d in D['transport']['days'] for l in d['rows']],
                      }},
        # Coates' own instructions to every driver coming onto this job. These are Andrew Fisher's, given as the
        # Shutdown Manager, and they are printed on every drop sheet as his — not as iEDM's and not as a rule
        # read off a drawing.
        'driver_rules': {
            'issued_by': f"{BR['author']}, {BR['role']}, {BR['org']}",
            'escort': 'Do not drive through the park unescorted.',
            'ppe': ['Hi-vis', 'Safety glasses', 'Steel-cap boots'],
        },
        'open_items': [{'id': i['id'], 'title': i['title'], 'finding': i['finding'],
                        'priority': i.get('priority_proposed'), 'status': i.get('status')}
                       for i in D['open_items']],
        # What was actually supplied, as committed by the last rebuild. Anything captured in this browser since
        # then sits alongside it and is shown as uncommitted, never merged into it — the two have to stay
        # tellable apart or nobody can say what the office has and what is still only on this laptop.
        'ops': OPS,
        # The eight cost categories, as the expectation words them (print/sources/cost_categories.json — supplied by
        # Andrew Fisher, 11 Sep 2026). Every cost line on the Costs tab names one; the ops layer checks the same list.
        'cost_categories': D.get('cost_categories') or {'categories': OPS.get('cost_categories') or []},
        # Who is doing what for Coates on the event and how to reach them — as Andrew Fisher listed it on 11 Sep 2026
        # (sources/team/event_team.json). Event roles as he assigned them; a missing number means none was available.
        'team': D.get('team'),
        # Andrew Fisher, 12 Sep 2026: each rental contract has a branch code and the branch code is the branch that gets
        # the revenue; each branch carries labour, transport, damages and subhire. The branches and what each usually
        # supplies, as he gave them, and the purchase orders he holds for the fencing subhire (sources/team/branches.json,
        # sources/purchase_orders/). Both are Coates commercial detail and stay off the iEDM pack.
        'branches': D.get('branches'),
        'purchase_orders': D.get('purchase_orders'),
        # Fencing has no asset references. A fencing variance names a week sheet and a fence type, so the page
        # needs the list of both to offer them rather than have somebody type a sheet name that does not exist.
        # The 2026 fencing programme (received 11 Sep 2026) is the plan: each week sheet with its span, its stated
        # totals and — for the sheets that carry 2026 dates — the plan by day, so "planned to date" is read by the
        # day. The removal weeks still carry 2025 dates and are marked not rolled forward; the page shows their
        # totals as a reference and never as a 2026 plan. Last year's programme rides along for comparison.
        'fencing': {
            'authority': D['fencing']['authority'],
            'source_file': D['fencing']['source_file'],
            'programme_year': D['fencing'].get('programme_year'),
            'received': D['fencing'].get('received'),
            'reference_basis': D['fencing'].get('reference_basis'),
            'not_rolled_forward': D['fencing'].get('not_rolled_forward') or [],
            'stray_years': D['fencing'].get('stray_years') or [],
            # A week with an installation plan (a later document from the programme's author — CW5, 11 Sep 2026) plans by
            # that document's days; the programme's own figures ride beside it as programme_totals / programme_totals per
            # day, and plan_update carries what changed, row by row, with the plan's own flags and page notes.
            'week_sheets': [{'sheet': w['sheet'], 'phase': w.get('phase'),
                             'span': w.get('span_as_written'), 'year': w.get('year'), 'rolled_forward': w.get('rolled_forward'),
                             'first_day': w.get('first_day'), 'last_day': w.get('last_day'),
                             'days': [{'date': d['date'], 'rows': d['rows'], 'totals': d['totals'], 'basis': d.get('basis'),
                                       'programme_totals': d.get('programme_totals')} for d in (w.get('days') or [])],
                             'totals': w.get('totals') or w.get('totals_as_stated') or {},
                             'totals_basis': w.get('totals_basis'),
                             'programme_totals': w.get('programme_totals'),
                             'plan_update': w.get('plan_update')}
                            for w in D['fencing']['week_sheets']],
            'installation_plans': D['fencing'].get('installation_plans'),
            'fence_types': sorted({k for w in D['fencing']['week_sheets']
                                   for k in (w.get('totals_as_stated') or {})}),
        },
        # v5.59 — the 2025 fencing programme is not carried in the page any more. Andrew Fisher, 19 Sep 2026: no
        # 2025 for fencing — it is all 2026. It stays filed under sources/historical/ as history.
        'variance_types': OPS['variance_types'],
        # The fencing columns and the 2026 card's rates for them, so a docket typed on site is priced the same way the build prices it.
        'fence': FENCE,
        # what closes, in what order, and when — the fencing crew's race weekend (v5.60)
        'closures': closures(),
        # Who does the fencing. Stated by Andrew Fisher on 10 Sep 2026; the rate workbook does not name them.
        'fence_contractor': {'name': 'Advanced Temporary Fencing', 'stated_by': 'Andrew Fisher', 'stated_on': '10 Sep 2026'},
        # Where most loads leave from. Stated by Andrew Fisher on 10 Sep 2026 (pipeline/depot.py is the one source
        # of the address, coordinates and planning assumptions — the print dataset uses the same). The page only
        # ever LINKS to live directions; the planning figure beside a location is this page's own arithmetic.
        'depot': {**DEPOT,
                  # The planning figure's assumptions, printed wherever the figure is. Not a live time.
                  'planning': {**PLANNING,
                               'basis': f'straight-line distance × {PLANNING["road_factor"]} for the road, at '
                                        f'{PLANNING["truck_kmh"]} km/h average for a truck, plus {PLANNING["precinct_min"]} '
                                        'minutes for the last kilometre through the precinct — assumptions, '
                                        'not a live estimate; the maps app gives the live one'}},
        # Fencing sheets in the drawing register, for the docket's map reference. Any project, any year — a
        # 2026 D001 lands here after a rebuild without anyone editing this file.
        'fence_sheets': fence_sheets(),
        'chargeable_states': OPS['chargeable_states'],
        # For the driver's drop sheet. Transcribed from the induction deck the same way the A3 site card is,
        # and carrying the same caveat: a working transcript, not the controlled document.
        'site': {
            'address': D['induction'].get('site', {}).get('address'),
            'hours': D['induction'].get('site', {}).get('hours_24h'),
            'hours_days': D['induction'].get('site', {}).get('hours_days'),
            'hours_qualifier': D['induction'].get('site', {}).get('hours_qualifier'),
            'contacts': [c for c in D['induction'].get('iedm_contacts', [])
                         if c.get('role') in ('Site Manager', 'Safety & Traffic Coordinator')],
            'authority': D['induction'].get('authority'),
        },
    }

    payload, media_note = share_repeated_media(payload)

    qr_js = (Path(__file__).resolve().parent / 'vendor/qrcode.min.js')
    html = (motion_off_twins(TEMPLATE).replace('/*__DATA__*/', json.dumps(payload, ensure_ascii=False, separators=(',', ':')))
                    .replace('/*__QRCODE__*/', qr_js.read_text(encoding='utf-8') if qr_js.exists() else 'var qrcode = null;')
                    # the 3D circuit backdrop's engine, after the showcase's own script (it takes over the lap
                    # lights' frame loop only when that backdrop is chosen and WebGL2 is there)
                    # the geospatial runtime goes in FIRST, because the scene bundle's geospatial backdrop
                    # reads window.GC500RT the moment it is asked whether it is available
                    .replace('/*__GC500RT__*/', geo_runtime())
                    .replace('/*__GC3D__*/', gc3d_bundle())
                    # No car rides the programme strip any more (Andrew Fisher, 12 Sep 2026: the rendering was
                    # not good enough), so neither the picture nor its sprite sheet is embedded.
                    # The car on the page is his own photograph, at the top of Today, Where we are and the
                    # Timeline. The rules stay in the stylesheet with nothing to fill them, so putting a
                    # picture back is one line here.
                    .replace('/*FONT_FACES_HERE*/', font_faces())
                    .replace('APP_TITLE_HERE', APP_TITLE)
                    # v5.87 - the #26 (print/web/car_26.webp) and the circuit at dusk (print/web/hz_backdrop.jpg, graded
                    # once from sources/brand/hero_circuit.png by hz_backdrop()) ride inline: the banner needs no media import.
                    .replace('__HZ_CAR__', hz_car_uri())
                    .replace('__HZ_BACKDROP__', hz_backdrop_uri())
                    # What a photograph or an invoice can be filed against, in the page's head where the hosted
                    # service reads it on every upload of the page (hosting/railway/server.js, uploadApp): every
                    # reference on the schedule, and the branches from sources/team/branches.json. Andrew Fisher,
                    # 16 Sep 2026: pictures assigned to locations, and invoices per branch. One list, here.
                    .replace('GC500_REFS_HERE', html_mod.escape(' '.join([a['key'] for a in assets]
                                                                       + [l['key'] for l in ((A.get('plant_lines') or {}).get('lines') or []) if l.get('key')]), quote=True))
                    .replace('GC500_BRANCHES_HERE', html_mod.escape(';'.join(f"{b['code']}={b.get('name') or ''}"
                                                                       for b in ((D.get('branches') or {}).get('branches') or [])), quote=True))
                    .replace('CAR_CSS_RULE', '')
                    .replace('CAR_RUN_CSS_RULE', ''))
    if HOSTED:
        from hosted_media import externalise_html
        html, hosted_media_manifest = externalise_html(html, OUT / 'media')
    dest = OUT / ('GC500_Delivery_Control_shared.html' if SHARED else 'GC500_Delivery_Control_hosted.html' if HOSTED else 'GC500_Delivery_Control.html')
    if SHARED:
        html = as_fragment(html)
    # The file and hosted editions start with a UTF-8 byte-order mark. The page declares its charset in the first
    # line, and every browser opening it over http honours that — but a phone opening the file from its own storage
    # (Edge on Android reading a content:// file, 11 Sep 2026) rendered the en dashes and middle dots as "â€“" and
    # "Â·", having decided on Windows-1252 before it read the meta. A BOM settles the encoding before any byte of
    # the page is read, in every browser. The shared edition is a fragment pasted into another page, so it carries
    # none — the page around it sets the encoding.
    if SHARED:
        dest.write_text(html, encoding='utf-8')
    else:
        dest.write_text(html, encoding='utf-8-sig')
    print(f'{dest.name}  {dest.stat().st_size / 1e6:.1f} MB  ·  {len(assets)} assets + {(A.get("plant_lines") or {}).get("count", 0)} plant lines · '
          f'{sum(len(s["markers"]) for s in sheets)} markers · {len(sheets)} sheets')
    return 0


TEMPLATE = r'''<!doctype html>
<html lang="en-AU"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="gc500-refs" content="GC500_REFS_HERE">
<meta name="gc500-branches" content="GC500_BRANCHES_HERE">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%277%27 fill=%27%231c1512%27/%3E%3Crect x=%277%27 y=%276%27 width=%275%27 height=%2720%27 rx=%272%27 fill=%27%23ff6a13%27/%3E%3Ctext x=%2715%27 y=%2722%27 font-family=%27Segoe UI,system-ui,sans-serif%27 font-size=%2714%27 font-weight=%27800%27 fill=%27%23fff%27%3E5%3C/text%3E%3C/svg%3E">
<title>APP_TITLE_HERE</title>
<style>
/*FONT_FACES_HERE*/
:root{
  /* --mute carries every small explanatory line on the page, so it has to clear 4.5:1 on --paper, not look
     tasteful at 3:1. This page gets read on a phone in daylight and printed on paper. */
  --ink:#14181d; --ink2:#39424c; --slate:#5f6a75; --mute:#646d77;
  /* Warmed a couple of degrees off neutral. The header is a warm near-black and the accent is a warm orange;
     cool blue-grey rules underneath them read as two palettes bolted together rather than one. */
  --rule:#e4e0dc; --rule2:#f1eeec; --paper:#fff; --tint:#f8f6f4; --tint2:#fcfbfa;
  /* The Coates palette, from the brand assets: #FF6A13 "Pumpkin", white, and #67370F "Sepia". There is no
     navy in it, which is why the header below is a warm near-black pulled from the sepia rather than the blue
     it used to be. --orange-ink is not a fourth brand colour: it is #FF6A13 dropped far enough that white text
     on it clears 4.5:1, which #FF6A13 itself does not (2.9:1). */
  --orange:#ff6a13; --orange-lt:#ff9a4d; --orange-ink:#b34a0d; --sepia:#67370f;
  --orange-soft:#fdf0e6; --navy:#4a3426; --navy-soft:#f4efe9;
  --red:#b3261e; --red-soft:#fdeeed; --amber:#8a5a00; --amber-soft:#fdf5e3;
  --green:#1f6b3a; --green-soft:#eaf4ee; --shadow:0 1px 2px rgba(20,24,29,.06),0 8px 24px rgba(20,24,29,.08);
  /* The header band is its own small palette. --navy flips to a light blue in dark mode because it is used as
     a text colour there, so a header background cannot borrow it — these stay dark in both schemes and are
     contrast-checked against each other, not against the page. */
  --hdr:#1c1512; --hdr-2:#2a1e17; --hdr-ink:#faf7f5; --hdr-mute:#c4b3a7; --hdr-rule:#43312a;
  /* Solid, not translucent. A control painted with rgba over a gradient has no computable background, so a
     contrast checker reads white-on-white and, more to the point, so does anyone looking at it on a bad screen. */
  --hdr-ctl:#3a2a20; --hdr-ctl-hi:#4a362a;
  /* The glow. Orange means "this is the thing you are touching" and nothing else on the page uses it that way. */
  --glow:rgba(255,106,19,.46); --glow-wide:rgba(255,106,19,.22);
  --lift:0 1px 2px rgba(20,24,29,.05), 0 10px 28px -8px rgba(20,24,29,.16);
  --lift-hi:0 2px 4px rgba(20,24,29,.07), 0 18px 42px -10px rgba(20,24,29,.24);
}
/* ------------------------------------------------------------------ the page is a day page
   Andrew Fisher, 12 Sep 2026: the day look, because the race is run in the day.

   That settles it, and it is the right call for three reasons beyond the obvious one. This gets read on a phone
   at a gate in Queensland sun, where dark screens lose to the glare. Nearly every screen here has a Print
   button, and a light page is already the page that comes out of the printer. And the Coates palette is orange,
   white and sepia — there is no charcoal in it, so a dark shell reads as somebody's dashboard rather than as
   Coates.

   So the page is light, as it was, and the ONE dark thing is the hero band at the top of Where we are: a
   daytime circuit with the programme drawn on the asphalt. A racing car needs a dark ground to look like
   anything, and the asphalt supplies it inside the picture rather than by painting the whole tool.

   The page still follows the phone into dark mode, as it always did — that is the reader's setting, not a
   design decision. */
@media (prefers-color-scheme: dark){:root{
  --hdr:#150f0d; --hdr-2:#211711; --hdr-ink:#faf7f5; --hdr-mute:#c4b3a7; --hdr-rule:#3a2a23;
  --hdr-ctl:#2f221a; --hdr-ctl-hi:#3f2e23;
  --glow:rgba(255,138,58,.50); --glow-wide:rgba(255,138,58,.26);
  --lift:0 1px 2px rgba(0,0,0,.4), 0 10px 28px -8px rgba(0,0,0,.55);
  --lift-hi:0 2px 4px rgba(0,0,0,.45), 0 18px 42px -10px rgba(0,0,0,.65);
  --ink:#eef1f4; --ink2:#c6cdd4; --slate:#9aa4ad; --mute:#9aa3ac;
  --rule:#332e2a; --rule2:#282320; --paper:#1a1614; --tint:#221d1a; --tint2:#1e1a17;
  --orange:#ff8a3a; --orange-lt:#ffab70; --orange-ink:#c9560f; --orange-soft:#2c2016;
  --navy:#d8b79a; --navy-soft:#2a1f17;
  --red:#f08279; --red-soft:#2c1a19; --amber:#e0b064; --amber-soft:#2a2317;
  --green:#79c395; --green-soft:#17251c; --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
}}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font:14px/1.45 "Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;color:var(--ink);
  background:var(--tint);font-variant-numeric:tabular-nums;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--orange)}

/* ---------------- shell */
.app{display:flex;flex-direction:column;height:100vh;height:100dvh}
header.top{background:linear-gradient(180deg,var(--hdr) 0%,var(--hdr-2) 100%);
  border-bottom:1px solid var(--hdr-rule);flex:0 0 auto;position:relative}
/* A hairline of Coates orange along the whole top edge. One line, and it reads as ours from a metre away. */
header.top::before{content:'';position:absolute;inset:0 0 auto;height:3px;z-index:1;
  background:linear-gradient(90deg,var(--orange) 0%,#f0a052 55%,var(--orange) 100%)}
/* ---------------- the primary bar
   Superior Audit, 15 Sep 2026, and Andrew Fisher's own read of it: too much space before you reach the work.
   The bar was a wrapping flex row carrying a lockup, a search box, a name field, five buttons, a sync pill and
   the clock. On a laptop it took two rows; on a phone it took three and stood 183px tall before a single line
   of the day appeared. It is now ONE row of a fixed height at every width — 84px on a desktop, 60px on a phone
   — and everything that is not identity, search, record state or time lives behind a labelled More. */
.skipwork{position:absolute;left:8px;top:-60px;z-index:200;padding:10px 16px;border-radius:0 0 10px 10px;
  background:var(--orange);color:#1b1207;font:800 13px/1 'Inter',var(--sans,system-ui,sans-serif);text-decoration:none;
  transition:top .12s ease}
.skipwork:focus{top:0;outline:3px solid #fff;outline-offset:-3px}
@media print{ .skipwork{display:none} }
.brandrow{display:flex;align-items:center;gap:14px;padding:0 16px;flex-wrap:nowrap}
.hbar{height:84px;min-height:84px}
.lockup{display:flex;align-items:center;gap:11px;flex:0 1 auto;min-width:0}
.lockup .brandtxt{min-width:0}
.brandtxt b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hmore{flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.hmore .cv{width:0;height:0;border:4px solid transparent;border-top-color:currentColor;margin-top:2px;opacity:.7}
.btn.iconb{min-width:38px;justify-content:center}
/* ---------------- the record strip
   What the RECORD is doing, beside the clock and never mixed with it. No animation: a pulsing dot reads as a
   live feed, and this page cannot stand behind that. */
.recstrip{display:flex;align-items:center;gap:8px;flex:0 0 auto;padding:6px 11px;border-radius:9px;
  border:1px solid var(--hdr-rule);background:var(--hdr-ctl);max-width:210px;min-width:0}
.recstrip .rsdot{width:8px;height:8px;border-radius:50%;flex:0 0 auto;background:var(--hdr-mute);
  box-shadow:0 0 0 3px rgba(255,255,255,.05)}
.recstrip .rsw{display:flex;flex-direction:column;gap:1px;min-width:0}
.recstrip .rsw b{font:800 10px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.09em;text-transform:uppercase;
  color:var(--hdr-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recstrip .rsw em{font:600 10px/1.2 'Inter',var(--sans,system-ui,sans-serif);font-style:normal;color:var(--hdr-mute);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}
.recstrip.shared .rsdot{background:#4ec97f;box-shadow:0 0 0 3px rgba(78,201,127,.16)}
.recstrip.pending .rsdot{background:var(--orange);box-shadow:0 0 0 3px rgba(255,138,58,.18)}
.recstrip.checking .rsdot{background:#9aa4ad}
.recstrip.offline .rsdot{background:#e08a6a;box-shadow:0 0 0 3px rgba(224,138,106,.16)}
.recstrip.view .rsdot{background:#8fb3d9;box-shadow:0 0 0 3px rgba(143,179,217,.16)}
.recstrip.local .rsdot{background:#d9b96a;box-shadow:0 0 0 3px rgba(217,185,106,.16)}
.recstrip.offline, .recstrip.local{border-color:rgba(224,138,106,.4)}

/* The tab strip scrolls sideways once there are eight of them. Without an edge hint nobody knows the ones past
   the fold exist — on a phone the strip is 732px of tabs in a 390px window. */
/* The strip still scrolls on a narrow phone — six buttons is 330px or so — with the same edge hint. A mask
   would clip the More menu, so the hint is a gradient overlay that the menu can draw over instead. */
nav.tabs{position:relative}
nav.tabs::-webkit-scrollbar{height:0}
/* the fade that masked the row's edge is gone with the scrolling row it masked (23 Sep 2026) */

.mark{width:5px;height:34px;background:var(--orange);border-radius:3px;flex:0 0 auto;
  box-shadow:0 0 14px 1px var(--glow-wide)}
.brandtxt b{display:block;font-size:12.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--hdr-ink)}
.brandtxt span{display:block;font-size:11px;color:var(--hdr-mute);margin-top:1px}
/* The event, given the weight it has on site. GC500 is what everybody calls it and what everybody looks for. */
.wordmark{display:flex;align-items:baseline;gap:9px;margin-top:3px}
.wordmark i{font-style:normal}
.wordmark .gc{font-size:21px;font-weight:800;letter-spacing:-.015em;line-height:1;color:#fff}
.wordmark .yr{font-size:12px;font-weight:700;letter-spacing:.1em;color:var(--orange-lt);line-height:1}
/* A chequer, two rows of 4px squares. A small motorsport nod that costs nothing and reads as deliberate —
   any more of it and a coordination document starts looking like a fan page. */
.wordmark .chq{display:inline-block;width:26px;height:9px;align-self:center;border-radius:1.5px;opacity:.92;
  margin-right:2px;
  background:
    linear-gradient(45deg,#fff 25%,transparent 25%,transparent 75%,#fff 75%) 0 0/8px 8px,
    linear-gradient(45deg,#fff 25%,transparent 25%,transparent 75%,#fff 75%) 4px 4px/8px 8px,
    var(--hdr-ctl)}
.wordmark .when{font-size:11px;color:var(--hdr-mute);letter-spacing:.04em;line-height:1;white-space:nowrap}
@media(max-width:640px){.wordmark .gc{font-size:18px}.wordmark .chq{display:none}}
.search{flex:1 1 260px;min-width:0;position:relative}
.search input{width:100%;padding:10px 34px 10px 13px;border:1px solid var(--hdr-rule);border-radius:9px;
  background:var(--hdr-ctl);color:var(--hdr-ink);outline:none;
  transition:border-color .16s, box-shadow .16s, background .16s}
.search input::placeholder{color:var(--hdr-mute)}
.search input:focus{border-color:var(--orange);background:var(--hdr-ctl-hi);
  box-shadow:0 0 0 3px var(--glow-wide)}
.search .x{position:absolute;right:6px;top:5px;border:0;background:none;color:var(--mute);cursor:pointer;
  font-size:18px;line-height:1;padding:4px 6px}
.search .x{color:var(--hdr-mute)}
header.top .btn{background:var(--hdr-ctl);border-color:var(--hdr-rule);color:var(--hdr-ink)}
header.top .btn:hover{background:var(--hdr-ctl-hi);border-color:var(--orange);
  box-shadow:0 0 0 3px var(--glow-wide)}
.tools{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
/* ---------------- the timing pod
   Andrew Fisher's one-look pack, 14 Sep 2026: a live running clock that looks like a V8 lap timer.
   The same housing as every other dark card on the page — espresso, orange edge, the two opposing chamfers —
   and the page's own racing numerals, set tabular so nothing shifts as the digits change.
   What it is NOT, said on the pod itself: this is the clock ON THIS DEVICE, read in Brisbane time. It is not a
   server clock and it says nothing about the record. The record's freshness is the sync state beside it, which
   has its own source and its own timestamp. */
/* 214px in the bar — the audit's 200-230px, measured rather than asserted. The numerals are tabular so the
   width never moves as the digits change. */
.tpodwrap{flex:0 0 214px;width:214px;align-self:center;position:relative}
.tpcard{--cut:12px;--edge:#3a2f27}
.tpcard > .face{display:block;padding:0}
/* Stacked, not strung out in a row: the zone, then the numerals, then the strip and what the clock IS. Laid
   out side by side the label and the numerals fought for the same 214px and overlapped. */
.tphead{display:flex;flex-direction:column;align-items:stretch;gap:1px;padding:7px 12px 6px;background:none;border:0;
  cursor:pointer;color:#f6f1ec;font:inherit;text-align:left;width:100%}
.tphead:focus-visible{outline:3px solid var(--orange);outline-offset:-3px;border-radius:10px 0 10px 0}
.tpk{display:flex;align-items:baseline;justify-content:space-between;gap:8px;min-width:0}
.tpk b{font:800 8.5px/1.15 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase;color:rgba(246,241,236,.82);white-space:nowrap}
.tpk i{font:600 8px/1.15 'Inter',var(--sans,system-ui,sans-serif);font-style:normal;letter-spacing:.09em;text-transform:uppercase;color:rgba(246,241,236,.5);white-space:nowrap;flex:0 0 auto}
/* the numerals: tabular, so the width never moves; the seconds in orange, the way a lap timer reads */
.tpnum{display:block;font-size:26px;line-height:1.02;color:#fff;font-variant-numeric:tabular-nums;white-space:nowrap;letter-spacing:-.015em}
.tpnum .sec{color:var(--orange)}
.tpnum .d{font-size:15px;color:rgba(246,241,236,.85);margin-right:.25em}
.tpnum .sep{color:rgba(246,241,236,.6)}
/* the seconds strip: twelve segments, one every five seconds. It is TIME, not delivery progress, and it says so
   in its own title — nothing on this pod ever stands for the record. */
.tpsec{display:flex;gap:2px;flex:1 1 auto;align-items:center;justify-content:space-between;margin-top:3px}
.tpsec i{display:block;flex:1 1 auto;height:3px;border-radius:1px;background:rgba(255,255,255,.14)}
.tpsec i.on{background:var(--orange);box-shadow:0 0 5px rgba(255,106,19,.6)}
/* the panel drops BELOW the pod rather than growing it, so opening the countdown never shoves the tabs down */
.tppanel{position:absolute;top:calc(100% + 6px);right:0;z-index:60;width:300px;max-width:calc(100vw - 24px);
  padding:2px 14px 13px;background:linear-gradient(160deg,#26201b 0%,#191411 100%);border:1px solid #3a2f27;
  box-shadow:0 18px 40px -12px rgba(0,0,0,.6);
  clip-path:polygon(0 0,calc(100% - 13px) 0,100% 13px,100% 100%,13px 100%,0 calc(100% - 13px));
  animation:finderIn .16s cubic-bezier(.2,.7,.2,1) both}
.tppanel[hidden]{display:none}
.tpsub{font:600 10.5px/1.4 'Inter',var(--sans,system-ui,sans-serif);color:rgba(246,241,236,.82);padding:8px 0 7px}
.tpmode{display:inline-flex;gap:0;border:1px solid rgba(255,255,255,.2);border-radius:7px;overflow:hidden}
.tpmode button{padding:5px 11px;border:0;background:#2f2823;color:#f6f1ec;font:700 11px/1 'Inter',var(--sans,system-ui,sans-serif);cursor:pointer}
.tpmode button + button{border-left:1px solid rgba(255,255,255,.2)}
.tpmode button[aria-pressed="true"]{background:var(--orange);color:#1b1207}
.tpmode button:focus-visible{outline:2px solid var(--orange);outline-offset:-2px}
.tpnote{margin:8px 0 0;font:400 10px/1.45 'Inter',var(--sans,system-ui,sans-serif);color:rgba(246,241,236,.6)}
.tpclose{margin-left:8px;padding:5px 11px;border:1px solid rgba(255,255,255,.25);border-radius:7px;background:none;
  color:#f6f1ec;font:700 11px/1 'Inter',var(--sans,system-ui,sans-serif);cursor:pointer;min-height:28px}
.tpclose:hover{border-color:var(--orange)} .tpclose:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
/* V11 audit: getting out of the phone's search, visibly */
.searchclose{position:absolute;right:6px;top:50%;transform:translateY(-50%);z-index:2;padding:6px 11px;
  border:1px solid var(--hdr-rule);border-radius:7px;background:var(--hdr-ctl-hi, var(--hdr-ctl));color:var(--hdr-ink);
  font:700 11.5px/1 'Inter',var(--sans,system-ui,sans-serif);cursor:pointer;min-height:32px}
.searchclose:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
body.search-open .search input{padding-right:78px}
body:not(.search-open) .searchclose{display:none}
.tpodwrap.expired .tpnum{color:rgba(246,241,236,.75)}
.tpprint{display:none}
/* a phone: a shallow strip across the top, above everything the day is about, rather than a second hero */
/* On a phone the pod shrinks to the clock itself inside the 60px bar. It used to take a full-width second line
   of its own (flex:1 1 100%), which is half of why the bar stood 183px tall. */
@media(max-width:860px){
  .tpodwrap{flex:0 0 auto;width:auto;max-width:132px}
  .tppanel{left:auto;right:0}
  .tphead{padding:4px 9px 5px;gap:0}
  .tpnum{font-size:19px;line-height:1}
  .tpsec{display:none}
  .tpk i{display:none}
}
@media(max-width:400px){
  .tpodwrap{max-width:108px}
  .tpk b{font-size:7.5px;letter-spacing:.08em}
  .tpnum{font-size:15px}
}
@media (prefers-reduced-motion:reduce){ .tpsec i{box-shadow:none} .tppanel{animation:none} }
html[data-motion="off"] .tppanel{animation:none}
/* on paper the clock is frozen at the moment the print was asked for, and says so. Record freshness comes from
   the dataset snapshot in the print note, never from this. */
@media print{
  .tpcard{background:#fff !important;border:1px solid #999;clip-path:none;--edge:#999}
  .tpcard > .face{background:#fff !important;color:#000 !important}
  .tphead, .tpk b, .tpk i, .tpnum{color:#000 !important}
  .tpsec, .tpmode, .tpnote, .tppanel{display:none !important}
  .tpprint{display:block;padding:0 12px 8px;font:600 8pt/1.3 'Inter',var(--sans,system-ui,sans-serif);color:#333}
}
/* the finder: the matches under the search box, on the page's own card, cut on the same corners */
.finder{position:absolute;left:0;top:calc(100% + 6px);z-index:60;background:var(--paper);color:var(--ink);
  width:max(100%, 640px);max-width:calc(100vw - 24px);
  border:1px solid var(--rule);border-radius:12px 0 12px 0;box-shadow:0 18px 40px -12px rgba(0,0,0,.45), 0 0 0 3px var(--glow-wide);
  max-height:min(62vh, 520px);overflow:auto;padding:6px;
  clip-path:polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
  animation:finderIn .16s cubic-bezier(.2,.7,.2,1) both}
@keyframes finderIn{from{opacity:.001;transform:translateY(-4px)} to{opacity:1;transform:none}}
.finder .fi{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;cursor:pointer;min-width:0;border:1px solid transparent}
.finder .fi + .fi{margin-top:2px}
.finder .fi:hover{background:var(--tint2)}
.finder .fi.on{background:var(--orange-soft, #fff3e8);border-color:var(--orange-lt, #ffb07a);box-shadow:0 0 0 2px var(--glow-wide)}
.finder .fim{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:1px;line-height:1.3}
.finder .fim b{font-size:13px;font-weight:800;letter-spacing:-.01em;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.finder .fim > span{font-size:11.5px;color:var(--ink2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.finder .fim small{font:600 9.5px/1 "Segoe UI",system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.finder .fiw{color:var(--mute)}
.finder .fik{flex:0 0 auto;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);
  border:1px solid var(--rule);border-radius:6px;padding:3px 6px;white-space:nowrap}
.finder .fi .dstat{flex:0 0 auto}
.finder .rplate{flex:0 0 auto;white-space:nowrap;overflow-wrap:normal}
.search input[type=search]::-webkit-search-cancel-button{-webkit-appearance:none;appearance:none}
.finder .fipin{flex:0 0 auto;min-width:36px;height:26px;padding:0 6px;border-radius:13px;background:var(--ink);color:#fff;font:800 12px/26px 'Inter',var(--sans,system-ui,sans-serif);text-align:center;letter-spacing:.02em;
  box-shadow:0 0 0 2px #fff, 0 0 0 3px rgba(0,0,0,.25)}
.finder .fipin.sh{background:var(--navy, #1b3a6b)}
.finder .fih{font-size:10.5px;color:var(--mute);padding:8px 10px 4px;letter-spacing:.02em}
@media(max-width:640px){ .finder{position:fixed;left:8px;right:8px;width:auto;top:auto;max-height:60vh} .finder .fi .dstat{display:none} }
/* the back button: where you were, one press away — and Alt+left */
.navback{display:inline-flex;align-items:center;gap:5px;padding:8px 12px 8px 9px;border:1px solid var(--hdr-rule);border-radius:9px;
  background:var(--hdr-ctl);color:var(--hdr-ink);font:700 12.5px/1 'Inter',var(--sans,system-ui,sans-serif);cursor:pointer;
  transition:border-color .15s, box-shadow .15s, transform .15s, background .15s}
.navback:hover{border-color:var(--orange);background:var(--hdr-ctl-hi);box-shadow:0 0 0 3px var(--glow-wide)}
.navback:active{transform:translateX(-1px)}
.navback:focus-visible{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px var(--glow)}
.navback[hidden]{display:none}
/* the word fits on a wide screen; everywhere else the chevron is the button, so the header keeps its one row */
.navback span{display:none}
.navback{padding:9px 9px}
@media(min-width:1560px){ .navback span{display:inline} .navback{padding:8px 12px 8px 9px} }
/* the marker the finder took you to: a ring that swells out of it three times, then it rests lifted. Both
   pseudo-elements on a marker are spoken for (the light on its shoulder, the hit box), so the ring is the
   marker's own shadow spreading — no extra element, nothing to collide with. */
.mk.locate{z-index:8;--k:1.22;animation:mkLocate 1.1s ease-out 3}
@keyframes mkLocate{0%{box-shadow:0 0 0 0 rgba(255,106,19,.95), 0 0 0 1.5px #fff} 100%{box-shadow:0 0 0 22px rgba(255,106,19,0), 0 0 0 1.5px #fff}}
@media (prefers-reduced-motion:reduce){ .finder{animation:none} .mk.locate{animation:none;box-shadow:0 0 0 4px var(--orange)} }
/* v5.79 — THE RING ROUND WHAT YOU SEARCHED FOR (Andrew Fisher, 24 Sep 2026): a search by asset or code number
   takes you to the thing on the main map with a highlighted circle round it. A circle, not a
   glow: drawn round the marker the search found, held at one size on the screen whatever the zoom (the same
   1/--z the pills use), swelling in three times so the eye finds it, then standing until the next search. It is
   its own element behind the pill, so the pill stays pressable and keeps its own light and hit box. */
.mkfound{position:absolute;width:64px;height:64px;border-radius:50%;pointer-events:none;z-index:5;box-sizing:border-box;
  transform:translate(-50%,-50%) scale(calc(1 / var(--z, 1)));border:3px solid var(--orange);
  box-shadow:0 0 0 2px #fff, 0 0 0 5px rgba(255,106,19,.30), 0 0 22px 6px rgba(255,106,19,.45), inset 0 0 0 2px #fff, inset 0 0 14px rgba(255,106,19,.35);
  animation:mkFoundIn 1.6s ease-out infinite}   /* v5.86 - it keeps breathing while the search stands (Andrew Fisher, 25 Sep 2026) */
@keyframes mkFoundIn{0%{box-shadow:0 0 0 2px #fff, 0 0 0 0 rgba(255,106,19,.9), 0 0 22px 6px rgba(255,106,19,.45), inset 0 0 0 2px #fff, inset 0 0 14px rgba(255,106,19,.35)}
  100%{box-shadow:0 0 0 2px #fff, 0 0 0 30px rgba(255,106,19,0), 0 0 22px 6px rgba(255,106,19,.45), inset 0 0 0 2px #fff, inset 0 0 14px rgba(255,106,19,.35)}}
@media (prefers-reduced-motion:reduce){ .mkfound{animation:none} }
/* the strip above the map that says what the ring is round, with the record one press away and a way to take the ring off */
.foundbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 10px;padding:8px 10px 8px 12px;border:1px solid var(--orange);
  border-radius:10px;background:color-mix(in srgb, var(--orange) 9%, var(--paper));font-size:13px;line-height:1.35}
.foundbar .fring{flex:none;width:18px;height:18px;border-radius:50%;border:3px solid var(--orange);box-shadow:0 0 0 1.5px #fff, 0 0 8px rgba(255,106,19,.6)}
.foundbar .fwords{flex:1 1 220px;min-width:0}
.foundbar .fwords b{font-weight:800}
.foundbar .fwords small{display:block;color:var(--mute);font-size:11.5px}
.foundbar .btn{padding:6px 10px;font-size:12px}
.foundbar .fx{flex:none;width:32px;height:32px;border-radius:8px;border:1px solid var(--rule);background:var(--paper);font-size:18px;line-height:1;cursor:pointer}
.foundbar .fx:hover{border-color:var(--orange)}
/* Who is holding the phone. Every light, supplied record and variance carries this name, so it lives in the
   header where it is seen on every tab rather than buried in one form. */
.who{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--hdr-mute);letter-spacing:.04em}
.who span{text-transform:uppercase;white-space:nowrap}
.who input{width:150px;padding:8px 10px;border:1px solid var(--hdr-rule);border-radius:8px;background:var(--hdr-ctl);
  color:var(--hdr-ink);outline:none;transition:border-color .16s, box-shadow .16s}
.who input::placeholder{color:var(--hdr-mute)}
.who input:focus{border-color:var(--orange);background:var(--hdr-ctl-hi);box-shadow:0 0 0 3px var(--glow-wide)}
.who input.need{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow);animation:whopulse 1.1s ease-in-out 3}
@keyframes whopulse{50%{box-shadow:0 0 0 6px var(--glow-wide)}}
@media(max-width:640px){.who span{display:none}.who input{width:120px}}

/* ---------------- inline link-buttons
   A reference or an "on the map" inside a sentence or a cell. Styled as a link so it reads as one, sized as a
   button so a thumb can hit it: 24px is the WCAG floor and the box is padded out to it invisibly. */
.linkish{display:inline-flex;align-items:center;min-height:24px;padding:0 4px;margin:0 -4px;border:0;background:none;
  color:var(--orange-ink);cursor:pointer;font:inherit;text-decoration:underline;text-decoration-color:var(--orange-lt);
  text-underline-offset:2px;border-radius:5px;transition:background .15s}
.linkish:hover{background:var(--orange-soft);text-decoration-color:var(--orange)}
.linkish:focus-visible{outline:3px solid #0b63c5;outline-offset:1px}
@media (prefers-color-scheme:dark){.linkish{color:var(--orange)}}

/* ---------------- the Today hub */
.hubhead{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin:2px 0 14px}
.hubhead h2{margin:0;font-size:24px;letter-spacing:-.015em;line-height:1.1}
.hubhead .sub{color:var(--slate);font-size:12.5px;margin-top:4px}
.hubwho{font-size:12.5px;color:var(--slate)}
.hub{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;align-items:start}
.hubcard{cursor:pointer;display:flex;flex-direction:column;gap:8px;position:relative;
  transition:box-shadow .18s, border-color .18s, transform .18s}
.hubcard:hover{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide), var(--lift-hi);transform:translateY(-1px)}
.hubcard:focus-visible{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px var(--glow)}
.hubcard.alert{border-top:3px solid var(--red)}
.hubcard:not(.alert){border-top:3px solid var(--orange)}
/* A card's heading and its chips, on one line where they fit and on two where they do not. They used not to
   wrap at all, so a chip whose words came out long — "15 due with nothing recorded" — pushed the whole page
   sideways on a phone. What a chip says depends on the record, so the layout has to hold for the longest thing
   it can ever say rather than the shortest it happens to say today. */
.hubtitle{display:flex;justify-content:space-between;align-items:center;gap:6px 8px;flex-wrap:wrap;max-width:100%}
.hubtitle h3{margin:0;font-size:15px;min-width:0}
.hubtitle .chip{min-width:0;max-width:100%;overflow-wrap:anywhere}
.hubbig{font-size:14px;color:var(--ink2)} .hubbig b{font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1;color:var(--ink)}
.hubbig .w{color:var(--mute);margin:0 4px}
.hublist{margin:0;padding:0;list-style:none;font-size:12.5px;display:grid;gap:4px}
.hublist li{display:flex;align-items:center;gap:7px;padding:3px 0;border-bottom:1px solid var(--rule2);min-width:0}
.hublist li .w{flex:1 1 auto;min-width:0;overflow-wrap:anywhere}
.hublist li:last-child{border-bottom:0}
.hublist .tm{font-weight:700;font-variant-numeric:tabular-nums;min-width:3.2em;white-space:nowrap}
.hublist.compact li{padding:2px 0}
.hublist .more{color:var(--mute);font-style:italic}
.hublist .hubrow{padding:5px 0;flex-wrap:wrap}
/* v5.84 — a clash row is a sentence, not a table: on a 340 px card the flex columns squeezed to one character each */
.clashcard .hublist li{display:block;line-height:1.5}
.clashcard .hublist li .tm{display:inline;margin-right:4px}
.clashcard .hublist li .w{display:inline}
.hublist .hubrow .anos{display:block;font-size:11px;margin-top:1px}
.hublist .hubrow .anos small{font:600 9px/1 "Segoe UI",system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.hubgo{margin-top:auto;font-size:12px;font-weight:700;color:var(--orange-ink);letter-spacing:.02em}
@media (prefers-color-scheme:dark){.hubgo{color:var(--orange)}}
.hublights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.hublights .hl{display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid var(--rule);border-radius:10px;background:var(--tint2);
  cursor:pointer;font-size:12px;text-align:left;white-space:normal;line-height:1.15;min-width:0;transition:border-color .15s, box-shadow .15s}
.hublights .hl b{font-size:16px}
.hublights .hl:hover{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide)}
.hubsheets{display:flex;flex-wrap:wrap;gap:6px}
.hubsheets .btn{padding:6px 10px;font-size:12px}
/* the attention dot on a tab or the Export button */
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--tl-red);margin-left:6px;vertical-align:1px;
  box-shadow:0 0 0 2px var(--hdr), 0 0 8px 1px rgba(214,40,28,.6)}
/* The dial card leads the hub and runs the full width of it — it is the first question anybody asks. */
.hubcard.wide{grid-column:1/-1}
.hubcard.wide .cnote{display:none}
@media(max-width:640px){.hub{grid-template-columns:1fr}.hubhead h2{font-size:20px}}

/* ---------------- the traffic light
   Red — not on site. Amber — in transit. Green — on site. Used identically on the map, the register, the plant
   pages, the timeline, the drawer and the drop sheet, so the same colour means the same thing wherever it is
   seen. These three are their own tokens: --red/--amber/--green on this page are text colours for chips and
   are too dark to read as lights at 10px. A hollow red is "red because nobody has said anything yet". */
:root{--tl-red:#d6281c; --tl-amber:#f0a600; --tl-green:#179a47; --tl-ring:#fff}
@media (prefers-color-scheme:dark){:root{--tl-red:#ef4a3d; --tl-amber:#ffbb1f; --tl-green:#2fc064; --tl-ring:#1a1614}}
.tl{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;white-space:nowrap;vertical-align:middle}
.tl i{flex:0 0 auto;width:12px;height:12px;border-radius:50%;border:2px solid var(--tl-ring);box-sizing:content-box;
  box-shadow:0 0 0 1px rgba(0,0,0,.18), inset 0 -2px 3px rgba(0,0,0,.22)}
/* dark ground: the ring is near-black, so a 1.5px line of the page's rule colour keeps the pip from bleeding into it */
@media (prefers-color-scheme:dark){.tl i{box-shadow:0 0 0 1.5px var(--rule), inset 0 -2px 3px rgba(0,0,0,.35)}}
/* the pip is a lit LED, not a paint dot: a hot centre, a coloured body and a glow in its own colour, the same
   language as the instrument at one twelfth the size */
.tl.red i{background:radial-gradient(circle at 38% 35%, #ffd7d3 0, var(--tl-red) 45%, #a3140a 100%);box-shadow:0 0 0 1px rgba(0,0,0,.18), 0 0 7px 1px rgba(230,40,28,.55), inset 0 -2px 3px rgba(0,0,0,.22)}
.tl.amber i{background:radial-gradient(circle at 38% 35%, #fff2c8 0, var(--tl-amber) 45%, #9a5d00 100%);box-shadow:0 0 0 1px rgba(0,0,0,.18), 0 0 7px 1px rgba(245,166,0,.6), inset 0 -2px 3px rgba(0,0,0,.22)}
.tl.green i{background:radial-gradient(circle at 38% 35%, #dfffe9 0, var(--tl-green) 45%, #0a5a26 100%);box-shadow:0 0 0 1px rgba(0,0,0,.18), 0 0 7px 1px rgba(30,180,90,.55), inset 0 -2px 3px rgba(0,0,0,.22)}
/* nothing recorded: a hollow NEUTRAL ring. It used to be a hollow red one, and at 12px across a register a
   hollow red ring simply reads as red — which quietly turned "nobody has said anything" into "recorded as not
   here". Grey says the honest thing: there is no record to colour. */
.tl.none i{background:transparent;border-color:var(--mute);box-shadow:none}
/* a green the rental system set, not a person: a ring of green around a green pip. Same colour, because it means
   the same thing — on site — and a different edge, because a person can still override it. */
.tl.hire i{box-shadow:0 0 0 1px rgba(0,0,0,.18), 0 0 0 3px rgba(23,154,71,.28), inset 0 -2px 3px rgba(0,0,0,.22)}
.tl .eta{font-weight:600;color:var(--ink2);font-variant-numeric:tabular-nums}
.tl .w{font-weight:500;color:var(--mute);font-size:11px}

/* ---------------- the working strip at the top of Today
   One row: the day, the counts, and a line saying what to chase. It is the first thing on the page and it fits
   inside one screen at 1366 x 768 with the hero still visible underneath it. */
.tstrip{display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding:13px 16px}
.tsday{display:flex;align-items:center;gap:10px;flex:0 0 auto}
.tsdow{font-size:12.5px;font-weight:700;color:var(--slate);line-height:1.25;max-width:9em}
.tsq-row{display:flex;gap:10px;flex-wrap:wrap;flex:1 1 auto;min-width:0}
/* On a phone the four tiles wrapped 2 / 1 / 1 and read as three rows of different things. A two-column grid
   makes it one block of four, which is what it is. */
@media(max-width:640px){ .tsq-row{display:grid;grid-template-columns:1fr 1fr;gap:8px} .tsq{padding:7px 10px 8px} }
/* v5.49 — THE TODAY TILES WEAR THE CARD LANGUAGE HE APPROVED, like everything else. They were 9px rounded
   boxes with a hairline border — the boxed look Andrew Fisher called out on 12 Sep 2026 as the standard to
   hold — sitting on a page whose own components are the 17px chamfer he settled on 14 Sep.
   Same geometry as .cut: a one-pixel edge behind a pearl face, the corner cut top-right and bottom-left, and
   the edge itself going orange on hover rather than a border colour changing under a shadow. The numerals
   were already Barlow Condensed bold italic and stay exactly as they were. */
.tsq{--cut:13px; --edge:var(--rule); --face:var(--tint2);
  display:flex;flex-direction:column;gap:0;align-items:flex-start;min-width:0;
  border:0;background:var(--edge);color:inherit;cursor:pointer;font:inherit;text-align:left;
  border-radius:11px 0 11px 0;padding:1px;position:relative;
  clip-path:polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
  transition:background .18s ease, box-shadow .18s ease, transform .18s ease}
.tsq > .tsqface{display:flex;flex-direction:column;align-items:flex-start;gap:0;width:100%;min-height:100%;
  background:var(--face);border-radius:10px 0 10px 0;padding:7px 12px 8px;
  clip-path:polygon(0 0, calc(100% - var(--cut) + 1px) 0, 100% calc(var(--cut) - 1px), 100% 100%,
    calc(var(--cut) - 1px) 100%, 0 calc(100% - var(--cut) + 1px))}
.tsq:hover{background:var(--orange);box-shadow:var(--lift);transform:translateY(-1px)}
.tsq:focus-visible{outline:3px solid #0b63c5;outline-offset:2px}
.tsq[disabled]{cursor:default;opacity:.75}
.tsq .tsqface b{font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;
  font-weight:700;font-size:27px;line-height:.9;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
.tsq .tsqface span{font-size:12px;font-weight:800;letter-spacing:-.005em;margin-top:2px}
.tsq .tsqface em{font-style:normal;font-size:10.5px;color:var(--ink2);font-weight:600}
/* the two groups that need chasing wear the page's unresolved tint — the same amber every unresolved fact wears,
   never the orange, which on this page means "where you are looking" and never "something is wrong" */
.tsq.gap{--face:var(--sem-gap-bg); --edge:var(--sem-gap-edge)}
.tsq.gap .tsqface b, .tsq.gap .tsqface span{color:var(--sem-gap-ink)}
.tsnote{flex:1 1 100%;font-size:12px;color:var(--mute);line-height:1.45;margin:0}
.tsnote b{color:var(--ink);font-variant-numeric:tabular-nums}
@media(max-width:640px){ .tstrip{gap:12px;padding:12px 13px} .tsq .tsqface{padding:6px 10px 7px} .tsq .tsqface b{font-size:23px}
  .tsq-row{gap:8px} .tsday{flex:1 1 100%} }
@media print{ .tstrip{break-inside:avoid} .tsq{background:#777 !important;clip-path:none !important} .tsq .tsqface{background:#fff !important;clip-path:none !important}
  .tsq.gap .tsqface{background:#fff !important;border-left:3px solid #000 !important} }

/* ---------------- the delivery status instrument
   One housing, three lenses, fixed left-red / centre-amber / right-green. Exactly one lens lights for a state
   somebody has recorded. NOTHING RECORDED LIGHTS NOTHING — a reference nobody has spoken about is not a
   reference recorded as absent. The words beside the housing carry the state, so the instrument never has to
   be read by colour alone: greyscale paper, a colour-blind reader and a screen reader all get the same sentence.
   The drawing itself is SVG (lampSvg): a machined housing, a bezelled recess for each lens, an LED matrix
   behind glass, and a bloom on the lit one. It is one drawing scaled to three sizes, sharp on any screen.
   Andrew Fisher, 14 Sep 2026: state-of-the-art supercar lights, animated — not a cheap visual. */
.dstat{display:inline-flex;align-items:center;gap:9px;vertical-align:middle;max-width:100%;min-width:0;flex-wrap:wrap}
.dstat .hz{flex:0 0 auto;display:block;filter:drop-shadow(0 2px 3px rgba(0,0,0,.38))}
/* the lamp group is drawn for every lens and shown for one — the state class on the wrapper picks it */
.dstat .hz .lens .lamp{opacity:0}
.dstat.red   .hz .lens.r .lamp, .dstat.amber .hz .lens.a .lamp, .dstat.green .hz .lens.g .lamp{opacity:1}
/* a lit lens hides its dark matrix, and the bezel's shadow on it eases — light fills the recess */
.dstat.red   .hz .lens.r .dots.off, .dstat.amber .hz .lens.a .dots.off, .dstat.green .hz .lens.g .dots.off{opacity:0}
.dstat.red   .hz .lens.r .shade, .dstat.amber .hz .lens.a .shade, .dstat.green .hz .lens.g .shade{opacity:.42}
/* THE POWER-ON. Only on a state that changed in front of the person (the `just` class, see lampJust): the
   outgoing lens is already dark by the time this draws — the record resolved first, the picture follows —
   and the incoming one strikes: dark, a fast rise past full, and a settle to steady, the way a bank of LEDs
   comes up behind a lens. About 320 ms, once. The halo overshoots and settles a beat later. */
@keyframes lampStrike{0%{opacity:0;transform:scale(.86)} 55%{opacity:1;transform:scale(1.06)} 100%{opacity:1;transform:scale(1)}}
@keyframes lampBloom{0%{opacity:0;transform:scale(.6)} 45%{opacity:.95;transform:scale(1.12)} 100%{opacity:.5;transform:scale(1)}}
@keyframes lampHalo{0%{opacity:0} 50%{opacity:1} 100%{opacity:.55}}
.dstat.just.red .hz .lens.r .lamp, .dstat.just.amber .hz .lens.a .lamp, .dstat.just.green .hz .lens.g .lamp{
  animation:lampStrike .32s cubic-bezier(.2,.9,.3,1.2) both;transform-origin:center;transform-box:fill-box}
.dstat.just.red .hz .lens.r .bloom, .dstat.just.amber .hz .lens.a .bloom, .dstat.just.green .hz .lens.g .bloom{
  animation:lampBloom .55s ease-out both;transform-origin:center;transform-box:fill-box}
.dstat.just.red .hz .lens.r .halo, .dstat.just.amber .hz .lens.a .halo, .dstat.just.green .hz .lens.g .halo{
  animation:lampHalo .6s ease-out both}
/* THE IDLE, removed. V11 audit: the detail-size lamps breathed continuously — a slow swell of the glow, four
   seconds a cycle, forever, on a page that may sit open on a screen in a site office all day.

   Two reasons it is gone. It is decorative work that carries on when nobody is looking at it, which is the
   thing the audit asked to stop. And a recorded fact that moves reads as a fact that is being CHECKED — a
   breathing green lamp looks like a live poll of the site, and this page has never polled anything. A light
   here is what somebody wrote down, and what somebody wrote down is steady.

   What remains is the settle: one 550 ms bloom when a lens genuinely changes state, and then still. */
.dstat.lg.just.red .hz .lens.r .bloom, .dstat.lg.just.amber .hz .lens.a .bloom, .dstat.lg.just.green .hz .lens.g .bloom,
.dstat.xl.just.red .hz .lens.r .bloom, .dstat.xl.just.amber .hz .lens.a .bloom, .dstat.xl.just.green .hz .lens.g .bloom{
  animation:lampBloom .55s ease-out both}
/* going dark is instant, on purpose: a lens fading out over a quarter of a second looks like it is still on */
@media (prefers-reduced-motion:reduce){ .dstat .hz .lens .lamp, .dstat .hz .lens .bloom, .dstat .hz .lens .halo{animation:none !important} }
html[data-motion="off"] .dstat .hz .lens .lamp, html[data-motion="off"] .dstat .hz .lens .bloom, html[data-motion="off"] .dstat .hz .lens .halo{animation:none !important}
/* rental-derived green: the same lamp, because it means the same thing */
.dstat.hire .hz .lens.g{outline:none}
.dstat .ds-w{flex:1 1 auto;min-width:8.5em;display:flex;flex-direction:column;gap:1px;line-height:1.25}
.dstat .ds-w b{font-weight:800;font-size:13px;letter-spacing:-.005em;overflow-wrap:break-word}
.dstat .ds-w em{font-style:normal;font-weight:600;color:var(--mute);font-size:11px;overflow-wrap:break-word}
.dstat.none .ds-w b{color:var(--ink2)}
/* four sizes: a dense row, a card, the detail in the drawer, the hero. The words stay OUTSIDE the housing at
   every size. */
.dstat.sm{gap:7px}
.dstat.sm .ds-w b{font-size:12px} .dstat.sm .ds-w em{font-size:10.5px}
.dstat.sm .ds-w em{display:none} .dstat.sm.why .ds-w em{display:block}
.dstat.sm .ds-w{min-width:0;flex:0 0 auto} .dstat.sm .ds-w b{white-space:nowrap}
.dstat.lg{gap:14px} .dstat.lg .ds-w b{font-size:17px;letter-spacing:-.01em} .dstat.lg .ds-w em{font-size:12px}
/* the hero stacks: the housing with its labels, then the state in racing capitals under it */
.dstat.xl{gap:14px;flex-direction:column;align-items:flex-start}
.dstat.xl .ds-w{min-width:0;flex:0 0 auto}
.dstat.xl .ds-w b{font-size:34px;letter-spacing:-.01em;font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;text-transform:uppercase;font-weight:800;line-height:.9}
.dstat.xl .ds-w em{display:none}
.dstat.bare .ds-w{display:none}
.dstat.bare{gap:0}
@media(max-width:560px){ .dstat.lg .hz{width:132px;height:51px} .dstat.lg .ds-w b{font-size:15px}
  .dstat.xl .hz{width:182px;height:70px} .dstat.xl .ds-w b{font-size:21px} }
/* THE CONTROL. The instrument with a press target laid over each lens — a third of the housing each, the
   full height, so a thumb in a glove has the whole lens and a margin. Nothing is drawn for the target itself:
   the lens under it pre-lights on hover, wears a ring on keyboard focus, and strikes when it is set. */
.dstat .hzc{position:relative;display:inline-block;line-height:0;flex:0 0 auto;margin:0;padding:0}
.dstat .hzc .hz{display:block;position:relative;z-index:1}
.tlset .lb{position:absolute;top:0;bottom:0;width:33.34%;z-index:2;padding:0;margin:0;border:0;background:transparent;cursor:pointer;
  -webkit-tap-highlight-color:transparent;font:inherit;color:inherit;outline:none}
.tlset .lb.r{left:0} .tlset .lb.a{left:33.33%} .tlset .lb.g{left:66.66%}
.dstat .hz .lens .lamp{transition:opacity .14s ease-out}
.dstat.ctl:not(.red) .lb.r:hover ~ .hz .lens.r .lamp, .dstat.ctl:not(.amber) .lb.a:hover ~ .hz .lens.a .lamp,
.dstat.ctl:not(.green) .lb.g:hover ~ .hz .lens.g .lamp{opacity:.32}
.lb.r:active ~ .hz .lens.r, .lb.a:active ~ .hz .lens.a, .lb.g:active ~ .hz .lens.g{
  transform:scale(.96);transform-origin:center;transform-box:fill-box}
.lb.r:focus-visible ~ .hz .lens.r .bz, .lb.a:focus-visible ~ .hz .lens.a .bz, .lb.g:focus-visible ~ .hz .lens.g .bz{stroke:#4da3ff;stroke-width:3}
.lb:focus-visible ~ .hz{filter:drop-shadow(0 0 0 2px #0b63c5)}
/* the big control says its words under each lens */
.dstat .hzc.big{padding-bottom:20px}
.tlset.big .lb .tlw{position:absolute;left:50%;top:100%;transform:translateX(-50%);margin-top:6px;white-space:nowrap;
  font:700 9.5px/1 'Inter', var(--sans, system-ui, sans-serif);letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
@media(max-width:560px){ .tlset.big .lb .tlw{font-size:8.5px;letter-spacing:.05em} }
.tlset.big .lb[aria-pressed="true"] .tlw{color:var(--ink)}
.dstat.ctl.none .hzc.big .tlw{color:var(--ink2)}
/* a thumb: the row control grows to card size, so each lens is a 35 x 41 target */
@media (pointer:coarse){ .dstat.sm.ctl .hz{width:106px;height:41px} }
@media (prefers-reduced-motion:reduce){.dstat .hz .lens .lamp{transition:none} .lb:active ~ .hz .lens{transform:none}}
/* the big one in the drawer */
.tlcard{display:grid;grid-template-columns:auto 1fr;gap:12px 14px;align-items:center}
.tlcard.one{grid-template-columns:1fr;gap:8px}
.tlcard > *{min-width:0;overflow-wrap:anywhere}
@media(max-width:640px){.tlcard{grid-template-columns:1fr}}
.tlcard .big i{width:22px;height:22px;border-width:3px}
.tlcard .big{font-size:15px;gap:10px}
.tlcard .since{font-size:11.5px;color:var(--mute);line-height:1.45}
.tlhist{margin:8px 0 0;padding:0;list-style:none;font-size:11.5px;color:var(--ink2)}
.tlhist li{padding:3px 0;border-bottom:1px solid var(--rule2);display:flex;gap:8px;align-items:center}
/* an open breakdown: a red "!" on the marker's other shoulder */
.mk .bdx{position:absolute;left:-6px;top:-7px;width:14px;height:14px;border-radius:50%;background:var(--tl-red);color:#fff;
  font:800 10px/14px "Segoe UI",system-ui,sans-serif;text-align:center;border:1.5px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.35);font-style:normal;z-index:1}
tbody tr.stop, tbody tr.stop:hover{background:var(--red-soft)}
.card.alert{border-top:3px solid var(--red)}
/* a marker's light: a dot on the pill's shoulder, never covering the ID */
.mk[data-lt]::before{content:'';position:absolute;right:-4px;top:-4px;width:9px;height:9px;border-radius:50%;
  border:1.5px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.35);z-index:1}
/* a lit marker glows in its light's colour — the whole pill, faintly, so a sheet reads at a glance: where the
   green is, where the amber is still moving. The amber one breathes, because in transit is the one state that
   is actually changing. Nothing recorded glows nothing. */
.mk[data-lt="red"]::before{background:radial-gradient(circle at 38% 35%, #ffd7d3 0, var(--tl-red) 45%, #a3140a 100%);box-shadow:0 0 0 1px rgba(0,0,0,.35), 0 0 6px 1px rgba(230,40,28,.7)}
.mk[data-lt="amber"]::before{background:radial-gradient(circle at 38% 35%, #fff2c8 0, var(--tl-amber) 45%, #9a5d00 100%);box-shadow:0 0 0 1px rgba(0,0,0,.35), 0 0 6px 1px rgba(245,166,0,.75)}
.mk[data-lt="green"]::before{background:radial-gradient(circle at 38% 35%, #dfffe9 0, var(--tl-green) 45%, #0a5a26 100%);box-shadow:0 0 0 1px rgba(0,0,0,.35), 0 0 6px 1px rgba(30,180,90,.7)}
.mk[data-lt="green"]{box-shadow:0 0 0 1.5px rgba(255,255,255,.55), 0 0 10px 2px rgba(30,180,90,.45), 0 1px 4px rgba(0,0,0,.45)}
.mk[data-lt="amber"]{box-shadow:0 0 0 1.5px rgba(255,255,255,.55), 0 0 10px 2px rgba(245,166,0,.5), 0 1px 4px rgba(0,0,0,.45);animation:mkamber 2.6s ease-in-out infinite}
.mk[data-lt="red"]{box-shadow:0 0 0 1.5px rgba(255,255,255,.55), 0 0 9px 2px rgba(230,40,28,.4), 0 1px 4px rgba(0,0,0,.45)}
@keyframes mkamber{0%,100%{box-shadow:0 0 0 1.5px rgba(255,255,255,.55), 0 0 8px 1px rgba(245,166,0,.35), 0 1px 4px rgba(0,0,0,.45)} 50%{box-shadow:0 0 0 1.5px rgba(255,255,255,.55), 0 0 14px 4px rgba(245,166,0,.65), 0 1px 4px rgba(0,0,0,.45)}}
@media (prefers-reduced-motion:reduce){.mk[data-lt="amber"]{animation:none}}
html[data-motion="off"] .mk[data-lt="amber"]{animation:none}
.mk[data-lt="none"]::before{background:transparent;border-color:var(--tl-red);box-shadow:0 0 0 1px rgba(255,255,255,.6)}
.mk.off{opacity:.14}
.lightbar{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:0 0 10px}
.lightbar .lead{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--slate);font-weight:600;margin-right:4px}
.lightbar button{padding:5px 11px 5px 8px;border:1px solid var(--rule);background:var(--paper);border-radius:20px;cursor:pointer;
  font-size:12px;display:inline-flex;align-items:center;gap:6px;transition:border-color .15s, box-shadow .15s}
.lightbar button:hover{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide)}
.lightbar button[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.lightbar button[aria-pressed="true"] .tl i{border-color:var(--ink)}
.lightbar button b{font-variant-numeric:tabular-nums}

/* ---------------- fencing dockets */
.fqgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.fqgrid input::placeholder{font-size:11px}

/* ---------------- the per-day timeline */
/* --------------------------------------------------------------- the cut card, shared
   Andrew Fisher, 14 Sep 2026: the same orange surfaces, shaped corners, typography and labelled colour pills
   throughout. So the treatment is defined ONCE here and every surface that wears it — the programme date
   cards, the daily panels, the attention cards, the driver card — uses these classes. A look that is
   re-implemented per screen is a look that drifts apart by the third screen.

   The shape is a clip-path, which takes the corners off but also clips anything drawn outside the element,
   including a focus ring — the one thing that must never be clipped. So a cut card is two elements: the outer
   is the SHAPE and carries the edge colour, the inner sits one pixel inside it in the same shape. The perimeter
   edge is the outer showing through, diagonals included, and keyboard focus is that edge grown to three pixels,
   which follows the cut corners because it IS the card. */
.cut{--cut:17px; --edge:var(--rule); --face:var(--paper);
  padding:1px;border:0;background:var(--edge);position:relative;font:inherit;text-align:left;
  border-radius:13px 0 13px 0;
  clip-path:polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
  transition:background .18s ease, transform .18s ease, box-shadow .18s ease}
.cut > .face{display:block;background:var(--face);border-radius:12px 0 12px 0;min-height:100%;
  font-family:'Inter', var(--sans, system-ui, sans-serif);
  /* one pixel less of a cut than the outside, so the diagonal edge has the same weight as the straight ones */
  clip-path:polygon(0 0, calc(100% - var(--cut) + 1px) 0, 100% calc(var(--cut) - 1px), 100% 100%,
                    calc(var(--cut) - 1px) 100%, 0 calc(100% - var(--cut) + 1px));
  transition:background .18s ease}
button.cut{cursor:pointer}
button.cut:hover{--edge:var(--orange-lt);transform:translateY(-1px);box-shadow:var(--lift)}
button.cut:focus-visible{outline:none;--edge:var(--orange);padding:3px}
/* The livery. Andrew's own stops — #FF8E35 through #FF761B to Coates orange #FF6A13 — charcoal text, and a
   shadow tinted from the orange rather than a grey drop. Orange is a NAVIGATION state on these surfaces: it is
   where you are looking, never work that is finished, so nothing wearing it carries a tick. */
.cut.on{--edge:#d0530a; --face:linear-gradient(152deg, #FF8E35 0%, #FF761B 48%, #FF6A13 100%);
  box-shadow:0 6px 18px -6px rgba(255,106,19,.55), 0 2px 5px -2px rgba(27,18,7,.28)}
.cut.on > .face{background:var(--face);color:#1b1207}
button.cut.on:hover{--edge:#b8480a}
button.cut.on:focus-visible{--edge:#1b1207}
.cut.dark{--edge:#2a231e; --face:linear-gradient(160deg, #26201b 0%, #191411 100%)}
.cut.dark > .face{background:var(--face);color:#f6f1ec}
@media (prefers-reduced-motion:reduce){.cut,.cut > .face{transition:none} button.cut:hover{transform:none}}
/* the racing numeral: Barlow Condensed bold italic, embedded with the page so it is the same on any device */
.racenum{font-family:'Barlow Condensed', 'Arial Narrow', var(--sans, system-ui, sans-serif);
  font-style:italic;font-weight:700;line-height:.86;letter-spacing:-.01em;font-variant-numeric:tabular-nums;
  display:inline-block}
/* ---------------- the reference plate
   The GC500 reference on an orange plate, cut on the same two corners as the cards. It is the thing a driver
   reads from three metres away through a windscreen, so it gets the strongest surface the page has.
   What is NOT on it: the asset number. A reference (P33) names a line on the schedule; an asset number
   (453375) names a physical machine in the Coates fleet, and the two get confused at a gate often enough
   without a design that prints them on one plate. The number stays a separate labelled field.
   Sized in em, so one class serves a 12px row and a 60px drop sheet. */
.rplate{display:inline-flex;align-items:center;justify-content:center;
  font-family:'Barlow Condensed', 'Arial Narrow', var(--sans, system-ui, sans-serif);
  font-style:italic;font-weight:700;line-height:.86;letter-spacing:-.01em;font-variant-numeric:tabular-nums;
  background:linear-gradient(152deg,#FF8E35 0%,#FF761B 48%,#FF6A13 100%);color:#1b1207;
  padding:.2em .34em .24em;box-shadow:0 2px 6px -2px rgba(255,106,19,.5);
  clip-path:polygon(0 0,calc(100% - .3em) 0,100% .3em,100% 100%,.3em 100%,0 calc(100% - .3em));
  max-width:100%;overflow-wrap:anywhere;text-align:center}
/* on a surface that is already orange — a selected card, a selected date — the plate inverts to espresso so it
   stays a plate instead of dissolving into the card behind it */
.cut.on .rplate, .rplate.inv{background:#241b16;color:#ffb673;box-shadow:none}
.cut.dark .rplate{box-shadow:none}
@media print{ .rplate{ background:var(--orange) !important; color:#1b1207 !important; box-shadow:none !important;
  -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  /* backgrounds off: the plate loses its fill, so it keeps a heavy outline and stays a plate on the page */
  .rplate{ outline:1.5pt solid #111; outline-offset:-1.5pt } }
/* the labelled pills. Every one of them carries its words, so the meaning survives greyscale, a photocopier and
   anybody who does not see colour the way the designer does. */
.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 9px;
  border-radius:7px;border:1px solid transparent;white-space:nowrap;font-family:'Inter', var(--sans, system-ui, sans-serif)}
.pill b{font-weight:800;font-variant-numeric:tabular-nums}
.pill.load{background:var(--sem-plan-bg);color:var(--sem-plan-ink);border-color:var(--sem-plan-edge)}
.pill.gap{background:var(--sem-gap-bg);color:var(--sem-gap-ink);border-color:var(--sem-gap-edge)}
.pill.late{background:var(--sem-stop-bg);color:var(--sem-stop-ink);border-color:var(--sem-stop-edge)}
.pill.good{background:var(--sem-good-bg);color:var(--sem-good-ink);border-color:var(--sem-good-edge)}
.pill.plan{background:var(--sem-plan-bg);color:var(--sem-plan-ink);border-color:var(--sem-plan-edge)}
.pill.none{background:var(--sem-none-bg);color:var(--sem-none-ink);border-color:var(--sem-none-edge)}
.cut.on .pill.load,.cut.on .pill.gap,.cut.on .pill.late,.cut.on .pill.none{
  background:#fdf6ef;border-color:rgba(27,18,7,.18)}
.cut.dark .pill{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.14);color:#e8e0d8}
.cut.dark .pill.late{background:rgba(220,80,80,.16);border-color:rgba(220,80,80,.32);color:#ffb4b4}
.cut.dark .pill.good{background:rgba(90,200,130,.14);border-color:rgba(90,200,130,.3);color:#a7e5bf}
/* the racing slashes, bottom right, and the label opposite them */
.cutfoot{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;min-height:14px;
  padding-left:calc(var(--cut) - 11px)}
.cutfoot .lab{font-size:10.5px;font-weight:700;color:var(--mute)}
.cut.on .cutfoot .lab{color:#1b1207}
.cut.dark .cutfoot .lab{color:rgba(246,241,236,.72)}
.slash{font-size:13px;font-weight:800;color:var(--rule);letter-spacing:-.08em;transform:skewX(-12deg);line-height:1}
.cut.on .slash{color:rgba(27,18,7,.4)}
.cut.dark .slash{color:rgba(255,255,255,.2)}

/* ------------------------------------------------------------------------- the equipment cards */
/* align-items:start, deliberately. A grid row stretches every card to the tallest one in it, so one card with a
   photograph used to drag four sparse cards up with it and leave a hand-span of dead white above the Open
   link — Andrew Fisher's screenshots of 14 Sep show exactly that. Each card is now its own height. The tops
   still line up, which is what the eye follows down a grid; the bottoms are ragged, which costs nothing. */
.eqgrid{display:grid;grid-template-columns:repeat(auto-fill, minmax(min(100%, 210px), 1fr));gap:12px;margin:12px 0;
  align-items:start}
.eqc{width:100%}
/* the status instrument sits at the top of the card, above the picture: on a register of 193 references the
   first question is always "is it here", not "what does it look like" */
.eqstat{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:0 0 9px}
.eqc.on .eqstat .dstat .ds-w b{color:#1b1207}
.eqc.on .eqstat .dstat .ds-w em{color:rgba(27,18,7,.7)}
.eqc .rplate{align-self:flex-start;margin:1px 0 3px}
.eqc > .face{padding:11px 12px 9px;display:flex;flex-direction:column;gap:3px;height:100%}
.eqpic{display:block;position:relative;border-radius:9px;overflow:hidden;background:var(--tint2);
  aspect-ratio:16/11;margin-bottom:7px}
.eqpic img{display:block;width:100%;height:100%;object-fit:cover}
/* two products on one reference: two pictures side by side, the same window split, each with its own tab */
.eqpair{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:7px}
.eqpair .eqpic{margin-bottom:0;aspect-ratio:1/1}
.eqpair .eqpl{font-size:8.5px;left:5px;bottom:5px;padding:1px 5px}
/* ---------------------------------------------------------------- photographs of the drop itself
   Deliberately NOT the product card's picture styling. A product photograph sits flush in a 16:11 window with
   a dark "Reference photo" tab; a drop photograph is squarer, sits on the paper with a visible border, and
   carries an ORANGE "On site" tab. Two pictures of the same yellow cabin, one stock and one taken on the day,
   have to be tellable apart at arm's length on a phone in the sun. */
/* the things inside a reference */
.unitform{margin:-2px 0 14px}
.unitlist{list-style:none;margin:9px 0 8px;padding:0;display:flex;flex-direction:column;gap:5px}
.unitlist li{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:7px 9px;border:1px solid var(--rule);
  border-radius:9px;background:var(--paper);font-size:12.5px}
.unitlist li.on{border-color:var(--orange);box-shadow:0 0 0 1px var(--orange) inset;background:var(--tint2)}
.unitlab{flex:0 0 auto;min-width:46px;font-weight:800;letter-spacing:.01em}
.unitno{flex:0 0 auto}
.unitwhere{flex:1 1 auto;min-width:0;color:var(--mute)}
.unitwhere b{color:var(--ink);font-weight:800}
.dphform{margin:-2px 0 12px;container-type:inline-size}
.dphgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:9px 0 0}
.dph{border:1px solid var(--rule);border-radius:11px;padding:9px;background:var(--paper);min-width:0;text-align:left}
.dph.dphnone{border-style:dashed;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;
  gap:6px;min-height:132px;padding:12px 11px;background:var(--tint2);text-align:left;font-size:inherit}
.dph.dphnone .dphpick{margin-top:3px}
/* F03: what a photograph's place says when the file behind it is not on the service. Bordered in the gap tone
   rather than filled black, so a printed sheet shows a labelled absence and not a photograph of the dark. */
.dphgone{display:flex;flex-direction:column;justify-content:center;gap:4px;min-height:96px;padding:12px 14px;
  border:1.5px dashed var(--sem-gap-edge, rgba(160,120,40,.5));border-radius:8px;
  background:var(--sem-gap-bg, rgba(200,150,40,.08));color:var(--sem-gap-ink, var(--ink2));font-size:12px;line-height:1.45}
.dphgone b{font-size:13px;letter-spacing:.01em}
.dphgone code{font-family:var(--mono, ui-monospace, monospace);font-size:11px;word-break:break-all;opacity:.9}
.dphgone .w{color:var(--mute);font-size:11px}
/* F07: the three non-ready states are told apart on sight as well as in words — checking is neutral and
   temporary, unable-to-check is not a claim about the photograph, unavailable is. */
.dphgone.checking{border-style:solid;border-color:var(--rule);background:var(--tint2);color:var(--mute)}
.dphgone.unchecked{border-color:var(--sem-plan-edge, rgba(90,130,190,.5));background:var(--sem-plan-bg, rgba(90,130,190,.08));color:var(--sem-plan-ink, var(--ink2))}
.rs-shot .dphgone{min-height:120px}
.eqpic .dphgone{min-height:78px;padding:9px 10px;font-size:11px}
@media print{ .dphgone{border-color:#666 !important;background:#fff !important;color:#000 !important} }
.dphpic{position:relative;display:block;border-radius:8px;overflow:hidden;background:var(--tint2);
  aspect-ratio:4/3;margin-bottom:7px;border:1px solid var(--rule)}
.dphpic img{display:block;width:100%;height:100%;object-fit:cover;cursor:zoom-in}
/* the tab is on the picture, always, so a drop photograph can never be read as a product picture */
.dphl{position:absolute;left:6px;bottom:6px;font-size:9.5px;font-weight:800;letter-spacing:.07em;
  text-transform:uppercase;padding:2px 7px;border-radius:6px;background:var(--orange);color:#fff;
  box-shadow:0 1px 4px -1px rgba(27,18,7,.45)}
/* the unit's asset number sits on the picture with the tab, so a picture of one toilet block is never read as
   the other one */
.dphu{position:absolute;right:6px;bottom:6px;font-family:Consolas,ui-monospace,monospace;font-size:10px;font-weight:700;
  padding:2px 7px;border-radius:6px;background:rgba(21,24,28,.82);color:#fff;letter-spacing:.02em}
/* a unit's own pair, under the reference's */
.dphunit{margin:12px 0 0;border-top:1px dashed var(--rule);padding-top:8px}
.dphunit > summary{cursor:pointer;display:flex;align-items:center;gap:10px;list-style:none;font-size:12.5px;padding:2px 0}
.dphunit > summary::-webkit-details-marker{display:none}
.dphunit > summary::before{content:'\25B8';color:var(--mute);font-size:11px;transition:transform .15s}
.dphunit[open] > summary::before{transform:rotate(90deg)}
.dphunit > summary .w{color:var(--mute);font-size:11.5px}
.dphunit > summary:hover .dphuh .ano{text-decoration:underline}
.dphabout{font-size:11.5px;color:var(--mute);margin:-4px 0 8px;line-height:1.4}
.dphslot{font-size:11px;font-weight:700;letter-spacing:.02em;color:var(--ink)}
/* v5.79 — the two places for the drone's shots wear a small mark, and an empty one sits a shade lighter */
.dphdrone{display:inline-block;margin-left:6px;padding:1px 6px;border-radius:9px;border:1px solid var(--orange);color:var(--orange);font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;font-style:normal;vertical-align:middle}
.dph.dphnone.dphair{border-style:dashed}
.dphhint{font-size:10.5px;color:var(--mute);line-height:1.35;margin:0}
.dphsays{font-size:10px;color:var(--mute);line-height:1.35;margin:2px 0 6px;overflow-wrap:anywhere}
.dphcap{margin:0 0 6px}
.dphcap input{display:block;width:100%;min-width:0;font:inherit;font-size:12px;padding:6px 8px;
  border:1px solid var(--rule);border-radius:8px;background:var(--paper);color:var(--ink)}
/* photographs filed against the reference on the service (admin page or Documents tab) — a plainer frame than
   the drop sheet's two places, because these are the library's, not the record's */
.filedgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:10px;margin:9px 0 0}
.filed{margin:0;min-width:0;border:1px solid var(--rule);border-radius:10px;padding:7px;background:var(--paper)}
.filedpic{display:block;aspect-ratio:4/3;border-radius:7px;overflow:hidden;background:var(--tint2);border:1px solid var(--rule);margin-bottom:6px}
.filedpic img{display:block;width:100%;height:100%;object-fit:cover;cursor:zoom-in}
.filedpic.filedfile{display:flex;align-items:center;justify-content:center;font-weight:800;letter-spacing:.06em;color:var(--mute);text-decoration:none}
.filed figcaption{display:flex;flex-direction:column;gap:4px;font-size:11.5px;line-height:1.35;overflow-wrap:anywhere}
.filed figcaption b{font-size:12px}
.filed figcaption .w{color:var(--mute);font-size:10.5px}
.filed .btn.sm{align-self:flex-start;margin-top:2px}
@media print{ .filedgrid,.filedsay,.filedhead{display:none} }
.dphcap input:focus{border-color:var(--orange);outline:none}
.dphacts{display:flex;gap:5px;flex-wrap:wrap}
.dphacts .btn{flex:0 1 auto;min-width:0}
/* the input itself is never shown — the label is the button, which is what lets one control offer both the
   camera and the photo library on a phone */
.dphin{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);
  clip-path:inset(50%);white-space:nowrap;border:0}
.dphreuse{margin-top:6px}
.dphreuse select{width:100%;font:inherit;font-size:12.5px;padding:6px 8px;border-radius:8px;border:1px solid var(--line, #d9d2ca);background:var(--card, #fff);color:inherit}
.dphpick{cursor:pointer}
/* the paper behind a docket, and what it is still owed for — both belong beside the quantities */
.dpaper{display:flex;flex-direction:column;gap:3px;margin-top:6px}
.dpaperone{display:flex;flex-direction:column;font-size:12px}
.dpaperone em{font-style:normal;font-size:11px;color:var(--mute)}
.nocharge{margin-top:5px;font-size:11.5px;line-height:1.4;color:var(--ink2);border-left:3px solid var(--orange);
  padding-left:7px}
.nocharge b{color:var(--ink)}
.dphin:focus-visible + .dphpick{outline:2px solid var(--orange);outline-offset:2px}
/* Sized against the DRAWER, not the window — the drawer is about 410 px wide whether the screen is 1280 px or
   412 px, so a viewport media query is the wrong instrument here and never fires on a desktop at all.

   The two stay SIDE BY SIDE down to 300 px of drawer, which is narrower than any phone this will be opened on.
   In position and Access and surrounds are a pair — the whole reason for two is that you look at them together,
   one showing the unit and one showing the way back to it — and stacking them puts the second below the fold on
   the screen where it is most needed. What gives way instead is the controls: the caption row and the buttons
   wrap onto another line rather than squeezing the pictures. */
@container (max-width:299px){ .dphgrid{grid-template-columns:minmax(0,1fr)} }
/* the label is on the picture, always, so a photograph can never be read as a picture of this asset */
.eqpl{position:absolute;left:7px;bottom:7px;font-size:9.5px;font-weight:700;letter-spacing:.06em;
  padding:2px 7px;border-radius:6px;background:rgba(20,16,13,.82);color:#fff}
/* and the drop's own photograph wears orange, so the two can be told apart across a room */
.eqpl.live{background:var(--orange);font-weight:800;letter-spacing:.07em;text-transform:uppercase}
/* a picture nobody took: an outlined tab, so it reads as a different KIND of thing from a solid photo tab even
   before the word is read */
.eqpl.made{background:rgba(20,16,13,.62);border:1px solid rgba(255,255,255,.55);padding:1px 6px}
.eqcap{font-size:10px;color:var(--mute);line-height:1.3;margin:-4px 0 4px}
.eqc.on .eqcap{color:rgba(27,18,7,.72)}
.eqnopic{display:flex;align-items:center;gap:9px;border:1px dashed var(--rule);border-radius:9px;
  padding:11px 11px;margin-bottom:7px;min-height:62px;font-size:10.5px;color:var(--mute);line-height:1.35}
.eqnopic i{flex:0 0 auto;width:22px;height:22px;border-radius:6px;background:var(--tint);display:inline-flex;
  align-items:center;justify-content:center;font-style:normal;font-weight:800;color:var(--slate)}
.eqc.on .eqnopic{border-color:rgba(27,18,7,.28);color:rgba(27,18,7,.78)}
.eqc.on .eqnopic i{background:rgba(255,255,255,.4);color:#1b1207}
.eqk{font-size:9.5px;font-weight:800;letter-spacing:.13em;color:var(--slate)}
.eqc.on .eqk{color:rgba(27,18,7,.78)}
.eqc b.racenum{font-size:34px;color:var(--ink);line-height:.9;margin:1px 0 2px}
.eqc.on b.racenum{color:#1b1207}
.eqn{font-size:14px;font-weight:800;letter-spacing:-.01em;color:var(--ink);line-height:1.2}
.eqc.on .eqn{color:#1b1207}
.eqi{font-size:11px;color:var(--mute);line-height:1.35}
.eqc.on .eqi{color:rgba(27,18,7,.74)}
.eqpills{display:flex;flex-wrap:wrap;gap:5px;margin:7px 0 9px}
/* a pill in a card wraps. Everywhere else a pill is one short phrase on a wide surface and nowrap is right;
   in a 160 px card on a phone "No demob row in the schedule" runs off the edge and the card's own diagonal
   clips it, so the reader loses the last word of the thing they most need to read. */
.eqpills .pill{font-size:10px;padding:2px 7px;white-space:normal;text-align:left}
.eqc .cutfoot{margin-top:auto}
.eqc .cutfoot .lab{display:inline-flex;align-items:center;gap:5px}
@media (max-width:420px){ .eqgrid{grid-template-columns:repeat(auto-fill, minmax(min(100%, 160px), 1fr))}
  .eqc .rplate{font-size:25px !important} }

/* ------------------------------------------------------------------------- the load brief */
.lbrief{border:1px solid var(--rule);border-radius:12px;background:var(--paper);margin:0 0 14px;padding:12px 14px 13px;
  font-family:'Inter', var(--sans, system-ui, sans-serif)}
.lbhead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:11px}
.lbk{margin:0;font-size:10px;font-weight:800;letter-spacing:.13em;color:var(--orange-ink)}
@media (prefers-color-scheme:dark){.lbk{color:var(--orange)}}
.lbhead h3{margin:2px 0 0;font-size:20px;font-weight:800;letter-spacing:-.02em}
.lbwhen{text-align:right}
.lbwhen span{display:block;font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--slate);text-transform:uppercase}
.lbwhen b{font-size:14px;font-weight:800;color:var(--ink)}
/* the band: the carrier on the dark half, the load time on the livery half */
.lbband{--cut:19px;--edge:#2a231e;--face:#241d18;margin:0 0 9px}
.lbband > .face{background:var(--face);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,128px);min-height:104px}
.lbcar{padding:13px 15px;display:flex;flex-direction:column;justify-content:space-between;min-width:0;color:#f6f1ec}
.lbck{font-size:9.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.72;line-height:1.3}
.lbcar b{font-size:22px;font-weight:800;letter-spacing:-.01em;line-height:1.12;margin-top:9px;word-break:break-word}
/* B4, from an outside re-audit of the live site on 16 Sep 2026: the drawer scrolled sideways — 460 px wide with
   481 px of content — and the load brief was the chain that pushed it. The load time as supplied can read two
   ways ("0600 / 6am"), and at 40 px condensed it simply did not fit its 128 px column. The value is never cut
   and never abbreviated — Andrew Fisher's rule is that the Load Time cell prints as the source writes it — so
   it wraps instead, and every box in the chain is allowed to shrink rather than push. */
.lbrief, .lbcar, .lbtime, .lbband, .lbband > .face{min-width:0}
.lbcar b, .lbrow b{overflow-wrap:anywhere}
.lbtime{padding:13px 14px;display:flex;flex-direction:column;justify-content:space-between;min-width:0;
  background:linear-gradient(152deg, #FF8E35 0%, #FF761B 48%, #FF6A13 100%);color:#1b1207}
.lbtime.none{background:var(--sem-none-bg);color:var(--sem-none-ink)}
.lbtime b.racenum{font-size:34px;color:inherit;margin:6px 0 0;display:block;max-width:100%;overflow-wrap:anywhere}
.lbtf{font-size:10px;font-weight:700;padding-top:7px;border-top:1px solid rgba(27,18,7,.25);opacity:.85}
.lbtime.none .lbtf{border-color:var(--sem-none-edge)}
.lbrow{border:1px solid var(--rule);border-radius:10px;padding:9px 12px;margin-bottom:9px;background:var(--tint2)}
.lbrow b{display:block;font-size:17px;font-weight:800;letter-spacing:-.01em;color:var(--ink);margin-top:2px;
  font-variant-numeric:tabular-nums;word-break:break-word}
.lbkit{display:flex;align-items:flex-start;gap:12px;padding:2px 0 4px}
.lbref{flex:0 0 auto;font-size:26px;color:var(--orange-ink);background:var(--orange-soft);
  border:1px solid var(--orange-lt);border-radius:9px;padding:6px 12px;line-height:1}
@media (prefers-color-scheme:dark){.lbref{color:var(--orange)}}
.lbkit > div{min-width:0}
.lbkit b{display:block;font-size:16px;font-weight:800;letter-spacing:-.01em;color:var(--ink);line-height:1.2}
.lbpills{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.lbflag{display:flex;gap:11px;align-items:flex-start;margin-top:10px;padding:10px 13px;border-radius:10px;
  border:1px solid var(--sem-gap-edge);background:var(--sem-gap-bg);color:var(--sem-gap-ink)}
.lbfi{flex:0 0 auto;width:24px;height:24px;border-radius:7px;display:inline-flex;align-items:center;
  justify-content:center;font-weight:800;background:rgba(0,0,0,.07)}
.lbflag b{display:block;font-size:14px;font-weight:800}
.lbflag p{margin:2px 0 0;font-size:12.5px;line-height:1.4;opacity:.92}
.lbnotes{border-top:1px solid var(--rule2);margin-top:11px;padding:10px 0 0;container-type:inline-size}
@media (max-width:520px){ .lbband > .face{grid-template-columns:minmax(0,1fr)}
  .lbtime{border-top:1px solid rgba(27,18,7,.25)} .lbcar b{font-size:19px} }

/* ------------------------------------------------------------------------- the driver card, on screen */
.dcard{border:1px solid var(--rule);border-radius:12px;background:var(--paper);overflow:hidden;margin:0 0 14px;
  border-top:3px solid var(--orange);font-family:'Inter', var(--sans, system-ui, sans-serif)}
.dcbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
  padding:9px 14px;border-bottom:1px solid var(--rule2)}
.dcbar b{display:block;font-size:12.5px;font-weight:800;color:var(--ink)}
.dcbar em{font-style:normal;font-size:11px;color:var(--mute)}
.dchead{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 14px 10px}
.dchead h3{margin:0;font-size:20px;font-weight:800;letter-spacing:-.02em}
.dchead span{font-size:10.5px;font-weight:700;letter-spacing:.12em;color:var(--slate)}
.dcmain{display:grid;grid-template-columns:minmax(0,150px) minmax(0,1fr);gap:14px;padding:0 14px 12px;align-items:stretch}
/* the reference, in the livery, big enough to read across a yard */
.dcref{--cut:19px}
.dcref > .face{background:var(--face);color:#1b1207;padding:13px 14px 11px;display:flex;flex-direction:column;
  min-height:150px;position:relative}
.dcref{--edge:#d0530a; --face:linear-gradient(152deg, #FF8E35 0%, #FF761B 48%, #FF6A13 100%)}
.dcrk{font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(27,18,7,.8)}
.dcref b.racenum{font-size:52px;margin:auto 0;color:#1b1207;word-break:break-word;line-height:.9}
.dcrf{font-size:11px;font-weight:700;letter-spacing:.06em;color:rgba(27,18,7,.72);
  padding-top:9px;border-top:1px solid rgba(27,18,7,.2)}
.dcref .slash{position:absolute;top:11px;right:calc(var(--cut) - 3px);color:rgba(27,18,7,.42)}
.dcwhat{min-width:0;display:flex;flex-direction:column;justify-content:center}
.dcp{margin:0;font-size:10.5px;font-weight:800;letter-spacing:.13em;color:var(--slate)}
.dcwhat h4{margin:3px 0 0;font-size:25px;font-weight:800;letter-spacing:-.025em;line-height:1.15;color:var(--ink)}
.dci{margin:3px 0 0;font-size:13.5px;color:var(--ink2)}
.dcpills{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}
/* the band that says whether anybody has confirmed where this goes. It is never absent and never quiet. */
.dcpos{display:flex;gap:12px;align-items:flex-start;margin:0 14px 12px;padding:12px 14px;border-radius:10px;
  border:1px solid var(--sem-gap-edge);background:var(--sem-gap-bg);color:var(--sem-gap-ink)}
.dcpos.good{border-color:var(--sem-good-edge);background:var(--sem-good-bg);color:var(--sem-good-ink)}
/* A drawing match is SOURCE INFORMATION, not a verified position, so it wears the blue the page uses for
   everything that came off a plan and the plain map pin the map uses — never the green tick, which on this
   page means somebody stood there and checked. Andrew Fisher's audit of 14 Sep caught P33 wearing a green tick
   over a position nobody had confirmed. Blue says: this is what the drawing says, go and look. */
.dcpos.plan{border-color:var(--sem-plan-edge);background:var(--sem-plan-bg);color:var(--sem-plan-ink)}
.dcpi{flex:0 0 auto;width:30px;height:30px;border-radius:8px;display:inline-flex;align-items:center;
  justify-content:center;font-weight:800;font-size:15px;background:rgba(0,0,0,.07)}
.dcpos > div{min-width:0}
.dcpk{margin:0;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;opacity:.85}
.dcpos b{display:block;font-size:16px;font-weight:800;letter-spacing:-.01em;margin:2px 0 3px}
.dcpos p{margin:0;font-size:12.5px;line-height:1.45;opacity:.92}
.dcsrc{border-top:1px solid var(--rule2);padding:10px 14px 12px;container-type:inline-size}
.dcsrc > summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:7px;
  font-size:12px;font-weight:700;color:#f6f1ec;background:#241d18;border-radius:8px;padding:7px 13px}
.dcsrc > summary::-webkit-details-marker{display:none}
.dcsrc > summary::after{content:'⌄';font-size:13px;line-height:0.6}
.dcsrc[open] > summary::after{content:'⌃'}
.dcsrc > summary:hover{background:#100c0a}
.dcsrc > summary:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
/* fixed layout, or a long sentence in the second column pushes the table past the card it sits in */
/* the global table rule carries min-width:640px so the register can scroll sideways inside .tblwrap. These
   little source tables live in a 400 px drawer and must not inherit it. */
.dcsrctbl{width:100%;max-width:100%;min-width:0;border-collapse:collapse;margin-top:10px;font-size:12px;
  table-layout:fixed}
.dcsrctbl td{padding:6px 9px;border-bottom:1px solid var(--rule2);vertical-align:top;color:var(--ink2);
  overflow-wrap:anywhere}
.dcsrctbl td:first-child{color:var(--ink);font-weight:600;width:34%}
/* the drawer is about 460 px whatever the window is, so this is sized by the CARD, not the viewport */
@container (min-width:520px){ .dcsrctbl td:first-child{width:170px} }
@media (max-width:560px){ .dcmain{grid-template-columns:minmax(0,1fr)} .dcref > .face{min-height:118px}
  .dcref b.racenum{font-size:44px} .dcwhat h4{font-size:21px} }

/* ------------------------------------------------------------------------- the daily brief */
.dbrief{margin:0 0 18px;padding:0 0 4px;font-family:'Inter', var(--sans, system-ui, sans-serif);max-width:min(100%, 880px)}
.dbhead{display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;padding-bottom:14px;border-bottom:2px solid var(--ink)}
.dbdate{--cut:19px;--edge:#d0530a;--face:linear-gradient(152deg, #FF8E35 0%, #FF761B 48%, #FF6A13 100%);
  flex:0 0 auto;width:132px}
.dbdate > .face{background:var(--face);color:#1b1207;padding:12px 14px 11px;display:flex;flex-direction:column;
  min-height:132px}
.dbdw{font-size:11px;font-weight:800;letter-spacing:.14em}
.dbdate b.racenum{font-size:62px;color:#1b1207;margin:auto 0 2px;line-height:.85}
.dbdm{font-size:11.5px;font-weight:700;letter-spacing:.08em;color:rgba(27,18,7,.78)}
.dbtitle{flex:1 1 240px;min-width:0}
.dbacts{flex:0 0 auto;align-self:flex-start;margin-top:4px}
.dbk{margin:0;font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--slate)}
.dbtitle h3{margin:5px 0 0;font-size:40px;font-weight:800;letter-spacing:-.035em;line-height:1.03;color:var(--ink)}
.dbtitle h3 span{display:inline-block;margin-right:.22em}
.dbsub{margin:8px 0 0;font-size:13px;color:var(--mute)}
.dbs{display:flex;align-items:center;gap:12px;margin:20px 0 11px}
.dbn{flex:0 0 auto;font-size:11px;font-weight:800;letter-spacing:.06em;color:var(--orange-ink);
  background:var(--orange-soft);border-radius:6px;padding:4px 9px;font-variant-numeric:tabular-nums}
@media (prefers-color-scheme:dark){.dbn{color:var(--orange)}}
.dbs h4{margin:0;font-size:17px;font-weight:800;letter-spacing:-.015em;color:var(--ink);white-space:nowrap}
.dbs i{flex:1 1 auto;height:1px;background:var(--rule)}
.dbtiles{display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 150px), 1fr));gap:11px}
.dbt > .face{padding:12px 14px 13px;display:flex;flex-direction:column;gap:1px;background:var(--face)}
.dbtl{font-size:12px;font-weight:700;color:var(--ink2)}
.dbt b.racenum{font-size:40px;color:var(--ink);margin:5px 0 2px}
.dbts{font-size:10.5px;color:var(--ink2)}
.dbt.in{--edge:var(--orange-lt); --face:var(--orange-soft)} .dbt.in .dbtl{color:var(--orange-ink)}
.dbt.out{--edge:var(--sem-change-edge); --face:var(--sem-change-bg)} .dbt.out .dbtl{color:var(--sem-change-ink)}
.dbt.load{--edge:var(--sem-plan-edge); --face:var(--sem-plan-bg)} .dbt.load .dbtl{color:var(--sem-plan-ink)}
/* the line that matters: what the record can stand behind, never a blank */
.dbout{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:11px;
  padding:11px 14px;border-radius:9px;border-left:4px solid var(--sem-gap-edge);background:var(--tint);font-size:13.5px}
.dbout > span{color:var(--mute)}
.dbout b{font-weight:800;color:var(--ink)}
.dbout.good{border-left-color:var(--sem-good-edge)} .dbout.good b{color:var(--sem-good-ink)}
.dbout.gap{border-left-color:var(--sem-gap-edge)} .dbout.gap b{color:var(--sem-gap-ink)}
.dbout.none{border-left-color:var(--rule)}
.dbrow{display:flex;align-items:flex-start;gap:13px;padding:11px 0;border-bottom:1px solid var(--rule2)}
.dbrow:last-of-type{border-bottom:0}
.dbrn{flex:0 0 auto;min-width:52px;text-align:center;font-size:22px;font-weight:800;padding:7px 9px;border-radius:9px;
  font-variant-numeric:tabular-nums;line-height:1}
.dbrn.stop{background:var(--sem-stop-bg);color:var(--sem-stop-ink);border:1px solid var(--sem-stop-edge)}
.dbrn.gap{background:var(--sem-gap-bg);color:var(--sem-gap-ink);border:1px solid var(--sem-gap-edge)}
.dbrow > div{min-width:0}
.dbrow b{display:block;font-size:15px;font-weight:800;letter-spacing:-.01em;color:var(--ink)}
.dbrow p{margin:2px 0 0;font-size:12.5px;color:var(--mute);line-height:1.45}
.dbnote{margin:10px 0 0;font-size:12px;color:var(--ink2);line-height:1.45}
/* the delivery rows: plate | name and type | the instrument (which sets it) | the action | the slashes.
   One card shell, cut on the same corners as everything else on the page. */
.dbdels{display:grid;gap:9px}
.dbdel{--cut:14px}
.dbdel > .face{display:flex;align-items:center;gap:14px;padding:10px 14px 10px 12px;flex-wrap:wrap}
.dbdel .dbdn{flex:1 1 200px;min-width:0;display:flex;flex-direction:column;gap:2px}
.dbdel .dbdn b{font-size:14.5px;font-weight:800;letter-spacing:-.01em;color:var(--ink);overflow-wrap:anywhere}
.dbdel .dbdn > span{font-size:11.5px;color:var(--mute);overflow-wrap:anywhere}
.dbdel .dbdn .ano{font-size:11.5px}
.dbdel .dstat{flex:0 0 236px}
.dbdel .dbda{display:inline-flex;align-items:center;justify-content:flex-end;gap:8px;flex:0 0 150px;margin-left:auto}
@media(max-width:900px){ .dbdel .dstat{flex:0 1 auto} .dbdel .dbda{flex:0 0 auto} }
.dbdel .slash{flex:0 0 auto}
.dbdel.fin{--edge:var(--sem-good-edge)}
.dbdel:hover{--edge:var(--orange-lt);box-shadow:var(--lift)}
@media(max-width:640px){ .dbdel > .face{gap:10px 12px} .dbdel .dbda{margin-left:0} }
/* the champagne action: the one button on a row that asks for a decision */
.btn.amber{background:var(--sem-gap-bg, #FFF0C9);border-color:var(--sem-gap-edge, #e9c76a);color:var(--sem-gap-ink, #5a3d00);font-weight:700}
.btn.amber:hover{border-color:var(--orange)}
.dbnext{border:1px solid var(--rule);border-radius:11px;overflow:hidden;background:var(--paper)}
.dbnext > summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;
  gap:12px;flex-wrap:wrap;padding:12px 15px;background:#241d18;color:#f6f1ec;font-size:14px;font-weight:800}
.dbnext > summary::-webkit-details-marker{display:none}
.dbnext > summary::after{content:'+';font-size:19px;font-weight:800;color:var(--orange-lt);line-height:1}
.dbnext[open] > summary::after{content:'\2212'}
.dbnext > summary:hover{background:#100c0a}
.dbnext > summary:focus-visible{outline:2px solid var(--orange);outline-offset:-3px}
.dbnx{font-weight:500;font-size:12.5px;color:rgba(246,241,236,.8);font-variant-numeric:tabular-nums}
.dbnx b{font-weight:800;color:#fff}
.dbnb{padding:14px 15px 15px}
.dbnl{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}
.dbnl > span{font-size:11.5px;padding:4px 9px;border-radius:7px;border:1px solid var(--rule);background:var(--tint2);
  max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}
.dbnl > span:hover{border-color:var(--orange)}
.dbnl > span:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
.dbnl b{color:var(--orange-ink);font-weight:800;margin-right:4px}
@media (prefers-color-scheme:dark){.dbnl b{color:var(--orange)}}
.dbnl .more{background:transparent;border-color:transparent;color:var(--mute);cursor:default}
@media (max-width:560px){ .dbtitle h3{font-size:30px} .dbdate{width:108px} .dbdate b.racenum{font-size:48px}
  .dbdate > .face{min-height:108px} }
@media print{ .dbnext{display:none} .dbrief{max-width:100%} }

/* ------------------------------------------------------ the day's figures, and what still needs looking at */
.todaypanels{margin:0 0 16px}
.tpday{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:0 0 9px}
.tpday h3{margin:0;font-size:17px;letter-spacing:-.01em}
.tpday span{font-size:12px;color:var(--mute)}
/* Four panels, each about a panel's width — stretched across a desktop they became letterboxes with the
   figure floating in them. */
.dpanels{display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 148px), 216px));gap:10px;
  justify-content:start}
.dp > .face{padding:11px 13px 12px;display:flex;flex-direction:column;gap:2px}
.dp .dpl{display:flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;color:var(--ink2)}
.dp .dpl i{font-style:normal;font-size:12px;opacity:.75}
.dp b{font-size:34px;color:var(--ink);margin:4px 0 1px}
.dp .dps{font-size:10.5px;color:var(--mute);line-height:1.3}
/* Each figure keeps one colour and one meaning, taken from the page's own key, so a panel here and a pill on a
   date card say the same thing in the same colour. Due in is the livery because it is the day's headline. */
.dp.in{--edge:#d0530a; --face:linear-gradient(152deg, #FF8E35 0%, #FF761B 48%, #FF6A13 100%)}
.dp.in > .face{background:var(--face)} .dp.in .dpl,.dp.in b{color:#1b1207} .dp.in .dps{color:rgba(27,18,7,.72)}
.dp.load{--edge:var(--sem-plan-edge); --face:var(--sem-plan-bg)} .dp.load .dpl{color:var(--sem-plan-ink)}
.dp.out{--edge:var(--sem-change-edge); --face:var(--sem-change-bg)} .dp.out .dpl{color:var(--sem-change-ink)}
.dp.gap{--edge:var(--sem-gap-edge); --face:var(--sem-gap-bg)} .dp.gap .dpl{color:var(--sem-gap-ink)}
@media (max-width:760px){ .dpanels{grid-template-columns:repeat(2, minmax(0,1fr))} .dp b{font-size:29px} }
.attnwrap{margin:14px 0 4px}
 /* The two cards are bounded: given a whole desktop row they stretched into letterboxes and the figure that is
    the point of the card floated in a field of nothing. Two cards, each about a card's width. */
.attngrid{display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 250px), 360px));gap:12px;
  justify-content:start}
.attn{width:100%}
.attn > .face{padding:15px 17px 13px;display:flex;flex-direction:column;gap:1px;min-height:218px}
.attnk{font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--slate)}
.attn.on .attnk{color:rgba(27,18,7,.78)}
.attn b.racenum{font-size:64px;color:var(--ink);margin:8px 0 2px}
.attn.on b.racenum{color:#1b1207}
.attnw{font-size:17px;font-weight:800;letter-spacing:-.01em;color:var(--ink);margin-top:auto}
.attn.on .attnw{color:#1b1207}
.attn .cutfoot{border-color:var(--rule)!important;color:var(--rule)}
.attn.on .cutfoot{border-color:rgba(27,18,7,.22)!important}
.attn .cutfoot .lab{display:inline-flex;align-items:center;gap:5px}
.attnnote{display:flex;align-items:flex-start;gap:9px;margin:11px 0 0;font-size:12px;color:var(--ink2);
  line-height:1.45;max-width:min(100%, 732px)}
.attnnote i{flex:0 0 auto;width:17px;height:17px;border-radius:50%;border:1px solid var(--rule);
  display:inline-flex;align-items:center;justify-content:center;font-style:normal;font-size:10.5px;
  font-weight:800;color:var(--mute);margin-top:1px}
.attnbody{display:block;margin:12px 0 0;max-width:min(100%, 732px)}
.attnbody > .face{padding:15px 17px 15px;display:flex;flex-direction:column;gap:12px}
.attnbh{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.attnbh .attnk{color:rgba(246,241,236,.62)}
.attnbh b{display:block;font-size:21px;font-weight:800;letter-spacing:-.02em;margin-top:2px}
.attnbn{font-size:34px;color:var(--orange-lt);margin-right:calc(var(--cut) - 8px)}
.attnsplit{display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 230px), 1fr));gap:1px;
  background:rgba(255,255,255,.1);border-radius:9px;overflow:hidden}
.attnsplit > span{display:block;background:#f7f1ea;color:#231c16;padding:11px 13px;font-size:13px;line-height:1.4}
.attnsplit em{display:block;font-style:normal;font-size:11px;color:#6d6157;margin-bottom:3px}
.attnpills{display:flex;flex-wrap:wrap;gap:6px}
.attnlist{display:flex;flex-wrap:wrap;gap:6px;padding-top:11px;border-top:1px solid rgba(255,255,255,.12)}
.attnlist > span{font-size:11.5px;padding:3px 9px;border-radius:7px;background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.13);color:#e8e0d8;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.attnlist > span[data-k]{cursor:pointer}
.attnlist > span[data-k]:hover{border-color:var(--orange);color:#fff}
.attnlist > span[data-k]:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
.attnlist b{font-weight:800;color:var(--orange-lt);margin-right:5px}
.attnlist .more{background:transparent;border-color:transparent;color:rgba(232,224,216,.6)}
@media print{ .attnbody{display:none} .dpanels{grid-template-columns:repeat(4, minmax(0,1fr));justify-content:stretch} }

/* --------------------------------------------------------------------- the day cards
   A race number on a car: the date is the number, the top-right and bottom-left corners are cut, and the
   selected day wears the livery. The figures sit in a pale inset panel so they read as a data plate rather than
   more text.

   The shape is a clip-path, which takes the corners off but also clips anything drawn outside the element —
   including a focus ring, which is exactly the thing that must never be clipped. So the card is two elements:
   the button is the SHAPE and carries the edge colour, and the face sits one pixel inside it in the same shape.
   The perimeter edge is then the button showing through, the diagonals included, and keyboard focus is the same
   edge grown to three pixels — it follows the cut corners because it IS the card. */
.daystrip{display:flex;gap:10px;overflow-x:auto;padding:4px 2px 14px;scroll-snap-type:x proximity;
  -webkit-overflow-scrolling:touch;scroll-padding-left:2px}
.day{--cut:17px; --edge:var(--rule); --face:var(--paper);
  flex:0 0 auto;width:178px;min-width:178px;padding:1px;border:0;background:var(--edge);
  cursor:pointer;text-align:left;scroll-snap-align:start;position:relative;font:inherit;
  border-radius:13px 0 13px 0;
  clip-path:polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
  transition:background .18s ease, transform .18s ease, box-shadow .18s ease}
.dface{display:flex;flex-direction:column;gap:9px;padding:12px 13px 9px;background:var(--face);
  border-radius:12px 0 12px 0;min-height:100%;
  /* one pixel less of a cut than the button, so the diagonal edge has the same weight as the straight ones —
     two identical polygons an inset pixel apart leave 0.7 px of edge on a 45 degrees, which reads as nothing */
  clip-path:polygon(0 0, calc(100% - var(--cut) + 1px) 0, 100% calc(var(--cut) - 1px), 100% 100%,
                    calc(var(--cut) - 1px) 100%, 0 calc(100% - var(--cut) + 1px));
  transition:background .18s ease}
.day:hover{--edge:var(--orange-lt);transform:translateY(-1px);box-shadow:var(--lift)}
.day:focus-visible{outline:none;--edge:var(--orange);padding:3px}
.day.today{--edge:var(--orange)}
.dhead{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:20px}
/* Inter for everything operational: the labels, the figures, the chips. */
.dface{font-family:'Inter', var(--sans, system-ui, sans-serif)}
.day .dow{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--slate);font-weight:700}
.dtoday{display:inline-flex;align-items:center;gap:5px;font-size:9.5px;font-weight:800;letter-spacing:.1em;
  padding:3px 8px;border-radius:20px;background:var(--orange-soft);color:var(--orange-ink);
  border:1px solid var(--orange-lt);margin-right:calc(var(--cut) - 8px)}
.dtoday i{width:5px;height:5px;border-radius:50%;background:var(--orange)}
@media (prefers-color-scheme:dark){.dtoday{color:var(--orange)}}
/* The numeral in Barlow Condensed bold italic — the racing character Andrew asked for, and the reason the face
   is embedded rather than linked. The weekday, month and year stay upright, in Inter, because they are read as
   words and not as a number. The numeral is always two digits and set in a fixed-width box, so the cards never
   jog as the strip scrolls and nothing can clip. */
.dnum{display:flex;align-items:baseline;gap:9px;min-width:0}
.dnum .dd{font-family:'Barlow Condensed', 'Arial Narrow', var(--sans, system-ui, sans-serif);
  font-style:italic;font-weight:700;font-size:60px;line-height:.86;letter-spacing:-.01em;color:var(--ink);
  font-variant-numeric:tabular-nums;flex:0 0 auto}
.dnum .dfig0{font-size:20px;font-weight:800;color:var(--ink)}
.dmy{display:flex;flex-direction:column;line-height:1.12;min-width:0}
.dmy b{font-size:14px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--ink)}
.dmy em{font-size:11.5px;font-style:normal;font-weight:500;color:var(--mute);font-variant-numeric:tabular-nums}
.dwk{display:flex;align-items:center;gap:7px;font-size:9.5px;font-weight:700;letter-spacing:.09em;
  color:var(--slate);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dwk i{flex:0 0 auto;width:14px;height:2px;border-radius:2px;background:var(--orange)}
.day.event .dwk i{background:var(--green)} .day.demob .dwk i{background:var(--sepia)} .day.quiet .dwk i{background:var(--rule)}
/* the inset panel: the figures, set back from the card face */
.dpan{margin-top:auto;background:var(--tint);border:1px solid var(--rule2);border-radius:10px;padding:9px 10px 8px;
  display:flex;flex-direction:column;gap:8px}
/* Due in leads — it is the figure somebody is looking for. Due out is beside it, smaller, never hidden. */
.dfig{display:flex;align-items:flex-end;gap:10px}
.dfig > span{display:flex;flex-direction:column-reverse;gap:1px;min-width:0}
.dfig .din{flex:1 1 auto}
.dfig .dout{flex:0 0 auto;border-left:1px solid var(--rule);padding-left:10px}
.dfig b{font-weight:800;line-height:1;letter-spacing:-.03em;color:var(--ink);font-variant-numeric:tabular-nums}
.dfig .din b{font-size:27px}
.dfig .dout b{font-size:19px;color:var(--ink2)}
.dfig em{font-size:10px;font-style:normal;font-weight:600;color:var(--mute)}
/* One meaning per colour, and every colour says its own words — the card reads the same in greyscale. */
.dchips{display:flex;flex-wrap:wrap;gap:5px;padding-top:7px;border-top:1px solid var(--rule)}
.dchip{font-size:10px;font-weight:600;padding:2px 7px;border-radius:6px;border:1px solid transparent;white-space:nowrap}
.dchip b{font-weight:800;font-variant-numeric:tabular-nums}
.dchip.load{background:var(--sem-plan-bg);color:var(--sem-plan-ink);border-color:var(--sem-plan-edge)}
.dchip.gap{background:var(--sem-gap-bg);color:var(--sem-gap-ink);border-color:var(--sem-gap-edge)}
.dchip.late{background:var(--sem-stop-bg);color:var(--sem-stop-ink);border-color:var(--sem-stop-edge)}
/* nothing recorded: neutral, because an unknown is not a failure and must never be coloured as one (F01) */
.dchip.none{background:var(--sem-none-bg, rgba(127,127,127,.12));color:var(--sem-none-ink, var(--mute));border-color:var(--sem-none-edge, rgba(127,127,127,.34))}
.day .lights{display:flex;gap:3px;height:5px}
.day .lights i{display:block;height:5px;border-radius:3px;min-width:4px}
.day .lights .r{background:var(--tl-red)} .day .lights .a{background:var(--tl-amber)} .day .lights .g{background:var(--tl-green)}
.day .lights .n{background:var(--rule)}
.dfoot{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;min-height:14px;
  padding-left:calc(var(--cut) - 11px)}
.dsel{font-size:10.5px;font-weight:700;color:var(--mute)}
.dslash{font-size:13px;font-weight:800;color:var(--rule);letter-spacing:-.08em;transform:skewX(-12deg);line-height:1}
/* The selected day, in the livery — Andrew Fisher's own stops, #FF8E35 through #FF761B to Coates orange
   #FF6A13, charcoal text, and a shadow tinted from the orange rather than a grey drop. The panel goes pale so
   the figures stay readable on it, and every colour inside is restated: a token that only works on paper white
   is how a card ends up with its own text invisible. */
.day.on{--edge:#d0530a; --face:linear-gradient(152deg, #FF8E35 0%, #FF761B 48%, #FF6A13 100%);
  box-shadow:0 6px 18px -6px rgba(255,106,19,.55), 0 2px 5px -2px rgba(27,18,7,.28)}
.day.on .dface{background:var(--face)}
.day.on .dow, .day.on .dnum .dd, .day.on .dmy b, .day.on .dwk, .day.on .dsel{color:#1b1207}
.day.on .dmy em{color:rgba(27,18,7,.74)}
.day.on .dwk i{background:#1b1207}
.day.on .dslash{color:rgba(27,18,7,.4)}
.day.on .dtoday{background:#fff6ef;color:#a8430a;border-color:#fff6ef}
.day.on .dtoday i{background:#e85f0f}
.day.on .dpan{background:#fdf6ef;border-color:rgba(27,18,7,.16)}
.day.on .dfig .din b{color:#1b1207}
.day.on .dfig .dout b{color:rgba(27,18,7,.78)}
.day.on .dfig em{color:rgba(27,18,7,.68)}
.day.on .dfig .dout, .day.on .dchips{border-color:rgba(27,18,7,.16)}
.day.on .lights .n{background:rgba(27,18,7,.18)}
.day.on:hover{--edge:#b8480a}
.day.on:focus-visible{--edge:#1b1207}
@media (prefers-reduced-motion:reduce){.day,.dface{transition:none} .day:hover{transform:none}}
/* Two WHOLE cards side by side on a phone, and more as the screen grows. The width is worked from the viewport
   so two of them plus the gap always fit — including at 320, the narrowest phone anybody still carries, where a
   fixed minimum wide enough for a comfortable card left the second one half off the screen. */
@media (max-width:470px){ .day{width:calc(50vw - 28px);min-width:0}
  .dnum .dd{font-size:48px} .dfig .din b{font-size:23px} .dfig .dout b{font-size:17px} }
@media (max-width:360px){ .daystrip{gap:8px} .day{width:calc(50vw - 25px)}
  .dface{padding:10px 10px 8px} .dnum{gap:6px} .dnum .dd{font-size:40px}
  .dmy b{font-size:12.5px} .dmy em{font-size:10.5px}
  .dfig .din b{font-size:21px} .dfig .dout b{font-size:16px} .dfig .dout{padding-left:8px}
  .dtoday{font-size:9px;padding:2px 6px} }
.dayhead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin:6px 0 10px}
.dayhead h3{margin:0;font-size:18px;letter-spacing:-.01em}
.dayhead .sub{color:var(--slate);font-size:12.5px}
.daynav{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.daytbl td{vertical-align:middle}
.daytbl td.t{font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
.daytbl td.t input{width:6.2rem;padding:5px 7px;border:1px solid var(--rule);border-radius:7px;background:var(--tint2);font:inherit}
.daytbl td.t input:focus{border-color:var(--orange);outline:none;background:var(--paper)}
.daytbl td.t .mv{margin-top:5px;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.daytbl td.t .mv input{width:9.4rem;font-size:12px;font-weight:600}
/* a row whose light is green or amber carries a wash of the colour — the eye finds what has moved */
tbody tr.done, tbody tr.done:hover{background:var(--green-soft)}
tbody tr.moving, tbody tr.moving:hover{background:var(--amber-soft)}
/* ticked complete: the same green wash with a solid green edge — done, and nothing on the row is hidden */
tbody tr.complete, tbody tr.complete:hover{background:var(--green-soft)}
/* the Complete tick — a chip, a big chip in the drawer, and the button that sets it */
.tick{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:800;color:#fff;background:var(--tl-green);
  border-radius:999px;padding:1px 8px 1px 6px;white-space:nowrap;vertical-align:middle;letter-spacing:.01em}
.tick.sm{padding:0 6px;font-size:11px}
.tick.big{font-size:14px;padding:3px 12px 3px 9px}
.tick.big.off{background:transparent;color:var(--mute);border:1.5px dashed var(--rule);font-weight:600}
.tickbtn{width:34px;height:34px;border-radius:9px;border:2px solid var(--rule);background:var(--tint2);cursor:pointer;
  color:var(--mute);font:800 18px/1 system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;padding:0;
  transition:transform .15s, box-shadow .15s, border-color .15s}
/* ==================================================================== Where we are — the summary of everything
   Andrew Fisher, 12 Sep 2026: totals, so anyone can see at a glance where we are tracking — toilets delivered
   over the total with a gauge pill for progress; the same for fencing (metres done over metres planned) and
   for water barriers (units as well as the 15 locations); pricing too. Where we are is the summary of
   everything: what has turned up, where each plant or misc group is at, and the cost breakdowns.

   So this screen is that summary and nothing else. No picture, no car: the car and rail were his earlier idea
   and he said they were not working. A plate per group, each with delivered over total and a gauge; fencing in
   metres; barriers in units as well as locations; hire and transport by trade; and what has actually gone out.

   The palette is Coates — #FF6A13 Pumpkin for the one thing to look at, white ground, #67370F Sepia and the
   near-black pulled from it for type. The gauge is the only orange on a plate, because progress is the point. */
.dsn{--c-or:#ff6a13; --c-or-ink:#b34a0d; --c-sepia:#67370f; margin:-4px 0 0}

/* the head: title, the as-at day, the programme as a strip of dates, the controls */
.dsn .head{background:var(--paper);border:1px solid var(--rule);border-radius:14px;box-shadow:var(--lift);padding:18px 20px 16px}
.dsn .head h2{margin:0;font-size:26px;font-weight:800;letter-spacing:-.02em;display:flex;align-items:center;gap:12px;color:var(--ink)}
.dsn .head h2 i{display:inline-block;width:6px;height:28px;border-radius:3px;background:var(--c-or)}
.dsn .asat{margin:6px 0 0;font-size:13.5px;color:var(--ink2)}
.dsn .asat b{color:var(--ink)}
.dsn .hacts{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.dsn .hb{display:inline-flex;align-items:center;min-height:38px;padding:0 14px;border-radius:9px;border:1px solid var(--rule);
  background:var(--tint2);color:var(--ink);font:inherit;font-weight:700;font-size:13px;cursor:pointer;text-decoration:none}
.dsn .hb:hover{border-color:var(--orange)}
.dsn .hb input{border:0;background:transparent;font:inherit;font-weight:700;color:var(--ink);padding:0;min-height:36px}
.dsn .strip{display:flex;flex-wrap:wrap;gap:6px 18px;margin:14px 0 0;padding:12px 0 0;border-top:1px solid var(--rule)}
.dsn .strip .m{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--mute);white-space:nowrap}
.dsn .strip .m i{width:12px;height:12px;border-radius:50%;border:2px solid var(--rule);background:var(--paper);box-sizing:border-box}
.dsn .strip .m.done i{background:var(--c-or);border-color:var(--c-or)}
.dsn .strip .m.now i{background:var(--c-or);border-color:var(--c-or);box-shadow:0 0 0 3px rgba(255,106,19,.22)}
.dsn .strip .m.done,.dsn .strip .m.now{color:var(--ink)}
.dsn .strip .m b{font-weight:700}

/* ------------------------------------------------------------------ the pit-lane board
   Andrew Fisher, 12 Sep 2026: use this picture, with the day's information rendered on the message board —
   today's weather, the day's data and date, and where we are on the project.

   His picture of the Coates #26 and the Coates VMS trailer, and his ten-second clip that drives into it and stops
   exactly there. Neither is redrawn, recoloured, cropped or painted on — what the board says is HTML laid over the
   picture at the place the board face was measured (pipeline/board_asset.py), so it is read from the record at the
   moment it is shown and can never go stale inside an image. The clip plays once and holds its last frame; the
   still sits under it and is what prints. */
.bhero{position:relative;margin:0 0 18px;border-radius:14px;overflow:hidden;border:1px solid var(--rule);
  box-shadow:var(--lift);background:#0e1216;line-height:0}
/* the same band on Today and the Timeline, where the rest of the page is not the Where we are screen */
.dsnband{margin:0 0 14px}
/* A banner: the window is a strip and the whole picture sits inside it, pushed up so the band runs from y 190 to
   y 765 of the 941. Andrew Fisher, 12 Sep 2026, asked for it not to take up the whole screen left to right, but
   banner length — and then, of the first cut, that half the car was still missing. So the band is measured off the
   picture rather than guessed: the car's own pixels run y 443–749 and the board's frame and mast start about
   y 200, so the band takes 190 to 765 and every wheel is in it. Only the sky and the near asphalt are cropped.
   The board overlay is still placed against the WHOLE picture, so it lands on the board face exactly as measured. */
.bhero .bwin{position:relative;width:100%;aspect-ratio:1672/575;overflow:hidden}
.bhero .bmedia{position:absolute;left:0;top:-33.043%;width:100%;aspect-ratio:1672/941}
/* ---------------- showing and hiding the banner
   Andrew Fisher, 15 Sep 2026: the video had been cut and half the car was missing. He is right and this was my mistake.
   The Coates 26 and the pit-lane still are HIS assets and the standing rule on them has never changed: they are
   never redrawn, recoloured, cropped or painted on. I shortened the band by cropping it, which took the car's
   wheels off, and that is not a trade this page is allowed to make.

   The arithmetic says why there is no middle: the band shows rows 190-765 of the 941-row picture, the board's
   frame starts about row 200 and the car's own pixels end at row 749. Holding both needs 565 rows, which at any
   page width is the full band. A shorter band is a cropped car.

   So the choice is the whole banner or none of it, and it opens on the whole banner. Somebody who wants the
   vertical space back hides it entirely and gets the one-line strip instead — nothing is ever half shown. */
.bhero.folded .bwin{display:none}
.bhero.folded .bplay{display:none}
.bhero.folded{border-radius:12px 0 12px 0}
.bhero.folded .bcap{border-top:0}
/* the control: in the caption, where it is out of the picture and still next to it */
.bopen{margin-left:auto;flex:0 0 auto;border:1px solid var(--rule);background:var(--tint);color:var(--ink2);
  border-radius:8px;padding:5px 11px;font:600 11.5px/1 'Inter',var(--sans,system-ui,sans-serif);cursor:pointer;
  min-height:30px;white-space:nowrap}
.bopen:hover{border-color:var(--orange);color:var(--ink)}
.bopen:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
/* on paper the banner is always whole, and the control is not printed */
@media print{ .bopen{display:none!important} .bhero.folded .bwin{display:block!important} }
/* fill, not cover: the box carries the picture's own aspect ratio, so nothing is stretched — and nothing is
   cropped either, which is what keeps the board overlay on the board face to the pixel */
.bhero img,.bhero video{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;display:block}
.bhero video{opacity:0;transition:opacity .4s ease;z-index:1;pointer-events:none}
.bhero.playing video{opacity:1}
.bhero.playing .vmsb{opacity:0;transition:opacity .3s ease}
/* the press that starts the clip and its sound — a browser will not start sound on its own */
.bhero .bwin{isolation:isolate}
.bhero .bplay{position:absolute;z-index:4;right:16px;bottom:16px;display:inline-flex;align-items:center;gap:9px;
  border:0;border-radius:999px;padding:10px 18px 10px 14px;cursor:pointer;font:inherit;font-weight:800;font-size:13px;
  color:#fff;background:rgba(16,20,25,.72);backdrop-filter:blur(3px);box-shadow:0 6px 20px rgba(0,0,0,.35)}
.bhero .bplay i{width:0;height:0;border-style:solid;border-width:7px 0 7px 12px;border-color:transparent transparent transparent #ff6a13}
.bhero .bplay:hover{background:var(--c-or)}
.bhero .bplay:hover i{border-left-color:#fff}
.bhero.film{cursor:pointer}
.bhero.playing{cursor:default}
@media (max-width:620px){ .bhero .bplay{right:10px;bottom:10px;padding:8px 14px 8px 11px;font-size:12px} }
/* v5.84 — the board's words, said under the picture on a phone, where the lamps are a hundred pixels wide */
/* a <p>, not a <span>: the weather refresh rewrites the caption's second span and must keep finding the weather line */
.bhero .bsay{display:none;margin:0}
@media (max-width:640px){ .bhero .bsay{display:block;flex:1 1 100%;font-weight:800;font-size:13px;letter-spacing:.02em;color:var(--ink)} }
/* the board face — placed by the fractions measured off the picture itself, so it holds at any size */
/* Everything on the face is sized off the face's own width (cqw), so it reads the same on a laptop, on a phone
   and on paper without a line of script — the printed report is the one that used to come out clipped. The fit
   pass in wireBoard can only shrink from here, never grow. */
.vmsb{position:absolute;z-index:2;overflow:hidden;background:#07080a;container-type:inline-size;
  box-sizing:border-box;
  font-family:'DSEG','Roboto Mono',ui-monospace,'Cascadia Mono','Consolas',monospace;
  text-transform:uppercase;letter-spacing:.03em;line-height:1.16;text-align:center;
  transition:opacity .35s ease}
/* the lamp grid — a dot mask over the whole face, the way a real board reads up close */
.vmsb::after{content:'';position:absolute;inset:0;pointer-events:none;
  background-image:radial-gradient(circle at 50% 50%, rgba(0,0,0,0) 38%, rgba(0,0,0,.55) 60%);
  background-size:.75cqw .75cqw;opacity:.55}
.vmsb canvas.lamps{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:1}
/* the words stay in the page under the lamps: a screen reader finds them, and paper prints them where a grid of
   dots would not survive the ink */
.vmsb .words{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;
  gap:calc(1cqw * var(--fit,1));padding:2cqw 2.6cqw;box-sizing:border-box;opacity:0}
.vmsb.nolamps .words{opacity:1}
.vmsb .ln{position:relative;z-index:1;color:#ffb31a;font-weight:700;
  text-shadow:0 0 1.2cqw rgba(255,150,20,.75), 0 0 3cqw rgba(255,110,10,.35)}
/* the big and middle lines never wrap — the fit pass shrinks them until they sit on one line, the way a board does */
.vmsb .ln.big{font-size:calc(7.6cqw * var(--fit,1));letter-spacing:.02em;white-space:nowrap}
.vmsb .ln.mid{font-size:calc(5.6cqw * var(--fit,1));white-space:nowrap}
.vmsb .ln.sm{font-size:calc(4.4cqw * var(--fit,1));color:#ff8c1a;letter-spacing:.06em}
.vmsb .ln.white{color:#ffd79a;text-shadow:0 0 1.2cqw rgba(255,190,120,.7)}
.vmsb.fade{opacity:0}
/* the caption under the picture — what the board is, where the weather came from, and when */
/* the caption sits in its own band under the picture — over the car it was a shadow across the livery */
.bhero .bcap{position:relative;z-index:3;line-height:1.4;
  display:flex;flex-wrap:wrap;gap:4px 14px;align-items:center;
  padding:7px 14px;font-size:11.5px;color:var(--mute);background:var(--tint2);border-top:1px solid var(--rule)}
/* F11: one line, not two. The caption said the event name, the as-at date and the weather across the full
   width and wrapped to a second row on most laptops, which put 40px of grey under a band that had just been
   cut to 220px to save exactly that. */
.bhero .bcap{flex-wrap:nowrap;gap:4px 12px}
.bhero .bcap > span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.bhero .bcap b{color:var(--ink)}
.bhero .bcap .warn{color:#a3560a}
.bhero .bcap button{border:1px solid var(--rule);background:var(--paper);color:var(--ink);
  font:inherit;font-size:11.5px;font-weight:700;border-radius:7px;padding:3px 9px;cursor:pointer}
.bhero .bcap button:hover{border-color:var(--c-or);background:var(--tint)}
@media (hover:hover){ .bhero:hover{border-color:var(--orange);box-shadow:var(--lift),0 0 0 3px rgba(255,106,19,.16)} }
@media (prefers-reduced-motion:reduce){ .vmsb{transition:none} .bhero video{display:none} }
/* on a phone the whole picture is only a couple of hundred pixels tall anyway, so it is shown whole rather than
   cropped to a strip too thin to read the board on */
@media (max-width:620px){
  .bhero .bcap{font-size:11px;padding:8px 11px;flex-wrap:wrap;gap:6px 10px}
  /* the caption's words on one line, its buttons on the next — four lines of a wrapped weather-key button is
     more of the phone than the band it sits under */
  .bhero .bcap{flex-wrap:wrap}
  .bhero .bcap > span{flex:1 1 100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bhero .bcap button{flex:0 0 auto;white-space:nowrap;font-size:11px;padding:4px 9px}
  /* the weather key is a one-off setup action and it is offered on the About tab as well */
  .bhero .bcap #wxKeyBtn{display:none}
  .bhero .bwin{aspect-ratio:1672/941}
  .bhero .bmedia{top:0}
}

/* the plates */
.dsn .figs{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin-top:16px}
.dsn .fig{background:var(--paper);border:1px solid var(--rule);border-radius:12px;padding:16px 18px;
  box-shadow:var(--lift);border-top:3px solid var(--c-or)}
.dsn .fig .k{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);font-weight:700}
.dsn .fig .n{font-size:34px;font-weight:800;line-height:1.05;margin:6px 0 0;letter-spacing:-.02em;color:var(--ink);font-variant-numeric:tabular-nums}
.dsn .fig .n small{font-size:14px;font-weight:600;color:var(--mute);letter-spacing:0}
.dsn .fig .n.word{font-size:17px;line-height:1.3;color:var(--orange-ink)}
.dsn .fig .src{margin:8px 0 0;font-size:11.5px;color:var(--mute);line-height:1.45}

/* the gauge pill: the one orange thing on a plate */
/* ---------------------------------------------------------------- how far through the job we are
   One dial, one verdict, and the figures behind both. It sits on Today, on Where we are and in the email that
   goes out, and it is drawn once so the three can never drift apart. Andrew Fisher, 13 Sep 2026: the business
   works from visuals and data — a percentage of completion to race day, and whether we are on track or
   not. */
/* Nothing here may make the page scroll sideways, not even for the frame between the first paint and the media
   query settling — on a phone that shows as the whole page jogging left. So the block is bounded to its column
   and every part is allowed to shrink, rather than relying on a breakpoint to save them. */
.cblock{max-width:min(100%, 1060px);overflow:hidden}
.chead{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:2px 0 14px}
.chead > div:first-child{flex:1 1 200px;min-width:0}
.ceyebrow{margin:0;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-ink)}
@media (prefers-color-scheme:dark){.ceyebrow{color:var(--orange)}}
.ctitle{margin:2px 0 0;font-size:26px;font-weight:800;letter-spacing:-.025em;color:var(--ink);line-height:1.1}
.csub{margin:4px 0 0;font-size:12px;color:var(--mute)}
.crace{flex:0 0 auto;display:flex;align-items:baseline;gap:7px;padding:8px 14px;border:1px solid var(--rule);
  border-radius:10px;background:var(--paper);box-shadow:var(--lift)}
.crace b{font-size:24px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.crace span{font-size:12px;color:var(--mute)}
/* gauge left, the figures right — one grid, so the two columns line up top and bottom at every width */
/* The gauge column is BOUNDED. Left to grow it took half a wide page, and everything inside it grew with it. */
.cgrid{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:16px;align-items:stretch;max-width:100%}
/* The gauge sits on its own dark plate. It is the one thing on the page that is a PICTURE rather than a figure,
   and the plate is what says so. --gauge-* are its own tokens, defined for both themes, because a near-black
   card on a near-black page needs a different near-black. */
.cgauge{--gauge-bg:#241c16;--gauge-ink:#fff;--gauge-mute:#b9ada3;--gauge-track:#4a3d33;
  min-width:0;border-radius:16px;padding:15px 16px 14px;background:
    radial-gradient(120% 95% at 50% 118%, rgba(255,106,19,.30) 0%, rgba(255,106,19,0) 62%), var(--gauge-bg);
  border:1px solid #3a2e25;display:flex;flex-direction:column;justify-content:center}
@media (prefers-color-scheme:dark){.cgauge{--gauge-bg:#120f0d;--gauge-track:#3a302a;border-color:#2e2622}}
/* ---------------- the instrument: the 260-degree dial Andrew Fisher approved on 15 Sep 2026.
   Every colour is a token so the whole face can be turned to ink on paper by redefining six values, rather than
   by a second copy of the markup. No colour carries a meaning on its own: the arc is orange at every value and
   the words beside it say whether that is good. */
.cgauge.gi{--gi-rim:url(#girim);--gi-bez:#0e171a;--gi-disc:url(#gifac);--gi-track:#354447;--gi-fill:#ff6a13;
  --gi-maj:#d9e0d7;--gi-med:#80968f;--gi-min:#4e6662;--gi-lab:#c6d0c9;--gi-cap:#c4cdc6;--gi-cap2:#829791;
  --gi-n1:#ff8434;--gi-n2:#ffe9bf;--gi-hub:#0a1215;--gi-hubline:#687c7a;--gi-rule:#52615b;--gi-foot:#96aaa0;
  background:linear-gradient(140deg,#282f30 0%,#121718 61%,#232a2b 100%);border-color:#42494a;
  padding:14px 12px 13px;box-shadow:inset 0 0 0 1px #42494a}
.gitop{display:flex;justify-content:space-between;gap:12px;padding:0 6px;color:#c0c6c2;font-size:10px;
  letter-spacing:.12em;text-transform:uppercase;font-weight:700}
.gitop span:last-child{color:var(--gi-fill)}
.giscope{display:flex;justify-content:center;margin-top:12px;gap:3px}
.giscope .gsc{flex:1;min-width:0;font:inherit;font-size:12px;font-weight:700;padding:9px 10px;border-radius:2px;
  border:1px solid #464d4e;background:transparent;color:#d4d9d3;cursor:pointer;min-height:40px}
.giscope .gsc.on{background:#343734;color:#fff;border-bottom:2px solid var(--gi-fill)}
.giface{position:relative;width:100%;max-width:520px;margin:2px auto 0;container-type:inline-size}
.giface svg{display:block;width:100%;height:auto}
.girim{fill:var(--gi-rim)} .gibez{fill:var(--gi-bez)} .gidisc{fill:var(--gi-disc)}
.gitrack{stroke:var(--gi-track)} .gifill{stroke:var(--gi-fill)}
.gk{stroke:var(--gi-min);stroke-width:1} .gk.med{stroke:var(--gi-med)} .gk.maj{stroke:var(--gi-maj);stroke-width:2}
.gl{fill:var(--gi-lab);font-family:Arial,sans-serif;font-size:23px;text-anchor:middle}
.gicap{fill:var(--gi-cap);font-family:Arial,sans-serif;font-size:14px;text-anchor:middle;letter-spacing:3px}
.gicap2{fill:var(--gi-cap2);font-family:Arial,sans-serif;font-size:11px;text-anchor:middle;letter-spacing:2px}
.gin1{fill:var(--gi-n1)} .gin2{fill:var(--gi-n2)}
.gihub{fill:var(--gi-hub);stroke:var(--gi-hubline);stroke-width:1} .gipin{fill:var(--gi-fill)}
.girule{stroke:var(--gi-rule);stroke-width:1;fill:none}
.gifoot{fill:var(--gi-foot);font-family:Arial,sans-serif;font-size:12px;text-anchor:middle;letter-spacing:3px}
/* the needle turns about the dial's own centre, and it settles rather than snapping — 720 ms, the timing the
   review specified and Andrew Fisher approved. A device asking for less motion gets the same reading, still. */
.gineedle{transform-origin:260px 232px;transition:transform 720ms cubic-bezier(.22,.7,.25,1)}
@media (prefers-reduced-motion:reduce){.gineedle{transition:none}}
.gidig{position:absolute;top:58%;left:0;right:0;text-align:center;pointer-events:none}
.gidig b{font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;
  font-weight:700;font-size:clamp(22px,11.2cqw,58px);letter-spacing:-.04em;line-height:1;color:#fff;
  font-variant-numeric:tabular-nums}
.gidig b i{font-style:normal;font-size:.38em;letter-spacing:-.02em;margin-left:2px;font-weight:400}
.gidig p{margin:calc(.6cqw + 2px) 0 0;font-size:clamp(7px,1.9cqw,10px);letter-spacing:.15em;text-transform:uppercase;color:#b6c0bb}
.ginote{text-align:center;border-top:1px solid #3b4240;padding-top:11px;margin:10px 0 0;font-size:12px;color:#d2d8d2}
.ginote b{color:#fff}
.cgauge.gi .cgnote{color:#b6c0bb;border:0;margin-top:8px}
.cgauge.gi .cgdot{background:var(--gi-fill)}
/* ---------------- the instrument, moving.
   The needle SWEEPS to its reading rather than appearing at it, because an instrument that is already settled
   when you look at it has told you nothing about itself. Andrew Fisher, 15 Sep 2026: these animate.

   It plays for a REASON and not on every repaint: the first time this device sees the instrument, and whenever
   the reading actually changes — a scope pressed, a light set, a different day chosen. A re-render that changes
   nothing plays nothing, the same rule the delivery lamps have carried since 13 Sep. A dial that re-swept every
   few seconds would be a dial nobody reads.

   Nothing waits for it: the needle is placed at its final angle in the markup, and the sweep is a transition
   FROM the old angle. So a device that refuses the animation, or a person who has asked for less motion, gets
   the same correct reading immediately — never a needle stuck at zero. */
@keyframes giSweep{from{opacity:.001} to{opacity:1}}
@keyframes giArc{from{stroke-dashoffset:var(--gi-len)} to{stroke-dashoffset:0}}
@keyframes giDigit{0%{opacity:.35;transform:translateY(3px)} 100%{opacity:1;transform:none}}
.gineedle{transform-origin:260px 232px}
@keyframes giNeedle{from{transform:rotate(var(--gi-from))} to{transform:rotate(var(--gi-to))}}
.cgauge.gi.sweep .gineedle{animation:giNeedle 720ms cubic-bezier(.22,.7,.25,1) both}
.cgauge.gi.sweep .gifill{stroke-dasharray:var(--gi-len);animation:giArc 720ms cubic-bezier(.22,.7,.25,1) both}
.cgauge.gi.sweep .gidig b{animation:giDigit 520ms ease-out both;animation-delay:140ms}
@media (prefers-reduced-motion:reduce){
  .cgauge.gi.sweep .gineedle{animation:none}
  .cgauge.gi.sweep .gifill{animation:none;stroke-dasharray:none}
  .cgauge.gi.sweep .gidig b{animation:none}
}
@media print{ .cgauge.gi .gineedle{animation:none} .cgauge.gi .gifill{animation:none;stroke-dasharray:none} }
/* ---------------- the showcase */
.show{position:fixed;inset:0;z-index:90;background:#13191b;color:#f3f1e8;display:flex;flex-direction:column;
  overflow:auto;border-top:5px solid var(--orange)}
body.showing{overflow:hidden}
.show[hidden]{display:none !important}
/* ---------------- the Coates Way machine, inside the page (v5.77) */
.machine{position:fixed;inset:0;z-index:92;background:#11171b;color:#f3f1e8;display:flex;flex-direction:column;border-top:5px solid var(--orange)}
.machine[hidden]{display:none !important}
body.machining{overflow:hidden}
.mtop{flex:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 14px;border-bottom:1px solid #2a3338;min-height:52px}
.mtop .mname{margin:0;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:#d1d6cf}
.mtop .mname i{font-style:normal;color:#8b9aa3;margin-left:8px;letter-spacing:.04em;text-transform:none;font-weight:500}
.mtop .mbtns{display:flex;gap:8px;align-items:center;flex-wrap:nowrap;flex:none}
.mpages{display:flex;gap:4px;margin-right:6px}.mpages .btn[aria-pressed="true"]{background:var(--orange);color:#1b1207;border-color:var(--orange)}
@media (max-width:720px){.mname{display:none}.mpages .btn,.mbtns .btn{padding:6px 8px;font-size:12px}#machineOwn{display:none}}
.mtop .btn{font-size:12.5px;font-weight:700;min-height:40px;padding:8px 14px;border-radius:6px;background:var(--orange);color:#fff;border:1px solid transparent;white-space:nowrap}
.mtop .btn.ghost{background:transparent;color:#e6e9e4;border-color:#3d4a50}
.mtop .btn:focus-visible{outline:2px solid #fff;outline-offset:2px}
.mframe{flex:1;min-height:0;position:relative;background:#11171b}
.mframe iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#11171b}
.mwait{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#9fb0aa;font-size:14px;pointer-events:none}
.cwhero{position:relative;display:block;width:100%;margin:0 0 14px;border-radius:14px;overflow:hidden;background:#11171b;border:1px solid var(--hdr-rule);aspect-ratio:1600/995;cursor:default}
.cwhero img,.cwhero video{display:block;width:100%;height:100%;object-fit:cover;background:#0b0f12}
.cwhero.opens{cursor:pointer}
.cwhero .cwherotag{position:absolute;left:14px;bottom:12px;display:flex;gap:8px;align-items:center;padding:7px 12px;border-radius:9px;background:#10171cd9;color:#f3f1e8;font-size:12.5px;font-weight:700;letter-spacing:.04em;border:1px solid #ffffff2a;pointer-events:none}
.cwhero .cwherotag i{width:8px;height:8px;border-radius:50%;background:var(--orange);box-shadow:0 0 10px #ff6a1380}
.cwhero:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
.cwm{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
.cwm .cwmpic{flex:none;width:132px;height:88px;border-radius:8px;background:#11171b;border:1px solid #2a3338;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--orange);font-weight:800;font-size:22px;letter-spacing:.04em;overflow:hidden}
.cwm .cwmpic img{width:100%;height:100%;object-fit:cover;display:block}
.cwm .cwmpic small{font-size:10px;letter-spacing:.14em;color:#9fb0aa;font-weight:700}
.cwm .cwmtxt{flex:1 1 260px;min-width:0}
.cwm .cwmtxt p{margin:4px 0 0}
.cwm .cwmact{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}
.cwm .cwmst{font-size:12.5px;color:var(--muted,#646d77)}
@media (max-width:600px){.mtop{padding:6px 10px;min-height:48px}.mtop .mname{font-size:11px;letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}.mtop .mname i{display:none}.mtop .btn{min-height:36px;padding:6px 10px;font-size:12px}}
.shtop{padding:18px 24px 14px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;
  flex-wrap:wrap;border-bottom:1px solid #354041;flex:none}
.shbrand{margin:0;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:#d1d6cf}
.shchap{margin:6px 0 0;font-size:13px;color:#9fb0aa;letter-spacing:.06em;text-transform:uppercase}
.shchap i{font-style:normal;color:#6f8681;margin-left:8px;font-variant-numeric:tabular-nums}
.shtopr{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.shbtn{font:inherit;font-size:12.5px;font-weight:700;min-height:44px;padding:9px 14px;border-radius:3px;
  border:1px solid #53605f;background:transparent;color:#f3f1e8;cursor:pointer}
.shbtn:hover:not(:disabled){background:#313b3c}
.shbtn:disabled{opacity:.38;cursor:default}
.shbtn.back{border-color:var(--orange);color:#ffd7b8}
/* the launch lamps. Three lights, and a line of type under them saying they mean nothing, because a red light
   on a screen in a site office means something to everyone who walks past it. */
.shlamps{display:flex;align-items:center;gap:6px;padding:6px 10px;border:1px solid #3c4b4c;border-radius:3px;background:#0e1517}
.shlamps[hidden]{display:none}
.shlamps i{width:13px;height:13px;border-radius:50%;background:#2c3634;box-shadow:inset 0 1px 2px rgba(0,0,0,.6)}
.shlamps i[data-lamp="r"].on{background:#ff3b2f;box-shadow:0 0 10px rgba(255,59,47,.6)}
.shlamps i[data-lamp="a"].on{background:#ffb300;box-shadow:0 0 10px rgba(255,179,0,.6)}
.shlamps i[data-lamp="g"].on{background:#2ee56f;box-shadow:0 0 10px rgba(46,229,111,.6)}
.shlampw{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:#8c9a96;margin-left:6px}
/* THE SCENE FITS THE SCREEN IT IS ON. Andrew Fisher's photographs of the TV in the site office, 17 Sep 2026: the
   top line of "Done, and checked." and "Metres in the ground." cut off under the header, the kick line under it
   gone, the fine print gone under the footer. The scene centred its content with align-items and hid its
   overflow, so content taller than the box lost its top and nothing could reach it. Now: the wrapper centres
   itself with auto margins (which give way at the top when there is no room), the box scrolls rather than hides
   as a last resort, the type is sized by the height as well as the width, and showFit() measures the finished
   scene and zooms it down until it fits — so a zoomed browser on a 4K television and a phone held sideways both
   get the whole scene. */
/* overflow-x hidden: after a scene's sweep the parked .shsweep sat 390% of its width to the right and, with
   overflow:auto, put a horizontal scrollbar across the whole show (found by the 3D scene's authors, 17 Sep 2026) */
.shscene{--u:14px;flex:1;min-height:0;position:relative;padding:calc(var(--u)*1.5) calc(var(--u)*2) calc(var(--u)*1.2);display:flex;align-items:flex-start;overflow:hidden auto;z-index:0}
.shwrap{max-width:calc(var(--u)*72);width:100%;margin:0 auto;position:relative;z-index:1}
.shk{margin:0 0 calc(var(--u)*.85);font-size:calc(var(--u)*.80);letter-spacing:.17em;text-transform:uppercase;color:#ff9956;font-weight:700}
.shscene h2{margin:0;font-size:calc(var(--u)*4.6);line-height:1.03;letter-spacing:-.055em;font-weight:800}
.shf{margin:calc(var(--u)*1.15) 0 0;font-size:calc(var(--u)*.95);line-height:1.5;color:#aab8b1;max-width:min(62ch,calc(var(--u)*52))}
.shbig{margin:calc(var(--u)*1.25) 0 calc(var(--u)*.4);font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);
  font-style:italic;font-weight:700;font-size:calc(var(--u)*9.2);line-height:.95;letter-spacing:-.06em;
  font-variant-numeric:tabular-nums;color:#fffaf0}
.shbig small{font-size:.22em;font-style:normal;font-weight:400;letter-spacing:-.01em;color:#cad3cc;margin-left:.42em}
.shrow{display:flex;justify-content:space-between;gap:calc(var(--u)*1);border-top:1px solid #374341;padding:calc(var(--u)*.78) 0;font-size:calc(var(--u)*1);color:#cad4cb}
.shrow b{font-size:calc(var(--u)*1.5);letter-spacing:-.03em;color:#fbf6ed}
.shof{font-size:calc(var(--u)*.95);font-weight:400;color:#9fb0aa;letter-spacing:0}
.shclock{display:grid;grid-template-columns:repeat(4,1fr);max-width:calc(var(--u)*46);column-gap:calc(var(--u)*1.2);align-items:baseline;margin:calc(var(--u)*1.4) 0 calc(var(--u)*.3)}
.shclock b{grid-row:1} .shclock span{grid-row:2}
@media (max-width:520px){ .shclock{grid-template-columns:repeat(2,auto);row-gap:calc(var(--u)*.6)} .shclock b:nth-of-type(3),.shclock b:nth-of-type(4){grid-row:3} .shclock span:nth-of-type(3),.shclock span:nth-of-type(4){grid-row:4} }
.shclock b{font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;
  font-weight:700;font-size:calc(var(--u)*7.2);line-height:.95;letter-spacing:-.06em;color:#fffaf0;
  font-variant-numeric:tabular-nums}
.shclock b.cdz{color:#9fb0aa}
.shclock span{font-size:calc(var(--u)*.80);letter-spacing:.13em;text-transform:uppercase;color:#9fb0aa;margin:0}
.shppl{list-style:none;margin:calc(var(--u)*1.4) 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(calc(var(--u)*16),1fr));gap:calc(var(--u)*.9) calc(var(--u)*1.6)}
.shppl li{border-top:1px solid #374341;padding:calc(var(--u)*.8) 0}
.shppl b{display:block;font-size:calc(var(--u)*1.5);letter-spacing:-.03em}
.shppl span{font-size:calc(var(--u)*.92);color:#aab8b1}
/* one person, one card — the same lines in the same order, wherever a person is shown */
.shcards{list-style:none;margin:calc(var(--u)*1.4) 0 0;padding:0;display:grid;
  grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:calc(var(--u)*1) calc(var(--u)*1.3)}
@media (max-width:900px){ .shcards{grid-template-columns:repeat(2,minmax(0,1fr))} }
@media (max-width:520px){ .shcards{grid-template-columns:1fr} }
/* the fencing crew's eight cards: four across, two rows, on any screen wide enough — never five and three */
@media (min-width:1000px){ .shcards.crew8{grid-template-columns:repeat(4,minmax(0,1fr))} }
/* the org chart's own row of nodes: it draws one connector across the top, so it holds while the nodes fit
   across the plate. Past that it becomes a plain grid of cards under one heading — legible beats schematic. */
.shorg-row.wrapped{display:grid;grid-template-columns:repeat(auto-fit,minmax(calc(var(--u)*13),1fr));gap:calc(var(--u)*1.1) calc(var(--u)*1.3)}
.shorg-row.wrapped::before{display:none} .shorg-row.wrapped .shstub{display:none} .shorg-row.wrapped .shnode{padding-top:0}
.shcard{border-top:2px solid #4a5856;padding:calc(var(--u)*.85) 0 0;display:flex;flex-direction:column;gap:calc(var(--u)*.2);min-width:0}
.shcard.lead{border-top-color:var(--orange)}
.shcard .shpn{font-size:calc(var(--u)*1.58);letter-spacing:-.03em;color:#fbf6ed;line-height:1.1}
.shcard .shpr{font-size:calc(var(--u)*.78);letter-spacing:.14em;text-transform:uppercase;color:#ff9956;font-weight:700;margin:calc(var(--u)*.15) 0 calc(var(--u)*.2)}
.shcard .shpt{font-size:calc(var(--u)*.92);color:#aab8b1}
.shcard .shpm{font-size:calc(var(--u)*1.28);font-weight:700;color:#fff7ea;font-variant-numeric:tabular-nums;letter-spacing:.01em;margin-top:calc(var(--u)*.3)}
.shcard .shpp{font-size:calc(var(--u)*.98);color:#cad4cb;font-variant-numeric:tabular-nums}
.shcard .shpe{font-size:calc(var(--u)*.86);color:#9fb0aa;overflow-wrap:anywhere}
.shcard.grp{gap:0}
.shcard.grp > .shpr{margin-bottom:6px}
.shcard .shsub{display:flex;flex-direction:column;gap:calc(var(--u)*.12);padding:calc(var(--u)*.5) 0 calc(var(--u)*.55);border-top:1px solid #2f3a38}
.shcard .shsub .shpn{font-size:calc(var(--u)*1.28)}
.shcard .shsub .shpm{font-size:calc(var(--u)*1.05);margin-top:calc(var(--u)*.15)}
/* (the 1600-point bump that used to live here is gone: every size is a multiple of --u, which is measured
   from the plate, so a wall-sized screen scales the whole scene rather than four hand-picked lines) */
/* the org chart: the lead above, one node per group below, joined by the event's lines; a group of several
   people spans one column each, under one label */
.shwrap.wide{max-width:calc(var(--u)*100)}
/* the 3D backdrop writes its credit along the foot of the plate, so the scene keeps a strip clear for it and
   the words never land on top of it, at any size (v5.41) */
.show[data-back="circuit3d"] .shscene,.show[data-back="circuit3d_day"] .shscene{padding-bottom:calc(var(--u)*1.2 + 26px)}
/* v5.43 — under the day backdrop the type carries its own shadow. Cream on a sunlit circuit needs contrast, and
   giving it to the letters is far better than dimming the picture until it is dusk: the scrim then only has to
   look after the left of the plate, and the sky, the water and the far side of the circuit stay daylit. */
/* v5.45 — a label carrying the hidden attribute must actually hide. The View control is a .shloop label, and
   .shloop sets display:flex, which beats the browser's own [hidden]{display:none} — so it sat in the controls
   with an empty dropdown on every backdrop that has no camera to choose. Caught in the render. */
.shloop[hidden],.shbackl[hidden]{display:none}
.show[data-back="circuit3d_day"] .shscene{text-shadow:0 1px 2px rgba(8,12,14,.55),0 2px 10px rgba(8,12,14,.42)}
.show[data-back="circuit3d_day"] .shscene .shprop,.show[data-back="circuit3d_day"] .shscene .shmeter{box-shadow:0 1px 6px rgba(8,12,14,.35)}
/* the quiet second figure on a row ("of 8,088.5 m") is a muted grey chosen for a dark plate; over daylight it
   drops out, so under this backdrop it comes up to near the main figure's weight (v5.43) */
.show[data-back="circuit3d_day"] .shscene .shf span,.show[data-back="circuit3d_day"] .shscene .shrow span,
.show[data-back="circuit3d_day"] .shscene small,.show[data-back="circuit3d_day"] .shscene em{color:#e8edef}
/* v5.41 — the words no longer hug the left under the 3D scene: the scene is drawn behind them at any shape, so
   the wrap keeps the same place on every backdrop and every scene starts where the last one did */
.shorg{margin-top:calc(var(--u)*1.1)}
.shorg-top{display:flex;justify-content:center}
.shorg-top .shcard{min-width:calc(var(--u)*20);max-width:calc(var(--u)*27);text-align:center;align-items:center;border-top-width:3px}
.shorg-stem{display:block;width:2px;height:calc(var(--u)*1.4);background:#4a5856;margin:0 auto}
.shorg-row{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n,4),minmax(0,1fr));gap:0 12px;position:relative}
.shorg-row::before{content:"";position:absolute;left:var(--l,12%);right:var(--r,12%);top:0;height:2px;background:#4a5856}
.shnode{position:relative;padding-top:calc(var(--u)*1.1);min-width:0;grid-column:span var(--k,1)}
.shnode .shstub{position:absolute;left:50%;top:0;width:2px;height:calc(var(--u)*1.1);background:#4a5856;margin-left:-1px}
.shnode .shcard{border-top-width:2px}
.shglabel{font-size:calc(var(--u)*.78);letter-spacing:.14em;text-transform:uppercase;color:#ff9956;font-weight:700;text-align:center;
  border-top:2px solid #4a5856;padding:8px 0 0}
.shgrow{display:grid;grid-template-columns:repeat(var(--k,1),minmax(0,1fr));gap:0 10px}
.shgrow .shcard{border-top:1px solid #2f3a38;padding-top:8px}
.shcard.names{padding-top:8px;border-top:1px solid #2f3a38}
.shcard.names .shpn{font-size:calc(var(--u)*1.2);line-height:1.25}
@media (max-width:760px){
  .shorg-row{grid-template-columns:1fr;gap:10px}
  .shorg-row::before,.shnode .shstub,.shorg-stem{display:none}
  .shnode{padding-top:0;grid-column:auto}
  .shgrow{grid-template-columns:1fr}
  .shglabel{text-align:left}
  .shorg-top .shcard{min-width:0;max-width:none;width:100%;text-align:left;align-items:flex-start}
}
/* a short, wide screen: the milestone lists in two columns rather than a scroll */
@media (max-height:560px) and (min-width:700px){ .shdates,.shnext{column-count:2;column-gap:34px} .shdates li,.shnext li{break-inside:avoid} }
/* documents read as a list; dates and the days coming read ACROSS the scene as cards, so four or five of them
   are one row a viewer takes in at a glance instead of a column running down a tall plate (v5.41) */
.shdocs{list-style:none;margin:calc(var(--u)*1.4) 0 0;padding:0}
.shdocs li{border-top:1px solid #374341;padding:calc(var(--u)*.85) 0;display:flex;justify-content:space-between;gap:calc(var(--u)*1.3);align-items:baseline}
.shdocs b{font-size:calc(var(--u)*1.32);letter-spacing:-.02em;max-width:34em}
.shdocs span{font-size:calc(var(--u)*.92);color:#9fb0aa;font-family:ui-monospace,Menlo,Consolas,monospace;white-space:nowrap}
.shdates,.shnext{list-style:none;margin:calc(var(--u)*1.4) 0 0;padding:0;display:grid;
  grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));gap:calc(var(--u)*1.1) calc(var(--u)*1.4)}
/* the row never leaves an orphan: the column count is the number of items, and it steps down whole on a
   narrower plate rather than wrapping three and one (v5.41) */
@media (max-width:900px){ .shdates,.shnext{grid-template-columns:repeat(2,minmax(0,1fr))} }
@media (max-width:520px){ .shdates,.shnext{grid-template-columns:1fr} }
.shdates li,.shnext li{border-top:2px solid #4a5856;padding:calc(var(--u)*.7) 0 0;display:flex;flex-direction:column;gap:calc(var(--u)*.12);min-width:0}
.shdates b,.shnext b{font-size:calc(var(--u)*2.6);letter-spacing:-.04em;color:#fff7ea;font-variant-numeric:tabular-nums;line-height:1}
.shdates em,.shnext em{font-style:normal;font-size:calc(var(--u)*.98);color:#fbf6ed;letter-spacing:-.01em}
.shdates span,.shnext span{font-size:calc(var(--u)*.88);color:#9fb0aa;text-align:left}
.shmeter{height:calc(var(--u)*.46);background:#2b3634;margin:calc(var(--u)*.45) 0 calc(var(--u)*1);max-width:calc(var(--u)*46)}
.shmeter i{display:block;height:100%;background:var(--orange)}
.shtrack{display:flex;gap:calc(var(--u)*.22);margin-top:calc(var(--u)*1.5);flex-wrap:wrap}
.shtrack span{flex:1 1 calc(var(--u)*.45);min-width:calc(var(--u)*.3);height:calc(var(--u)*1.5);background:#35423e}
.shtrack span.past{background:var(--orange)} .shtrack span.now{background:#ffe1c8}
/* the proportion bar: what is ticked against what it is ticked out of, in one length a viewer can read —
   the old grid of loose blocks counted nothing a person could follow (v5.41) */
.shprop{margin:calc(var(--u)*1.2) 0 0;max-width:calc(var(--u)*52)}
.shprop .shpbar{display:flex;height:calc(var(--u)*1.7);background:#252f2d;overflow:hidden}
.shprop .shpbar i{display:block;height:100%}
.shprop .shpbar i.a{background:var(--orange)} .shprop .shpbar i.b{background:#5c6b66}
.shprop .shpkey{display:flex;gap:calc(var(--u)*1.6);flex-wrap:wrap;margin-top:calc(var(--u)*.55);font-size:calc(var(--u)*.9);color:#bac5be}
.shprop .shpkey span{display:flex;align-items:center;gap:calc(var(--u)*.4)}
.shprop .shpkey i{width:calc(var(--u)*.8);height:calc(var(--u)*.8);display:block}
.shprop .shpkey b{color:#fbf6ed;font-variant-numeric:tabular-nums}
.shfoot{flex:none;padding:0 24px 18px;border-top:1px solid #33403a}
.shbar{display:flex;gap:4px;margin:14px 0 13px}
.shbar span{height:3px;flex:1;background:#35413d}
.shbar span.done{background:#87968b} .shbar span.now{background:var(--orange)}
.shctl{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.shctlg{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.shloop{display:flex;gap:7px;align-items:center;font-size:12.5px;color:#c7d1c5;min-height:44px;cursor:pointer}
.shloop input{width:18px;height:18px;accent-color:var(--orange)}
.shsel{min-height:36px;padding:4px 8px;font-weight:600;background:#13191b}
.shbackl{margin-left:10px}
.shstate{margin:0;font-size:12px;color:#adb9ae}
/* v5.63 — the finder's two new kinds: a document, and one day of a per-day document. */
.fipin.dc{background:#2d3a44;color:#dfe7ec;font-size:9px;letter-spacing:.4px}
.fipin.dy{background:#b4521a;color:#fff;font-weight:700}
/* v5.63 — the 3D fallback notice. It sits with the controls, not on the plate and not in .gc3d-ui,
   because both of those are removed at the moment it has something to say. */
.sh3dnote{margin:6px 0 0;font-size:12px;color:#e8c37a;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sh3dnote .shbtn{font-size:12px;padding:2px 8px}
.shsrc{margin:13px 0 0;padding-top:12px;border-top:1px solid #2b3733;font-size:11px;color:#8fa09a;max-width:90ch}
/* the movement: a scene settles in, and a narrow orange light crosses its edge once. Both are decoration and
   both stop dead for a person who has asked for less motion — the words and the figures never move. */
@keyframes shIn{from{opacity:0;transform:translateY(17px)} to{opacity:1;transform:none}}
@keyframes shSweep{0%{opacity:0;transform:translateX(-100%)} 28%{opacity:.7} 100%{opacity:0;transform:translateX(390%)}}
@keyframes shBars{from{opacity:.2;transform:scaleY(.3)} to{opacity:1;transform:none}}
.shsweep{position:absolute;left:0;top:0;height:1px;width:35%;pointer-events:none;
  background:linear-gradient(90deg,transparent,var(--orange),transparent);opacity:0}
/* backwards, not both: with the final frame held, the sweep sat parked 390% to the right and counted as overflow */
.shscene.in .shsweep{animation:shSweep 2100ms ease-out backwards}
.shscene.in .shwrap > *{animation:shIn 700ms cubic-bezier(.22,.7,.25,1) both}
.shscene.in .shwrap > *:nth-child(2){animation-delay:110ms}
.shscene.in .shwrap > *:nth-child(3){animation-delay:220ms}
.shscene.in .shwrap > *:nth-child(4){animation-delay:330ms}
.shscene.in .shwrap > *:nth-child(5){animation-delay:440ms}
.shscene.in .shtrack span,.shscene.in .shgrid span{animation:shBars 550ms ease-out both;animation-delay:var(--d,0ms)}
@media (prefers-reduced-motion:reduce){
  .shscene.in .shsweep,.shscene.in .shwrap > *,.shscene.in .shtrack span,.shscene.in .shgrid span{animation:none}
}
@media (max-width:760px){
  .shtop{padding:14px 16px 12px} .shscene{padding:calc(var(--u)*1.3) 16px calc(var(--u)*1)} .shfoot{padding:0 16px 14px}
  .shdocs li,.shdates li,.shnext li{flex-direction:column;gap:4px}
  .shdates span,.shnext span{text-align:left}
  .shlampw{display:none}
}
@media (max-height:640px){
  .shtop{padding:8px 18px 6px} .shchap{margin-top:2px}
  .shfoot{padding-bottom:8px} .shbar{margin:8px 0 7px} .shsrc{margin-top:7px;padding-top:6px}
  .shbtn{min-height:36px;padding:6px 11px}
}
/* Controls remain scrollable on a phone without consuming the whole scene. */
@media (max-width:699px),(max-height:560px){
  .show .shfoot{max-height:40vh;max-height:40dvh;overflow-y:auto;overscroll-behavior:contain}
  .show .shstage{min-height:150px}
}
@media (max-height:400px){ .show .shstage{min-height:120px} }
/* THE BACKDROP IS DECORATION. Andrew Fisher, 17 Sep 2026: black works; show some ideas with V8 Supercars
   rendered in the background. Four to choose from beside the black, chosen on the device and
   kept there (gc500.showback), every one drawn in code except the last, which is his own photograph of the
   Coates 26 car — the still the page already carries — dimmed behind the type. No picture is made up, nothing
   is fetched, and the figures sit on a dark plate over every one of them so the record stays the thing you
   read. The footer says the backdrop is decoration. */
.shstage{flex:1;min-height:0;position:relative;display:flex;flex-direction:column}
.shstage .shscene{flex:1;min-height:0;z-index:1}
/* Car focus leaves the stage clear while the unchanged figures remain available with one press. */
.show.car-focus .shscene{visibility:hidden;pointer-events:none}
.show.car-focus .shplate::after{display:none}
#showCarFocus[aria-pressed="true"]{border-color:var(--orange);background:#7c310a;color:#fff}
.shplate{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none;background:#13191b}
.shplate::before{content:"";position:absolute;inset:0;opacity:0;will-change:transform}
.show:not([data-back="black"]) .shplate::after{content:"";position:absolute;inset:0;z-index:3;
  background:linear-gradient(90deg,rgba(19,25,27,.94) 0%,rgba(19,25,27,.74) 44%,rgba(19,25,27,.1) 100%)}
/* a phone has no side to keep the type on: the whole backdrop sits under the figures, so it is dimmed evenly */
@media (max-width:699px){ .show:not([data-back="black"]) .shplate::after{background:rgba(19,25,27,.78)} }
/* THE GEOSPATIAL BACKDROP GETS ITS OWN SCRIM, the same shape as every other one — solid where the figures are,
   clear where the city is — but opening further and sooner to the right, because this is the backdrop actually
   worth looking at and the default gradient was still dimming the skyline at three quarters of the way across. */
.show[data-back^="geo"] .shplate::after{background:linear-gradient(90deg,rgba(19,25,27,.97) 0%,rgba(19,25,27,.88) 28%,
  rgba(19,25,27,.40) 52%,rgba(19,25,27,.06) 78%,rgba(19,25,27,0) 100%)}
/* and a little weight into the corners, so the scene sits in the plate rather than stopping at its edge */
.show[data-back^="geo"] .shplate::before{opacity:1;z-index:3;
  background:radial-gradient(128% 104% at 66% 40%,rgba(0,0,0,0) 34%,rgba(4,7,9,.30) 74%,rgba(4,7,9,.62) 100%)}
@media (max-width:699px){ .show[data-back^="geo"] .shplate::after{background:rgba(19,25,27,.80)} }
.shplate video,.shplate canvas,.shplate svg,.shplate .shglide{position:absolute;inset:0;width:100%;height:100%}
.shplate video{object-fit:cover;object-position:center;filter:saturate(.85) brightness(.62);opacity:0;transition:opacity 700ms ease;z-index:1}
.shplate video.on{opacity:1}
.shplate img.shpic{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.8) brightness(.6);z-index:1;
  animation:shKen 48s ease-in-out infinite alternate;will-change:transform}
.shplate canvas{z-index:2}
.shplate svg.shcircuit{z-index:1}
/* a soft band of light crossing the plate, the one movement every backdrop but black shares */
.shplate .shglide{z-index:2;width:38%;left:-40%;opacity:.16;background:linear-gradient(100deg,transparent 0%,rgba(255,214,170,.9) 50%,transparent 100%);
  animation:shGlide 14s cubic-bezier(.45,0,.2,1) infinite;animation-delay:2s}
@keyframes shGlide{0%{transform:translateX(0)} 100%{transform:translateX(370%)}}
@keyframes shKen{from{transform:scale(1) translate(0,0)} to{transform:scale(1.09) translate(-1.6%,-1.2%)}}
.show[data-back="carbon"] .shplate::before{opacity:1;
  background:
    linear-gradient(112deg,transparent 57%,rgba(255,106,19,.42) 57.15%,rgba(255,106,19,.42) 57.6%,transparent 57.75%,transparent 59%,rgba(255,106,19,.16) 59.15%,rgba(255,106,19,.16) 64%,transparent 64.15%,transparent 67%,rgba(255,106,19,.07) 67.15%,rgba(255,106,19,.07) 70%,transparent 70.15%),
    repeating-linear-gradient(45deg,#1a2123 0 6px,#121819 6px 12px),
    repeating-linear-gradient(-45deg,rgba(255,255,255,.035) 0 6px,transparent 6px 12px);
  background-blend-mode:normal,normal,overlay}
/* THE CIRCUIT IS THE REAL ONE (Andrew Fisher, 17 Sep 2026: the real track, not a made-up one). The ring
   is iEDM's own key plan off sheet K220, read from the PDF's vectors by pipeline/circuit_keyplan.py — the
   Surfers Paradise street circuit with the street grid round it, in the sheet's own orientation, the sheet's
   north drawn in the corner. A point of light laps it; that is decoration, and where it is means nothing. */
/* CRISP AT 4K, AND CHEAP (Andrew Fisher, 17 Sep 2026: television quality at 4K, crisp and sharp). Everything
   here is vector or drawn at the screen's own pixels; nothing is a picture scaled up. Measured before this was
   settled: one blurred halo repainted with the moving lights took a 4K plate from 60 to 4 frames a second in a
   software renderer. So the circuit is three layers that never make each other repaint — the map (one SVG,
   static once its ring has drawn on), the halo (its own SVG, blurred once, breathing through a composited
   opacity animation), and the lights (a canvas at the screen's pixel density, the only thing drawn each frame). */
.shplate svg.shcircuit,.shplate svg.shhalo,.shplate canvas.shlaps{shape-rendering:geometricPrecision;text-rendering:optimizeLegibility}
.shplate svg.shhalo{z-index:1;opacity:.55;animation:shPulse 3600ms ease-in-out infinite alternate;will-change:opacity}
.shplate canvas.shlaps{z-index:2}
@keyframes shPulse{from{opacity:.3} to{opacity:.85}}
.shcircuit .streets{fill:none;stroke:#40504d;stroke-width:.45;stroke-linecap:round}
.shcircuit .road{fill:url(#shroad);fill-rule:evenodd;stroke:none}
/* the ring draws itself on when the backdrop is chosen, then holds */
.shcircuit .edge{fill:none;stroke:#ff8a3a;stroke-width:1.05;stroke-opacity:1;stroke-linejoin:round;
  stroke-dasharray:var(--lap,1000px) var(--lap,1000px);stroke-dashoffset:var(--lap,1000px);animation:shDraw 2400ms cubic-bezier(.4,0,.2,1) forwards}
.shcircuit .edge.in{stroke:#ffd0a6;stroke-width:.75;stroke-opacity:.9;animation-delay:200ms}
@keyframes shDraw{to{stroke-dashoffset:0}}
.shhalo .halo{fill:none;stroke:#ff6a13;stroke-width:11;stroke-opacity:.75;stroke-linejoin:round;filter:url(#shbloom)}
.shcircuit .north{fill:none;stroke:#9fb0aa;stroke-width:.5;stroke-linejoin:round}
.shcircuit .north text{fill:#9fb0aa;stroke:none;font:600 4.5px/1 var(--sans,system-ui,sans-serif)}
.shcircuit .note{fill:#6f8681;stroke:none;font:400 3.2px/1 var(--sans,system-ui,sans-serif)}
@media (prefers-reduced-motion:reduce){
  .shplate .shglide,.shplate img.shpic,.shplate svg.shhalo{animation:none}
  .shcircuit .edge{animation:none;stroke-dashoffset:0}
}
@media print{ .show{display:none !important} }
/* the way in, on Where we are */
.showgo{display:inline-flex;align-items:center;gap:9px;font:inherit;font-size:13.5px;font-weight:800;
  min-height:44px;padding:10px 16px;border-radius:4px;border:1px solid var(--orange);background:var(--orange);
  color:#1b1207;cursor:pointer;letter-spacing:.01em}
.showgo:hover{background:#f25e08;border-color:#f25e08}
.showgo i{font-style:normal;font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.75}
@media print{ .showgo{display:none} }
/* ---------------- the delivery signals: four banks under the instrument */
.sigs{margin:14px 0 0;border:1px solid var(--rule);border-radius:14px;padding:14px 15px 12px;background:var(--paper)}
.sightl{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.sightl h3{margin:0;font-size:16px;letter-spacing:-.02em}
.sightl span{font-size:12px;color:var(--mute)}
.sigrow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
@media (max-width:760px){.sigrow{grid-template-columns:repeat(2,minmax(0,1fr))}}
.sig{min-width:0;text-align:left;font:inherit;cursor:pointer;border:1px solid #3c4b4c;border-radius:4px;
  background:linear-gradient(150deg,#222a2b,#13191a 70%);color:#f7f4e9;padding:11px 12px 10px;
  display:flex;flex-direction:column;gap:2px;--signal:#77837f}
.sig:hover{border-color:#5d6f6e}
.sig[aria-pressed="true"]{outline:2px solid var(--orange);outline-offset:1px}
.sig b{display:block;font-size:30px;line-height:1;letter-spacing:-.04em;font-variant-numeric:tabular-nums;color:#f7f4e9}
.sig span:last-child{font-size:11.5px;color:#b9c4bf;line-height:1.3}
.sigbank{display:flex;gap:4px;margin-bottom:10px;padding:5px 6px;background:#0e1517;border:1px solid #3c4b4c;border-radius:3px}
.sigbank i{flex:1;min-width:0;height:8px;border-radius:1px;background:#39433f;box-shadow:inset 0 1px 1px rgba(255,255,255,.09)}
/* lit is lit: the bank says "there are some", never how many. rgba rather than color-mix(), which an older
   site browser drops the whole rule over. */
.sig.lit .sigbank i{background:var(--signal);box-shadow:0 0 6px rgba(0,0,0,.001),inset 0 1px 1px rgba(255,255,255,.5)}
.sig.green{--signal:#9be18e} .sig.amber{--signal:#ffc46b} .sig.red{--signal:#ff7a6b} .sig.none{--signal:#8d9a96}
.sig.green.lit .sigbank i{box-shadow:0 0 6px rgba(155,225,142,.3),inset 0 1px 1px rgba(255,255,255,.5)}
.sig.amber.lit .sigbank i{box-shadow:0 0 6px rgba(255,196,107,.3),inset 0 1px 1px rgba(255,255,255,.5)}
.sig.red.lit .sigbank i{box-shadow:0 0 6px rgba(255,122,107,.3),inset 0 1px 1px rgba(255,255,255,.5)}
.signote{margin:10px 0 0;font-size:11.5px;color:var(--mute)}
/* the power-on: each lamp struck in turn, once, on the first draw. --d is the lamp's place in the row. */
@keyframes sigOn{0%{opacity:.15;transform:scaleY(.4)} 60%{opacity:1;transform:scaleY(1.15)} 100%{opacity:1;transform:scaleY(1)}}
@keyframes sigMoved{0%{transform:translateY(0)} 35%{transform:translateY(-3px)} 100%{transform:translateY(0)}}
@keyframes sigCount{0%{opacity:.3} 100%{opacity:1}}
.sig.poweron .sigbank i{animation:sigOn 300ms cubic-bezier(.2,.9,.3,1.2) both;animation-delay:var(--d)}
.sig.moved{animation:sigMoved 300ms cubic-bezier(.2,.9,.3,1.2) both}
.sig.moved b{animation:sigCount 300ms ease-out both}
@media (prefers-reduced-motion:reduce){
  .sig.poweron .sigbank i,.sig.moved,.sig.moved b{animation:none}
}
@media print{ .sig.poweron .sigbank i,.sig.moved,.sig.moved b{animation:none} }
@media print{
  .sig{background:#fff !important;color:#111;border-color:#bbb}
  .sig b{color:#111} .sig span:last-child{color:#444}
  .sigbank{background:#fff;border-color:#ccc} .sigbank i{background:#e6e6e6;box-shadow:none}
  .sig.lit .sigbank i{background:#666 !important;box-shadow:none !important}
  .signote{display:none}
}
@media print{
  /* ON PAPER THE FACE IS PAPER. A graphite dial printed solid is a page of ink for one number, and the number is
     the point. Same geometry, same needle, same reading — in ink. */
  .cgauge.gi{background:#fff !important;border:1px solid #bbb !important;box-shadow:none !important;
    --gi-rim:#e7e7e4;--gi-bez:#fff;--gi-disc:#fff;--gi-track:#d6d6d2;--gi-fill:#c2561a;--gi-maj:#333;
    --gi-med:#777;--gi-min:#aaa;--gi-lab:#333;--gi-cap:#333;--gi-cap2:#666;--gi-n1:#c2561a;--gi-n2:#7a3410;
    --gi-hub:#fff;--gi-hubline:#555;--gi-rule:#bbb;--gi-foot:#666}
  .cgauge.gi .gitop,.cgauge.gi .ginote,.cgauge.gi .cgnote{color:#333}
  .cgauge.gi .ginote b,.cgauge.gi .gidig b{color:#111}
  .cgauge.gi .gidig p{color:#555}
  .giscope{display:none}
  /* On paper the instrument is a figure on a report, not a face on a wall. Andrew Fisher, 12 Sep 2026: a
     beautifully presented page of details — the whole thing stays a short A4 report, so the dial is sized to
     earn its space rather than to fill the sheet. Same geometry, same needle, same reading. */
  .cgauge.gi{padding:8px 10px 9px}
  .cgauge.gi .giface{max-width:224px}
  .cgauge.gi .gidig{top:56%}
  .cgauge.gi .gidig b{font-size:26px}
  .cgauge.gi .gidig p{font-size:8px;letter-spacing:.1em;margin-top:3px}
  .cgauge.gi .gitop{font-size:8px}
  .cgauge.gi .ginote{font-size:10px;padding-top:7px;margin-top:7px}
  .cgauge.gi .cgnote{font-size:9px;margin-top:5px}
  /* THE BANKS DO NOT PRINT. They are an instrument for a screen on a wall; on paper the very same four counts
     are already in the Build table, column by column, with the references named under it. Printing them as
     well would be the same fact twice on a report Andrew Fisher asked to keep short, and a second place for it
     to go stale. */
  .sigs{display:none}
}
.cgcap{margin:0 0 2px;font-size:9.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;
  color:var(--gauge-mute);text-align:center}
.cgwrap{position:relative;width:100%;max-width:250px;margin:0 auto}
.cgauge svg{display:block;width:100%;height:auto;overflow:visible}
.cgauge .cgtick{stroke:var(--gauge-track);stroke-width:2;stroke-linecap:round}
/* the figures sit in the well of the arc, in HTML, at a size that does not move with the column */
.cgn{position:absolute;left:6%;right:6%;bottom:2px;text-align:center;pointer-events:none;
  font-size:40px;font-weight:800;line-height:1;letter-spacing:-.035em;color:var(--gauge-ink);
  font-variant-numeric:tabular-nums}
.cgn .cgp{font-size:19px;font-weight:700;font-style:normal;color:var(--orange)}
.cgsub{margin:7px 0 0;text-align:center;font-size:11.5px;font-weight:600;color:var(--gauge-mute);
  font-variant-numeric:tabular-nums;line-height:1.3}
.cgfoot{display:flex;justify-content:space-between;gap:8px;font-size:9.5px;color:var(--gauge-mute);margin-top:6px;
  max-width:250px;margin-left:auto;margin-right:auto;width:100%}
.cgnote{display:flex;align-items:center;gap:7px;margin-top:11px;padding-top:9px;border-top:1px solid var(--gauge-track);
  font-size:10.5px;color:var(--gauge-mute);line-height:1.35}
.cgdot{flex:0 0 auto;width:9px;height:9px;border-radius:50%}
.cside{min-width:0;display:flex;flex-direction:column;gap:9px}
/* Every tile is coloured from the page's own key — the one the semantic legend explains — so the colour is a
   meaning and not a decoration: what is observed is good, what is only planned is plan, a gap that stops work
   is stop. Nothing here invents a fourth palette. */
.ctile{min-width:0;border:1px solid var(--rule);border-radius:12px;padding:11px 13px;background:var(--tint)}
.ctile.good{background:var(--sem-good-bg);border-color:var(--sem-good-edge)}
.ctile.plan{background:var(--sem-plan-bg);border-color:var(--sem-plan-edge)}
.ctile.stop{background:var(--sem-stop-bg);border-color:var(--sem-stop-edge)}
.ctile.none{background:var(--sem-none-bg);border-color:var(--sem-none-edge)}
.ctile.lead{display:flex;align-items:center;justify-content:space-between;gap:12px}
.ctile.lead .ctl{display:flex;align-items:flex-start;gap:9px;min-width:0}
.ctile.lead .ctmark{flex:0 0 auto;font-weight:800;font-size:15px;line-height:1.25}
.ctile.lead b{display:block;font-size:13.5px;font-weight:800;letter-spacing:.01em;text-transform:uppercase;line-height:1.25}
.ctile.lead span{display:block;font-size:11.5px;opacity:.85;line-height:1.35;margin-top:2px;text-transform:none;font-weight:500}
.ctile.lead .ctbig{flex:0 0 auto;font-size:32px;font-weight:800;line-height:1;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.ctile.lead.stop{color:var(--sem-stop-ink)}
.ctile.lead.good{color:var(--sem-good-ink)}
.ctile.lead.none{color:var(--sem-none-ink)}
.ctwo{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:9px}
.ctwo .ctile.good{color:var(--sem-good-ink)}
.ctwo .ctile.plan{color:var(--sem-plan-ink)}
.ctk{margin:0;font-size:9.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;opacity:.85}
.ctwo b{display:block;font-size:30px;font-weight:800;line-height:1.05;letter-spacing:-.03em;
  font-variant-numeric:tabular-nums;margin-top:3px;color:var(--ink)}
.ctwo > .ctile > span{display:block;font-size:11px;line-height:1.3;margin:2px 0 7px;opacity:.9}
.ctwo > .ctile{display:flex;flex-direction:column;align-items:flex-start}
.ctwo .sem{font-size:10.5px;padding:2px 8px;align-self:flex-start}
.ctile.whole{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  background:var(--tint);border-color:var(--rule)}
.ctile.whole b{font-size:22px;font-weight:800;letter-spacing:-.025em;font-variant-numeric:tabular-nums;color:var(--ink)}
.ctile.whole > div:first-child span{font-size:11.5px;color:var(--mute);margin-left:7px}
.cwpc{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--ink2);font-variant-numeric:tabular-nums}
.cwpc span{display:flex;align-items:center;gap:5px}
.cwpc i{flex:0 0 auto;width:9px;height:9px;border-radius:50%;background:var(--orange)}
.cwpc i.pl{background:var(--sem-plan-ink)}
/* the working. A <details>, so it needs no handler on either of the two pages that draw this block */
.cwork{margin-top:12px;border-top:1px solid var(--rule);padding-top:10px}
.cwork > summary{cursor:pointer;font-size:12px;font-weight:700;color:var(--orange-ink);list-style:none;
  display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border:1px solid var(--rule);border-radius:20px;
  background:var(--paper)}
@media (prefers-color-scheme:dark){.cwork > summary{color:var(--orange)}}
.cwork > summary::-webkit-details-marker{display:none}
.cwork > summary::before{content:'▸';font-size:11px}
.cwork[open] > summary::before{content:'▾'}
.cwork > summary:hover{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide)}
.cwork > summary:focus-visible{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px var(--glow)}
.cworktbl{width:100%;border-collapse:collapse;margin-top:10px;font-size:12px}
.cworktbl td{padding:6px 9px;border-bottom:1px solid var(--rule2);vertical-align:top;color:var(--ink2)}
.cworktbl td:first-child{color:var(--ink);font-weight:600}
.cworktbl td.n{text-align:right;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;white-space:nowrap}
.cworktbl td:last-child{color:var(--mute);font-size:11px}
.cworknote{margin:9px 0 0;font-size:11px;color:var(--mute);line-height:1.45}
@media (max-width:620px){
  .cgrid{grid-template-columns:minmax(0,1fr);gap:12px}
  .ctitle{font-size:22px}
  .ctile.lead .ctbig{font-size:26px}
  .ctwo b{font-size:24px}
}
@media (max-width:380px){ .ctwo{grid-template-columns:minmax(0,1fr)} }
/* the dial at the top of Where we are, and on the paper it prints to */
.dsn .chero{margin:16px 0 0;padding:16px 18px;border:1px solid var(--rule);border-top:3px solid var(--c-or);
  border-radius:8px;background:var(--card, #fff);overflow:hidden;max-width:100%}
@media print{ .dsn .chero{break-inside:avoid;page-break-inside:avoid;padding:4mm 5mm;margin-top:4mm}
  /* On paper the dark plate would lay down a block of toner for no gain, so the gauge prints on white with its
     own ink. Everything it says in colour it also says in words, so nothing is lost. */
  .dsn .chero .cgauge{--gauge-bg:#fff;--gauge-ink:#14181d;--gauge-mute:#646d77;--gauge-track:#e4e0dc;
    background:#fff;border-color:#e4e0dc;padding:2mm 3mm}
  .dsn .chero .cgn{font-size:34px} .dsn .chero .ctwo b{font-size:17px}
  .dsn .chero .ctile.lead .ctbig{font-size:22px} .dsn .chero .ctitle{font-size:19px}
  .dsn .chero .cwork > summary{display:none} .dsn .chero .cwork{border-top:none;padding-top:0}
  .dsn .chero .cwork[open] .cworktbl{font-size:9pt} }
.dsn .gp{position:relative;height:10px;border-radius:99px;background:var(--tint2);border:1px solid var(--rule);overflow:hidden;margin-top:10px}
.dsn .gp i{position:absolute;inset:0 auto 0 0;border-radius:99px;background:var(--c-or);min-width:0}
.dsn .gp.full i{background:var(--tl-green)}
.dsn .gl{display:flex;justify-content:space-between;font-size:11.5px;color:var(--mute);margin-top:5px;font-variant-numeric:tabular-nums}
.dsn .gl b{color:var(--ink)}

/* the group plates */
.dsn h3.sec{margin:22px 0 10px;font-size:15px;font-weight:800;letter-spacing:.02em;color:var(--ink);display:flex;align-items:baseline;gap:4px 10px;flex-wrap:wrap;white-space:nowrap}
.dsn h3.sec span{white-space:normal}
.dsn h3.sec span{font-weight:600;color:var(--mute);font-size:12.5px}
/* each plate is its own height — a box stretched to its neighbour's height reads as half empty, and the
   figures inside it float away from the words that explain them (Andrew Fisher: the boxing has to be perfect) */
.dsn .groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px;align-items:start}
.dsn .grp{background:var(--paper);border:1px solid var(--rule);border-radius:12px;padding:14px 16px 14px;box-shadow:var(--lift);cursor:pointer}
.dsn .grp:hover{border-color:var(--orange)}
.dsn .grp .k{font-size:12.5px;font-weight:800;color:var(--ink);display:flex;justify-content:space-between;gap:8px;align-items:baseline}
.dsn .grp .k span{font-weight:600;color:var(--mute);font-size:11.5px;white-space:nowrap}
.dsn .grp .n{font-size:30px;font-weight:800;line-height:1.05;margin:8px 0 0;letter-spacing:-.02em;color:var(--ink);font-variant-numeric:tabular-nums}
.dsn .grp .n small{font-size:13px;font-weight:600;color:var(--mute);letter-spacing:0}
.dsn .grp .rows{margin:10px 0 0;display:grid;grid-template-columns:1fr auto;gap:3px 10px;font-size:12px;color:var(--ink2)}
.dsn .grp .rows b{font-variant-numeric:tabular-nums;color:var(--ink);text-align:right}
.dsn .grp .rows .bad{color:var(--red)}
.dsn .grp .rows .bad b{color:var(--red)}
.dsn .grp .money{margin-top:10px;padding-top:8px;border-top:1px dashed var(--rule);font-size:12px;color:var(--ink2);display:flex;justify-content:space-between;gap:8px;font-variant-numeric:tabular-nums}
.dsn .grp .money b{color:var(--ink)}
.dsn .grp .note{margin:8px 0 0;font-size:11px;color:var(--mute);line-height:1.4}
.dsn .grp .rows small{font-weight:600;color:var(--mute);font-size:10.5px}
.dsn .grp .rows b.none{color:var(--mute);font-weight:600}
/* the by-type table on a plate: the schedule's own item names, on site over asked, one unit per plate */
.dsn .bt{width:100%;min-width:0;border-collapse:collapse;margin:10px 0 0;font-size:11.5px;font-variant-numeric:tabular-nums;table-layout:auto}
.dsn .bt th{position:static;background:transparent;border-right:0;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);font-weight:700;text-align:right;padding:0 0 4px 8px;border-bottom:1px solid var(--rule);white-space:nowrap}
.dsn .bt th:first-child{text-align:left;padding-left:0}
.dsn .bt td{padding:3px 0 3px 8px;border-right:0;border-bottom:1px solid var(--rule2);color:var(--ink2);text-align:right;white-space:nowrap;vertical-align:baseline}
.dsn .bt td:first-child{text-align:left;color:var(--ink);font-weight:600;white-space:normal;padding-left:0}
.dsn .bt td:nth-child(2){font-weight:800;color:var(--ink)}
.dsn .bt td i{font-style:normal;font-weight:600;color:var(--mute);font-size:10.5px}
.dsn .bt tbody tr, .dsn .bt tbody tr:hover{background:transparent}
.dsn .bt tr.behind td:nth-child(2){color:var(--red)}
.dsn .bt tr:last-child td{border-bottom:0}
.dsn .grp.fence{grid-column:span 2}
@media (max-width:620px){ .dsn .grp.fence{grid-column:auto} }
/* the plate's accent and its state. Andrew Fisher, 12 Sep 2026: each category shows its progress in colour and border.
   The accent is on the top edge and the name; the headline number reads its state — quiet before anything is on
   site, the accent while it is coming in, green once everything asked for is there. */
.dsn .grp{--acc:var(--c-or);border-top:3px solid var(--acc);padding-top:12px}
.dsn .grp .k{color:var(--c-or-ink);flex-wrap:wrap}
.dsn .grp.none .n{color:var(--ink2)}
.dsn .grp.part .n{color:var(--c-or-ink)}
.dsn .grp.full .n{color:var(--tl-green)}
.dsn .grp.full .gp i{background:var(--tl-green)}
.dsn .grp .n.word{font-size:15px;line-height:1.35;color:var(--ink2);font-weight:600;margin-top:10px}
.dsn .grp .src{margin:6px 0 0;font-size:11.5px;color:var(--mute);line-height:1.4}
.dsn .grp .nsub{margin-top:2px;font-size:12.5px;font-weight:600;color:var(--mute)}
.dsn .grp .nsub b.unrated{color:var(--red);font-weight:700}
.dsn .grp.branch .k{flex-direction:column;align-items:flex-start;gap:3px}
.dsn .grp.branch .k > span{white-space:normal}
.dsn .grp .k .code{font-family:Consolas,ui-monospace,monospace;letter-spacing:.02em;background:var(--c-or);color:#fff;border-radius:6px;padding:1px 7px;margin-right:6px;font-size:11.5px}
/* the branch plates */
.dsn .groups.branches .grp.all{grid-column:span 2}
@media (max-width:620px){ .dsn .groups.branches .grp.all{grid-column:auto} }
.dsn .grp .rows.kinds{grid-template-columns:1fr auto}
.dsn .grp .rows .hd{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);font-weight:700;border-bottom:1px solid var(--rule);padding-bottom:3px;margin-bottom:2px}
.dsn .grp .rows b .none, .dsn .grp .rows b.none{color:var(--mute);font-weight:600}
.dsn .gl-groups{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:8px;font-size:11.5px;color:var(--ink2)}
/* 21 Sep 2026, from the live review: at 1363 px this row was twenty pixels wider than the page and put a
   scrollbar under the whole of Where we are. The cause was nowrap on a label that can read "Toilets &
   amenities · 18 of 18 toilet units on site" — long enough on its own to beat the column. It wraps now, and
   is capped at the width of what holds it so no single long word can push past it either. The dot stays with
   the first line rather than centring itself against two. Nothing is clipped and no overflow is hidden. */
/* a traffic report past its own stated end time: still listed, still readable, no longer shouting */
.roads li.spent{opacity:.62}
.roads li.spent b{font-weight:600}
/* v5.66 — a stale snapshot's list, folded. The summary is the whole control: it says how old the list is and
   how many of its reports have outlived their own window, so the reader decides whether to open it. */
.roadsold{margin:0 0 10px}
.roadsold>summary{cursor:pointer;font-size:12.5px;color:var(--mute);padding:7px 10px;border:1px solid var(--rule);border-radius:8px;background:var(--tint2);list-style:none}
.roadsold>summary::-webkit-details-marker{display:none}
.roadsold>summary::before{content:'\25B8';display:inline-block;margin-right:7px;transition:transform .15s}
.roadsold[open]>summary::before{transform:rotate(90deg)}
.roadsold>summary:hover,.roadsold>summary:focus-visible{border-color:var(--acc,#ff6a13);color:var(--ink)}
.roadsold[open]>summary{margin-bottom:8px}
/* v5.66 — the pre-starts page: two crews, a day at a time, newest first. A row is a day, what it is, and the
   way in to it; the day is the thing a person scans for, so it leads and it is the widest fixed column. */
.prelist{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:6px}
.prerow{display:grid;grid-template-columns:minmax(120px,170px) 1fr auto;gap:10px;align-items:baseline;
  padding:8px 10px;border:1px solid var(--rule);border-radius:9px;background:var(--tint2)}
.preday{font-weight:700;font-size:13px}
.pretitle{font-size:13px;line-height:1.35}
.pretitle .w{display:block;color:var(--mute);font-size:11.5px}
.preopen{white-space:nowrap}
.preswms{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;
  margin:8px 0 2px;padding:9px 11px;border:1px solid var(--rule);border-left:3px solid var(--navy);
  border-radius:10px;background:var(--navy-soft)}
.preswms b{display:block;font-size:13px}
.preswms span{display:block;color:var(--mute);font-size:11.5px;line-height:1.35}
.premaster{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;
  margin:8px 0 2px;padding:9px 11px;border:1px solid var(--orange);border-left:3px solid var(--orange);
  border-radius:10px;background:var(--orange-soft)}
.premaster b{display:block;font-size:13px;color:var(--orange-ink)}
.premaster span{display:block;color:var(--mute);font-size:11.5px;line-height:1.35}
.preadd{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin:8px 0 2px;
  padding:10px;border:1px dashed var(--rule);border-radius:10px}
.preadd .f{display:flex;flex-direction:column;gap:3px;font-size:12px}
.preadd .f span{color:var(--mute);font-size:11.5px}
.preadd .norate{flex:1 1 100%;margin:2px 0 0}
@media(max-width:640px){.prerow{grid-template-columns:1fr;gap:3px}.preopen{margin-top:4px}}
.cwc,.cwmcard{--acc:var(--orange)}
.cwc h3,.cwmcard h3{margin:0 0 2px}
.cwc>.sub{margin:0 0 10px;color:var(--mute);font-size:12.5px;line-height:1.45}
.cwk{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.cwkpi{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;
  padding:11px 12px;border:1px solid var(--rule);border-left:3px solid var(--acc);border-radius:10px;background:var(--tint2)}
.cwkpi.good{--acc:var(--green)}
.cwkpi.watch{--acc:var(--amber)}
.cwkn{grid-row:span 2;font:800 25px/1 "Segoe UI",system-ui,sans-serif;color:var(--acc);
  display:flex;align-items:baseline;gap:1px;min-width:52px}
.cwkn small{font:700 12px/1 inherit}
.cwkw b{display:block;font-size:13.5px;line-height:1.3}
.cwkw span{display:block;color:var(--mute);font-size:11.5px;margin-top:1px}
.cwkh{grid-column:2;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;
  margin-top:7px;padding-top:7px;border-top:1px dashed var(--rule)}
.cwkv{font:800 17px/1 "Segoe UI",system-ui,sans-serif;color:var(--ink)}
.cwks{flex:1 1 190px;color:var(--mute);font-size:11.5px;line-height:1.4}
.cwp{display:grid;gap:9px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.cwpill{padding:11px 12px;border:1px solid var(--rule);border-top:3px solid var(--acc);border-radius:10px;
  background:var(--tint2);cursor:pointer;transition:border-color .14s,box-shadow .14s,transform .14s}
.cwpill:hover,.cwpill:focus-visible{border-color:var(--acc);box-shadow:var(--shadow);transform:translateY(-1px);outline:none}
.cwph{display:flex;align-items:center;gap:8px}
.cwph b{font-size:14px}
.cwpk{display:grid;place-items:center;width:23px;height:23px;flex:none;border-radius:6px;
  background:var(--acc);color:#fff;font:800 12.5px/1 "Segoe UI",system-ui,sans-serif}
.cwpl{margin:5px 0 8px;color:var(--mute);font-size:11.5px;line-height:1.4}
.cwpt{width:100%;min-width:0;table-layout:fixed;border-collapse:collapse;font-size:12px}
.cwpt td{padding:4px 0;border-top:1px solid var(--rule2);vertical-align:top;overflow-wrap:anywhere}
.cwpt tr:first-child td{border-top:0}
.cwpt td:first-child{color:var(--mute);padding-right:9px;width:42%}
.cwred{width:100%;min-width:0;border-collapse:collapse;font-size:12.5px;margin:2px 0 6px}
.cwred th{text-align:left;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);
  padding:0 9px 5px 0;border-bottom:1px solid var(--rule);font-weight:700}
.cwred td{padding:7px 9px 7px 0;border-bottom:1px solid var(--rule2);vertical-align:top;line-height:1.35;overflow-wrap:anywhere}
.cwred tbody tr:hover{background:var(--tint)}
.cwgap{color:var(--amber);font-size:11px}
.cwt{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(265px,1fr))}
.cwtrait{display:flex;gap:9px;align-items:flex-start;padding:9px 11px;
  border:1px solid var(--rule);border-radius:10px;background:var(--tint2)}
.cwtn{flex:none;font:800 12px/1 Consolas,ui-monospace,monospace;color:var(--orange-ink);padding-top:2px;letter-spacing:.02em}
.cwdn{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;
  background:var(--orange-soft);color:var(--orange-ink);padding:0}
.cwtrait b{display:block;font-size:13px;line-height:1.3}
.cwtrait span{display:block;color:var(--mute);font-size:11.5px;line-height:1.4;margin-top:2px}
.cwvh{margin:14px 0 7px;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--mute)}
.cwv{display:grid;gap:7px;grid-template-columns:repeat(auto-fit,minmax(185px,1fr))}
.cwval{padding:8px 10px;border:1px solid var(--rule);border-radius:9px;background:var(--orange-soft)}
.cwval b{display:block;font-size:12.5px;color:var(--orange-ink)}
.cwval span{display:block;color:var(--ink2);font-size:11.5px;line-height:1.35;margin-top:1px}
@media(max-width:560px){
  .cwkpi{grid-template-columns:auto 1fr}
  .cwkn{font-size:21px;min-width:44px}
  .cwred,.cwred thead,.cwred tbody,.cwred tr,.cwred td{display:block;width:100%}
  .cwred thead{display:none}
  .cwred tr{border:1px solid var(--rule);border-radius:9px;padding:8px 10px;margin:0 0 7px;background:var(--tint2)}
  .cwred td{border:0;padding:2px 0}
  .cwred td:not(:first-child)::before{content:attr(data-l) ' \2014 ';color:var(--mute);font-size:11px}
}
.dsn .gl-groups span{display:inline-flex;align-items:flex-start;gap:5px;min-width:0;max-width:100%;
  white-space:normal;overflow-wrap:anywhere}
.dsn .gl-groups span i{width:8px;height:8px;border-radius:50%;background:var(--c-or);display:inline-block;flex:none;margin-top:.35em}
.dsn .gl-groups span b{color:var(--ink);font-variant-numeric:tabular-nums}
.dsn .grp .note.offer{color:var(--orange-ink);font-weight:600}
.dsn .bars .lb .code{font-family:Consolas,ui-monospace,monospace;font-size:11px;color:var(--ink)}
/* an asset number is always called one */
.ano{display:inline-flex;align-items:baseline;gap:4px;font-family:Consolas,ui-monospace,monospace;font-weight:700;color:var(--orange-ink);white-space:nowrap}
.ano small{font:600 10px/1 "Segoe UI",system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.ano.misc{font-style:italic;font-weight:600;color:var(--mute)}
.ano.none{font-style:italic;font-weight:600;color:var(--mute);font-family:'Inter', var(--sans, system-ui, sans-serif);font-size:11px}
/* the reference cell on a table: the plate, then the numbers of the machines under it */
.refcell{vertical-align:top}
.refcell .anos{margin-top:5px;font-size:12px;line-height:1.4;white-space:normal}
.refcell .anos small{font:600 9.5px/1 "Segoe UI",system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.refcell .anos .ano{white-space:normal}
/* the plate is small type; the button around it is not — 28 px tall for a finger, 24 being the floor */
.plateb{padding:4px 0;margin:0;min-height:28px;min-width:28px;border-radius:0;display:inline-flex;align-items:center;justify-content:center}
@media (pointer:coarse){ .plateb{min-height:32px;min-width:32px} }
.plateb:hover .rplate{box-shadow:0 0 0 3px var(--glow-wide), 0 2px 6px -2px rgba(255,106,19,.5)}
.plateb:focus-visible{outline:3px solid #0b63c5;outline-offset:2px}
.chip.ref.hire{box-shadow:inset 0 0 0 1px var(--c-or, #ff6a13)}
/* the glow. Andrew Fisher, 12 Sep 2026: a glow on hover. Every boxed thing on the page
   answers the pointer the same way — the orange edge and a soft halo — so a person knows what will open before
   they press. Only where there is a pointer to hover; a phone has none and gets the press glow instead. */
@media (hover:hover){
  .dsn .fig,.dsn .grp,.dsn .mcard,.dsn .oday,.dsn .out,.dsn .head,.card,.kpi,.doccard,.hb,.btn,.tickbtn,.tab,.chip[role=button],.mk{transition:box-shadow .18s ease,border-color .18s ease,transform .18s ease}
  .dsn .fig:hover,.dsn .grp:hover,.dsn .mcard:hover,.dsn .oday:hover,.dsn .out:hover,.dsn .head:hover,.card:hover,.kpi:hover,.doccard:hover{border-color:var(--orange);box-shadow:0 0 0 2px var(--glow),0 0 18px 4px var(--glow-wide)}
  .dsn .grp:hover,.kpi[role=button]:hover,.doccard:hover{transform:translateY(-1px)}
  .dsn .hb:hover,.btn:hover{border-color:var(--orange);box-shadow:0 0 0 2px var(--glow),0 0 12px 2px var(--glow-wide)}
}
@media (prefers-reduced-motion:reduce){ .dsn .grp:hover,.kpi[role=button]:hover,.doccard:hover{transform:none} }

/* money */
.dsn .money-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:14px}
.dsn .mcard{background:var(--paper);border:1px solid var(--rule);border-radius:12px;padding:14px 16px;box-shadow:var(--lift)}
.dsn .mcard h4{margin:0 0 8px;font-size:13px;font-weight:800;color:var(--ink)}
.dsn .bars{display:grid;grid-template-columns:auto 1fr auto;gap:6px 10px;align-items:center;font-size:12px}
.dsn .bars .lb{color:var(--ink2);white-space:nowrap}
.dsn .bars .bar{height:10px;border-radius:99px;background:var(--tint2);border:1px solid var(--rule);overflow:hidden}
.dsn .bars .bar i{display:block;height:100%;background:var(--c-or);border-radius:99px}
.dsn .bars .bar.open{border-style:dashed} .dsn .bars .bar.open i{background:var(--glow-wide)}
.dsn .bars .v{font-variant-numeric:tabular-nums;font-weight:700;color:var(--ink);text-align:right;white-space:nowrap}
.dsn .mtot{display:grid;grid-template-columns:1fr auto;gap:6px 10px;font-size:12.5px;color:var(--ink2);margin-top:4px}
.dsn .mtot b{font-variant-numeric:tabular-nums;color:var(--ink);text-align:right}
.dsn .mtot .big{font-size:22px;font-weight:800;color:var(--ink)}
.dsn .mtot .big b{font-size:22px}
.dsn .mnote{margin:8px 0 0;font-size:11px;color:var(--mute);line-height:1.45}

/* what has gone out */
.dsn .out{margin-top:16px;background:var(--paper);border:1px solid var(--rule);border-radius:12px;
  box-shadow:var(--lift);padding:16px 18px}
.dsn .out .oh{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;margin-bottom:12px}
.dsn .out .oh h3{margin:0;font-size:16px;font-weight:750}
.dsn .out .oh .chip{white-space:normal;line-height:1.3;text-align:left}
.dsn .ogrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;align-items:start}
.dsn .oday{border:1px solid var(--rule);border-radius:10px;overflow:hidden}
/* v5.81 — a day is a drop-down: its header is the whole box until it is opened (Andrew Fisher, 25 Sep 2026) */
.dsn details.oday > summary{list-style:none;cursor:pointer;display:block}
.dsn details.oday > summary::-webkit-details-marker{display:none}
.dsn details.oday > summary h4{position:relative;padding-right:30px}
.dsn details.oday:not([open]) > summary h4{border-bottom:0}
.dsn details.oday > summary h4::after{content:'';position:absolute;right:13px;top:50%;width:7px;height:7px;margin-top:-6px;border-right:2px solid var(--mute);border-bottom:2px solid var(--mute);transform:rotate(45deg);transition:transform .15s}
.dsn details.oday[open] > summary h4::after{transform:rotate(225deg);margin-top:-2px}
.dsn details.oday > summary:hover h4{color:var(--orange-ink)}
.dsn .fig .falert{margin:8px 0 0;font-size:12px;color:var(--red);line-height:1.4}
.dsn .mcard .mline{margin:8px 0 0;font-size:12px;color:var(--mute);line-height:1.4}
.dsn .mcard .mtot b.neg{color:var(--red)}
.dsn .mcard.ledgerc{cursor:pointer}
#pane-costs h4.subhd{margin:14px 0 6px;font-size:13px;font-weight:800;display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}
#pane-costs h4.subhd span{font-weight:400;color:var(--mute);font-size:12px}
#pane-costs table.people select{font:inherit;font-size:12.5px;padding:4px 6px;border:1px solid var(--rule);border-radius:6px;max-width:260px}
#pane-costs table.people input.rate{width:96px}
#pane-costs details.sfold.more > summary{font-size:12px}
/* on a phone the Costs tab's tiles sit two to a row, so the ledger and the tracker read in a screen, not six */
@media (max-width:640px){ #pane-costs .kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px} #pane-costs .kpi{padding:12px 12px} #pane-costs .kpi .v{font-size:24px} #pane-costs .kpi .q{font-size:11px} }
.dsn .mcard.ledgerc .mtot span.big{font-size:15px;align-self:center}
/* the basis a total is on, said under its label in small type — never at the size of the figure */
.dsn .mtot span small{display:block;font-size:11px;font-weight:600;letter-spacing:0;color:var(--mute);line-height:1.3;margin-top:1px}
details.sfold.pdetail{margin-top:22px;border-top:2px solid var(--rule)}
details.sfold.pdetail > summary{font-size:15px;letter-spacing:.02em;text-transform:none;color:var(--ink);font-weight:800;padding:10px 0 6px}
.dsn .oday h4{margin:0;padding:8px 12px;background:var(--tint);border-bottom:1px solid var(--rule);
  font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}
.dsn .oday h4 span{float:right;letter-spacing:0;text-transform:none;color:var(--mute);font-weight:600}
.dsn .oday ul{list-style:none;margin:0;padding:0}
.dsn .oday li{padding:8px 12px;border-top:1px solid var(--rule2);font-size:12.5px;line-height:1.45}
.dsn .oday li:first-child{border-top:0}
.dsn .oday li .no{font-weight:700;color:var(--orange-ink);font-family:Consolas,ui-monospace,monospace}
.dsn .oday li .no.misc{color:var(--mute);font-style:italic;font-weight:600}
.dsn .oday li .lnk{background:none;border:0;padding:6px 4px;margin:-6px 0 -6px -4px;min-height:32px;font:inherit;font-weight:700;color:var(--orange-ink);cursor:pointer;text-decoration:underline dotted}
.dsn .oday li .w{display:block;color:var(--mute);font-size:11.5px}
.dsn .onote{margin:12px 0 0;font-size:11.5px;color:var(--mute);line-height:1.55}
.dsn .onote b{color:var(--ink)}

.dsn .dsnsrc{margin-top:14px;font-size:11.5px;color:var(--mute);line-height:1.55}
.dsn .dsnsrc b{color:var(--ink)}
.dsn .pstamp{display:none}

@media (max-width:820px){ .dsn .money-grid{grid-template-columns:1fr} }
@media (max-width:560px){
  .dsn .head{padding:14px 14px 12px}
  .dsn .head h2{font-size:22px}
  .dsn .fig .n{font-size:28px} .dsn .grp .n{font-size:26px}
  /* narrow: the numeric columns give the type its room — headings may wrap, cells sit closer */
  .dsn .bt th{white-space:normal;line-height:1.15;padding-left:6px} .dsn .bt td{padding-left:6px}
}
@media print{
  .dsn .head,.dsn .fig,.dsn .grp,.dsn .mcard{break-inside:avoid}
  .dsn .hacts{display:none}
  /* Where we are on paper — A4 portrait, the plates as a report. Andrew Fisher, 12 Sep 2026: it prints as a
     well-presented page of details. Colour is kept (the gauge is the point); boxes lose their shadow and
     keep a fine rule; the plates fall three to a row, the figures four. */
  .dsn{-webkit-print-color-adjust:exact;print-color-adjust:exact;margin:0}
  .dsn .head{padding:0 0 4mm;border:0;border-bottom:2px solid var(--c-or);border-radius:0;box-shadow:none}
  .dsn .head h2{font-size:22px} .dsn .head h2 i{height:22px}
  .dsn .asat{font-size:11px;margin-top:2px}
  .dsn .strip{margin-top:6px;padding-top:6px;gap:4px 12px} .dsn .strip .m{font-size:9.5px}
  .dsn .pstamp{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:5px;font-size:8.5px;color:var(--mute)}
  .dsn .pstamp b{color:var(--ink)}
  .dsn .figs{grid-template-columns:repeat(4,1fr);gap:3mm;margin-top:3mm}
  .dsn .fig{padding:2.5mm 3mm;border-radius:3mm;box-shadow:none;border:1px solid #bdb6ad;border-top:2.5px solid var(--c-or)}
  .dsn .fig .k{font-size:8.5px} .dsn .fig .n{font-size:22px} .dsn .fig .n small{font-size:10px} .dsn .fig .src{font-size:8px;line-height:1.32;margin-top:4px}
  .dsn .gp{height:6px;margin-top:5px} .dsn .gl{font-size:8.5px;margin-top:3px}
  .dsn h3.sec{margin:4mm 0 2mm;font-size:12px} .dsn h3.sec span{font-size:9px}
  .dsn .groups{grid-template-columns:repeat(4,1fr);gap:3mm;align-items:start}
  .dsn .groups.branches .grp.all{grid-column:span 2}
  .dsn .gl-groups{font-size:8px;gap:2px 7px;margin-top:4px} .dsn .grp .rows .hd{font-size:7px}
  /* Page one is the header, the four figures and the first two rows of plates, set large enough to read across a
     table; the last row, the costs and what has gone out make page two; the trade tables page three. */
  .dsn .grp{padding:2.2mm 2.8mm;border-radius:2.5mm;box-shadow:none;border:1px solid #bdb6ad;cursor:default}
  .dsn .grp.fence{grid-column:span 2}
  .dsn .grp .k{font-size:10px} .dsn .grp .k span{font-size:8px}
  .dsn .grp .n{font-size:18px;margin-top:3px} .dsn .grp .n small{font-size:9.5px}
  .dsn .grp .gp{margin-top:4px} .dsn .grp .gl{margin-top:2px;font-size:8.5px}
  .dsn .bt{font-size:8.5px;margin-top:4px} .dsn .bt th{font-size:7px;padding-bottom:1px} .dsn .bt td{padding:1px 0 1px 6px} .dsn .bt td i{font-size:7px}
  .dsn .grp .rows{font-size:8.5px;gap:1px 6px;margin-top:4px} .dsn .grp .rows small{font-size:7px}
  .dsn .grp .money{font-size:8.5px;margin-top:4px;padding-top:3px} .dsn .grp .note{font-size:7px;line-height:1.25;margin-top:3px}
  .dsn .money-grid{grid-template-columns:1.4fr 1fr;gap:3mm}
  .dsn .mcard{padding:2.5mm 3mm;border-radius:3mm;box-shadow:none;border:1px solid #bdb6ad;break-inside:avoid}
  .dsn .mcard h4{font-size:10px;margin-bottom:4px} .dsn .bars{font-size:8.5px;gap:3px 8px} .dsn .bars .bar{height:6px}
  .dsn .mtot{font-size:8.5px;gap:2px 8px} .dsn .mtot .big,.dsn .mtot .big b{font-size:14px} .dsn .mtot span small{font-size:7px} .dsn .mnote{font-size:7.5px;line-height:1.3;margin-top:4px}
  .dsn .out{margin-top:4mm;padding:2.5mm 3mm;border-radius:3mm;box-shadow:none;border:1px solid #bdb6ad}
  .dsn .out .oh h3{font-size:11px} .dsn .out .oh{margin-bottom:2mm} .dsn .out .chip{font-size:7.5px}
  .dsn .ogrid{grid-template-columns:repeat(2,1fr);gap:3mm;align-items:start}
  .dsn .oday{break-inside:auto} .dsn .oday li{break-inside:avoid}
  .dsn .oday h4{font-size:8.5px;padding:1.5mm 2.5mm} .dsn .oday li{font-size:8.5px;padding:1.2mm 2.5mm;line-height:1.35} .dsn .oday li .w{font-size:7.5px}
  .dsn .oday li .lnk{min-height:0;padding:0;margin:0;text-decoration:none}
  .ano small{font-size:7px}
  .dsn .onote,.dsn .dsnsrc{font-size:7.5px;line-height:1.35;margin-top:2mm}
}

/* ------------------------------------------------------------------ the click glow
   Andrew Fisher, 11 Sep 2026: a glow when you click on something. Hover and keyboard focus already glowed;
   what was missing was the moment of the press and the state that follows it — you tap a marker on a phone in
   the dark at half four in the morning and nothing tells you the tap landed.

   Two separate things, because they mean two different things:
     .lit  — a short confirmation that THIS press registered. It fades on its own in under half a second and
             carries no meaning beyond "the page heard you".
     .picked / [aria-pressed=true] / .sel — a state that STAYS lit while the thing is the chosen one.
   The design standard is right that a click should yield useful detail rather than a decorative pulse, so the
   glow never replaces the detail — it accompanies it. Orange is reserved for this on the whole page.
   Reduced motion loses the animation and keeps the state, which is the part that carries information. */
@keyframes gc-lit{0%{box-shadow:0 0 0 0 var(--glow), 0 0 0 0 var(--glow-wide)}
  40%{box-shadow:0 0 0 4px var(--glow), 0 0 20px 8px var(--glow-wide)}
  100%{box-shadow:0 0 0 0 rgba(0,0,0,0), 0 0 0 0 rgba(0,0,0,0)}}
.lit{animation:gc-lit .42s ease-out}
.mk.lit{animation:gc-lit .42s ease-out}
/* the chosen thing stays lit while it is chosen */
.picked, .btn.picked, button.picked{border-color:var(--orange)!important;
  box-shadow:0 0 0 3px var(--glow), 0 0 16px 4px var(--glow-wide)!important}
@media (prefers-reduced-motion: reduce){
  .lit, .mk.lit{animation:none}
  .picked, .btn.picked, button.picked{box-shadow:0 0 0 3px var(--glow)!important}
}
.ohgrp{margin:10px 0 2px}
.ohgrp h4{margin:0 0 6px;font-size:13.5px;font-weight:650;color:var(--ink2)}
.ohlist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.ohlist li{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:7px 10px;border:1px solid var(--rule);
  border-radius:9px;background:var(--tint2);font-size:13px}
.ohlist li .mono{font-weight:650}
/* The status on an on-hire line is a sentence, not a label — "schedule row T0002 · DELIVERY TO MOLENDINAR — no
   reference on it". A .chip never wraps, which is right for "ON SITE" and wrong for this: on a 390 px phone it
   clipped and the reader lost the half that said why. It keeps the chip's colour and border and gets its own
   line-breaking. */
.ohlist .chip{white-space:normal;line-height:1.35;padding:3px 7px;text-align:left}
.tickbtn:hover{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide);transform:translateY(-1px);color:var(--ink)}
.tickbtn.on{background:var(--tl-green);border-color:var(--tl-green);color:#fff;box-shadow:0 0 10px 1px rgba(23,154,71,.45)}
.tickbtn.sm{width:28px;height:28px;font-size:15px;border-radius:8px}
/* the positioned-and-levelled tick: the level mark, hollow until it is set, a deeper green once it is — a
   different shape AND a different shade from Complete, so the two never read as one */
.tickbtn.lvlbtn{color:var(--mute);display:inline-flex;align-items:center;justify-content:center}
.tickbtn.lvlbtn:hover{color:var(--ink);border-color:#0f6b3a;box-shadow:0 0 0 3px rgba(15,107,58,.18)}
.tickbtn.lvlbtn.on{background:#0f6b3a;border-color:#0f6b3a;color:#fff;box-shadow:0 0 10px 1px rgba(15,107,58,.4)}
.tick.lvl{background:#0f6b3a;display:inline-flex;align-items:center;gap:4px}
.tick.sm.lvl{padding:0 4px}
/* the levelled rail is set with the other two, in the rail block further down */
/* the map: a levelled pin's ring goes solid and deep — the same ring, one shade further, closed off */
.mk[data-levelled="1"],.mk[data-complete="1"][data-levelled="1"]{box-shadow:0 0 0 3px #0f6b3a,0 0 0 4.5px #fff}
.mk[data-levelled="1"].sel,.mk[data-complete="1"][data-levelled="1"].sel{box-shadow:0 0 0 3px #0f6b3a,0 0 0 6px var(--glow-wide)}
/* THE STEPS TICK. Andrew Fisher, 16 Sep 2026: the steps install is its own tick, separate from the others.
   It is its own check, not a stage of levelled — a building can have its steps on before the final level
   check or the other way about, and two crews can carry the two jobs. So it gets its own colour, deep steel blue,
   which is neither of the two greens (levelled #0f6b3a, complete #179a47) nor the stop red nor the brand orange —
   nobody reading a row at arm's length can mistake one tick for the other. */
.tickbtn.stpbtn{color:var(--mute);display:inline-flex;align-items:center;justify-content:center}
.tickbtn.stpbtn:hover{color:var(--ink);border-color:#1d5b9e;box-shadow:0 0 0 3px rgba(29,91,158,.18)}
.tickbtn.stpbtn.on{background:#1d5b9e;border-color:#1d5b9e;color:#fff;box-shadow:0 0 10px 1px rgba(29,91,158,.4)}
.tick.stp{background:#1d5b9e;display:inline-flex;align-items:center;gap:4px}
.tick.sm.stp{padding:0 4px}
/* THE ROW RAILS — complete, levelled and steps — all in one place, and all on the row's LEFT EDGE.
   Two faults were found here on 16 Sep 2026 while the third tick was going in, both of them years of quiet
   wrongness rather than anything anyone reported:
     · `tbody tr.levelled > td` painted its 3 px bar inside EVERY cell, so a levelled row grew a green bar at
       every column boundary instead of one rail at its edge;
     · the first column is sticky, with its own background and its own separator shadow, and `.tblwrap
       td:first-child` outranks a row rule — so the one bar that WAS meant to be seen, at the row's edge, was
       the only one painted over.
   So the rail is a variable on the row and the first cell wears it, composed with the sticky separator when the
   table scrolls. The rails stack outward-in: the outer one is the deeper check, the inner one steps. */
tbody tr.complete{--rail:inset 4px 0 0 var(--tl-green)}
tbody tr.stepped{--rail:inset 3px 0 0 #1d5b9e}
tbody tr.levelled{--rail:inset 3px 0 0 #0f6b3a}
tbody tr.complete.stepped{--rail:inset 4px 0 0 var(--tl-green), inset 7px 0 0 #1d5b9e}
tbody tr.levelled.stepped{--rail:inset 3px 0 0 #0f6b3a, inset 6px 0 0 #1d5b9e}
tbody tr.complete > td:first-child, tbody tr.levelled > td:first-child, tbody tr.stepped > td:first-child{box-shadow:var(--rail)}
.tblwrap tbody tr.complete > td:first-child, .tblwrap tbody tr.levelled > td:first-child,
.tblwrap tbody tr.stepped > td:first-child{box-shadow:1px 0 0 var(--rule2), var(--rail)}
/* the map: a stepped pin takes a short blue bar under its face — a mark, not another ring, so it never fights the
   levelled ring or the complete ring for the same edge. It is a child element, not ::after: the pin already
   spends ::after on its touch target and again on the moved-location query mark. */
.mk .stpx{position:absolute;left:50%;bottom:-4px;transform:translateX(-50%);
  width:12px;height:3px;border-radius:2px;background:#1d5b9e;box-shadow:0 0 0 1px #fff;pointer-events:none}
/* the cancel button: the ring-and-bar, hollow until it is set, the stop colour once it is */
.tickbtn.nobtn{color:var(--mute);display:inline-flex;align-items:center;justify-content:center}
.tickbtn.nobtn:hover{color:var(--tl-red);border-color:var(--tl-red);box-shadow:0 0 0 3px rgba(190,32,32,.18)}
.tickbtn.nobtn.on{background:#fff;border-color:var(--tl-red);color:var(--tl-red);box-shadow:none}
/* the next-day button: a chevron, the same size as the tick */
.tickbtn.daybtn{font-size:22px;line-height:1;color:var(--mute);padding-bottom:3px}
.tickbtn.daybtn:hover{color:var(--ink)}
/* A COMPLETE PIN WEARS A GREEN RING (Andrew Fisher, 15 Sep 2026: completed areas carry a green circle on the maps
   too). The tick on the shoulder stays; the ring is what reads from across the
   plate. A ring, not a fill, so the reference on the pin's face stays legible and the ring prints as a shape. */
.mk[data-complete="1"]{box-shadow:0 0 0 3px var(--tl-green),0 0 0 4.5px #fff}
.mk[data-complete="1"].sel{box-shadow:0 0 0 3px var(--tl-green),0 0 0 6px var(--glow-wide)}
.tickbtn:focus-visible{outline:3px solid #0b63c5;outline-offset:2px}
/* THE EDIT TABLE. Boxes in a table, not a form: no Save button, no second copy, and the schedule's own answer
   in grey under every box that has been typed over. The columns are sized so the whole table fits a laptop and
   scrolls sideways in its own container on a phone with the reference column pinned, like every other wide
   table in this file. */
.edbar{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:flex-end;margin:10px 0 12px}
.edbar .f{flex:1 1 170px;min-width:0}
.edbar .f:last-child{flex:0 0 auto}
.edbar label{display:block;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);font-weight:700;margin-bottom:3px}
.edbar input,.edbar select{width:100%;padding:7px 9px;border:1px solid var(--rule);border-radius:8px;background:var(--paper);color:var(--ink);font:inherit;font-size:13px}
.edtbl td{vertical-align:top}
.edtbl th .w{font-weight:600;color:var(--mute);text-transform:none;letter-spacing:0}
.edbox{width:100%;min-width:0;padding:6px 8px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);
  color:var(--ink);font:inherit;font-size:12.5px}
.edbox:focus-visible{outline:3px solid #0b63c5;outline-offset:1px}
.edbox:disabled{background:var(--tint2);color:var(--mute)}
.edbox.edday{min-width:118px}
.edbox.edrate{text-align:right;min-width:92px}
.edwas{font-size:11px;color:var(--mute);line-height:1.35;margin-top:3px}
.edby{font-size:11px;color:var(--ink);line-height:1.35;margin-top:1px;font-variant-numeric:tabular-nums}
/* labour per piece: the ticks on a reference (17 Sep 2026) */
.labticks{display:flex;flex-wrap:wrap;gap:6px 14px;margin:4px 0 2px}
.labtick{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;cursor:pointer;padding:6px 0;min-height:24px}
.labunit .labtick{display:flex;flex-wrap:wrap;width:100%;gap:4px 9px;padding:5px 0;align-items:baseline}
.labunit .labtick input{flex:none;margin-top:2px}
.labunit .labtick .w{margin-left:auto;text-align:right;white-space:nowrap}
.labunit .labtick .edby{flex-basis:100%;margin-left:27px;margin-top:0}
/* v5.55 — a line the card prices at nothing, and one it carries no figure for at all, read differently from a
   priced one: the tick is offered on all three, and only the words underneath change. */
.labtick.labnil .w{opacity:.72}
.labtick.labunk .w{opacity:.72;font-style:italic}
.labunits{display:grid;gap:8px;margin-top:4px}
.labunit .labtick{overflow-wrap:normal;word-break:keep-all}
.labunith span{font-weight:600;letter-spacing:0;text-transform:none;opacity:.75}
.labunit{border:1px solid var(--rule);border-radius:9px;padding:6px 10px;background:var(--tint2)}
.labunith{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);padding-bottom:2px}
@media (min-width:720px){.labunits{grid-template-columns:1fr 1fr}}
.labtick input{width:24px;height:24px;margin:0;accent-color:var(--orange)}
.labtick .edby{margin-left:4px;color:var(--mute)}
.edby::before{content:'\2713  ';color:var(--mute)}
.edoffbtn{font-size:11px;margin-top:3px;display:inline-block}
.edsel{max-width:140px}
.edqty{width:64px}
.edhire{margin-top:8px;border-top:1px dashed var(--rule);padding-top:6px;text-align:left}
.edlbl{display:block;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);font-weight:700;margin-bottom:3px}
.edmapref{margin-top:6px;max-width:100%}
.maprefline{font-size:12px;margin:6px 0}
body.viewonly [data-edmove], body.viewonly [data-moveback]{display:none!important} .edtbl td.edqtyc{max-width:150px;white-space:normal} .edtbl td.edqtyc .edwas{max-width:150px}
/* the row's own state, so the edit table reads as a status list too — one dot, four words and the ticks */
.edstate{display:flex;align-items:center;gap:5px;flex-wrap:wrap;font-size:11px;color:var(--ink);margin-top:4px;font-weight:650}
.edstate .w{font-weight:400;color:var(--mute)}
.edlt{width:9px;height:9px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 0 1px rgba(0,0,0,.25)}
.edlt.green{background:var(--tl-green)} .edlt.amber{background:var(--tl-amber)}
.edlt.red{background:var(--tl-red)} .edlt.none{background:transparent;box-shadow:inset 0 0 0 1.5px var(--mute)}
/* the explanation and the filters fold away on a phone and stay open on a laptop */
.edhow summary,.edfold summary{cursor:pointer;font-weight:700;font-size:12.5px;color:var(--ink)}
.edhow[open] summary,.edfold[open] summary{margin-bottom:6px}
.edhow{margin-top:4px} .edhow[open] summary{color:var(--mute);font-weight:600}
.edfold{margin:8px 0 0} .edfold summary{color:var(--mute);font-weight:650}
.edfold[open] summary{color:var(--ink)}
.edwas b{color:var(--ink);font-weight:650}
.edmapline{display:flex;flex-wrap:wrap;gap:2px 8px;align-items:baseline}
.edmap{font-size:11px;color:var(--mute)}
.edtbl tr.edoff td{opacity:.62}
.edtbl td:nth-child(2){min-width:140px} .edtbl td:nth-child(4){min-width:170px} .edtbl td:nth-child(7){min-width:170px} .edtbl td:nth-child(8){width:150px}
.edtbl td:nth-child(8) .edwas{white-space:normal;max-width:150px}
@media(max-width:640px){.edbar .f{flex:1 1 100%}}
.tickcard{margin-top:12px;padding-top:12px;border-top:1px dashed var(--rule)}
/* the three ticks at full size in the drawer body — complete, levelled, steps. A generator shows one, a building
   shows three, and they wrap rather than squeezing on a phone-width drawer. */
.tickcard .tickrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
/* The light column needs room for the instrument AND its words on ONE line, or every row in a 193-row register
   grows a second line and the printed register doubles in pages. 200px holds the 78px housing, the gap and
   "No delivery record" beside it; below that the words drop under, which is right on a phone. */
.lcell{display:flex;align-items:center;gap:8px;flex-wrap:nowrap;min-width:262px}
/* the instrument keeps its own width. As an ordinary flex item it shrinks below its content, which pushed the
   words under the housing and put a second line on all 193 rows. */
.lcell > .dstat{flex:0 0 auto;flex-wrap:nowrap}
.lcell > .tickbtn{flex:0 0 auto}
/* Order matters here, and it was the wrong way round. A phone is small AND coarse, so the coarse rule's
   292px floor was beating the phone rule that clears it — which is how a sticky 292px Light column ended
   up filling a 412px screen with nothing on it that said WHICH asset it was. Coarse first, phone last. */
@media(pointer:coarse){ .lcell{min-width:292px} }
@media(max-width:640px){ .lcell{min-width:0;flex-wrap:wrap} }
@media print{ .lcell{min-width:218px;gap:5px} }
.syncpill{font-size:11px;font-weight:700;letter-spacing:.04em;color:var(--hdr-mute);white-space:nowrap;align-self:center}
/* a view-only link: the record is all there to read; the controls that would change it are put away */
body.viewonly .tlset .lb, body.viewonly .tickbtn, body.viewonly [data-fdone], body.viewonly .mv input, body.viewonly input[data-eta],
body.viewonly #importBtn, body.viewonly #folderBtn, body.viewonly .who, body.viewonly #bdReport, body.viewonly #bdNew,
body.viewonly #fdSave, body.viewonly #bSave, body.viewonly #vSave, body.viewonly #adSave, body.viewonly #aSave,
body.viewonly [data-fqvar], body.viewonly [data-fdel], body.viewonly [data-bedit], body.viewonly [data-vedit], body.viewonly [data-fence],
body.viewonly [data-po-save], body.viewonly #poAdd, body.viewonly #poNew,
body.viewonly .edoffbtn, body.viewonly [data-putback]{display:none!important}
body.viewonly [data-po-inv], body.viewonly [data-po-amt], body.viewonly [data-po-period]{pointer-events:none;opacity:.6}
body.viewonly .daytbl td.t input, body.viewonly #pane-add input, body.viewonly #pane-add select{pointer-events:none;opacity:.6}
/* F07, Superior Audit 15 Sep 2026: a view-only link left 47 rate boxes, the docket date, the PO period and
   "Save quoted quantities" visibly enabled, under a footer that said the link could not change anything. The
   CSS above is an enumerated list of controls somebody remembered to add, which is why the pricing boxes were
   never on it. applyCapability() below is the rule that does not need remembering: in a view-only link EVERY
   field under main and in the drawer is disabled unless it is marked data-ro, so a field added tomorrow is
   read-only by default rather than by luck. */
body.viewonly main input:disabled, body.viewonly main select:disabled, body.viewonly main textarea:disabled,
body.viewonly #drawer input:disabled, body.viewonly #drawer select:disabled, body.viewonly #drawer textarea:disabled{
  opacity:.55;cursor:not-allowed;background:var(--tint2)}
.clotbl td{vertical-align:middle}
@media(max-width:640px){.clotbl{width:100%;table-layout:fixed}.clotbl th,.clotbl td{white-space:normal;word-break:break-word}}
.clotbl tr.on{background:var(--tint2)}
b.clowin{font-size:15px;letter-spacing:.2px}
.clolist{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
.clolist li{display:flex;align-items:flex-start;gap:10px}
.cloord{flex:0 0 auto;width:26px;height:26px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;
  font-weight:800;font-size:13px;background:var(--tint2);border:1.5px solid var(--line)}
.clowhere{display:flex;flex-direction:column;gap:2px;padding-top:3px}
.clomark{display:flex;align-items:center;gap:7px;font-size:13px}
.clodot{width:11px;height:11px;border-radius:50%;flex:0 0 auto;border:1px solid rgba(0,0,0,.25)}
.clo-black{background:#222}.clo-pink{background:#e8579b}.clo-orange{background:#f07c22}.clo-teal{background:#28b3a8}
.cloplate{margin:6px 0 10px}
.cloplate img{width:100%;height:auto;border-radius:10px;border:1px solid var(--line);cursor:zoom-in;display:block}
.cloplate figcaption{font-size:11.5px;color:var(--mute);margin-top:5px}
@media print{ .cloplate img{cursor:auto} }
a.dkno{color:var(--orange);text-decoration:none;border-bottom:1px dashed currentColor}
a.dkno:hover,a.dkno:focus-visible{text-decoration:none;border-bottom-style:solid}
.dkn2,.dknop{display:block;font-size:11px;color:var(--mute)}
@media print{ a.dkno{border-bottom:0;color:inherit} }
.fratetbl td.frs input.rate{display:block;width:100%;max-width:110px;margin:3px 0 3px auto}
.fratetbl td.frs .w{display:block;font-size:11px;color:var(--mute)}
.fratetbl b.fmneg{color:var(--red,#c0392b)}
@media (max-width:760px){ .fratetbl td.frs input.rate{max-width:none} }
.rochip{display:inline-flex;align-items:center;gap:7px;margin:0 0 12px;padding:7px 12px;border-radius:9px;
  border:1px solid var(--rule);background:var(--tint2);font-size:12.5px;color:var(--ink2)}
.rochip b{color:var(--ink);font-weight:700}
.rochip i{width:8px;height:8px;border-radius:50%;background:#8fb3d9;flex:0 0 auto}
body:not(.viewonly) .rochip{display:none}
@media print{ .rochip{display:none!important} }
/* where we are */
.progtbl td.num, .progtbl th.num{white-space:nowrap}
.progtbl tr.total td{border-top:2px solid var(--ink);font-weight:600}
.progkeys{font-size:12.5px;line-height:1.9;margin:8px 0 0}
.asof{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--mute)}
.asof input{font:inherit;padding:4px 6px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);color:var(--ink)}
.hubwho{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;color:var(--slate)}
/* complete on the map: a green tick on the marker's lower shoulder, beside the light, never over the ID */
/* the cancelled mark: a ring and a bar, in the stop colour where colour is available and as a plain shape where
   it is not. On a marker it sits on the top-right shoulder — the tick has the bottom-right, the breakdown the
   top-left — and the pill itself goes hollow and dashed so it reads as a place nobody is going. */
.nomark{display:inline-flex;align-items:center;gap:5px;color:var(--tl-red);font-size:12px;letter-spacing:.02em;text-transform:uppercase;font-weight:700;vertical-align:middle}
.nomark .nogo{flex:0 0 auto}
.nomark.big{font-size:13px}
.mk .nox{position:absolute;right:-6px;top:-7px;width:14px;height:14px;border-radius:50%;background:#fff;color:var(--tl-red);display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 1px var(--tl-red)}
.mk.cancelled{background:var(--paper);color:var(--mute);border-style:dashed;text-decoration:line-through}
.mk .okx{position:absolute;right:-6px;bottom:-7px;width:14px;height:14px;border-radius:50%;background:var(--tl-green);color:#fff;
  font:800 10px/14px "Segoe UI",system-ui,sans-serif;text-align:center;border:1.5px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.35);font-style:normal;z-index:1}
@media (prefers-reduced-motion:reduce){.tickbtn{transition:none} .tickbtn:hover{transform:none}}
.daytbl .acts{display:flex;gap:4px;flex-wrap:wrap}
.daytbl .acts button{padding:4px 8px;font-size:11.5px;border-radius:7px}
.agenda .dayblock{margin-bottom:16px}
.sidecards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:12px}
/* F11: the brief and the context it is read against, side by side, on a screen wide enough to hold both */
.todaycols{display:grid;grid-template-columns:1fr;gap:16px;align-items:start}
.todaycols > .dbrief{max-width:100%;min-width:0}
.sidecol{display:grid;gap:12px;align-content:start;min-width:0}
.sidecol ul{margin:0;padding-left:18px;font-size:12.5px;line-height:1.5}
.sidecol .tm{font-weight:700;font-variant-numeric:tabular-nums;margin-right:6px}
@media(min-width:1180px){
  .todaycols{grid-template-columns:minmax(0,1fr) minmax(300px,380px)}
  .sidecol{position:sticky;top:8px}
}
@media print{ .todaycols{display:block} .sidecol{position:static;margin-top:10px} }
.sidecards ul{margin:0;padding-left:18px;font-size:12.5px;line-height:1.5}
.sidecards .tm{font-weight:700;font-variant-numeric:tabular-nums;margin-right:6px}
/* The old day card's phone rule lived here and set padding on .day, which on the new card is the PERIMETER
   EDGE — eight pixels of it, on every phone. The card's own media query is with the rest of its rules. */
/* v5.49 — THE BUTTONS JOIN THE FAMILY. Every card on this page carries the asymmetric corner Andrew Fisher
   settled on 14 Sep 2026 — cut at the top-right and the bottom-left — and every button was a plain 8px
   rounded rectangle, so a row of controls under a card read as a different kit bolted on. Same corner, same
   direction, a slightly firmer label. Nothing moves and nothing changes colour: it is the shape that was
   out of step. */
/* v5.49, straight after: THE PADDING STAYS AT 12. Widening the button by a pixel each side looked better and
   cost 9 px across the Register tab's control row, which on a 390 px phone is the difference between fitting
   and scrolling sideways — caught by the phone check in verify-open and measured back to exactly this rule.
   A button row on a phone has no room to give — and the firmer label went the same way for the same reason:
   at weight 600 the words themselves are wider, and the row still did not fit. So the CORNER is the whole of
   the change. It is the thing that was out of step anyway, and it costs not one pixel. */
.btn{padding:8px 12px;border:1px solid var(--rule);background:var(--paper);border-radius:9px 0 9px 0;cursor:pointer;
  font-size:13px;white-space:nowrap}
.btn{transition:border-color .15s, box-shadow .15s, background .15s}
.btn:hover{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide)}
.btn:active{transform:translateY(1px)}
.btn:focus-visible{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px var(--glow)}
@media (prefers-reduced-motion:reduce){.btn{transition:none}.btn:active{transform:none}}
/* White on #e5701c is 3.15:1. The darker orange keeps the brand and clears 4.5:1 for button text. */
.btn.primary{background:var(--orange-ink);border-color:var(--orange-ink);color:#fff;font-weight:700}
@media (prefers-color-scheme: dark){.btn.primary{background:#b5580f;border-color:#b5580f;color:#fff}}
.btn.ghost{background:none}
/* v5.76 — the one button in the page that erases rather than sets aside. It is quiet until you go near it,
   because it sits beside Take off in a list somebody scans, and a red button in a row of grey ones gets
   pressed by accident on a phone. It confirms before it acts either way. */
.btn.danger{border-color:#b3261e;color:#b3261e}
.btn.danger:hover,.btn.danger:focus-visible{background:#b3261e;color:#fff}
@media (prefers-color-scheme:dark){.btn.danger{border-color:#ff8a80;color:#ff8a80}
  .btn.danger:hover,.btn.danger:focus-visible{background:#b3261e;color:#fff;border-color:#b3261e}}
/* v5.49 — and the inputs that share a row with them, so a date box beside a Print button is the same shape */
.dsnhead input[type=date], .row input[type=date], .tools input[type=date],
input[type=date].btnlike, select.btnlike, input.btnlike{border-radius:9px 0 9px 0}
/* a link dressed as a button keeps button ink, not link orange — 2.9:1 on white is not readable */
a.btn{color:var(--ink);text-decoration:none;display:inline-flex;align-items:center}
/* the nav row: 46px, five primary views and a labelled More. It no longer scrolls on a laptop because it no
   longer carries fifteen buttons. Superior Audit, 15 Sep 2026. */
nav.tabs{display:flex;align-items:stretch;gap:2px;padding:0 12px;height:46px;min-height:46px;
  overflow-x:auto;overflow-y:visible;-webkit-overflow-scrolling:touch}
nav.tabs button{padding:0 15px;border:0;background:none;cursor:pointer;font-size:13px;
  color:var(--hdr-mute);border-bottom:2.5px solid transparent;white-space:nowrap;position:relative;
  transition:color .15s, border-color .15s;display:inline-flex;align-items:center;gap:6px}
nav.tabs .tg{width:14px;height:14px;flex:0 0 auto;opacity:.85}
nav.tabs button[aria-selected="true"] .tg,nav.tabs .tabmore.on .tg{opacity:1}
/* a tablet has the words but not the room for glyphs beside all of them: 641–1023 px keeps the words alone */
@media(min-width:641px) and (max-width:1023px){ nav.tabs button{padding:0 11px;gap:0} nav.tabs button .tg{display:none} }
/* THE PHONE'S TAB BAR. Seven views and More in one row of 360 px: a glyph over a word, no scrolling, every view
   in reach with a thumb. The row keeps its 46 px; the word is 10.5 px, bold when selected, and the glow under
   the open tab is the same glow. The More button carries the open view's name when that view is under it,
   trimmed to its cell rather than pushing the row out. */
@media(max-width:640px){
  nav.tabs{gap:0;padding:0 4px;overflow:hidden;justify-content:space-between}
  nav.tabs button{flex:1 1 0;min-width:0;padding:4px 1px 0;flex-direction:column;justify-content:flex-start;gap:2px;
    font-size:10.5px;letter-spacing:0;line-height:1.05;white-space:normal}
  nav.tabs .tg{width:17px;height:17px}
  /* a two-word view ("Where we are", "Coates Way") takes two lines rather than an ellipsis; the glyphs stay level
     because every tab hangs from the top of the row */
  nav.tabs .tw{max-width:100%;overflow:hidden;text-align:center;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
    overflow-wrap:normal;word-break:normal}
  nav.tabs .tw .nb{white-space:nowrap}
  nav.tabs .tabmore .cv{display:none}
  nav.tabs button[aria-selected="true"]::after,.tabmore.on::after{left:18%;right:18%}
  nav.tabs .dot{position:absolute;top:4px;right:calc(50% - 15px)}
}
/* More, in the nav row. It carries the name of the open view when the open view lives inside it, so a person
   who deep-linked to #pricing still sees where they are without opening anything. */
.tabmore{display:inline-flex;align-items:center;gap:6px;font-weight:600}
.tabmore .cv{width:0;height:0;border:4px solid transparent;border-top-color:currentColor;margin-top:2px;opacity:.75}
.tabmore.on{color:#fff;border-bottom-color:var(--orange)}
.tabmore.on::after{content:'';position:absolute;left:12%;right:12%;bottom:-2.5px;height:2.5px;border-radius:2px;
  background:var(--orange);box-shadow:0 0 12px 2px var(--glow)}
/* anchored to the header, not to the strip that scrolls; capped to the screen and scrollable if the list is
   longer than the phone is tall, so every view inside it is always reachable */
.tabmoremenu{position:absolute;left:12px;top:calc(100% - 2px);z-index:80;min-width:190px;
  max-width:calc(100vw - 16px);max-height:calc(100vh - 120px);overflow-y:auto;padding:6px;
  background:var(--paper);border:1px solid var(--rule);border-radius:12px 0 12px 0;box-shadow:var(--lift-hi);
  display:flex;flex-direction:column;gap:2px}
@media(max-width:640px){ .tabmoremenu{left:8px;right:8px;min-width:0;max-width:none} }
.tabmoremenu[hidden]{display:none!important}
.tabmoremenu button{display:block;width:100%;text-align:left;padding:8px 11px;border-radius:7px;font-size:13px;
  color:var(--ink);border-bottom:0;min-height:36px}
.tabmoremenu button:hover{background:var(--tint);color:var(--ink)}
.tabmoremenu button[aria-current="page"]{background:var(--orange-soft);color:var(--orange);font-weight:700}
.tabmoremenu button:focus-visible{outline:2px solid var(--orange);outline-offset:-2px}
nav.tabs button:hover{color:var(--hdr-ink)}
nav.tabs button[aria-selected="true"]{color:#fff;border-bottom-color:var(--orange);font-weight:600}
/* the glow under the active tab — the one place a soft light says "you are here" */
nav.tabs button[aria-selected="true"]::after{content:'';position:absolute;left:12%;right:12%;bottom:-2.5px;
  height:2.5px;border-radius:2px;background:var(--orange);box-shadow:0 0 12px 2px var(--glow)}
main{flex:1 1 auto;overflow:auto;padding:16px;min-height:0}
.pane{display:none;max-width:1500px;margin:0 auto}
.pane.on{display:block}
/* a tab arrives, it does not pop: 220 ms up from six pixels below, from a visible resting state — the pane is
   drawn first and eases in, so a thumbnail, a print and a reader who does not scroll all get the whole page */
@keyframes paneIn{from{opacity:.001;transform:translateY(6px)} to{opacity:1;transform:none}}
.pane.on.arrive{animation:paneIn .22s cubic-bezier(.2,.7,.2,1) both}
/* the orange plate catches the light on hover — one pass of gloss, never a loop */
.plateb .rplate, .eqc .rplate, .hubcard .rplate{position:relative;overflow:hidden}
.plateb .rplate::after, .eqc:hover .rplate::after{content:'';position:absolute;top:-30%;bottom:-30%;left:-60%;width:40%;
  background:linear-gradient(105deg, rgba(255,255,255,0) 0, rgba(255,255,255,.55) 50%, rgba(255,255,255,0) 100%);transform:skewX(-18deg);
  opacity:0;pointer-events:none}
.plateb:hover .rplate::after, .eqc:hover .rplate::after{animation:plateGloss .7s ease-out 1}
@keyframes plateGloss{0%{left:-60%;opacity:0} 15%{opacity:1} 100%{left:130%;opacity:0}}
/* a row's wash follows its light without a jump */
tbody tr{transition:background-color .35s ease}
@media (prefers-reduced-motion:reduce){.pane.on.arrive{animation:none} .plateb:hover .rplate::after, .eqc:hover .rplate::after{animation:none} tbody tr{transition:none}}
html[data-motion="off"] .pane.on.arrive{animation:none}

/* ---------------- notices */
.notice{background:var(--amber-soft);border-left:3px solid var(--amber);padding:11px 15px;border-radius:4px 10px 10px 4px;
  font-size:13px;margin:0 0 14px;line-height:1.5}
.notice.info{background:var(--navy-soft);border-left-color:var(--navy)}
.notice.warn{background:var(--red-soft);border-left-color:var(--red)}
.notice b{display:block;margin-bottom:2px}

/* ---------------- cards & tables
   Andrew Fisher, 14 Sep 2026: every card looks the same as the ones we have been doing — one look on every
   page.

   One page, one family, and ONE PLACE THAT SAYS SO. There are sixty-seven `class="card"` boxes across this
   page and ten that use the shaped .cut component. Converting sixty-seven call sites by hand would be sixty-
   seven chances to miss one and sixty-seven places for the next change to drift apart again, so the shape is
   put HERE, on the class every one of them already wears. One edit moves all of them, and the next one will
   too.

   The family mark is the ASYMMETRIC CORNER — sharp top-right and bottom-left, rounded on the other two, the
   same corner the .cut cards carry.

   What a plain card does NOT take is the diagonal notch. That is deliberate and it is not a shortcut: the
   notch is cut with clip-path, and clip-path clips EVERYTHING inside the box, focus rings included. A .cut
   card can wear one because it is a two-element sandwich built for it, with the clip on an outer shell and
   nothing focusable inside. A plain card holds buttons and inputs, and several of them sit in exactly the
   top-right corner the notch would take — Print this list, Refresh, Send to a phone. Clipping a keyboard
   focus ring in half to gain a corner is a bad trade. So the notch stays the mark of the cards that ARE the
   thing — a date, a drop, an item of equipment — and the container cards carry the corner, the edge, the lift
   and the type. Same family, one rank down. */
/* v5.49 — EVERY CARD WEARS THE CORNER HE SETTLED ON. Andrew Fisher, 14 Sep 2026, fixing the visual language
   for every surface: cut corners of about 17 px top-right and bottom-left, with a fine perimeter edge. The component
   family (.cut) has had it since; the ordinary card never did — it wore a ROUNDED version of the same
   asymmetry, 14px radius, which reads as a softened echo rather than the thing itself. Asked on 18 Sep 2026
   what to go at first, he said the cards.

   Done so the cut is real and nothing inside a card is clipped by it: the card itself stays an ordinary box
   with no background and no border, and its surface is drawn behind the content by two pseudo-elements — the
   edge, then the face one pixel inside it — each carrying the chamfer. Children are untouched, so a drawer, a
   sticky header or a map inside a card behaves exactly as it did. The lift comes from drop-shadow rather than
   box-shadow because a box-shadow would draw a rectangle around a cut corner, and drop-shadow follows the
   shape it is given.

   v5.49, straight after: NO `filter` ON THE CARD. drop-shadow was the obvious way to give a cut corner a
   shadow that follows its shape, and it cost more than it was worth — `filter` makes an element a containing
   block for anything `position: fixed` inside it, so the asset drawer stopped sizing itself to the screen and
   sized to the card instead, and the Register tab scrolled sideways on a phone. Caught by the phone check in
   verify-open, which is exactly what it is there for. The card carries its own fine edge and that is enough;
   his language asks for "a fine perimeter edge", and the restrained shadow he specified belongs to the orange
   selection card, which has it. --card-r is kept as the knob it always was: set it to 0 and a card squares
   off. */
.card{--cut:17px; --edge:var(--rule); --face:var(--paper);
  position:relative;background:none;border:0;
  padding:16px 18px;margin-bottom:16px;
  transition:none}
.card::before, .card::after{content:'';position:absolute;z-index:-1;pointer-events:none}
.card::before{inset:0;background:var(--edge);
  clip-path:polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)))}
.card::after{inset:1px;background:var(--face);
  clip-path:polygon(0 0, calc(100% - var(--cut) + 1px) 0, 100% calc(var(--cut) - 1px), 100% 100%,
    calc(var(--cut) - 1px) 100%, 0 calc(100% - var(--cut) + 1px))}
/* the lift on hover is the edge going orange, which needs no shadow and no filter */
.card:hover::before{background:var(--orange)}
/* on paper a chamfer is a hairline and the face is white */
@media print{.card::before{background:#000}.card::after{background:#fff}}
@media (prefers-reduced-motion:reduce){.card{transition:none}}
/* Every card heading reads the same way, whatever page it is on: the name in the page's own weight, and the
   line under it in the quiet colour at the quiet size. */
.card h3{margin:0 0 4px;font-size:15px;font-weight:800;letter-spacing:-.005em}
.card h4{margin:0 0 6px;font-size:13.5px;font-weight:800;letter-spacing:.005em}
.card .sub{color:var(--slate);font-size:12.5px;margin:0 0 12px}
/* A card inside a card is a panel, not a second card: it keeps the corner but drops the lift, so a page does
   not read as boxes stacked on boxes. */
.card .card{box-shadow:none;--card-r:11px}

/* ------------------------------------------------------------------ the programme rail
   Andrew Fisher, 12 Sep 2026, looking at the old strip: the programme reading on Where we are looked poor and
   needed to be cleaner and tidier. The weeks in four colours, a waving flag, six labels fighting over
   the same inch and a legend to decode it all are gone. What is left is the plain reading — how far through the
   calendar this day sits, where race start falls, and the three dates that bound it. The weeks are still hit
   areas, so a week is one press from its day view; they just no longer shout. */
.racecard{grid-column:1/-1}
.pgm{position:relative}
.pstats{display:flex;margin:0 0 24px;max-width:660px}
.pstat{flex:1;min-width:0;padding-right:20px}
.pstat+.pstat{border-left:1px solid var(--rule);padding-left:24px}
.pstat b{font-size:40px;font-weight:800;letter-spacing:-.035em;line-height:1;color:var(--ink)}
.pstat b+span{font-size:14px;color:var(--mute);margin-left:7px}
.pstat em{display:block;font-style:normal;font-size:14.5px;font-weight:600;color:var(--ink2);margin-top:10px}
.pstat i{display:block;font-style:normal;font-size:12px;color:var(--mute);margin-top:3px}
.prail{position:relative;height:8px;border-radius:6px;background:var(--rule2);margin-top:46px}
.prail .pfill{position:absolute;left:0;top:0;bottom:0;border-radius:6px;background:linear-gradient(90deg,#f59147,#e85f0f)}
.prail .pweek{position:absolute;top:-15px;bottom:-15px;border:0;background:transparent;padding:0;margin:0;cursor:pointer}
.prail .pweek:focus-visible{outline:2px solid var(--orange-ink);outline-offset:2px;border-radius:4px}
.prail .pnotch{position:absolute;top:-6px;bottom:-6px;left:var(--r);width:2px;margin-left:-1px;border-radius:1px;background:var(--ink);opacity:.7}
.prail .pdot{position:absolute;top:50%;left:var(--p);width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;
  background:var(--orange);box-shadow:0 1px 3px rgba(20,24,29,.28)}
.prail .plab{position:absolute;bottom:100%;margin-bottom:11px;left:var(--p);transform:translateX(-50%);
  white-space:nowrap;font-size:12px;font-weight:700;color:var(--orange-ink)}
.prail .plab.left{transform:none}
.prail .plab.right{transform:translateX(-100%)}
.pends{position:relative;height:32px;margin-top:10px;font-size:11.5px;color:var(--mute)}
.pends span{position:absolute;white-space:nowrap;line-height:1.35}
.pends b{display:block;font-size:12.5px;font-weight:700;color:var(--ink2)}
.pends .a{left:0}
.pends .z{right:0;text-align:right}
.pends .m{left:var(--r);transform:translateX(-50%);text-align:center}
.pnote{font-size:11.5px;color:var(--mute);margin:10px 0 0}
.pnote b{color:var(--ink2);font-weight:700}
/* the Today card that carries the rail: the phase, the two figures, the next milestone and the key dates */
.phead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
.phead h3{margin:0;font-size:16px}
.pphase{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;font-size:12px;font-weight:600;
  color:var(--orange-ink);background:var(--tint2);border:1px solid var(--rule);border-radius:999px;padding:5px 12px}
.pphase i{width:7px;height:7px;border-radius:50%;background:var(--orange)}
.pnext{margin-top:20px;padding:14px 16px;border:1px solid var(--rule);border-radius:12px;background:var(--tint2)}
.pnexthead{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.pnk{font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--orange-ink)}
.pnin{font-size:12px;color:var(--mute)}
.pnext h4{margin:5px 0 0;font-size:19px;letter-spacing:-.01em}
.pnext p{margin:2px 0 0;font-size:12.5px;color:var(--mute)}
.pnfig{display:flex;flex-wrap:wrap;gap:6px 20px;margin-top:10px;font-size:13px;color:var(--ink2)}
.pnfig b{font-size:19px;font-weight:800;margin-right:5px;color:var(--ink)}
.pkeys{margin-top:18px;border-top:1px solid var(--rule);padding-top:12px}
.pkeyhead{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12.5px;color:var(--mute)}
.pkeys ul{list-style:none;margin:8px 0 0;padding:0}
.pkeys li{display:flex;justify-content:space-between;gap:16px;padding:7px 0;border-bottom:1px solid var(--rule2);font-size:13.5px}
.pkeys li:last-child{border-bottom:0}
.pkeys li span{color:var(--ink2)}
.pkeys li b{font-weight:600;color:var(--ink)}
.pkeys li.done span,.pkeys li.done b{color:var(--mute)}
.pkeys li.next span,.pkeys li.next b{color:var(--orange-ink)}
@media (max-width:640px){
  .pstats{margin-bottom:20px}
  .pstat b{font-size:32px}
  .pstat{padding-right:12px}
  .pstat+.pstat{padding-left:16px}
  .pends .m{display:none}
  .phead{flex-wrap:wrap}
}
.unreftbl tr.unref td:first-child{box-shadow:inset 3px 0 0 var(--amber)}
.unrefcard{border-left:4px solid var(--amber)}
/* an installation plan laid over a programme week: its own block, its tables scroll sideways on a phone like every day table */
.planupd{margin-top:14px;padding:12px 14px 6px;border:1px solid var(--rule);border-left:4px solid var(--orange);border-radius:4px 10px 10px 4px;background:var(--tint2)}
.planupd h3{margin:0 0 6px;font-size:15px}
.planupd .tblwrap table{min-width:640px;overflow-wrap:normal}
.planupd .tblwrap td, .planupd .tblwrap th{overflow-wrap:normal;word-break:normal}
.planupd .sect{margin-top:10px}
/* v5.58 — a drawer section that opens and closes: the heading is the summary, and it remembers on this device */
details.dsect{margin:14px 0 8px;border-top:1px solid var(--line, #2b2521)}
details.dsect>summary{cursor:pointer;list-style:none;padding:10px 0 6px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent, #ff9a4d);font-weight:700;display:flex;align-items:center;gap:8px}
details.dsect>summary::-webkit-details-marker{display:none}
details.dsect>summary::before{content:'\25B8';font-size:12px;transition:transform .15s}
details.dsect[open]>summary::before{transform:rotate(90deg)}
details.dsect>summary:focus-visible{outline:2px solid var(--accent, #ff9a4d);outline-offset:2px}
.sect.contents{margin-top:16px}

.tm-list{list-style:none;margin:0;padding:0}
.tm-person{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--rule);flex-wrap:wrap}
.tm-person:last-child{border-bottom:0}
.tm-who{display:flex;flex-direction:column;gap:1px;min-width:0}
.tm-who b{font-size:14px}
.tm-role{font-size:12.5px;color:var(--ink2)}
.tm-title{font-size:11.5px;color:var(--mute)}
.tm-acts{display:flex;gap:6px;flex-wrap:wrap}
.tm-acts .btn{min-height:34px}
.tm-person.lead .tm-who b{font-size:15px}
.tm-person.lead{border-left:3px solid var(--orange);padding-left:10px}
.tm-group{margin-top:6px}
.tm-list.compact .tm-person{padding:6px 0}
.tm-list.compact .tm-role{font-size:12px}
.teamhub .tm-acts .btn{min-height:30px;padding:4px 10px;font-size:12px}
@media (max-width:640px){.tm-person{align-items:flex-start;flex-direction:column}.tm-acts{width:100%}.tm-acts .btn{flex:1;text-align:center}}
@media print{ .prail .pfill,.prail .pdot,.prail .pnotch{-webkit-print-color-adjust:exact;print-color-adjust:exact} }
CAR_CSS_RULE
CAR_RUN_CSS_RULE
/* F11: each tile is as tall as what it holds. Stretched to the tallest, a two-line tile beside a six-line one
   carried 200px of empty white, which is the dead space the audit measured on Today's right-hand column in
   another form. */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px;align-items:start}
/* ---------------- the headline tile, in the page's own geometry
   Superior Audit, 15 Sep 2026, and Andrew Fisher's own read of it: some pages looked premium while others still
   used the older design. Today, Documents and the Timeline had the chamfered card, the condensed racing figure and
   the orange keyline; Register, Fencing, Pricing, Costs, Breakdowns and Variances still had a rounded box with
   a bar across the top. One tile is used on all of them now — the same two opposing chamfers, the same figure,
   the same label and note — so a person moving between pages is looking at one system rather than two.
   Written on .kpi rather than as a new class on purpose: every page that already draws a headline figure gets
   it in this rebuild, and nothing has to be found and changed by hand. */
.kpi{--cut:14px; --edge:var(--rule); --face:var(--paper); --rule-top:var(--orange);
  position:relative;padding:15px 16px;border:0;background:transparent;color:var(--ink);
  border-radius:12px 0 12px 0;box-shadow:var(--lift);
  clip-path:polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)))}
/* two layers under the content: the edge, with the orange keyline across its top, and the face inset inside it.
   Drawn as pseudo-elements so no page has to change its markup to get the new geometry. */
.kpi::before{content:'';position:absolute;inset:0;z-index:0;
  background:linear-gradient(to bottom, var(--rule-top) 0 3px, var(--edge) 3px)}
.kpi::after{content:'';position:absolute;inset:3px 1px 1px 1px;z-index:0;background:var(--face);
  clip-path:polygon(0 0, calc(100% - var(--cut) + 2px) 0, 100% calc(var(--cut) - 2px), 100% 100%,
                    calc(var(--cut) - 2px) 100%, 0 calc(100% - var(--cut) + 2px))}
.kpi > *{position:relative;z-index:1}
.kpi.alert{--rule-top:var(--red)} .kpi.alert .v{color:var(--red)}
/* the figure in the page's own condensed racing face, tabular so a column of them lines up; it shrinks to fit
   its tile on a phone before it ever pushes the page sideways */
.kpi .v{font-family:'Barlow Condensed', 'Arial Narrow', var(--sans, system-ui, sans-serif);font-style:italic;
  font-size:clamp(26px,8vw,38px);font-weight:700;line-height:.94;letter-spacing:-.01em;
  overflow-wrap:normal;white-space:nowrap;min-width:0;font-variant-numeric:tabular-nums}
.kpi .v small{white-space:normal}
.kpi .v small{font-size:13px;color:var(--slate);font-style:normal;font-family:'Inter', var(--sans, system-ui, sans-serif)}
.kpi .l{font-family:'Inter', var(--sans, system-ui, sans-serif);font-size:10.5px;text-transform:uppercase;
  letter-spacing:.11em;color:var(--slate);margin-top:6px;font-weight:700}
.kpi .q{font-family:'Inter', var(--sans, system-ui, sans-serif);font-size:11.5px;color:var(--mute);
  margin-top:4px;line-height:1.4}
@media print{ .kpi{clip-path:none;border:1px solid #999;box-shadow:none}
  .kpi::before{background:#000;inset:0 0 auto;height:2px} .kpi::after{display:none} }
/* v5.81 — the Costs tab's section heads, in the plates' own style */
#pane-costs h3.sec{margin:18px 0 10px;font-size:15px;font-weight:800;letter-spacing:.02em;color:var(--ink);display:flex;align-items:baseline;gap:4px 10px;flex-wrap:wrap}
#pane-costs h3.sec span{font-weight:400;color:var(--mute);font-size:12px;letter-spacing:0}
/* v5.81 — the ledger: what we charge on the left, what it costs us on the right, never added across */
.ledger{display:grid;grid-template-columns:1fr 1fr;gap:14px 22px;margin-top:4px}
@media (max-width:820px){.ledger{grid-template-columns:1fr}}
.ledger .side{min-width:0}
.ledger .side h4{margin:0 0 4px;font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-size:17px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:var(--navy);display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.ledger .side h4 small{font-family:'Inter',var(--sans,system-ui,sans-serif);font-size:11px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--mute)}
.ledger .ln{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 14px;align-items:start;padding:7px 0;border-bottom:1px dashed var(--rule)}
.ledger .ln .lb{font-size:13px;min-width:0;overflow-wrap:anywhere}
.ledger .ln .lb small{display:block;color:var(--mute);font-size:11px;line-height:1.4;margin-top:2px}
.ledger .ln .amt{font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-size:19px;font-weight:700;font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap;line-height:1.2}
.ledger .ln.total{border-top:2px solid var(--ink);border-bottom:0;margin-top:2px;padding-top:8px}
.ledger .ln.total .lb{font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11.5px;align-self:center}
.ledger .ln.total .amt{font-size:24px}
.ledger .ln.faint{border-bottom:0;padding-top:4px} .ledger .ln.faint .lb{color:var(--mute);font-size:12px} .ledger .ln.faint .amt{color:var(--mute);font-weight:400;font-size:15px}
.verdict{margin-top:12px;padding:10px 14px;border-left:4px solid var(--green);background:var(--green-soft);border-radius:8px;font-size:13px;line-height:1.5}
.verdict.neg{border-left-color:var(--red);background:var(--red-soft)}
/* v5.83 — costs & charges for management: the definitions, the streams, what Coates pays by category */
.moneydef{margin:6px 0 0;font-size:12.5px;color:var(--ink2)}
.streamwrap{margin-top:12px}
.streamtbl{width:100%;border-collapse:collapse;font-size:13px}
.streamtbl th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--mute);text-align:left;padding:8px 10px;border-bottom:1px solid var(--rule);background:var(--tint2)}
.streamtbl td{padding:8px 10px;border-bottom:1px solid var(--rule);vertical-align:top}
.streamtbl td.num,.streamtbl th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.streamtbl td .w{font-size:11.5px;color:var(--mute)}
.streamtbl td.stnote{font-size:11.5px;color:var(--slate);line-height:1.4;min-width:220px}
.streamtbl tr.total td{border-top:2px solid var(--ink);border-bottom:0;background:var(--tint2)}
.streamtbl b.neg,.dsn .mtot i.neg{color:var(--red)} .streamtbl b.pos{color:var(--green)}
.paycats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:12px 0 10px}
@media (max-width:1000px){.paycats{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.paycats{grid-template-columns:1fr}}
.paycat{display:flex;flex-direction:column;gap:3px;background:var(--paper);border:1px solid var(--rule);border-left:4px solid var(--navy);border-radius:10px;padding:10px 12px;box-shadow:var(--lift);min-height:84px}
.paycat.hrs{border-left-color:var(--amber,#c98a00)} .paycat.none{border-left-color:var(--rule);opacity:.85}
.paycat .pc-name{font-weight:700;font-size:13px;line-height:1.25}
.paycat .pc-amt{font-size:21px;font-weight:700;letter-spacing:-.02em;line-height:1.15;margin-top:3px;font-variant-numeric:tabular-nums}
.paycat .pc-amt small{font-size:12px;font-weight:600;color:var(--mute)}
.paycat .pc-amt .todo{font-size:12px;font-weight:500;letter-spacing:0}
.paycat .pc-sub{font-size:11.5px;color:var(--slate);line-height:1.4}
.paytot{display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:baseline;border-top:2px solid var(--ink);padding-top:8px;font-size:13px}
.paytot b{font-size:22px;font-variant-numeric:tabular-nums} .paytot .w{grid-column:1 / -1;font-size:12px;color:var(--mute)}
@media (max-width:640px){
  .streamtbl thead{display:none}
  .streamwrap{overflow-x:visible}
  .streamtbl,.streamtbl tbody{display:block;width:100%;min-width:0}
  .streamtbl tr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px 10px;padding:10px 12px;border-bottom:1px solid var(--rule)}
  .streamtbl td{display:block;border:0;padding:0}
  .streamtbl td:first-child,.streamtbl td.stnote{grid-column:1 / -1;min-width:0}
  .streamtbl td.num{text-align:left;white-space:normal}
  .streamtbl td.num::before{content:attr(data-l);display:block;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--mute);font-weight:600}
  .streamtbl tr.total{border-top:2px solid var(--ink)}
}
.scopetbl td{vertical-align:top} .scopetbl input.scopein{width:6.2em;max-width:100%} .scopetbl input.ppl{width:3.2em} .scopetbl input.hrs{width:4.6em}
.scopetbl input.tm{width:4.6em;text-align:center}
/* the form that adds one of our lines */
.ourform{margin-top:12px;padding:10px 12px;border:1px dashed var(--rule);border-radius:10px;background:var(--paper)}
.ourform .hd{font-size:12px;font-weight:700;margin-bottom:8px}
.ourform .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px 10px}
.ourform label{display:flex;flex-direction:column;gap:3px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--mute);min-width:0}
.ourform label.wide{grid-column:span 2}
.ourform input,.ourform select{font:inherit;font-size:13.5px;padding:6px 8px;border:1px solid var(--rule);border-radius:6px;background:#fff;color:var(--ink);min-width:0;text-transform:none;letter-spacing:0}
.ourform .acts{margin-top:10px}
tr.editing td{background:var(--orange-soft)}
/* the eight cost categories, each a card that filters the lines beneath it */
.costcats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}
@media (max-width:1000px){.costcats{grid-template-columns:repeat(2,1fr)}}
.costcat{font:inherit;text-align:left;display:flex;flex-direction:column;gap:3px;background:var(--paper);border:1px solid var(--rule);
  border-left:4px solid var(--navy);border-radius:10px;padding:10px 12px;cursor:pointer;color:var(--ink);box-shadow:var(--lift);min-height:84px}
.costcat:hover{border-color:var(--orange);border-left-color:var(--orange)}
.costcat.on{border-color:var(--orange);border-left-color:var(--orange);background:var(--orange-soft)}
.costcat.warn{border-left-color:var(--red)}
.costcat:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
.costcat .cc-name{font-weight:700;font-size:13.5px;line-height:1.2}
.costcat .cc-full{font-size:10.5px;color:var(--mute);line-height:1.3}
.costcat .cc-amt{font-size:22px;font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-top:4px;font-variant-numeric:tabular-nums}
.costcat .cc-amt .todo{font-size:12px;font-weight:500;letter-spacing:0}
.costcat .cc-amt.hrs{font-size:17px}
.costcat .cc-sub{font-size:11.5px;color:var(--slate);line-height:1.35}
.costcat .cc-derived{font-size:11px;color:var(--mute);line-height:1.35;border-top:1px dashed var(--rule);padding-top:4px;margin-top:3px}
.costtbl tfoot td, .ledgertbl tfoot td{border-top:2px solid var(--rule);background:var(--tint2)}
.costtbl td.num, .costtbl th.num, .ledgertbl td.num, .ledgertbl th.num, .brtbl td.num, .brtbl th.num{font-variant-numeric:tabular-nums}
.costtbl{min-width:1000px} /* v5.83 — ten columns; below this the description column wraps a line a word on a phone, so the table scrolls sideways in its frame instead */
.brtbl tr.total td{border-top:2px solid var(--rule);background:var(--tint2);font-weight:600}
/* the purchase-order card's controls sit in table cells, outside the form styling — same size as every other control */
[data-po-period],[data-po-inv],[data-po-amt]{min-height:34px;font:inherit;font-size:13px;padding:4px 8px;border:1px solid var(--rule);border-radius:7px;background:var(--paper);color:var(--ink);max-width:100%}
[data-po-period]{max-width:190px}
@media (max-width:640px){.costcats{grid-template-columns:1fr 1fr;gap:8px} .costcat{padding:8px 10px;min-height:0} .costcat .cc-amt{font-size:18px} .costcat .cc-full{display:none}}
.tblwrap{overflow-x:auto;border:1px solid var(--rule);border-radius:10px;background:var(--paper)}
@media(max-width:640px){main{overflow-x:hidden}.tblwrap{max-width:100%}}   /* v5.99 - a phone never scrolls the page sideways */
@media(max-width:640px){.clotbl td,.clotbl .clowin{white-space:normal}.clotbl .clowin{display:inline}.fratetbl input.rate,.fratetbl td.frs input.rate{width:100%;max-width:120px}}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:640px}
th{position:sticky;top:0;background:var(--tint2);text-align:left;font-size:10.5px;text-transform:uppercase;
  border-right:1px solid var(--rule2);
  letter-spacing:.07em;color:var(--slate);padding:9px 10px;border-bottom:1px solid var(--rule);z-index:2;white-space:nowrap}
/* A full grid, not just row rules. Five columns of short values with nothing between them read as a drift of
   text; the vertical rules are what make a row scannable across. */
td{padding:8px 10px;border-bottom:1px solid var(--rule2);border-right:1px solid var(--rule2);
  vertical-align:top}
td:last-child, th:last-child{border-right:0}
tbody tr:last-child td{border-bottom:0}
/* the wash and the hover live on the row, so a sticky first cell can inherit them */
tbody tr{background:var(--paper)}
tbody tr:hover{background:var(--tint2)}
tbody tr.click{cursor:pointer}
/* the first column stays put when a wide table scrolls sideways on a phone — the ID is the thing you need */
.tblwrap td:first-child, .tblwrap th:first-child{position:sticky;left:0;z-index:1;background:inherit;
  box-shadow:1px 0 0 var(--rule2)}
.tblwrap th:first-child{z-index:3;background:var(--tint2)}
td.num,th.num{text-align:right;white-space:nowrap}
.mono{font-family:ui-monospace,"SF Mono",Consolas,monospace;font-size:11.5px}

/* ---------------- chips */
/* Five states, one colour each, everywhere on the page. Grey = nothing recorded. Green = the source says so.
   Amber = assumed or a candidate, confirm it. Red = unresolved, and something is blocked on it. Orange = it
   differs from what was asked for, which is the one that costs money. Every chip is a bordered box so the
   state reads as a box at a glance and still reads on a black-and-white print, where the colours are gone. */
.chip{display:inline-block;padding:1.5px 7px;border-radius:5px;font-size:10.5px;font-weight:700;
  letter-spacing:.03em;text-transform:uppercase;background:var(--tint);color:var(--slate);white-space:nowrap;
  vertical-align:1px;max-width:100%;overflow-wrap:anywhere;
  border:1px solid var(--rule)}
/* ---------------------------------------------------------------- what a colour MEANS
   From the 14 Sep 2026 audit: "Add semantic colour consistently, always with text and an icon … Colour must not
   be the sole carrier of meaning." Six meanings, each with its own ink, its own ground and its own mark, and
   every one of them carries words as well — a chip that says nothing but green says nothing at all to somebody
   who cannot tell it from the amber one.

     good    something a person has confirmed        SITE CONFIRMED · SYNC CONFIRMED · COMPLETE
     gap     something nobody has answered yet       NEEDS CHECKING · QUANTITY UNKNOWN · NO OWNER
     stop    something wrong, or in the way           LOCATION CONFLICT · SAVE FAILED · OVERDUE
     plan    something planned or worked out, not observed   SCHEDULED · RENTAL-DERIVED · FORECAST
     change  something that moved, and its history    LOCATION CHANGED · REVISED · MOVED
     none    nothing has been observed                NO RECORD · NOT APPLICABLE

   The inks are the audit's, checked for 4.5:1 on their own ground. Dark mode is not the same pair lightened: a
   dark ground needs a light ink and a dim fill, so every one is written out again rather than inverted and
   hoped for. */
:root{
  --sem-good-ink:#166534; --sem-good-bg:#dcfce7; --sem-good-edge:#86ce9f;
  --sem-gap-ink:#854d0e;  --sem-gap-bg:#fef3c7;  --sem-gap-edge:#dcb463;
  --sem-stop-ink:#991b1b; --sem-stop-bg:#fee2e2; --sem-stop-edge:#dd9c9c;
  --sem-plan-ink:#1e40af; --sem-plan-bg:#dbeafe; --sem-plan-edge:#93aee0;
  --sem-change-ink:#6b21a8;--sem-change-bg:#f3e8ff;--sem-change-edge:#c09ce0;
  --sem-none-ink:#475569; --sem-none-bg:#f1f5f9; --sem-none-edge:#b8c2cd;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --sem-good-ink:#86efac; --sem-good-bg:#0d2a18; --sem-good-edge:#2f6b45;
  --sem-gap-ink:#fcd34d;  --sem-gap-bg:#2e2408;  --sem-gap-edge:#7a5f17;
  --sem-stop-ink:#fca5a5; --sem-stop-bg:#2e1212; --sem-stop-edge:#7d3434;
  --sem-plan-ink:#93c5fd; --sem-plan-bg:#101f3a; --sem-plan-edge:#2f4e88;
  --sem-change-ink:#d8b4fe;--sem-change-bg:#241033;--sem-change-edge:#5c3380;
  --sem-none-ink:#cbd5e1; --sem-none-bg:#1a1f26; --sem-none-edge:#3d4650;
}}
.sem{display:inline-flex;align-items:center;gap:5px;padding:2px 8px 2px 6px;border-radius:5px;
  font-size:10.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;line-height:1.5;
  border:1px solid var(--rule);background:var(--tint);color:var(--slate);max-width:100%;overflow-wrap:anywhere}
.sem i{flex:0 0 auto;font-style:normal;font-weight:800;font-size:11px;line-height:1}
.sem.good{background:var(--sem-good-bg);color:var(--sem-good-ink);border-color:var(--sem-good-edge)}
.sem.gap{background:var(--sem-gap-bg);color:var(--sem-gap-ink);border-color:var(--sem-gap-edge)}
.sem.stop{background:var(--sem-stop-bg);color:var(--sem-stop-ink);border-color:var(--sem-stop-edge)}
.sem.plan{background:var(--sem-plan-bg);color:var(--sem-plan-ink);border-color:var(--sem-plan-edge)}
.sem.change{background:var(--sem-change-bg);color:var(--sem-change-ink);border-color:var(--sem-change-edge)}
.sem.none{background:var(--sem-none-bg);color:var(--sem-none-ink);border-color:var(--sem-none-edge)}
.datesay{display:block;font-size:11.5px;color:var(--ink2);margin-top:4px;min-height:1.2em;font-weight:600}
.jfilt{display:flex;flex-wrap:wrap;gap:6px}
.jfilt .btn.sm{padding:3px 10px;font-size:12px}
.jtbl td{vertical-align:top}
.jtbl tr.jday td{background:var(--tint2);font-weight:800;font-size:12px;letter-spacing:.04em;
  text-transform:uppercase;color:var(--ink2);padding-top:9px;padding-bottom:7px}
.unreftbl tr.late td{box-shadow:inset 3px 0 0 var(--sem-stop-ink)}
.unreftbl tr.done td{color:var(--mute)}
.unreftbl td.acts{white-space:nowrap}
.unreftbl td.acts .btn.sm{padding:3px 9px;font-size:12px;margin:0 2px 2px 0}
@media print{ #pane-journal .jfilt, #pane-journal td.acts, #pane-journal .f, #pane-journal #aAdd{display:none!important} }
.semkey{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 14px}
.semkey .sem{cursor:default}
@media print{ .sem{-webkit-print-color-adjust:exact;print-color-adjust:exact} }
.chip.cand{border-color:#e3c78a} .chip.crit{border-color:#e7a9a4}
.chip.ok{border-color:#a6cdb4} .chip.act{border-color:#f0b184} .chip.ref{border-color:#cbb9a8}
.drawer .chip{white-space:normal;line-height:1.35}
.chip.cand{background:var(--amber-soft);color:var(--amber)}
.chip.crit{background:var(--red-soft);color:var(--red)}
.chip.ok{background:var(--green-soft);color:var(--green)}
.chip.ref{background:var(--navy-soft);color:var(--navy)}
.chip.act{background:var(--orange-soft);color:#a2500f}
@media (prefers-color-scheme:dark){.chip.ref{color:#a8c4d8}.chip.act{color:#f0a76a}}
.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
/* An empty value. --mute already clears 4.5:1, so a dash is quiet without being unreadable. */
.todo{color:var(--mute);font-weight:600;letter-spacing:.06em}
/* .ccode, not .legend — the map already owns .legend and forces every <i> inside it to a 14x9px colour
   swatch, which squashed these chips to 16px and drew the labels on top of their own descriptions. */
.ccode{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin:2px 0 14px;padding:10px 13px;
  border:1px solid var(--rule);border-radius:10px;background:var(--tint2)}
.ccode > b{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--slate)}
.ccode .lg{display:inline-flex;align-items:baseline;gap:7px}
.ccode .lg i{font-style:normal;flex:0 0 auto}
.ccode .lg em{font-style:normal;font-size:11.5px;color:var(--ink2)}
@media(max-width:640px){.ccode .lg em{display:none}}
.prog{display:flex;align-items:center;gap:10px;margin:2px 0 12px;font-size:12px;color:var(--slate)}
/* Called .track, not .bar. The timeline already owns .bar and styles it position:absolute, left:2px,
   right:2px — which quietly stretched this one across the whole card as an invisible hairline. */
.prog .track{flex:0 0 210px;max-width:45%;height:8px;border-radius:99px;background:var(--tint);
  overflow:hidden;border:1px solid var(--rule);box-shadow:inset 0 1px 2px rgba(20,24,29,.08)}
.prog .track i{display:block;height:100%;border-radius:99px;
  background:linear-gradient(90deg,var(--orange),#f0a052);box-shadow:0 0 8px 1px var(--glow-wide)}
.filters .btn.primary{box-shadow:0 0 0 3px var(--glow-wide), var(--lift)}
.filters button{padding:5px 11px;border:1px solid var(--rule);background:var(--paper);border-radius:20px;
  cursor:pointer;font-size:12px;color:var(--slate)}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}

/* ---------------- map */
.maptools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.mapstage{position:relative;background:var(--paper);border:1px solid var(--rule);border-radius:12px;
  overflow:hidden;touch-action:none}
.mapinner{position:relative;transform-origin:0 0;will-change:transform}
.mapinner img{display:block;width:100%;height:auto;user-select:none;-webkit-user-drag:none}
/* The visible dot stays small so the drawing underneath stays readable, but the thing a finger has to hit is
   the ::after box: 26px on a mouse, 44px on a touch screen. WCAG 2.2 wants 24px minimum and a thumb wants 44. */
/* A pill, not a 19px circle with 9px text. The markers used to sit inside the scaled map, so zooming out to
   see the whole circuit shrank them to about 10px with the ID unreadable — which is the zoom everyone starts
   at. --z is the map zoom; scale(1 / var(--z)) holds the marker at the same size on screen whatever the map is
   doing, and --k is the hover/selected growth composed into the same transform. */
.mk{--k:1;position:absolute;transform:translate(-50%,-50%) rotate(calc(-1 * var(--rot, 0deg))) scale(calc(var(--k) / var(--z, 1)));
  min-width:24px;height:24px;padding:0 6px;border-radius:12px;
  border:1.5px solid #fff;background:#a8520d;box-shadow:0 1px 4px rgba(0,0,0,.5);cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;
  letter-spacing:.02em;line-height:1;overflow:visible;white-space:nowrap;
  text-shadow:0 1px 1px rgba(0,0,0,.55);
  transition:box-shadow .18s ease, transform .18s ease}
/* an unlinked callout — the drawing's number with nothing on the schedule behind it — reads quieter */
.mk.co{background:#5a4a40;font-weight:700}
/* On a phone the whole circuit fits in 390px and the compound's forty callouts land on one thumbnail. A
   slightly smaller pill there is still readable and piles up less; pinch-zoom separates them properly, which
   it could not before, because the pills grew with the map. The 44px hit box is untouched. */
@media(max-width:640px){.mk{min-width:20px;height:20px;padding:0 4px;font-size:9.5px;border-radius:10px}}
/* Touch feedback. :hover never fires reliably on a phone, so :active carries it and .on holds it for the
   marker whose panel is open. The halo is drawn with box-shadow rather than filter — a filter on 233 markers
   makes an older phone crawl. */
.mk:hover, .mk:active, .mk.sel{--k:1.18;
  box-shadow:0 0 0 3px var(--glow), 0 0 18px 6px var(--glow-wide), 0 2px 6px rgba(0,0,0,.5); z-index:8}
.mk.sel{animation:mkpulse 2.4s ease-in-out infinite}
@keyframes mkpulse{
  0%,100%{box-shadow:0 0 0 3px var(--glow), 0 0 16px 5px var(--glow-wide), 0 2px 6px rgba(0,0,0,.5)}
  50%    {box-shadow:0 0 0 5px var(--glow), 0 0 26px 9px var(--glow-wide), 0 2px 6px rgba(0,0,0,.5)}}
@media (prefers-reduced-motion:reduce){
  .mk{transition:none} .mk.sel{animation:none}
  .mk:hover,.mk:active,.mk.sel{--k:1}}
.mk::after{content:'';position:absolute;left:50%;top:50%;width:26px;height:26px;
  transform:translate(-50%,-50%);border-radius:50%}
@media (pointer:coarse){.mk::after{width:44px;height:44px}}
.mk:focus-visible{outline:3px solid #0b63c5;outline-offset:2px;z-index:7}
/* a destination somebody has typed over, with nobody yet confirming where it now is */
.mk.movedloc{box-shadow:0 0 0 2px #fff, 0 0 0 5px #7c3aed, 0 1px 5px rgba(0,0,0,.4)}
.mk.movedloc::after{content:'?';position:absolute;right:-7px;top:-7px;width:15px;height:15px;border-radius:50%;
  background:#7c3aed;color:#fff;font:800 11px/15px system-ui,sans-serif;text-align:center;
  box-shadow:0 0 0 1.5px #fff}
.mk.note{background:var(--navy);min-width:13px;width:13px;height:13px;padding:0;font-size:0;border-radius:50%}
.mk.dim{opacity:.18}
.mk.hit{background:#0d7a3f;box-shadow:0 0 0 4px rgba(13,122,63,.35),0 1px 4px rgba(0,0,0,.5);z-index:5}
/* The marker whose panel is open. It used to go red, which collided with red meaning "critical" everywhere
   else on this page — a marker you had merely clicked looked like a marker with a problem. It keeps its own
   colour and is picked out by the glow and the size instead. The background is unchanged so the white label
   keeps the contrast the a11y test measured. */
.mk.sel{z-index:6}
.zoomctl{position:absolute;right:10px;bottom:10px;display:flex;flex-direction:column;gap:4px;z-index:8}
.zoomctl button{width:44px;height:44px;border-radius:8px;border:1px solid var(--rule);background:var(--paper);
  cursor:pointer;font-size:17px;line-height:1;box-shadow:var(--shadow)}
/* v5.83 — THE DRAWING TURNS. Andrew Fisher, 25 Sep 2026: every map can be spun round. The drawing turns about the
   middle of the stage (two fingers twist it on a phone, Shift and the wheel on a laptop, or these buttons); the
   markers turn back the other way so their words stay upright, and N puts north at the top. */
.maprot{position:relative;transform-origin:50% 50%;will-change:transform}
.rotctl{position:absolute;left:10px;bottom:10px;display:flex;gap:4px;z-index:8}
.rotctl button{width:44px;height:44px;border-radius:8px;border:1px solid var(--rule);background:var(--paper);
  cursor:pointer;font-size:17px;line-height:1;box-shadow:var(--shadow)}
.rotctl button[disabled]{opacity:.45;cursor:default}
.rotctl .rotn{display:inline-block;font-weight:800;font-size:13px;transition:transform .18s ease}
.rotctl .rotn::before{content:'';display:block;width:0;height:0;margin:0 auto 1px;border-left:5px solid transparent;
  border-right:5px solid transparent;border-bottom:8px solid var(--brand, #e8641b)}
.maphint{font-size:11.5px;color:var(--mute);margin-top:8px;line-height:1.45}

/* ---------------- drawer */
.scrim{position:fixed;inset:0;background:rgba(20,24,29,.42);opacity:0;pointer-events:none;transition:opacity .16s;z-index:20}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(460px,100%);background:var(--paper);z-index:21;
  transform:translateX(102%);transition:transform .2s ease;display:flex;flex-direction:column;box-shadow:var(--shadow)}
.drawer.on{transform:none}
.drawer .dh{padding:14px 16px;border-bottom:1px solid var(--rule);display:flex;justify-content:space-between;gap:10px}
.drawer .dh h2{margin:0;font-size:18px;display:flex;min-width:0}
.drawer .dh .sub{color:var(--slate);font-size:12.5px;margin-top:2px}
.drawer .db{overflow:auto;padding:14px 16px;flex:1}
.drawer .df{padding:10px 16px;border-top:1px solid var(--rule);display:flex;gap:8px;flex-wrap:wrap}
.drawer .df a.btn{text-decoration:none;display:inline-flex;align-items:center}
/* v5.49 — the race photographs. A strip, the whole picture inside it, and nothing over or under it. No
   transition and no transform anywhere in here on purpose: Andrew Fisher asked for these to be static. */
.rbhero{margin:0 0 12px;padding:0}
.rbwin{position:relative;width:100%;overflow:hidden;border-radius:14px;background:#0d0c0b;
  box-shadow:0 1px 2px rgba(0,0,0,.18),0 8px 26px rgba(0,0,0,.16)}
.rbwin img{display:block;width:100%;height:auto}
.rbcap{display:flex;gap:6px;align-items:baseline;padding:7px 2px 0;font-size:11.5px;letter-spacing:.04em;
  text-transform:uppercase;font-weight:700;color:var(--mute)}
.rbcap span{font-weight:600;letter-spacing:.02em;text-transform:none;opacity:.78}
@media print{.rbwin{box-shadow:none;border-radius:0}}
.pgban{margin:0 0 14px}
.pgban .rbwin{aspect-ratio:3/1;border-radius:12px;background:#202326}
.pgban .rbwin img{width:100%;height:100%;object-fit:cover;object-position:50% 50%}
.pgban .rbcap{flex-wrap:wrap;row-gap:1px}
@media (max-width:640px){.pgban .rbwin{aspect-ratio:5/2}.pgban{margin-bottom:10px}}
/* the phone's folds (foldForPhone): one line, the page's own words, a chevron; open, the block is exactly itself */
details.pfold{margin:0 0 10px;border:1px solid var(--rule);border-radius:10px 0 10px 0;background:var(--paper)}
details.pfold > summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;padding:10px 12px;font-size:13px;font-weight:600;color:var(--ink)}
details.pfold > summary::-webkit-details-marker{display:none}
/* v5.81 — THE STORIES FOLD, ON EVERY SCREEN (management feedback through Andrew Fisher, 24 Sep 2026: the
   stories in every section were too much information — take them out, or fold them into a drop-down to
   open for the detail). Every long explanatory paragraph inside a card goes under one small Details fold at the card's
   foot, closed until pressed; short status lines stay on the face of the card. Nothing is removed. */
details.sfold{margin:8px 0 0;padding:0;border-top:1px dashed var(--rule);max-width:100%;min-width:0}
details.sfold > summary{list-style:none;cursor:pointer;display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding:6px 0 2px;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);max-width:100%;min-width:0;overflow-wrap:anywhere}
details.sfold > summary::-webkit-details-marker{display:none}
details.sfold > summary::after{content:'';flex:none;width:6px;height:6px;border-right:1.5px solid var(--mute);border-bottom:1.5px solid var(--mute);transform:rotate(-45deg);transition:transform .15s}
details.sfold[open] > summary::after{transform:rotate(45deg)}
details.sfold > summary:hover{color:var(--ink)}
details.sfold > .sfoldbody{padding:4px 0 2px}
details.sfold > .sfoldbody > *{margin-top:6px}
@media print{details.sfold{display:none}}
details.pfold > summary .pfw{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
details.pfold > summary .pfh{width:8px;height:8px;border-right:2px solid var(--mute);border-bottom:2px solid var(--mute);transform:rotate(45deg);margin-right:4px;transition:transform .15s}
details.pfold[open] > summary .pfh{transform:rotate(-135deg);margin-top:4px}
details.pfold[open] > summary{border-bottom:1px solid var(--rule)}
details.pfold > .notice, details.pfold > .card{margin:0!important;border:0;border-radius:0 0 10px 0;box-shadow:none}
details.pfold > summary:focus-visible{outline:2px solid var(--orange);outline-offset:-2px}
/* THE MAP'S BANNER SITS UNDER THE DRAWING, NOT OVER IT. The Sep 2026 audit's rule (tests/test_audit_fixes.py):
   a phone on site opens the drawing and sees it without scrolling, and a laptop sees the crowded spots the tap
   test walks. A 3:1 picture above the stage cost the first screen 400 px on a laptop and 220 on a phone, so on
   the Map page alone the banner is drawn after the map card — the drawing is the point of that page. */
.pgban[data-banner="map"]{margin:14px 0 0}
@media print{.pgban{display:none}}
/* v5.49 — a recorded position wears a ring, never the callout's pill: one is the drawing, the other is what
   somebody stood on, and they must never be read as the same thing. */
.mk.gpsmk{background:transparent;border:0;box-shadow:none;padding:0;min-width:0;width:26px;height:26px;z-index:6}
.mk.gpsmk .gpsu{position:absolute;left:50%;top:100%;transform:translate(-50%,1px);font:700 8.5px/1.1 var(--mono,ui-monospace,monospace);
  color:#fff;background:#1d5fc4;padding:1px 3px;border-radius:3px;white-space:nowrap;letter-spacing:.02em}
.satboard{position:relative;width:100%;height:min(72vh,680px);min-height:320px;border-radius:8px;overflow:hidden;background:#0e1216;margin-top:8px}
/* v5.80 — the 3D board: Cesium's own widget inside the same frame; its credits stay readable on the dark ground */
.satfly{height:min(56vw,420px);min-height:260px;position:relative}.satfly gmp-map-3d{position:absolute;inset:0;width:100%;height:100%;display:block}
.satsv img{width:100%;height:auto;display:block;border-radius:8px}
.fviews{margin:10px 0 12px}
.fvhead{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px}
.fvwords small{display:block;color:var(--mute);font-size:11.5px;line-height:1.4}
.fvtabs{display:flex;gap:6px;margin-left:auto;flex-wrap:wrap}
.fvtabs button{min-height:40px;padding:0 14px;border-radius:8px;border:1px solid var(--rule);background:var(--paper);cursor:pointer;font:inherit;font-weight:600}
.fvtabs button[aria-selected=true]{background:#1b1f23;color:#fff;border-color:#1b1f23}
.fvbox{position:relative;min-height:120px}
.fvbox .satboard{height:min(60vw,420px);min-height:260px}
/* v5.86 - the found spot glows in every view: a ring that breathes out from the point, on the aerial crop and on the
   satellite marker; the pictures grid; a greyed tab that says what it needs */
.fvpulse{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;pointer-events:none;z-index:4;box-sizing:border-box;
  border:3px solid var(--orange);box-shadow:0 0 0 2px #fff,0 0 18px 4px rgba(255,106,19,.55);animation:fvPulse 1.6s ease-out infinite}
.fvpulse::after{content:"";position:absolute;inset:-3px;border-radius:50%;border:2px solid rgba(255,106,19,.9);animation:fvPulseRing 1.6s ease-out infinite}
@keyframes fvPulse{50%{box-shadow:0 0 0 2px #fff,0 0 28px 10px rgba(255,106,19,.75)}}
@keyframes fvPulseRing{0%{transform:scale(1);opacity:.9}100%{transform:scale(3.2);opacity:0}}
.fvmk{position:relative;width:26px;height:26px}
.fvmk b{position:absolute;left:50%;top:50%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:var(--mkc,#e8641b);border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.5)}
.fvmk .fvpulse{border-color:var(--mkc,#e8641b)}
.fvmk .fvpulse::after{border-color:var(--mkc,#e8641b)}
.fvpics{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-top:8px}
.fvpic{margin:0;border:1px solid var(--rule);border-radius:8px;overflow:hidden;background:var(--tint2)}
.fvpic img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
.fvpic figcaption{padding:6px 8px;font-size:11.5px;line-height:1.4;color:var(--ink2)}
.fvnav{display:inline-flex}
.fvtabs button:disabled{opacity:.45;cursor:not-allowed}
.fvtabs button small{font-weight:600;opacity:.75;margin-left:2px}
.fvaer{height:min(60vw,420px);min-height:260px;border-radius:8px;margin-top:8px}
@media (prefers-reduced-motion:reduce){.fvpulse,.fvpulse::after{animation:none}}
.svpano{position:relative}
.fvnote{margin:8px 0 10px}
.sat3d .cesium-viewer{width:100%;height:100%}.sat3d .cesium-widget-credits{font-size:11px;color:#dfe3e6}.sat3d .cesium-viewer-bottom{background:rgba(0,0,0,.35)}
.satboard .livenote{position:absolute;left:12px;right:12px;top:12px;bottom:auto}
.satboard .mapboxgl-popup-content{font:13px/1.45 inherit;color:#111;padding:10px 12px;border-radius:8px}
.satboard .mapboxgl-popup-content .btn{margin-top:6px}
.sheetbtn.satbtn{border-color:#1d5fc4;color:#1d5fc4}
.sheetbtn.satbtn.primary{background:#1d5fc4;border-color:#1d5fc4;color:#fff}
@media print{.satboard{display:none!important}}
.givenblock{margin:0 14px 12px;padding:10px 12px;border:1px dashed var(--rule);border-radius:10px;background:var(--tint2)}
.givenblock.on{border-style:solid}
.givenblock .sect{margin:0 0 4px}
.givenblock .sub{margin:0 0 8px}
.day.blank .dface{opacity:.78}
.day.blank .dfig.dnone{display:flex;align-items:center;min-height:34px}
.day.blank .dq{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);font-weight:600}
.day.weekend .dow{color:var(--orange-ink)}
.day.holiday .dhead .dow::after{content:' · HOLIDAY';font-size:9px;letter-spacing:.08em;color:var(--orange-ink)}
.dchip.hol{background:#fff3e8;color:#9a3d05;border:1px solid #f3c9a4}
.dchip.mv{background:#e3edfb;color:#1d5fc4;border:1px solid #b9d0f5}
.candread{margin-top:6px;padding:7px 9px;border:1px dashed var(--rule);border-radius:8px;background:var(--tint2);font-size:12px;line-height:1.5}
.cw4open td{font-size:12.5px;vertical-align:top}
.movedoff .mvlist{margin:4px 0 0;padding-left:0;list-style:none;display:grid;gap:6px}
.movedoff .mvlist li{font-size:12.5px;line-height:1.5;padding:8px 10px;border:1px solid var(--rule);border-radius:8px;background:var(--tint2)}
.movedoff .mvlist .w{color:var(--mute)}
.roadscard .roads{margin:6px 0 0;padding-left:0;list-style:none;display:grid;gap:8px}
.roadscard .roads li{font-size:12.5px;line-height:1.5;padding:8px 10px;border:1px solid var(--rule);border-radius:8px;background:var(--tint2)}
.roadscard .roads .w{color:var(--mute)}
.navbtn .navpinned,.btn .navpinned{margin-left:5px;font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  color:#1d5fc4;background:#e3edfb;padding:1px 5px;border-radius:3px;vertical-align:1px}
.navbtn.primary .navpinned{color:#fff;background:rgba(255,255,255,.22)}
.pinblock{margin:0 14px 12px;padding:10px 12px 8px;border:1px solid var(--rule);border-radius:10px;background:var(--tint2)}
.pinblock .sect{margin:0 0 4px}
.pinblock .sub{margin:0 0 8px}
.pinrow{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:flex-start;padding:8px 0;border-top:1px solid var(--rule2)}
.pinrow .pinwho{flex:0 0 150px;display:grid;gap:1px}
.pinrow .pinwho .w{font-size:11.5px;color:var(--mute)}
.pinrow .pinwhat{flex:1 1 220px;display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center;font-size:12.5px}
.pinrow .pinby{flex-basis:100%;font-size:11.5px;color:var(--mute)}
.pinrow .pinacts{display:flex;flex-wrap:wrap;gap:6px;flex-basis:100%}
.pinrow.on .pinwho b::after{content:' \25CE';color:#1d5fc4}
/* v5.55 — a placed position is never the same mark as a stood-at one, anywhere on the page */
.pinrow.on.placed .pinwho b::after{content:' \25CB';color:#8a5a00}
.placeform{flex-basis:100%;display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:6px;
  padding:8px;border:1px dashed var(--rule);border-radius:7px}
.placeform input{font:inherit;font-size:12.5px;padding:5px 7px;border:1px solid var(--rule);border-radius:5px;background:var(--bg)}
.placeform .pfll{flex:1 1 200px;font-family:Consolas,monospace}
.placeform .pfhow{flex:1 1 200px}
.placeform .w{flex-basis:100%;color:var(--mute);font-size:11.5px}
@media (max-width:640px){.pinrow .pinwho{flex-basis:100%}}
@media print{.pinblock .pinbtn,.pinblock .pinoff,.pinblock .pinacts a{display:none!important}}
.mk.gpsmk .gpsx{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;
  border:2.5px solid #1668d6;background:rgba(22,104,214,.16);color:#1668d6;font-style:normal;font-size:13px;line-height:1;
  box-shadow:0 0 0 2px #fff,0 2px 6px rgba(0,0,0,.35)}
/* v5.54 — the way in, never the same mark as a position: a truck turning off the street is not where the
   thing stands, and a driver reading one as the other ends up in the wrong place. */
.mk.gpsmk.way .gpsx{border-color:#0a8f5b;background:rgba(10,143,91,.16);color:#0a8f5b}
.mk.gpsmk.put .gpsx{border-color:#8a5a00;background:transparent;border-style:dashed;color:#8a5a00}
@media (prefers-color-scheme:dark){.mk.gpsmk.way .gpsx{border-color:#3fd39a;color:#3fd39a}}
@media (prefers-color-scheme:dark){.mk.gpsmk.put .gpsx{border-color:#f0c67a;color:#f0c67a}}
@media (prefers-color-scheme:dark){.mk.gpsmk .gpsx{border-color:#5aa9ff;color:#5aa9ff;box-shadow:0 0 0 2px #1a1614,0 2px 6px rgba(0,0,0,.6)}}
.dnav{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:-4px 0 10px;font-size:12px;color:var(--mute)}
.dnav .btn{padding:5px 10px;font-size:12px}
.daynav a.btn{text-decoration:none;display:inline-flex;align-items:center}
.close{border:0;background:none;font-size:22px;line-height:1;cursor:pointer;color:var(--mute);padding:0 4px}
dl.kv{margin:0 0 12px;display:grid;grid-template-columns:112px 1fr;gap:5px 10px;font-size:13px}
dl.kv dt{color:var(--slate);font-size:11px;text-transform:uppercase;letter-spacing:.06em;font-weight:600;padding-top:2px}
dl.kv dd{margin:0}
.sect{margin:14px 0 6px;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--slate);
  font-weight:700;border-bottom:1px solid var(--rule);padding-bottom:4px}
.acc{display:flex;justify-content:space-between;gap:8px;padding:6px 0;border-bottom:1px solid var(--rule2);font-size:13px}
/* the right-hand end of an accessory line: its asset number and the way to take it off, together, wrapping to
   their own line on a phone-width drawer rather than squeezing the number */
.acc .accr{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;flex-shrink:0}
/* taken off, and still readable — nothing is rubbed out, so what the schedule asked for can always be read
   against what this reference has actually got */
.accoff{margin-top:10px;padding-top:8px;border-top:1px dashed var(--rule)}
.accoff .lbl{margin:0 0 4px;font-size:12px;color:var(--mute)}
.acc.off{opacity:.72}
.acc.off b{text-decoration:line-through}
.acc.gone b{text-decoration:none;color:var(--mute)}
.acc .w{color:var(--mute);font-size:11.5px}
.ev{padding:6px 0;border-bottom:1px solid var(--rule2);font-size:12.5px;display:flex;gap:8px;justify-content:space-between}

/* ---------------- forms */
.form{display:grid;gap:10px;max-width:620px}
.f{display:grid;gap:4px}
.f label{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--slate);font-weight:600}
.f input,.f select,.f textarea{padding:8px 10px;border:1px solid var(--rule);border-radius:8px;background:var(--tint2);outline:none;width:100%}
.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--orange);background:var(--paper)}
.f .hint{font-size:11.5px;color:var(--mute)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
input.rate{width:110px;text-align:right;padding:5px 8px;border:1px solid var(--rule);border-radius:6px;background:var(--tint2)}
input.rate:focus{border-color:var(--orange);background:var(--paper)}
.norate{color:var(--mute);font-style:italic;font-size:12px}
/* V11 audit: preflight's verdict, when it is not Ready. Never printed — it exists to stop a print. */
.printask{position:fixed;inset:0;z-index:300;background:rgba(10,8,6,.55);display:flex;align-items:center;justify-content:center;padding:16px}
.printask-box{background:var(--paper);color:var(--ink);border:1px solid var(--rule);border-radius:14px 0 14px 0;
  box-shadow:var(--lift-hi);padding:20px 22px;max-width:min(520px, 100%);max-height:80vh;overflow:auto}
.printask-box h3{margin:0 0 10px;font-size:18px}
.printask-box p{margin:0 0 8px;font-size:13.5px;line-height:1.5}
.printask-box .w{color:var(--mute);font-size:12.5px}
.printask-acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
@media print{ .printask{display:none!important} }
/* Navigate: a real button, the size of a thumb, in the orange the page uses for the thing to press */
/* the drawer's action row: Navigate, Send to a phone and Close. It wraps rather than pushing Close off the
   edge — on a Galaxy Fold opened, the three of them are wider than the drawer. */
.dhacts{display:flex;gap:6px;align-items:flex-start;flex-wrap:wrap;justify-content:flex-end;min-width:0}
.dhacts .close{order:-1;margin-left:auto}
@media(min-width:721px){ .dhacts{flex-wrap:nowrap} .dhacts .close{order:0;margin-left:0} }
.navbtn{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.navbtn svg{flex:0 0 auto;opacity:.9}
.navbtn.sm{padding:5px 10px;font-size:12px;min-height:32px}
@media(pointer:coarse){ .navbtn{min-height:40px} .navbtn.sm{min-height:36px} }
.navbtn::after{content:'\2197';font-size:11px;opacity:.65;margin-left:1px}
/* and what it says when there is nowhere honest to send anybody */
.navno{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:8px;
  border:1px dashed var(--rule);color:var(--mute);font-size:11.5px;white-space:nowrap;cursor:help}
.navno svg{opacity:.6}
@media print{ .navbtn, .navno{display:none!important} }

/* F10: the scope every count on this bar was taken over, beside the counts and never only in a tooltip */
.lfscope{font-size:11px;color:var(--mute);align-self:center;margin-left:4px;white-space:nowrap}
@media(max-width:640px){ .lfscope{white-space:normal;flex:1 1 100%;margin:2px 0 0} }
/* F06: a priced line whose dimensions are unresolved. The scenario sits UNDER the subtotal cell, in the muted
   tone, so nobody reads it as an amount in the column. */
.unres{margin-top:4px;font-size:11px;line-height:1.35;color:var(--sem-stop-ink, var(--mute));font-variant-numeric:tabular-nums}

/* ---------------- sending a text. The count under the box is the count that gets charged, so it is given the
   weight of a figure rather than a footnote, and anything that doubles the bill is said in red before the send. */
.smswho{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.smswho .chip{cursor:pointer;white-space:normal;text-align:left}
.smswho .chip[aria-pressed="true"]{background:var(--orange-ink);border-color:var(--orange-ink);color:#fff}
#smsCount{line-height:1.6}
#smsCount .warn{color:var(--red);background:none;border:0}
#smsCount .warn .btn.tiny{margin-left:4px}
.smslog{list-style:none;margin:10px 0 0;padding:0;font-size:12.5px}
.smslog li{padding:6px 0;border-top:1px solid var(--rule)}
.smslog .meta{color:var(--mute)}
/* a file name or a code longer than a phone is wide breaks rather than pushing the card sideways */
.card p, .card .sub, .notice, .hint, .kv dd{overflow-wrap:anywhere}

/* ---------------- timeline: the week-by-week Gantt this used to be is gone; the per-day view has its own
   rules under "the per-day timeline" above. A small legend swatch is all that is shared. */
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--slate);margin-top:8px;align-items:center}
.legend i{display:inline-block;width:14px;height:9px;border-radius:2px;margin-right:5px;vertical-align:0}
.legend .tl i{width:12px;height:12px;border-radius:50%;margin-right:0}

.empty{padding:30px;text-align:center;color:var(--mute);font-size:13px}
footer.foot{padding:10px 16px;border-top:1px solid var(--rule);background:var(--paper);font-size:11px;
  color:var(--mute);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;flex:0 0 auto}
/* v5.84 — WHAT A VIEW LINK DOES NOT SHOW. Hiding a control was already a courtesy and refusing the change the
   rule (mayWrite); but the day's own screen still carried "Put your name in Recording as", Your records with
   Export and Import, the Edit card and the day view's Add an asset, on a link that cannot change anything. A
   thing that only writes carries .editonly and goes with the body's viewonly class, so a link the service
   turns read-only after the render loses them too. The Tools menu's name field goes the same way. */
body.viewonly .editonly{display:none!important}
/* v5.86 - what belongs to a page that has been set aside (TABS_OFF) */
.tabsoff{display:none!important}
body.viewonly #moreMenu .who, body.viewonly #moreMenu .mmsec:first-child{display:none}
/* v5.84 — the phone: two lines of footer, not four; the tab's dot off the glyph; a thumb-sized button */
@media(max-width:640px){
  footer.foot{font-size:10px;padding:5px 12px;gap:1px 8px;line-height:1.3}
  footer.foot span{flex:1 1 100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
  nav.tabs .dot{top:2px;right:calc(50% - 19px)}
  #pane-today .btn, .hubsheets .btn{min-height:40px}
}
/* ---------------- BREAKPOINT OVERRIDES START HERE
   V11 audit: the 641-900px block below used to sit ABOVE the base rules it was meant to beat, so the base
   `.search{flex:1 1 260px;min-width:0}` — same specificity, later in the file — quietly won. The search still
   measured wide enough on a Fold, but by the base rule's 260px basis rather than by anything this block said,
   which is a layout that works until somebody edits the base rule. Every width-conditional rule for the shell
   now comes after every base rule for it, widest first. */
/* ---------------- the in-between widths: a Galaxy Fold opened, a small tablet, a split window
   Andrew Fisher, 15 Sep 2026: that was the view on a Samsung Fold. Unfolded, that screen is about 690 CSS px —
   past the 640px phone rules, so the full bar applies, but there is not room in it for the company line, the
   dates, a search box, the record's words, More and the clock all at once. The search was getting 110px of it
   and reading "Search a refere".

   So between 641 and 900 the bar keeps what a person came to use — the search — and gives up what is said
   elsewhere on the page: the company line and the event dates are in the footer, on the About tab and on every
   printed sheet, and the record's words are in the footer and in the strip's own tooltip. The Fold changes
   width the moment it opens, and these rules follow it without a reload. */
@media (max-width:900px){
  /* THE DAY'S TABLE BECOMES A LIST OF CARDS ON A PHONE.

     Andrew Fisher, 15 Sep 2026, from the Timeline on his phone: he could not see what each row was.
     He is looking at DUE IN (16) and every row shows a traffic light, "On site", a Complete chip and a tick —
     and nothing whatever that says which asset it is.

     Eight columns in a 640px-minimum table inside a sideways scroller, with the FIRST column pinned open. The
     first column is Light. The comment on that sticky rule says "the ID is the thing you need" — and the ID is
     the third column, 292 px off the left edge of a 412 px screen, behind a scroll nobody can see is there.

     A table that has to be scrolled sideways to find out what a row is about is not a table on a phone. So at
     this width every row becomes a card: the reference and its asset numbers first, what it is under that,
     then its light, its times, where it goes and what the schedule says, and the buttons at the bottom. No
     column is dropped and no figure is hidden — they are reordered with `order`, so the document still reads
     in table order for a screen reader, for the tests, and for every wider screen. Nothing scrolls sideways
     at all. */
  .tblwrap.daywrap{overflow-x:visible}
  .daywrap table.daytbl{display:block;min-width:0}
  .daywrap table.daytbl thead{display:none}
  .daywrap table.daytbl tbody{display:block}
  .daywrap table.daytbl tbody tr{display:flex;flex-direction:column;gap:7px;padding:12px 13px 13px;
    border-bottom:1px solid var(--rule)}
  .daywrap table.daytbl tbody tr:last-child{border-bottom:0}
  .daywrap table.daytbl td{display:block;border:0;padding:0}
  /* the sticky first column is a wide-screen device and has nothing to be sticky against here */
  .tblwrap.daywrap table.daytbl td:first-child{position:static;box-shadow:none}
  .daywrap table.daytbl td::before{content:attr(data-label);display:block;
    font:700 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.09em;text-transform:uppercase;
    color:var(--slate);margin-bottom:3px}
  /* four of them say what they are without being told: the plate, the product, the light and the buttons */
  .daywrap table.daytbl td.refcell::before,
  .daywrap table.daytbl td[data-label="What"]::before,
  .daywrap table.daytbl td[data-label="Light"]::before,
  .daywrap table.daytbl td[data-label="Actions"]::before{display:none}
  .daywrap table.daytbl td.refcell{order:1}
  .daywrap table.daytbl td[data-label="What"]{order:2}
  .daywrap table.daytbl td[data-label="Light"]{order:3}
  .daywrap table.daytbl td.t{order:4}
  .daywrap table.daytbl td[data-label="Where"]{order:5}
  .daywrap table.daytbl td.num{order:6}
  .daywrap table.daytbl td[data-label="Schedule says"]{order:7}
  .daywrap table.daytbl td[data-label="Actions"]{order:8}
  /* the quantity is one number — it reads across from its label rather than under it */
  .daywrap table.daytbl td.num{text-align:left;display:flex;align-items:baseline;gap:7px}
  .daywrap table.daytbl td.num::before{margin-bottom:0}
  /* the two time boxes side by side rather than stacked: they are short and they belong together */
  .daywrap table.daytbl td.t{display:flex;flex-wrap:wrap;align-items:flex-start;gap:6px 10px}
  .daywrap table.daytbl td.t::before{flex:0 0 100%}
  .daywrap table.daytbl td.t .mv{margin-top:0}
  .daywrap table.daytbl .acts button{padding:7px 12px;font-size:13px}
  /* the unreferenced-rows table has its own six columns; the row id and the button are what matter on a phone */
  .daywrap table.unreftbl td[data-label="Row"]{order:1}
  .daywrap table.unreftbl td[data-label="What"]{order:2}
  .daywrap table.unreftbl td[data-label="Where"]{order:3}
  .daywrap table.unreftbl td.num{order:4}
  .daywrap table.unreftbl td[data-label="Schedule says"]{order:5}
  .daywrap table.unreftbl td[data-label="Action"]{order:6}
  .daywrap table.unreftbl td[data-label="Row"]::before,
  .daywrap table.unreftbl td[data-label="What"]::before,
  .daywrap table.unreftbl td[data-label="Action"]::before{display:none}
  /* the detail row that hangs under a schedule row is a full-width block, not a labelled field */
  .daywrap table.daytbl tr.ohrow{padding:0 13px 12px}
  .daywrap table.daytbl tr.ohrow td::before{display:none}
}
@media(min-width:641px) and (max-width:900px){
  .hbar{gap:10px}
  #bOrg{display:none}
  .wordmark .when{display:none}
  .wordmark .chq{display:none}
  .lockup{gap:8px;flex:0 0 auto}
  .search{flex:1 1 auto;min-width:180px}
  .recstrip{max-width:none;padding:0 2px;border:0;background:none;gap:0;flex:0 0 auto}
  .recstrip .rsw{display:none}
  .recstrip .rsdot{width:10px;height:10px}
  header.top .btn{padding:7px 11px;font-size:12.5px}
  /* The drawer behaves the same way at both hinge states. A Fold that opens should not change how the record
     scrolls — the panel is 460px wide here instead of the full screen, but the header is still the tallest
     fixed thing in it and the eight actions still wrap to three rows, so the same single-scroller rule applies
     and the reading area goes from 520px to about 670. */
  .drawer{display:block;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
  .drawer .dh{position:sticky;top:0;z-index:3;background:var(--paper)}
  .drawer .db{overflow:visible;flex:none}
  .drawer .df{position:static;border-top:1px solid var(--rule)}
}
@media(max-width:640px){
  main{padding:10px}
  /* One mobile block, not two. A second @media further up the file was quietly losing every rule it shared
     with this one, which is how the header stayed 187px tall on a phone while the CSS said otherwise. */
  /* THE PHONE BAR — 60px, one row, never two.
     Superior Audit, 15 Sep 2026: this bar measured 183px on a 390px phone, so the map stage started a third of
     the way down the screen. It now carries the lockup, the clock and More, and nothing else. Search opens over
     the bar when asked for (the magnifier, the / key, or a search already in progress); the record strip drops
     to its dot, with the words in its title and in the footer, which already says all of it in full. */
  .brandrow{padding:0 10px;gap:8px}
  .hbar{height:60px;min-height:60px}
  /* On a phone the lockup is the orange mark and GC500 2026 — the words everybody on site uses. The full
     company line is in the footer, the About tab and every printed sheet, and it does not need 190px of a
     390px bar to say it again. */
  .lockup{flex:0 1 auto;min-width:0;gap:8px;overflow:hidden}
  #bOrg{display:none}
  /* the dates run under the search button at this width; they are on the About tab, in the footer and on every
     printed sheet, and the bar does not need to say them a fourth time */
  .wordmark .when{display:none}
  .brandtxt span{font-size:10px}
  .mark{height:24px;width:4px}
  .wordmark{margin-top:0;gap:5px}
  .wordmark .yr{font-size:10px}
  .search{position:absolute;left:8px;right:8px;top:8px;z-index:65;display:none;flex:0 0 auto;min-width:0}
  body.search-open .search{display:block}
  body.search-open .lockup, body.search-open .recstrip, body.search-open .tpodwrap{display:none}
  .tools{margin-left:auto;position:relative;flex:0 0 auto}
  .recstrip{max-width:none;padding:0;border:0;background:none;gap:0}
  .recstrip .rsw{display:none}
  .recstrip .rsdot{width:9px;height:9px}
  .hmore{gap:4px}
  .phoneonly{display:inline-flex!important;min-width:40px;justify-content:center;font-size:16px;line-height:1;padding:6px 9px}
  .who input{width:100%}
  header.top .btn{padding:7px 11px;font-size:12.5px}
  /* the phone's tab bar is styled with the nav row's own rules (glyph over word, 23 Sep 2026) */
  dl.kv{grid-template-columns:96px 1fr}
  .row2{grid-template-columns:1fr}
  /* THE DRAWER ON A PHONE — ONE SCROLL CONTAINER, NOT THREE BANDS.

     Andrew Fisher, 15 Sep 2026: too little room to scroll on the Timeline when opening what is coming in.

     He is right and the numbers are ugly. On his phone the drawer was a fixed header, a scrolling middle and a
     fixed footer. The header carried the plate, the delivery light, the name, two buttons and five precision
     tags that stack one to a row at this width — about 420 CSS px. The footer carried eight actions, which wrap
     to three rows — about 165. On a ~740px screen that left roughly 150px to read the record in, and no amount
     of scrolling made it bigger, because both bands were pinned.

     Two changes. The tags moved into the body (see openAsset) so they scroll away once read. And at this width
     the drawer becomes a single scroller: the header stays stuck to the top, because the reference, its light,
     Navigate and Close are what a person needs at any moment; the eight send-and-print actions ride at the
     bottom of the content, where they belong — the X in the header is always there to get out with.

     The reading area goes from about 150px to about 565. */
  .drawer{display:block;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
  .drawer .dh{position:sticky;top:0;z-index:3;background:var(--paper);padding:10px 14px}
  .drawer .db{overflow:visible;flex:none;padding:12px 14px}
  .drawer .df{position:static;border-top:1px solid var(--rule);padding:12px 14px 16px}
  /* the tags are the first thing in the body now, so they do not need the gap that separated them from a
     header rule that is no longer above them */
  .drawer .db > .ptags{margin-top:2px}
}

/* =====================================================================================================================
   v5.87 - THE PIT-WALL STANDARD (Andrew Fisher, 25 Sep 2026). One set of parts, used everywhere: the scene behind the
   bar, the instrument cluster and its pods, the carbon island, the chrome dial, the signal head, the LED tile, the card
   with the orange edge. Vector for every edge; the two photographs are the only rasters and ship oversized. */
header.top{--hzcar:url(__HZ_CAR__);background:#0d0a09 url(__HZ_BACKDROP__) center 62%/cover no-repeat}
header.top::before{background:linear-gradient(90deg,#ff9a4d,#ff6a13 45%,#ff6a13 70%,#ff8e35);box-shadow:0 1px 10px rgba(255,106,19,.7);z-index:6}
.hzscene{position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.hzgrade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,7,6,.55) 0%,rgba(10,7,6,.35) 26%,rgba(10,7,6,.62) 52%,rgba(8,6,5,.94) 66%,rgba(8,6,5,.97) 100%),linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,0) 35%,rgba(0,0,0,.55) 100%),radial-gradient(520px 200px at 14% 78%,rgba(255,106,19,.22),transparent 65%)}
.hzflare{position:absolute;top:-40px;right:16%;width:420px;height:110px;background:radial-gradient(closest-side,rgba(255,170,90,.28),rgba(255,106,19,.08) 55%,transparent 75%)}
.brandrow{position:relative;z-index:4}
.hbar{height:auto;min-height:100px;padding:12px 14px 12px 0;gap:12px}
.lockup{flex:0 0 auto} .brandtxt{min-width:0} #bOrg{white-space:nowrap;overflow:visible;text-overflow:clip;max-width:none}
.search{flex:1 1 200px;min-width:170px}
/* the #26 on its reflection, three light trails behind it */
.hzcar{position:relative;flex:0 0 auto;width:214px;height:92px;margin-left:-6px;display:block}
.hzcar::before,.hzcar::after{content:'';position:absolute;left:-40px;top:32px;width:250px;height:2px;background:linear-gradient(90deg,transparent,rgba(255,150,80,.45) 55%,transparent)}
.hzcar::after{top:50px;width:200px;left:-60px;opacity:.6}
.hzcarimg,.hzcarref{display:block;background:var(--hzcar) 0 0/100% auto no-repeat;aspect-ratio:1000/367}
.hzcarimg{position:absolute;left:0;top:-4px;width:228px;z-index:2;filter:drop-shadow(0 6px 6px rgba(0,0,0,.7))}
.hzcarref{position:absolute;left:0;top:68px;width:228px;transform:scaleY(-1);opacity:.2;-webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 70%);mask-image:linear-gradient(180deg,transparent 0%,#000 70%);pointer-events:none}
/* v5.93 - THE LOST FIRST TAP, FOUND: the car's reflection (v5.87) hung 84 px below the brand row, over Today and
   Where we are in the tab bar, and took the tap meant for them. No decoration in the header takes a pointer now. */
.brandrow .hzcarref,.brandrow .hzcar img,.hzscene,.hzscene *{pointer-events:none}
.lockup .mark{display:none}
#bOrg{font:800 10.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.24em;text-transform:uppercase;color:#e2d6cb;text-shadow:0 1px 2px #000,0 0 12px rgba(0,0,0,.8)}
.wordmark{gap:10px;margin-top:5px;align-items:center}
.wordmark .gc{font:700 40px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;letter-spacing:-.005em;background:linear-gradient(180deg,#ffffff 0%,#e9eef0 38%,#8f9ca0 50%,#dfe6e8 62%,#ffffff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 2px 2px rgba(0,0,0,.9))}
.wordmark .yr{font:700 19px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;color:#ff7a24;letter-spacing:.06em;text-shadow:0 0 1px #ffb27a,0 0 12px rgba(255,106,19,.9),0 0 30px rgba(255,106,19,.45)}
.wordmark .when{display:none}
.search input{height:46px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:linear-gradient(180deg,rgba(6,4,3,.82),rgba(6,4,3,.7));box-shadow:inset 0 2px 6px rgba(0,0,0,.8),inset 0 -1px 0 rgba(255,255,255,.06),0 1px 0 rgba(255,255,255,.05)}
.search input::placeholder{color:#9c8b7e}
.tools{order:4}
/* the cluster: carbon, the shift light along its top, three pods */
.hzcluster{order:3;position:relative;display:flex;gap:10px;padding:14px 12px 10px;border-radius:14px;flex:0 0 auto;align-self:center;
  background:#120e0c url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='8' height='8' viewBox='0 0 8 8'><defs><linearGradient id='a' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%23262019'/><stop offset='.55' stop-color='%23181310'/><stop offset='1' stop-color='%23110d0b'/></linearGradient><linearGradient id='b' x1='1' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23211b16'/><stop offset='.55' stop-color='%23151110'/><stop offset='1' stop-color='%230f0b0a'/></linearGradient></defs><rect width='8' height='8' fill='%23100c0a'/><rect x='0' y='0' width='4' height='4' rx='.6' fill='url(%23a)'/><rect x='4' y='4' width='4' height='4' rx='.6' fill='url(%23a)'/><rect x='4' y='0' width='4' height='4' rx='.6' fill='url(%23b)'/><rect x='0' y='4' width='4' height='4' rx='.6' fill='url(%23b)'/></svg>") 0 0/8px 8px;
  box-shadow:0 0 0 1px #3a2c24,0 0 0 2px #0a0706,0 14px 30px -10px rgba(0,0,0,.95),inset 0 1px 0 rgba(255,255,255,.07)}
.hzshift{position:absolute;left:14px;right:14px;top:4px;height:7px;display:flex;gap:3px}
.hzshift i{flex:1;border-radius:2px;background:#221a16;box-shadow:inset 0 0 0 1px #0a0706}
.hzshift i.g.on{background:#39e07a;box-shadow:0 0 6px 1px rgba(57,224,122,.9)} .hzshift i.o.on{background:#ff8a2a;box-shadow:0 0 6px 1px rgba(255,138,42,.9)} .hzshift i.r.on{background:#ff3b3b;box-shadow:0 0 6px 1px rgba(255,59,59,.9)}
.hzpod,.tpcard > .face,.recstrip{position:relative;min-width:142px;border-radius:12px;color:#fff;background:linear-gradient(180deg,#2a3436,#141b1d 40%,#0e1416);
  box-shadow:0 0 0 1px #0b1012,0 0 0 2.5px #4d5a5b,0 0 0 3.5px #1a2224,0 8px 18px -6px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.10),inset 0 -8px 16px rgba(0,0,0,.55)}
.hzpod::before,.tpcard > .face::before,.recstrip::before{content:'';position:absolute;inset:1px 1px auto 1px;height:46%;border-radius:11px 11px 40% 40%;background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,0));pointer-events:none}
.tpodwrap{flex:0 0 auto;width:auto} .tpcard{clip-path:none;background:none;padding:0} .tpcard > .face{display:block;padding:0;clip-path:none;border-radius:12px}
.tphead{padding:8px 11px 9px;gap:0} .tpk{justify-content:flex-start} .tpk b{font-size:9.5px;letter-spacing:.2em;color:#a9b4b3} .tpk i{display:none}
.tpnum{font:700 30px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;margin-top:3px;letter-spacing:-.005em;color:#f4f7f6;text-shadow:0 0 1px #fff,0 0 12px rgba(255,255,255,.18),0 2px 3px rgba(0,0,0,.8)}
.tpnum .sec{color:#ff7a24;text-shadow:0 0 1px #ffb27a,0 0 10px rgba(255,106,19,.85),0 0 26px rgba(255,106,19,.45)} .tpnum .sep{color:rgba(246,241,236,.6)} .tpnum .d{font-size:16px}
.tpsec{margin-top:6px;gap:2px} .tpsec i{height:5px;border-radius:1px;background:#3d2d24} .tpsec i.on{background:#ff7a24;box-shadow:0 0 5px rgba(255,106,19,.8)}
.tpdate{display:block;margin-top:5px;font:600 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.1em;text-transform:uppercase;color:#a9b4b3;white-space:nowrap}
.tpprint{display:none}
.hzpod{padding:8px 11px 9px;display:flex;flex-direction:column}
.hzpod .lab,.recstrip .rsw b{font:700 9.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;color:#a9b4b3;text-shadow:0 1px 0 #000}
.hzpod .num{display:block;margin-top:3px;font:700 30px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;color:#f4f7f6;white-space:nowrap;letter-spacing:-.005em;text-shadow:0 0 1px #fff,0 0 12px rgba(255,255,255,.18),0 2px 3px rgba(0,0,0,.8)}
.hzpod .num small{font:600 11px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.16em;margin-left:7px;color:#b8c2c1;vertical-align:.32em;text-shadow:none}
.hzpod .num small.cdt{font:700 16px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;letter-spacing:.04em;color:#ff9a4d;vertical-align:.22em;margin-left:9px;font-variant-numeric:tabular-nums;text-shadow:0 0 8px rgba(255,106,19,.35)}
.hzpod .num small.cdt:empty{display:none}
/* v5.93 - a tapped tab answers at once: lit while its page is drawn */
nav.tabs button.busy,#tabMoreMenu button.busy{color:#fff;background:rgba(255,106,19,.16)}
.hzpod .sub,.recstrip .rsw em{display:block;margin-top:4px;font:600 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.1em;text-transform:uppercase;color:#a9b4b3;white-space:nowrap;font-style:normal;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.hzpod.hzcd{max-width:236px;min-width:0}
@media(max-width:640px){.hzpod .num small.cdt{display:block;margin:5px 0 0;font-size:15px}}   /* v6.00 - on a phone the clock sits under the days, whole; it was clipped by the pod's edge */
.rail{position:relative;height:18px;margin-top:5px;width:100%;min-width:150px}
.rail .track{position:absolute;left:0;right:0;top:10px;height:3px;border-radius:2px;background:#0a0f10;box-shadow:inset 0 1px 1px rgba(0,0,0,.9),0 1px 0 rgba(255,255,255,.06)}
.rail .done{position:absolute;left:0;top:10px;height:3px;width:var(--p,0%);border-radius:2px;background:linear-gradient(90deg,#ff9a4d,#ff6a13);box-shadow:0 0 8px rgba(255,106,19,.8)}
.rail .wks i{position:absolute;top:8px;width:1px;height:7px;background:rgba(255,255,255,.22)}
.rail .flag{position:absolute;top:-4px;width:12px;height:8px;background:repeating-conic-gradient(#fff 0 25%,#171110 0 50%) 0 0/4px 4px;border:1px solid #fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,.8))}
.rail .flag::after{content:'';position:absolute;left:-1px;top:7px;width:1px;height:8px;background:#fff}
.rail .car{position:absolute;left:calc(var(--p,0%) - 16px);top:-3px;width:34px;aspect-ratio:1000/367;background:var(--hzcar) center/contain no-repeat;filter:drop-shadow(0 0 4px rgba(255,106,19,.85))}
.rail .lb{position:absolute;top:13px;font:700 7.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.14em;color:#8e9a99} .rail .lb.s{left:0} .rail .lb.e{right:0}
/* the record pod: three lamps and a word; the state is the colour, and it never pulses */
.recstrip{display:flex;flex-direction:column;align-items:flex-start;gap:0;padding:8px 11px 9px;max-width:none;border:0}
.recstrip .rsdot{display:none}
.recstrip .rsw{display:flex;flex-direction:column;gap:0;min-width:0;order:2}
.recstrip .rsw b{order:1;font:700 24px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;letter-spacing:0;text-transform:none;color:#f4f7f6;text-shadow:0 0 1px #fff,0 0 12px rgba(255,255,255,.18),0 2px 3px rgba(0,0,0,.8);margin-top:3px;padding-left:64px}
.recstrip .rslamps{position:absolute;left:11px;top:31px;display:inline-flex;gap:6px}
.recstrip .rslamps i{width:15px;height:15px;border-radius:50%;background:radial-gradient(circle at 38% 32%,#4a3a30,#2b2019 35%,#120d0b);box-shadow:0 0 0 1px #5a4638,inset 0 0 0 1px rgba(255,255,255,.05)}
.recstrip .rslamps i::after{content:'';position:absolute;width:5px;height:3px;border-radius:50%;background:#fff;opacity:.35;transform:translate(3px,3px)}
.recstrip.shared .rslamps i,.recstrip.view .rslamps i{background:radial-gradient(circle at 38% 32%,#c8ffd9,#3ddc78 35%,#0b6b2d);box-shadow:0 0 0 1px #0d3a1c,0 0 8px 2px rgba(47,192,100,.55)}
.recstrip.pending .rslamps i:nth-child(-n+2),.recstrip.checking .rslamps i:first-child{background:radial-gradient(circle at 38% 32%,#ffe3a0,#ffb000 35%,#7a4f00);box-shadow:0 0 0 1px #4a3000,0 0 8px 2px rgba(255,176,0,.5)}
.recstrip.offline .rslamps i:first-child,.recstrip.local .rslamps i:first-child{background:radial-gradient(circle at 38% 32%,#ffb0a8,#ff3b30 35%,#7a140c);box-shadow:0 0 0 1px #4a0d08,0 0 8px 2px rgba(255,59,48,.5)}
.recstrip::after{content:'';position:absolute;left:11px;top:8px;font:700 9.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;color:#a9b4b3}
.recstrip .rsw::before{content:'Record';font:700 9.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;color:#a9b4b3;text-shadow:0 1px 0 #000;order:0}
.recstrip .rsw em{order:2}
/* the tab row: glass over the scene */
nav.tabs{position:relative;z-index:3;background:linear-gradient(180deg,rgba(8,6,5,.9),rgba(8,6,5,.96));border-top:1px solid rgba(255,255,255,.09);box-shadow:inset 0 1px 0 rgba(0,0,0,.7)}
nav.tabs button[aria-selected="true"]::after,.tabmore.on::after{background:linear-gradient(90deg,#ff9a4d,#ff6a13);box-shadow:0 0 14px 3px rgba(255,106,19,.6)}
/* ---- Today: the strip's tiles are LED tiles now */
.tstrip{border-radius:14px;background:linear-gradient(180deg,#fff,#faf8f6)}
.tsq{--edge:#1a2224;--face:#141b1d;clip-path:none;border-radius:12px;background:none;padding:0;min-width:172px;box-shadow:0 0 0 1px #0b1012,0 0 0 2.5px #4d5a5b,0 0 0 3.5px #1a2224,0 10px 20px -8px rgba(0,0,0,.6);margin:3.5px}
.tsq > .tsqface{clip-path:none;border-radius:12px;padding:10px 14px 11px;background:linear-gradient(180deg,#232c2e,#111819 45%,#0c1213);color:#fff;position:relative}
.tsq > .tsqface::before{content:'';position:absolute;inset:1px 1px auto 1px;height:46%;border-radius:11px 11px 40% 40%;background:linear-gradient(180deg,rgba(255,255,255,.08),transparent);pointer-events:none}
.tsq .tsqface b{font-size:34px;color:#fff;text-shadow:0 0 12px rgba(255,255,255,.2);margin-top:4px}
.tsq .tsqface span{font:700 9.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;color:#a9b4b3;order:-1;margin:0}
.tsq .tsqface em{font:600 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.1em;text-transform:uppercase;color:#a9b4b3;margin-top:5px}
.tsq.gap .tsqface b,.tsq.gap .tsqface span{color:#ff8a3a;text-shadow:0 0 12px rgba(255,106,19,.8)}
.tsq:hover{background:none;box-shadow:0 0 0 1px #0b1012,0 0 0 2.5px #ff6a13,0 0 0 3.5px #1a2224,0 10px 20px -8px rgba(0,0,0,.6);transform:translateY(-1px)}
.tsnote{font-size:13px;color:var(--ink2)}
/* ---- the instruments: dark carbon islands with screws */
.inst{display:grid;grid-template-columns:400px minmax(0,1fr);gap:14px;margin-bottom:14px;align-items:stretch}
.inst .racecard{grid-column:1/-1}
.card.island{--edge:#3a2c24;--face:#120e0c;clip-path:none;border-radius:16px;margin:0;padding:14px 14px 12px;color:#fff;
  background:#120e0c url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='8' height='8' viewBox='0 0 8 8'><defs><linearGradient id='a' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%23262019'/><stop offset='.55' stop-color='%23181310'/><stop offset='1' stop-color='%23110d0b'/></linearGradient><linearGradient id='b' x1='1' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23211b16'/><stop offset='.55' stop-color='%23151110'/><stop offset='1' stop-color='%230f0b0a'/></linearGradient></defs><rect width='8' height='8' fill='%23100c0a'/><rect x='0' y='0' width='4' height='4' rx='.6' fill='url(%23a)'/><rect x='4' y='4' width='4' height='4' rx='.6' fill='url(%23a)'/><rect x='4' y='0' width='4' height='4' rx='.6' fill='url(%23b)'/><rect x='0' y='4' width='4' height='4' rx='.6' fill='url(%23b)'/></svg>") 0 0/8px 8px;
  box-shadow:0 0 0 1px #3a2c24,0 0 0 2px #0a0706,0 18px 34px -16px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.07);border-top:0}
.card.island > .face{display:contents}
.card.island::before,.card.island::after,.card.island .hubtitle::before,.card.island .hubtitle::after{content:'';position:absolute;width:9px;height:9px;border-radius:50%;z-index:2;background:radial-gradient(circle at 40% 35%,#c9d0d2,#6b7678 55%,#1c2224);box-shadow:0 0 0 1px #000,inset 0 0 0 1px rgba(255,255,255,.15)}
.card.island::before{left:6px;top:6px} .card.island::after{right:6px;top:6px} .card.island .hubtitle::before{left:6px;bottom:6px;top:auto} .card.island .hubtitle::after{right:6px;bottom:6px;top:auto}
.card.island .hubtitle{position:static} .card.island .hubtitle h3,.card.island .phead h3{font:700 10px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;color:#a9b4b3}
.card.island .chip{background:rgba(255,255,255,.06);color:#ffb27a;border-color:rgba(255,255,255,.12)} .card.island .chip.ok{color:#39e07a} .card.island .chip.crit{color:#ff8a80} .card.island .chip.cand{color:#ffd28a}
.card.island{cursor:default} .card.island .hubgo,.card.island .pkeyhead .hubgo{color:#ff8a3a}
.card.island .hubgo[data-go]{cursor:pointer;display:inline-block;padding:6px 10px;margin-left:-10px;border-radius:8px} .card.island .hubgo[data-go]:hover,.card.island .hubgo[data-go]:focus-visible{background:rgba(255,106,19,.14);outline:0;text-decoration:underline}
.card.island:hover{transform:none;box-shadow:0 0 0 1px #3a2c24,0 0 0 2px #0a0706,0 18px 34px -16px rgba(0,0,0,.8)}
.card.island:hover{border-color:transparent;box-shadow:0 0 0 1px #ff6a13,0 0 0 2px #0a0706,0 18px 34px -16px rgba(0,0,0,.8);transform:translateY(-1px)}
.card.island.dialcard .cgauge.gi{background:none;border:0;box-shadow:none;padding:0}
.card.island.dialcard .hubtitle{margin-bottom:4px}
.gikn{stroke:#0b1012;stroke-opacity:.55;stroke-width:1} .giring{fill:none;stroke:#fff;stroke-opacity:.12;stroke-width:1} .gired{stroke:#7a1a14;opacity:.9} .giglass{fill:url(#giglassg);pointer-events:none}
.cgauge.gi{--gi-track:#1f2a2c;--gi-fill:#ff6a13;--gi-maj:#e6ecec;--gi-med:#8a9a9c;--gi-min:#4e5e60;--gi-lab:#cfd6d7;--gi-cap:#9fb0b2;--gi-cap2:#6f8082;--gi-n1:#ff6a13;--gi-n2:#ffe1c6;--gi-hub:#151d1f;--gi-hubline:#9aa6a8;--gi-rule:#2b3638;--gi-foot:#7f8f91}
.cgauge.gi .gifill{filter:drop-shadow(0 0 6px rgba(255,106,19,.8))}
.cgauge.gi .gidig b{text-shadow:0 0 1px #fff,0 0 10px rgba(255,255,255,.35),0 2px 4px rgba(0,0,0,.9)}
.cgauge.gi .ginote{border-top-color:#2b3638} .cgauge.gi .cgnote{color:#b6c0bb}
.card.island.dialcard .ctile{background:linear-gradient(180deg,#1c2426,#0f1516);border:1px solid rgba(255,255,255,.1);border-radius:12px;box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 8px 16px -10px rgba(0,0,0,.8);color:#d7dedd}
.card.island.dialcard .ctile b,.card.island.dialcard .ctile .ctbig{color:#fff;font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;font-weight:700;text-shadow:0 0 1px #fff,0 0 12px rgba(255,255,255,.18)}
.card.island.dialcard .ctile span,.card.island.dialcard .ctile .ctk{color:#a9b4b3} .card.island.dialcard .ctile .ctk{font:700 9.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase}
.card.island.dialcard .ctile.lead.good{border-color:rgba(57,224,122,.5);box-shadow:inset 0 0 0 1px rgba(57,224,122,.15),0 0 18px -6px rgba(57,224,122,.5)} .card.island.dialcard .ctile.lead.good b,.card.island.dialcard .ctile.lead.good .ctbig,.card.island.dialcard .ctile.good > b{color:#39e07a;text-shadow:0 0 10px rgba(57,224,122,.55)}
.card.island.dialcard .ctile.lead.stop{border-color:rgba(255,59,48,.55);box-shadow:inset 0 0 0 1px rgba(255,59,48,.15),0 0 18px -6px rgba(255,59,48,.5)} .card.island.dialcard .ctile.lead.stop b,.card.island.dialcard .ctile.lead.stop .ctbig{color:#ff5a4e;text-shadow:0 0 10px rgba(255,59,48,.5)}
.card.island.dialcard .ctile.plan > b{color:#8fc4ff;text-shadow:0 0 10px rgba(143,196,255,.45)} .card.island.dialcard .ctile.plan{border-color:rgba(143,196,255,.35)}
.card.island.dialcard .ctile.whole{background:linear-gradient(180deg,#171d1f,#0d1213)} .card.island.dialcard .cwpc span{color:#c9d1d0}
.card.island.dialcard .sem,.card.island.dialcard .ctile .chip{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#e6ecec}
.card.island.dialcard .ctmark{color:inherit}
/* the lights island: the signal head beside the counts */
.card.island.lights .hublights{display:grid;grid-template-columns:96px 1fr;gap:10px 12px;align-items:start}
.card.island.lights .sighead{grid-row:1/span 4;width:96px;height:auto;align-self:center}
.card.island.lights .hl{background:rgba(255,255,255,.05);border:0;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);color:#a9b4b3;font:600 11px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.1em;text-transform:uppercase;border-radius:10px;padding:8px 10px;gap:10px}
.card.island.lights .hl b{font:700 28px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;min-width:52px;text-align:right;color:#fff}
.card.island.lights .hl[data-lf-go="green"] b{color:#39e07a;text-shadow:0 0 10px rgba(57,224,122,.6)} .card.island.lights .hl[data-lf-go="amber"] b{color:#ffb000} .card.island.lights .hl[data-lf-go="red"] b{color:#ff5a4e} .card.island.lights .hl[data-lf-go="none"] b{color:#c9c9c9}
.card.island.lights .hl[data-lf-go="done"],.card.island.lights .hl[data-lf-go="levelled"],.card.island.lights .hl[data-lf-go="steps"]{grid-column:2;background:linear-gradient(180deg,#232c2e,#111819);box-shadow:0 0 0 1px #0b1012,0 0 0 2px #3d4a4b,inset 0 1px 0 rgba(255,255,255,.08)}
.card.island.lights .hl[data-lf-go="done"] b{color:#39e07a} .card.island.lights .hl[data-lf-go="levelled"] b,.card.island.lights .hl[data-lf-go="steps"] b{color:#8fc4ff}
.card.island.lights .hl .tl,.card.island.lights .hl .tick{display:none}
.card.island.lights .hl .w{color:#a9b4b3;font-size:10px}
.card.island.lights .hl:hover{box-shadow:inset 0 0 0 1px #ff6a13}
/* the programme island: its rail and figures in white, the race numerals, the next milestone as dark glass */
.card.island.racecard{color:#fff}
.card.island.racecard .pstat b{font:700 44px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;letter-spacing:-.01em;color:#fff;text-shadow:0 0 1px #fff,0 0 12px rgba(255,255,255,.18)}
.card.island.racecard .pstat b+span,.card.island.racecard .pstat em{color:#c9d1d0} .card.island.racecard .pstat+.pstat{border-left-color:rgba(255,255,255,.14)}
.card.island.racecard .pnext{background:linear-gradient(180deg,#1c2426,#0f1516);border:1px solid rgba(255,106,19,.45);border-radius:12px;box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 0 18px -6px rgba(255,106,19,.45);color:#d7dedd}
.card.island.racecard .pnext *{color:inherit} .card.island.racecard .pnext h4{color:#fff} .card.island.racecard .pnext b{color:#fff} .card.island.racecard .pphase{color:#ff8a3a} .card.island.racecard .pnext{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1)} .card.island.racecard .pnext h4,.card.island.racecard .pkeys li b,.card.island.racecard .pnfig b{color:#fff}
.card.island.racecard .pkeys li{border-color:rgba(255,255,255,.08);color:#d2d8d2} .card.island.racecard .pkeys li.next,.card.island.racecard .pkeys li.next b{color:#ff8a3a}
.card.island.racecard .pgm,.card.island.racecard .pgm *{color:#d2d8d2}
/* ---- the cards: white, an orange edge, the race numerals, equal heights */
.hub{align-items:stretch}
.hubcard{--face:#fff;border-radius:14px;box-shadow:0 12px 28px -20px rgba(0,0,0,.45);transition:transform .18s cubic-bezier(.2,.7,.2,1),box-shadow .18s}
/* v5.92 - a card lifts a touch under the pointer; every edge is antialiased for the big screens */
@media (hover:hover){.hubcard[data-go]:hover,.photocat:hover,.card.island:hover{transform:translateY(-2px);box-shadow:0 18px 34px -18px rgba(0,0,0,.55)}}
html{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}
.hubbig b,.pstat b,.tkpi b,.kpi b{font-variant-numeric:tabular-nums lining-nums}
@media (prefers-reduced-motion:reduce){.hubcard,.photocat,.card.island{transition:none!important;transform:none!important}}
/* v5.91 - the photograph drawers on Documents: race cards with a strip of pictures */
.photocats{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin:4px 0 6px}.photocats .photocat{grid-column:auto}
.photocat{display:flex;flex-direction:column;gap:8px;text-align:left;cursor:pointer;background:linear-gradient(160deg,#1f2a30,#11171b);border:1px solid #2a3338;padding:14px 16px;min-height:170px;font:inherit}
.photocat .pstat{padding:0}.photocat .pstat span{display:block;font-weight:700;font-size:14px;color:#fff;margin-top:2px}.photocat .pstat em{display:block;font-style:normal;font-size:12px;color:#c9d1d0;margin-top:2px}
.photocat .pstrip{display:flex;gap:6px;height:56px}.photocat .pstrip img,.photocat .pstrip i{flex:1;min-width:0;height:56px;object-fit:cover;border-radius:6px;background:#0d1114;border:1px solid #2a3338}
.photocat:hover,.photocat:focus-visible{border-color:var(--orange);outline:0}.photocat .hubgo{color:#ffb27a}
.clamp{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.clamp.open{display:block;-webkit-line-clamp:unset}.clampbtn{font-size:11px;padding:0;margin-top:2px}.fwhy{max-width:440px}
.regsum{margin-top:14px}.regviewsw{display:flex;gap:4px}.regviewsw .btn[aria-pressed="true"]{background:var(--orange);color:#1b1207;border-color:var(--orange)}
#pane-register.inplant{margin-top:18px}#pane-register.inplant .panehead{border-top:1px solid var(--rule,#e4e0dc);padding-top:14px}
.docgrid.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}
.hubcard > .face{border-radius:14px}
.hubbig b{font:700 40px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;letter-spacing:-.01em;color:var(--ink)}
.hublist .tm{font:700 15px/1.2 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;color:var(--ink)}
.hubgo{font:700 12px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.06em;text-transform:uppercase}
.hubtitle h3{font-size:15px;font-weight:800;letter-spacing:-.01em}
/* ---- the page's own scale: laptop, tablet, phone */
@media(max-width:1280px){ .inst{grid-template-columns:360px minmax(0,1fr)} }
@media(max-width:900px){ .inst{grid-template-columns:1fr} }
@media(max-width:640px){
  header.top{background-position:38% 70%}
  .hbar{flex-wrap:wrap;gap:9px 10px;padding:10px 12px 10px;min-height:0;height:auto}
  .lockup{order:1;overflow:visible} .hzcar{width:110px;height:48px;margin-left:-8px} .hzcarimg{width:124px;top:-2px} .hzcarref{display:none} .hzcar::before,.hzcar::after{display:none}
  .wordmark .gc{font-size:30px} .wordmark .yr{font-size:15px} .wordmark{margin-top:0}
  .tools{order:2;margin-left:auto}
  body.search-open .recstrip{display:flex} body.search-open .tpodwrap{display:block}
  .tpk{overflow:hidden} .tpk b{display:block;overflow:hidden;text-overflow:ellipsis}
  .tsq-row{grid-template-columns:1fr;gap:6px} .tsq{margin:3.5px 3.5px}
  .tsq > .tsqface{flex-direction:row;align-items:center;gap:10px;padding:7px 12px} .tsq .tsqface b{font-size:26px;margin:0;min-width:44px} .tsq .tsqface span{order:0;flex:1 1 auto} .tsq .tsqface em{margin:0;text-align:right;max-width:40%}
  .hzcluster{order:5;flex:1 1 100%;gap:7px;min-width:0;max-width:100%;padding:12px 8px 8px;border-radius:12px} .hzshift{left:8px;right:8px}
  .hzpod,.tpcard > .face,.recstrip{min-width:0;flex:1 1 0;overflow:hidden} .tpodwrap{flex:1 1 0;min-width:0}
  .hzpod .num,.tpnum{font-size:22px} .hzpod .num small{font-size:9px;margin-left:4px} .hzpod .lab,.tpk b,.recstrip .rsw::before{font-size:7.5px;letter-spacing:.12em;white-space:nowrap} .hzpod .sub,.tpdate,.recstrip .rsw em{font-size:8px;letter-spacing:.06em;overflow:hidden;text-overflow:ellipsis}
  .recstrip .rsw b{font-size:17px;padding-left:46px} .recstrip .rslamps{gap:3px;top:26px} .recstrip .rslamps i{width:11px;height:11px}
  .rail{min-width:0} .rail .lb{display:none} .rail .car{width:26px;top:-1px}
  .tppanel{left:0;right:auto;width:calc(100vw - 24px)}
  .tsq{min-width:0}
  .inst{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){ .hzshift i{transition:none} }
@media print{ .hzscene,.hzcar,.hzcluster{display:none!important} header.top{background:#fff!important} }
/* ---------------------------------------------------------------------------------- printing
   The page is built for a phone and a laptop, but people print the register and take it on site.
   Without these rules only the on-screen viewport reached the paper: printing 150 assets produced a
   single page holding one row, because .app is a 100vh flex column with the scrolling inside it. */
@media print{
  @page{ size:A4 landscape; margin:12mm 10mm; }
  html,body{ background:#fff !important; }
  .app{ display:block !important; height:auto !important; }
  main{ flex:none !important; overflow:visible !important; height:auto !important; display:block !important; }
  .pane{ display:block !important; }
  .pane:not(.on){ display:none !important; }
  .top{ position:static !important; }
  .tabs, .tools, .search, .zoomctl, .rotctl, .drawer, .scrim, .btn, .filters, input, select, textarea{ display:none !important; }
  /* the register's working cards — the branch guide and its offer, the contract controls — are for the screen;
     on paper the register is the register */
  #pane-register .notice.info, #pane-register .hint, #pane-register .form{ display:none !important; }
  /* the contracts' 304 lines are a screen card (v5.78): on paper the register's own rows already carry each
     line's branch and contract, and printing the contracts as well tripled the page count */
  #pane-register .card.contracts-lines{ display:none !important; }
  /* a short card stays whole on a page; a card holding a table is allowed to run across pages — keeping the
     register card whole pushed the whole table to page 2 and printed a page with only the header on it */
  /* the card's class says whether it holds a table (set by markCards() before every print and render) — a
     :has() selector would say the same, but an engine without :has() drops the whole rule, and the older WebViews
     on site scanners and rugged tablets are such engines */
  .card:not(.has-table), .kpi, .notice, tr, .acc{ page-break-inside:avoid; break-inside:avoid; }
  .card.has-table{ page-break-inside:auto; break-inside:auto; }
  table{ width:100% !important; font-size:8pt; }
  thead{ display:table-header-group; }
  .tblwrap{ overflow:visible !important; max-height:none !important; }
  a[href]:after{ content:''; }
  .printnote{ display:block !important; font-size:8pt; color:#000; border-top:1px solid #999;
    margin-top:6mm; padding-top:2mm; }
  .mapinner{ transform:none !important; }
  .maprot{ transform:none !important; --rot:0deg !important; }
  .mk{ box-shadow:none; }
  /* Print is ink on paper. Every glow, gradient and lift is screen furniture — on a page it prints as a grey
     smudge or, on the header, as a solid block of toner. */
  header.top{ background:#fff !important; border-bottom:1px solid #999 !important; }
  header.top::before{ display:none !important; }
  .brandtxt b, .brandtxt span{ color:#000 !important; }
  .card, .kpi{ box-shadow:none !important; border:1px solid #bbb !important; }
  .mk{ --z:1 !important; }
  .mk:hover, .mk:active, .mk.sel{ box-shadow:none !important; --k:1 !important; animation:none !important; }
  /* the lights print as ink: the dot keeps its colour, the set-buttons and filters are screen controls */
  .tlset .lb, .lightbar, .daynav, .who, .acts, .dnav, .hubgo, .mv input{ display:none !important; }
  .hub{ display:block; } .hubcard{ margin-bottom:6mm; break-inside:avoid; }
  .mk .bdx{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .tl i, .mk[data-lt]::before, .day .lights i{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  /* The status instrument on paper. Backgrounds off throws away every gradient, so the drawing is reduced to
     ink: the housing an outline, each lens an outlined circle, and the lit one a solid disc inside a THICK
     DARK RING — the ring is a stroke, not a fill, so it survives greyscale and backgrounds-off both. Bloom,
     glass and the LED texture are dropped: at 8 mm across they are noise. The words print at every size. */
  /* paper has no time axis: a pane caught on the first frame of its arrival printed as a blank page */
  *, *::before, *::after{ animation:none !important; transition:none !important; }
  .pane.on{ opacity:1 !important; transform:none !important; }
  .dstat .hz{ filter:none !important; width:74px !important; height:28.5px !important; }
  .dstat .hz .body, .dstat .hz .panel{ fill:#fff !important; stroke:#444; stroke-width:1.5; }
  .dstat .hz .edge{ stroke:#444; stroke-opacity:1; }
  .dstat .hz .bevel, .dstat .hz .bolt, .dstat .hz .glass, .dstat .hz .bloom, .dstat .hz .halo, .dstat .hz .hot, .dstat .hz .dots,
  .dstat .hz .sheen, .dstat .hz .edgehi, .dstat .hz .rimhi, .dstat .hz .shade, .dstat .hz .bz2, .dstat .hz .gap{ display:none !important; }
  .dstat .hz .lens circle{ fill:#fff !important; stroke:#777; stroke-width:1.5; }
  .dstat .hz .lens .lamp{ opacity:0 !important; }
  .dstat .hzc{ padding-bottom:0 !important; }
  .dstat.red .hz .lens.r .lamp, .dstat.amber .hz .lens.a .lamp, .dstat.green .hz .lens.g .lamp{ opacity:1 !important; animation:none !important; }
  .dstat.red .hz .lens.r .core{ fill:var(--tl-red) !important; stroke:#111; stroke-width:5; }
  .dstat.amber .hz .lens.a .core{ fill:var(--tl-amber) !important; stroke:#111; stroke-width:5; }
  .dstat.green .hz .lens.g .core{ fill:var(--tl-green) !important; stroke:#111; stroke-width:5; }
  .dstat .hz{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .dstat .ds-w{ display:flex !important; }
  .dstat .ds-w b{ font-size:9.5pt !important; color:#000 !important; }
  .dstat .ds-w em{ font-size:8pt !important; color:#333 !important; }
  .daystrip{ flex-wrap:wrap; overflow:visible; }
  .day{ box-shadow:none !important; }
  tbody tr.done > td, tbody tr.moving > td, tbody tr.complete > td, tbody tr.complete > td:first-child, tbody tr.levelled > td:first-child, tbody tr.stepped > td:first-child, .tick, .mk .okx, .mk .nox, .mk .stpx, .nomark, .mk[data-complete="1"], .mk[data-levelled="1"], .mk[data-steps="1"]{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .tickbtn, #folderBtn, .syncpill, .mkpick, .tlw, .sheetsel{display:none!important}
  #flash{display:none!important}
  /* a body pinned to the viewport height is a page and a bit once printed — let it be as tall as its content */
  html, body, .app{min-height:0!important;height:auto!important}
  /* the documents tab: the list prints; the pictures and the buttons do not */
  #pane-docs .thumb, #pane-docs .docadd, #pane-docs .docjump{display:none!important}
  #pane-docs .docgrid{display:block} #pane-docs .doccard{margin-bottom:2mm;break-inside:avoid;clip-path:none;background:#fff;border:1px solid #bbb}
  #pane-docs .doccard > .face{clip-path:none;padding:1.5mm 3mm} #pane-docs .doccard .dockind{background:#fff !important;color:#000 !important;clip-path:none;padding:0} #pane-docs .doccard .slash.doc{display:none}
  /* Availability has to survive the printer. The old rule hid "not on the service yet" on paper, so a printed
     register read as though every document were there — the one thing a person holding the list needs to know
     is exactly which ones are not. It prints, in black, with a rule so it reads without colour. */
  #pane-docs .doccard .absent{display:block !important;color:#000 !important;font-size:8.5pt !important;
    border-left:2px solid #000;padding-left:2mm;margin-top:1mm}
  /* a drawing sheet printed from the page: one landscape page, nothing else on it */
  body.printing-sheet #sheetprint{position:static;padding:0;height:auto}
  body.printing-sheet #sheetprint img{height:auto;max-height:265mm}
  /* where we are: an A4 portrait report — the summary plates, then the trade tables (v5.16) */
  body.printing-progress header.top, body.printing-progress .app footer{display:none!important}
  /* the pit-lane board heads the report: the still, never the clip, and what the board says printed under the
     picture as well as on it so it reads at any print quality (v5.18) */
  body.printing-progress #pane-progress .bhero{margin:0 0 3mm;border:1px solid #bbb;box-shadow:none;break-inside:avoid;background:#fff}
  body.printing-progress #pane-progress .bhero video{display:none!important}
  body.printing-progress #pane-progress .bhero .bwin{max-width:150mm}
  body.printing-progress #pane-progress .bhero .bcap{background:none;color:#333;padding:1.2mm 2mm;font-size:7.5px;display:block;line-height:1.35;border-top:1px solid #ddd;max-width:150mm}
  body.printing-progress #pane-progress .bhero .bcap b{color:#111}
  body.printing-progress #pane-progress .bhero .bcap .warn{color:#8a5a00}
  body.printing-progress #pane-progress .bhero .bcap button{display:none!important}
  #pane-progress .hubhead{margin:0 0 2mm} #pane-progress .hubwho{display:none!important}
  #pane-progress .card{padding:1.5mm 3mm;margin-bottom:1.5mm;break-inside:avoid;box-shadow:none;border:1px solid #bbb}
  #pane-progress .hubtitle{margin-bottom:1mm}
  #pane-progress .progtbl{font-size:7.5px} #pane-progress .progtbl th, #pane-progress .progtbl td{padding:0.5px 4px;line-height:1.25}
  #pane-progress .card{page-break-inside:auto;break-inside:auto}
  #pane-progress .norate, #pane-progress .progkeys{font-size:7.5px;line-height:1.3;margin:1mm 0 0}
  /* the programme strip stays on the screen; the printed page is the three tables for the morning meeting, on one
     sheet, and its heading already says the day and the days to race day */
  body.printing-progress #pane-progress .pgm{display:none!important}
  body.printing-progress #pane-progress .card.has-race{display:none!important}
  /* The programme page is one sheet for the morning meeting. The day's deliveries print as their own
     sheet from the button on that card — the same sheet Today prints — so they are left off this one
     rather than pushing it onto a second page. */
  body.printing-progress #pane-progress .card.wentin{display:none!important}
  /* Where we are on paper is the summary first — the plates, the costs, what has gone out — then the trade
     tables as the detail behind them, A4 portrait. Andrew Fisher, 12 Sep 2026: it prints as a well-presented
     page of details. The advice and the day still print from their own buttons. */
  body.printing-progress #pane-progress .hubhead.detail{margin-top:5mm!important;padding-top:3mm;border-top:2px solid var(--c-or, #ff6a13);break-before:auto}
  body.printing-progress #pane-progress .hubhead.detail h2{font-size:13px}
  /* nor the rental system's offer — it is a working list, not part of the programme page */
  body.printing-progress #pane-progress .card.onhireday{display:none!important}
  /* v5.81 — the trade tables fold on the screen under "The detail, trade by trade"; on paper they are the report's
     second half under their own heading, so the fold itself shows and its one-line summary does not */
  body.printing-progress #pane-progress details.sfold.pdetail{display:block!important;border-top:0;margin-top:0}
  body.printing-progress #pane-progress details.sfold.pdetail > summary{display:none!important}
  /* a closed day prints as its heading and its count — the summary; the chevron is for a finger, not for paper */
  #pane-progress details.oday > summary h4::after{display:none}
  #pane-progress .progkeys .linkish{font-size:7.5px;min-height:0;padding:0;display:inline;margin-right:4px}
  /* nine trades now, not six: the tables tighten so the sheet stays one page, and the run of every unrecorded
     reference is left to the screen — on paper it is a paragraph of codes that nobody reads at a meeting */
  body.printing-progress #pane-progress .progtbl{font-size:7.5px} body.printing-progress #pane-progress .progtbl th, body.printing-progress #pane-progress .progtbl td{padding:1px 4px;line-height:1.2}
  body.printing-progress #pane-progress .progkeys{display:none!important}
  body.printing-progress #pane-progress .card{padding:1mm 2.5mm;margin-bottom:1mm}
  body.printing-progress #pane-progress .norate{font-size:6.5px;line-height:1.2}
  #pane-progress .maphint{display:none!important} #pane-progress h2{font-size:15px;margin:0} #pane-progress h3{font-size:10.5px;margin:0}
  #pane-progress .hubhead .sub{font-size:8.5px}
  #pane-progress .chip, #pane-progress .tick{ -webkit-print-color-adjust:exact; print-color-adjust:exact; font-size:7.5px }
  /* costs by category: one landscape page — the eight categories, then the lines shown */
  body.printing-costs header.top, body.printing-costs .app footer{display:none!important}
  #pane-costs .hubhead{margin:0 0 2mm} #pane-costs .daynav, #pane-costs .filters, #pane-costs .acts, #pane-costs .maphint, #pane-costs #workforce .kpis{display:none!important}
  /* v5.83 — on paper, Costs & charges is the money summary, what Coates pays by the eight categories, the branches and
     the charge lines shown; the working detail of our transport and the tracker stays on the screen (its totals are in
     the summary and the categories) */
  body.printing-costs #pane-costs #ourTransport, body.printing-costs #pane-costs #workforce{display:none!important}
  #pane-costs #moneyCard .kpis{display:grid!important;grid-template-columns:repeat(4,1fr);gap:1.5mm;margin:1mm 0!important}
  #pane-costs #moneyCard .kpi{padding:1mm 2mm;box-shadow:none;border:1px solid #bbb;min-height:0} #pane-costs #moneyCard .kpi .v{font-size:15px} #pane-costs #moneyCard .kpi .l{font-size:6.5px}
  #pane-costs .moneydef{font-size:7.5px;margin:0}
  #pane-costs .streamwrap{margin-top:1mm} #pane-costs .streamtbl{font-size:7.5px;min-width:0} #pane-costs .streamtbl th{font-size:6.5px;padding:1px 4px} #pane-costs .streamtbl td{padding:1px 4px;line-height:1.25}
  #pane-costs .streamtbl td .w, #pane-costs .streamtbl td.stnote, #pane-costs .streamtbl small{font-size:6.5px!important;min-width:0}
  #pane-costs .paycats{grid-template-columns:repeat(4,1fr);gap:1.5mm;margin:1mm 0} #pane-costs .paycat{box-shadow:none;border:1px solid #bbb;border-left:3px solid #4a3426;padding:1mm 2mm;min-height:0;gap:0;break-inside:avoid}
  #pane-costs .paycat .pc-name{font-size:7.5px} #pane-costs .paycat .pc-amt{font-size:11px} #pane-costs .paycat .pc-amt small, #pane-costs .paycat .pc-amt .todo{font-size:6.5px} #pane-costs .paycat .pc-sub{font-size:6px;line-height:1.25}
  #pane-costs .paytot, #pane-costs .paytot *{font-size:8px!important} #pane-costs h3.sec{font-size:10.5px;margin:2mm 0 1mm} #pane-costs p.hint{font-size:7.5px;line-height:1.3;margin:0 0 1mm}
  #pane-costs .brtbl{font-size:7.5px;min-width:0} #pane-costs .brtbl th, #pane-costs .brtbl td{padding:1px 4px;line-height:1.2} #pane-costs .brtbl td *{font-size:7px!important}
  #pane-costs .costtbl{min-width:0} #pane-costs .costtbl th:nth-child(8), #pane-costs .costtbl td:nth-child(8), #pane-costs .costtbl th:nth-child(9), #pane-costs .costtbl td:nth-child(9){display:none}
  #pane-costs .costtbl td:nth-child(3) .w{display:none}
  #pane-costs h2{font-size:15px;margin:0} #pane-costs h3{font-size:10.5px;margin:0} #pane-costs .hubhead .sub{font-size:8.5px}
  #pane-costs .notice{font-size:7.5px;line-height:1.3;padding:1mm 2mm;margin:0 0 1.5mm;break-inside:avoid}
  #pane-costs .costcats{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5mm;margin-bottom:1.5mm}
  #pane-costs .costcat{box-shadow:none;border:1px solid #bbb;border-left:3px solid #4a3426;padding:1mm 2mm;min-height:0;gap:0;break-inside:avoid}
  #pane-costs .costcat .cc-name{font-size:8.5px} #pane-costs .costcat .cc-full{font-size:6.5px} #pane-costs .costcat .cc-amt{font-size:12px;margin-top:1px}
  #pane-costs .costcat .cc-sub, #pane-costs .costcat .cc-derived{font-size:6.5px}
  #pane-costs .card{padding:1.5mm 3mm;margin-bottom:1.5mm;box-shadow:none;border:1px solid #bbb;page-break-inside:auto;break-inside:auto}
  #pane-costs .costtbl, #pane-costs .ledgertbl{font-size:7.5px} #pane-costs .costtbl th, #pane-costs .costtbl td, #pane-costs .ledgertbl th, #pane-costs .ledgertbl td{padding:0.5px 4px;line-height:1.25}
  #pane-costs .ledger{gap:2mm 6mm} #pane-costs .ledger .ln{padding:2px 0} #pane-costs .ledger .ln .lb{font-size:8px} #pane-costs .ledger .ln .lb small{font-size:6.5px} #pane-costs .ledger .ln .amt{font-size:11px} #pane-costs .ledger .ln.total .amt{font-size:13px}
  #pane-costs .verdict{font-size:8px;padding:1mm 2mm;margin-top:1.5mm} #pane-costs .ourform{display:none} #pane-costs details.sfold:not([open]){display:none}
  /* the screen sizes some cells inline (supplier, recorded); on paper every cell is one size */
  #pane-costs .costtbl td, #pane-costs .costtbl td *, #pane-costs .ledgertbl td, #pane-costs .ledgertbl td *{font-size:7.5px!important;line-height:1.25!important}
  #pane-costs .costtbl th:last-child, #pane-costs .costtbl td:last-child, #ourTransport .ledgertbl th:last-child, #ourTransport .ledgertbl td:last-child{display:none}
  #pane-costs .costtbl .linkish{min-height:0;padding:0;display:inline;margin:0 4px 0 0}
  #pane-costs .costtbl .chip{font-size:6px!important;padding:0 3px;line-height:1.4!important}
  #pane-costs .norate{font-size:7.5px;line-height:1.3;margin:1mm 0 0}
  #pane-costs .chip{ -webkit-print-color-adjust:exact; print-color-adjust:exact; font-size:6.5px }
}
.printnote{ display:none; }

/* the satellite panel */
.sat{grid-column:1/-1;margin:6px 0 4px;border:1px solid var(--rule);border-radius:8px;overflow:hidden;
  background:var(--tint2)}
.sat.none{grid-column:1/-1;padding:10px 12px}
.sath{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 10px;
  font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--slate);
  border-bottom:1px solid var(--rule2);background:var(--paper)}
.satzs{display:flex;gap:4px}
.satz{font:inherit;font-size:10.5px;letter-spacing:.04em;text-transform:none;font-weight:600;
  padding:3px 8px;min-height:24px;border:1px solid var(--rule);border-radius:5px;background:var(--paper);
  color:var(--slate);cursor:pointer}
.satz.on{background:var(--orange-ink);border-color:var(--orange-ink);color:#fff;box-shadow:0 0 0 3px var(--glow-wide)}
.satbox{position:relative;width:100%;height:210px;overflow:hidden;background:#0e1216}
.satbox img{position:absolute;max-width:none;image-rendering:auto;user-select:none;-webkit-user-drag:none}
.sbar{position:absolute;left:8px;bottom:8px;pointer-events:none;font:600 10px/1 system-ui,sans-serif;color:#fff;
  text-shadow:0 0 3px #000,0 0 2px #000;text-align:right;white-space:nowrap;padding-bottom:8px;min-width:24px}
.sbar::after{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;box-sizing:border-box;border:1px solid #111;
  background:linear-gradient(90deg,#fff 0 25%,#111 25% 50%,#fff 50% 75%,#111 75% 100%)}
.sbar.map{left:12px;bottom:12px;z-index:3}
.satz.live{border-color:var(--orange-ink);color:var(--orange-ink)}
.satz.live.on{color:#fff}
.livemap{position:absolute;inset:0;z-index:4;background:#0e1216}
.livemap .mapboxgl-ctrl-logo{opacity:.85}
.livenote{position:absolute;left:8px;right:8px;bottom:8px;z-index:6;padding:7px 10px;border-radius:6px;font-size:11.5px;line-height:1.45;
  color:#fff;background:rgba(14,18,22,.86);border:1px solid rgba(255,255,255,.18)}
.livenote.warn{background:rgba(120,32,18,.9)}
.livenote .sub{display:block;margin-top:4px;font-size:10.5px;color:#cfd4d8}
.livenote .liveform{display:flex;gap:6px;margin:6px 0 0;align-items:center;flex-wrap:wrap}
.livenote .liveform input{flex:1 1 160px;min-width:0;font:inherit;font-size:12px;padding:5px 7px;border-radius:5px;border:1px solid #888;background:#fff;color:#111}
.liveform.about{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.liveform.about input{flex:1 1 220px;min-width:0;width:auto}
.livenote .mono{font-family:ui-monospace,Menlo,Consolas,monospace}
.satcap.pos{display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center}
.satcap.pos .sub{flex-basis:100%}
.btn.tiny{padding:1px 8px;font-size:11px;min-height:22px}
/* a count that is a button is a thumb's target too — never under 24 px either way (WCAG 2.2, 2.5.8) */
.btn.tiny.cnt{min-width:36px;min-height:24px;padding:2px 10px;font-size:12px}
.satx{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;
  border:2px solid #fff;pointer-events:none;
  box-shadow:0 0 0 2px rgba(0,0,0,.55), 0 0 0 4px var(--glow), 0 0 20px 6px var(--glow-wide),
             0 0 14px rgba(0,0,0,.5)}
.satx:after{content:'';position:absolute;left:50%;top:50%;width:3px;height:3px;margin:-1.5px 0 0 -1.5px;
  border-radius:50%;background:#fff;box-shadow:0 0 0 1.5px rgba(0,0,0,.6)}
.satcap{margin:0;padding:8px 10px 0;font-size:11.5px;line-height:1.5;color:var(--ink2)}
.satcap.sub{color:var(--mute);font-size:11px;padding-top:5px}
.satmsg{margin:4px 0 0;font-size:11.5px;color:var(--mute);line-height:1.5}
.satacts{padding:8px 10px 10px}
@media print{ .sat{break-inside:avoid} .satzs,.satacts,.livemap,.livenote{display:none!important} }

/* ---------------------------------------------------------------------------------- the drop sheet
   Hidden until a driver's sheet is asked for. On screen it sits over the app as a preview; in print it is the
   only thing on the page. Designed for a laser printer in a demountable: black text, one accent, no tints
   that turn to grey mush, and every box a real line. */
#dropsheet{display:none}
#dropsheet *, #dropsheet *::before, #dropsheet *::after{box-sizing:border-box}
/* The app's tables carry min-width:640px so a phone can scroll them sideways. On a sheet of paper there is no
   sideways: that rule pushed the contacts table 3x wider than its column and the phone numbers — the one thing
   a driver needs off that block — off the right edge of the page. */
#dropsheet table{min-width:0;font-size:inherit}
#dropsheet th, #dropsheet td{position:static}
.ds-contacts td{border-right:0}
body.dropping #dropsheet{display:block;position:fixed;inset:0;z-index:50;background:#fff;overflow:auto;
  color:#111;font-size:11.5px;line-height:1.38}
body.dropping .app, body.dropping .drawer, body.dropping .scrim, body.dropping #flash{display:none!important}
.ds-page{width:190mm;margin:0 auto;padding:8mm 0 6mm;display:flex;flex-direction:column;gap:5mm;min-height:277mm}
.ds-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;
  border-bottom:3px solid #ff6a13;padding-bottom:4mm}
.ds-brand{display:flex;align-items:center;gap:10px}
.ds-brand .ds-mark{display:block;width:5px;height:34px;background:#ff6a13;border-radius:2px}
.ds-brand b{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase}
.ds-brand span{display:block;font-size:10.5px;color:#555;margin-top:2px}
.ds-title{text-align:right}
.ds-title span{display:block;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#555}
.ds-title b{display:block;font-size:34px;font-weight:800;line-height:1;letter-spacing:-.02em;margin-top:2px}
.ds-what{display:grid;grid-template-columns:1.75fr .65fr 1fr 1.15fr 1.6fr;gap:0;border:1.5px solid #111;border-radius:6px;
  overflow:hidden}
.ds-cell{padding:8px 11px;border-right:1px solid #999}
.ds-cell:last-child{border-right:0}
.ds-cell label{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.1em;color:#555;font-weight:700}
.ds-cell b{display:block;font-size:15px;line-height:1.15;margin-top:2px}
.ds-cell.wide b{font-size:18px}
.ds-cell span{display:block;font-size:10.5px;color:#555;margin-top:2px}
.ds-where{border:1.5px solid #111;border-radius:6px;overflow:hidden}
.ds-caveat{background:#111;color:#fff;padding:6px 10px;font-size:11px;line-height:1.35}
.ds-qr{position:absolute;left:6px;top:6px;width:22mm;background:#fff;border:1px solid #111;border-radius:3px;padding:2px 2px 1px;
  text-align:center;font:700 7.5px/1.15 system-ui,sans-serif;color:#111;z-index:2;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.ds-qr svg{display:block;width:100%;height:auto} .ds-qr span{display:block;padding:1px 0 1px;text-transform:uppercase;letter-spacing:.03em}
.numlist{list-style:none;margin:0 0 10px;padding:0;display:flex;flex-direction:column;gap:6px}
.numlist li{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.numlist li.lbl{display:block;font-size:12px;color:var(--mute);margin-bottom:2px}
.numlist b{font-size:17px;letter-spacing:-.01em}
.numlist .w{font-size:12px;color:var(--mute)}
.numlist.off b{text-decoration:line-through;opacity:.7}
.btn.sm{padding:3px 9px;font-size:12px}
#damaged{background:#7a1f0b;color:#fff;padding:12px 16px;font-size:14px;line-height:1.45;position:relative;z-index:60}
#damaged b{color:#ffd2bb}
#damaged .btn{margin:8px 8px 0 0}
body.unsaved #flash{outline:2px solid #ff6a13}
.btn.out{text-decoration:none}
.satcap.pos .run{flex-basis:100%;font-size:12px}
.ds-run{margin:0 0 4px;font-size:10.5px;line-height:1.3;padding:3px 6px;background:#f3f3f3;border-radius:4px}
.ds-caveat b{color:#ffb27a}
.ds-pics{display:grid;grid-template-columns:1fr 1fr;gap:0}
.ds-pic{margin:0;border-right:1.5px solid #111}
.ds-pic:last-child{border-right:0}
.ds-crop{position:relative;height:92mm;overflow:hidden;background:#222}
.ds-crop img{position:absolute;max-width:none;-webkit-user-drag:none}
.ds-x{position:absolute;left:50%;top:50%;width:30px;height:30px;margin:-15px 0 0 -15px;border-radius:50%;
  border:3px solid #ff6a13;box-shadow:0 0 0 2px #fff,0 0 0 5px rgba(0,0,0,.45);pointer-events:none}
.ds-x::after{content:'';position:absolute;left:50%;top:50%;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;
  border-radius:50%;background:#ff6a13;box-shadow:0 0 0 1.5px #fff}
.ds-pic figcaption{padding:5px 10px;font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  background:#f2efec;border-top:1px solid #999}
.ds-rose{position:absolute;right:7px;top:7px;width:38px;height:38px;border-radius:50%;background:rgba(0,0,0,.6);
  border:1.5px solid #fff}
.ds-needle{position:absolute;inset:0;transform-origin:50% 50%}
.ds-needle::before{content:'';position:absolute;left:50%;top:9px;width:0;height:0;margin-left:-4px;
  border:4px solid transparent;border-bottom:10px solid #ff6a13}
.ds-cp{position:absolute;left:50%;top:50%;font:800 8px/1 system-ui,sans-serif;color:#fff;text-shadow:0 0 3px #000;
  --cpr:12px}
.ds-rose .ds-cp:first-of-type{color:#ffb27a}
.ds-cols{display:grid;grid-template-columns:1.25fr 1fr;gap:5mm;flex:1}
.ds-col{border:1.5px solid #111;border-radius:6px;padding:8px 10px}
.ds-col h3{margin:0 0 6px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#111;
  border-bottom:2px solid #ff6a13;padding-bottom:3px}
.ds-col h3 + *{margin-top:0}
.ds-col h3:not(:first-child){margin-top:10px}
.ds-col h4{margin:10px 0 4px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#7a2e0a}
.ds-steps{margin:0;padding-left:18px;font-size:10.5px}
.ds-steps li{margin:0 0 3px;line-height:1.3}
.ds-rules{margin:0;padding-left:16px;font-size:9px;color:#333}
.ds-rules li{margin:0 0 2px;line-height:1.3}
.ds-fine{font-size:9px;color:#666;margin:6px 0 0;line-height:1.3}
/* Fixed layout with the widths declared. Nested inside a table cell, an auto-layout table let the name column
   grow until the phone number — the one thing a driver needs off this block — was pushed past the page edge. */
.ds-contacts{width:100%;border-collapse:collapse;font-size:11.5px;table-layout:fixed}
.ds-contacts td{padding:4px 4px 4px 0;border-bottom:1px solid #ddd;vertical-align:top;overflow-wrap:anywhere}
.ds-contacts td:first-child{color:#555;font-size:10px;width:36%}
.ds-contacts td:nth-child(2){width:34%}
.ds-contacts td:last-child{white-space:nowrap;width:30%;text-align:right;font-weight:700;font-size:12px}
.ds-site{font-size:11px;margin:0;line-height:1.45}
.ds-receipt{width:100%;border-collapse:collapse;font-size:10.5px;margin-top:2px;table-layout:fixed}
.ds-receipt td:nth-child(2), .ds-receipt td:nth-child(4){width:29%}
.ds-receipt td{border:1px solid #444;padding:4px 6px;height:24px;vertical-align:bottom}
.ds-receipt td:nth-child(odd){color:#555;font-size:9px;text-transform:uppercase;letter-spacing:.05em;
  width:21%;background:#f2efec;white-space:nowrap}
.ds-receipt td.ds-sig{height:44px}
/* the one-look paper family */
.ds-page.pp{gap:4mm;font-family:'Inter',var(--sans,system-ui,sans-serif)}
.pp-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;border-bottom:2.5px solid #ff6a13;padding-bottom:3mm}
.pp-brand b{display:block;font-size:9pt;letter-spacing:.09em;text-transform:uppercase;color:#111}
.pp-gc{display:block;font-size:22.5pt;font-weight:900;letter-spacing:-.03em;line-height:1;margin-top:1mm;color:#111}
.pp-gc i{font-style:normal;color:#ff6a13;font-size:12pt;margin-left:6px;letter-spacing:0;font-weight:800}
.pp-kind{text-align:right} .pp-kind b{display:block;font-size:9pt;letter-spacing:.09em;text-transform:uppercase;color:#111}
.pp-kind span{display:block;font-size:8pt;letter-spacing:.12em;text-transform:uppercase;color:#666;margin-top:1mm}
.pp-band{font-size:9.5pt;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#5a3d00;background:#FFF0C9;padding:1.6mm 3mm;border-radius:2px;
  -webkit-print-color-adjust:exact;print-color-adjust:exact}
.pp-h1{margin:1mm 0 0;font-size:19.5pt;font-weight:800;letter-spacing:-.03em;line-height:1.05;color:#111}
.pp-sub{margin:0;font-size:10.5pt;color:#555}
.pp-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:3mm}
.pp-tile{padding:3mm 3.5mm 3mm;border-radius:2px;display:flex;flex-direction:column;gap:1mm;-webkit-print-color-adjust:exact;print-color-adjust:exact;
  clip-path:polygon(0 0,calc(100% - 3mm) 0,100% 3mm,100% 100%,3mm 100%,0 calc(100% - 3mm))}
.pp-tile b{font-size:19.5pt;color:#111} .pp-tile span{font-size:9pt;color:#333;font-weight:600}
.pp-tile.pearl{background:#F7F6F3;outline:1px solid #ddd;outline-offset:-1px} .pp-tile.blue{background:#E2EDFF} .pp-tile.amber{background:#FFF0C9} .pp-tile.lilac{background:#F1E6FD}
/* V11 audit, P04: a neutral tile for "no delivery record". It used to wear the amber wash, which on paper is
   the tone this sheet uses for in transit — a colour saying one thing over words saying another. */
.pp-tile.plain{background:#fff;outline:1px dashed #bbb;outline-offset:-1px}
.pp-tile.plain b{color:#333}
.pp-note{margin:0;font-size:10pt;color:#444;line-height:1.45}
.pp-sec{display:flex;align-items:center;gap:3mm;margin:2mm 0 0;font-size:12pt;font-weight:800;letter-spacing:-.01em;color:#111}
.pp-sec span{font-size:9pt;font-weight:800;color:#c8560c;letter-spacing:.06em}
.pp-sec::after{content:'';flex:1 1 auto;height:1px;background:#bbb}
.pp-tbl{width:100%;border-collapse:collapse;font-size:10.5pt}
.pp-tbl th{text-align:left;font-size:9pt;letter-spacing:.1em;text-transform:uppercase;color:#555;padding:1.5mm 2mm;border-bottom:1.5px solid #111}
.pp-tbl td{padding:.9mm 2mm;border-bottom:1px solid #ccc;vertical-align:middle;font-size:10.5pt}
/* THE HANDOVER TABLE HAS FIXED COLUMNS. With auto layout the follow-up sentence "Check with site — nothing
   recorded either way" measured exactly the width of its cell: it sat on one line on the screen the sheet is
   measured on and wrapped to two on the paper, where the same table came out three pixels narrower — so a
   seven-row day printed as two sheets under a footer that said "one sheet" (tester audit, 17 Sep 2026).
   Fixed columns lay out identically in both, and the follow-up column is given the room its sentences need. */
.pp-tbl.pp-hand{table-layout:fixed}
.pp-hand col.c1{width:24%} .pp-hand col.c2{width:28%} .pp-hand col.c3{width:48%}
.ds-page.pp .dstat .hz{width:58px !important;height:22.3px !important}
.pp-tbl tr{break-inside:avoid}
.pp-tbl .dstat{flex-wrap:nowrap;gap:2mm} .pp-tbl .dstat .ds-w{min-width:0;flex:1 1 auto} .pp-tbl .dstat .ds-w em{display:none}
.pp-tbl .rplate{font-size:11pt}
.pp-tbl .pp-nm{display:inline-block;font-size:9pt;color:#555;margin-left:2mm;vertical-align:middle;max-width:62mm;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pp-tbl.dock th{background:#15181C;color:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact} .pp-tbl.dock td{height:8mm}
.pp-two{display:grid;grid-template-columns:1fr 1fr;gap:3mm}
.pp-box{padding:3mm 3.5mm;border-radius:2px;display:flex;flex-direction:column;gap:1.2mm;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.pp-box b{font-size:10.5pt} .pp-box .pp-big{font-size:13pt;font-weight:800;letter-spacing:-.01em;color:#111} .pp-box small{font-size:9pt;color:#444;line-height:1.4}
.pp-box.amber{background:#FFF0C9} .pp-box.blue{background:#E2EDFF}
.pp-dockhead{display:grid;grid-template-columns:auto 1fr 1fr;gap:4mm;align-items:end}
.pp-plate{display:inline-flex;flex-direction:column;justify-content:center;padding:3mm 5mm;background:#FF761B;color:#1b1207;
  clip-path:polygon(0 0,calc(100% - 3mm) 0,100% 3mm,100% 100%,3mm 100%,0 calc(100% - 3mm));-webkit-print-color-adjust:exact;print-color-adjust:exact;outline:1.2pt solid #111;outline-offset:-1.2pt}
.pp-plate b{font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;font-weight:700;font-size:21pt;line-height:.9;text-transform:uppercase}
.pp-plate span{font-size:9pt;letter-spacing:.12em;text-transform:uppercase;font-weight:800;margin-top:1mm}
.pp-field{display:flex;flex-direction:column;gap:1.4mm}
.pp-field label{font-size:9pt;letter-spacing:.1em;text-transform:uppercase;color:#555;font-weight:700}
.pp-rule{display:block;width:100%;height:6.5mm;border-bottom:1.2px solid #333}
.pp-ticks{display:flex;gap:8mm;align-items:center;font-size:10.5pt} .pp-ticks b{font-size:9pt;letter-spacing:.06em;text-transform:uppercase;color:#555}
.pp-ticks span{display:inline-flex;align-items:center;gap:2mm} .pp-bx{display:inline-block;width:4.2mm;height:4.2mm;border:1.4px solid #222;border-radius:1px}
.pp-foot{display:flex;flex-direction:column;gap:1mm;font-size:9pt;color:#555;border-top:1px solid #999;padding-top:2mm;line-height:1.4}
.pp-foot b{color:#111}
/* The four provenance facts, each named and each separate. They wrap as a row of labelled pairs rather than a
   run-on sentence, because the one somebody looks for — when the record was last confirmed — has to be findable
   without reading the other three. */
.pp-prov{display:flex;flex-wrap:wrap;gap:.8mm 4mm}
.pp-prov b{font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:8pt;color:#111;margin-right:1mm}
.pp-pages{font-weight:700;color:#111}
/* Said at the top, where somebody lifting paper off a printer sees it, not only in the footer they will not
   reach if the last sheet is the one that went missing. */
.pp-cont{font-size:9.5pt;font-weight:700;line-height:1.35;color:#5a3d00;background:#FFF0C9;border:1.2px solid #E0A83C;
  border-radius:2px;padding:1.6mm 3mm;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.ds-foot{display:flex;justify-content:space-between;gap:14px;font-size:8px;color:#666;
  border-top:1px solid #999;padding-top:3mm;line-height:1.4}
.ds-foot span:last-child{text-align:right;max-width:58%}
.ds-none{padding:14px;font-size:13px;margin:0}
/* what the rental system holds against a row or an asset — a second document, boxed as its own source */
/* the precision tags */
.ptags{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:6px;margin-top:9px}
.ptag{display:inline-flex;flex-direction:column;gap:1px;padding:6px 10px 6px;border-radius:9px 0 9px 0;min-width:96px;border:1px solid transparent;
  clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px))}
.ptag small{font:700 9px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase;opacity:.75}
.ptag b{font-size:12.5px;font-weight:800;letter-spacing:-.01em;line-height:1.2}
.ptag.src{background:var(--sem-plan-bg);color:var(--sem-plan-ink)}
.ptag.rev{background:var(--sem-change-bg);color:var(--sem-change-ink)}
.ptag.loc{background:var(--sem-gap-bg);color:var(--sem-gap-ink)}
/* F08: "Kept in" is a fact about the RECORD, so it takes a record tone; "This link" is a fact about this copy
   of the page, so it is the plain bordered one and never coloured like evidence. */
.ptag.kept{background:var(--sem-ok-bg, var(--green-soft));color:var(--sem-ok-ink, var(--green))}
.ptag.sync{background:var(--paper);color:var(--ink);border-color:var(--rule);clip-path:none;border-radius:9px 0 9px 0}
@media print{ .ptag{ background:#fff !important; color:#000 !important; border:1px solid #777; clip-path:none } }
/* the pit boards */
.pitgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%, 300px),1fr));gap:12px;margin:10px 0 12px;align-items:start}
.pitboard{--cut:18px}
.pitboard > .face{padding:14px 16px 14px;display:flex;flex-direction:column;gap:9px}
.pitboard .pbk{font:600 10.5px/1.35 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.22em;text-transform:uppercase;color:rgba(246,241,236,.62)}
.pitboard .pbpill{display:flex;gap:6px;flex-wrap:wrap;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.12)}
.pitboard .pbnum{font-size:54px;color:#fff;letter-spacing:-.01em;margin:2px 0 0;text-transform:uppercase}
.pitboard .pbwhat{font-size:12.5px;color:rgba(246,241,236,.8);line-height:1.45;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.12)}
.pitboard .pbwhat b{color:#fff} .pitboard .pbar{color:rgba(246,241,236,.55)}
.pitboard .pbrefs{display:flex;flex-direction:column;gap:8px}
.pitboard .pbref{display:flex;align-items:center;gap:12px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.1)}
.pitboard .pbref .plateb .rplate{box-shadow:0 2px 8px -2px rgba(255,106,19,.55)}
.pitboard .pbname{font-size:15px;font-weight:700;color:#fff;letter-spacing:-.01em;overflow-wrap:anywhere}
.pitboard .pbnone{font-size:12px;color:rgba(246,241,236,.62);line-height:1.4;padding:6px 0}
.pitboard .pbdrop{display:flex;gap:8px;align-items:baseline;font-size:12px;color:rgba(246,241,236,.7)}
.pitboard .pbdrop b{color:#fff}
.pitboard .pbev{display:flex;align-items:center;gap:12px;padding:8px 0 4px;border-top:1px solid rgba(255,255,255,.1)}
.pitboard .pbev > span{font-size:12px;line-height:1.35;color:rgba(246,241,236,.78);padding-left:12px;border-left:1px solid rgba(255,255,255,.18)}
.pitboard .pbev .dstat{flex:0 0 auto}
.pitboard .pbacts{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
.pitboard .btn{background:#2f2823;border-color:rgba(255,255,255,.22);color:#f6f1ec}
.pitboard .btn:hover{border-color:var(--orange)}
.pitboard .btn.primary{background:var(--orange);border-color:var(--orange);color:#1b1207}
.pitboard a.btn{color:#f6f1ec} .pitboard a.btn i{font-style:normal;color:var(--orange);margin-left:4px}
.loadrow{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:4px 0 8px;font-size:12px;
  padding-left:52px}
.loadrow .btn.tiny{padding:3px 8px}
@media (max-width:640px){.loadrow{padding-left:0}}
.onhire{border:1px solid var(--rule);border-left:3px solid var(--navy);border-radius:8px;
  background:var(--navy-soft);padding:8px 10px;margin:8px 0 0;font-size:12.5px}
.onhire-h{font-weight:700;font-size:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:5px}
.onhire-l{margin:0;padding-left:16px;line-height:1.5}
.onhire-l li{margin:0 0 2px;overflow-wrap:anywhere}
.onhire-w{margin:5px 0 0;font-size:11.5px;color:var(--slate);line-height:1.4}
.onhire .acts{margin-top:6px}
.ds-close{position:fixed;top:12px;right:12px;z-index:51}
/* the delivery advice's tables — the same page as the drop sheet, a list instead of a map */
.ad-tbl{width:100%;border-collapse:collapse;font-size:10.5px;table-layout:fixed}
.ad-tbl th{text-align:left;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:#555;
  border-bottom:1.5px solid #111;padding:3px 5px 3px 0}
.ad-tbl td{border-bottom:1px solid #ddd;padding:4px 5px 4px 0;vertical-align:top;overflow-wrap:anywhere}
.ad-tbl .mono{font-variant-numeric:tabular-nums}
.ad-w{color:#666;font-size:9px}
.ad-h{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#7a2e0a;font-weight:800;margin:0 0 3px}
.ad-tick{color:#0a7a33;font-weight:800}
.ad-small td, .ad-small th{font-size:9.5px}
/* The schedule's own delivery notes — "Crane onsite", "Not Torrens" — and the block a driver must read before
   the gate. The block is Coates' instruction and is boxed in Coates orange so it cannot be mistaken for one of
   iEDM's rules further down, which are boxed in black. */
.ds-dd{margin:0;font-size:11px;padding:5px 10px;border:1px dashed #444;border-radius:6px;background:#fafafa}
.ds-safe{border:2px solid #ff6a13;border-radius:6px;padding:5px 11px 5px;background:#fff7f1}
.ds-safe-lead{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#b34a0d;font-weight:800;margin-bottom:3px}
.ds-safe ul{margin:0 0 3px;padding-left:16px;font-size:11px;line-height:1.35}
.ds-safe li{margin:0}
.ds-safe-who{font-size:9.5px;color:#555;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ds-safe-who .tl{font-size:10px;color:#111}
.ds-safe-who .tl i{width:9px;height:9px;border-width:1.5px}

/* One page, portrait, always. The app itself prints landscape; the sheet declares its own. */
/* ---------------------------------------------------------------------------------- documents
   SWMS, drawings, plates and packs as a library: a picture of the first page, what it is, how big, and the two
   things a person wants — open it, print it. Cards sit in a grid that becomes one column on a phone. */
.docsec{margin:0 0 18px}
.docsec > .hubtitle{margin:0 0 8px}
.docsec > .hubtitle h3{margin:0;font-size:17px}
.docgroup{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin:14px 0 8px}
/* listed vs openable, in the heading, where it cannot be scrolled past */
.rowsoff{margin:10px 0 0}
.rowsoff summary{cursor:pointer;font-size:12.5px;color:var(--slate);padding:6px 0}
.rowsoff summary b{color:var(--ink);font-variant-numeric:tabular-nums}
.rowsoff tr.off td{color:var(--mute)} .rowsoff tr.off td b{color:var(--ink2);font-weight:600}
.docavail{margin-top:3px;font-variant-numeric:tabular-nums}
.docavail.short b{color:var(--sem-gap-ink)}
@media print{ .docavail{ display:block !important; color:#000 !important; font-size:9pt !important } }
.docgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%, 330px),1fr));gap:12px;align-items:start}
/* Board 3: one card shell — the kind on an orange tab, the slashes opposite, the cover left, the words right */
.doccard{--cut:15px}
.doccard > .face{display:flex;flex-direction:column;gap:0;padding:0 0 12px;position:relative}
.doccard .dockind{display:inline-flex;align-self:flex-start;align-items:center;font:800 10.5px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase;
  color:#1b1207;background:linear-gradient(152deg,#FF8E35 0%,#FF761B 48%,#FF6A13 100%);padding:7px 22px 7px 12px;
  clip-path:polygon(0 0,calc(100% - 12px) 0,100% 100%,0 100%)}
.doccard .slash.doc{position:absolute;right:12px;top:8px;color:var(--orange);font-size:15px}
.doccard .docbody{display:flex;gap:14px;padding:12px 12px 0;min-width:0}
.docpreview-shell{display:block;position:relative;min-height:72px}
.docpreview-status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:8px;text-align:center;font-size:11px;color:var(--mute);background:var(--tint2);pointer-events:none}
.docpreview-shell .thumb{position:relative;opacity:0}
.docpreview-shell .thumb.is-ready{opacity:1}
.doccard .doccover{flex:0 0 118px;max-width:38%}
.doccard .doccover.portrait{flex-basis:104px}
.doccard .thumb{display:block;width:100%;aspect-ratio:1.414/1;object-fit:cover;object-position:top left;background:var(--tint);
  border:1px solid var(--rule2);border-radius:6px;cursor:pointer;box-shadow:0 2px 6px -2px rgba(0,0,0,.35)}
.doccard .doccover.portrait .thumb{aspect-ratio:1/1.414}
.doccard .thumb.none{display:flex;align-items:center;justify-content:center;color:var(--mute);font-size:12px;cursor:default;aspect-ratio:1/1.414}
.doccard .docmain{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:6px}
.doccard h4{margin:0;font-size:15px;line-height:1.25;font-weight:800;letter-spacing:-.01em;text-wrap:balance}
.doccard .docsub{font-size:12px;color:var(--mute);line-height:1.4}
.doccard .docpills{display:flex;flex-wrap:wrap;gap:6px}
.doccard .docpills .pill{gap:6px}
.doccard .pipdot{width:8px;height:8px;border-radius:50%;background:currentColor;display:inline-block;flex:0 0 auto;box-shadow:0 0 6px currentColor}
.doccard .pill.gap .pipdot{background:transparent;border:2px solid currentColor;box-shadow:none;width:6px;height:6px}
.doccard .docrev{display:flex;flex-direction:column;gap:1px;font-size:12px;line-height:1.35}
.doccard .docrev b{font-size:12.5px;color:var(--ink)} .doccard .docrev span{color:var(--mute)}
.doccard .meta{font-size:11.5px;color:var(--mute);line-height:1.45}
.doccard .meta b{color:var(--ink2);font-weight:600}
.doccard .note{font-size:12px;color:var(--ink2);line-height:1.4;margin-top:6px}
.doccard .acts{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.doccard .acts .btn{padding:8px 12px;font-size:12.5px;font-weight:700}
.doccard .absent{font-size:11.5px;color:var(--sem-gap-ink, #7a5200);font-weight:600;line-height:1.4}
.doccard .docmore{padding:10px 12px 0;border-top:1px dashed var(--rule);margin:10px 12px 0}
.doccard.offsvc .doccover{opacity:.55}
.doccard:hover{--edge:var(--orange-lt);box-shadow:var(--lift)}
.docsheets{font-size:11.5px;color:var(--mute);line-height:1.5;margin:0;padding-left:16px}
.docadd{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0 0}
.docadd input[type=text]{flex:1 1 180px;min-width:0;padding:8px 10px;border:1px solid var(--rule);border-radius:8px;font:inherit;background:var(--paper);color:var(--ink)}
.docadd input[type=file]{font-size:12px;max-width:100%}
.docadd select{max-width:100%;padding:7px 8px;border:1px solid var(--rule);border-radius:8px;font:inherit;background:var(--paper);color:var(--ink)}
.docadd [hidden]{display:none!important}
.docsec > .hubtitle .docaddhere{margin-left:auto}
@keyframes docaddflash{0%{box-shadow:0 0 0 3px var(--orange)}100%{box-shadow:0 0 0 0 transparent}}
.docaddflash{animation:docaddflash .9s ease-out 1}
@media (prefers-reduced-motion:reduce){.docaddflash{animation:none}}
.docjump{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
@media (max-width:520px){ .docgrid{grid-template-columns:1fr} .doccard h4{font-size:14px} .doccard .doccover{flex-basis:88px} .doccard .doccover.portrait{flex-basis:78px} }
/* the map on a phone: one sheet selector, the help folded, the filters under the map so the map is the first thing */
.sheetsel{display:none} .sheetsel select{padding:9px 10px;border:1px solid var(--rule);border-radius:8px;background:var(--paper);color:var(--ink);font:inherit;max-width:100%}
.mapabout summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:6px}
.mapabout summary::-webkit-details-marker{display:none}
.mapabout summary::before{content:'▸';font-size:11px;color:var(--mute)} .mapabout[open] summary::before{content:'▾'}
.mapabout summary b{display:inline;margin:0}
@media(max-width:640px){
  .sheetsel{display:block;flex:1 1 100%} .sheetbtn{display:none}
  .mapcard{display:flex;flex-direction:column} .mapcard .maptools{order:1} .mapcard .mapstage{order:2} .mapcard .lightbar{order:3;margin:10px 0 0} .mapcard .maphint{order:4}
  #folderBtn{display:none}
}
/* the choice when a tap could mean more than one asset */
.mkpick{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);width:min(440px,calc(100% - 24px));background:var(--paper);border:1px solid var(--rule);
  border-radius:14px;box-shadow:var(--lift-hi);z-index:45;padding:8px 8px 10px;max-height:60vh;overflow:auto}
.mkpick-h{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:13px;padding:4px 6px 8px}
.mkpick-i{display:flex;align-items:center;gap:8px;width:100%;text-align:left;padding:10px 10px;border:1px solid var(--rule);border-radius:10px;background:var(--tint2);font:inherit;cursor:pointer;margin-top:6px;min-height:44px}
.mkpick-i:hover, .mkpick-i:focus-visible{border-color:var(--orange);box-shadow:0 0 0 3px var(--glow-wide);outline:none}
.mkpick-i span{flex:1 1 auto;min-width:0;overflow-wrap:anywhere} .mkpick-i .w{flex:0 0 auto;font-size:11px;color:var(--mute)}
.mkpick-i.w{cursor:default;color:var(--mute);font-size:12px}
.mkpick-i b{display:block} .mkpick-i .w{display:block;flex:1 1 100%;font-size:11px;color:var(--mute)}
.mkpick .uform{padding:0 4px 4px}
.mkpick-or{display:flex;align-items:center;gap:8px;margin:8px 4px 2px;color:var(--mute);font-size:11px;text-transform:uppercase;letter-spacing:.1em}
.mkpick-or::before,.mkpick-or::after{content:'';flex:1 1 auto;height:1px;background:var(--rule)}
/* the unit form, in the drawer and on the map */
.uadd{margin-top:8px} .uadd > summary{cursor:pointer;font-size:12.5px;font-weight:700;color:var(--orange-ink);padding:4px 0}
.uadd > summary:hover{text-decoration:underline}
.uform .hint{font-size:11px;color:var(--mute)}
.unitlist li .btn.sm{margin-left:auto;padding:3px 8px;font-size:11.5px}
/* on a phone the tick grows to a thumb's size (the row instrument grows with it, see .dstat.sm.ctl) */
@media (pointer:coarse){ .tickbtn.sm{width:34px;height:34px} }
/* the sheet print: the drawing picture the map tab already holds, on one landscape page with a title strip */
#sheetprint{display:none}
/* ---------------------------------------------------------------- one page per drop, on paper
   Andrew Fisher, 13 Sep 2026: one page for each asset or location, because there are likely to be different
   drivers and truck drivers. One A4 a driver can be handed: the map location and the asset number as two
   labelled fields, a crop of the drawing with the callout ringed, and a ruled space anywhere a number has not
   been recorded — so a blank reads as "write it here" and never as nothing. */
#dayprint{display:none}
/* MEASURED AT THE PAPER'S WIDTH, WHATEVER THE SCREEN'S. The tester audit of 16 Sep 2026 printed the day's drop
   sheets from a 390 px phone: max-width:100% laid the sheets out 390 px wide, every one of them ran past one A4
   in that narrow column, and the preflight told the driver all fifteen were "longer than one A4 page" — on a
   laptop the same fifteen fit. The crops were cut for that narrow width too. While the sheets are being fitted
   and printed they are laid out at 190 mm, the paper's own width; the phone's screen is behind the print
   dialog for that moment and may scroll sideways, which is nothing against a false verdict. */
body.printing-day #dayprint{display:block;position:static;max-width:none}
body.printing-day .app, body.printing-day header.top, body.printing-day #drawer, body.printing-day .drawer, body.printing-day footer{display:none!important}
/* POINTS, NOT CSS PIXELS, ON EVERYTHING THAT GOES ON PAPER.

   V11 audit: this sheet was typed in CSS pixels, and a CSS pixel is 1/96 inch, so `font-size:8px` on a printed
   page is SIX POINT. The delivery steps were 7.9pt, the captions 6.4pt and the footer 6pt — set in a truck at
   night, in the rain, by somebody who left their reading glasses in the ute. The rule now is: anything a person
   reads on this sheet is at least 10pt, labels and captions at least 9pt, and it is written in the unit it is
   measured in so nobody has to divide by 1.333 to know what they are looking at. Display type was converted at
   its exact optical equivalent (px x 0.75) so the design did not move, only the honesty of the unit.

   What is NOT converted: the compass letters, the scale bar and the caption inside a QR box. Those are drawn ON
   a photograph and are sized against the picture by cropFit, not against a reader — making them 9pt would put
   furniture over the street the picture is printed to show.

   The words growing means the pictures shrink, because fitPages finds the largest picture scale that still
   leaves one drop on one sheet. That is the right way round: nobody was ever hurt by a smaller aerial. */
#dayprint{font:10pt/1.34 var(--sans, system-ui, sans-serif);color:#111;background:#fff;
  width:190mm;max-width:100%;margin:0 auto}   /* A4 portrait less the margins dayPrint sets: the paper's own width */
/* The screen's `.mono{font-size:11.5px}` leaked onto the paper, so the one thing on the sheet a driver dials
   - the phone numbers - printed at 8.6pt inside a band set to 9. On paper the monospaced face keeps its family
   and takes the sheet's own size. */
#dayprint .mono{font-size:inherit}
#dayprint .rs-page{break-after:page;page-break-after:always;break-inside:avoid;padding-bottom:1mm}
#dayprint .rs-page:last-child{break-after:auto;page-break-after:auto}
/* the heading */
#dayprint .rs-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8mm;
  border-bottom:3px solid #ff6a13;padding-bottom:1.4mm;margin-bottom:1.6mm}
#dayprint .rs-hl{min-width:0}
#dayprint .rs-brand{font-size:9pt;letter-spacing:.11em;text-transform:uppercase;color:#555;margin-bottom:.5mm;line-height:1.2}
#dayprint h1{font-size:13.5pt;letter-spacing:-.015em;margin:0 0 .5mm;line-height:1.08}
#dayprint .rs-sub{font-size:9pt;color:#3a3a3a;line-height:1.25}
#dayprint .rs-r{font-size:9pt;color:#555;text-align:right;line-height:1.3;white-space:nowrap}
#dayprint .rs-r b{display:block;font-size:10pt;color:#111;margin-top:.5mm}
#dayprint .rs-ref{display:inline-block;font-family:var(--mono, ui-monospace, monospace);font-size:10.5pt;color:#111;
  border:1px solid #666;border-radius:2px;padding:.6mm 2mm;letter-spacing:.02em}
/* a field. Every box on this sheet is one, so the base comes first and the variants after it — a variant that
   sits above its base at the same weight is quietly undone by it. */
#dayprint .rs-f{border:1.1px solid #6d6d6d;border-top:2.5px solid #333;border-radius:2px;
  padding:.9mm 2.4mm 1.1mm;margin-bottom:1.2mm}
#dayprint .rs-f.wide{width:100%}
#dayprint .rs-l{display:block;font-size:9pt;letter-spacing:.11em;text-transform:uppercase;color:#555;font-weight:700;margin-bottom:.5mm;line-height:1.2}
#dayprint .rs-v{font-size:10pt;line-height:1.28}
#dayprint .rs-sup{display:block;font-size:9pt;color:#4a4a4a;margin-top:.7mm;line-height:1.26}
#dayprint .rs-sup.rs-warn{color:#a4320a;font-weight:700}
#dayprint .rs-none{display:block;font-size:10pt;color:#555;font-style:italic}
#dayprint .rs-hint{display:block;font-size:9pt;color:#666;margin-top:.6mm}
#dayprint .wr{display:block;width:100%;border-bottom:1.2px solid #333;height:5.5mm;margin-top:.7mm}
#dayprint .rs-grid{display:flex;gap:4mm;align-items:stretch}
#dayprint .rs-grid > .rs-f{flex:1;min-width:0}
/* the two numbers. Same box, same height, in the same two places on every page, whether they are filled in or
   ruled for writing — so a driver's eye lands where it landed on the last one. Andrew Fisher, 12 Sep 2026: very
   clear — the map location number, and the asset number where there is one. */
#dayprint .rs-id{display:flex;gap:4mm;margin-bottom:1.2mm;align-items:stretch}
#dayprint .rs-id > .rs-f{flex:1;min-width:0;margin-bottom:0}
#dayprint .rs-f.rs-key{border:1.4px solid #222;border-top:4px solid #ff6a13;background:#fafafa;
  min-height:17mm;display:flex;flex-direction:column}
#dayprint .rs-key .rs-v{flex:1;display:flex;flex-direction:column;justify-content:center}
/* the plate and its callout line sit side by side, so the box stays the height it always was */
#dayprint .rs-plated .rs-v{flex-direction:row;align-items:center;gap:3mm;flex-wrap:wrap}
#dayprint .rs-plated .rs-v .rs-sup{margin-top:0;flex:1 1 30mm}
#dayprint .rs-key .wr{height:7mm}
/* the reference on paper is the same orange plate it is on every screen — Board 5: "orange reference plates" */
#dayprint .rs-big{display:inline-block;font-family:'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;font-weight:700;
  font-size:27px;line-height:.9;letter-spacing:-.01em;padding:1mm 2.6mm 1.2mm;color:#1b1207;background:#FF761B;
  clip-path:polygon(0 0,calc(100% - 3mm) 0,100% 3mm,100% 100%,3mm 100%,0 calc(100% - 3mm));
  -webkit-print-color-adjust:exact;print-color-adjust:exact;outline:1.2pt solid #111;outline-offset:-1.2pt;margin-bottom:1mm}
#dayprint .rs-band{font-size:9.5pt;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#5a3d00;background:#FFF0C9;
  padding:1.4mm 2.6mm;border-radius:2px;margin-bottom:2mm;-webkit-print-color-adjust:exact;print-color-adjust:exact}
/* the site record sits in the heading's right-hand block, under the page count — the one place on the sheet
   with room to spare, so the pictures under it keep every millimetre of their paper */
#dayprint .rs-rec{display:flex;align-items:center;gap:2mm;align-self:center;flex:0 0 auto;max-width:74mm;white-space:normal}
#dayprint .rs-rec .dstat{flex-wrap:nowrap;gap:1.5mm} #dayprint .rs-rec .dstat .ds-w{min-width:0;flex:0 1 auto;text-align:left}
#dayprint .rs-rec .dstat .ds-w b{font-size:9pt;white-space:nowrap} #dayprint .rs-rec .dstat .ds-w em{display:block;font-size:9pt;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:52mm}
#dayprint .rs-sec{display:flex;align-items:center;gap:2.6mm;margin:.2mm 0 .8mm;font-size:10.5pt;font-weight:800;letter-spacing:-.01em;color:#111;line-height:1.1}
#dayprint .rs-sec span{font-size:9pt;font-weight:800;color:#c8560c;letter-spacing:.06em;font-variant-numeric:tabular-nums}
#dayprint .rs-sec::after{content:'';flex:1 1 auto;height:1px;background:#999}
#dayprint .rs-nums{display:flex;flex-wrap:wrap;gap:0 5mm}
#dayprint .rs-num{font-size:16pt;line-height:1.2;font-family:var(--mono, ui-monospace, monospace);letter-spacing:-.02em;font-weight:700}
/* v5.71 — A LONG LIST OF NUMBERS IS SET SMALLER SO THE DROP STAYS ON ONE SHEET. Andrew Fisher gave WC07's
   twenty toilet asset numbers on 22 Sep 2026; at sixteen point they cost 179 points of column and pushed the
   page to 1,093 against A4's 1,043. One drop is one page, and that rule is older than this list. Eleven point
   is still well clear of the nine-point floor this sheet holds everything else to, and a driver reading twenty
   numbers is checking them off a plate rather than reading them across a yard. */
#dayprint .rs-nums.many{gap:0 3mm}
#dayprint .rs-nums.many .rs-num{font-size:11pt;line-height:1.3}
#dayprint .rs-qty{font-size:16pt;line-height:1.2;font-weight:700}
#dayprint .rs-where{display:block;font-size:13pt;line-height:1.18;letter-spacing:-.01em;font-weight:700}
/* F05: no destination on the record. Set smaller than a real one and ruled underneath, so the sheet reads as an
   instruction to go and find out rather than as a place with a strange name. */
#dayprint .rs-nodest{font-size:10pt;font-weight:600;line-height:1.35;color:#000}
/* the source, on the field's own label line, in the label's tone and case */
#dayprint .rs-lsrc{font-weight:600;letter-spacing:.02em;text-transform:none;opacity:.72;margin-left:6px}
#dayprint .rs-lsrc::before{content:'· '}
/* what gets written on site */
#dayprint .rs-sign{border:1.2px dashed #777;border-radius:2px;padding:1.8mm 2.2mm .3mm;margin-bottom:2.4mm;background:#fbfbfb}
#dayprint .rs-sl{font-size:9pt;letter-spacing:.11em;text-transform:uppercase;color:#666;font-weight:700;margin-bottom:.5mm;line-height:1.2}
#dayprint .rs-sign .rs-f{background:#fff;padding:1.3mm 2.2mm 1.4mm}
#dayprint .rs-f.rs-tick{text-align:center}
#dayprint .bxx{display:inline-block;width:11mm;height:11mm;border:1.6px solid #222;border-radius:1.5px;background:#fff;margin-top:.5mm}
/* the aerial photograph, cropped round the drop — wide to orient, close to find it */
#dayprint .rs-map{margin:0 0 1.2mm}
#dayprint .rs-pics{display:grid;gap:0;border:1.4px solid #222;overflow:hidden}
#dayprint .rs-pics{border-radius:2px;grid-template-columns:1fr}
#dayprint .rs-pics.n2{grid-template-columns:1fr 1fr}
#dayprint .rs-pics.n3{grid-template-columns:1fr 1fr 1fr}
/* Four pictures go two by two rather than four across. Four across on an A4 page is 47 mm a picture, which is
   too narrow to read a street name in; two by two is nearly 100 mm each, which is not. */
#dayprint .rs-pics.n4{grid-template-columns:1fr 1fr}
#dayprint .rs-fig{margin:0;min-width:0;border-right:1.4px solid #222}
#dayprint .rs-fig:last-child{border-right:0}
#dayprint .rs-pics.n4 .rs-fig:nth-child(2n){border-right:0}
#dayprint .rs-pics.n4 .rs-fig:nth-child(-n+2){border-bottom:1.4px solid #222}
#dayprint .rs-win{position:relative;overflow:hidden;width:100%;background:#222}
/* The drop's own photographs, two across. A separate class from .rs-win on purpose: .rs-win images are the
   aerial and the drawing, and they are CUT to the drop by cropFit before the dialog opens — a photograph of
   the unit is already framed on what matters and must be left whole. 4:3, because that is what a phone holds
   the wrong way up produces, and letterboxing it is better than cutting the top off a cabin. */
#dayprint .rs-shots{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1.4px solid #222;border-radius:2px;
  overflow:hidden;margin:0 0 1.8mm}
#dayprint .rs-shots .rs-fig:only-child{grid-column:1 / -1}
/* V11 audit: the comment above said "letterboxing it is better than cutting the top off a cabin" and the rule
   underneath it said `cover`, which cuts. A 3000x4000 portrait — a phone held upright, which is how most of
   these arrive — loses 43.75% of its height in a 4:3 frame under `cover`, and the half it loses is the top:
   the roof, the branding, the lifting points. `contain` keeps the whole photograph and pays for it in two
   light bars. The matte is light, not #222: an inked black band either side of every portrait photograph on
   every sheet is toner spent on nothing, and a grey field reads as "this is the edge of the picture" just as
   clearly. The aerial and the drawing are .rs-win and are still deliberately cut to the drop by cropFit. */
#dayprint .rs-shot{position:relative;overflow:hidden;width:100%;aspect-ratio:4/3;background:#edeae6}
#dayprint .rs-shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center}
#dayprint .rs-tag.live{text-transform:uppercase;letter-spacing:.07em}
#dayprint .rs-pics .rs-win{aspect-ratio:61/50}
#dayprint .rs-sheet{background:#f4f4f4}
#dayprint .rs-cap .rs-warn{color:#a4320a}
#dayprint .rs-win img{position:absolute;max-width:none}
#dayprint .rs-fig figcaption{padding:.7mm 2mm;line-height:1.2;font-size:9pt;font-weight:700;letter-spacing:.04em;
  text-transform:uppercase;background:#f2efec;border-top:1px solid #8a8a8a;color:#222;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* the photograph's caption carries a reference, a time and a name, which will not fit on one line at 8.5px —
   it wraps rather than being cut off, because the time is the half that gets cut and the time is the point */
#dayprint .rs-shots figcaption{white-space:normal;text-transform:none;letter-spacing:0;font-weight:600;
  line-height:1.2;font-size:9pt}
#dayprint .rs-shots figcaption b{text-transform:uppercase;letter-spacing:.04em;font-weight:800}
#dayprint .rs-x{position:absolute;width:6.5mm;height:6.5mm;margin:-3.25mm 0 0 -3.25mm;border-radius:50%;
  border:.8mm solid #ff6a13;box-shadow:0 0 0 .35mm #fff, 0 0 0 .9mm rgba(0,0,0,.45);pointer-events:none}
#dayprint .rs-x::after{content:'';position:absolute;left:50%;top:50%;width:1.6mm;height:1.6mm;margin:-.8mm 0 0 -.8mm;
  border-radius:50%;background:#ff6a13;box-shadow:0 0 0 .4mm #fff}
/* All four points, not just north — a driver reads a direction off the paper instead of working it out at the
   wheel. The rose is a shade bigger than it was to make room for the letters and still read at arm's length. */
#dayprint .rs-rose{position:absolute;right:2mm;top:2mm;width:10.5mm;height:10.5mm;border-radius:50%;
  background:rgba(0,0,0,.74);border:.35mm solid #fff;z-index:2}
#dayprint .rs-needle{position:absolute;inset:0;transform-origin:50% 50%}
#dayprint .rs-needle::before{content:'';position:absolute;left:50%;top:2.2mm;width:0;height:0;margin-left:-.9mm;
  border:.9mm solid transparent;border-bottom:2.4mm solid #ff6a13}
#dayprint .rs-cp{position:absolute;left:50%;top:50%;font:800 6.5px/1 system-ui,sans-serif;color:#fff;
  text-shadow:0 0 2px #000;letter-spacing:.02em}
#dayprint .rs-rose .rs-cp:first-of-type{color:#ffc79a}
/* The box grew from 14mm to 17mm when the quiet zone went from two thirds of a module to the four the standard
   asks for. It had to: the quiet zone is part of the symbol, so leaving the box at 14mm would have paid for
   the correct margin by shrinking the data modules from about 0.40mm to 0.32mm, and a 0.32mm module is where a
   phone camera starts failing on paper under a work light. Correct quiet zone AND a readable module, or the
   fix is only correct on the page it is measured on. */
#dayprint .rs-qr{position:absolute;left:2mm;top:2mm;width:var(--qr,17mm);background:#fff;border:.3mm solid #111;
  border-radius:1mm;padding:.5mm .5mm .3mm;text-align:center;font:700 6px/1.15 system-ui,sans-serif;color:#111;z-index:2;
  box-shadow:0 0 1.2mm rgba(0,0,0,.5)}
#dayprint .rs-qr svg{display:block;width:100%;height:auto}
#dayprint .rs-qr span{display:block;font-size:6pt;padding:.3mm 0;text-transform:uppercase;letter-spacing:.02em}
#dayprint .rs-cap{font-size:9pt;color:#3a3a3a;margin-top:.7mm;line-height:1.26}
#dayprint .rs-cap b{color:#111}
/* The whole circuit. The dimming is eased right off — at this zoom a hard spotlight hides the streets that make
   the picture worth printing — and the ring is smaller so it reads as a pin rather than swallowing the site. */
#dayprint .rs-site .rs-spot{background:radial-gradient(ellipse closest-side at var(--x,50%) var(--y,50%),
  rgba(0,0,0,0) 0 30%, rgba(0,0,0,.22) 78%)}
#dayprint .rs-site .rs-x{width:5mm;height:5mm;margin:-2.5mm 0 0 -2.5mm;border-width:.7mm}
/* Crosshairs to the edges of the picture, so the pin is found in a glance rather than hunted for. Only on the
   site view: on the close pictures the ring is already the biggest thing in the frame. Both lines hang off the
   ring itself, so wherever the ring is put the cross follows, and the window clips them at its own edges. */
#dayprint .rs-site .rs-x::before{content:'';position:absolute;left:50%;top:50%;width:400mm;height:400mm;
  margin:-200mm 0 0 -200mm;
  background:
    linear-gradient(to right, rgba(255,106,19,.85) 0 100%) center/100% .3mm no-repeat,
    linear-gradient(to bottom, rgba(255,106,19,.85) 0 100%) center/.3mm 100% no-repeat}
/* the transport and lifting documents: one code, the names beside it */
/* Andrew Fisher, 13 Sep 2026: a clear bordered box near the delivery instructions. So: a box with
   a real border of its own, sitting directly under the steps rather than dropped in the footer. */
#dayprint .rs-docs{display:flex;gap:2.4mm;align-items:center;border:1.4px solid #222;
  border-left:2.8mm solid #ff6a13;border-radius:2px;padding:.7mm 2.2mm;margin-bottom:1.2mm;background:#fff}
/* 16mm -> 19mm for the same reason the navigation code grew: four modules of quiet zone are part of the symbol
   and have to be paid for in width, not out of the data modules. The panel is already white, so the quiet zone
   has clear paper around it on all four sides. */
#dayprint .rs-dq{width:19mm;flex:0 0 19mm;text-align:center;font:700 5.6px/1.15 system-ui,sans-serif;
  color:#111;text-transform:uppercase;letter-spacing:.02em}
#dayprint .rs-dq svg{display:block;width:100%;height:auto}
#dayprint .rs-dq span{display:block;font-size:6.5pt;padding-top:.4mm}
#dayprint .rs-dt{min-width:0;font-size:9pt;line-height:1.3;color:#333}
#dayprint .rs-dt > b{display:block;color:#111;font-size:10pt;margin-bottom:.2mm;line-height:1.2}
#dayprint .rs-dt span{display:block;color:#333}
#dayprint .rs-dt .rs-dh{display:inline;color:#111;font-size:9pt;margin:0}
#dayprint .rs-dt .rs-dh.rs-warn{color:#a4320a}
#dayprint .rs-dt em{display:block;font-style:normal;color:#4a4a4a;font-size:9pt;margin-top:.4mm}
#dayprint .rs-inline{font-style:normal;font-size:9pt;color:#555;margin-left:3mm}
#dayprint .rs-rules{font-size:9.5pt;color:#333;border-left:2.5px solid #ff6a13;padding-left:2.5mm;margin:.8mm 0 0;line-height:1.26}
/* the spotlight: everything but the callout is dimmed, so the one you want is the one you see */
#dayprint .rs-spot{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse closest-side at var(--x,50%) var(--y,50%),
    rgba(0,0,0,0) 0 38%, rgba(0,0,0,.44) 72%)}
#dayprint .rs-sheet .rs-x{width:9mm;height:9mm;margin:-4.5mm 0 0 -4.5mm;border-width:1mm}
/* The centre dot marks a point on a photograph. On the drawing the point is a printed number, and a dot on top
   of it hides the very thing the ring is pointing at. */
#dayprint .rs-sheet .rs-x::after{display:none}
#dayprint .rs-tag{position:absolute;left:50%;bottom:2mm;transform:translateX(-50%);background:#ff6a13;color:#fff;
  font:800 9pt/1 system-ui,sans-serif;letter-spacing:.02em;padding:1.2mm 2.6mm;border-radius:1mm;
  box-shadow:0 0 0 .45mm #fff, 0 0 1.5mm rgba(0,0,0,.5);white-space:nowrap;z-index:2}
/* how to get there, in plain sentences */
#dayprint .rs-go{border:1.1px solid #6d6d6d;border-top:2.5px solid #333;border-radius:2px;padding:.8mm 2.4mm 1mm;margin-bottom:1.2mm}
#dayprint .rs-run{font-size:10pt;line-height:1.26;color:#222;background:#f4f2f0;border-radius:1.5mm;
  padding:1.1mm 2.4mm;margin:0 0 1.2mm}
#dayprint .rs-steps{margin:0;padding-left:5mm;font-size:10pt;line-height:1.3}
#dayprint .rs-steps li{margin-bottom:.4mm}
#dayprint .rs-steps li:last-child{margin-bottom:0}
#dayprint .rs-steps b{color:#111}
#dayprint .rs-ring{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 3.4mm;border:1.4px solid #222;
  border-left:2.8mm solid #222;border-radius:2px;padding:.7mm 2.2mm;margin-bottom:1.2mm;font-size:9pt;line-height:1.25}
#dayprint .rs-ring > b{font-size:9.5pt;color:#111}
#dayprint .rs-ring span{white-space:nowrap;color:#333}
#dayprint .rs-ring i{font-style:normal;font-size:9pt;text-transform:uppercase;letter-spacing:.05em;color:#5a5a5a}
#dayprint .rs-ring b.mono{font-weight:700;color:#111;letter-spacing:.01em}
#dayprint .rs-ring .rs-000 b.mono{color:#a4320a}
#dayprint .rs-foot{padding-top:1.2mm;border-top:1px solid #6d6d6d;font-size:9pt;color:#5a5a5a;line-height:1.3}
#dayprint .sbar{left:auto;right:2mm;bottom:2mm;font-size:9px;z-index:2}
@media print{ #dayprint .rs-win, #dayprint .rs-win img, #dayprint .rs-x, #dayprint .rs-rose, #dayprint .rs-qr,
  #dayprint .rs-fig figcaption, #dayprint .rs-key, #dayprint .rs-head, #dayprint .sbar, #dayprint .sbar::after{
    -webkit-print-color-adjust:exact; print-color-adjust:exact } }
body.printing-sheet #sheetprint{display:flex;flex-direction:column;position:fixed;inset:0;background:#fff;z-index:10000;padding:6mm 7mm}
body.printing-sheet #sheetprint .sp-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;border-bottom:1px solid #999;
  padding-bottom:2mm;margin-bottom:2mm;font-size:10pt;color:#000}
body.printing-sheet #sheetprint .sp-head b{font-size:12pt}
body.printing-sheet #sheetprint .sp-head .r{font-size:9pt;color:#333;text-align:right}
body.printing-sheet #sheetprint img{flex:1 1 auto;min-height:0;width:100%;height:100%;object-fit:contain;object-position:top center}
body.printing-sheet #sheetprint .sp-foot{font-size:8pt;color:#333;border-top:1px solid #999;padding-top:1.5mm;margin-top:2mm}
body.printing-sheet .app, body.printing-sheet header.top, body.printing-sheet #flash, body.printing-sheet .drawer, body.printing-sheet .scrim{display:none!important}
@page dropsheet{size:A4 portrait;margin:10mm 10mm 8mm}
@media print{
  body.dropping{background:#fff}
  body.dropping #dropsheet{position:static;overflow:visible;page:dropsheet}
  /* Block and table, not flex and grid. Chrome's print engine fragments a grid with fr tracks by collapsing
     the first column to a strip a few characters wide and spilling the rest onto page two and three. A table
     fragments the way paper expects. */
  body.dropping .ds-page{display:block;width:auto;min-height:0;padding:0}
  body.dropping .ds-page > *{margin-bottom:1.8mm}
  /* Inline-block, border-box, widths that add to less than 100%. The table-cell version overran the page
     edge by its own padding and clipped the phone numbers — the one thing a driver needs off that block. */
  body.dropping .ds-cols{display:block;font-size:0}
  body.dropping .ds-col{display:inline-block;vertical-align:top;box-sizing:border-box;font-size:11px}
  body.dropping .ds-col:first-child{width:56%;margin-right:2%}
  body.dropping .ds-col:last-child{width:42%}
  body.dropping .ds-crop{height:40mm}
  body.dropping .ds-close, body.dropping .printnote, body.dropping header.top, body.dropping .app footer{display:none!important}
  .ds-page, .ds-what, .ds-where, .ds-cols, .ds-col, .ds-safe{break-inside:avoid;page-break-inside:avoid}
  .ds-crop,.sbar,.sbar::after{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .ds-caveat, .ds-rose, .ds-receipt td:nth-child(odd), .ds-pic figcaption, .ds-safe, .ds-safe-who .tl i{
    -webkit-print-color-adjust:exact;print-color-adjust:exact}
}



.edgewrap{position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none}
.edgec{position:absolute;left:0;top:0;font-size:11px;font-weight:700;color:#fff;letter-spacing:.05em;
  text-shadow:0 0 3px rgba(0,0,0,.95),0 0 8px rgba(0,0,0,.8)}
.edgec.n{color:#ffb4ac;font-size:12.5px}
.rose{position:absolute;right:9px;top:9px;width:44px;height:44px;border-radius:50%;
  background:rgba(16,20,25,.62);border:1px solid rgba(255,255,255,.5);backdrop-filter:blur(2px)}
.rose .needle{position:absolute;inset:0}
.rose .needle i{position:absolute;left:50%;top:50%;width:0;height:0;margin:-17px 0 0 -4px;
  border-left:4px solid transparent;border-right:4px solid transparent;border-bottom:15px solid #e8564a}
.rose .rn{position:absolute;left:50%;top:50%;font-size:9px;font-weight:700;color:#fff;letter-spacing:.04em}
.ways{margin:4px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:1px 10px}
.ways li{font-size:11.5px;color:var(--ink2);padding:1px 0}
.getting{border-top:1px solid var(--rule2);margin-top:8px;background:var(--paper)}
.gt{margin:8px 10px 0;padding-left:16px;font-size:11.5px;line-height:1.55;color:var(--ink2)}
.gt li{margin-bottom:4px}
.gt.rules{color:var(--mute);font-size:11px;border-top:1px dashed var(--rule2);margin-top:8px;padding-top:7px}

.phoneonly{display:none}
/* the primary bar's More menu, at every width — the name box, every view, and the record actions */
.moremenu{position:absolute;right:0;top:calc(100% + 8px);background:var(--paper);border:1px solid var(--rule);
  border-radius:12px 0 12px 0;box-shadow:var(--lift-hi);padding:8px;display:flex;flex-direction:column;gap:4px;
  z-index:70;min-width:230px;max-width:min(300px, calc(100vw - 24px));max-height:min(70vh, 560px);overflow:auto}
.moremenu[hidden]{display:none!important}
.moremenu .btn{background:var(--paper);color:var(--ink);border-color:var(--rule);text-align:left;min-height:36px}
.moremenu .mmsec{font:800 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase;
  color:var(--mute);padding:8px 4px 3px}
.moremenu .mmsec:first-child{padding-top:2px}
.moremenu .mmviews{display:grid;grid-template-columns:1fr 1fr;gap:3px}
/* v5.96 - TOOLS OPENS LIKE THE #26's V8 TOOLBOX: a steel drawer with an orange lip and a stamped label strip, the
   tools set in dark foam, a short slide out as it opens. The one menu in the header. */
.moremenu{background:linear-gradient(180deg,#252d31 0,#161c1f 18%,#0f1417 100%);border:1px solid #3a4448;border-top:4px solid var(--orange);border-radius:6px 6px 14px 14px;
  box-shadow:0 26px 48px -18px rgba(0,0,0,.85),inset 0 1px 0 rgba(255,255,255,.07);padding:0 10px 4px;gap:5px;color:#e9edec;transform-origin:top right;animation:tbxOpen .34s cubic-bezier(.2,.8,.2,1) both}
.moremenu::before{content:'COATES · V8 TOOLBOX';display:block;margin:0 -10px 4px;padding:8px 12px 7px;font:800 10px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);letter-spacing:.22em;color:#ffb27a;
  background:repeating-linear-gradient(90deg,#1c2327 0 10px,#151b1e 10px 20px);border-bottom:1px solid #3a4448}
.moremenu::after{content:'';display:block;height:8px;margin:6px -10px -4px;border-radius:0 0 12px 12px;background:linear-gradient(180deg,#2c3539,#0b0f11);box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}
.moremenu .mmsec{color:#9fb0b2;padding:9px 2px 4px;border-top:1px dashed #2c3539}.moremenu .mmsec:first-child{border-top:0;padding-top:4px}
.moremenu .btn{background:linear-gradient(180deg,#1c2327,#12181b);color:#f1f4f3;border:1px solid #2f393d;box-shadow:inset 0 0 0 1px rgba(0,0,0,.55),inset 0 -2px 0 rgba(0,0,0,.45);min-height:38px}
.moremenu .btn:hover,.moremenu .btn:focus-visible{border-color:var(--orange);color:#fff;background:linear-gradient(180deg,#2c2118,#1a140f);outline:0}
.moremenu .btn[aria-current="page"]{border-color:var(--orange);color:#ffb27a;background:linear-gradient(180deg,#3a2a1c,#241a10)}
.moremenu .who{color:#9fb0b2}.moremenu .who input{background:#0b1013;color:#fff;border-color:#2f393d}
.moremenu .mmviews{gap:4px}
.hmore{background:linear-gradient(180deg,#2c3539,#151b1e);color:#fff;border:1px solid #3a4448;border-left:3px solid var(--orange)}
.hmore::before{content:'';display:inline-block;width:13px;height:9px;border:2px solid currentColor;border-radius:2px;box-shadow:inset 0 3px 0 -1px currentColor;margin-right:2px;position:relative;top:1px}
.hmore .dot{position:static;margin-left:4px}
@keyframes tbxOpen{from{transform:translateY(-14px) scaleY(.9);opacity:0}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){.moremenu{animation:none}}
.moremenu .mmviews .btn{padding:7px 9px;font-size:12.5px;justify-content:flex-start}
.moremenu .mmviews .btn[aria-current="page"]{background:var(--orange-soft);color:var(--orange);border-color:var(--orange);font-weight:700}
.moremenu .who{display:block}
.moremenu .who input{width:100%;padding:8px 10px;border:1px solid var(--rule);border-radius:8px;background:var(--tint)}
.tools{position:relative}
/* visually hidden, still read aloud */
.vh{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
/* ================================================================================================================
   v6.10 - DEPTH, GLASS, GLOW, MOTION (Andrew Fisher, 26 Sep 2026: the same look and design, enhanced). One layer on
   top of everything above: nothing here changes a colour, a face, a chamfer or a typeface. Heavy effects (filters,
   blur, the drifting hero) are laptop only; every motion respects reduced-motion and the page's own motion switch.
   ================================================================================================================ */
:root{--sh-card:0 1px 2px rgba(20,14,10,.05),0 12px 26px -16px rgba(20,14,10,.30),0 26px 50px -32px rgba(20,14,10,.22);
  --sh-tile:drop-shadow(0 1px 1px rgba(20,14,10,.09)) drop-shadow(0 10px 16px rgba(20,14,10,.13));
  --glow-or:0 0 0 1px rgba(255,106,19,.45),0 0 22px -3px rgba(255,106,19,.75)}
/* the day pod: the Today strip's plate and tiles, in the banner's housing, an orange rim round the row (Andrew Fisher's mock-ups, 26 Sep 2026) */
.hzpod.hztd{padding:9px 12px 10px;display:flex;flex-direction:row;align-items:center;gap:12px;flex-wrap:wrap;
  box-shadow:0 0 0 1px #0b1012,0 0 0 2.5px rgba(255,106,19,.62),0 0 0 3.5px #1a2224,0 0 22px -4px rgba(255,106,19,.55),0 8px 18px -6px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.10),inset 0 -8px 16px rgba(0,0,0,.55)}
.hztd .tdday{display:flex;align-items:center;gap:10px;flex:0 0 auto;padding-right:12px;border-right:1px solid rgba(255,255,255,.12)}
.hztd .tdday .rplate{font-size:19px} .hztd .tdw{font:600 11px/1.25 'Inter',var(--sans,system-ui,sans-serif);color:#c9d1d0;max-width:9em} .hztd .tdw b{color:#f4f7f6;font-weight:800}
.hztd .tdrow{display:flex;gap:7px;flex:1 1 auto;min-width:0}
.hztd .tdf{appearance:none;border:0;font:inherit;flex:1 1 0;min-width:0;background:linear-gradient(180deg,#1c2628,#0f1517);border-radius:9px;padding:6px 9px 6px;color:#f4f7f6;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;gap:1px;text-align:left;box-shadow:0 0 0 1px #0b1012,inset 0 1px 0 rgba(255,255,255,.08);transition:transform .15s,box-shadow .15s}
.hztd .tdf .tl{font:700 7.5px/1.1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.16em;text-transform:uppercase;color:#a9b4b3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.hztd .tdf .tn{display:flex;align-items:center;gap:7px} .hztd .tdf .tn b{font:700 26px/1 'Barlow Condensed','Arial Narrow',var(--sans,system-ui,sans-serif);font-style:italic;letter-spacing:-.005em;text-shadow:0 0 1px #fff,0 0 12px rgba(255,255,255,.18),0 2px 3px rgba(0,0,0,.8)}
.hztd .tdf .tn svg{width:15px;height:15px;fill:none;stroke:#8d9a99;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.hztd .tdf .ts{font:600 8px/1.1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.1em;text-transform:uppercase;color:#a9b4b3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.hztd .tdf.gap .tn b{color:#ff9a4d;text-shadow:0 0 1px #ffb27a,0 0 10px rgba(255,106,19,.85)} .hztd .tdf.gap .tn svg{stroke:#ff9a4d}
.hztd .tdf:hover,.hztd .tdf:focus-visible{transform:translateY(-1px);box-shadow:0 0 0 1px #0b1012,0 0 0 2px rgba(255,106,19,.55),0 8px 16px -8px rgba(255,106,19,.7);outline:none}
/* the banner's order at every width (Andrew Fisher, 26 Sep 2026: the car and the search bar up the top, the three pods under
   that, the day's figures under those): the row wraps, the cluster sits right on its own line as wide as its three pods, and
   the day pod takes the full width of the cluster beneath them */
.brandrow{flex-wrap:wrap}
.hzcluster{order:5;flex:0 0 auto;margin-left:auto;max-width:min(100%,660px);flex-wrap:wrap;justify-content:flex-end;row-gap:8px}   /* a wrapping flex box measures as one line, so the cap is what makes the day row drop under the three pods */
.hzpod.hztd{flex:1 1 100%;order:9;min-width:0}
/* depth: every card sits on a soft, layered shadow; the tiles and the day cards carry a shadow that follows their chamfer */
main .card{box-shadow:var(--sh-card);transition:transform .25s cubic-bezier(.2,.7,.2,1),box-shadow .25s}
main .card::after{background:linear-gradient(180deg,rgba(255,255,255,.85),rgba(255,255,255,0) 64px),var(--face)}
.kpi{filter:var(--sh-tile);transition:transform .25s cubic-bezier(.2,.7,.2,1),filter .25s}
.kpi::after{background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,255,255,0) 48px),var(--face)}
.kpi .v{text-shadow:0 1px 0 rgba(255,255,255,.8)}
.kpi.alert .v{text-shadow:0 1px 0 rgba(255,255,255,.8),0 0 16px rgba(214,40,28,.35)}
.tsq,.ctile{transition:transform .2s cubic-bezier(.2,.7,.2,1),box-shadow .2s,filter .2s}
.day{filter:drop-shadow(0 1px 1px rgba(20,14,10,.08)) drop-shadow(0 10px 14px rgba(20,14,10,.14))}
.day .dface{background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,255,255,0) 54px),var(--face)}
.day.today{--edge:var(--orange);animation:v610breathe 2.8s ease-in-out infinite}
.day[aria-pressed="true"]{transform:translateY(-2px)}
@keyframes v610breathe{0%,100%{filter:drop-shadow(0 1px 1px rgba(20,14,10,.08)) drop-shadow(0 10px 14px rgba(20,14,10,.14)) drop-shadow(0 0 0 rgba(255,106,19,0))}50%{filter:drop-shadow(0 1px 1px rgba(20,14,10,.08)) drop-shadow(0 10px 14px rgba(20,14,10,.14)) drop-shadow(0 0 10px rgba(255,106,19,.55))}}
/* glass: the hero caption is a frosted plate over the picture; the vignette under it keeps the words readable */
.pgban{position:relative}
.pgban .rbwin{position:relative;overflow:hidden;box-shadow:var(--sh-card)}
.pgban .rbwin::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 58%,rgba(10,8,6,.55));pointer-events:none}
.pgban .rbcap{position:absolute;left:14px;bottom:12px;right:auto;max-width:calc(100% - 28px);margin:0;padding:8px 13px;border-radius:10px;color:#f6f1ec;background:rgba(18,14,12,.46);border:1px solid rgba(255,255,255,.16);box-shadow:0 10px 24px -12px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.18);text-shadow:0 1px 2px rgba(0,0,0,.6);z-index:1}
.pgban .rbcap span{opacity:.86}
.tblwrap thead th{position:sticky;top:0;z-index:2;background:rgba(255,255,255,.88)}
/* glow: the active tab, the orange buttons, the race-day rail, the record's LIVE lamp */
nav.tabs button[aria-selected="true"]{text-shadow:0 0 14px rgba(255,106,19,.35)}
.btn.primary{background:linear-gradient(180deg,#ff8a3d,var(--orange-ink) 62%);box-shadow:inset 0 1px 0 rgba(255,255,255,.32),0 8px 18px -9px rgba(255,106,19,.85);transition:transform .15s,box-shadow .15s,filter .15s}
.btn.primary:hover,.btn.primary:focus-visible{transform:translateY(-1px);box-shadow:inset 0 1px 0 rgba(255,255,255,.32),var(--glow-or)}
.btn:not(.primary):hover{transform:translateY(-1px)}
.btn{transition:border-color .15s,box-shadow .15s,background .15s,transform .15s}
.hzpod .rail .done{box-shadow:0 0 8px rgba(255,106,19,.75)}
h3.sec{position:relative;padding-bottom:7px}
h3.sec::after{content:'';position:absolute;left:0;bottom:0;width:58px;height:3px;border-radius:2px;background:var(--orange);box-shadow:0 0 12px rgba(255,106,19,.6)}
tbody tr{transition:background .15s,box-shadow .15s}
tbody tr:hover{box-shadow:inset 3px 0 0 var(--orange)}
/* a 3D touch: tiles and day cards lift and tilt to the pointer, cards lift */
@media (hover:hover) and (min-width:900px){
  .kpi:hover{transform:translateY(-3px) perspective(700px) rotateX(2.5deg);filter:var(--sh-tile) drop-shadow(0 0 16px rgba(255,106,19,.28))}
  .day:hover{transform:translateY(-4px) perspective(700px) rotateX(2deg);filter:drop-shadow(0 1px 1px rgba(20,14,10,.08)) drop-shadow(0 16px 22px rgba(20,14,10,.2)) drop-shadow(0 0 12px rgba(255,106,19,.35))}
  main .card:hover{box-shadow:0 1px 2px rgba(20,14,10,.05),0 16px 34px -16px rgba(20,14,10,.36),0 30px 60px -34px rgba(20,14,10,.26)}
  .tsq:hover,.ctile:hover{transform:translateY(-2px)}
  .pgban .rbcap{-webkit-backdrop-filter:blur(12px) saturate(1.4);backdrop-filter:blur(12px) saturate(1.4)}
  .tblwrap thead th{-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);background:rgba(255,255,255,.72)}
  .pgban .rbwin img{animation:v610drift 28s ease-in-out infinite alternate;will-change:transform}
}
@keyframes v610drift{from{transform:scale(1) translate3d(0,0,0)}to{transform:scale(1.06) translate3d(-1.4%,-.9%,0)}}
/* motion: a staggered rise as a page arrives (on the arrive class the page already sets, never on a re-render) */
.pane.on.arrive > *{animation:v610rise .55s cubic-bezier(.2,.7,.2,1) both}
.pane.on.arrive > :nth-child(2){animation-delay:.05s} .pane.on.arrive > :nth-child(3){animation-delay:.1s} .pane.on.arrive > :nth-child(4){animation-delay:.15s}
.pane.on.arrive > :nth-child(5){animation-delay:.2s} .pane.on.arrive > :nth-child(6){animation-delay:.25s} .pane.on.arrive > :nth-child(7){animation-delay:.3s} .pane.on.arrive > :nth-child(n+8){animation-delay:.35s}
@keyframes v610rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@media (max-width:640px){
  .hzcluster{flex:1 1 100%;margin-left:0;max-width:100%} .hzpod.hztd{padding:8px 9px 9px;gap:8px} .hztd .tdday{flex:1 1 100%;border-right:0;padding-right:0} .hztd .tdrow{flex:1 1 100%;gap:5px} .hztd .tdf{padding:5px 7px} .hztd .tdf .tn b{font-size:22px} .hztd .tdf .tl,.hztd .tdf .ts{font-size:7px}
  .kpi,.day{filter:none} .day.today{animation:none;box-shadow:none} .pgban .rbcap{background:rgba(18,14,12,.7)} .pgban .rbwin{box-shadow:none}
}
@media (prefers-reduced-motion:reduce){
  .pane.on.arrive > *{animation:none} .day.today{animation:none} .pgban .rbwin img{animation:none}
  .kpi,.day,.tsq,.ctile,main .card,.btn,.btn.primary,.hztd .tdf{transition:none}
}
html[data-motion="off"] .pane.on.arrive > *,html[data-motion="off"] .day.today,html[data-motion="off"] .pgban .rbwin img{animation:none}
@media print{ .kpi,.day{filter:none} main .card{box-shadow:none} .pgban .rbcap{position:static;background:none;color:inherit;border:0;box-shadow:none;text-shadow:none} .pgban .rbwin::after{display:none} .hzpod.hztd{display:none} }
/* ================================================================================================================
   v6.20 - THE CIRCUIT IN THE BANNER (Andrew Fisher's mock-ups, 26 Sep 2026): the map panel, its pins and their menu, and
   the banner's grid - the car and the search top left, the map across the right, the pods in one row beneath.
   ================================================================================================================ */
.hzmap{position:relative;overflow:hidden;border-radius:14px;background:#0b0f12;min-height:0;z-index:2;
  box-shadow:0 0 0 1px #3a2c24,0 0 0 2px #0a0706,0 14px 30px -10px rgba(0,0,0,.95),inset 0 1px 0 rgba(255,255,255,.07)}
.hzmap img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;display:block}   /* contain: the whole ring is always in the panel; the dark bars either side belong to the instrument */
.hzmap::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.30),rgba(0,0,0,0) 32%,rgba(0,0,0,0) 72%,rgba(0,0,0,.42)),radial-gradient(120% 90% at 50% 50%,rgba(0,0,0,0) 60%,rgba(0,0,0,.35))}
.hzmap.folded{height:44px;aspect-ratio:auto;min-height:44px} .hzmap.folded img,.hzmap.folded .hzpins,.hzmap.folded .hznorth,.hzmap.folded .hznorthl{display:none} .hzmap.folded .hzmapcap span{display:none}
.hzpins{position:absolute;inset:0;z-index:2}
.hzpin{position:absolute;transform:translate(-50%,-100%);appearance:none;border:0;background:none;padding:0 0 2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:0;font:inherit;transition:transform .15s}
.hzpin .rplate{font-size:10px;box-shadow:0 0 0 1px #000,0 8px 16px -6px rgba(0,0,0,.95)}
.hzpin .stem{width:2px;height:7px;background:rgba(255,255,255,.75);box-shadow:0 0 4px rgba(0,0,0,.8)}
.hzpin .dot{width:9px;height:9px;border-radius:50%;background:#8d9a99;box-shadow:0 0 0 2px #0b0f12,0 0 8px rgba(255,255,255,.45)}
.hzpin .dot.green{background:#39e07a;box-shadow:0 0 0 2px #0b0f12,0 0 12px rgba(57,224,122,.95)} .hzpin .dot.amber{background:#ffb020;box-shadow:0 0 0 2px #0b0f12,0 0 12px rgba(255,176,32,.95)} .hzpin .dot.red{background:#ff3b3b;box-shadow:0 0 0 2px #0b0f12,0 0 12px rgba(255,59,59,.95)}
.hzpin:hover,.hzpin:focus-visible{transform:translate(-50%,-100%) scale(1.12);z-index:3;outline:none}
.hzmapcap{position:absolute;left:12px;top:9px;z-index:3;color:#f6f1ec;font:700 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;text-shadow:0 1px 2px #000,0 0 10px rgba(0,0,0,.7);pointer-events:none;max-width:80%}
.hzmapcap span{display:block;font-weight:600;letter-spacing:.1em;color:#d5dcdb;margin-top:3px;text-transform:none;font-size:10.5px;letter-spacing:.04em}
.hznorth{position:absolute;right:12px;top:10px;z-index:3;width:24px;height:24px;filter:drop-shadow(0 1px 2px #000)} .hznorthl{position:absolute;right:38px;top:13px;z-index:3;font:800 11px/1 'Inter',var(--sans,system-ui,sans-serif);color:#f6f1ec;text-shadow:0 1px 2px #000;font-style:normal}
.hzmapfold{position:absolute;right:10px;bottom:8px;z-index:4;appearance:none;border:1px solid rgba(255,255,255,.22);background:rgba(16,24,31,.72);color:#e8ebe9;border-radius:7px;padding:4px 9px;font:700 10px/1 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.hzmapfold:hover{background:rgba(255,106,19,.85);border-color:#ff6a13;color:#fff}
.hzpinmenu{position:absolute;z-index:6;min-width:200px;max-width:min(320px,92%);background:#10181ff2;border:1px solid #ff6a1370;border-radius:10px;padding:6px;box-shadow:0 14px 30px -10px rgba(0,0,0,.95),0 0 0 1px #000;display:flex;flex-direction:column;gap:3px}
.hzpinmenu b{display:flex;align-items:center;gap:8px;font:600 11px/1.3 'Inter',var(--sans,system-ui,sans-serif);color:#f4f7f6;padding:4px 8px 7px;border-bottom:1px solid rgba(255,255,255,.12)} .hzpinmenu b span{color:#c9d1d0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hzpinmenu button{appearance:none;border:0;background:#1c2628;color:#f4f7f6;border-radius:7px;padding:7px 9px;text-align:left;font:600 12px/1.25 'Inter',var(--sans,system-ui,sans-serif);cursor:pointer}
.hzpinmenu button:hover,.hzpinmenu button:focus-visible{background:var(--orange);color:#fff;outline:none}
@media (min-width:641px){
  .brandrow{display:grid;grid-template-columns:auto auto minmax(280px,1fr);grid-template-areas:"lock lock map" "search tools map" "cluster cluster cluster";align-items:center;column-gap:14px;row-gap:8px}
  .lockup{grid-area:lock} .search{grid-area:search;flex:none;min-width:280px;max-width:520px} .tools{grid-area:tools;justify-self:end} .navback{grid-area:tools;justify-self:start;align-self:center}
  .hzmap{grid-area:map;align-self:stretch;aspect-ratio:4760/1989;max-height:380px}
  .hzcluster{grid-area:cluster;margin-left:auto;max-width:100%;justify-content:flex-end}
  .hzpod.hztd{flex:1 1 440px;order:9;min-width:0}
  body.search-open .brandrow{display:flex}
}
@media (min-width:641px) and (max-height:820px){ .hzmap{aspect-ratio:auto;height:250px} }
@media (max-width:640px){
  .hzmap{flex:1 1 100%;order:4;height:200px;aspect-ratio:auto;border-radius:12px} .hzmapcap{max-width:70%} .hzpin .rplate{font-size:9px} .hzmapfold{display:none}
}
@media print{ .hzmap{display:none} }
/* ================================================================================================================
   v6.21 - THE BANNER'S PROPORTIONS (Andrew Fisher, 26 Sep 2026: "Yours does not look good"). The left column stacks the
   wordmark, the car and the search; the map fills its panel at its own aspect; everything a size up.
   ================================================================================================================ */
@media (min-width:641px){
  .brandrow{grid-template-columns:minmax(0,auto) minmax(0,auto) minmax(0,1fr);grid-template-areas:"lock lock map" "search tools map" "cluster cluster cluster";column-gap:22px;row-gap:10px;padding:14px 16px 14px 16px;align-items:end}
  .lockup{flex-direction:column;align-items:flex-start;gap:4px;align-self:start}
  .lockup .mark{order:0} .brandtxt{order:1} .hzcar{order:2}
  #bOrg{font-size:12px;letter-spacing:.3em}
  .wordmark{margin-top:5px;gap:12px} .wordmark .gc{font-size:44px} .wordmark .yr{font-size:22px;letter-spacing:.06em} .wordmark .when{font-size:12px;letter-spacing:.14em;text-transform:uppercase}
  .hzcar{width:400px;height:176px;margin:2px 0 0 -8px}
  .hzcarimg{width:428px;top:-6px} .hzcarref{top:128px;width:428px}
  .hzcar::before{left:-60px;top:62px;width:480px} .hzcar::after{top:96px;width:380px;left:-90px}
  .search{min-width:320px;max-width:560px;align-self:center} .search input{height:48px;border-radius:26px;padding-left:44px;font-size:14px;background:linear-gradient(180deg,rgba(6,4,3,.86),rgba(6,4,3,.74)) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c9bfb4' stroke-width='2.2' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><path d='M20 20l-3.6-3.6'/></svg>") 15px 50%/18px 18px no-repeat}
  .tools{align-self:center}
  .hzmap{aspect-ratio:4760/1989;max-height:none;height:auto;border-radius:16px;min-width:0;max-width:100%;justify-self:stretch}
  .hzmapcap{left:16px;top:13px;font-size:11px;letter-spacing:.24em} .hzmapcap span{font-size:12.5px;margin-top:5px}
  .hznorth{width:32px;height:32px;right:16px;top:12px} .hznorthl{right:52px;top:19px;font-size:13px}
  .hzmapfold{right:14px;bottom:12px;padding:6px 11px;font-size:10.5px}
  .hzpin .rplate{font-size:11.5px} .hzpin .dot{width:12px;height:12px} .hzpin .stem{height:9px}
}
@media (min-width:641px) and (max-width:1180px){ .wordmark .gc{font-size:36px} .hzcar{width:330px;height:146px} .hzcarimg,.hzcarref{width:352px} .hzcarref{top:104px} .search{min-width:240px} }
@media (max-width:640px){ .hzmap{height:auto;aspect-ratio:4760/1989} }
/* v6.22 - the map out of the banner (Andrew Fisher, 26 Sep 2026); the lockup left, the three pods beside it, the day row under them */
.hzmap{display:none!important}
@media (min-width:641px){
  .brandrow{grid-template-columns:minmax(0,auto) minmax(0,auto) minmax(0,1fr);grid-template-areas:"lock lock cluster" "search tools cluster";align-items:center}
  .lockup{align-self:center} .search{min-width:380px;max-width:560px}
  .hzcluster{grid-area:cluster;justify-self:end;align-self:center;margin-left:0;max-width:min(100%,700px);flex-wrap:wrap;justify-content:flex-end;row-gap:8px}
  .hzpod.hztd{flex:1 1 100%;order:9}
}
@media (min-width:641px) and (max-width:1180px){
  .brandrow{grid-template-areas:"lock lock" "search tools" "cluster cluster";grid-template-columns:minmax(0,auto) minmax(0,1fr)}
  .hzcluster{justify-self:stretch;max-width:100%;justify-content:flex-end}
}
/* ================================================================================================================
   v6.23 - STRIPPED BACK (Andrew Fisher, 26 Sep 2026: "its to much"). Two slim rows: the lockup row as it always was; one
   row of pods with the day as a compact fourth pod. Undoes the v6.21/v6.22 sizes and grid.
   ================================================================================================================ */
@media (min-width:641px){
  .brandrow{display:flex;flex-wrap:wrap;align-items:center;gap:14px;padding:12px 14px 12px 0;row-gap:8px}
  .lockup{flex-direction:row;align-items:center;gap:11px;align-self:auto;flex:0 0 auto}
  .lockup .mark,.brandtxt,.hzcar{order:0}
  #bOrg{font-size:10.5px;letter-spacing:.24em}
  .wordmark{margin-top:3px;gap:9px} .wordmark .gc{font-size:21px} .wordmark .yr{font-size:12px;letter-spacing:.1em} .wordmark .when{font-size:11px;letter-spacing:.04em;text-transform:none}
  .hzcar{width:214px;height:92px;margin:0 0 0 -6px} .hzcarimg{width:228px;top:-4px} .hzcarref{top:68px;width:228px}
  .hzcar::before{left:-40px;top:32px;width:250px} .hzcar::after{top:50px;width:200px;left:-60px}
  .search{flex:1 1 260px;min-width:0;max-width:none;align-self:auto} .search input{height:46px;border-radius:12px;padding-left:13px;font-size:inherit;background:linear-gradient(180deg,rgba(6,4,3,.82),rgba(6,4,3,.7))}
  .tools{order:4;align-self:auto}
  .hzcluster{order:5;flex:0 0 auto;margin-left:auto;max-width:100%;flex-wrap:nowrap;justify-content:flex-end;gap:10px;align-self:center;justify-self:auto}
  .hzpod.hztd{flex:0 0 auto;min-width:0;order:9;flex-direction:column;align-items:flex-start;gap:0;padding:8px 11px 9px;flex-wrap:nowrap}
  .hztd .tdday{border-right:0;padding-right:0;gap:7px;flex:0 0 auto}
  .hztd .tdday .rplate{font-size:12px} .hztd .tdw{font:700 9.5px/1.2 'Inter',var(--sans,system-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase;color:#a9b4b3;max-width:none;white-space:nowrap} .hztd .tdw b{color:#f4f7f6}
  .hztd .tdrow{gap:5px;margin-top:6px;flex:0 0 auto}
  .hztd .tdf{flex:0 0 auto;flex-direction:column;align-items:flex-start;gap:1px;padding:3px 8px 4px;min-width:52px}
  .hztd .tdf .tl{font-size:7px;letter-spacing:.14em} .hztd .tdf .tn b{font-size:20px} .hztd .tdf .tn svg{display:none} .hztd .tdf .ts{display:none}
}
@media (min-width:641px) and (max-width:1180px){ .hzcluster{flex-wrap:wrap;margin-left:auto} .hzpod.hztd{flex:0 0 auto} }
/* v6.24 - the page always has room: a screen under 600 px tall (a phone held sideways) folds the pods away and slims the top row */
@media (max-height:600px){
  .hzcluster{display:none!important}
  .hbar{min-height:0;padding:6px 10px 6px 0}
  .hzcar{width:150px;height:64px;margin:0 0 0 -4px} .hzcarimg{width:160px;top:-2px} .hzcarref{display:none} .hzcar::before,.hzcar::after{display:none}
  #bOrg{font-size:9px} .wordmark .gc{font-size:17px} .wordmark .yr{font-size:10px} .wordmark .when{display:none}
  .search input{height:38px}
  main{min-height:45vh}
}
@media (min-height:601px) and (max-height:760px){ main{min-height:40vh} }
/* v6.25 - the pit wall: on a laptop or tablet the pods span the whole banner at equal width, nothing left empty */
@media (min-width:641px){
  .hzcluster{flex:1 1 100%;max-width:100%;margin-left:0;justify-content:stretch;gap:10px;flex-wrap:nowrap;padding:14px 12px 10px}
  .tpodwrap,.hzpod,.recstrip,.hzpod.hztd{flex:1 1 0;min-width:0}
  .tpcard > .face{display:block} .tphead{width:100%}
  .recstrip{align-items:flex-start}
  .hzpod.hztd{flex:1.35 1 0;flex-direction:column;align-items:stretch}
  .hztd .tdday{justify-content:flex-start}
  .hztd .tdrow{display:flex;gap:6px;margin-top:6px} .hztd .tdf{flex:1 1 0;min-width:0;align-items:flex-start}
  .hztd .tdf .tl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
  .hzshift{left:14px;right:14px}
}
@media (min-width:641px) and (max-width:1180px){ .hzcluster{flex-wrap:wrap} .tpodwrap,.hzpod,.recstrip{flex:1 1 30%} .hzpod.hztd{flex:1 1 100%} }
/* v6.26 - Tools in the tab row, the car out of the banner (Andrew Fisher, 26 Sep 2026) */
.hzcar{display:none!important} .lockup{gap:8px}
nav.tabs .tools{margin-left:auto;order:99;flex:0 0 auto;align-self:center;position:static;padding-left:10px;flex-wrap:nowrap}
nav.tabs .tools .hmore{height:32px;padding:0 12px;font-size:12.5px}
.moremenu{position:fixed;top:auto;right:auto;z-index:80;overflow:auto;overscroll-behavior:contain}
.brandrow .sbtop{order:4;margin-left:auto}
@media (max-width:640px){ nav.tabs .tools{padding-left:6px;padding-right:2px} .hbar{padding-right:12px} }
/* v6.27 - the brand block gets room, over the clock and race-day pods (Andrew Fisher, 26 Sep 2026) */
@media (min-width:641px){
  .brandrow{padding-top:16px;row-gap:12px}
  .lockup{padding:4px 0 2px 12px;align-self:center}
  #bOrg{font-size:14px;letter-spacing:.34em;text-shadow:0 1px 2px #000,0 0 14px rgba(0,0,0,.85)}
  .wordmark{margin-top:8px;gap:12px;align-items:baseline} .wordmark .gc{font-size:42px;letter-spacing:-.02em;text-shadow:0 2px 3px rgba(0,0,0,.8),0 0 18px rgba(0,0,0,.6)} .wordmark .yr{font-size:20px;letter-spacing:.08em} .wordmark .when{font-size:12px;letter-spacing:.12em;text-transform:uppercase}
  .wordmark .chq{transform:scale(1.35);transform-origin:left center;margin-left:6px}
  .search{align-self:center;flex:1 1 300px} .navback{align-self:center}
}
@media (max-width:640px){
  .lockup{padding:6px 0 2px 4px} #bOrg{display:block;font-size:10px;letter-spacing:.26em;margin-bottom:2px} .wordmark .gc{font-size:30px} .wordmark .yr{font-size:15px} .wordmark .chq{display:inline-block;transform:scale(1.1);transform-origin:left center}
}
</style></head>
<body>
<!-- The delivery status instrument's materials, defined once and referenced by every instrument on the page:
     the machined housing, the bezel, the recessed well, the LED matrix lit and unlit in each colour, the
     glass highlight and the bloom. One set of gradients for 200 instruments, not 200 sets. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
  <!-- the housing: graphite, lit from above, with a recessed panel and a diagonal sheen -->
  <linearGradient id="hzBody" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#43474d"/><stop offset=".3" stop-color="#2a2d32"/><stop offset=".75" stop-color="#191b1e"/><stop offset="1" stop-color="#0c0d0f"/></linearGradient>
  <linearGradient id="hzPanel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1d1f23"/><stop offset="1" stop-color="#101114"/></linearGradient>
  <linearGradient id="hzSheen" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".12"/><stop offset=".45" stop-color="#fff" stop-opacity="0"/></linearGradient>
  <!-- the bezel: a raised ring lit top-left, an inner ring lit bottom-right, so the lens reads as a recess -->
  <linearGradient id="hzBezel" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8a8f96"/><stop offset=".35" stop-color="#3d4147"/><stop offset=".7" stop-color="#1b1d21"/><stop offset="1" stop-color="#0a0b0c"/></linearGradient>
  <linearGradient id="hzBezelIn" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0b0c0d"/><stop offset=".6" stop-color="#26292e"/><stop offset="1" stop-color="#4a4f56"/></linearGradient>
  <radialGradient id="hzWell" cx=".5" cy=".45" r=".6"><stop offset="0" stop-color="#202226"/><stop offset="1" stop-color="#050506"/></radialGradient>
  <!-- the shade: the bezel's own shadow falling on the LED array, heavier at the top -->
  <radialGradient id="hzShade" cx=".5" cy=".64" r=".62"><stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".78"/></radialGradient>
  <radialGradient id="hzGlass" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity=".30"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
  <radialGradient id="hzBolt" cx=".32" cy=".3" r=".75"><stop offset="0" stop-color="#b7bcc2"/><stop offset=".5" stop-color="#5a5f66"/><stop offset="1" stop-color="#17191c"/></radialGradient>
  <!-- the lit LED array in each colour: white-hot centre, saturated body, darker at the rim -->
  <radialGradient id="hzCoreR" cx=".5" cy=".46" r=".56"><stop offset="0" stop-color="#ffe2de"/><stop offset=".22" stop-color="#ff6d5e"/><stop offset=".68" stop-color="#ec2416"/><stop offset="1" stop-color="#8a1008"/></radialGradient>
  <radialGradient id="hzCoreA" cx=".5" cy=".46" r=".56"><stop offset="0" stop-color="#fff5d6"/><stop offset=".22" stop-color="#ffd35c"/><stop offset=".68" stop-color="#f7a600"/><stop offset="1" stop-color="#8f5600"/></radialGradient>
  <radialGradient id="hzCoreG" cx=".5" cy=".46" r=".56"><stop offset="0" stop-color="#e6ffee"/><stop offset=".22" stop-color="#7ff0a8"/><stop offset=".68" stop-color="#1fc862"/><stop offset="1" stop-color="#0a6a2e"/></radialGradient>
  <!-- the LED matrix, hex-packed: dark and tinted when off, bright when on -->
  <pattern id="hzDotsOffR" width="2.6" height="4.5033" patternUnits="userSpaceOnUse"><circle cx="1.3" cy="1.1258" r=".98" fill="#3d1512" fill-opacity=".85"/><circle cx="0" cy="3.3775" r=".98" fill="#3d1512" fill-opacity=".85"/><circle cx="2.6" cy="3.3775" r=".98" fill="#3d1512" fill-opacity=".85"/></pattern>
  <pattern id="hzDotsOffA" width="2.6" height="4.5033" patternUnits="userSpaceOnUse"><circle cx="1.3" cy="1.1258" r=".98" fill="#3c2a09" fill-opacity=".85"/><circle cx="0" cy="3.3775" r=".98" fill="#3c2a09" fill-opacity=".85"/><circle cx="2.6" cy="3.3775" r=".98" fill="#3c2a09" fill-opacity=".85"/></pattern>
  <pattern id="hzDotsOffG" width="2.6" height="4.5033" patternUnits="userSpaceOnUse"><circle cx="1.3" cy="1.1258" r=".98" fill="#0f2f18" fill-opacity=".85"/><circle cx="0" cy="3.3775" r=".98" fill="#0f2f18" fill-opacity=".85"/><circle cx="2.6" cy="3.3775" r=".98" fill="#0f2f18" fill-opacity=".85"/></pattern>
  <pattern id="hzDotsOnR" width="2.6" height="4.5033" patternUnits="userSpaceOnUse"><circle cx="1.3" cy="1.1258" r=".88" fill="#ffd3ce" fill-opacity=".78"/><circle cx="0" cy="3.3775" r=".88" fill="#ffd3ce" fill-opacity=".78"/><circle cx="2.6" cy="3.3775" r=".88" fill="#ffd3ce" fill-opacity=".78"/></pattern>
  <pattern id="hzDotsOnA" width="2.6" height="4.5033" patternUnits="userSpaceOnUse"><circle cx="1.3" cy="1.1258" r=".88" fill="#fff0c4" fill-opacity=".78"/><circle cx="0" cy="3.3775" r=".88" fill="#fff0c4" fill-opacity=".78"/><circle cx="2.6" cy="3.3775" r=".88" fill="#fff0c4" fill-opacity=".78"/></pattern>
  <pattern id="hzDotsOnG" width="2.6" height="4.5033" patternUnits="userSpaceOnUse"><circle cx="1.3" cy="1.1258" r=".88" fill="#d2ffe0" fill-opacity=".78"/><circle cx="0" cy="3.3775" r=".88" fill="#d2ffe0" fill-opacity=".78"/><circle cx="2.6" cy="3.3775" r=".88" fill="#d2ffe0" fill-opacity=".78"/></pattern>
  <filter id="hzBloom" x="-70%" y="-70%" width="240%" height="240%"><feGaussianBlur stdDeviation="4.4"/></filter>
  <filter id="hzHalo" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="1.7"/></filter>
  <filter id="hzHot" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="2.6"/></filter>
</defs></svg>
<div class="app">
 <div class="printnote" id="printnote"></div>
 <!-- V11 audit: a keyboard lands on the header every time. One link, first in the order, straight to the work. -->
 <a class="skipwork" href="#pane-today" id="skipWork">Skip to the work</a>
 <header class="top">
  <div class="hzscene" aria-hidden="true"><div class="hzgrade"></div><div class="hzflare"></div></div>
  <!-- The primary bar. ONE row on a desktop, 84px tall, in the order a person reads it: who we are, what they
       are looking for, what the record is doing, what the time is. Everything that is not one of those four
       lives behind More, labelled, keyboard-reachable, and holding all of it.
       Superior Audit, 15 Sep 2026: the old bar wrapped to three rows and stood 183px tall on a phone before a
       single line of the day's work appeared. -->
  <div class="brandrow hbar">
   <div class="lockup">
     <span class="hzcar" aria-hidden="true"><i class="hzcarimg"></i><i class="hzcarref"></i></span>
     <div class="mark"></div>
     <div class="brandtxt">
       <h1 class="vh">APP_TITLE_HERE</h1>
       <b id="bOrg">Coates Industrial Solutions</b>
       <span class="wordmark"><i class="gc">GC500</i><i class="yr">2026</i>
         <i class="chq" aria-hidden="true"></i><i class="when" id="bSub"></i></span>
     </div>
   </div>
   <button type="button" class="navback" id="navBack" hidden aria-label="Back to where you were" title="Back (Alt+←)"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M8.5 2.5 4 7l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Back</span></button>
   <div class="search">
     <label for="q" class="vh">Search assets</label>
     <input id="q" type="search" aria-label="Search a reference, a name, an asset number, a unit or a place on a drawing"
       placeholder="Search a reference, a name, an asset number or a map location — try P33, medical, 1322588, callout 033" autocomplete="off"
       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="finder" aria-haspopup="listbox">
     <button class="x" id="qx" title="Clear what you typed" aria-label="Clear what you typed" hidden>&times;</button>
     <!-- V11 audit: clearing what you typed and getting OUT of search are two different things, and the phone
          only offered the first. This is the second, and it is visible. -->
     <button type="button" class="searchclose phoneonly" id="searchClose" aria-label="Close search">Close</button>
     <div class="finder" id="finder" role="listbox" aria-label="Matches" hidden></div>
   </div>
   <!-- v6.20 - THE CIRCUIT IN THE BANNER (Andrew Fisher's mock-ups, 26 Sep 2026): the registered aerial with the key-plan
        ring, and the day's due-in deliveries pinned on it, each pin a menu to exactly where it needs to go -->
   <div class="hzmap" id="hzmap" role="group" aria-label="The circuit, with the day's deliveries">
     <img id="hzmapImg" alt="The Surfers Paradise street circuit on the registered aerial photograph" decoding="async">
     <div class="hzpins" id="hzpins"></div>
     <div class="hzmapcap"><b>Surfers Paradise street circuit</b><span id="hzmapSub"></span></div>
     <svg class="hznorth" id="hznorth" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l5 18-5-4-5 4z" fill="#f6f1ec"/><path d="M12 2l5 18-5-4z" fill="#ff6a13"/></svg><i class="hznorthl" id="hznorthl" aria-hidden="true">N</i>
<button type="button" class="hzmapfold" id="hzmapFold" aria-expanded="true" title="Fold the map away, or open it again">Fold the map</button>
   </div>
   <!-- The record strip. What the RECORD is doing — never the clock, and never a green light that pulses
        because pulsing looks alive. Superior Audit, 15 Sep 2026: "Never animate a fake green heartbeat."
        Every state here is read from SYNC, and the time beside it is the last time the service actually
        answered, not the time now. -->
   <div class="tools">
     <button class="btn iconb phoneonly" id="searchBtn" aria-label="Search" title="Search" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="6.5" cy="6.5" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 10l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
     <!-- V11 audit: two controls said "More" and opened unrelated menus. This one is the tools — your name,
          export, import, the shared folder — so it says Tools. The nav row's More is the other views. -->
     <button class="btn hmore" id="moreBtn" aria-label="Tools — your name, export, import and the other views" title="Your name, Export, Import, the shared folder, and every view" aria-expanded="false" aria-haspopup="menu">Tools<i class="cv" aria-hidden="true"></i></button>
     <div class="moremenu" id="moreMenu" role="menu" aria-label="Tools" hidden>
       <div class="mmsec">Recording as</div>
       <label class="who" role="none"><span class="vh">Recording as</span>
         <input id="who" autocomplete="name" placeholder="your name" aria-label="Your name — every record you make carries it"></label>
       <div class="mmsec" id="mmViewsHead">Every view</div>
       <div class="mmviews" id="mmViews" role="none"></div>
       <div class="mmsec">This page</div>
       <button class="btn" role="menuitem" id="motionBtn" aria-pressed="false">Motion: Subtle</button>
       <div class="mmsec">The record</div>
       <button class="btn" role="menuitem" id="folderBtn" hidden>Shared folder</button>
       <button class="btn" role="menuitem" id="exportBtn">Export</button>
       <button class="btn" role="menuitem" id="importBtn">Import</button>
       <input type="file" id="importFile" accept="application/json" hidden>
     </div>
   </div>
   <!-- The timing pod. The same housing as everything else: espresso, orange edge, the two opposing chamfers.
        Compact in the header; the mode switch, the target and what the clock IS open underneath when pressed. -->
   <div class="hzcluster" id="hzcluster">
   <div class="hzshift" id="hzshift" aria-hidden="true" title="the seconds of the minute, as a shift light"></div>
   <div class="tpodwrap" id="tpod" role="group" aria-label="Gold Coast time and event countdown">
     <div class="cut dark tpcard"><span class="face">
       <button type="button" class="tphead" id="tpodOpen" aria-expanded="false" aria-controls="tpodPanel" title="Gold Coast time · press for the countdown and what this clock is">
         <span class="tpk"><b id="tpodLab">Gold Coast · AEST</b><i id="tpodSrc">device clock</i></span>
         <span class="tpnum racenum" id="tpodNum" role="timer" aria-live="off" aria-label="Gold Coast time">--:--:--</span>
         <span class="tpsec" id="tpodSec" aria-hidden="true" title="seconds of the current minute"></span>
         <span class="tpdate" id="tpodDate"></span>
       </button>
       <div class="tpprint" id="tpodPrint" aria-hidden="true"></div>
     </span></div>
     <!-- outside the chamfered card on purpose: a clip-path clips whatever is drawn beyond it, dropdown included -->
     <div class="tppanel" id="tpodPanel" hidden>
       <div class="tpsub" id="tpodSub"></div>
       <div class="tpmode" role="group" aria-label="What the clock shows">
         <button type="button" data-tpod="clock" aria-pressed="true">Clock</button><button type="button" data-tpod="countdown" aria-pressed="false">Countdown</button>
       </div>
       <p class="tpnote" id="tpodNote"></p>
     </div>
   </div>
   <p class="vh" id="tpodSay" role="status" aria-live="polite"></p>
   <!-- v5.87 - the countdown pod: days to race day on the programme rail, the #26 at today. Read from DATA.race_days
        and DATA.weeks, worked out once a day (hzCountdown), never a record. -->
   <div class="hzpod hzcd" id="hzcd" role="group" aria-label="Countdown to race day">
     <span class="lab" id="hzcdLab">Race day</span>
     <span class="num"><b id="hzcdN">—</b><small id="hzcdU">DAYS</small><small class="cdt" id="hzcdT" aria-label="hours, minutes and seconds to race day"></small></span>
     <div class="rail" id="hzrail" aria-hidden="true"><span class="track"></span><span class="done"></span><span class="wks"></span><span class="flag"></span><i class="car"></i><span class="lb s"></span><span class="lb e"></span></div>
     <span class="sub" id="hzcdSub"></span>
   </div>
   <!-- v6.10 - the day pod: the Today strip's day and figures, in the banner (Andrew Fisher, 26 Sep 2026) -->
   <div class="hzpod hztd" id="hztd" role="group" aria-label="The programme day and its deliveries"></div>
   <div class="recstrip" id="recstrip" role="status" aria-live="polite" aria-label="The shared record"></div>
   </div>
  </div>
  <nav class="tabs" id="tabs" role="tablist"></nav>
  <!-- The More menu lives HERE, outside the tab strip, and not inside it.
       Andrew Fisher, 15 Sep 2026: on a phone the options at the top did not show when More was pressed. The strip
       sideways on a phone (overflow-x:auto), and an overflow container clips every absolutely positioned thing
       inside it — CSS turns the other axis to auto the moment one axis is not visible, so the menu was being
       cut off at the strip's own bottom edge with one item showing. It hangs off the header instead. -->
  <!-- v5.96 - the nav row's More menu is gone; every view is in Tools -->
 </header>
 <main>
