/* everything set aside on this record, newest first — the Edit tab lists it with Put back on each line */
function asideList(){
  return Object.entries(S.aside || {}).filter(([id]) => tombedHere(id))
    .map(([id, e]) => Object.assign({id}, e)).sort((a, b) => String(b.at || '').localeCompare(String(a.at || '')));
}
/* ------------------------------------------------------------------ a record moved to another reference
