                      recorded_on: (sl && sl.recorded_on) || fromRow.recorded_on || now.slice(0, 10),
                      note: ((sl && sl.note) || fromRow.note || '') + ' — moved from ' + from + ' by ' + who + ' ' + fmtStamp(now)};
    items.forEach(i => stampIt('supplied', to + '/' + i.asked, who));
    /* the numbers recorded against the source are set aside there, by name, so no reader adds them twice — and
       a number the target had taken off earlier (the schedule allocated 1110619 to P58, it went to P19, now it is
       back at P58) is put back there, by name, or the old removal would keep it off the sheet */
    supNums.forEach(n => { tomb('num/' + from + '/' + n, who); if (tombedHere('num/' + to + '/' + n)) untomb('num/' + to + '/' + n, who); });
  }
  const typed = ((S.assetNumbers || {})[from] || []).slice();
  if (typed.length) { S.assetNumbers = S.assetNumbers || {}; S.assetNumbers[to] = [...new Set(((S.assetNumbers || {})[to] || []).concat(typed))];
    typed.forEach(n => { stampIt('assetNumbers', to + '/' + n, who); tomb('num/' + from + '/' + n, who); if (tombedHere('num/' + to + '/' + n)) untomb('num/' + to + '/' + n, who); }); }
  /* the things inside, and the accessories added here */
  const units = unitsOf(from).map(u => { const c = Object.assign({}, u); delete c._where; return c; });
  if (units.length) { S.units = S.units || {}; S.units[to] = {units}; stampIt('units', to, who); }
  const acc = ((S.accessories || {})[from] || []).slice();
  if (acc.length) { S.accessories = S.accessories || {}; S.accessories[to] = ((S.accessories || {})[to] || []).concat(J(acc)); }
  /* the one-value fields */
  const one = (coll, stampField) => { const v = (S[coll] || {})[from]; if (v == null || v === '') return;
    S[coll] = S[coll] || {}; S[coll][to] = J(v); stampIt(stampField || coll, to, who); };
  one('notes'); one('branch'); one('rental'); one('weeks'); one('hireStart');
  /* the labour ticks are keyed "REF|discipline|item|line", so each is written again under the target and
     stamped there by name; the source's keys stay, unread while its moved marker stands */
  Object.keys(S.labour || {}).filter(k => k.indexOf(from + '|') === 0).forEach(k => {
    const nk = to + k.slice(from.length); S.labour[nk] = true; stampIt('labour', nk, who); });
  const cb = fromRow.branch; if (!(S.branch || {})[from] && cb) { const c = typeof cb === 'string' ? cb : cb.code; if (c) { S.branch = S.branch || {}; S.branch[to] = c; stampIt('branch', to, who); } }
  const cc = fromRow.contract; if (!(S.rental || {})[from] && cc && cc.rental_id) { S.rental = S.rental || {}; S.rental[to] = cc.rental_id; stampIt('rental', to, who); }
  /* the marker on the source — and a return clears the marker on the reference it comes back to */
