  if (d.done || d.levelled || d.steps) has.push('ticks');
  const x = knownNumbersExtra(key);
  if (x.supplied.length || x.local.length || ((S.assetNumbers || {})[key] || []).length) has.push('asset numbers');
  if (unitsOf(key).length) has.push('things inside');
  if (itemRows(assetOf(key) || {key, item_types: []}).some(r => r.supplied)) has.push('a supplied record');
  if (((S.accessories || {})[key] || []).length) has.push('accessories added here');
  if (Object.keys(S.labour || {}).some(k => k.indexOf(key + '|') === 0 && S.labour[k])) has.push('labour ticks');
  if ((S.notes || {})[key]) has.push('a note');
  if ((S.branch || {})[key]) has.push('a branch');
  if ((S.rental || {})[key]) has.push('a Rental ID');
