  const unpriced = allTicked.filter(x => x.money !== 'rate' && x.money !== 'zero' && x.money !== 'included');
  if (unpriced.length) return {total: null, ticked: allTicked, info: info, blocked: true, units: per,
                               why: 'ticked work the card carries no figure for: ' + [...new Set(unpriced.map(x => x.name))].join(', ')};
  return {total: allTicked.reduce((s, x) => s + (x.rate || 0), 0), ticked: allTicked, info: info,
