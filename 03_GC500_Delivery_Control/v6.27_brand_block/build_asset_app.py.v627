  ['accessories', 'assetNumbers', 'notes', 'rates', 'accRates', 'fenceRates', 'fenceCosts', 'weeks', 'supplied', 'fenceDone', 'deleted', 'delivery', 'stamps', 'contracts', 'rental', 'branch', 'locations', 'descs', 'items', 'qtys', 'aside', 'moves', 'hireStart', 'mapRef', 'by', 'dropPhotos', 'units', 'docketPapers', 'loads', 'purchaseOrders', 'labour', 'eventHours', 'minDays'].forEach(k => { if (k in rec && !isObj(rec[k])) bad.push(k + ' is not a keyed object'); count(rec[k], k); });
  /* a labour tick is only ever true; hours are a number of hours in a day */
  Object.entries(isObj(rec.labour) ? rec.labour : {}).forEach(([k, v]) => { if (v !== true) bad.push('labour tick ' + k + ' is not a tick'); });
  Object.entries(isObj(rec.eventHours) ? rec.eventHours : {}).forEach(([k, v]) => { const n = Number(v); if (v == null || v === '' || !Number.isFinite(n) || n < 0 || n > 24) bad.push('hours ' + k + ' is not a number of hours in a day'); });
  /* a hire start is a day or nothing; a move names the reference it went to */
