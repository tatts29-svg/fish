  const link = /^(?:https?:|\/)/i.test(original) ? `<a href="${esc(original)}" target="_blank" rel="noopener">Open original</a>` : '';
  d.innerHTML = `<div class="dphgone docpreview-fallback"><b>Preview could not load</b><span>The image could not be displayed. File availability is unchanged; try opening the original.</span>${t.closest('a') ? '' : link}</div>`;
