       + '. The original service files are retained.' + uploadPreviewNote(up));
}
async function dropPhotoRemove(key, slot, say, unit){
  const tell = say || flash;
  if (SYNC.readonly) return tell('View only — this link shows the record but cannot change it.');
  const u = unitKey(unit), got = dropPhotoSlots(key, u), gone = got[slot];
  if (!gone) return;
  dropPhotoGroupSet(key, u, got.map((x, i) => x && Object.assign({}, x, {slot: i})).filter(Boolean).filter(x => x.slot !== slot));
  bump();
