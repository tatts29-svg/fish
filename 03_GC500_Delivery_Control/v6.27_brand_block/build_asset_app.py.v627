# The friendly name for each drawing family. Anything in the register for project 26003 that is not named
# here gets the register's own title, so a new sheet — the fencing drawings, when they land — appears on the
# map after a rebuild without anybody editing this file.
SHEET_LABELS = {
    'D022': 'Portable buildings', 'D023': 'Toilets & amenities', 'D024': 'Generators & light towers',
    'D025': 'Variable message signs', 'D007': 'Event week site access', 'K220': 'Water barriers',
    'D001': 'Fencing', 'D016': 'Cypress carpark',
}
# The order the tabs sit in. Families not listed go after these, in register order.
SHEET_ORDER = ['D022', 'D023', 'D024', 'D025', 'D007', 'K220', 'D001', 'D016']


def sheet_images() -> dict:
    """Every sheet the map offers: the aerial, then one tab per 26003 drawing family, read from the register.

    The K-sheets share one file and one basemap crop; only the master K220 is offered, as before. Historical
    sheets (25003, 23003) are never offered — the map is the 2026 circuit.
    """
    reg = json.loads((ROOT / 'pipeline/drawing_register.json').read_text(encoding='utf-8'))
    cur = AS.current()
    out = {'AERIAL': ('Site aerial',
                      (f"Queensland Government aerial, {cur['captured']} · to scale, north to the left"
                       if cur['kind'] == 'qld2022' else
                       'Restored basemap from the 26003 drawings. Orientation only.'), None)}
    fam: dict = {}
    for sh in reg['sheets']:
        if sh.get('project_no') != '26003' or not sh.get('file'):
            continue
        key = sh['dwg_no']
        if key.startswith('K2') and key != 'K220':
            continue
        if key in fam:                                          # one tab per family; first entry wins
            continue
        title = (sh.get('title') or '').split(' (')[0]
        fam[key] = (SHEET_LABELS.get(key, title or key), f"{sh['sheet_id']} · {title}", sh['sheet_id'])
    for key in SHEET_ORDER:
        if key in fam:
            out[key] = fam.pop(key)
    out.update(fam)
    return out


SHEET_IMAGES = sheet_images()
