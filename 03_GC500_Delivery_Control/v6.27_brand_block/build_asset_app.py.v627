  rep.summary = [['delivery', 'lights/times'], ['supplied', 'supplied records'], ['variances', 'variances'], ['dockets', 'fencing dockets'], ['breakdowns', 'breakdowns'], ['contracts', 'rental contracts'], ['rental', 'Rental IDs on assets'], ['branch', 'branch codes on assets'], ['loads', 'carrier loads paired'], ['costs', 'cost lines'], ['pos', 'purchase orders'], ['notes', 'notes'],
                 ['added', 'added assets'], ['accessories', 'accessories'], ['assetNumbers', 'asset numbers'], ['quote', 'fencing quote'], ['pins', 'recorded positions']]
    .filter(([k]) => rep[k]).map(([k, w]) => rep[k] + ' ' + w).join(', ') || 'nothing new';
