  const one = r => ({contract: r.rental_contract, line: r.line, item: r.item, description: r.what || r.description, qty: r.quantity, kind: r.kind,
                     rate_1: r.rate_1, rate_2: r.rate_2, rate_type: r.rate_type, prebill: r.prebill_amount, supplier: r.supplier_sub_rental || null, branch: r.branch_code,
                     charge: amt(r), how: ch.get(r).how, basis: ch.get(r).basis, days: ch.get(r).days});
  const known = rows.filter(r => typeof amt(r) === 'number'), unknown = rows.filter(r => typeof amt(r) !== 'number');
  const diff = rows.filter(r => ch.get(r).differs);
