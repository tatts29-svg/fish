  bump(); buzz(40);
  flash('Moved what was recorded against ' + from + ' to ' + to + ' — ' + who + ', ' + fmtStamp(now) + '. ' + from + ' now says so. The schedule, the drawings and the rental system are untouched; photographs, the map and any variance, breakdown, cost or action stay on ' + from + '.');
  return true;
}
function movedLine(key){
  const m = movedAway(key); if (!m) return '';
  if (m.returned) return `<div class="notice info movedline"><b>The record that sat here went back to <button class="linkish" data-k="${esc(m.to)}">${esc(m.to)}</button></b> — ${esc(m.by || 'unnamed')}${m.at ? ' · ' + esc(fmtStamp(m.at)) : ''}. ${esc(key)} carries nothing of its own again; the schedule's own row, callout and numbers are unchanged.</div>`;
  return `<div class="notice warn movedline"><b>Moved to <button class="linkish" data-k="${esc(m.to)}">${esc(m.to)}</button></b> — ${esc(m.by || 'unnamed')}${m.at ? ' · ' + esc(fmtStamp(m.at)) : ''}. What was recorded against ${esc(key)} is on ${esc(m.to)} now; the schedule's own row, callout and numbers are unchanged here.
