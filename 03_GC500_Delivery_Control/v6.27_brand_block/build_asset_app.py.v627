  const bytes = recordBytes(), big = bytes > 3.5e6 ? ` · the record here is ${(bytes / 1e6).toFixed(1)} MB, near what a browser keeps — export it now` : '';
  const wait = waiting ? ` · ${waiting} change${waiting === 1 ? '' : 's'} waiting to send` : '';
