      else if (x.category !== K.category) bad.push('our cost line ' + x.id + ' has a category that is not its kind\'s: ' + JSON.stringify(x.category).slice(0, 60));
      if (x.kind !== 'person' && (!day(x.date) || x.date == null)) bad.push('our cost line ' + x.id + ' has a date that is not a day');
      if (!nonneg(x.amount) || !nonneg(x.hours) || !nonneg(x.accommodation_rate) || !nonneg(x.break_min)) bad.push('our cost line ' + x.id + ' has a figure that is not a non-negative number');
      if (x.charged_as && !eventRoles().some(r => r.role === x.charged_as)) bad.push('our cost line ' + x.id + ' is charged as a role the card does not carry');
