      _qtyTyped: typedQty != null ? {to: typedQty, from: (a.charge_lines && a.charge_lines.length) ? a.charge_lines[0].quantity : null,
                                     at: (S.stamps || {})['qtys/' + a.key] || null,
                                     by: ((S.by || {})['qtys/' + a.key]) || null} : null,
      _qtyUnreadable: typedQtyRaw != null && String(typedQtyRaw).trim() !== '' && typedQty == null,
      _nameOnTheSchedule: a.name || null,
