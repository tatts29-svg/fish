          unknown_kinds: [...unknown.reduce((m, r) => m.set(r.kind || 'line', (m.get(r.kind || 'line') || 0) + 1), new Map()).entries()].sort((a, b) => b[1] - a[1]),
          daily: {lines: daily.length, charge: sum(daily, amt)}, event: {lines: event.length, charge: sum(event, amt)},
          differs: diff.map(r => Object.assign(one(r), {reads: ch.get(r).reads})), differs_charge: sum(diff, amt), differs_prebill: sum(diff, r => r.prebill_amount),
          prebill: sum(rows, r => r.prebill_amount), prebill_lines: rows.filter(r => typeof r.prebill_amount === 'number').length,
          billed: sum(rows, r => r.billed_amount),
          plant: {lines: plant.length, charge: sum(plant, amt), prebill: sum(plant, r => r.prebill_amount), rated: plant.filter(r => typeof r.rate_1 === 'number').length,
                  unrated: plant.filter(r => typeof r.rate_1 !== 'number').length},
          subhire: {lines: sub.length, charge: sum(sub, amt), prebill: sum(sub, r => r.prebill_amount), items: sub.map(one)},
