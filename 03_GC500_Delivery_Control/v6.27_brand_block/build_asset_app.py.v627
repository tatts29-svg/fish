function assetTotal(a){
  const span = chargeSpanOf(a);
  const w = assetWeeks(a).w;                     /* how long it is on site — kept, and shown beside the charge */
  let transport = 0, transportKnown = true;
  let labourSum = 0, labourKnown = true, labourAny = false;
  const lines = chargeLines(a).map(l => {
    const r = rateFor(l.discipline, l.item, a.key);
    const min = minHireFor(l.discipline, l.item, a.key);
    const cd = chargedDays(span, min);
    const t = l.priceable ? lineMoney(r, l.quantity, cd.days) : null;
    /* F06: dimensions, checked separately from the rate match */
    const u = unitCheck(l, r);
    /* transport: the Gold Coast CHARGE on the transport tab, per unit, kept apart from hire */
    const tc = r.card && r.card.transport && typeof r.card.transport.charge === 'number' ? r.card.transport.charge : null;
    if (tc != null && l.priceable && l.quantity != null) transport += tc * l.quantity; else transportKnown = false;
    /* labour per piece, charged only where somebody has ticked it */
    const lab = labourMoney(a.key, l, a.key, a);
    if (lab.ticked.length) labourAny = true;
    if (lab.total == null) labourKnown = false; else labourSum += lab.total;
    return {item:l.item, discipline:l.discipline, qty:l.quantity, priceable:l.priceable,
            quantity_state:l.quantity_state, rate:r.value, per:r.per, source:r.source, card:r.card,
            transport_charge: tc, transport_cost: r.card && r.card.transport && typeof r.card.transport.cost === 'number' ? r.card.transport.cost : null,
            unit_resolved: u.resolved, unit_declared: u.declared, unit_given: u.given, unit_why: u.why,
            /* the days this line is actually charged for, and whether the card's minimum lifted them */
            days: cd.days, days_floored: cd.floored, min_days: cd.min, window_days: span.days,
            minimum: min, labour: lab,
            /* the money this line WOULD be if the unit were the card's. Shown as a scenario, never added in. */
            provisional: u.resolved ? null : (Number.isFinite(t) ? t : null),
            total: (u.resolved && Number.isFinite(t)) ? t : null};
  });
  const baseKnown = lines.length > 0 && lines.every(l => l.total != null);
  const base = baseKnown ? lines.reduce((s,l) => s + l.total, 0) : null;
  let accSum = 0, accKnown = true;
  (a.accessories||[]).forEach(x => {
    const ar = accRateFor(x.type);
    /* an accessory rides in the thing it is in, so it is charged over the same window — a flat rate ignores it */
    const t = lineMoney(ar, x.qty || 1, span.days);
    if (t == null) accKnown = false; else accSum += t;
  });
  const accTotal = (a.accessories||[]).length ? (accKnown ? accSum : null) : 0;
  const labourTotal = labourAny ? (labourKnown ? labourSum : null) : 0;
  /* `total` is the asset's full price and is null the moment anything is missing. `known` is the money that can
     be worked out right now — a building whose quantity cell is blank still has a fridge in it on known weeks.
     The running total sums `known`, so every dollar shown in the rate card is a dollar in the headline. */
  const known = lines.reduce((s,l) => s + (l.total || 0), 0) + (accSum || 0) + (labourSum || 0);
  return {weeks:w, span: span, lines, base, accessories:accTotal, labour: labourTotal, labour_any: labourAny, known,
          transport: lines.length ? transport : 0, transport_known: transportKnown,
          /* the accessories that CAN be priced now, even where another on the same reference cannot — the part of
             `known` that is accessories, so a figure built from the lines adds up to the Pricing tab's subtotal */
          accessories_known: accSum,
          total:(base != null && accTotal != null && labourTotal != null) ? base + accTotal + labourTotal : null};
}
/* the ticks on one reference: every labour line the card offers on each of its item types */
function labourTicksHtml(a){
  const lines = chargeLines(a);
  if (!lines.length) return '<span class="chip">no item type on this reference</span>';
  if (movedAway(a.key)) return '<span class="chip cand">record moved — see the reference it went to</span>';
  const units = labourUnits(a);
  /* what the card says the money is, said in the tick's own label rather than left to be guessed */
  const labWords = L => L.money === 'rate' ? money(L.rate)
                      : L.money === 'zero' ? '$0.00 on the card'
                      : L.money === 'included' ? 'included in the hire'
                      : L.money === 'spread' ? 'not settled'
                      : L.money === 'poa' ? String(L.as_written || 'POA')
                      : 'no figure on the card';
  const labCls = L => L.money === 'rate' ? '' : L.money === 'zero' || L.money === 'included' ? ' labnil' : ' labunk';
  const out = lines.map(l => {
    const info = labourLinesFor(a.key, l.discipline, l.item, a.key);
    const q = qtyOf(l);
    if (!info.lines.length) return `<div><b>${esc(l.item)}</b> — <span class="chip" title="${esc(info.withheld && info.withheld.length ? 'the card carries no figure for ' + info.withheld.join(', ').toLowerCase() + ' on this item, so none is added (Andrew Fisher, 24 Sep 2026)' : '')}">${esc(info.state === 'no rate line' ? 'not matched to a card line' : 'no labour priced on the card for this item')}</span></div>`;
    const m = labourMoney(a.key, l, a.key);
    /* one set of ticks per building where the reference carries more than one asset number, else one set */
    const tickSet = (unit) => info.lines.map(L0 => {
      const L = unit ? (labourLinesFor(a.key, l.discipline, l.item, a.key, unit).lines.find(x => x.key === L0.key) || L0) : L0;
      return `<label class="labtick${labCls(L)}" title="${esc((L.heading || 'not a column on this item’s block of the card') + (L.money_note ? ' — ' + L.money_note : '') + (L.year_note ? ' — ' + L.year_note : ''))}">
        <input type="checkbox" data-lab="${esc(labourKey(a.key, l.discipline, l.item, L.key, unit))}" ${L.ticked ? 'checked' : ''}>
        ${esc(L.name)} <span class="w" style="color:var(--mute)">${esc(labWords(L))}${L.money === 'rate' && !unit && q != null && q !== 1 ? ' × ' + esc(String(q)) : ''}</span>${
        L.ticked ? `<span class="edby">${esc(L.by || 'unnamed')}${L.at ? ' · ' + esc(fmtStamp(L.at)) : ''}</span>` : ''}</label>`; }).join('');
    const body = units.length
      ? `<div class="labunits">${units.map(u => `<div class="labunit"><div class="labunith">${esc(u)}${
           unitWordsFor(a, u) ? ' <span>' + esc(unitWordsFor(a, u)) + '</span>' : ''}</div>
           <div class="labticks">${tickSet(u)}</div></div>`).join('')}</div>`
      : `<div class="labticks">${tickSet(null)}</div>`;
    const said = m.blocked ? esc(m.why || 'ticked, and the money is not known')
               : m.ticked.length ? esc(money(m.total)) + ' labour ticked' + (m.perBuilding ? ' — one charge a building' : '')
               : 'not ticked — no labour charged on this line yet';
    return `<div><b>${esc(l.item)}</b>${q == null && !units.length ? ' <span class="chip crit">qty not readable — a tick here cannot be costed</span>' : ''}${
      units.length ? ` <span class="chip ref" title="this reference carries ${units.length} asset numbers, so each one is ticked on its own">${units.length} buildings</span>` : ''}${
      info.agreed_from ? ` <span class="chip cand" title="${esc('the hire rate is not settled — ' + info.agreed_from.join(', ') + ' could all be this item — but every one of them gives the same labour, so these are the card’s own figures')}">labour agreed across the card’s candidates</span>` : ''}
      ${body}
      <div class="w" style="font-size:11.5px;color:var(--mute)">${said}${
        info.withheld && info.withheld.length ? ` · <span title="${esc('not on this item: the card carries no figure for ' + info.withheld.join(', ').toLowerCase() + ' on its line (Andrew Fisher, 24 Sep 2026)')}">${info.withheld.length} other labour type${info.withheld.length === 1 ? '' : 's'} not priced on the card</span>` : ''}</div></div>`;
  });
  return out.join('');
}
/* ------------------------------------------------------------------ the labour ticks and the hours: setters
   A tick is a decision with a name on it, exactly as a rate typed over the card is: only on an editing link, only by
   a named person, and the name and the time are kept beside it so any list can say who ticked it. Unticking is
   recorded the same way — the tick is removed and the stamp says who removed it and when. */
function setLabour(ref, disc, item, line, on, unit){
  if (!mayWrite('a labour tick')) return false;
  const who = whoAmI(); if (!who) return false;
  const k = labourKey(ref, disc, item, line, unit);
  S.labour = S.labour || {};
  /* v5.58 — THE FIRST PER-BUILDING EDIT MOVES AN OLD WHOLE-REFERENCE TICK ONTO THE BUILDINGS.
     The 19 Sep 2026 audit: a tick recorded against the reference before v5.55 counts for every building on it,
     and the reader says `unit tick OR reference tick`. So unticking ONE building deleted its own key and
     changed nothing, because the old reference tick still answered true for it — WC15 stayed at $291.48 with
     the setter reporting success. A person could not take a tick off.

     Deleting the reference tick outright would untick every sibling nobody touched. So the old tick is spread
     first: one explicit key per building, each stamped in this person's name with the note that it came from
     the reference tick, and then the reference key goes. After that the building asked about is set as asked.
     Every sibling keeps exactly what it had; the record simply says it per building now. */
  if (unit) {
    const refKey = labourKey(ref, disc, item, line);
    if (S.labour[refKey]) {
      const a = allAssets().find(x => x.key === ref);
      (a ? labourUnits(a) : []).forEach(u => {
        const uk = labourKey(ref, disc, item, line, u);
        if (!S.labour[uk]) { S.labour[uk] = true; stampIt('labour', uk, who); }
      });
      delete S.labour[refKey]; stampIt('labour', refKey, who);
    }
  }
  if (on) S.labour[k] = true; else delete S.labour[k];
  stampIt('labour', k, who); save(); bump();
  return true;
}
/* every reference carrying this item type, ticked or unticked in one go — each one stamped by name */
function setLabourAll(disc, item, line, on){
  if (!mayWrite('labour ticks')) return false;
  const who = whoAmI(); if (!who) return false;
  S.labour = S.labour || {};
  let n = 0;
  allAssets().filter(a => !a._cancelled && !movedAway(a.key)).forEach(a => chargeLines(a).forEach(l => {
    if (l.discipline !== disc || l.item !== item) return;
    /* v5.55 — a reference with two buildings gets a tick on each, so Tick all means every building on the job */
    const us = labourUnits(a);
    (us.length ? us : [null]).forEach(u => {
      const k = labourKey(a.key, disc, item, line, u);
      if (on) S.labour[k] = true; else delete S.labour[k];
      /* an older reference-level tick is cleared too, so Untick all really does untick */
      if (!on && u) delete S.labour[labourKey(a.key, disc, item, line)];
      stampIt('labour', k, who); n++;
    });
  }));
  save(); bump();
  return n;
}
const HOURS_MAX = 24;
function eventHoursKey(role, day){ return role + '|' + day; }
function eventHoursOf(role, day, RH){
  const v = (S.eventHours || {})[eventHoursKey(role, day)];
  if (v == null || v === '') {
    /* v5.81 — nothing typed for this day and role: the tracker's race-day hours of the people charged as it
       (the race weekend is what we charge — Andrew Fisher, 25 Sep 2026) */
    const x = (RH || raceRoleHours()).get(eventHoursKey(role, day));
    return x && x.hours > 0 ? x.hours : null;
  }
  const n = Number(v);
  return Number.isFinite(n) && n >= 0 && n <= HOURS_MAX ? n : null;
}
function setEventHours(role, day, v){
  if (!mayWrite('hours')) return false;
  const who = whoAmI(); if (!who) return false;
  const k = eventHoursKey(role, day);
  S.eventHours = S.eventHours || {};
  if (String(v == null ? '' : v).trim() === '') delete S.eventHours[k]; else S.eventHours[k] = String(v).trim();
  stampIt('eventHours', k, who); save(); bump();
