  Object.entries(isObj(rec.moves) ? rec.moves : {}).forEach(([k, v]) => { if (v != null && (!isObj(v) || typeof v.to !== 'string' || !v.to.trim())) bad.push('the move of ' + k + ' names no reference it went to'); });
  /* what hangs off those maps: an accessory list that is not a list, a supplied row that is not a row */
  Object.entries(isObj(rec.accessories) ? rec.accessories : {}).forEach(([k, v]) => { if (!Array.isArray(v)) bad.push('accessories on ' + k + ' is not a list'); });
  Object.entries(isObj(rec.assetNumbers) ? rec.assetNumbers : {}).forEach(([k, v]) => { if (!Array.isArray(v)) bad.push('asset numbers on ' + k + ' is not a list'); });
  Object.entries(isObj(rec.docketPapers) ? rec.docketPapers : {}).forEach(([k, v]) => { if (!Array.isArray(v)) bad.push('papers on docket ' + k + ' is not a list'); });
  if (rec.fenceQuote != null && !isObj(rec.fenceQuote)) bad.push('fenceQuote is not an object');
  text(rec.operator, 'operator');
