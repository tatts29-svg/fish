const ERASED = '(erased — a wrong number, never on the job)';
function numberErased(id){ return ((S.notes || {})[id] === ERASED) || (((COMMITTED && COMMITTED.notes) || {})[id] === ERASED); }
function untombBy(id){ return ((S.by || {})['deleted/' + UNDO + id]) || null; }
/* And a putting-back is a record too. From an outside audit of 14 Sep 2026, TR-07: putting a removed asset
