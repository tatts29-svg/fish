function existingPhotosFor(key){
  const out = new Map();
  dropPhotosOf(key).forEach(x => { if (!out.has(String(x.id))) out.set(String(x.id), {id: String(x.id),
    label: (x.caption || (DROP_SLOTS[x.slot] || {}).lab || x.name || String(x.id)) + (unitKey(x.unit) ? ' \u2014 asset ' + unitKey(x.unit) : ' \u2014 ' + key)}); });
  const filed = filedPhotosOf(key);
  (filed.files || []).forEach(f => { if (!out.has(String(f.id))) out.set(String(f.id), {id: String(f.id), label: (f.name || String(f.id)) + ' \u2014 filed'}); });
