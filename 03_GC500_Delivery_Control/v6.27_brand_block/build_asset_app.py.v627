# Where each one comes from, and what makes it. The four photographs are Andrew Fisher's own files; the made
# pictures are in sources/brand/generated. Both are reduced to a card-sized webp here so the page carries them.
PRODUCT_SOURCES = {
    'card_buildings_6x3.webp':       'brand/products/card_buildings_6x3.png',
    'card_buildings_12x3.webp':      'brand/products/card_buildings_12x3.png',
