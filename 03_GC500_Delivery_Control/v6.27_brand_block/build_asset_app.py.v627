function labourUnits(a){
  /* v5.59 — the BUILDINGS, never the things inside them: a fridge is not a place to fit stairs */
  const u = buildingNumbersOf(a).filter(Boolean);
  return u.length > 1 ? u : [];
}
function labourTicked(ref, disc, item, line, unit, asset){
  if (movedAway(ref)) return false;
  const L = S.labour || {};
  /* a tick recorded against the reference before v5.55 counts for every building on it */
  if (unit) return !!(L[labourKey(ref, disc, item, line, unit)] || L[labourKey(ref, disc, item, line)]);
  if (L[labourKey(ref, disc, item, line)]) return true;
  /* asked about the reference as a whole, where it carries several buildings: it is ticked when EVERY building
