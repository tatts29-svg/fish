    if (d.levelled != null && typeof d.levelled !== 'boolean') bad.push('delivery ' + k + ' levelled is not true or false');
    if (d.steps != null && typeof d.steps !== 'boolean') bad.push('delivery ' + k + ' steps is not true or false');
    if (!day(d.date) || !day(d.out_date)) bad.push('delivery ' + k + ' has a moved day that is not a day');
    if (d.eta != null && d.eta !== '' && !/^([01]\d|2[0-3]):[0-5]\d$/.test(String(d.eta))) bad.push('delivery ' + k + ' has a planned time that is not a time of day (hh:mm, 24-hour): ' + JSON.stringify(d.eta).slice(0, 20));
    text(d.note, 'delivery ' + k + ' note'); text(d.by, 'delivery ' + k + ' by');
    ['history', 'done_history', 'levelled_history', 'steps_history'].forEach(h => { if (d[h] != null && !Array.isArray(d[h])) bad.push('delivery ' + k + ' ' + h + ' is not a list'); }); });
  Object.entries(isObj(rec.notes) ? rec.notes : {}).forEach(([k, v]) => text(v, 'note ' + k));
  Object.entries(isObj(rec.supplied) ? rec.supplied : {}).forEach(([k, r]) => { if (!isObj(r)) bad.push('supplied ' + k + ' is not an object'); else if (r.items != null && !Array.isArray(r.items)) bad.push('supplied ' + k + ' items is not a list'); });
  Object.entries(isObj(rec.fenceDone) ? rec.fenceDone : {}).forEach(([k, r]) => { if (!isObj(r) || typeof r.done !== 'boolean') bad.push('fencing area ' + k + ' tick is not yes/no'); else if (!iso(r.at)) bad.push('fencing area ' + k + ' tick has a time that is not a timestamp'); });
  Object.entries(isObj(rec.stamps) ? rec.stamps : {}).forEach(([k, v]) => { if (!iso(v)) bad.push('stamp ' + k + ' is not a timestamp'); });
  Object.entries(isObj(rec.purchaseOrders) ? rec.purchaseOrders : {}).forEach(([no, o]) => {
