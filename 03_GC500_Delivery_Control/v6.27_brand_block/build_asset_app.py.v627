/* things recorded as units that are NOT a building and NOT contents either — a hire line of their own on the
   card (a waste tank is "Waste Tank 6m (Additional)" under toilets). Never a place for stairs; never a fridge. */
const NOT_A_BUILDING = ['waste tank', 'tank'];
function notABuilding(label){ const s = String(label || '').trim().toLowerCase(); return !!s && NOT_A_BUILDING.some(k => s === k || s.startsWith(k + ' ')); }
/* the contents type a name is, or null when the name is not contents (a toilet block, a board, a building) */
function contentsType(label){
  const s = String(label || '').trim().toLowerCase().replace(/\s+/g, ' ');
