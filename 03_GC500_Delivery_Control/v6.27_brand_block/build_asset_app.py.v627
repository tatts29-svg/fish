/* ------------------------------------------------------------------ plant lines
   Andrew Fisher, 11 Sep 2026: plant shows everything — the VMS boards, the forklifts and the misc lines
   (forklift tynes) were missing. The register was built from drawing references, and a thing nobody drew never became an
   asset — every VMS board, every forklift, the track mat and the tynes. They are schedule rows on a real contract
   with real plant numbers, and they are carried here under the schedule's own task id (T0001, T0003 …), which is
   stable and can never be mistaken for a drawing reference. A plant line is shaped like an asset — item types,
   quantity, events, hire span, charge lines — so it counts, lights and prices like one. It has no position:
   nothing was drawn, so nothing goes on the map. */
const PLANT_LINES = ((DATA.plant_lines || {}).lines || []).map(l => Object.assign({}, l, {_plant: true}));
function isPlantLine(a){ return !!(a && a._plant); }
/* v5.53 — A REFERENCE OF HIS CHOOSING. Andrew Fisher, 18 Sep 2026: some things cannot be given a reference because
   of what they are called — most would begin with the letter T, such as T0024 or T0004 — so any reference he
   chooses can be given when there is no other option.

   A plant line is carried under the schedule's own task id because nothing was drawn for it. That id is stable
   and honest, and nobody on site would ever say it. So a person with the edit link can GIVE a plant line a
   reference — P70, GN30, whatever the site calls the thing — and from then on the line IS that reference on
   every page: the map, the drawer, the pins, the photographs, the drop sheet, the register, the search box.
   The schedule row underneath keeps its task id (the schedule is never overwritten) and the page shows the
   trail, "schedule row T0024", wherever the reference is named in full. What was already recorded against the
   task id is moved to the new reference the way any record moves, with a way back: taking the reference off
   moves it home again. The reference must be one nobody else has. */
function givenRefs(){ return S.givenRefs || {}; }
function givenRefOf(taskId){ const g = givenRefs()[taskId]; return g && g.ref ? g : null; }
function taskIdOfRef(ref){ const e = Object.entries(givenRefs()).find(([, g]) => g && g.ref === ref); return e ? e[0] : null; }
function plantLineOf(key){
  return PLANT_LINES.find(l => l.key === key || (givenRefOf(l.key) || {}).ref === key) || null;
}
/* the plant lines as the page shows them: under the given reference where there is one */
function plantLinesShown(){
  return PLANT_LINES.map(l => { const g = givenRefOf(l.key); return g ? Object.assign({}, l, {key: g.ref, task_id: l.key, _given: g}) : l; });
}
const GIVEN_REF_RE = /^[A-Z][A-Z0-9-]{1,11}$/;
function giveLineReference(taskId, ref){
  if (!mayWrite('a reference')) return false;
  taskId = String(taskId || '').trim().toUpperCase(); ref = String(ref || '').trim().toUpperCase();
  const who = whoAmI(); if (!who) return false;
  const line = PLANT_LINES.find(l => l.key === taskId);
  if (!line) { flash(taskId + ' is not one of the schedule rows carried under its task id — only those can be given a reference. Anything else is added under Tools → Edit, Add an asset.'); return false; }
  if (givenRefOf(taskId)) { flash(taskId + ' already carries the reference ' + givenRefOf(taskId).ref + ' — take that off first if it is wrong.'); return false; }
  if (!GIVEN_REF_RE.test(ref)) { flash('A reference is letters and digits, starting with a letter, up to 12 characters — P70, GN30, WC90. Nothing recorded.'); return false; }
  if (allAssets().some(a => a.key === ref) || PLANT_LINES.some(l => l.key === ref) || taskIdOfRef(ref)) { flash(ref + ' is already a reference on this job — pick one nobody else has. Nothing recorded.'); return false; }
  if (deletionOf(ref)) { flash(ref + ' was deleted for good earlier — a deleted reference is never re-used. Pick a different one. Nothing recorded.'); return false; }
  S.givenRefs = S.givenRefs || {};
  S.givenRefs[taskId] = {ref, by: who, at: new Date().toISOString()};
  stampIt('givenRefs', taskId, who);
  /* what was already recorded against the task id goes with it, the way any record moves */
  if (recordOn(taskId).length) {
    const ok = moveRecord(taskId, ref);
    if (!ok) { delete S.givenRefs[taskId]; stampIt('givenRefs', taskId, who); flash('The reference was not given: what is recorded against ' + taskId + ' could not be moved to ' + ref + '. Nothing changed.'); return false; }
  }
  bump();
  flash(taskId + ' is ' + ref + ' from here on — given by ' + who + '. The schedule row keeps its task id underneath.');
  return true;
}
function takeLineReferenceOff(taskId){
  if (!mayWrite('a reference')) return false;
  const g = givenRefOf(taskId); if (!g) return false;
  const who = whoAmI(); if (!who) return false;
  if (recordOn(g.ref).length || movedAway(taskId)) {
    const ok = moveRecord(g.ref, taskId);   /* the way back: whatever was recorded under the given reference goes home first */
    if (!ok) { flash('What is recorded against ' + g.ref + ' could not be moved back to ' + taskId + ' — the reference stays until it can. Nothing changed.'); return false; }
  }
  delete S.givenRefs[taskId];
  stampIt('givenRefs', taskId, who); bump();
  flash(g.ref + ' taken off — the row is ' + taskId + ' again, as the schedule has it.');
  return true;
}
/* Every rental line on a key: a plant line carries its own; an asset carries the extract rows whose match names
   it. The earliest start is the day the rental system has it on site. */
function rentalOf(key){
  const pl = plantLineOf(key);
  let lines = pl ? (pl.rental || []) : [];
  if (!pl) lines = ONHIRE_ROWS.filter(r => r.match && r.match.to === 'asset' && r.match.key === key);
  if (!lines.length) return null;
  /* A MISCITEM row is the rental system's own miscellaneous line — the 1.8 m tynes against the 5 t forklift. It
     is an accessory on hire, not a machine, so it never starts the hire of the thing itself and never counts as
     one. Andrew Fisher, 12 Sep 2026: there was no second forklift — it was a misc line for forklift tynes. */
  const machines = lines.filter(isMachineRow), accessories = lines.filter(r => isMiscRow(r) && !isSubhire(r));
  const starts = machines.map(r => r.start_date).filter(Boolean).sort();
  const first = machines.find(r => r.start_date === starts[0]) || machines[0] || lines[0];
  const offs = machines.map(r => r.demob_date).filter(Boolean).sort();
  const accStarts = accessories.map(r => r.start_date).filter(Boolean).sort();
  return {lines, machines, accessories, from: starts[0] || null, from_time: (first && first.start_time) || null,
          from_at: starts[0] ? new Date(starts[0] + 'T' + (((first && first.start_time) || '00:00').slice(0, 5)) + ':00+10:00').toISOString() : null,
          off: offs.length ? offs[offs.length - 1] : null,
          acc_from: accStarts[0] || null,
          contracts: [...new Set(lines.map(r => r.rental_contract).filter(Boolean))],
          branches: [...new Set(lines.map(r => r.branch_code).filter(Boolean))],
          subhires: machines.filter(isSubhire),
          /* a subhire has no Coates asset number — MISCITEM is the rental system's placeholder, never a number */
          numbers: machines.filter(r => !isMiscRow(r)).map(r => r.asset_no).filter(Boolean)};
}
/* Andrew Fisher, 11 Sep 2026: on hire is on site — a thing is on site before he is, and he is on site from the Monday. So a
   rental start puts the thing on site from that day, and says so in the rental system's name. */
const RENTAL_BY = 'Coates rental system';
function rentalDelivery(key, asOf){
  const r = rentalOf(key); if (!r || !r.from) return null;   // accessories on hire do not put a machine on site
  if (asOf && r.from > asOf) return null;
  return {state: 'on site', c: LIGHT['on site'].c, recorded: true, where: 'rental', by: RENTAL_BY, set_at: r.from_at,
          rental: r, note: 'on hire from ' + fmtDate(r.from) + (r.from_time ? ' ' + r.from_time : '') + ' — the rental system\'s record; set the light yourself to override it',
          eta: null, eta_where: null, history: [], date: null, date_by: null, date_at: null, date_where: null,
          out_date: null, out_by: null, out_at: null, done: false, done_by: null, done_at: null, done_where: null,
          levelled: false, levelled_by: null, levelled_at: null, levelled_where: null,
          steps: false, steps_by: null, steps_at: null, steps_where: null};
}

/* ------------------------------------------------------------------ what a row of the register IS
   For every discipline but one, a row is an asset: one building, one toilet, one generator, one light tower.
   Count the rows and you have counted the plant. The water-filled barrier rows are not assets — each is a work
   front, a named place on the circuit — so "15" there is fifteen PLACES, and how many barriers go to each is a
   note on the K sheets that the master and the detail sheets disagree about. This page used to print that 15 as
   a barrier count. It does not any more: everywhere a discipline total is shown, it is shown with the word for
   what it counts, and the barrier quantity is shown only beside its disagreement. */
const DISC_UNIT = (DATA.summary && DATA.summary.discipline_units) || {};
function discUnit(d){ return DISC_UNIT[d] || {one: 'asset', many: 'assets', why: null, quantity_is_on: null}; }
function discWord(d, n){ const u = discUnit(d); return n === 1 ? u.one : u.many; }
/* "Water-filled barriers 15 locations" — the word is the point, so it is never dropped to save room */
function discCount(d, n){ return `${n} ${discWord(d, n)}`; }

/* ------------------------------------------------------------------ counting things, not rows
   Andrew Fisher, 12 Sep 2026: schedule lines mislead — plant shows total numbers (there are more than 7 VMS and
   more than 1 trackmat).
   He was right: the Plant tab, the Register buttons and the trade tables were all counting SCHEDULE ROWS and
   calling the answer a plant count. Seven rows move twenty-two boards; one row lays twenty track mats.

   One rule, one function, read by every page — the plates, the Plant tab, the Register, the trade tables, the
   branch plates, the email and the printed page — so no two of them can ever disagree:

     · a charge line whose quantity cell reads as a number asks for that many things;
     · a reference the schedule gives no readable quantity for asks for ONE thing — LT01 is one tower position
       on D024, P13 is one office, WC05 is one combo block. A reference is a thing in a place;
     · a relocation row moves plant already on site and asks for nothing.

   Counting a drawn position as one thing is reading the drawing. PRICING it is money, and pricing is unchanged:
   a line with no readable quantity is still not priced and still says why. The two are kept apart on purpose. */
function unitsAsked(a){
  if (!a || a.relocation) return 0;
  return chargeLines(a).reduce((n, l) => n + (l.quantity != null ? l.quantity : 1), 0);
}
/* HOW MANY THINGS A LIST ASKS FOR. One reading for every chip, filter and plate that counts a group: the things
   the schedule asks for on the references that are still on. A cancelled reference keeps its own quantity — its
   row, its drop sheet and its drawing are unchanged — but it is not work outstanding, so it is out of the totals
   people act on, and the chips say so on their face. Andrew Fisher, 15 Sep 2026: whatever we do, everything
   updates. */
function askedTot(list){ return (list || []).reduce((n, a) => n + (a._cancelled ? 0 : unitsAsked(a)), 0); }
function offCount(list){ return (list || []).filter(a => a._cancelled).length; }
function offWords(list){ const n = offCount(list);
  return n ? ` · ${n} cancelled reference${n === 1 ? '' : 's'} not counted (${(list || []).filter(a => a._cancelled).map(a => a.key).join(', ')})` : ''; }
/* the lines behind that total whose quantity the schedule does not write — named, so the count can be checked */
function noQtyLines(a){
  if (!a || a.relocation) return 0;
  return chargeLines(a).filter(l => l.quantity == null).length;
}
/* What the Coates rental system has on hire against a line by a day, split into machines and accessories.

   A MISCITEM row has no asset number. Most of the time that is an accessory — an attachment booked against a
   machine. Sometimes it is the machine: a SUBHIRED machine has no Coates asset number at all, so the rental
   system books it as a miscellaneous line with the machine named in the description. Which is which is never
   guessed from the words: a person who knows what turned up names it in sources/rental/subhired_machines.json
   and the register carries that through as `subhired_machine`.

   Andrew Fisher, 11 Sep 2026: there was no second forklift — it was a misc line for forklift tynes.
   Andrew Fisher, 12 Sep 2026, correcting it: a second forklift was delivered — a subhired forklift with tynes.
   So this line is a machine on site — a subhired 5 t forklift with 1.8 m tynes — and it still has no
   asset number, because a subhire does not have one. */
/* a miscellaneous line: the extract's MISCITEM placeholder, or (from the 23 Sep contracts) an accessory line — a fridge,
   chairs, a desk, a sink, a boiler — riding on a building's docket. Neither is the machine itself. */
function isMiscRow(r){ return String((r && r.asset_no) || '').toUpperCase() === 'MISCITEM' || (!!r && (r.family === 'accessory' || r.family === 'furniture' || r.family === 'forklift accessory') && !(r.register_type && r.match && r.match.via === 'kind of item')); }
function isSubhire(r){ return !!(r && r.subhired_machine); }
function isMachineRow(r){ return !isMiscRow(r) || isSubhire(r); }
function machinesOnHire(key, asOf){
  const r = rentalOf(key); if (!r) return [];
  return r.lines.filter(x => isMachineRow(x) && x.start_date && (!asOf || x.start_date <= asOf));
}
function accessoriesOnHire(key, asOf){
  const r = rentalOf(key); if (!r) return [];
  return r.lines.filter(x => isMiscRow(x) && !isSubhire(x) && x.start_date && (!asOf || x.start_date <= asOf));
}
/* what a group asks for and what is on site, in things — the one answer every page reads */
function groupTotals(disc, asOf){
  const rs = allAssets().filter(a => a.discipline === disc && !a._cancelled);   // cancelled is a fifth bucket, never part of a group's work
  const day = asOf || todayIso();
  let asked = 0, noQty = 0, reloc = 0, onUnits = 0, onLines = 0, numbers = 0, subhires = 0, accs = 0;
  rs.forEach(a => {
    if (a.relocation) { reloc++; return; }
    asked += unitsAsked(a); noQty += noQtyLines(a);
    const nums = machinesOnHire(a.key, day);
    numbers += nums.filter(x => !isMiscRow(x)).length; subhires += nums.filter(isSubhire).length;
    accs += accessoriesOnHire(a.key, day).length;
    const d = deliveryAsOf(a.key, day);
    const on = !!(d.recorded && (d.state === 'on site' || d.done));
    if (!on) return;
    onLines++;
    if (d.where === 'rental') { onUnits += nums.length; return; }
    /* a person's record: what they wrote down as supplied, else what the line asks for */
    const sup = itemRows(a).reduce((n, i) => n + (i.qty_supplied != null ? (Number(i.qty_supplied) || 0) : 0), 0);
    onUnits += sup || unitsAsked(a);
  });
  return {disc, lines: rs.length, asked, noQty, reloc, onUnits, onLines, numbers, subhires, accessories: accs};
}

/* The barrier quantity as the drawings state it, never as a settled figure. Null when nothing was read.
   v5.56 — the master has THREE readings, not one: counting each zone once, counting every box K220 draws (it
   draws Zone 9 twice), and what the zone sheets themselves carry. All three travel. */
function barrierQty(){
  const b = DATA.barriers; if (!b) return null;
  const m = b.coates_wfb_master_total, box = b.coates_wfb_master_total_every_box, det = b.detail_coates_total;
  if (m == null && det == null) return null;
  return {master: m, everyBox: box, detail: det, agree: m === det && (box == null || box === m),
          conflicts: (b.master_vs_detail_conflicts || []).length,
          repeated: (b.repeated_zone_boxes || []), basis: b.total_basis || '', note: b.note || ''};
}
/* The most barriers on the ground at once, worked out day by day from the schedule's own place and remove rows
   — never by adding the rows up, because WB19 and WB20 put back what WB02 and WB03 already delivered. */
function barrierPeak(){
  const b = DATA.barriers; const oh = b && b.on_hire;
  return oh && oh.peak != null ? oh : null;
}
function barrierNotice(){
  const q = barrierQty(); if (!q) return '';
  const pk = barrierPeak();
  return `<div class="notice info" style="margin-top:8px"><b>Fifteen locations, not fifteen barriers.</b>
    Each WB row is a work front — a named place on the circuit. How many barriers go to each is written on the K
    sheets as a drawing annotation, and the sheets do not agree: the <b>K220 master</b> totals
    <b>${q.master == null ? '—' : q.master}</b> Coates WFB counting each zone once${
      q.everyBox != null && q.everyBox !== q.master ? ` and <b>${q.everyBox}</b> counting every box it draws` : ''},
    the <b>K221–K231 detail</b> sheets total <b>${q.detail == null ? '—' : q.detail}</b>${
      q.agree ? '' : `, and <b>${q.conflicts + q.repeated.length}</b> zone${q.conflicts + q.repeated.length === 1 ? ' is' : 's are'} in open disagreement`}.
    ${pk ? `What the schedule actually puts on the ground is <b>${pk.peak}</b> at once, first reached on
      <b>${esc(fmtDate(pk.peak_first_reached))}</b> — counted day by day, so a barrier taken away and put back is
      not counted twice. ` : ''}None of the drawing totals is a Coates approved quantity and nothing here has been
    reconciled — the card below lists every difference and who settles it, and the K220 master and the zone plates
    open on the Documents tab.</div>`;
}
/* ------------------------------------------------------------------ v5.56 — THE BARRIERS, AS THREE DOCUMENTS
   SAY THEM. iEDM's drawing K220–K231, the Coates schedule's WB rows, and iEDM's installation table
   TP02-26003-02. Nothing on this card is reconciled: where two documents differ, both are shown and the
   difference is named with who settles it. Built by pipeline/water_barriers.py. */
function barriersCard(){
  const b = DATA.barriers; if (!b || !b.present) return '';
  const qs = b.questions || [], t = b.totals || {}, oh = b.on_hire || {};
  const tbl = b.iedm_table;
  return `<div class="card barriersfold">
    <div class="hubtitle" style="margin-bottom:6px"><h3>Water barriers — what three documents say
      <span class="chip ${qs.length ? 'crit' : 'ok'}">${qs.length} open</span></h3>
      <span class="w" style="font-size:12px;color:var(--mute)">nothing here is reconciled</span></div>
    <p class="sub">${esc(b.what_this_is || '')}</p>
    <div class="tblwrap"><table><thead><tr><th>Reading</th><th class="num">Coates barriers</th><th>What it is</th></tr></thead>
      <tbody>
      <tr><td>K220 master, each zone counted once</td><td class="num"><b>${t.drawing_master_coates_zone_counted_once ?? '—'}</b></td>
        <td>the roll-up on the key plan</td></tr>
      ${t.drawing_master_coates_every_box != null && t.drawing_master_coates_every_box !== t.drawing_master_coates_zone_counted_once
        ? `<tr><td>K220 master, every box it draws</td><td class="num"><b>${t.drawing_master_coates_every_box}</b></td>
           <td>the same key plan, counting the zone it draws twice</td></tr>` : ''}
      <tr><td>K221–K231 zone sheets</td><td class="num"><b>${t.drawing_detail_coates ?? '—'}</b></td>
        <td>what is drawn on the ground</td></tr>
      <tr class="done"><td><b>The schedule — most on the ground at once</b></td>
        <td class="num"><b>${t.schedule_most_on_the_ground_at_once ?? '—'}</b></td>
        <td>${oh.peak_first_reached ? 'first reached ' + esc(fmtDate ? fmtDate(oh.peak_first_reached) : oh.peak_first_reached) + ' — ' : ''}counted day by day across ${t.schedule_references ?? '—'} WB references, so a barrier taken away and put back is counted once</td></tr>
      </tbody></table></div>
    <p class="norate">${esc(t.reading || '')}</p>
    <p class="norate"><b>No key joins a zone to a WB reference.</b> ${esc(b.no_zone_to_reference_join || '')}</p>
    ${tbl ? `<div class="notice ${tbl.rows_not_legible ? 'warn' : 'info'}" style="margin-top:8px">
      <b>iEDM's installation table ${esc(tbl.document)} — read in part only.</b> ${esc(tbl.transcription_state)}
      <br><b>What is needed:</b> ${esc(tbl.what_is_needed)}</div>` : ''}
    ${qs.length ? `<div class="tblwrap" style="margin-top:10px"><table>
      <thead><tr><th>Where</th><th>What does not agree</th><th>Why it matters</th><th>Who settles it</th></tr></thead>
      <tbody>${qs.map(q => `<tr class="${q.settled ? 'done' : ''}">
        <td><b>${esc(q.ref)}</b></td><td>${esc(q.question)}</td><td>${esc(q.why_it_matters)}</td>
        <td>${q.settled ? '<span class="chip ok">settled</span>' : '<span class="chip cand">open</span>'} ${esc(q.ask)}</td>
      </tr>`).join('')}</tbody></table></div>`
      : '<p class="norate">Nothing is in disagreement between the three documents.</p>'}
    ${(oh.rows_not_counted || []).length ? `<p class="norate"><b>Not counted:</b> ${
      oh.rows_not_counted.map(r => esc(r.ref + ' (' + r.date + ') — ' + r.why)).join('; ')}. A blank is
      unknown, not nought.</p>` : ''}
  </div>`;
}

/* ------------------------------------------------------------------ search */
function haystack(a){
  const d = deliveryOf(a.key);
  return [a.key, a.task_id, a.name, a.discipline, (a.item_types||[]).join(' '), (a.asset_numbers||[]).join(' '),
          (a.locations||[]).join(' '), (a.accessories||[]).map(x => x.type + ' ' + x.as_written).join(' '),
          (a.drawing_links||[]).map(l => l.label).join(' '), a._note,
          /* "transit", "on site", "green" all find the lights; the eta finds a time */
          /* F01: the haystack takes the PROJECTION's words, so typing "red" finds the references somebody
             recorded as not on site and not the ones nobody has spoken about. */
          deliveryView(a).label, deliveryView(a).word, d.eta, d.note, a.first_date, d.date, d.out_date, d.date ? 'moved' : '',
          breakdownsFor(a.key).filter(b => b.open).length ? 'breakdown' : '',
          /* the rental contract: its id, the customer's code and name, the site */
          (() => { const c = contractOf(a.key); return c.id ? [c.id, c.c && c.c.customer_code, c.c && c.c.customer_name, c.c && c.c.site, c.c && c.c.contract_no].filter(Boolean).join(' ') : 'no contract'; })(),
          /* the branch: its code, so "kingston" or "no branch" finds the assets */
          (() => { const b = branchOf(a.key); return b.code ? 'branch ' + b.code : 'no branch'; })()].join(' ').toLowerCase();
}
function matches(a, q){
  if (!q) return true;
  return q.split(/\s+/).filter(Boolean).every(t => haystack(a).includes(t));
}

/* `disc` filters the register; `mapDisc` filters the markers on the sheet in front of you — two different
   questions, so two different settings. Neither is remembered between visits: a filter you forgot you set is
   how somebody concludes half the light towers are missing. */
/* Everything in here is where somebody is LOOKING. None of it is the record: a tab, a search, a picked day,
   a picked attention group. Nothing here is ever exported, merged or sent. */
let state = {tab:'map', q:'', sheet:'D022', disc:null, mapDisc:null, sel:null, zoom:1, ox:0, oy:0, rot:0, rotSheet:null, attn:'status', regView:'list',
  /* what the search found and ringed on the map: {sheet, label, key, unit, fx, fy}. Navigation, never a record. */
  found:null,
  /* which board was pressed on the map, so the drawer can mark it. Navigation, never a record. */
  unit:null,
  /* which scope the delivery instrument is reading — 'due' is what the plan asks for BY the selected day,
     'all' is the whole job including work not due yet. A viewing choice, never a record. */
  gscope:'due'};

/* ------------------------------------------------------------------ what was supplied
   Two records exist at once and must never be merged: COMMITTED is what the last rebuild read out of
   sources/ops/as_supplied.json and is what the office has; LOCAL is what has been typed into this browser
   since. Showing them as one number is how somebody ends up believing a variance was filed when it is still
   sitting on a laptop in a demountable. */
const COMMITTED = DATA.ops || {rows:[], variances:[], summary:{}, deleted:{}};
const CROW = new Map((COMMITTED.rows||[]).map(r => [r.key, r]));

function localSupplied(key){ return (S.supplied||{})[key] || {}; }

/* Asked for, against supplied, item by item. A blank supplied field is "not recorded" — never "same as asked".
   The asked quantity is the schedule's own, from the charge line, unless a person typed one: WC07 asks for
   twenty FWF, and a page that showed it as one was wrong. A cell the schedule leaves blank stays null. */
function scheduleQty(a, item){
  const l = chargeLines(a).find(x => x.item === item);
  return l && l.quantity != null ? l.quantity : null;
}
function itemRows(a){
  const gone = movedAway(a.key);
  const loc = gone ? {} : localSupplied(a.key), com = gone ? {} : (CROW.get(a.key) || {});
  const asked = a.item_types || [];
  const find = (list, t) => (list||[]).find(i => i.asked === t);
  return asked.map(t => {
    const l = find(loc.items, t), c = (com.items||[]).find(i => i.asked === t && i.state !== 'not recorded');
    const sup = (l && l.supplied) || (c && c.supplied) || null;
    return {asked:t, supplied:sup,
            qty_asked:  (l && l.qty_asked)    != null ? l.qty_asked    : (c && c.qty_asked) != null ? c.qty_asked : scheduleQty(a, t),
            qty_supplied:(l && l.qty_supplied)!= null ? l.qty_supplied : (c && c.qty_supplied),
            where: l && l.supplied ? 'local' : (c && c.supplied ? 'committed' : null),
            state: !sup ? 'not recorded' : (sup === t ? 'as asked' : 'differs')};
  });
}
function setSupplied(key, asked, patch){
  if (!mayWrite('what was supplied')) return false;
  S.supplied = S.supplied || {};
  const r = S.supplied[key] || (S.supplied[key] = {items:[]});
  r.items = r.items || [];
  let it = r.items.find(i => i.asked === asked);
  if (!it) { it = {asked}; r.items.push(it); }
  Object.assign(it, patch); stampIt('supplied', key + '/' + asked);
  if (!it.supplied && it.qty_supplied == null) r.items = r.items.filter(i => i !== it);
  if (!r.items.length && !r.recorded_by) delete S.supplied[key];
  save();
}
/* Ids are only unique within this browser, which is exactly what the tag says. The build renumbers nothing —
   two people capturing separately will both produce V-0001, and the merge is a human job with the file open. */
/* the next id for a prefix — one past the highest number that prefix has ever used here, on the committed record
   or on a deletion, so a deleted record's number is never handed out again (its tombstone would take the new one) */
function nextIdFor(letter, lists){
  const pre = (S.operator || '').trim().split(/\s+/).map(w => w[0] || '').join('').toUpperCase().slice(0, 3);
  const head = letter + '-' + (pre ? pre + '-' : '');
  let n = 0;
  const seen = id => { const m = String(id || '').match(/^([A-Z]-(?:[A-Z]{1,3}-)?)(\d+)/); if (m && m[1] === head) n = Math.max(n, Number(m[2])); };
  lists.forEach(l => (l || []).forEach(x => seen(x && x.id)));
  Object.keys(S.deleted || {}).forEach(seen);
  return head + String(n + 1).padStart(4, '0');
}
function nextVarId(){ return nextIdFor('V', [S.variances, COMMITTED.variances]); }
function allVariances(){
  return (COMMITTED.variances||[]).map(v => Object.assign({}, gradeVariance(v), v, {_where:'committed'}))
    .concat((S.variances||[]).map(v => Object.assign({}, v, {_where:'local', ...gradeVariance(v)})));
}
/* The same grading the build applies, so the page never shows a variance as stronger than the office will. */
function gradeVariance(v){
  if (v.authorised_by && v.authorised_on)
    return {authority_state:'authorised', authority_note:'authorised by '+v.authorised_by+' on '+v.authorised_on};
  if (v.authorised_by)
    return {authority_state:'named, undated',
            authority_note:v.authorised_by+' is named as authorising it, but no date is recorded'};
  if (v.recorded_by)
    return {authority_state:'recorded only',
            authority_note:'recorded by '+v.recorded_by+', nobody named as authorising it'};
  return {authority_state:'unattributed',
          authority_note:'nobody is named against this — it cannot support a claim'};
}
/* One way to get from a reference to its marker, used from the plant pages, the variance registers and the
   drawer. Three copies of this drifted apart the last time each page grew its own. */
function showOnMap(key){
  const a = allAssets().find(x => x.key === key);
  const at = a && mapPlaceFor(a);
  if (!at) { const sh = a && mapSheetFor(a); if (!sh) { flash(key + ' has no drawing link, so there is no marker to show.'); return; }
    state.sheet = sh.key; state.sel = key; state.q = ''; const qb = $('#q'); if (qb) qb.value = ''; go('map'); return; }
  /* v5.79 — the same ring the search draws: zoomed on the marker, circled, the words above the map */
  mapLocate(at.sheet.key, at.label, key, {marker: at.marker});
}
/* The first drawing link that lands on a marker this page draws: the sheet, the label the pill wears and the marker
   itself. Matched the way renderMap matches — by the drawing's own tag where both sides carry one, else by label —
   so the ring goes round the pill the map actually links to the reference. */
function mapPlaceFor(a){
  for (const l of (a && a.drawing_links || [])) {
    const sh = DATA.sheets.find(s => s.sheet_id === l.sheet); if (!sh) continue;
    const m = (sh.markers || []).find(x => x.marker_kind !== 'note' && (l.tag_id && x.tag ? x.tag === l.tag_id : x.label === l.label));
    if (m) return {sheet: sh, label: String(m.label), marker: m};
  }
  return null;
}
/* the same for one unit inside a reference: the callout it was recorded standing at */
function unitPlaceFor(u){
  if (!u || !u.sheet || !u.callout) return null;
  const sh = DATA.sheets.find(s => s.sheet_id === u.sheet || s.key === u.sheet); if (!sh) return null;
  const m = (sh.markers || []).find(x => x.marker_kind !== 'note' && calloutKey(x.label) === calloutKey(u.callout));
  return m ? {sheet: sh, label: String(m.label), marker: m} : null;
}
function showPlantGroup(key){
  const a = allAssets().find(x => x.key === key);
  state.plantGroup = (a && (a.product || a.discipline)) || null;
  go('plant');
}

const AUTH_CHIP = {'authorised':'ok', 'named, undated':'cand', 'recorded only':'cand', 'unattributed':'crit'};
const CHARGE_CHIP = {'yes':'act', 'no':'', 'to be agreed':'cand'};
function whereChip(w){
  return w === 'schedule correction'
    ? '<span class="chip ok" title="corrected out loud by the person who owns the job and applied at the build (sources/2026_Schedule/corrections.json) — the workbook still reads the day as written, beside it">schedule correction</span>'
    : w === 'rental'
    ? '<span class="chip ok" title="the Coates rental system has it on hire from this date — on hire is on site (Andrew Fisher, 11 Sep 2026); set the light yourself to override it">rental system</span>'
    : w === 'committed'
    ? '<span class="chip ok" title="read from the committed file at the last rebuild">committed</span>'
    : w === 'record'
    ? '<span class="chip ok" title="worked out on this page from the fencing dockets, at the crew\'s own sheet — nothing typed; a docket recorded here fills in here">from the record</span>'
    : w === 'given'
    ? '<span class="chip ok" title="Andrew Fisher gave this line to the build (sources/costs/given.json), as he gave it, with the day">given to the build</span>'
    : SYNC.on ? '<span class="chip cand" title="in the shared record everyone who opens this page sees, and not yet exported to the build">shared record</span>'
    : FOLDER.status === 'live' ? '<span class="chip cand" title="kept in the shared folder OneDrive syncs — everyone connected to it shares it; not yet exported to the build">shared folder</span>'
    : '<span class="chip cand" title="typed in this browser and not yet exported to the build">this browser only</span>';
}

/* ------------------------------------------------------------------ the traffic light
   Red is not on site. Amber is on the truck. Green is on the ground. One record per GC500 reference, set by a
   person whose name travels with it, plus the time the thing is due on site. Before anybody records anything
   every reference reads red — which is true, nothing is on site before the first truck — but "red because
   somebody said so" and "red because nobody has said anything" stay visibly different, here and in the build.
   The committed copy (last rebuild) and the local one (this browser) are never merged: local wins on screen and
   is labelled local. */
const LIGHT = {
  'not on site': {c:'red',   word:'Red',   label:'Not on site'},
  'in transit':  {c:'amber', word:'Amber', label:'In transit'},
  'on site':     {c:'green', word:'Green', label:'On site'},
};
const LIGHT_ORDER = ['not on site', 'in transit', 'on site'];
/* ------------------------------------------------------------------ set, or deliberately cleared?
   V11 audit, F02. For a field whose empty value MEANS something — a reschedule taken back off, a planned time
   removed — `a || b` cannot tell "nobody has set this" from "somebody cleared it on purpose". Both look false.

   Every such field carries two stamps: when it was set, and when it was cleared. This reads the later of the
   two on each side, then prefers whichever side acted last. A clear that happened after a set wins, and a
   reschedule that happened after a clear wins, whichever copy of the record each of them came from.

   Returns the value, who did it, when, which copy it came from, and — when the answer is "cleared" — who took
   it off and when, so the page can say so rather than showing a blank that looks like nothing ever happened. */
function stampedPick(side, field, byF, atF, offByF, offAtF){
  if (!side) return null;
  const set = side[field] != null && side[field] !== '' ? {v: side[field], by: side[byF] || null, at: side[atF] || null, act: 'set'} : null;
  const off = side[offAtF] ? {v: null, by: side[offByF] || null, at: side[offAtF] || null, act: 'cleared'} : null;
  if (set && off) return (String(off.at) > String(set.at || '')) ? off : set;
  return set || off;
}
function stamped(field, loc, com, byF, atF, offByF, offAtF){
  const L = stampedPick(loc, field, byF, atF, offByF, offAtF);
  const C = stampedPick(com, field, byF, atF, offByF, offAtF);
  /* the later action wins; with no stamp to compare, the local copy is the one in front of the person */
  let win = null, where = null;
  if (L && C) { const later = String(L.at || '') >= String(C.at || '') ? L : C; win = later; where = later === L ? 'local' : 'committed'; }
  else if (L) { win = L; where = 'local'; }
  else if (C) { win = C; where = 'committed'; }
  const out = {};
  out[field] = win && win.act === 'set' ? win.v : null;
  out[byF] = win && win.act === 'set' ? win.by : null;
  out[atF] = win && win.act === 'set' ? win.at : null;
  out[field + '_where'] = win && win.act === 'set' ? where : null;
  /* the reset, kept and readable: who put it back on the plan, and when */
  out[field + '_cleared'] = !!(win && win.act === 'cleared');
  out[field + '_cleared_by'] = win && win.act === 'cleared' ? win.by : null;
  out[field + '_cleared_at'] = win && win.act === 'cleared' ? win.at : null;
  return out;
}
/* The compiled record is the baseline; S holds the current field overlays. A stamp
   for THIS field makes an absent local value an explicit clear. A stamp for another
   field does not establish ownership. The build exposes no comparable ETA/note
   field stamp, so this follows the existing local-overlay contract, not a guessed
   global last-writer time. */
function deliveryTypedField(field, stampField, key, loc, com){
  const value = loc && loc[field];
  const at = (S.stamps || {})[stampField + '/' + key];
  const local = !!value || (typeof at === 'string' && !!at && Number.isFinite(Date.parse(at)));
  return {value: local ? (value || null) : (com && com[field]) || null,
          where: local ? 'local' : (com && com[field]) ? 'committed' : null, local};
}
function deliveryOf(key){
  /* a reference whose record was moved reads as nothing recorded here — with the move on its face */
  const mv = movedAway(key);
  if (mv) return {state: 'not on site', c: LIGHT['not on site'].c, recorded: false, where: null, by: null, set_at: null,
    eta: null, eta_where: null, note: null, history: [], date: null, date_by: null, date_at: null, date_where: null,
    out_date: null, out_by: null, out_at: null, done: false, done_by: null, done_at: null, done_where: null,
    levelled: false, levelled_by: null, levelled_at: null, levelled_where: null,
    steps: false, steps_by: null, steps_at: null, steps_where: null, moved: mv};
  const loc = (S.delivery || {})[key] || null;
  const com = (CROW.get(key) || {}).delivery || null;
  const src = (loc && LIGHT[loc.state]) ? loc : (com && com.recorded && LIGHT[com.state]) ? com : null;
  const state = src ? src.state : null;
  const etaField = deliveryTypedField('eta', 'eta', key, loc, com);
  const noteField = deliveryTypedField('note', 'dnote', key, loc, com);
  const eta = etaField.value;
  /* nobody has set a light: the rental system's start date is the record, and it says on site.
     Design audit, 15 Sep 2026, A02: a Complete tick on a rental-derived green was SAVED and then not SHOWN —
     setDone saw the light already green, wrote no state, and this early return carried no ticks, so the tick
     was in the record and nowhere on the page. The rental system supplies the light; the person's ticks, dates
     and note ride on top of it, exactly as they do on a light a person set. */
  if (!state) { const rd = rentalDelivery(key, null); if (rd) return Object.assign(rd, {eta, eta_where: etaField.where,
    note: noteField.local ? noteField.value : rd.note,
    ...stamped('date', loc, com, 'date_by', 'date_at', 'date_off_by', 'date_off_at'),
    ...stamped('out_date', loc, com, 'out_by', 'out_at', 'out_off_by', 'out_off_at'),
    ...ticksOf(loc, com)}); }
  return {
    state: state || 'not on site', c: LIGHT[state || 'not on site'].c,
    recorded: !!state, where: src === loc && src ? 'local' : src ? 'committed' : null,
    by: src ? (src.by || null) : null, set_at: src ? (src.set_at || null) : null,
    eta, eta_where: etaField.where,
    note: noteField.value,
    history: histOf(key, 'history'),
    /* a site reschedule: the day it is now coming (or going), with who moved it and when. The plan date is
       never overwritten — it stays on the asset and shows beside this as "moved from".

       V11 audit, F02. This used to read `local.date || committed.date`, which is a question about TRUTHINESS
       and not about what anybody did. Taking a reschedule back OFF writes no date and a reset stamp instead —
       so after a reset the local side has nothing truthy, the committed side still has the old day, and the
       page put the day a person had just removed straight back on the screen. The record was right; the read
       was wrong, which is the worst shape of this fault, because an export of it looked correct.

       A field with a meaningful empty value is resolved by STAMPS, not by truthiness: the later of "somebody
       set it" and "somebody cleared it" wins, on each side, and then the two sides are compared the same way.
       Applies to the due-in day, the due-out day, the planned time and the note — every field where empty is
       something a person chose. */
    ...stamped('date', loc, com, 'date_by', 'date_at', 'date_off_by', 'date_off_at'),
    ...stamped('out_date', loc, com, 'out_by', 'out_at', 'out_off_by', 'out_off_at'),
    ...ticksOf(loc, com),
  };
}
/* The two ticks, projected the one way wherever a delivery is read — on a light a person set and on a light the
   rental system supplies alike. The Complete tick: in position, set up, checked. It sits ON TOP of the light — it
   never replaces it and never hides anything. POSITIONED AND LEVELLED — the second, final tick. Andrew Fisher,
   15 Sep 2026: another tick of approval — positioned and levelled, the final check that closes off the asset,
   needed only for buildings and toilets, sewage tanks included.
   It sits on top of Complete the way Complete sits on top of the light. A local un-tick (false) is a record too,
   so it overrides a committed tick.
   STEPS INSTALLED — the third tick, and a SIBLING of levelled, not a stage of it. Andrew Fisher, 16 Sep 2026:
   the steps install is its own tick, separate from the others. Same population as levelled —
   every building, toilet block and tank — but neither tick waits on the other and neither one implies the
   other: a building can have its steps on before the final level check or the other way about, and two crews
   can carry the two jobs on the same day. */
function ticksOf(loc, com){
  const ld = loc && typeof loc.done === 'boolean', lv = loc && typeof loc.levelled === 'boolean';
  const st = loc && typeof loc.steps === 'boolean';
  return {
    done: ld ? loc.done : !!(com && com.done),
    done_by: ld ? (loc.done_by || null) : (com && com.done) ? (com.done_by || null) : null,
    done_at: ld ? (loc.done_at || null) : (com && com.done) ? (com.done_at || null) : null,
    done_where: ld ? 'local' : (com && com.done) ? 'committed' : null,
    levelled: lv ? loc.levelled : !!(com && com.levelled),
    levelled_by: lv ? (loc.levelled_by || null) : (com && com.levelled) ? (com.levelled_by || null) : null,
    levelled_at: lv ? (loc.levelled_at || null) : (com && com.levelled) ? (com.levelled_at || null) : null,
    levelled_where: lv ? 'local' : (com && com.levelled) ? 'committed' : null,
    steps: st ? loc.steps : !!(com && com.steps),
    steps_by: st ? (loc.steps_by || null) : (com && com.steps) ? (com.steps_by || null) : null,
    steps_at: st ? (loc.steps_at || null) : (com && com.steps) ? (com.steps_at || null) : null,
    steps_where: st ? 'local' : (com && com.steps) ? 'committed' : null,
  };
}
/* ------------------------------------------------------------------ THE delivery projection
   Superior Audit, 15 Sep 2026, F01. deliveryOf() answers what the record holds. This answers what a person
   should be TOLD, and it is the only place on the page that decides that.

   The fault it closes: deliveryOf() returns state:'not on site' when nobody has recorded anything, because red
   is the honest default for a thing that has not arrived. The instrument knew better and drew no lens — but
   every other renderer read d.state straight off the record and printed the word beside it. So "Email it" sent
   "Red — nothing recorded", the timeline sent "Red (no record)", and a past date card counted six references
   nobody had spoken about under "not on site". Three different renderers, three different sentences, one
   untrue claim in each: that somebody had reported the thing missing.

   Unknown is a FOURTH state here, not a shade of red. It lights nothing, it is never negative, and it is never
   added to a count of things that went wrong. Screen, drawer, register, map, email, copied text and every print
   renderer call this; none of them may read LIGHT[d.state] to make words again. */
const DSTATE = {
  'unknown':      {c: 'none',  word: 'No record', label: 'No delivery record', pill: 'gap',  negative: false},
  'not on site':  {c: 'red',   word: 'Red',       label: 'Not on site',        pill: 'late', negative: true},
  'in transit':   {c: 'amber', word: 'Amber',     label: 'In transit',         pill: 'plan', negative: false},
  'on site':      {c: 'green', word: 'Green',     label: 'On site',            pill: 'good', negative: false},
};
function deliveryView(a){
  const key = (a && a.key) ? a.key : a, d = deliveryOf(key);
  const semantic = d.recorded && DSTATE[d.state] ? d.state : 'unknown';
  const P = DSTATE[semantic];
  const why = d.moved
    ? (d.moved.returned ? 'record put back on ' : 'moved to ') + d.moved.to + (d.moved.by ? ' by ' + d.moved.by : '') + (d.moved.at ? ' · ' + fmtStamp(d.moved.at) : '')
    : !d.recorded
    ? 'nothing recorded yet'
    : d.where === 'rental'
      ? 'rental-derived · on hire from ' + fmtDate(d.rental.from) + (d.rental.from_time ? ' ' + d.rental.from_time : '')
      : (d.by ? d.by + ' · ' : '') + (d.set_at ? fmtStamp(d.set_at) : 'time not recorded')
        + (d.where === 'local' ? ' · ' + LW() : '');
  return {
    key: key, d: d, semantic: semantic, recorded: !!d.recorded,
    c: P.c, word: P.word, label: P.label, pill: P.pill, negative: P.negative,
    why: why,
    /* the sentence for a title or a screen reader */
    said: d.moved ? (d.moved.returned ? 'Nothing of its own — ' : 'Moved to ' + d.moved.to + ' — ') + why : P.label + (d.recorded ? ' — ' + why : ' — nothing recorded yet, which is not a record of absence'),
    /* the one-line form for an email, a text message or a printed list. An unknown says what it is and stops —
       there is nothing after "No delivery record" that would be true. */
    line: d.moved ? (d.moved.returned ? 'No delivery record (its copy went back to ' + d.moved.to + ')' : 'Moved to ' + d.moved.to) : P.label + (d.recorded ? ' — ' + why : ''),
    /* the short form for a dense row: the label alone, never the colour word for an unknown */
    short: d.moved ? (d.moved.returned ? 'No record here' : 'Moved to ' + d.moved.to) : P.label,
    moved: d.moved || null,
    done: !!d.done, eta: d.eta || null,
  };
}
/* Tick or un-tick Complete. Carries a name, like a light. Ticking something that is not yet green also sets the
   light to on site — a thing cannot be set up and checked without being on the ground — and says so. */
/* a record can only be made against a reference the page knows — a stray attribute or a typo never creates one */
function isRef(key){ return !!key && (allAssets().some(a => a.key === key) || !!givenRefOf(key)); }
/* a task id that has been given a reference names the same asset — an old link, the move that carries the
   record across — so it resolves to the reference it was given */
function resolveRef(key){ const g = givenRefOf(key); return g ? g.ref : key; }
/* a short buzz when a light or a tick is set from a phone — a hand in a glove, in generator noise, knows the press took
   without looking up. Browsers only honour it inside a tap, so a programmatic call does nothing; iPhones have no vibrate */
function buzz(ms){ try { if (navigator.vibrate) navigator.vibrate(ms || 30); } catch (e) {} }
/* HOW MUCH OF A RECORD'S OWN HISTORY IS KEPT.

   V12 audit D08: both setters and the merge cut every light and tick history to the last TWELVE events, and
   that silently destroys evidence rather than trimming a display. The audit's fixture shows it plainly: 14
   September replays as recorded on site, somebody makes a thirteenth change days later, and the same question
   about 14 September now answers "unrecorded" — nothing about that day changed, the observation that proved it
   was simply pushed off the end. On a job that has to stand up afterwards, that is the wrong thing to throw
   away first.

   Not removed altogether, though: this array lives in a shared record on a volume, and an unbounded per-asset
   list is how a record quietly becomes unusable. 400 events at roughly 75 bytes is about 30 kB for one history;
   a reference whose light changed twice a day every day from first delivery to the end of demob would use
   about ninety. The cap is therefore around thirty times the worst honest case, which means it protects against
   a runaway loop and nothing else. A display still shows its newest six. The figure is written at each of the
   five sites rather than held in a constant, because the audit's harness lifts these functions out of the page
   and runs them alone, where a module-level name is not in scope and a literal cannot be.

   What was already lost before this change cannot be recovered from the current record, and this does not
   pretend otherwise. Backend retention is a separate question and is still unverified. */
function setDone(key, on){
  if (!mayWrite('the complete tick')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const now = new Date().toISOString();
  d.done = !!on; d.done_by = who; d.done_at = now;
  d.done_history = (d.done_history || []).concat([{done: !!on, at: now, by: who}]).slice(-400);
  /* an un-tick of complete takes BOTH checks that sit on top of it — levelled and steps are gates AFTER
     complete, and neither can stand on something no longer called finished */
  const came = [];
  if (!on && deliveryOf(key).steps) {
    d.steps = false; d.steps_by = who; d.steps_at = now;
    d.steps_history = (d.steps_history || []).concat([{steps: false, at: now, by: who, because: 'complete un-ticked'}]).slice(-400);
    came.push('steps installed');
  }
  if (!on && deliveryOf(key).levelled) {
    d.levelled = false; d.levelled_by = who; d.levelled_at = now;
    d.levelled_history = (d.levelled_history || []).concat([{levelled: false, at: now, by: who, because: 'complete un-ticked'}]).slice(-400);
    came.push('positioned and levelled');
  }
  let alsoGreen = false;
  if (on && deliveryOf(key).state !== 'on site') {
    d.state = 'on site'; d.set_at = now; d.by = who;
    d.history = (d.history || []).concat([{state: 'on site', at: now, by: who}]).slice(-400);
    alsoGreen = true;
  }
  bump(); buzz(on ? 40 : 20);
  flash(on ? key + ' ticked complete by ' + who + (alsoGreen ? ' — and set to green, on site, because complete means it is on the ground.' : '.')
           : key + ' un-ticked by ' + who + ' — the light is left as it was'
                 + (came.length ? ', and ' + came.join(' and ') + ' came off with it, on the record.' : '.'));
  return true;
}
/* Which references the second tick is FOR: things that get moved around and have to be levelled — portable
   buildings, toilets, toilet blocks, and the sewage and waste tanks that sit with them. A generator or a light
   tower is complete when it is complete; it is never levelled, and it never shows the control. */
/* v5.81 — THE LABOUR RULE. Andrew Fisher, 24 Sep 2026: labour is used only on the descriptions that mention it —
   each type kept as mentioned (install, levelling, stairs), where the description is mentioned or similar; if it
   is not as per the reference, it is not added. So install, levelling,
   stairs and labour lines exist on a reference only where the reference's OWN words — the schedule row's item,
   notes and activity, the accessories as written, and the rental contract's line descriptions — say so, or near
   enough (install/installation/installed; level/levelling; stair/stairs/step/steps; labour/labor). Nothing is
   offered as a tick to be added by hand, and a card line the words do not name is not added. */
/* v5.81 — THE LABOUR RULE. Andrew Fisher, 24 Sep 2026, with management's read of the drawers: labour is used only on
   the descriptions that mention it — each type kept as mentioned (install, levelling, stairs), where the description is
   mentioned or similar; if it is not as per the reference, it is not added.
   The reference is the rate card: a labour type (install, steps, levelling, cleaning, fire extinguisher,
   demob) is on an item only where the card's line for that item — the same description, or the similar line the
   card matching settled on — carries a figure for it. A column the card leaves at nought, writes "Included" in, or
   does not have for that block is not mentioned, and it is not added. This reverses v5.55's "offer every line in
   case": the six-tick rows that management read as over-stating are gone. */
function labourOffered(a, kind){
  return chargeLines(a).some(l => labourLinesFor(a.key, l.discipline, l.item, a.key, undefined, a).lines.some(L => L.key === kind));
}
function mentionsSteps(a){ return labourOffered(a, 'steps'); }
function needsLevel(a){
  const x = (a && a.key) ? a : assetOf(a); if (!x) return false;
  return x.discipline === 'Portable buildings' || x.discipline === 'Toilets & amenities';
}
function setLevelled(key, on){
  if (!mayWrite('the positioned-and-levelled tick')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  if (!needsLevel(key)) { flash(key + ' is not a building, toilet or tank — positioned and levelled does not apply.'); return false; }
  const who = whoAmI(); if (!who) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const now = new Date().toISOString();
  d.levelled = !!on; d.levelled_by = who; d.levelled_at = now;
  d.levelled_history = (d.levelled_history || []).concat([{levelled: !!on, at: now, by: who}]).slice(-400);
  /* levelled is the LAST gate: it cannot be true of something that is not complete and on the ground, so
     ticking it ticks complete (and green) too, the way complete ticks green */
  let also = [];
  if (on && !deliveryOf(key).done) {
    d.done = true; d.done_by = who; d.done_at = now;
    d.done_history = (d.done_history || []).concat([{done: true, at: now, by: who}]).slice(-400);
    also.push('complete');
  }
  if (on && deliveryOf(key).state !== 'on site') {
    d.state = 'on site'; d.set_at = now; d.by = who;
    d.history = (d.history || []).concat([{state: 'on site', at: now, by: who}]).slice(-400);
    also.push('green, on site');
  }
  bump(); buzz(on ? 50 : 20);
  flash(on ? key + ' positioned and levelled — closed off by ' + who + (also.length ? ' — and set to ' + also.join(' and ') + ', because levelled means it is there and finished.' : '.')
           : key + ' un-ticked positioned and levelled by ' + who + ' — complete and the light are left as they were.');
  return true;
}
/* THE THIRD TICK: STEPS INSTALLED. Andrew Fisher, 16 Sep 2026: like levelling, the steps install is a tick of its
   own, separate from the others.

   It is its own record, with its own name and its own time, and it is NOT chained to levelling. A building can
   have its steps on before the final level check, or the other way about, and two crews can do the two jobs —
   so neither tick waits on the other and neither one implies the other. What steps DOES share with levelling is
   the floor under it: steps on something that is not there and not finished is not a thing that happened, so
   ticking it puts the reference on site and complete exactly as levelling does, and un-ticking complete or
   setting the light red takes it off again with the reason written down.

   It applies to the same references levelling applies to — buildings, toilets and tanks — which Andrew Fisher
   chose on 16 Sep 2026: one row, three ticks, and the ones that take no steps simply never get the third. */
function setSteps(key, on){
  if (!mayWrite('the steps-installed tick')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  if (!needsLevel(key)) { flash(key + ' is not a building, toilet or tank — steps installed does not apply.'); return false; }
  const who = whoAmI(); if (!who) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const now = new Date().toISOString();
  d.steps = !!on; d.steps_by = who; d.steps_at = now;
  d.steps_history = (d.steps_history || []).concat([{steps: !!on, at: now, by: who}]).slice(-400);
  let also = [];
  if (on && !deliveryOf(key).done) {
    d.done = true; d.done_by = who; d.done_at = now;
    d.done_history = (d.done_history || []).concat([{done: true, at: now, by: who}]).slice(-400);
    also.push('complete');
  }
  if (on && deliveryOf(key).state !== 'on site') {
    d.state = 'on site'; d.set_at = now; d.by = who;
    d.history = (d.history || []).concat([{state: 'on site', at: now, by: who}]).slice(-400);
    also.push('green, on site');
  }
  bump(); buzz(on ? 50 : 20);
  flash(on ? key + ' steps installed — recorded by ' + who + (also.length ? ' — and set to ' + also.join(' and ') + ', because steps go on something that is there and finished.' : '.')
           : key + ' un-ticked steps installed by ' + who + ' — complete, levelled and the light are left as they were.');
  return true;
}
/* An empty delivery record is dropped so "nothing recorded" stays true. A tick, or an un-tick, is a record. */
/* A record that holds nothing but the note that a reschedule was taken off is NOT empty — that note is the
   evidence, and dropping it is what let an older copy put the reschedule back (TR-07's fault in a second coat). */
function deliveryEmpty(d){ return !d.state && !d.eta && !d.note && !d.date && !d.out_date && typeof d.done !== 'boolean'
  && typeof d.levelled !== 'boolean' && typeof d.steps !== 'boolean' && !d.date_off_at && !d.out_off_at; }
/* The tick as a chip, only when it is set — the absence of a tick is not a status. */
function doneChip(a){
  const d = deliveryOf(a.key || a);
  if (!d.done) return '';
  const title = `Complete — ticked ${fmtStamp(d.done_at)} by ${d.done_by || 'unnamed'}${d.done_where === 'local' ? ` (${LW()})` : ' (committed)'}`;
  return `<span class="tick" title="${esc(title)}" aria-label="${esc(title)}">✓ Complete</span>`;
}
/* THE CANCEL BUTTON AND THE NEXT-DAY BUTTON. Andrew Fisher, 15 Sep 2026: beside the tick for complete, one for
   Cancelled and one that moves a delivery to the next day — and whatever is done, everything updates.
   Neither is a new kind of record. Cancel writes the same row/<key>
   tombstone the committed cancellations and the schedule-row removals use, so the ring-and-bar, the folded day
   list, the register count, the map pin and the drop sheets all read the one state; Next day is the existing
   reschedule (setDate) with the date already worked out, so the plan date stays beside the new one as "moved
   from", exactly as if it had been typed. One state, every surface — the buttons only make it one tap. */
function cancelBtn(key, small){
  const a = assetOf(key); if (!a) return '';
  if (a._cancelled) return `<button type="button" class="tickbtn nobtn on${small ? ' sm' : ''}" data-restorek="${esc(key)}" aria-pressed="true"
    title="Cancelled — ${esc(rowOffWords(key))}. Press to put it back on its day." aria-label="Put ${esc(key)} back on its day">${noGlyph(small ? 14 : 18)}</button>`;
  return `<button type="button" class="tickbtn nobtn${small ? ' sm' : ''}" data-cancelk="${esc(key)}" aria-pressed="false"
    title="Cancel — not coming; off every day, list, count and drop sheet, with your name and the reason" aria-label="Cancel ${esc(key)}">${noGlyph(small ? 14 : 18)}</button>`;
}
function nextDayOf(key){
  const a = assetOf(key); if (!a) return null;
  const from = effectiveDates(a).in || a.first_date; if (!from) return null;
  const d = new Date(from + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + 1);
  return d.toISOString().slice(0, 10);
}
function nextDayBtn(key, small){
  const a = assetOf(key); if (!a || a._cancelled) return '';
  const to = nextDayOf(key); if (!to) return '';
  return `<button type="button" class="tickbtn daybtn${small ? ' sm' : ''}" data-nextday="${esc(key)}"
    title="Move to the next day — due in ${esc(fmtDate(to))}; the plan date is kept beside it as moved from, with your name" aria-label="Move ${esc(key)} to ${esc(fmtDate(to))}">›</button>`;
}
/* the second tick's chip, only when it is set */
function levelChip(a){
  const d = deliveryOf(a.key || a);
  if (!d.levelled) return '';
  const title = `Positioned and levelled — closed off ${fmtStamp(d.levelled_at)} by ${d.levelled_by || 'unnamed'}${d.levelled_where === 'local' ? ` (${LW()})` : ' (committed)'}`;
  return `<span class="tick lvl" title="${esc(title)}" aria-label="${esc(title)}">${levelGlyph(12)} Levelled</span>`;
}
/* THE LEVEL MARK: a spirit level — a bar with the bubble centred — so the two ticks never read as one. Drawn as
   a shape in the current colour, so it prints. */
function levelGlyph(size){
  const n = size || 14;
  return `<svg class="lvlgo" width="${n}" height="${n}" viewBox="0 0 20 20" aria-hidden="true" focusable="false">`
       + `<rect x="1.5" y="6.5" width="17" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>`
       + `<circle cx="10" cy="10" r="1.9" fill="currentColor"/><line x1="7" y1="8" x2="7" y2="12" stroke="currentColor" stroke-width="1.4"/><line x1="13" y1="8" x2="13" y2="12" stroke="currentColor" stroke-width="1.4"/></svg>`;
}
/* the second tick's toggle — only on the references it applies to */
function levelBtn(key, small){
  if (!needsLevel(key)) return '';
  const d = deliveryOf(key);
  return `<button type="button" class="tickbtn lvlbtn${small ? ' sm' : ''}${d.levelled ? ' on' : ''}" data-levelled="${esc(key)}" aria-pressed="${d.levelled}"
    title="${d.levelled ? 'Un-tick positioned and levelled' : 'Tick positioned and levelled — the final check that closes the asset off (buildings, toilets and tanks)'}" aria-label="${d.levelled ? 'Un-tick positioned and levelled for ' : 'Tick positioned and levelled for '}${esc(key)}">${levelGlyph(small ? 15 : 19)}</button>`;
}
/* the third tick's chip, only when it is set */
function stepsChip(a){
  const d = deliveryOf(a.key || a);
  if (!d.steps) return '';
  const title = `Steps installed — recorded ${fmtStamp(d.steps_at)} by ${d.steps_by || 'unnamed'}${d.steps_where === 'local' ? ` (${LW()})` : ' (committed)'}`;
  return `<span class="tick stp" title="${esc(title)}" aria-label="${esc(title)}">${stepsGlyph(12)} Steps</span>`;
}
/* THE STEPS MARK: a flight of three treads climbing to the right. It has to be told apart from the tick and from
   the spirit level at a glance on a phone in the sun, so it is a shape and not a colour, and it prints. */
function stepsGlyph(size){
  const n = size || 14;
  return `<svg class="stpgo" width="${n}" height="${n}" viewBox="0 0 20 20" aria-hidden="true" focusable="false">`
       + `<path d="M2 17 H7 V12.5 H12 V8 H17 V3.5" fill="none" stroke="currentColor" stroke-width="2"`
       + ` stroke-linecap="round" stroke-linejoin="round"/></svg>`;
}
/* the third tick's toggle — the same references levelling applies to, chosen by Andrew Fisher on 16 Sep 2026 */
function stepsBtn(key, small){
  if (!needsLevel(key)) return '';
  const d = deliveryOf(key);
  return `<button type="button" class="tickbtn stpbtn${small ? ' sm' : ''}${d.steps ? ' on' : ''}" data-steps="${esc(key)}" aria-pressed="${d.steps}"
    title="${d.steps ? 'Un-tick steps installed' : 'Tick steps installed — its own check, separate from levelled (buildings, toilets and tanks)'}" aria-label="${d.steps ? 'Un-tick steps installed for ' : 'Tick steps installed for '}${esc(key)}">${stepsGlyph(small ? 15 : 19)}</button>`;
}
/* The tick toggle, wired by delegation like the lights. */
function doneBtn(key, small){
  const d = deliveryOf(key);
  return `<button type="button" class="tickbtn${small ? ' sm' : ''}${d.done ? ' on' : ''}" data-done="${esc(key)}" aria-pressed="${d.done}"
    title="${d.done ? 'Un-tick complete' : 'Tick complete — in position, set up, checked'}" aria-label="${d.done ? 'Un-tick complete for ' : 'Tick complete for '}${esc(key)}">✓</button>`;
}
/* Every asset number known against a reference, once: the schedule's, what a person recorded as supplied
   (committed or in this browser), and the machines on the rental extract. Andrew Fisher, 14 Sep 2026: the timeline
   names the asset number — so a row that has none says so, in words, not with a blank. */
/* v5.58 — A NUMBER SOMEBODY TOOK OFF STAYS OFF, WHICHEVER DOOR IT COMES BACK THROUGH.
   The 19 Sep 2026 audit, P37: Andrew Fisher took 1105035 off on 17 Sep and the drawer said so — "Taken off —
   still on schedule, not counted here" — and then, three panels down, the labour section counted "2 buildings"
   and priced both: $707.88 where the one building still on the reference is $353.94. allAssets() had removed
   the number correctly; this function then folded the committed, supplied and rental lists back in without
   asking whether any of those numbers had been taken off, so the retired one walked back in through the side
   door and became a billable building again.

   Every number, from every source, now passes the same removal check the register applies. What was taken
   off is off — for the photographs, the pins, the labour ticks and the clash check alike. */
function assetNumbersOf(a){
  const key = a.key || a, com = CROW.get(key) || {}, rent = rentalOf(key);
  const rentNums = rent ? rent.lines.filter(r => !isMiscRow(r)).map(r => r.asset_no).filter(Boolean) : [];
  return [...new Set([].concat(a.asset_numbers || [], com.asset_numbers_supplied || [],
                               localSupplied(key).asset_numbers || [], rentNums).map(n => String(n).trim()).filter(Boolean))]
    .filter(n => !tombedHere('num/' + key + '/' + n));
}
/* ONE MACHINE CANNOT BE TWO BUILDINGS. Andrew Fisher, 16 Sep 2026, reported 1097343 turning up at P18; the
   register already carried it against P27. Neither side is wrong — P27 was cancelled and the machine went
   somewhere else — but until somebody says which reference it belongs to, two drop sheets carry the same
   number and one of them sends a driver to the wrong place.

   So the page works it out from what it already reads: the schedule's numbers, the ones recorded on site, the
   ones typed here and the rental system's, per reference, with the ones taken off already gone. It NEVER picks
   a winner — it names both and says where each claim came from, because the page has no way to know which
   person was right and a person does. A cancelled reference still counts: a number stuck on a cancelled row is
   exactly the case that produced this. */
/* v5.59 — the numbers INSIDE a reference count too: a fridge or an air conditioner recorded inside two buildings
   is the same contradiction as a building on two references (air conditioner 1295810 was inside both P18 and
   P19 on the live record of 19 Sep 2026). Read off the one projection — the folded contents, plus the units that
   are not contents but carry a number — never off the raw lists, so a thing listed once is claimed once. */
function contentsNumbersOf(a){
  const x = (a && a.key) ? a : assetOf(a); if (!x) return [];
  const nos = (x.accessories || []).map(y => String(y.asset_no || '').trim()).filter(Boolean)
    .concat((Array.isArray(x._unitsNotContents) ? x._unitsNotContents : unitsOf(x.key)).map(u => String(u.asset_no || '').trim()).filter(Boolean));
  return [...new Set(nos)].filter(n => !/^MISCITEM$/i.test(n));
}
function numberClaims(){
  const by = new Map();
  allAssets().forEach(a => assetNumbersOf(a).concat(contentsNumbersOf(a)).forEach(n => {
    if (!by.has(n)) by.set(n, []);
    by.get(n).push(a.key);
  }));
  const out = new Map();
  by.forEach((keys, n) => { const u = [...new Set(keys)]; if (u.length > 1) out.set(n, u.sort()); });
  return out;
}
/* v5.73 — A NUMBER IS A GUIDE UNTIL IT IS DELIVERED. Andrew Fisher, 22 Sep 2026: an asset number is not locked in
   until it has been delivered and marked as delivered; anything short of that is a guide only.

   The check above was built from one real case (1097343, 16 Sep) and then applied to every coincidence. So a
   plan carrying the same number against two references — which is ordinary while the plan is still a plan —
   came out as a red alert on Today and as CHECK THE PLATE on the driver's card. That is paperwork shouting
   about a contradiction that does not exist yet, and it teaches people to ignore the warning that matters.

   Each claim is now graded by whether it is LOCKED: the reference's light says on site AND that number was
   recorded on site against it — supplied, or recorded inside it by the crew. A number off the schedule, typed
   here, or from the rental system is a guide, however many references carry it.

     two or more locked   a real contradiction. One machine cannot be two. Loud, and on the paperwork.
     exactly one locked   settled. The delivered one is the record; the others are stale plan lines. Said on
                          the guide side only — the delivered reference is correct and its driver is told
                          nothing, because there is nothing for that driver to check.
     none locked          plan only. A guide. Says nothing, anywhere.

   It still never picks a winner where two are locked: that remains a person's call, as it always was. */
function claimLocked(n, key){
  if (deliveryOf(key).state !== 'on site') return false;     /* not delivered — a guide, whatever it says */
  const said = String(n);
  if (((CROW.get(key) || {}).asset_numbers_supplied || []).map(String).includes(said)) return true;
  if ((localSupplied(key).asset_numbers || []).map(String).includes(said)) return true;
  const a = assetOf(key);                                    /* a thing recorded inside a delivered reference */
  return !!a && contentsNumbersOf(a).includes(said);
}
function claimGrades(){
  const out = new Map();
  numberClaims().forEach((keys, n) => {
    const locked = keys.filter(k => claimLocked(n, k));
    out.set(n, {keys, locked, guide: keys.filter(k => !claimLocked(n, k)),
      grade: locked.length > 1 ? 'contradiction' : locked.length === 1 ? 'settled' : 'plan'});
  });
  return out;
}
/* the numbers worth saying something about on THIS reference, already graded */
function claimsFor(nums, key){
  const grades = claimGrades();
  return nums.filter(n => { const g = grades.get(n); if (!g) return false;
    if (g.grade === 'contradiction') return true;
    return g.grade === 'settled' && !g.locked.includes(key);   /* a delivered reference is never warned */
  }).map(n => Object.assign({n}, grades.get(n)));
}
function claimWhere(n, key){
  const a = assetOf(key); if (!a) return '';
  const said = [];
  if ((a._numbersOnTheSchedule || []).includes(n)) said.push('the schedule');
  if (((CROW.get(key) || {}).asset_numbers_supplied || []).map(String).includes(n)) said.push('recorded on site');
  if ((localSupplied(key).asset_numbers || []).map(String).includes(n)) said.push('recorded here');
  if ((S.assetNumbers[key] || []).map(String).includes(n)) said.push('typed here');
  const rent = rentalOf(key);
  if (rent && rent.lines.some(r => String(r.asset_no || '') === n)) said.push('the rental system');
  const inside = (a.accessories || []).find(y => String(y.asset_no || '').trim() === n)
    || (Array.isArray(a._unitsNotContents) ? a._unitsNotContents : unitsOf(key)).find(u => String(u.asset_no || '').trim() === n);
  if (inside) said.push('inside it — ' + String(inside.type || inside.label || 'a thing recorded on site').toLowerCase());
  return said.join(', ') || 'unclear where from';
}
/* the notice under Contents and accessories: a thing inside this reference whose number is on another one */
function contentsClashLine(a){
  const got = claimsFor(contentsNumbersOf(a), a.key);
  if (!got.length) return '';
  const what = n => { const x = (a.accessories || []).find(y => String(y.asset_no || '').trim() === n)
    || (a._unitsNotContents || []).find(u => String(u.asset_no || '').trim() === n) || {}; return String(x.type || x.label || 'a thing'); };
  const hard = got.some(g => g.grade === 'contradiction'), one = got.length === 1;
  const head = hard
    ? `<b>${one ? 'A number inside ' : got.length + ' numbers inside '}${esc(a.key)} ${one ? 'is' : 'are'} on another reference too.</b>
       One machine cannot be in two buildings — take it off whichever it is not in.`
    : `<b>${one ? 'A number recorded inside here has' : got.length + ' numbers recorded inside here have'} been delivered against another reference.</b>
       The delivered reference is the record; take it off here.`;
  return `<div class="notice warn cclash" style="margin:8px 0">${head}
    ${got.map(g => `<div style="margin-top:4px"><b class="mono">${esc(g.n)}</b> <span class="w">${esc(what(g.n))}</span> — ${
      g.keys.map(k => (k === a.key ? '<b>' + esc(k) + '</b>' : '<button class="linkish" data-k="' + esc(k) + '">' + esc(k) + '</button>')
        + ' <span class="w" style="color:var(--mute)">(' + esc(claimWhere(g.n, k))
        + (g.locked.includes(k) ? ', delivered' : '')
        + ((assetOf(k) || {})._cancelled ? ', cancelled' : '') + ')</span>').join(' · ')}</div>`).join('')}</div>`;
}
/* THE WARNING RIDES WITH THE NUMBER. Outside audit, 17 Sep 2026 (B01): Today and the drawer flagged a number on
   two references, while the drop sheet, the prepared email, the load brief and the driver card printed the same
   number with nothing beside it — and those are the pieces of paper a driver actually holds. One sentence, in
   words, wherever the number goes: which other reference carries it, where that claim came from, and that the
   plate is to be checked. It still never picks a winner. */
function clashOf(a){
  const key = a.key || a, got = claimsFor(assetNumbersOf(a), key);
  if (!got.length) return null;
  const items = got.map(g => ({n: g.n, grade: g.grade,
    others: g.keys.filter(k => k !== key).map(k => ({key: k, where: claimWhere(g.n, k), locked: g.locked.includes(k),
      cancelled: !!((assetOf(k) || {})._cancelled)}))}));
  const hard = items.some(x => x.grade === 'contradiction');
  const o2s = o => o.key + ' (' + o.where + (o.locked ? ', delivered' : '') + (o.cancelled ? ', cancelled' : '') + ')';
  const gone = x => x.others.filter(o => o.locked).map(o => o.key);
  const say = x => x.grade === 'contradiction'
    ? x.n + ' is also on ' + x.others.map(o2s).join(' and ')
    : x.n + ' was delivered against ' + gone(x).join(' and ') + ', so this line is a guide only';
  return {nums: items.map(x => x.n), items, grade: hard ? 'contradiction' : 'settled',
    words: items.map(say).join('; ') + (hard
      ? ' — one machine cannot be two; check the plate before you drop.'
      : ' — the delivered reference is the record; take it off this one.'),
    short: items.map(x => x.grade === 'contradiction'
      ? x.n + ' also on ' + x.others.map(o => o.key + (o.cancelled ? ' (cancelled)' : '')).join(', ')
      : x.n + ' delivered against ' + gone(x).join(', ')).join('; ')};
}
function clashLine(a){
  const got = claimsFor(assetNumbersOf(a), a.key);
  if (!got.length) return '';
  const hard = got.some(g => g.grade === 'contradiction'), one = got.length === 1;
  const head = hard
    ? `<b>${one ? 'An asset number on ' : got.length + ' asset numbers on '}${esc(a.key)} ${one ? 'is' : 'are'} on another reference too.</b>
       One machine cannot be two of them — take it off whichever is wrong, on the reference it does not belong to.`
    : `<b>${one ? 'A number on this line has' : got.length + ' numbers on this line have'} already been delivered elsewhere.</b>
       The delivered reference is the record; this is a plan line that has been overtaken. Take it off here.`;
  return `<div class="notice warn" style="margin:8px 0">${head}
    ${got.map(g => `<div style="margin-top:4px"><b class="mono">${esc(g.n)}</b> — ${
      g.keys.map(k => (k === a.key ? '<b>' + esc(k) + '</b>' : '<button class="linkish" data-k="' + esc(k) + '">' + esc(k) + '</button>')
        + ' <span class="w" style="color:var(--mute)">(' + esc(claimWhere(g.n, k))
        + (g.locked.includes(k) ? ', delivered' : '')
        + ((assetOf(k) || {})._cancelled ? ', cancelled' : '') + ')</span>').join(' · ')}</div>`).join('')}</div>`;
}
function assetNosLine(a){
  const nums = assetNumbersOf(a);
  if (!nums.length) return `<span class="ano none" title="no asset number recorded against ${esc(a.key)} — the schedule, the supplied record and the rental extract carry none">no asset no.</span>`;
  return `<small>asset no.</small> ${nums.map(n => assetNo(n, {bare: true})).join(' ')}`;
}
/* The light cell every table shares: ONE instrument, which is also the control, then the tick. */
/* THE CANCELLED MARK. Andrew Fisher, 15 Sep 2026, sent a prohibition sign — a red ring with a bar through it —
   and asked for something like it. So this is that ring and bar, drawn as a shape
   in the current text colour so it survives greyscale paper and a reader who cannot tell red from grey, and it
   never goes anywhere without the word "cancelled" beside it or in its accessible name. The colour is a hint;
   the shape and the word are the meaning. */
function noGlyph(size){
  const n = size || 14;
  return `<svg class="nogo" width="${n}" height="${n}" viewBox="0 0 20 20" aria-hidden="true" focusable="false">`
       + `<circle cx="10" cy="10" r="7.6" fill="none" stroke="currentColor" stroke-width="2.8"/>`
       + `<line x1="5" y1="5" x2="15" y2="15" stroke="currentColor" stroke-width="2.8" stroke-linecap="butt"/></svg>`;
}
function lightCell(a, small){
  /* A CANCELLED REFERENCE IS NOT WAITING ON A RECORD. The lamps are how a person records an arrival; offering
     them beside "nothing recorded yet" on something that has been called off reads as work still to do, which
     is the one thing it is not. The cell says what it is instead, in the words of whoever cancelled it, and
     the row stays on the register with everything else about it intact. */
  if (a && a._cancelled) return `<div class="lcell"><span class="nomark" role="img" aria-label="cancelled">${noGlyph(18)}<b>cancelled</b></span>
    <span class="w" style="font-size:11.5px;color:var(--mute)">${esc(rowOffWords(a.key))}</span>${cancelBtn(a.key, small !== false)}</div>`;
  return `<div class="lcell">${dstat(a, {size: 'sm', ctl: true})}${doneChip(a)}${levelChip(a)}${stepsChip(a)}${doneBtn(a.key, small !== false)}${levelBtn(a.key, small !== false)}${stepsBtn(a.key, small !== false)}${nextDayBtn(a.key, small !== false)}${cancelBtn(a.key, small !== false)}</div>`;
}
/* The row wash: complete beats on site beats in transit. Nothing is hidden by a wash — it is a hint, not a filter. */
function rowClass(a){
  if (a && a._cancelled) return 'complete';
  const d = deliveryOf(a.key || a);
  return d.levelled ? ('complete levelled' + (d.steps ? ' stepped' : '')) : d.done ? ('complete' + (d.steps ? ' stepped' : ''))
       : d.recorded ? (d.c === 'green' ? 'done' : d.c === 'amber' ? 'moving' : '') : '';
}
/* The dates an asset actually moves on: the site reschedule if there is one, else the plan. Both are kept. */
function effectiveDates(a){
  const d = deliveryOf(a.key);
  const outPlan = (a.events || []).filter(e => e.movement === 'remove' && e.date).map(e => e.date).sort()[0] || (a._added ? a.last_date : null) || null;
  const inPlan = a.first_date || null;
  /* v5.54 — A DAY CORRECTED OUT LOUD AT THE SOURCE READS LIKE A RESCHEDULE. Andrew Fisher, 19 Sep 2026: the schedule
     had a delivery on the King's Birthday, Mon 5 Oct, when nobody works, so it moves to the next day. The
     correction lives in sources/2026_Schedule/corrections.json and is applied at the build, so the row's day IS
     the corrected day on every page and print; the workbook's day rides beside it as the plan, with his name and
     the day he said it. A reschedule recorded on the page still wins, the way it beats the plan. */
  const corr = !d.date ? dateCorrectionOf(a) : null;
  if (corr) return {in: inPlan, in_plan: corr.as_written || inPlan, in_moved: true, in_by: corr.stated_by, in_at: corr.recorded_at || corr.stated_on,
                    in_where: 'schedule correction', in_correction: corr,
                    out: d.out_date || outPlan, out_plan: outPlan, out_moved: !!(d.out_date && d.out_date !== outPlan), out_by: d.out_by, out_at: d.out_at};
  return {in: d.date || inPlan, in_plan: inPlan, in_moved: !!(d.date && d.date !== inPlan), in_by: d.date_by, in_at: d.date_at, in_where: d.date_where,
          out: d.out_date || outPlan, out_plan: outPlan, out_moved: !!(d.out_date && d.out_date !== outPlan), out_by: d.out_by, out_at: d.out_at};
}
/* the source correction on the day an asset arrives, if the schedule row that brings it carries one */
function dateCorrectionOf(a){
  const e = (a && a.events || []).find(e => e.date_correction && e.movement !== 'remove');
  return e ? e.date_correction : null;
}
/* everything the schedule had on a day that now reads on another day, by a correction at the source */
function movedOffDay(iso){
  const out = [];
  allAssets().forEach(a => (a.events || []).forEach(e => {
    if (e.date_correction && e.date_as_written === iso && !out.some(x => x.key === a.key)) out.push({key: a.key, what: (a.item_types || []).join(', ') || a.product || e.item || '', to: e.date, corr: e.date_correction});
  }));
  (DATA.unreferenced || []).forEach(r => {
    if (r.date_correction && r.date_as_written === iso && !out.some(x => x.key === r.task_id)) out.push({key: r.task_id, what: r.item || r.product || '', to: r.date, corr: r.date_correction});
  });
  return out;
}
function movedOffLine(m){
  const c = m.corr || {};
  return `<span class="chip act" title="${esc('stated ' + fmtDate(c.stated_on || ''))}">moved to ${esc(fmtDay(m.to).dow + ' ' + fmtDay(m.to).dm)}</span> <b>${esc(m.key)}</b> ${esc(m.what)} — ${esc(fmtDate(c.stated_on || ''))}`;
}
/* Move an asset to another day. A reschedule carries a name, like a light. An empty date puts it back on the plan. */
function setDate(key, iso, which){
  if (!mayWrite('the date')) return false;
  const v = String(iso || '').trim();
  if (v && !/^\d{4}-\d{2}-\d{2}$/.test(v)) return false;
  if (!isRef(key)) return false;
  const who = v ? whoAmI() : (S.operator || 'unnamed'); if (!who) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const f = which === 'out' ? ['out_date', 'out_by', 'out_at'] : ['date', 'date_by', 'date_at'];
  const off = which === 'out' ? ['out_off_by', 'out_off_at'] : ['date_off_by', 'date_off_at'];
  const a = allAssets().find(x => x.key === key), plan = a ? (which === 'out' ? effectiveDates(a).out_plan : a.first_date) : null;
  /* Putting a day back on the plan is an event with a time on it. From an outside audit of 14 Sep 2026, TR-06:
     this used to delete the three fields and write nothing in their place, so the record afterwards was
     indistinguishable from one that had never been rescheduled at all. The merge rule is the later stamp wins —
     and a record with no stamp cannot win anything, so ANY copy that still carried the reschedule put it
     straight back, and the asset showed a day somebody had deliberately taken off. The reset now carries who
     did it and when, so it competes with the reschedule on the same footing and the later one stands. */
  if (!v || v === plan) {
    const had = d[f[0]] != null;
    delete d[f[0]]; delete d[f[1]]; delete d[f[2]];
    if (had) { d[off[0]] = who; d[off[1]] = new Date().toISOString(); }
  }
  else { d[f[0]] = v; d[f[1]] = who; d[f[2]] = new Date().toISOString(); delete d[off[0]]; delete d[off[1]]; }
  if (deliveryEmpty(d)) delete S.delivery[key];
  bump();
  if (v && v !== plan) flash(key + (which === 'out' ? ' now due out ' : ' now due in ') + fmtDate(v) + (plan ? ' — the plan said ' + fmtDate(plan) : '') + '.');
  else flash(key + ' is back on its plan date' + (plan ? ' — ' + fmtDate(plan) : '') + '.');
  return true;
}
/* ------------------------------------------------------------------ typed over the schedule
   Andrew Fisher, 16 Sep 2026: an edit page where people can edit or add — the date, the description, the map location
   and perhaps the day rate — because dates, descriptions and map locations change, and whatever is added or changed
   here updates everywhere else.

   The last sentence is the whole design. Neither of these setters owns a display: they write to the two stores
   the PROJECTION reads — S.descs and S.locations, folded into allAssets() — so a word typed on the edit table
   reaches the register, the drawer, the map's titles, the load brief, the advice email and every printed sheet
   at once, with nothing to keep in step and nothing that can drift.

   And the schedule's own wording is never rubbed out. It stays in the build, it is shown beside the typed
   version everywhere the change is shown, and clearing the box puts it straight back. */
function setDesc(key, text){
  if (!mayWrite('the description')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  const v = String(text == null ? '' : text).trim().slice(0, 160);
  const a = assetOf(key) || {};
  const asSched = String(a._nameOnTheSchedule == null ? (a.name || '') : a._nameOnTheSchedule).trim();
  S.descs = S.descs || {};
  const had = (S.descs[key] || '').trim();
  /* typing the schedule's own words back is the same act as clearing the box, and is recorded as clearing it */
  if (!v || v === asSched) { if (!had) return false; delete S.descs[key]; }
  else { if (v === had) return false; S.descs[key] = v; }
  stampIt('descs', key, who); bump();
  flash(!v || v === asSched
    ? key + ' is back to the schedule\'s own wording' + (asSched ? ' — ' + asSched : '') + '.'
    : key + ' now reads “' + v + '”' + (asSched ? ' — the schedule says “' + asSched + '”, and keeps saying it' : '') + '.');
  return true;
}
function setLocationText(key, text){
  if (!mayWrite('where it goes')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  const v = String(text == null ? '' : text).trim().slice(0, 120);
  const a = assetOf(key) || {};
  const asSched = String(((a._locationMoved && a._locationMoved.from)
    || (a.locations || []).find(l => l && l !== key) || '')).trim();
  S.locations = S.locations || {};
  const had = (S.locations[key] || '').trim();
  if (!v || v === asSched) { if (!had) return false; delete S.locations[key]; }
  else { if (v === had) return false; S.locations[key] = v; }
  stampIt('locations', key, who); bump();
  flash(!v || v === asSched
    ? key + ' goes where the schedule says' + (asSched ? ' — ' + asSched : ' — and the schedule says nothing about it') + '.'
    : key + ' now goes to “' + v + '”' + (asSched ? ' — the schedule said “' + asSched + '”, and still does' : '') + '.');
  return true;
}
/* The item TYPE, chosen from the list of every type the job knows (itemTypeOptions), so a typed one always
   lands on a rate line. Same rules as setDesc: written over the schedule's, never instead of it; the schedule's
   own type stays in the build and comes back when the box is cleared; a change carries a name. */
function setItemType(key, text){
  if (!mayWrite('the item type')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  const v = String(text == null ? '' : text).trim().slice(0, 80);
  const a = assetOf(key) || {};
  const asSched = String(a._itemOnTheSchedule || '').trim();
  S.items = S.items || {};
  const had = (S.items[key] || '').trim();
  if (!v || v === asSched) { if (!had) return false; delete S.items[key]; }
  else { if (v === had) return false; S.items[key] = v; }
  stampIt('items', key, who); bump();
  flash(!v || v === asSched
    ? key + ' is back to the schedule\'s own item type' + (asSched ? ' — ' + asSched : '') + '.'
    : key + ' is now a “' + v + '”' + (asSched ? ' — the schedule says “' + asSched + '”, and keeps saying it' : '') + '.');
  return true;
}
/* The QUANTITY the reference asks for — a whole number a named person has put over the schedule's cell. The
   schedule's own quantity (or its unreadable cell — P09's asset number, WC05's letter T) stays in the build and
   under the box. An empty box, or the schedule's own number typed back, is recorded as clearing it. A value
   that is not a whole number of one or more is refused and nothing is written: the record never holds a
   quantity that is not a count. */
function setQty(key, text){
  if (!mayWrite('the quantity')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  const raw = String(text == null ? '' : text).trim();
  const a = assetOf(key) || {};
  const asSched = a._qtyOnTheSchedule == null ? null : a._qtyOnTheSchedule;
  S.qtys = S.qtys || {};
  const had = S.qtys[key] == null ? null : S.qtys[key];
  if (raw !== '') {
    const n = safeInt(raw, MAX_QTY);
    if (n == null) { flash('A quantity is a whole number of things, 1 to ' + MAX_QTY + ' — “' + raw.slice(0, 20) + '” is not one, so nothing was recorded.'); return false; }
    if (n === asSched) { if (had == null) return false; delete S.qtys[key]; }
    else { if (n === had) return false; S.qtys[key] = n; }
  } else { if (had == null) return false; delete S.qtys[key]; }
  stampIt('qtys', key, who); bump();
  const now = S.qtys[key];
  flash(now == null
    ? key + ' is back to the schedule\'s own quantity' + (asSched != null ? ' — ' + asSched : ' — which it does not give') + '.'
    : key + ' now asks for ' + now + (asSched != null ? ' — the schedule says ' + asSched + ', and keeps saying it' : ' — the schedule gives no readable quantity') + '.');
  return true;
}
/* THE DAY THE HIRE IS CHARGED FROM. Andrew Fisher, 16 Sep 2026: a Start Hire date, for when the hire date is
   different — approved 17 Sep as the commercial clock, kept apart from due in (the day it
   lands). Typed by a named person, a real day, blank = unknown (never assumed to be the due-in day). The rental
   system's own start date, where its extract has one, is shown beside it and is not overwritten. Pricing counts
   the hire days from this day when it is set (assetWeeks). */
function setHireStart(key, iso){
  if (!mayWrite('the hire start')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  const v = String(iso || '').trim();
  if (v && !/^\d{4}-\d{2}-\d{2}$/.test(v)) { flash('A hire start is a day — nothing recorded.'); return false; }
  if (v) { const [y, m, d] = v.split('-').map(Number), t = new Date(y, m - 1, d); if (t.getFullYear() !== y || t.getMonth() !== m - 1 || t.getDate() !== d) { flash('That is not a real day — nothing recorded.'); return false; } }
  S.hireStart = S.hireStart || {};
  const had = S.hireStart[key] || '';
  if (!v) { if (!had) return false; delete S.hireStart[key]; }
  else { if (v === had) return false; S.hireStart[key] = v; }
  stampIt('hireStart', key, who); bump();
  flash(!v ? key + ' has no hire start recorded — the hire days go back to the schedule\'s span.'
           : key + ' is charged from ' + fmtDate(v) + ' — ' + who + '.');
  return true;
}
function hireStartOf(key){
  if (movedAway(key)) return null;
  const v = (S.hireStart || {})[key]; if (!v) return null;
  return {iso: v, by: stampBy('hireStart', key), at: (S.stamps || {})['hireStart/' + key] || null};
}
/* A MAP ATTACHED TO A REFERENCE. Andrew Fisher, 16 Sep 2026: an option to attach a map to a reference when there is
