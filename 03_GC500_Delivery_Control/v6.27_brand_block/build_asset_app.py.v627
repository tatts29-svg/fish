const MOVE_COLLS = ['delivery', 'supplied', 'assetNumbers', 'accessories', 'units', 'notes', 'branch', 'rental', 'weeks', 'hireStart', 'labour'];
function movedAway(key){ const m = (S.moves || {})[key]; return (m && m.to) ? m : null; }
/* what a reference carries that a move would overwrite — nothing here reads the schedule's own fields */
function recordOn(key){
  const has = [];
  const d = deliveryOf(key);
