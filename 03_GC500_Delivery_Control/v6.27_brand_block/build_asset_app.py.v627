   <div class="dh"><div><h2>${editing ? 'Rental ID ' + esc(editing.rental_id) : 'Add a rental contract'}</h2>
     <div class="sub">${editing ? (editing.recorded_by ? 'recorded ' + esc(fmtStamp(editing.recorded_on)) + ' by ' + esc(editing.recorded_by) : 'from the committed record') : 'typed from the rental contract screen — Rental ID, customer and site'}</div></div>
     <button class="close" id="cClose" aria-label="Close" title="Close">&times;</button></div>
   <div class="db"><div class="form">
    ${CONTRACT_FIELDS.reduce((h, [f, label, ph], i) => h + (i % 2 === 0 ? '<div class="row2">' : '') +
      `<div class="f"><label for="c_${f}">${esc(label)}</label><input id="c_${f}" value="${esc(seed[f] || '')}" placeholder="${esc(ph)}"${f === 'rental_id' && editing ? ' readonly' : ''}${['rental_id', 'contract_no', 'customer_code', 'contract_type'].includes(f) ? ' style="text-transform:uppercase"' : ''}></div>` +
      (i % 2 === 1 || i === CONTRACT_FIELDS.length - 1 ? '</div>' : ''), '')}
    <div class="f"><label for="c_note">Note</label><input id="c_note" value="${esc(seed.note || '')}" placeholder="anything the next person needs — billing contact, what the contract covers"></div>
    <div class="notice info"><b>What this is for</b>Every asset belongs to a Rental ID. Put the contract on an asset in its drawer, or on every asset the
      register lists at once from the Plant page. The details are typed, so check them against the rental screen — this page cannot read the rental system.</div>
   </div></div>
   <div class="df"><button class="btn primary" id="cSave">${editing ? 'Save' : 'Add contract'}</button>
     <button class="btn" id="cCancel">Cancel</button>${editing && (S.contracts || {})[editing.rental_id] ? '<button class="btn" id="cDel">Remove contract</button>' : ''}</div>`;
  mounted(document.body.appendChild(d));
  const shut = () => { d.remove(); bump(); };
  $('#cClose', d).onclick = shut; $('#cCancel', d).onclick = shut;
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  const del = $('#cDel', d);
  if (del) del.onclick = () => {
    const n = contractCount(editing.rental_id);
    if (!confirm('Remove Rental ID ' + editing.rental_id + ' from the record?' + (n ? ' ' + n + ' asset' + (n === 1 ? '' : 's') + ' will keep the Rental ID but lose its details.' : ''))) return;
    delete S.contracts[editing.rental_id]; tomb('contract/' + editing.rental_id); stampIt('contracts', editing.rental_id); save(); shut(); flash('Rental ID ' + editing.rental_id + ' removed.'); };
  $('#cSave', d).onclick = () => {
    const who = whoAmI(); if (!who) return;
    const raw = {}; CONTRACT_FIELDS.forEach(([f]) => raw[f] = $('#c_' + f, d).value); raw.note = $('#c_note', d).value;
    const c = normContract(raw), bad = checkContract(c);
    if (bad.length) { flash(bad[0] + '.'); $('#c_' + (bad[0].includes('Rental') ? 'rental_id' : bad[0].includes('customer code') ? 'customer_code' : bad[0].includes('contract number') ? 'contract_no' : 'rental_id'), d).focus(); return; }
    if (!editing && (S.contracts || {})[c.rental_id]) { flash('Rental ID ' + c.rental_id + ' is already on the record — open it from the list to change it.'); return; }
    const now = new Date().toISOString();
    S.contracts = S.contracts || {};
    S.contracts[c.rental_id] = Object.assign(c, {recorded_by: editing && editing.recorded_by || who, recorded_on: editing && editing.recorded_on || now, updated_at: now, updated_by: who});
    stampIt('contracts', c.rental_id); save(); d.remove();
    flash('Rental ID ' + c.rental_id + (editing ? ' updated.' : ' added.'));
    if (onDone) onDone(c.rental_id); else bump();
  };
  const first = $('#c_' + (editing ? 'customer_code' : 'rental_id'), d); if (first) first.focus();
}
/* the drawer's block: which contract this asset is on, and a way to change it */
function contractBlock(a){
  const c = contractOf(a.key), list = allContracts();
  const opts = ['<option value="">— no contract recorded —</option>']
    .concat(list.map(x => `<option value="${esc(x.rental_id)}"${c.id === x.rental_id ? ' selected' : ''}>${esc(x.rental_id)}${x.customer_code ? ' · ' + esc(x.customer_code) : ''}${x.customer_name ? ' · ' + esc(x.customer_name) : ''}</option>`))
    .concat(c.id && !list.some(x => x.rental_id === c.id) ? [`<option value="${esc(c.id)}" selected>${esc(c.id)} (${c.where === 'rental' ? 'rental system' : 'details not held'})</option>`] : [])
    .concat(['<option value="+new">＋ Add a contract…</option>']);
  return `<div class="sect">Rental contract</div>
    <div class="form" style="margin-bottom:12px">
      <p class="hint" style="margin:0 0 6px">${c.id ? contractLine(c.c, c.id) + (c.where === 'committed' ? ' <span class="chip ref" title="from the last committed record">committed</span>'
          : c.where === 'rental' ? ` <span class="chip ok" title="${esc('from the Coates rental contracts (Baseplan export' + (ONHIRE ? ', ' + ONHIRE.supplied_on : '') + ')' + (() => { const g = ONHIRE && ONHIRE.assignments ? ONHIRE.assignments[a.key] : null; return g && g.basis ? ' — ' + g.basis : ''; })() + '. Pick a Rental ID here to override it.')}">rental contract</span>${c.c && c.c.branch_code ? ' · branch ' + esc(c.c.branch_code) : ''}`
          : ` <span class="chip act" title="recorded in ${esc(LW())}">${esc(LW())}</span>`) : '<span title="Every asset belongs to one — pick it here, or put a contract on every listed asset from the Register.">No Rental ID recorded yet.</span>'}</p>
      <div class="row2"><div class="f"><label for="rentalSel">Belongs to Rental ID</label><select id="rentalSel">${opts.join('')}</select></div>
        <div style="align-self:end;display:flex;gap:6px">${c.id && list.some(x => x.rental_id === c.id) ? `<button class="btn" id="rentalEdit">Contract details</button>` : ''}</div></div>
      ${c.c && (c.c.po_no || c.c.customer_ref || c.c.note) ? `<p class="hint" style="margin:6px 0 0">${[c.c.po_no ? 'PO ' + esc(c.c.po_no) : '', c.c.customer_ref ? 'customer ref. ' + esc(c.c.customer_ref) : '', c.c.note ? esc(c.c.note) : ''].filter(Boolean).join(' · ')}</p>` : ''}
    </div>`;
}
/* the drawer's block: which branch this asset belongs to. Typed, not chosen from a list of branches the page
   holds — the page holds none. Codes already used in this record are offered back so one branch is not typed
   three ways, and the field says plainly when nobody has recorded one. */
function branchBlock(a){
  const b = branchOf(a.key), used = branchesUsed();
  return `<div class="sect">Branch</div>
    <div class="form" style="margin-bottom:12px">
      <p class="hint" style="margin:0 0 6px">${b.code
        ? (b.where === 'rental'
            ? `On branch <b class="mono">${esc(b.code)}</b> <span class="chip ok" title="${esc('the branch code on its rental contract' + (b.contracts && b.contracts.length ? ' ' + b.contracts.join(', ') : '') + ' — the Coates rental system has this line on hire under this branch. Type a different code here to override it.')}">rental system</span>`
            : `On branch <b class="mono">${esc(b.code)}</b>${b.at ? ' · recorded ' + esc(fmtStamp(b.at)) : ''} ${b.where === 'committed'
            ? '<span class="chip ref" title="from the last committed record">committed</span>'
            : `<span class="chip act" title="recorded in ${esc(LW())}">${esc(LW())}</span>`}`)
        : '<span title="Type the branch code it belongs to — nothing here guesses one from the depot the trucks leave.">No branch recorded yet.</span>'}
        ${!b.code && branchGuideWords(a.discipline) ? `<br><span class="w">${branchGuideWords(a.discipline)}</span>` : ''}</p>
      <div class="row2">
        <div class="f"><label for="branch-${esc(a.key)}">Branch code</label>
          <input id="branch-${esc(a.key)}" data-branch="${esc(a.key)}" list="branchcodes-drawer" maxlength="${BRANCH_MAX}"
            value="${esc(b.code || '')}" placeholder="the branch this asset is on hire from" title="${esc((used.length ? 'already used here: ' + used.slice(0, 6).map(x => x.code + ' (' + x.count + ')').join(' · ') + '. ' : '') + (branchGuideWords(a.discipline) ? branchGuideWords(a.discipline).replace(/<[^>]+>/g, '') : ''))}"></div>
        <div style="align-self:end"><button class="btn" id="branchAll" title="put this branch code on every asset the register lists right now">Put on the listed</button></div>
      </div>
      <datalist id="branchcodes-drawer">${branchOptions()}</datalist>
      ${onhireBlock(onhireForAsset(a), {take: a.key})}
    </div>`;
}
function wireBranch(a){
  const box = $('#branch-' + CSS.escape(a.key)) || $('#drawer').querySelector('[data-branch]');
  if (box) box.onchange = () => { if (setBranch([a.key], box.value)) bump(); else box.value = branchOf(a.key).code || ''; };
  const all = $('#branchAll');
  if (all) all.onclick = () => {
    const code = normBranch((box && box.value) || branchOf(a.key).code || '');
    const keys = (state.list || []).filter(isRef);
    if (!code) { flash('Type a branch code first — then it can go on the listed assets.'); return; }
    if (!keys.length) { flash('Nothing is listed to put a branch on — open the Plant page first.'); return; }
    if (setBranch(keys, code)) bump();
  };
}
function wireContract(a){
  const sel = $('#rentalSel'); if (!sel) return;
  sel.onchange = () => {
    if (sel.value === '+new') { contractDialog(null, id => { setRental([a.key], id, true); bump(); flash('Rental ID ' + id + ' added and put on ' + a.key + '.'); }); return; }
    if (setRental([a.key], sel.value || null)) bump(); else sel.value = contractOf(a.key).id || '';
  };
  const ed = $('#rentalEdit'); if (ed) ed.onclick = () => contractDialog(contractOf(a.key).id);
}
/* the register's card: the branch codes on this record, how many assets carry each, and the box that puts one on
   every asset the register is listing right now — the way 168 assets get a branch without typing it 168 times. */
/* A BRANCH GOES ON WORK THAT IS STILL ON. A cancelled reference stays on the register — nothing is deleted — but
   it is out of every money rollup, so putting a code on it would offer a number the branch plate then contradicts.
   The card works on the listed lines that are still live, says when it has left cancelled ones out, and the count
   on the button is exactly what the press does. */
function liveKeys(list){ return (list || []).filter(k => isRef(k) && !(assetOf(k) || {})._cancelled); }
function branchCard(listedAll){
  const listed = liveKeys(listedAll);
  const skipped = (listedAll || []).length - listed.length;
  const used = branchesUsed();
  const none = allAssets().filter(a => !a._cancelled && !branchOf(a.key).code).length;
  return `<div class="card foldphone" style="margin-bottom:14px">
  <div class="hubtitle" style="margin-bottom:6px"><h3>Branch <span class="chip ref">${used.length}</span></h3>
    <span class="w" style="font-size:12px;color:var(--mute)">${none ? `<b>${none}</b> asset${none === 1 ? '' : 's'} with no branch recorded` : 'every asset carries a branch code'}</span></div>
  <p class="hint" style="margin:0 0 8px">Every asset belongs to a Coates branch — the branch that gets the revenue. Nothing supplied carries the code, so it is typed here:
    filter the register to a group or a search, type the code and press <i>Put on the listed</i>, or set one asset at a time in its drawer.
    Blank means nobody has recorded one — it is never assumed from the depot the trucks leave from.${
    skipped ? ` <span class="nomark">${noGlyph(11)}</span> <b>${skipped} cancelled reference${skipped === 1 ? '' : 's'} listed here ${skipped === 1 ? 'is' : 'are'} left out</b> — a branch carries revenue, and a reference that has been called off is out of the money.` : ''}</p>
  ${(() => { /* the guide: what Andrew Fisher said each branch usually supplies, offered for the group listed — a person presses it */
      const discs = [...new Set(listed.map(k => (allAssets().find(a => a.key === k) || {}).discipline).filter(Boolean))];
      const g = discs.length === 1 ? branchGuide(discs[0]) : [];
      const open = listed.filter(k => !branchOf(k).code).length;
      if (!g.length) return `<p class="hint" style="margin:0 0 8px"><b>The guide.</b> ${(BRANCHES.branches || []).map(b => `<strong class="mono">${esc(b.code)}</strong> ${esc(b.name)} — ${esc(b.usually)}`).join(' · ')} <span class="w">(Andrew Fisher, 12 Sep 2026)</span></p>`;
      return `<div class="notice info"><b>The guide for ${esc(discs[0])}</b>${branchGuideWords(discs[0])} ${open ? `<strong>${open}</strong> of the ${listed.length} listed ${open === 1 ? 'has' : 'have'} no branch yet.` : 'Every listed line carries a branch.'}
        ${open ? `<div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">${g.map(b => `<button class="btn" data-branch-guide="${esc(b.code)}">Put ${esc(b.code)} on the ${open} with none</button>`).join('')}</div>` : ''}</div>`; })()}
  ${used.length ? `<div class="filters" style="margin-bottom:8px">${used.map(x =>
      `<button data-branch-find="${esc(x.code)}" title="list the assets on branch ${esc(x.code)}">${esc(x.code)} ${x.count}</button>`).join('')}${
      none ? `<button data-branch-find="no branch" title="list the assets with no branch recorded">no branch ${none}</button>` : ''}</div>` : ''}
  <div class="form"><div class="row2">
    <div class="f"><label for="branchBulk">Branch code</label>
      <input id="branchBulk" list="branchcodes-reg" maxlength="${BRANCH_MAX}" placeholder="e.g. the branch this hire sits against">
      <datalist id="branchcodes-reg">${branchOptions()}</datalist></div>
    <div style="align-self:end;display:flex;gap:6px">
      <button class="btn primary" id="branchPut" ${listed.length ? '' : 'disabled'}>Put on the ${listed.length} ${skipped ? 'still on' : 'listed'}</button>
      <button class="btn" id="branchClear" ${listed.length ? '' : 'disabled'} title="take the branch off every listed asset that is still on">Clear on the ${skipped ? 'still on' : 'listed'}</button></div>
  </div></div></div>`;
}
function wireBranchCard(pane, listedAll){
  const listed = liveKeys(listedAll);   // cancelled references are out of the money, so out of the branch too
  const box = $('#branchBulk', pane), put = $('#branchPut', pane), clr = $('#branchClear', pane);
  if (put) put.onclick = () => { const v = normBranch(box ? box.value : '');
    if (!v) { flash('Type the branch code first.'); if (box) box.focus(); return; }
    if (setBranch(listed, v)) bump(); };
  if (clr) clr.onclick = () => { if (setBranch(listed, '')) bump(); };
  /* the guide's offer: only the listed lines that carry no branch, and only when a named person presses it */
  pane.querySelectorAll('[data-branch-guide]').forEach(b => b.onclick = () => {
    const keys = listed.filter(k => !branchOf(k).code);
    if (!keys.length) { flash('Every listed line already carries a branch.'); return; }
    if (setBranch(keys, b.dataset.branchGuide)) bump(); });
  pane.querySelectorAll('[data-branch-find]').forEach(b => b.onclick = () => {
    state.q = b.dataset.branchFind === 'no branch' ? 'no branch' : 'branch ' + b.dataset.branchFind;
    const qb = $('#q'); if (qb) { qb.value = state.q; const qx = $('#qx'); if (qx) qx.hidden = false; }
    render(); });
}
/* the register's card: the rental system's on-hire lines, what they match, and where the two documents disagree.
   Every difference here is a real question for a person — a machine described two ways, a hire closing before the
   programme is finished with the plant — and none of them is resolved by the page. */
function onhireCard(){
  if (!ONHIRE) return '';
  const s = ONHIRE.summary, asg = ONHIRE.assignments || {};
  const row = r => { const m = r.match || {}, st = ONHIRE_STATE[m.state] || ONHIRE_STATE.unmatched; return `<tr>
    <td class="mono"><b>${esc(r.branch_code)}</b></td>
    <td class="mono">${esc(r.rental_contract)}${r.line ? `<br><span class="w" style="font-size:11px;color:var(--mute)">line ${esc(String(r.line))}</span>` : ''}</td>
    <td class="mono">${r.asset_no_is_plant_number ? `<button class="linkish" data-onhire-find="${esc(r.asset_no)}" title="find this asset number">${esc(r.asset_no)}</button>` : esc(r.asset_no || '—')}</td>
    <td>${esc(r.what || r.description)}${r.quantity && r.quantity !== 1 ? ` <span class="chip">× ${esc(String(r.quantity))}</span>` : ''}${r.location ? `<br><span class="w" style="font-size:11px;color:var(--mute)">${esc(r.location)}</span>` : ''}</td>
    <td style="white-space:nowrap">${r.start_date ? `<b>${esc(fmtDay(r.start_date).dm)}</b>` : r.delivery_number ? `<span class="w" style="color:var(--mute)">docket raised</span>` : `<span class="w" style="color:var(--mute)">from ${esc(fmtDay(r.contract_start || r.start_date).dm)}</span>`}<br><span class="w" style="font-size:11px;color:var(--mute)">off ${esc(fmtDay(r.demob_date).dm)}</span></td>
    <td class="mono">${esc(r.delivery_number || '—')}</td>
    <td><span class="chip ${st.chip}" title="${esc(m.basis || '')}">${esc(st.word)}</span>${
      m.task_id ? ` <span class="mono w" style="font-size:11px">${esc(m.task_id)}</span>` : m.key ? ` <button class="linkish" data-k="${esc(m.key)}"><b>${esc(m.key)}</b></button>` : ''}</td></tr>`; };
  const by = s.assigned_by || {};
  const byWords = Object.keys(by).map(k => `${by[k]} by ${k}`).join(', ');
  return `<div class="card contracts-lines" style="margin-bottom:14px">
  <div class="hubtitle" style="margin-bottom:6px"><h3>The rental contracts <span class="chip ref">${s.lines} lines</span></h3>
    <span class="w" style="font-size:12px;color:var(--mute)">${esc(ONHIRE.supplied_by)}, ${esc(ONHIRE.supplied_on)} · ${s.branches.join(', ')} · ${s.contracts.length} contract${s.contracts.length === 1 ? '' : 's'}</span></div>
  <p class="hint" style="margin:0 0 8px">${esc(ONHIRE.source)} Every asset a line names by number, or that is a kind of thing the contracts hold, carries its branch code and contract number from here${byWords ? ' (' + esc(byWords) + ')' : ''}. A line the contract has as delivered puts its machine on site on the docket's date; a light set on the ground overrides it.</p>
  <div class="kpis" style="margin-bottom:10px">
    ${kpi(s.same_asset_number, 'lines matched by asset number')}${kpi((s.same_delivery_docket || 0) + (s.same_day_and_kind || 0) + (s.settled_by_tonnage || 0), 'lines matched by docket or day')}
    ${kpi(s.assets_assigned || Object.keys(asg).length, 'assets given a branch and a contract')}${kpi(s.delivered_lines || 0, 'lines the contracts have as delivered')}
  </div>
  <div class="tblwrap"><table><thead><tr><th>Branch</th><th>Contract</th><th>Asset no.</th><th>What</th><th>Delivered</th><th>Docket</th><th>Matched to</th></tr></thead>
    <tbody>${ONHIRE_ROWS.map(row).join('')}</tbody></table></div>
  <p class="norate">${esc(ONHIRE.authority)}</p>
  </div>`;
}
function wireOnhireCard(pane){
  pane.querySelectorAll('[data-onhire-find]').forEach(b => b.onclick = () => {
    state.q = b.dataset.onhireFind; const qb = $('#q');
    if (qb) { qb.value = state.q; const qx = $('#qx'); if (qx) qx.hidden = false; }
    render(); });
}
/* the register's card: every contract, how many assets sit on it, and the button that puts it on the listed assets */
function contractsCard(listed){
  const list = allContracts();
  const rows = list.filter(x => { const qq0 = String(state.q || '').trim().toLowerCase(); return !qq0 || [x.rental_id, x.contract_no, x.contract_type, x.customer_code, x.customer_name, x.site].join(' ').toLowerCase().indexOf(qq0) >= 0; })
    .map(x => { const n = contractCount(x.rental_id); return `<tr>
    <td><b class="mono">${esc(x.rental_id)}</b>${x.contract_no && x.contract_no !== x.rental_id ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">contract ${esc(x.contract_no)}</span>` : ''}</td>
    <td>${esc(x.contract_type || '—')}</td><td class="mono">${esc(x.customer_code || '—')}</td><td>${esc(x.customer_name || '—')}</td><td>${esc(x.site || '—')}</td>
    <td class="num">${n ? `<button class="btn tiny cnt" data-contract-find="${esc(x.rental_id)}" title="list the assets on this contract"><b>${n}</b></button>` : '<span class="todo">0</span>'}</td>
    <td style="white-space:nowrap"><button class="btn tiny" data-contract-edit="${esc(x.rental_id)}">Details</button>
      <button class="btn tiny primary" data-contract-assign="${esc(x.rental_id)}" ${listed.length ? '' : 'disabled'} title="put this Rental ID on every asset the register lists right now">Put on the ${listed.length} listed</button></td></tr>`; }).join('');
  const none = allAssets().filter(a => !contractOf(a.key).id).length;
  /* the rental system's own contracts, read from the extract and never edited here — one row each, with the
     lines the extract puts on it and how many of them the register matched */
  /* a search on the register narrows this card too — a person looking for P01 is not looking for a contract
     list, and a contract row is only listed when the search names it */
  const qq = String(state.q || '').trim().toLowerCase();
  const hit = txt => !qq || String(txt || '').toLowerCase().indexOf(qq) >= 0;
  const rentRows = (ONHIRE && ONHIRE.contracts || []).filter(rc => !list.some(x => String(x.rental_id) === String(rc.rental_contract)))
    .filter(rc => hit([rc.rental_contract, rc.branch_code, (rc.locations || []).join(' '), 'rental system'].join(' '))).map(rc => {
    const n = allAssets().filter(a => { const c = contractOf(a.key); return c.where === 'rental' && (c.ids || []).includes(String(rc.rental_contract)); }).length;
    return `<tr><td><b class="mono">${esc(rc.rental_contract)}</b><br><span class="chip ok" title="from the Coates rental contracts (Baseplan export${ONHIRE ? ', ' + esc(ONHIRE.supplied_on) : ''}) — read, not typed">rental contract</span></td>
    <td>—</td><td class="mono">—</td><td>—</td><td>${esc((rc.locations || []).join(', ') || '—')}</td>
    <td class="num">${n ? `<button class="btn tiny cnt" data-contract-find="${esc(rc.rental_contract)}" title="list the assets the rental system has on this contract"><b>${n}</b></button>` : '<span class="todo">0</span>'}</td>
    <td style="white-space:nowrap"><span class="w" style="font-size:11.5px;color:var(--mute)">branch ${esc(rc.branch_code || '—')} · ${esc(String(rc.lines || 0))} line${rc.lines === 1 ? '' : 's'} on the contract</span></td></tr>`; }).join('');
  const rentN = (ONHIRE && ONHIRE.contracts || []).length;
  return `<div class="card foldphone" style="margin-bottom:14px">
  <div class="hubtitle" style="margin-bottom:6px"><h3>Rental contracts <span class="chip ref">${list.length + rentN}</span></h3>
    <span class="w" style="font-size:12px;color:var(--mute)">${none ? `<b>${none}</b> asset${none === 1 ? '' : 's'} with no Rental ID yet` : 'every asset is on a contract'}</span></div>
  <p class="hint" style="margin:0 0 8px">Every asset belongs to a Rental ID in the rental system. Add the contract once — Rental ID, contract type, customer code and name, site — then
    put it on the assets: filter the register (a discipline, a search, a light) and press <i>Put on the listed</i>, or pick it in an asset's drawer. Typed from the rental screen; check it there.</p>
  ${(rows || rentRows) ? `<div class="tblwrap"><table><thead><tr><th>Rental ID</th><th>Type</th><th>Customer code</th><th>Customer</th><th>Site</th><th class="num">Assets</th><th></th></tr></thead><tbody>${rows}${rentRows}</tbody></table></div>`
    : (list.length || rentN) ? `<p class="norate">No contract matches “${esc(String(state.q || '').trim())}” — clear the search to see all ${list.length + rentN}.</p>` : '<p class="norate">No contract on the record yet.</p>'}
  <div style="margin-top:8px"><button class="btn" id="contractAdd">＋ Add a contract</button></div>
  </div>`;
}
function wireContractsCard(pane, listed){
  const add = $('#contractAdd', pane); if (add) add.onclick = () => contractDialog(null);
  pane.querySelectorAll('[data-contract-edit]').forEach(b => b.onclick = () => contractDialog(b.dataset.contractEdit));
  pane.querySelectorAll('[data-contract-find]').forEach(b => b.onclick = () => { state.q = b.dataset.contractFind; const qb = $('#q'); if (qb) { qb.value = state.q; const qx = $('#qx'); if (qx) qx.hidden = false; } render(); });
  pane.querySelectorAll('[data-contract-assign]').forEach(b => b.onclick = () => {
    const id = b.dataset.contractAssign, keys = listed.slice();
    const already = keys.filter(k => contractOf(k).id && contractOf(k).id !== id).length;
    if (!confirm(`Put Rental ID ${id} on the ${keys.length} asset${keys.length === 1 ? '' : 's'} the register lists?` + (already ? ` ${already} of them ${already === 1 ? 'is' : 'are'} on a different Rental ID and will be moved.` : ''))) return;
    if (setRental(keys, id)) render();
  });
}
function breakdownDialog(seed, editId){
  const editing = editId ? (S.breakdowns || []).find(b => b.id === editId) : null;
  if (editing) seed = Object.assign({}, editing);
  seed = seed || {};
  const areas = fenceByArea(allDockets().filter(d => d.usable)).map(a => a.name);
  const sheets = (DATA.fence_sheets || []).map(x => x.sheet_id).concat(DATA.sheets.map(x => x.sheet_id).filter(Boolean));
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', editing ? 'Update a breakdown' : 'Report a breakdown');
  d.innerHTML = `
   <div class="dh"><div><h2>${editing ? 'Update ' + esc(editing.id) : 'Report a breakdown'}</h2>
     <div class="sub">${editing ? 'raised ' + esc(fmtStamp(editing.at)) + ' by ' + esc(editing.by || 'unnamed') : 'saved in this browser until you export'}</div></div>
     <button class="close" id="bClose" aria-label="Close" title="Close">&times;</button></div>
   <div class="db"><div class="form">
    <div class="row2">
      <div class="f"><label for="bType">What kind</label><select id="bType">${BD_TYPES.map(t => `<option${(seed.type || 'breakdown') === t ? ' selected' : ''}>${t}</option>`).join('')}</select></div>
      <div class="f"><label for="bSev">How bad</label><select id="bSev">${BD_SEVERITY.map(t => `<option${(seed.severity || 'needs attention') === t ? ' selected' : ''}>${t}</option>`).join('')}</select></div>
    </div>
    <div class="row2">
      <div class="f"><label for="bRef">GC500 reference</label><input id="bRef" list="bRefs" value="${esc(seed.ref || '')}" placeholder="the asset — GN01, P09 …" autocomplete="off">
        <datalist id="bRefs">${allAssets().map(a => `<option value="${esc(a.key)}">${esc(a.key)} · ${esc(a.name || (a.item_types || []).join(', ') || '')}</option>`).join('')}</datalist></div>
      <div class="f"><label for="bArea">or a fencing area</label><input id="bArea" list="bAreas" value="${esc(seed.area || '')}" placeholder="as written on the dockets" autocomplete="off">
        <datalist id="bAreas">${areas.map(a => `<option value="${esc(a)}">`).join('')}</datalist></div>
    </div>
    <div class="f"><label for="bMap">Drawing / map sheet</label><select id="bMap"><option value="">— from the reference —</option>${sheets.map(x => `<option${seed.map_ref === x ? ' selected' : ''}>${esc(x)}</option>`).join('')}</select>
      <div class="hint">An asset already knows its sheet. For a fencing area, pick the sheet the area is on.</div></div>
    <div class="f"><label for="bWhat">What happened *</label><textarea id="bWhat" rows="3" placeholder="plain words — what is wrong, what you saw, what it is stopping">${esc(seed.what || '')}</textarea></div>
    <div class="row2">
      <div class="f"><label for="bOwner">Who is fixing it</label><input id="bOwner" value="${esc(seed.owner || '')}" placeholder="Coates service, ${esc((DATA.fence_contractor || {}).name || 'the fencing crew')}, iEDM, carrier …"></div>
      <div class="f"><label for="bDue">Fix by</label><input id="bDue" type="date" value="${esc(seed.due || '')}"></div>
    </div>
    <div class="f"><label for="bAction">What is being done</label><input id="bAction" value="${esc(seed.action || '')}" placeholder="e.g. service tech booked for 06:00, swap unit from the yard"></div>
    ${editing ? `
    <div class="row2">
      <div class="f"><label for="bStatus">Status</label><select id="bStatus">${BD_STATUS.map(t => `<option${(seed.status || 'open') === t ? ' selected' : ''}>${t}</option>`).join('')}</select></div>
      <div class="f"><label for="bRes">What fixed it</label><input id="bRes" value="${esc(seed.resolution || '')}" placeholder="filled in when it is fixed"></div>
    </div>` : ''}
    <div class="notice info"><b>Where it sends people</b>The record opens the asset, shows its marker on the map and prints the drop
      sheet with the aerial pictures, or points at the fencing area — so whoever goes to look goes to the right place.</div>
   </div></div>
   <div class="df"><button class="btn primary" id="bSave">${editing ? 'Save update' : 'Report it'}</button>
     <button class="btn" id="bCancel">Cancel</button>${editing ? '<button class="btn" id="bDel">Set aside</button>' : ''}</div>`;
  mounted(document.body.appendChild(d));
  const shut = () => { d.remove(); bump(); };
  $('#bClose', d).onclick = shut; $('#bCancel', d).onclick = shut;
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  const del = $('#bDel', d);
  if (del) del.onclick = () => { const who = whoAmI(); if (!who) return;
    if (!confirm('Set aside ' + editing.id + '? It is kept, with your name and the time, and can be put back from Tools → Edit.')) return;
    if (!setAside('breakdowns', editing.id, who)) return;
    save(); shut(); flash(editing.id + ' set aside by ' + who + ' — Put back is under Tools → Edit.'); };
  $('#bSave', d).onclick = () => {
    const who = whoAmI(); if (!who) return;
    const val = id => { const el = $('#' + id, d); return el ? (el.value || '').trim() : ''; };
    const ref = val('bRef').toUpperCase() || null, area = val('bArea') || null;
    if (!val('bWhat')) { flash('Say what happened — that is the record.'); $('#bWhat', d).focus(); return; }
    if (!ref && !area) { flash('Give it a reference or a fencing area, or nobody can be sent anywhere.'); $('#bRef', d).focus(); return; }
    if (ref && !allAssets().some(a => a.key === ref)) { flash(ref + ' is not a reference in this file.'); $('#bRef', d).focus(); return; }
    const now = new Date().toISOString();
    const b = {id: editing ? editing.id : nextBreakdownId(), at: editing ? editing.at : now, by: editing ? editing.by : who,
               type: val('bType'), severity: val('bSev'), ref, area, map_ref: val('bMap') || null, what: val('bWhat'),
               owner: val('bOwner') || null, due: val('bDue') || null, action: val('bAction') || null,
               status: editing ? val('bStatus') : 'open', resolution: editing ? (val('bRes') || null) : null,
               updated_at: now, updated_by: who,
               resolved_at: editing && (val('bStatus') === 'fixed' || val('bStatus') === 'closed') ? (editing.resolved_at || now) : null};
    S.breakdowns = editing ? (S.breakdowns || []).map(x => x.id === b.id ? b : x) : (S.breakdowns || []).concat([b]);
    save(); shut();
    flash(b.id + (editing ? ' updated' : ' reported') + ' in this browser. Export and rebuild to put it on the record.');
  };
  const first = $('#bWhat', d); if (first) first.focus();
}
function breakdownMailto(b){
  const a = b.ref ? allAssets().find(x => x.key === b.ref) : null;
  const link = a ? (a.drawing_links || [])[0] : null;
  const gate = heavyGate(), pt = a ? aerialPointFor(a) : null;
  const bg = (gate && pt) ? bearingBetween(gate.ax, gate.ay, pt.ax, pt.ay) : null;
  const lines = [
    `${DATA.brand.org} · ${DATA.event.name} · ${b.id}`,
    `${(b.type || '').toUpperCase()} — ${b.severity} — ${b.status}`,
    b.ref ? `Asset: ${b.ref}${a && a.name ? ' — ' + a.name : ''}${a ? ' · ' + ((a.item_types || []).join(', ') || a.product || '') : ''}${a && (a.asset_numbers || []).length ? ' · asset no. ' + a.asset_numbers.join(', ') : ''}` : null,
    b.area ? `Fencing area: ${b.area}` : null,
    `Where: ${link ? 'callout ' + link.label + ' on sheet ' + link.sheet + ' — a drawing position, not a survey' : b.map_ref ? 'sheet ' + b.map_ref : 'see the map'}`,
    gate && a ? `Get there: ${gate.text.replace(/ · /g, ' — ')}${bg ? '; from the gate head ' + bg.compass : ''}. ${(DATA.driver_rules || {}).escort || ''}` : null,
    '',
    `What happened: ${b.what}`,
    b.owner ? `Who is fixing it: ${b.owner}` : 'Who is fixing it: not yet assigned',
    b.action ? `What is being done: ${b.action}` : null,
    b.due ? `Fix by: ${fmtDate(b.due)}` : null,
    b.resolution ? `What fixed it: ${b.resolution}` : null,
    `Raised ${fmtStamp(b.at)} by ${b.by || 'unnamed'}${b.updated_at && b.updated_at !== b.at ? ' · updated ' + fmtStamp(b.updated_at) + ' by ' + (b.updated_by || 'unnamed') : ''}`,
    '',
    `Sent from GC500_Delivery_Control.html · open it at #breakdowns${b.ref ? ' or #asset/' + b.ref : ''} · dataset ${(DATA.register_sha256 || '').slice(0, 12)}`,
  ];
  return mailto(`GC500 · ${b.id} ${b.type} — ${b.ref || b.area || ''} (${b.severity})`, capLines(lines));
}
function bdWhere(b){
  const a = b.ref ? allAssets().find(x => x.key === b.ref) : null;
  const parts = [];
  if (b.ref) parts.push(`<button class="linkish" data-open="${esc(b.ref)}"><b>${esc(b.ref)}</b></button>${a && a.name ? ' <span class="w" style="color:var(--mute)">' + esc(a.name) + '</span>' : ''}${a && mapSheetFor(a) ? `<br><button class="linkish" data-map="${esc(b.ref)}">on the map</button>` : ''}`);
  if (b.area) parts.push(`<button class="linkish" data-area="${esc(b.area)}">${esc(b.area)}</button> <span class="w" style="color:var(--mute)">fencing area</span>`);
  if (b.map_ref) parts.push(`<span class="mono">${esc(b.map_ref)}</span>${DATA.sheets.some(x => x.sheet_id === b.map_ref) ? ` <button class="linkish" data-fmap="${esc(DATA.sheets.find(x => x.sheet_id === b.map_ref).key)}">sheet</button>` : ''}`);
  return parts.join('<br>') || '<span class="chip crit">nowhere named</span>';
}
/* the chip a row wears when the asset has an open breakdown */
function bdBadge(key){
  const o = breakdownsFor(key).filter(b => b.open);
  if (!o.length) return '';
  const worst = o.some(b => b.severity === 'stops work');
  return `<br><span class="chip ${worst ? 'crit' : 'act'}" title="${esc(o.map(b => b.id + ': ' + b.what).join('; '))}">${worst ? 'breakdown — stops work' : 'breakdown open'}</span>`;
}
function breakdownCard(a){
  const mine = breakdownsFor(a.key), open = mine.filter(b => b.open);
  return `
  <div class="card${open.some(b => b.severity === 'stops work') ? ' alert' : ''}" style="margin:0 0 14px">
    <div class="hubtitle"><h3>Breakdowns${mine.length ? ` <span class="chip ${open.length ? 'crit' : 'ok'}">${open.length} open</span>` : ''}</h3>
      <button class="btn" id="bdReport">Report a breakdown</button></div>
    ${mine.length ? `<div style="margin-top:8px">${mine.slice(0, 5).map(b => `
      <div class="acc"><span><b>${esc(b.id)}</b> ${bdChip(b)} ${whereChip(b._where)}<br>
        <span class="w">${esc(b.what)}${b.owner ? ' · ' + esc(b.owner) : ''}${b.action ? ' · ' + esc(b.action) : ''}${b.resolution ? ' · fixed: ' + esc(b.resolution) : ''}</span></span>
        <span>${b._where === 'local' ? `<button class="btn ghost" data-bedit="${esc(b.id)}" style="padding:4px 8px;font-size:12px">Update</button>` : ''}</span></div>`).join('')}
      ${mine.length > 5 ? `<button class="linkish tabsoff" id="toBreakdowns">See all ${mine.length} on the register →</button>` : ''}</div>`
      : '<p class="norate">Nothing reported against this one.</p>'}
  </div>`;
}
/* ---------------------------------------------------------------- the Journal
   Two halves of one question. WHAT IS OWED sits on top, because an open action with a name and a date on it is
   the only thing on this page anybody can act on. WHAT HAPPENED sits under it, read back out of the record —
   not written here, not editable here, and therefore not arguable. */
function renderJournal(){
  const q = (state.q || '').trim();
  const kind = state.jKind || 'all';
  const rows = journal({q, kind, ref: state.jRef || null});
  const acts = actionsOf({state: state.aState || null});
  const allActs = (S.actions || []);
  const openN = allActs.filter(a => (a.state || 'open') === 'open' || a.state === 'doing').length;
  const lateN = allActs.filter(actionOverdue).length;
  const noOwner = allActs.filter(a => ((a.state || 'open') === 'open' || a.state === 'doing') && !String(a.owner || '').trim()).length;
  const noDue = allActs.filter(a => ((a.state || 'open') === 'open' || a.state === 'doing') && !a.due).length;
  const who = (S.operator || '').trim();
  const kinds = [['all', 'Everything']].concat(Object.entries(JOURNAL_KINDS).map(([k, v]) => [k, v.word]));
  const day = iso => { const d = String(iso).slice(0, 10); return d; };
  let lastDay = null;

  const actRow = a => {
    const st = a.state || 'open', S_ = ACTION_STATES[st] || ACTION_STATES.open;
    const late = actionOverdue(a);
    const done = st === 'done' || st === 'dropped';
    return `<tr class="${done ? 'done' : ''}${late ? ' late' : ''}" data-act="${esc(a.id)}">
      <td>${sem(late ? 'stop' : S_.tone, late ? 'Overdue' : S_.word,
        late ? 'due ' + fmtDate(a.due) + ' and not done' : '')}
        ${a.priority ? sem(a.priority === 'stop' ? 'stop' : a.priority === 'soon' ? 'gap' : 'none',
          ACTION_PRIORITY[a.priority] || a.priority) : ''}</td>
      <td><b>${esc(a.what || '')}</b>${a.why ? `<div class="w">${esc(a.why)}</div>` : ''}
        ${a.ref ? `<div class="w"><button class="linkish" data-ajump="${esc(a.ref)}">${esc(a.ref)}</button></div>` : ''}</td>
      <td>${a.owner ? esc(a.owner) : sem('gap', 'No owner')}</td>
      <td class="mono">${a.due ? esc(fmtDate(a.due)) : sem('gap', 'No date')}</td>
      <td class="w">${esc(a.by || 'unnamed')}<br>${esc(fmtStamp(a.at))}${
        a.done_at ? `<br>${esc(st === 'dropped' ? 'dropped' : 'done')} ${esc(fmtStamp(a.done_at))} by ${esc(a.done_by || 'unnamed')}` : ''}</td>
      <td class="acts">${done
        ? `<button class="btn ghost sm" data-areopen="${esc(a.id)}">Re-open</button>`
        : `<button class="btn sm" data-adoing="${esc(a.id)}"${st === 'doing' ? ' disabled' : ''}>Doing</button>
           <button class="btn primary sm" data-adone="${esc(a.id)}">Done</button>
           <button class="btn ghost sm" data-adrop="${esc(a.id)}">Drop</button>`}</td>
    </tr>`;
  };

  $('#pane-journal').innerHTML = paneHeadingHtml('journal') + `
  <div class="hubhead"><div><h2>Journal</h2>
    <div class="sub">What is owed, and everything that has happened on this job — read back out of the record,
      in the order it happened, with the name of whoever did it.</div></div>
    <div class="acts"><button class="btn" id="jPrint">Print the journal</button></div></div>

  ${semKey()}

  <div class="card">
    <div class="hubtitle"><h3>What is owed</h3>
      <span class="chip ${lateN ? 'crit' : openN ? 'cand' : 'ok'}">${openN} open${lateN ? ` · ${lateN} overdue` : ''}</span></div>
    ${(noOwner || noDue) ? `<p class="norate">${[noOwner ? noOwner + ' with nobody\'s name on' : null,
      noDue ? noDue + ' with no date' : null].filter(Boolean).join(' · ')} — an action nobody owns and nothing is
      due by is a wish, not an action.</p>` : ''}
    <div class="f" style="margin-top:10px">
      <label for="aWhat">Add an action</label>
      <input id="aWhat" type="text" maxlength="160" placeholder="What has to be done">
    </div>
    <div class="rs-grid four" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:8px">
      <div class="f"><label for="aWhy">Why / root cause</label><input id="aWhy" type="text" maxlength="200" placeholder="optional"></div>
      <div class="f"><label for="aRef">Against</label><input id="aRef" type="text" maxlength="20" list="jRefs" placeholder="P01, WC12 … optional"></div>
      <div class="f"><label for="aOwner">Owner</label><input id="aOwner" type="text" maxlength="60" placeholder="who is doing it"></div>
      <div class="f"><label for="aDue">Due</label><input id="aDue" type="date">
        <span class="datesay" id="aDueSay"></span></div>
      <div class="f"><label for="aPri">Priority</label><select id="aPri">
        <option value="">not set</option><option value="stop">Stops work</option>
        <option value="soon">Needed soon</option><option value="watch">Watch</option></select></div>
    </div>
    <datalist id="jRefs">${allAssets().slice(0, 400).map(a => `<option value="${esc(a.key)}">`).join('')}</datalist>
    <div style="margin-top:10px"><button class="btn primary" id="aAdd">Add it</button>
      <span class="hint">${who ? 'It will be recorded against ' + esc(who) + '.'
        : 'Put your name in “Recording as” first — an action with nobody\'s name on it is not recorded.'}</span></div>
    <div class="tblwrap" style="margin-top:14px">
      <table class="unreftbl"><thead><tr><th>State</th><th>What</th><th>Owner</th><th>Due</th><th>Raised</th><th></th></tr></thead>
      <tbody>${acts.length ? acts.map(actRow).join('')
        : `<tr><td colspan="6" class="w">Nothing is owed. ${allActs.length ? 'Everything raised has been closed out.' : 'Nothing has been raised yet.'}</td></tr>`}</tbody></table></div>
    <div class="jfilt" style="margin-top:8px">${[['', 'Open and doing'], ['all', 'All'], ['done', 'Done'], ['dropped', 'Dropped']]
      .map(([k, w]) => `<button class="btn sm${(state.aState || '') === k ? ' primary' : ' ghost'}" data-as="${k}">${w}</button>`).join('')}</div>
  </div>

  <div class="card" style="margin-top:16px">
    <div class="hubtitle"><h3>What happened</h3><span class="chip ref">${rows.length} entr${rows.length === 1 ? 'y' : 'ies'}</span></div>
    <p class="norate">Nothing on this list is written here. Every line is read back out of the record somebody
      else already wrote — the lights, the ticks, the breakdowns, the dockets, the stamps — so it cannot be
      edited into saying something that did not happen. ${state.jRef ? `Filtered to <b>${esc(state.jRef)}</b> —
      <button class="linkish" id="jClearRef">show everything</button>.` : ''}</p>
    <div class="jfilt">${kinds.map(([k, w]) =>
      `<button class="btn sm${kind === k ? ' primary' : ' ghost'}" data-jk="${k}">${esc(w)}</button>`).join('')}</div>
    <div class="tblwrap" style="margin-top:10px">
      <table class="unreftbl jtbl"><thead><tr><th>When</th><th>What</th><th>Against</th><th>Who</th></tr></thead>
      <tbody>${rows.length ? rows.slice(0, 400).map(r => {
        const K = JOURNAL_KINDS[r.kind] || {word: r.kind, tone: 'none'};
        const d = day(r.at); const head = d !== lastDay ? (lastDay = d, true) : false;
        return `${head ? `<tr class="jday"><td colspan="4">${esc(fmtDate(d))}</td></tr>` : ''}
          <tr><td class="mono">${r.dateOnly ? '<span class="w" title="the record holds the day, not the time">day only</span>' : esc(timeOfStamp(r.at) || '')}${r.lastOnly ? '<div class="w">last changed</div>' : ''}</td>
            <td>${sem(K.tone, K.word)} ${esc(r.what)}</td>
            <td>${r.ref ? `<button class="linkish" data-jref="${esc(r.ref)}">${esc(r.ref)}</button>` : '<span class="w">—</span>'}</td>
            <td class="w">${r.who ? esc(r.who) : sem('none', 'Not named')}${r.where === 'committed' ? ' <span class="chip ref" title="read from the committed record this page was built from (sources/ops/as_supplied.json)">committed</span>' : ''}</td></tr>`;
      }).join('') : `<tr><td colspan="4" class="w">Nothing recorded yet${kind !== 'all' ? ' of that kind' : ''}${q ? ' matching “' + esc(q) + '”' : ''}.</td></tr>`}</tbody></table></div>
    ${rows.length > 400 ? `<p class="norate">Showing the most recent 400 of ${rows.length}. Narrow it with the
      buttons above or the search box.</p>` : ''}
  </div>`;

  const pane = $('#pane-journal');
  pane.querySelectorAll('[data-jk]').forEach(b => b.onclick = () => { state.jKind = b.dataset.jk; renderJournal(); });
  pane.querySelectorAll('[data-as]').forEach(b => b.onclick = () => { state.aState = b.dataset.as; renderJournal(); });
  pane.querySelectorAll('[data-jref]').forEach(b => b.onclick = () => { state.jRef = b.dataset.jref; renderJournal(); });
  pane.querySelectorAll('[data-ajump]').forEach(b => b.onclick = () => openAsset(b.dataset.ajump));
  const cr = $('#jClearRef'); if (cr) cr.onclick = () => { state.jRef = null; renderJournal(); };
  const pr = $('#jPrint'); if (pr) pr.onclick = () => { try { markCards(); window.print(); } catch (e) {} };
  /* From the 14 Sep 2026 audit: a browser's own date field showed 09/14/2026 — the American way round — and a
     day that reads as the fourteenth of September to one person and the ninth of the fourteenth month to nobody
     is a day worth writing out. The browser draws the field; this writes the date beside it in the words the
     site uses, and it is the only place the chosen day is stated unambiguously. */
  const dueSay = () => { const el = $('#aDue'), say = $('#aDueSay'); if (!el || !say) return;
    say.textContent = el.value ? fmtDate(el.value) : ''; };
  const dueEl = $('#aDue'); if (dueEl) { dueEl.oninput = dueSay; dueSay(); }
  const add = $('#aAdd');
  if (add) add.onclick = () => {
    const what = $('#aWhat').value.trim();
    const by = (S.operator || '').trim();
    if (!by) { flash('Put your name in “Recording as” first — an action with nobody\'s name on it is not recorded.'); return; }
    if (!what) { flash('Say what has to be done.'); return; }
    const ref = $('#aRef').value.trim().toUpperCase();
    if (ref && !allAssets().some(a => a.key === ref)) { flash(ref + ' is not a reference in this file.'); return; }
    const at = new Date().toISOString();
    S.actions = S.actions || [];
    S.actions.push({id: 'A' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase(),
      at, updated_at: at, by, what, why: $('#aWhy').value.trim() || null, ref: ref || null,
      owner: $('#aOwner').value.trim() || null, due: $('#aDue').value || null,
      priority: $('#aPri').value || null, state: 'open'});
    bump(); flash('Action added.'); renderJournal();
  };
  const setState = (id, st) => {
    const a = (S.actions || []).find(x => x.id === id); if (!a) return;
    const by = (S.operator || '').trim();
    if (!by) { flash('Put your name in “Recording as” first.'); return; }
    a.state = st; a.updated_at = new Date().toISOString();
    if (st === 'done' || st === 'dropped') { a.done_at = a.updated_at; a.done_by = by; }
    else { a.done_at = null; a.done_by = null; }
    bump(); renderJournal();
  };
  pane.querySelectorAll('[data-adoing]').forEach(b => b.onclick = () => setState(b.dataset.adoing, 'doing'));
  pane.querySelectorAll('[data-adone]').forEach(b => b.onclick = () => setState(b.dataset.adone, 'done'));
  pane.querySelectorAll('[data-adrop]').forEach(b => b.onclick = () => setState(b.dataset.adrop, 'dropped'));
  pane.querySelectorAll('[data-areopen]').forEach(b => b.onclick = () => setState(b.dataset.areopen, 'open'));
}

function renderBreakdowns(){
  const q = state.q.trim().toLowerCase();
  const all = allBreakdowns();
  const hay = b => [b.id, b.type, b.severity, b.status, b.ref, b.area, b.map_ref, b.what, b.owner, b.action, b.resolution, b.by].filter(Boolean).join(' ').toLowerCase();
  const filt = state.bdFilter || 'open';
  const shown = all.filter(b => !q || q.split(/\s+/).filter(Boolean).every(t => hay(b).includes(t)))
                   .filter(b => filt === 'all' ? true : filt === 'open' ? b.open : filt === 'stop' ? (b.open && b.severity === 'stops work') : !b.open);
  const open = all.filter(b => b.open), stop = open.filter(b => b.severity === 'stops work');
  $('#pane-breakdowns').innerHTML = paneHeadingHtml('breakdowns') + `
  <div class="kpis">
    ${kpi(open.length, 'open', open.length > 0)}${kpi(stop.length, 'stopping work', stop.length > 0)}
    ${kpi(all.filter(b => b.status === 'being fixed').length, 'being fixed')}${kpi(all.filter(b => !b.open).length, 'fixed or closed')}
    ${kpi(all.filter(b => b._where === 'local').length, LW())}
  </div>
  <div class="notice info"><b>What goes here</b>
   Anything that did not go well: a unit that will not start, a building delivered damaged, a fence line knocked down,
   an access problem. Every entry is tied to a GC500 reference or a fencing area, so the person sent to look at it is
   sent to the right place — the record opens the asset, shows the marker, prints the drop sheet or points at the area.
   Update it as the fix moves along; close it with what fixed it.</div>
  <div class="card">
    <div class="hubtitle"><h3>Breakdowns <span class="chip ref">${all.length}</span></h3>
      <div class="daynav"><button class="btn primary" id="bdNew">Report a breakdown</button></div></div>
    <div class="filters" style="margin-top:10px">
      ${[['open', 'Open ' + open.length], ['stop', 'Stopping work ' + stop.length], ['done', 'Fixed or closed ' + (all.length - open.length)], ['all', 'All ' + all.length]]
        .map(([k, l]) => `<button data-bf="${k}" aria-pressed="${filt === k}">${esc(l)}</button>`).join('')}
    </div>
    <div class="tblwrap"><table><thead><tr><th>Ref</th><th>State</th><th>Where</th><th>What happened</th><th>Fix</th><th>Raised</th><th></th></tr></thead>
    <tbody>${shown.length ? shown.map(b => `<tr class="${b.open && b.severity === 'stops work' ? 'stop' : b.open ? 'moving' : 'done'}">
      <td><b>${esc(b.id)}</b><br><span class="chip">${esc(b.type)}</span><br>${whereChip(b._where)}${b.problems.length ? ' <span class="chip crit" title="' + esc(b.problems.join('; ')) + '">incomplete</span>' : ''}</td>
      <td>${bdChip(b)}</td>
      <td>${bdWhere(b)}</td>
      <td>${esc(b.what || '')}${b.resolution ? '<br><span class="w" style="font-size:12px;color:var(--green)"><b>Fixed:</b> ' + esc(b.resolution) + '</span>' : ''}</td>
      <td style="font-size:12.5px">${b.owner ? '<b>' + esc(b.owner) + '</b>' : '<span class="todo" title="nobody owns the fix yet">—</span>'}${b.action ? '<br>' + esc(b.action) : ''}${b.due ? '<br><span class="w" style="color:var(--mute)">by ' + esc(fmtDate(b.due)) + '</span>' : ''}</td>
      <td style="font-size:12px;white-space:nowrap">${esc(fmtStamp(b.at))}<br><span class="w" style="color:var(--mute)">${esc(b.by || 'unnamed')}</span>${b.updated_at && b.updated_at !== b.at ? '<br><span class="w" style="color:var(--mute)">updated ' + esc(fmtStamp(b.updated_at)) + '</span>' : ''}</td>
      <td><div class="acts">${b._where === 'local' ? `<button class="btn" data-bedit="${esc(b.id)}">Update</button>` : ''}
        <a class="btn" href="${breakdownMailto(b)}">Email</a>${b.ref ? `<button class="btn" data-drop="${esc(b.ref)}">Drop sheet</button>` : ''}</div></td>
    </tr>`).join('') : `<tr><td colspan="7" class="empty">${all.length ? 'Nothing matches.' : 'Nothing reported. Long may it last.'}</td></tr>`}</tbody></table></div>
  </div>`;
  const pane = $('#pane-breakdowns');
  $('#bdNew').onclick = () => breakdownDialog({});
  pane.querySelectorAll('[data-bf]').forEach(b => b.onclick = () => { state.bdFilter = b.dataset.bf; renderBreakdowns(); });
  pane.querySelectorAll('[data-bedit]').forEach(b => b.onclick = () => breakdownDialog(null, b.dataset.bedit));
  pane.querySelectorAll('[data-open]').forEach(b => b.onclick = () => openAsset(b.dataset.open));
  pane.querySelectorAll('[data-map]').forEach(b => b.onclick = () => showOnMap(b.dataset.map));
  pane.querySelectorAll('[data-fmap]').forEach(b => b.onclick = () => { state.sheet = b.dataset.fmap; state.sel = null; go('map'); });
  pane.querySelectorAll('[data-area]').forEach(b => b.onclick = () => { state.q = b.dataset.area; const qb = $('#q'); if (qb) { qb.value = state.q; $('#qx').hidden = false; } go('fencing'); });
  pane.querySelectorAll('[data-drop]').forEach(b => b.onclick = () => dropSheet(b.dataset.drop));
}

/* ------------------------------------------------------------------ costs by category
   The expectation, supplied by Andrew Fisher on 11 Sep 2026 (print/sources/cost_categories.json): every cost on the
   job is allocated and recorded against one of eight categories, in AUD ex GST, against a category and, where it
   helps, against the asset or the fencing area it was for.
   v5.79 — NOTHING IS TYPED ON THIS TAB, AND EVERY FIGURE IS WHAT COATES CHARGES. Andrew Fisher, 23 Sep 2026: costs
   fill in by themselves or from what he gives the build, not by hand; everything on the tab is what we are charging
   the V8s, and the breakdown by branch code is what each branch is charging the V8s.
   So the Record-a-cost drawer, the Change buttons and
   the Invoice button on a purchase order are gone, and a line is on the tab for one of three reasons, and says
   which: (1) THE RECORD — every usable fencing docket, priced whole at the 2026 card by the same costDocket() the
   Fencing tab uses, is one line under the fencing category (docketCostLines below; costs_from_record in
   pipeline/ops_layer.py does the same sum for ops_layer.json, and tests/test_costs.py holds the two to the cent).
   A docket recorded on this page fills in here the moment it is usable, and a rate typed on the Fencing tab
   reaches every line, because the lines are worked out live, never stored; (2) GIVEN — what Andrew gives the
   build in sources/costs/given.json, as he gave it, with the day; (3) an older record's own lines, carried through
   the export, the import and the merge exactly as before, so nothing anybody recorded before v5.79 is lost. The
   branch roll-up reads the fencing charge from the lines as STPS's subhire — once. What Coates pays the fencing
   contractor is on its purchase orders on the Fencing tab and is not on this tab. The ops layer grades a committed
   line by the same rules, so the page and the build agree. */
const COST_CATS = ((DATA.cost_categories || {}).categories || (DATA.ops || {}).cost_categories || []).slice();
const COST_SHORT = {'Internal labour hours and overtime': 'Internal labour', 'External contractor costs': 'Contractors', 'Rehire costs': 'Rehire',
  'Equipment costs (including generators and associated assets)': 'Equipment', 'Temporary fencing and crowd control': 'Fencing & crowd control',
  'Any installation-related costs': 'Installation', 'Buy invoicing branch costs': 'Buy invoicing branch', 'Any other event-related expenses': 'Other event'};
const costShort = c => COST_SHORT[c] || c || '—';
const COST_FENCE_CAT = COST_CATS.find(c => /fencing/i.test(c)) || null;
function gradeCost(c){
  const has = v => v != null && v !== '';
  const num = v => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && Number.isFinite(Number(v)) ? Number(v) : null;
  const amt = has(c.amount) ? num(c.amount) : null, hrs = has(c.hours) ? num(c.hours) : null, ot = has(c.overtime_hours) ? num(c.overtime_hours) : null;
  /* v5.81 — OUR OWN COSTS are the other side of the ledger (side 'ours'): graded by their own kind's rules (gradeOurs) */
  if (isOurs(c)) return gradeOurs(c);
  const problems = [
    !COST_CATS.includes(c.category) ? 'the category is not one of the eight' : null,
    !String(c.description || '').trim() ? 'nothing says what the cost is' : null,
    has(c.amount) && (amt == null || amt < 0) ? 'the amount is not a number' : null,
    has(c.hours) && (hrs == null || hrs < 0) ? 'the hours are not a number' : null,
    has(c.overtime_hours) && (ot == null || ot < 0) ? 'the overtime hours are not a number' : null,
    !has(c.amount) && !has(c.hours) && !has(c.overtime_hours) ? 'neither an amount nor hours — nothing to allocate' : null,
    !/^\d{4}-\d{2}-\d{2}$/.test(String(c.date || '')) || isNaN(new Date(String(c.date) + 'T00:00:00')) ? 'the date is not a day' : null,
    c.ref && !allAssets().some(a => a.key === c.ref) ? c.ref + ' is not a reference in this file' : null,
    !c.recorded_by ? 'nobody is named as recording it' : null].filter(Boolean);
  return Object.assign({}, c, {amount: amt != null && amt >= 0 ? amt : null, hours: hrs != null && hrs >= 0 ? hrs : null, overtime_hours: ot != null && ot >= 0 ? ot : null,
    usable: !problems.length, problems});
}
/* v5.79 — THE FENCING DOCKETS AS LINES ON THE COSTS TAB, worked out here, live. Andrew Fisher, 23 Sep 2026:
   everything on the tab is what we are charging the V8s — so the line is the docket's CHARGE at the
   2026 card, the same figure the Fencing tab shows, never a second basis. One line per usable docket whose every
   the card prices at all (cost_state 'priced' or 'partly priced' — so the category's total is the Fencing tab's
   charged figure to the cent; a column the card cannot price is named on the line): id C-FD-<docket no>, the docket's own words, its charge, the
   fencing category, subhire, on the fencing contractor's branch (STPS — what that branch charges the V8s for
   fencing). A docket with no day of its own (a row off the crew's workbook) is dated the last day of its week and
   says so. The same rule, line for line, as costs_from_record in pipeline/ops_layer.py — change one and you
   change the other. */
function docketCostLines(){
  if (!COST_FENCE_CAT) return [];
  const sup = PO_SRC.supplier || {};
  const name = sup.name || 'the fencing contractor';
  return allDockets().filter(d => d.usable && (d.cost_state === 'priced' || d.cost_state === 'partly priced') && (d.lines || []).length).map(d => {
    const no = d.docket_no || d.id;
    /* every usable docket the card prices at all, so the category's total IS the Fencing tab's charged figure; the columns the card cannot price are named, never guessed */
    let words = (d.lines || []).filter(l => l.cost != null).map(l => `${String(l.qty)} ${l.unit || ''} ${l.name}`.replace(/\s+/g, ' ').trim()).join(', ');
    const unpriced = (d.lines || []).filter(l => l.cost == null).map(l => l.name);
    if (unpriced.length) words += ' (' + unpriced.join(', ') + ' on the docket, not priced by the card)';
    let date = d.date || null, dated = '';
    if (!date && d.week) { const w = (DATA.weeks || []).find(x => x.sheet === d.week); if (w && w.end) { date = w.end; dated = ` (the workbook gives the week, ${d.week}, not the day — dated its last day)`; } }
    return {id: 'C-FD-' + String(no).replace(/\s+/g, ''), date, category: COST_FENCE_CAT,
            description: `${name} docket ${no} — ${words}, charged at the 2026 card`,
            amount: d.cost_total, hours: null, overtime_hours: null, supplier: name, reference: no != null ? String(no) : null, ref: null,
            area: d.location || d.map_ref || null,
            note: 'filled in from the fencing docket — what Coates charges the V8s for it, the same figure as the Fencing tab' + dated,
            recorded_by: 'the fencing dockets (from the record)', recorded_on: d.recorded_on || null, updated_at: null, updated_by: null,
            branch: normBranch(sup.branch_code || '') || null, kind: 'subhire', po_no: null, from: 'record', docket: d.id};
  });
}
/* where a line comes from, in words — for the table, the drawer and the email */
function costFromWords(c){
  return c.from === 'record' ? `the fencing docket ${c.docket || c.reference || ''}, charged at the 2026 card — nothing typed`.replace(/\s+,/, ',')
    : c.from === 'given' ? 'given to the build by Andrew Fisher (sources/costs/given.json)'
    : 'an older copy of the record, recorded on the page before v5.79';
}
function allCosts(){
  /* the record's own docket lines are worked out here (docketCostLines), so a committed copy of them is not read twice;
     our own costs (side 'ours') are the other ledger and never a charge — ourCosts() reads them */
  const com = ((COMMITTED.costs) || []).filter(c => c.from !== 'record' && !isOurs(c)).map(c => Object.assign(gradeCost(c), {_where: c.from === 'given' ? 'given' : 'committed'}));
  const rec = docketCostLines().map(c => Object.assign(gradeCost(c), {_where: 'record'}));
  const loc = (S.costs || []).filter(c => !isOurs(c)).map(c => Object.assign(gradeCost(c), {_where: 'local'}));
  return com.concat(rec, loc).sort((x, y) => String(y.date || '').localeCompare(String(x.date || '')) || String(y.updated_at || '').localeCompare(String(x.updated_at || '')) || String(x.id).localeCompare(String(y.id)));
}
function costsFor(key){ return allCosts().filter(c => c.ref === key); }
/* ------------------------------------------------------------------ OUR COSTS — what it costs Coates
   v5.81 — Andrew Fisher, 24 Sep 2026: transport is one of our own costs to track, with its branch code; he can give
   certain people access to add details as they get them, and everything updates — our costs tracked and
   summarised simply, because the business will be shown them. And on 25 Sep, re-sending his labour,
   accommodation, meals and expenses tracker: it is editable, and the race weekend is what we charge, not our
   costs.
   So our costs are a second ledger, kept apart from everything Coates charges, that a named person types into:
   transport (with the branch), the shifts, the nights away, the meals, the other expenses, and one line per
   person carrying their rate a night and the card role they are charged as over the race weekend. Every line
   rides in the record's cost list under side 'ours', so it exports, imports, merges by id and time, syncs through
   the existing costs collection (no server change) and reaches every copy — and is never read as a charge. The
   tracker's own lines are the starting point (pipeline/workforce_expenses.py, ids by person and day): a change
   made here replaces the tracker's line by its id, and a line taken off is a tombstone that travels. A line can be
   recorded before its figure is known — it is then awaiting its figure, listed, and out of every total until the
   amount is typed; never nought. Hours worked on the race days are what Coates CHARGES (priced at the card's
   hourly event rates by each person's role) and are kept off the cost side. */
const OUR_KINDS = [
  {key: 'transport', letter: 'T', label: 'Transport', category: 'Transport — our cost', money: true, fields: [
    {name: 'date', label: 'Day', type: 'date', req: true},
    {name: 'branch', label: 'Branch', type: 'branch'},
    {name: 'ref', label: 'Ref · load', type: 'ref', ph: 'P01, WC05, T0003…'},
    {name: 'carrier', label: 'Carrier', type: 'text', list: 'carrier', ph: 'who moved it'},
    {name: 'route_from', label: 'From', type: 'text', ph: 'Kingston'},
    {name: 'route_to', label: 'To', type: 'text', ph: 'site · pit lane'},
    {name: 'description', label: 'What moved', type: 'text', wide: true, ph: '6 m building, 2 × 40 ft loads…'},
    {name: 'amount', label: 'Cost ex GST', type: 'money', ph: 'leave empty until the invoice lands'},
    {name: 'reference', label: 'Docket · invoice', type: 'text', ph: 'docket or invoice no.'},
    {name: 'note', label: 'Note', type: 'text', wide: true, ph: 'anything the line should carry'}]},
  {key: 'labour', letter: 'L', label: 'Shift', category: 'Labour — hours', money: false, fields: [
    {name: 'person', label: 'Person', type: 'person', req: true},
    {name: 'date', label: 'Day', type: 'date', req: true},
    {name: 'start', label: 'Start', type: 'time'},
    {name: 'finish', label: 'Finish', type: 'time'},
    {name: 'break_min', label: 'Unpaid break (min)', type: 'number'},
    {name: 'hours', label: 'Hours', type: 'number', ph: 'from start and finish'},
    {name: 'note', label: 'Note', type: 'text', wide: true}]},
  {key: 'accommodation', letter: 'A', label: 'Night', category: 'Accommodation', money: true, fields: [
    {name: 'person', label: 'Person', type: 'person', req: true},
    {name: 'date', label: 'Night of', type: 'date', req: true},
    {name: 'amount', label: 'Rate this night ex GST', type: 'money', ph: "empty — the person's rate"},
    {name: 'hotel', label: 'Hotel', type: 'text', list: 'hotel'},
    {name: 'note', label: 'Note', type: 'text', wide: true}]},
  {key: 'meals', letter: 'M', label: 'Meals', category: 'Meals away from home', money: true, fields: [
    {name: 'person', label: 'Person', type: 'person', req: true},
    {name: 'date', label: 'Day', type: 'date', req: true},
    {name: 'amount', label: 'Amount ex GST', type: 'money', ph: 'leave empty until the receipt lands'},
    {name: 'note', label: 'Note', type: 'text', wide: true}]},
  {key: 'misc', letter: 'E', label: 'Expense', category: 'Misc and other expenses', money: true, fields: [
    {name: 'date', label: 'Day', type: 'date', req: true},
    {name: 'type', label: 'Type', type: 'text', list: 'type', ph: 'Equip R&M, Printing…'},
    {name: 'description', label: 'What', type: 'text', wide: true, req: true},
    {name: 'who', label: 'Who', type: 'text'},
    {name: 'supplier', label: 'Supplier', type: 'text', list: 'supplier'},
    {name: 'amount', label: 'Amount ex GST', type: 'money', ph: 'leave empty until the receipt lands'},
    {name: 'reference', label: 'Receipt · invoice', type: 'text'},
    {name: 'note', label: 'Note', type: 'text', wide: true}]},
  {key: 'person', letter: 'P', label: 'Person', category: 'Person — rate and role', money: false, fields: [
    {name: 'person', label: 'Name', type: 'text', req: true},
    {name: 'type', label: 'Type', type: 'select', options: ['Salary', 'Internal CNA', 'External']},
    {name: 'employer', label: 'Employer', type: 'text', list: 'employer'},
    {name: 'accommodation_rate', label: 'Rate a night ex GST', type: 'money'},
    {name: 'charged_as', label: 'Charged as on race weekend', type: 'role'},
    {name: 'note', label: 'Note', type: 'text', wide: true}]},
];
const OUR_KIND = Object.fromEntries(OUR_KINDS.map(k => [k.key, k]));
const OUR_COST_CATS = OUR_KINDS.map(k => k.category);
function eventRoles(){ return (RM && RM.event_team && RM.event_team.roles) || []; }
function isOurs(c){ return !!c && c.side === 'ours'; }
function ourSlug(s){ return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'unnamed'; }
/* the hours between a start and a finish, less an unpaid break — to the hundredth of an hour; past midnight counts */
function shiftHours(start, finish, brk){
  const t = v => { const m = /^(\d{1,2}):(\d{2})$/.exec(String(v == null ? '' : v).trim()); return m && Number(m[1]) < 24 && Number(m[2]) < 60 ? Number(m[1]) * 60 + Number(m[2]) : null; };
  const a = t(start), b = t(finish);
  if (a == null || b == null) return null;
  let mins = b - a; if (mins <= 0) mins += 24 * 60;
  const br = Number(brk); if (Number.isFinite(br) && br > 0) mins -= br;
  return mins > 0 ? Math.round(mins / 60 * 100) / 100 : null;
}
/* Andrew Fisher's rule for the hours of a day (24 Sep 2026): a standard day is 7.6 h; the next 2 h are x1.5 and the
   2 after that x2; Saturday is x1.5 for the first 2 h and x2 after; Sunday is x2 for every hour worked.
   The same split pipeline/workforce_expenses.py makes — hours only, never a dollar. */
function splitHours(h, iso){
  const wd = new Date(String(iso) + 'T00:00:00').getDay();
  const x = Math.max(0, Number(h) || 0), r2 = n => Math.round(n * 100) / 100;
  if (wd === 0) return {ordinary: 0, at_1_5: 0, at_2: r2(x)};
  if (wd === 6) { const a = Math.min(x, 2); return {ordinary: 0, at_1_5: r2(a), at_2: r2(x - a)}; }
  const o = Math.min(x, 7.6), a = Math.min(Math.max(x - 7.6, 0), 2);
  return {ordinary: r2(o), at_1_5: r2(a), at_2: r2(Math.max(x - 9.6, 0))};
}
/* one of our lines graded by its own kind's rules — the same rules pipeline/ops_layer.py applies at the build */
function gradeOurs(c){
  const has = v => v != null && v !== '';
  const num = v => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && Number.isFinite(Number(v)) ? Number(v) : null;
  const day = v => /^\d{4}-\d{2}-\d{2}$/.test(String(v || '')) && !isNaN(new Date(String(v) + 'T00:00:00'));
  const K = OUR_KIND[c.kind] || null, P = [];
  const amt = has(c.amount) ? num(c.amount) : null;
  let amount = amt != null && amt >= 0 ? amt : null, hours = null, awaiting = false;
  if (!K) P.push('the kind is not one of ours');
  else if (c.category !== K.category) P.push('the category is not one of our own');
  if (!c.recorded_by) P.push('nobody is named as recording it');
  if (c.ref && !allAssets().some(a => a.key === c.ref)) P.push(c.ref + ' is not a reference in this file');
  if (K && K.key !== 'person' && !day(c.date)) P.push('the date is not a day');
  if (K && K.money && has(c.amount) && (amt == null || amt < 0)) P.push(K.key === 'accommodation' ? 'the rate is not a number' : 'the cost is not a number');
  if (K) switch (K.key) {
    case 'transport':
      if (!String(c.description || '').trim() && !String(c.route_from || '').trim() && !String(c.route_to || '').trim()) P.push('nothing says what moved or where');
      awaiting = !has(c.amount); break;
    case 'labour': {
      if (!String(c.person || '').trim()) P.push('nobody is named as working it');
      const h = has(c.hours) ? num(c.hours) : shiftHours(c.start, c.finish, c.break_min);
      if (has(c.hours) && (h == null || h < 0 || h > 24)) P.push('the hours are not a number of hours in a day');
      else if (h == null) P.push('no hours, and no start and finish to work them out from');
      else hours = Math.round(h * 100) / 100;
      amount = null; break; }
    case 'accommodation':
      if (!String(c.person || '').trim()) P.push('nobody is named as staying');
      awaiting = !has(c.amount); break;
    case 'meals':
      if (!String(c.person || '').trim()) P.push('nobody is named');
      awaiting = !has(c.amount); break;
    case 'misc':
      if (!String(c.description || '').trim() && !String(c.type || '').trim()) P.push('nothing says what the expense is');
      awaiting = !has(c.amount); break;
    case 'person': {
      if (!String(c.person || '').trim()) P.push('the person has no name');
      const r = has(c.accommodation_rate) ? num(c.accommodation_rate) : null;
      if (has(c.accommodation_rate) && (r == null || r < 0)) P.push('the rate a night is not a number');
      if (c.charged_as && !eventRoles().some(x => x.role === c.charged_as)) P.push('charged as a role the card does not carry');
      amount = null; break; }
  }
  return Object.assign({}, c, {amount, hours, overtime_hours: null, awaiting, usable: !P.length, problems: P});
}
/* the raw line as the record holds it — this browser's copy, else the committed record's, else the tracker's */
function ourRawOf(id){
  const k = String(id);
  return (S.costs || []).find(c => isOurs(c) && c.id === k) || ((COMMITTED.costs) || []).find(c => isOurs(c) && c.id === k)
    || ((WF.present && WF.lines) || []).find(c => c.id === k) || null;
}
function ourCosts(){
  const seen = new Map();
  ((WF.present && WF.lines) || []).forEach(c => seen.set(c.id, Object.assign(gradeCost(c), {_where: 'tracker'})));
  ((COMMITTED.costs) || []).filter(isOurs).forEach(c => seen.set(c.id, Object.assign(gradeCost(c), {_where: 'committed'})));
  (S.costs || []).filter(isOurs).forEach(c => seen.set(c.id, Object.assign(gradeCost(c), {_where: 'local'})));
  const list = [...seen.values()].filter(c => !tombedHere(c.id));
  /* a night with no rate of its own is priced at the person's rate a night; with neither it waits, never nought */
  const rate = new Map(list.filter(c => c.kind === 'person' && c.usable).map(p => { const r = p.accommodation_rate;
    return [p.person, r != null && r !== '' && Number.isFinite(Number(r)) && Number(r) >= 0 ? Number(r) : null]; }));
  list.forEach(c => { if (c.kind === 'accommodation' && c.usable && c.amount == null) { const r = rate.get(c.person);
    if (r != null) { c.amount = r; c.awaiting = false; c.rate_from = 'person'; } } });
  return list.sort((x, y) => String(y.date || '').localeCompare(String(x.date || '')) || String(x.person || '').localeCompare(String(y.person || '')) || String(x.id).localeCompare(String(y.id)));
}
function ourCostOf(id){ return ourCosts().find(c => c.id === String(id)) || null; }
/* the sums the page prints for our lines: usable lines with a figure; the rest named, never nought */
function ourTotals(list){
  const ok = list.filter(c => c.usable && !c.awaiting && c.amount != null);
  return {lines: list.length, priced: ok.length, awaiting: list.filter(c => c.usable && (c.awaiting || c.amount == null) && OUR_KIND[c.kind] && OUR_KIND[c.kind].money).length,
          problems: list.filter(c => !c.usable).length, amount: sumOf(ok, 'amount')};
}
function ourByBranch(list){
  const m = new Map();
  list.forEach(c => { const k = normBranch(c.branch || '') || ''; if (!m.has(k)) m.set(k, []); m.get(k).push(c); });
  return [...m.entries()].map(([code, rows]) => Object.assign({code: code || null}, ourTotals(rows))).sort((a, b) => b.amount - a.amount || String(a.code || '~').localeCompare(String(b.code || '~')));
}
function nextOurId(){ return nextIdFor('T', [S.costs, COMMITTED.costs]); }
/* the fields a form or a call hands in, tidied by type: a figure that is not a number is NaN so it can be refused */
function cleanOur(K, f){
  const t = v => String(v == null ? '' : v).replace(/\s+/g, ' ').trim().slice(0, 240);
  const out = {};
  K.fields.forEach(fd => { if (!(fd.name in f)) return; const v = f[fd.name];
    if (fd.type === 'money' || fd.type === 'number') { const a = String(v == null ? '' : v).replace(/[$,\s]/g, ''); out[fd.name] = a === '' ? null : (Number.isFinite(Number(a)) ? Math.round(Number(a) * 100) / 100 : NaN); }
    else if (fd.type === 'date') out[fd.name] = t(v).slice(0, 10) || null;
    else if (fd.type === 'time') { const m = /^(\d{1,2}):(\d{2})/.exec(t(v)); out[fd.name] = m ? String(m[1]).padStart(2, '0') + ':' + m[2] : null; }
    else if (fd.type === 'branch') out[fd.name] = normBranch(v || '') || null;
    else if (fd.type === 'ref') out[fd.name] = t(v).toUpperCase() || null;
    else out[fd.name] = t(v) || null; });
  return out;
}
/* one person's hours on one day, one night, one person's meals on one day are ONE line on every copy: the id is the
   person and the day (the tracker's own scheme), so adding one where the tracker has one changes that line */
function ourIdFor(K, f){
  if (K.key === 'person') return 'W-P-' + ourSlug(f.person);
  if (K.key === 'labour' || K.key === 'accommodation' || K.key === 'meals') return 'W-' + K.letter + '-' + ourSlug(f.person) + '-' + String(f.date || '').replace(/-/g, '');
  return nextIdFor(K.letter, [S.costs, COMMITTED.costs, (WF.present && WF.lines) || []]);
}
function ourRefuse(K, f){
  const bad = K.fields.find(fd => (fd.type === 'money' || fd.type === 'number') && Number.isNaN(f[fd.name]));
  if (bad) return `${bad.label} has to be a number${K.money && bad.type === 'money' ? ', ex GST' : ''} — or leave it empty until it is known.`;
  const miss = K.fields.find(fd => fd.req && !f[fd.name]);
  if (miss) return `Put the ${miss.label.toLowerCase()} on it.`;
  if (f.ref && !allAssets().some(a => a.key === f.ref)) return f.ref + ' is not a reference in this file.';
  if (f.charged_as && !eventRoles().some(r => r.role === f.charged_as)) return 'That is not a role on the card\'s event team.';
  if (K.key === 'labour' && f.hours != null && (f.hours < 0 || f.hours > 24)) return 'Hours have to be between 0 and 24 for one day.';
  return null;
}
/* add one of our lines; a line with a problem the grading finds is still recorded so the detail can follow — only a
   figure that is not a number, a missing name or day, or a reference not in this file is refused outright */
function addOurCost(kind, fields){
  if (!mayWrite('our cost line')) return null;
  const who = whoAmI(); if (!who) return null;
  const K = OUR_KIND[kind] || OUR_KIND.transport;
  const f = cleanOur(K, fields || {});
  if (K.key === 'labour' && f.hours == null) f.hours = shiftHours(f.start, f.finish, f.break_min);
  const no = ourRefuse(K, f); if (no) { flash(no); return null; }
  const id = ourIdFor(K, f);
  const prior = ourRawOf(id), now = new Date().toISOString();
  const line = prior && !tombedHere(id)
    ? Object.assign({}, prior, f, {id, side: 'ours', kind: K.key, category: K.category, updated_at: now, updated_by: who})
    : Object.assign({id, side: 'ours', kind: K.key, category: K.category, from: 'page'}, f, {recorded_by: who, recorded_on: now, at: now, by: who, updated_at: now, updated_by: who});
  if (tombedHere(id)) untomb(id, who);
  S.costs = (S.costs || []).filter(c => c.id !== id); S.costs.push(line);
  stampIt('ourcost', id, who); save();
  const g = gradeOurs(line);
  flash(`${prior ? id + ' changed' : id + ' recorded'} by ${who}${g.awaiting && K.money ? ' — awaiting its figure' : ''}${g.problems.length ? ' · ' + g.problems.join('; ') : ''}.`);
  return id;
}
function setOurCost(id, fields){
  if (!mayWrite('our cost line')) return false;
  const who = whoAmI(); if (!who) return false;
  const raw = ourRawOf(id); if (!raw || tombedHere(String(id))) { flash('That line is not on the record.'); return false; }
  const K = OUR_KIND[raw.kind] || OUR_KIND.transport;
  const f = cleanOur(K, fields || {});
  const merged = Object.assign({}, raw, f);
  if (K.key === 'labour' && ('start' in f || 'finish' in f || 'break_min' in f) && !('hours' in f && f.hours != null)) merged.hours = shiftHours(merged.start, merged.finish, merged.break_min);
  const no = ourRefuse(K, merged); if (no) { flash(no); return false; }
  /* the id is the person and the day: a change to either is a different line, so it moves — the old one is taken off */
  const newId = (K.key === 'person' || K.key === 'labour' || K.key === 'accommodation' || K.key === 'meals') ? ourIdFor(K, merged) : raw.id;
  const now = new Date().toISOString();
  const line = Object.assign(merged, {id: newId, side: 'ours', kind: K.key, category: K.category, updated_at: now, updated_by: who});
  if (newId !== raw.id) { if (ourCostOf(newId)) { flash(`${merged.person} already has a line on ${fmtDate(merged.date)} — change that one instead.`); return false; }
    S.costs = (S.costs || []).filter(c => c.id !== raw.id); tomb(raw.id, who); if (tombedHere(newId)) untomb(newId, who); }
  S.costs = (S.costs || []).filter(c => c.id !== newId); S.costs.push(line);
  stampIt('ourcost', newId, who); save();
  flash(`${newId} changed by ${who}.`);
  return true;
}
function removeOurCost(id){
  if (!mayWrite('our cost line')) return false;
  const who = whoAmI(); if (!who) return false;
  const cur = ourCostOf(id); if (!cur) return false;
  S.costs = (S.costs || []).filter(c => c.id !== cur.id);
  tomb(cur.id, who); save();
  flash(`${cur.id} taken off by ${who} — the removal travels with the record.`);
  return true;
}
/* a person's rate a night or race-weekend role, set from the People table — the person's own line, changed or made */
function setOurPerson(name, patch){
  const id = 'W-P-' + ourSlug(name);
  return ourRawOf(id) && !tombedHere(id) ? setOurCost(id, patch) : !!addOurCost('person', Object.assign({person: name}, patch));
}
function ourLineWords(c){
  const K = OUR_KIND[c.kind] || {label: 'Our cost'};
  if (c.kind === 'transport') return `${c.description || ((c.route_from || c.route_to) ? (c.route_from || '?') + ' → ' + (c.route_to || '?') : 'transport')}`;
  if (c.kind === 'labour') return `${c.person || 'someone'} · ${c.hours != null ? fmtNum(c.hours) + ' h' : 'hours not worked out'}${c.start && c.finish ? ' (' + c.start + '–' + c.finish + ')' : ''}`;
  if (c.kind === 'accommodation') return `${c.person || 'someone'} · a night${c.hotel ? ' at ' + c.hotel : ''}`;
  if (c.kind === 'meals') return `${c.person || 'someone'} · meals`;
  if (c.kind === 'misc') return `${c.type ? c.type + ' · ' : ''}${c.description || 'expense'}`;
  if (c.kind === 'person') return `${c.person || 'someone'}${c.accommodation_rate != null ? ' · ' + money(c.accommodation_rate) + ' a night' : ''}${c.charged_as ? ' · charged as ' + c.charged_as : ''}`;
  return K.label;
}
function ourCostMailto(c){
  const K = OUR_KIND[c.kind] || OUR_KIND.transport;
  const lines = [`${DATA.brand.org} · ${DATA.event.name} · ${c.id} — our cost`, `Kind: ${c.category}`, c.date ? `Date: ${fmtDate(c.date)}` : null,
    c.kind === 'transport' ? `Branch: ${c.branch ? branchWords(c.branch) : 'none recorded'}` : null, c.person ? `Person: ${c.person}` : null,
    c.ref ? `Reference / load: ${c.ref}` : null, c.carrier ? `Carrier: ${c.carrier}` : null,
    (c.route_from || c.route_to) ? `Movement: ${c.route_from || '?'} → ${c.route_to || '?'}` : null, c.description ? `What: ${c.description}` : null,
    c.kind === 'labour' ? `Hours: ${c.hours != null ? fmtNum(c.hours) : 'not worked out'}${c.start && c.finish ? ' (' + c.start + '–' + c.finish + (c.break_min ? ', ' + c.break_min + ' min break' : '') + ')' : ''}` : null,
    K.money ? (c.amount != null ? `Cost: ${money(c.amount)} ex GST${c.rate_from === 'person' ? " (the person's rate a night)" : ''}` : 'Cost: awaiting the figure') : null,
    c.reference ? `Docket / invoice: ${c.reference}` : null, c.note ? `Note: ${c.note}` : null,
    c._where === 'tracker' ? `From Andrew Fisher's tracker (${WF.workbook || 'workbook'})` : `Recorded ${fmtStamp(c.recorded_on)} by ${c.recorded_by || 'unnamed'}${c.updated_at && c.updated_at !== c.recorded_on ? ' · changed ' + fmtStamp(c.updated_at) + ' by ' + (c.updated_by || 'unnamed') : ''}`,
    '', `Sent from GC500_Delivery_Control.html · open it at #costs · dataset ${(DATA.register_sha256 || '').slice(0, 12)}`];
  return mailto(`GC500 · ${c.id} — our ${K.label.toLowerCase()} cost${c.amount != null && K.money ? ' ' + money(c.amount) + ' ex GST' : ''}`, capLines(lines));
}
const sumOf = (list, f) => Math.round(list.reduce((a, c) => a + (c[f] || 0), 0) * 100) / 100;
function costTotals(list){
  const ok = list.filter(c => c.usable);
  return {lines: list.length, usable: ok.length, problems: list.length - ok.length, amount: sumOf(ok, 'amount'), without_amount: ok.filter(c => c.amount == null).length,
          hours: sumOf(ok, 'hours'), overtime_hours: sumOf(ok, 'overtime_hours')};
}
function costsByCategory(list){
  return COST_CATS.map(cat => Object.assign({category: cat, short: costShort(cat)}, costTotals(list.filter(c => c.category === cat))));
}
/* THE FENCING SIDE'S DERIVED FIGURES. `charged` is what the customer is charged at the 2026 card across the usable
   dockets — the figure every total on the page reads; `cost` (v5.60, off in v5.79, back in v5.80 on Andrew Fisher's
   word of 24 Sep 2026 that fencing shows charged and paid) is what Coates pays Advanced at the crew's own sheet
   across the same dockets, and `margin` the difference across the dockets where both sides are known on every
   line. `cost` is shown on the Fencing tab, and follows the printed summary and the email on its own line outside
   every total; nothing is ever added across the two, and the Costs tab and the branches do not read it. */
function fenceDerived(){
  const u = allDockets().filter(d => d.usable);
  const r2 = n => Math.round(n * 100) / 100;
  const both = u.filter(d => d.margin != null);
  return {dockets: u.length,
          cost: r2(u.reduce((a, d) => a + (d.paid_total || 0), 0)),
          charged: r2(u.reduce((a, d) => a + d.cost_total, 0)),
          margin: both.length ? r2(both.reduce((a, d) => a + d.margin, 0)) : null,
          margin_dockets: both.length};
}
const hoursWords = (h, ot) => (h || ot) ? `${h || 0} h${ot ? ' + ' + ot + ' h overtime' : ''}` : '';
function costMailto(c){
  const a = c.ref ? allAssets().find(x => x.key === c.ref) : null;
  const lines = [
    `${DATA.brand.org} · ${DATA.event.name} · ${c.id}`,
    `Category: ${c.category}`,
    `Date: ${fmtDate(c.date)}`,
    `What: ${c.description}`,
    c.amount != null ? `Amount: ${money(c.amount)} ex GST` : 'Amount: none on the line',
    hoursWords(c.hours, c.overtime_hours) ? `Hours: ${hoursWords(c.hours, c.overtime_hours)}` : null,
    c.supplier ? `Supplier / who: ${c.supplier}` : null,
    c.reference ? `Docket / invoice / timesheet: ${c.reference}` : null,
    c.ref ? `Asset: ${c.ref}${a && a.name ? ' — ' + a.name : ''}` : null,
    c.area ? `Fencing area: ${c.area}` : null,
    `Branch: ${costBranchOf(c).code ? branchWords(costBranchOf(c).code) + ' (' + costBranchOf(c).why + ')' : 'none recorded'} · Kind: ${kindLabel(costKindOf(c))} (${costKindWhy(c)})`,
    c.po_no ? `Purchase order: ${c.po_no}` : null,
    c.note ? `Note: ${c.note}` : null,
    c.problems && c.problems.length ? `Incomplete: ${c.problems.join('; ')}` : null,
    `From: ${costFromWords(c)}`,
    `Recorded ${fmtStamp(c.recorded_on)} by ${c.recorded_by || 'unnamed'}${c.updated_at && c.updated_at !== c.recorded_on ? ' · changed ' + fmtStamp(c.updated_at) + ' by ' + (c.updated_by || 'unnamed') : ''}`,
    '', `Sent from GC500_Delivery_Control.html · open it at #costs · dataset ${(DATA.register_sha256 || '').slice(0, 12)}`];
  return mailto(`GC500 · ${c.id} — ${costShort(c.category)}${c.amount != null ? ' ' + money(c.amount) + ' ex GST' : ''}`, capLines(lines));
}
function costsSummaryMailto(list){
  const T = costTotals(list), fd = fenceDerived();
  /* v5.83 — the email says what management should read, in the order they read it: the three figures, the
     streams (charge · cost · difference), what Coates pays by the eight categories, what is not in it yet */
  const M = moneySummary();
  const sd = v => v == null ? '—' : (v < 0 ? '-' + money0(-v) : money0(v));
  const lines = [`${DATA.event.name} · as at ${fmtDate(M.as_at)} · AUD ex GST`,
    'A charge is what Coates bills the V8s (all hire is a charge); a cost is what Coates pays. The two are never added together.', '',
    `WE CHARGE THE V8s ${money0(M.charge.total)} · COATES PAYS (known) ${money0(M.cost.known)} · DIFFERENCE SO FAR ${sd(M.difference0)} — not a margin yet`,
    M.breakeven != null ? `Wages are not in it: ${fmtNum(M.breakeven_hours)} h with no wage rate — the difference covers them up to ${money(M.breakeven)} an hour.` : null, '',
    'BY STREAM (we charge · Coates pays · difference):'];
  const TS = M.servicing;
  M.streams.forEach(s => { const bits = [];
    if (s.key === 'crew' && M.cost.labour) bits.push('wages not in it — hours only');
    if (s.key === 'toilets' && TS && TS.at_card_total) bits.push(`servicing not charged — ${money0(TS.at_card_total)} at our pump-out rates`);
    if (s.unrated) bits.push(`${s.unrated} line${s.unrated === 1 ? '' : 's'} no rate yet`);
    lines.push(`${s.name}: ${s.charge_known ? money0(s.charge0) : '—'} · ${s.cost_known ? money0(s.cost0) : '—'} · ${s.cost_known ? sd(s.difference0) : 'before costs'}${bits.length ? ' (' + bits.join('; ') + ')' : ''}`); });
  lines.push('', `NOT IN IT YET: ${M.missing_short.join(', ')}`);
  if (M.caveats_short && M.caveats_short.length) lines.push(`PROVISIONAL: ${M.caveats_short.join('; ')}`);
  /* what Coates pays by the eight categories management expect every cost recorded against, in one breath */
  const cats = M.categories || [], none = cats.filter(c => !c.known && !c.hours);
  lines.push('', 'COATES PAYS BY CATEGORY (to the cent): ' + cats.filter(c => c.known || c.hours).sort((a, b) => (b.known ? b.amount : -1) - (a.known ? a.amount : -1) || (b.hours || 0) - (a.hours || 0)).map(c => `${costShort(c.category).toLowerCase()} ${c.known ? money(c.amount) + (c.hours ? ' + ' + fmtNum(c.hours) + ' h' : '') : fmtNum(c.hours) + ' h'}`).join(' · ') + (none.length ? ` · nothing yet: ${none.map(c => costShort(c.category).toLowerCase()).join(', ')}` : ''));
  if (T.problems) lines.push('', `CHARGE LINES ON THE RECORD: ${T.problems} incomplete, left out of every figure`);
  const tail = [`Every line is on the Costs & charges tab (#costs) · nothing typed or estimated · dataset ${(DATA.register_sha256 || '').slice(0, 12)}`];
  const keep = tail.reduce((n, l) => n + l.length + 1, 2);
  return mailto(`GC500 · are we making money — ${money0(M.charge.total)} charged, ${money0(M.cost.known)} known cost, as at ${fmtDate(M.as_at)}`, capLines(lines.filter(l => l != null), undefined, keep) + '\n\n' + tail.join('\n'));
}
/* the chip an asset's drawer wears when cost lines name it */
function costCard(a){
  const mine = costsFor(a.key), T = costTotals(mine);
  return `
  <div class="card" style="margin:0 0 14px">
    <div class="hubtitle"><h3>Costs${mine.length ? ` <span class="chip ref">${mine.length}</span>` : ''}</h3></div>
    ${mine.length ? `<p class="hint" style="margin:6px 0">${esc(money(T.amount) || '$0.00')} ex GST, from the record${hoursWords(T.hours, T.overtime_hours) ? ' · ' + esc(hoursWords(T.hours, T.overtime_hours)) : ''}${T.problems ? ` · <span class="chip crit">${T.problems} incomplete</span>` : ''}</p>
      <div>${mine.slice(0, 5).map(c => `<div class="acc"><span><b>${esc(c.id)}</b> <span class="chip">${esc(costShort(c.category))}</span> ${whereChip(c._where)}<br>
        <span class="w">${esc(fmtDate(c.date).slice(0, 10))} · ${esc(c.description)}${c.amount != null ? ' · ' + esc(money(c.amount)) : ''}${c.supplier ? ' · ' + esc(c.supplier) : ''}</span></span>
        <span></span></div>`).join('')}
      ${mine.length > 5 ? `<button class="linkish" id="toCosts">See all ${mine.length} on the Costs tab →</button>` : ''}</div>`
      : '<p class="norate" title="Nothing is typed here — a cost line arrives from the record (the fencing dockets) or from what Andrew Fisher gives the build.">No cost line names this asset.</p>'}
  </div>`;
}
function wireCostCard(a){
  const t = $('#toCosts'); if (t) t.onclick = () => { state.q = a.key; const qb = $('#q'); if (qb) { qb.value = state.q; const qx = $('#qx'); if (qx) qx.hidden = false; } go('costs'); };
}
/* By branch — the same roll-up Where we are draws its branch plates from (branchRollup), as a table: hire and
   transport at the card, then every kind of charge on the record (the fencing dockets among them, as subhire on
   the fencing contractor's branch), then the purchase orders. Andrew Fisher, 12 Sep 2026: each branch captures
   these costs; and 23 Sep 2026: the breakdown by branch code is what each branch is charging the V8s. */
function branchCostCard(){
  const R = branchRollup(todayIso());
  const rows = R.branches.concat(R.none && (R.none.lines.length || R.none.costs.length || (R.none.ours && R.none.ours.lines.length)) ? [R.none] : []);
  const kinds = COST_KINDS.filter(k => rows.some(g => g.kinds[k.key].lines) || ['labour', 'transport', 'damages', 'subhire'].includes(k.key));
  const cell = v => v ? `<b>${esc(money0(v))}</b>` : '<span class="todo">—</span>';
  return `<div class="card">
    <div class="hubtitle"><h3>By branch <span class="chip ref">${R.branches.length}</span></h3>
      <span class="w" style="font-size:12px;color:var(--mute)">${R.all.linked} of ${R.all.lines} lines carry a branch · ${R.all.pos} purchase order${R.all.pos === 1 ? '' : 's'}</span></div>
    <p class="hint" style="margin:0 0 8px">The branch code on a rental contract is the branch that gets the revenue (Andrew Fisher, 12 Sep 2026). What each branch charges the V8s is
      its contract lines by the rate and its charge lines on the record by kind — by the branch on the line or on the asset it names; the fencing dockets at the 2026 card sit under subhire on the fencing contractor's branch (Andrew Fisher, 23 Sep 2026).
      The event labour scope is the job's and on no branch. Our transport, at the right, is a cost to Coates — never a charge. Put a branch on an asset from its drawer or the Register tab.</p>
    <div class="tblwrap"><table class="brtbl"><thead><tr><th>Branch</th><th class="num">Lines</th><th class="num" title="what this branch's contract lines charge by Andrew Fisher's rule — Rate 1 as the whole-event bill, or a day rate from when it went in for VMS, forklifts and water barriers; never Baseplan's prebill">On the contracts<br><span class="w" style="font-weight:400;font-size:10.5px">by the rate</span></th>${kinds.map(k => `<th class="num">${esc(k.label)}<br><span class="w" style="font-weight:400;font-size:10.5px">charge lines</span></th>`).join('')}<th class="num" title="the contracts by the rate and the charge lines by kind, added — what this branch charges the V8s">Charged<br><span class="w" style="font-weight:400;font-size:10.5px">in all</span></th><th class="num">POs</th><th class="num" style="color:var(--mute)" title="what transport costs Coates on this branch — the lines people record under Transport — our costs; a cost, never a charge">Our transport<br><span class="w" style="font-weight:400;font-size:10.5px">cost to us</span></th></tr></thead>
    <tbody>${rows.map(g => `<tr>
      <td>${g.code ? `<b class="mono">${esc(g.code)}</b>${g.name ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(g.name)}</span>` : ''}` : '<span class="todo">no branch recorded</span>'}</td>
      <td class="num">${g.lines.length}${g.contracts.length ? `<br><span class="w" style="font-size:11px;color:var(--mute)">${g.contracts.length} contract${g.contracts.length === 1 ? '' : 's'}</span>` : ''}</td>
      <td class="num" title="${g.contract && g.contract.lines ? esc(`${g.contract.charge_lines} of ${g.contract.lines} contract line${g.contract.lines === 1 ? '' : 's'} on ${g.code || 'no branch'} charge by the rate${g.contract.unknown ? ` · ${g.contract.unknown} with no rate yet` : ''}${g.contract.differs.length ? ` · ${g.contract.differs.length} where Baseplan's prebill reads differently` : ''}${g.contract.subhire.lines ? ` · subhired ${money0(g.contract.subhire.charge)}` : ''}${g.contract.transport.lines ? ` · transport and delivery ${money0(g.contract.transport.charge)}` : ''} · Baseplan prebilled ${money0(g.contract.prebill)} — listed under the table`) : ''}">${g.contract && g.contract.lines ? `${cell(g.contract.charge0)}${g.contract.unknown || g.contract.differs.length ? `<br><span class="w" style="font-size:11px;color:var(--mute)"> ${g.contract.unknown ? g.contract.unknown + ' no rate' : ''}${g.contract.unknown && g.contract.differs.length ? ' · ' : ''}${g.contract.differs.length ? g.contract.differs.length + ' to settle' : ''}</span>` : ''}` : '<span class="todo">—</span>'}</td>
      ${kinds.map(k => `<td class="num">${g.kinds[k.key].amount ? cell(g.kinds[k.key].amount0) : g.kinds[k.key].hours ? `<span class="w">${esc(g.kinds[k.key].hours)} h</span>` : '<span class="todo">—</span>'}</td>`).join('')}
      <td class="num">${cell(g.charged0)}</td>
      <td class="num">${g.pos.length ? `${g.pos.length}<br><span class="w" style="font-size:11px;color:var(--mute)">${g.invoiced} invoiced</span>` : '—'}</td>
      <td class="num" style="color:var(--mute)">${g.ours && g.ours.transport.lines ? `${cell(g.ours.transport.amount0)}${g.ours.transport.awaiting ? `<br><span class="w" style="font-size:11px"> ${g.ours.transport.awaiting} awaiting a figure</span>` : ''}` : '<span class="todo">—</span>'}</td></tr>`).join('')}
      <tr class="total"><td><b>All branches</b></td><td class="num">${R.all.lines}</td>
      <td class="num" title="${esc(R.all.contract.charge_lines + ' of ' + R.all.contract.lines + ' lines on ' + R.all.contract.contracts.length + ' contracts charge by the rate · Baseplan prebilled ' + money0(R.all.contract.prebill))}">${R.all.contract.lines ? cell(R.all.contract.charge0) : '—'}</td>
      ${kinds.map(k => `<td class="num">${R.all.kinds[k.key].amount ? cell(R.all.kinds[k.key].amount0) : R.all.kinds[k.key].hours ? `<span class="w">${esc(R.all.kinds[k.key].hours)} h</span>` : '—'}</td>`).join('')}
      <td class="num">${cell(R.all.charged0)}</td>
      <td class="num">${R.all.pos || '—'}</td>
      <td class="num" style="color:var(--mute)">${R.all.ours && R.all.ours.transport.lines ? cell(R.all.ours.transport.amount0) : '—'}</td></tr></tbody></table></div>
    ${R.all.contract.lines ? `<details class="sfold"><summary>On the contracts — by the rate, the lines to settle, subhired and charge lines, by branch</summary><div class="sfoldbody">
      <p class="hint">The contracts column is what each branch's lines charge by Andrew Fisher's rule of 24 Sep 2026 — forklifts, VMS and water barriers from when they go in, everything else over the event only, and always by the rate, never by the prebill amount — so a VMS, forklift or water-barrier line is Rate 1 a day from the contract's start to its term (never fewer than the line's own minimum days), and every other line is Rate 1 once, as the whole-event bill. Baseplan's export of ${ONHIRE ? esc(fmtDate(ONHIRE.supplied_on)) : '—'} prebilled ${esc(money0(R.all.contract.prebill))} on the same lines; the rule agrees with it on ${R.all.contract.lines - R.all.contract.unknown - R.all.contract.differs.length} of the ${R.all.contract.lines - R.all.contract.unknown} lines it can price. A line whose item code starts with SUB is subhired; a transport or delivery line is a charge, not a thing on site. ${R.all.contract.unknown ? `${R.all.contract.unknown} line${R.all.contract.unknown === 1 ? ' carries' : 's carry'} no rate yet (${esc(R.all.contract.unknown_kinds.map(([k, n]) => n + ' ' + k).join(', '))}) — unknown, not nought.` : ''}</p>
      ${R.all.contract.differs.length ? `<p class="hint"><b>${R.all.contract.differs.length} line${R.all.contract.differs.length === 1 ? '' : 's'} where Baseplan's prebill reads differently</b> — ${esc(money0(R.all.contract.differs_charge))} by the rule against ${esc(money0(R.all.contract.differs_prebill))} prebilled. The page goes by the rate; settle each with its branch:</p>
      <ul style="margin:0 0 8px;padding-left:18px;font-size:12.5px;line-height:1.55">${R.all.contract.differs.map(x => `<li>${esc(contractDiffWords(x))}</li>`).join('')}</ul>` : ''}
      ${rows.filter(g => g.contract && g.contract.lines).map(g => `<p class="hint"><b class="mono">${esc(g.code || 'no branch')}</b> — ${g.contract.lines} line${g.contract.lines === 1 ? '' : 's'} on ${esc(g.contract.contracts.join(', '))}, ${esc(money0(g.contract.charge0 != null ? g.contract.charge0 : g.contract.charge))} by the rate${g.contract.daily.lines ? ` (${esc(money0(g.contract.daily.charge))} by the day on ${g.contract.daily.lines} line${g.contract.daily.lines === 1 ? '' : 's'})` : ''}${g.contract.unknown ? ` · ${g.contract.unknown} line${g.contract.unknown === 1 ? '' : 's'} with no rate yet` : ''}${g.contract.differs.length ? ` · ${g.contract.differs.length} to settle` : ''} · Baseplan prebilled ${esc(money0(g.contract.prebill))}. ${contractPlateNote(g.contract).replace(/^<p class="src">|<\/p>$/g, '')}</p>`).join('')}
    </div></details>` : ''}
    <details class="sfold"><summary>For comparison — the 2026 ${esc(CARD_WORD)} card's estimate from the schedule, by branch</summary><div class="sfoldbody">
      <p class="hint">The Pricing tab prices the schedule lines each branch carries at the 2026 ${esc(CARD_WORD)} card: ${esc(rows.filter(g => g.lines.length).map(g => `${g.code || 'no branch'} ${money0(g.hire0)} hire${g.transport0 ? ' + ' + money0(g.transport0) + ' transport' : ''}`).join(' · '))} — ${esc(money0(R.all.hire0))} hire and ${esc(money0(R.all.transport0))} transport in all. An estimate from the schedule, never the bill and never added to what is charged.</p>
    </div></details>
  </div>`;
}
function printCosts(){
  /* one landscape page: the categories and the lines shown; the rule is scoped to this print and removed after it */
  const st = document.createElement('style'); st.id = 'costPage'; st.textContent = '@page{size:A4 landscape;margin:6mm 8mm}';
  document.head.appendChild(st); document.body.classList.add('printing-costs');
  const done = () => { st.remove(); document.body.classList.remove('printing-costs'); };
  window.addEventListener('afterprint', done, {once: true});
  setTimeout(() => { try { markCards(); window.print(); } catch (e) { done(); } }, 50);
  setTimeout(() => { if (document.getElementById('costPage')) done(); }, 15000);
}
/* ------------------------------------------------------------------ ARE WE MAKING MONEY?
   v5.81 — Andrew Fisher, 24 Sep 2026: management want every cost captured — what we charge, what each branch
   charges, our transport, our labour (in hours only — there are no labour costs for this job), accommodation,
   misc costs and meals away from home — with our costs kept separate and neatly summarised, so we can see
   whether we are making money or losing it.
   One function every surface reads — the Costs tab's
   summary, the email and the printed page — so no two of them can disagree. The two sides of the ledger are
   never added across: what Coates charges the V8s on the left, what it costs Coates on the right, and the
   difference between them only where both are known. Every figure names where it came from; a figure nobody has
   is said to be missing, never nought; nothing is estimated. */
const WF = DATA.workforce || {present: false};
/* ------------------------------------------------------------------ the tracker, live
   Everything the Costs tab says about labour, nights, meals and expenses is worked out here from the lines as they
   stand now — the tracker's, changed and added to on the page — never from the workbook's own totals, which are
   kept beside them in the build (print/workforce_expenses.json) as what was supplied. */
function trackerFigures(asOf){
  const day = asOf || todayIso();
  const L = ourCosts();
  const r2 = n => Math.round(n * 100) / 100;
  const people = new Map();
  L.filter(c => c.kind === 'person' && c.usable).forEach(p => people.set(p.person, p));
  const personOf = n => people.get(n) || {person: n, type: null, employer: null, accommodation_rate: null, charged_as: null, _none: true};
  const race = new Set(EVENT_DAYS);
  const shifts = L.filter(c => c.kind === 'labour' && c.usable);
  const lab = {hours: 0, to_date: 0, planned: 0, ordinary: 0, at_1_5: 0, at_2: 0, shifts: 0, by_employer: {}};
  const rw = {hours: 0, shifts: 0, people: new Map(), unpriced_hours: 0, unpriced_people: new Set()};
  const per = new Map();
  const pp = n => { if (!per.has(n)) { const P = personOf(n); per.set(n, {name: n, type: P.type, employer: P.employer, rate: P.accommodation_rate, charged_as: P.charged_as || null,
    shifts: 0, hours: 0, to_date: 0, planned: 0, ordinary: 0, at_1_5: 0, at_2: 0, race: 0, nights: 0, nights_unpriced: 0, accommodation: 0, meals: 0}); } return per.get(n); };
  people.forEach((p, n) => pp(n));
  shifts.forEach(s => { const h = s.hours || 0, x = pp(s.person); x.shifts++;
    if (race.has(s.date)) { rw.hours += h; rw.shifts++; x.race += h;
      const q = rw.people.get(s.person) || {name: s.person, hours: 0, days: {}}; q.hours += h; q.days[s.date] = (q.days[s.date] || 0) + h; rw.people.set(s.person, q);
      if (!x.charged_as) { rw.unpriced_hours += h; rw.unpriced_people.add(s.person); } return; }
    const b = splitHours(h, s.date);
    lab.hours += h; lab.shifts++; lab.ordinary += b.ordinary; lab.at_1_5 += b.at_1_5; lab.at_2 += b.at_2;
    x.hours += h; x.ordinary += b.ordinary; x.at_1_5 += b.at_1_5; x.at_2 += b.at_2;
    if (s.date <= day) { lab.to_date += h; x.to_date += h; } else { lab.planned += h; x.planned += h; }
    const e = x.employer || 'unstated'; const ee = lab.by_employer[e] || {hours: 0, people: new Set()}; ee.hours += h; ee.people.add(s.person); lab.by_employer[e] = ee; });
  const nights = L.filter(c => c.kind === 'accommodation' && c.usable);
  const acc = {nights: nights.length, amount: 0, to_date: 0, planned: 0, unpriced: 0, unpriced_for: new Set()};
  nights.forEach(n => { const x = pp(n.person); x.nights++;
    if (n.amount == null) { acc.unpriced++; acc.unpriced_for.add(n.person); x.nights_unpriced++; return; }
    acc.amount += n.amount; x.accommodation += n.amount; if (n.date <= day) acc.to_date += n.amount; else acc.planned += n.amount; });
  const mealLines = L.filter(c => c.kind === 'meals' && c.usable), miscLines = L.filter(c => c.kind === 'misc' && c.usable);
  const meals = {lines: mealLines.length, amount: 0, awaiting: 0}, misc = {lines: miscLines.length, amount: 0, awaiting: 0, by_type: {}};
  mealLines.forEach(m => { if (m.amount == null) { meals.awaiting++; return; } meals.amount += m.amount; pp(m.person).meals += m.amount; });
  miscLines.forEach(m => { if (m.amount == null) { misc.awaiting++; return; } misc.amount += m.amount; const t = m.type || 'untyped'; misc.by_type[t] = (misc.by_type[t] || 0) + m.amount; });
  ['hours', 'to_date', 'planned', 'ordinary', 'at_1_5', 'at_2'].forEach(k => lab[k] = r2(lab[k]));
  Object.values(lab.by_employer).forEach(e => { e.hours = r2(e.hours); e.people = [...e.people].sort(); });
  lab.weighted = r2(lab.ordinary + 1.5 * lab.at_1_5 + 2 * lab.at_2);
  rw.hours = r2(rw.hours); rw.unpriced_hours = r2(rw.unpriced_hours); rw.unpriced_people = [...rw.unpriced_people].sort();
  ['amount', 'to_date', 'planned'].forEach(k => acc[k] = r2(acc[k])); acc.unpriced_for = [...acc.unpriced_for].sort();
  meals.amount = r2(meals.amount); misc.amount = r2(misc.amount); Object.keys(misc.by_type).forEach(k => misc.by_type[k] = r2(misc.by_type[k]));
  per.forEach(x => ['hours', 'to_date', 'planned', 'ordinary', 'at_1_5', 'at_2', 'race', 'accommodation', 'meals'].forEach(k => x[k] = r2(x[k])));
  /* the weeks of the tracker's own overview, worked out again from the lines as they stand */
  const weeks = (WF.weeks || []).map(w => { const inW = d => d >= w.from && d <= w.to;
    const sh = shifts.filter(s => inW(s.date)), ni = nights.filter(n => inW(n.date));
    const hrsBy = t => r2(sh.filter(s => (personOf(s.person).type || '') === t).reduce((a, s) => a + (s.hours || 0), 0));
    const accW = r2(ni.reduce((a, n) => a + (n.amount || 0), 0)), mealW = r2(mealLines.filter(m => inW(m.date)).reduce((a, m) => a + (m.amount || 0), 0)), otherW = r2(miscLines.filter(m => inW(m.date)).reduce((a, m) => a + (m.amount || 0), 0));
    return {week: w.week, from: w.from, to: w.to, cna: hrsBy('Internal CNA'), external: hrsBy('External'), salary: hrsBy('Salary'), hours: r2(sh.reduce((a, s) => a + (s.hours || 0), 0)),
            race: r2(sh.filter(s => race.has(s.date)).reduce((a, s) => a + (s.hours || 0), 0)), nights: ni.length, accommodation: accW, meals: mealW, other: otherW, total: r2(accW + mealW + otherW)}; });
  return {people: [...per.values()].sort((a, b) => (b.hours + b.race) - (a.hours + a.race) || a.name.localeCompare(b.name)), personOf, labour: lab, race: rw, accommodation: acc, meals, misc, weeks, lines: L};
}
/* the race weekend's hours by card role and day, from the people charged as that role — what the Pricing tab's
   event-hours card falls back on where nobody has typed a figure for that day and role */
function raceRoleHours(){
  const T = trackerFigures(), m = new Map();
  T.lines.filter(c => c.kind === 'labour' && c.usable && EVENT_DAYS.includes(c.date)).forEach(s => {
    const role = T.personOf(s.person).charged_as; if (!role) return;
    const k = eventHoursKey(role, s.date), x = m.get(k) || {hours: 0, people: []};
    x.hours = Math.round((x.hours + (s.hours || 0)) * 100) / 100; if (!x.people.includes(s.person)) x.people.push(s.person); m.set(k, x); });
  return m;
}
function moneySummary(asOf){
  const mk = 'money:' + (asOf || ''); if (RENDER_MEMO.has(mk)) return RENDER_MEMO.get(mk); const v = moneySummary_(asOf); RENDER_MEMO.set(mk, v); return v; }
function moneySummary_(asOf){
  const day = asOf || todayIso();
  const R = branchRollup(day);
  const C = R.all.contract;
  const cents = n => Math.round(n * 100) / 100;
  const fd = fenceDerived();
  const live = allAssets().filter(a => !a._cancelled);
  /* the card side: labour ticked per piece (a charge the contracts do not carry yet — the labour charges captured
     here are to be added to those hire contracts in time), and the card's hire as the comparison figure */
  let labour = 0, labourTicks = 0, labourUnknown = 0, cardHire = 0, cardTransportCharge = 0, cardTransportCost = 0;
  live.forEach(a => { const t = assetTotal(a);
    (t.lines || []).forEach(l => {
      if (l.labour && l.labour.ticked.length) { labourTicks += l.labour.ticked.length; if (l.labour.total != null) labour += l.labour.total; else labourUnknown++; }
      if (l.transport_charge != null && l.qty != null) cardTransportCharge += l.transport_charge * l.qty;
      if (l.transport_cost != null && l.qty != null) cardTransportCost += l.transport_cost * l.qty; });
    /* v5.82 — the accessories that can be priced, on a reference where another cannot, count too: the comparison
       line is then Pricing's resolved subtotal less the labour ticked (it was $447 under it — CP1, P05, T0021) */
    cardHire += (t.lines || []).reduce((s, l) => s + (l.total || 0), 0) + (t.accessories_known || 0); });
  /* the schedule's own TPORT COST column (24 Sep 2026), read as written on the load briefs. v5.83 — it IS what
     Coates pays for those loads (Andrew Fisher, 25 Sep 2026, sending the schedule with its transport costs), so a
     figure on it is counted on the cost side — at the figure written, which is "the figure and more" where the
     workbook puts a plus after it — unless somebody has recorded our own transport line against the same
     reference, in which case that line is the figure and the schedule's is not read twice. A load marked Internal
     is a Coates truck: no carrier charge. A load with no figure is not in yet, and is said to be missing. */
  const OCL = ourCosts().filter(c => c.kind === 'transport' && c.usable);
  const ourRefs = new Set(OCL.filter(c => c.amount != null && c.ref).map(c => c.ref));
  const tRows = live.map(a => ({a, t: transportCostOf(a)})).filter(x => x.t);
  /* v5.85 - THE SAME COLUMN, EVERY ROW WITH A FIGURE. The fencing semis to Phillip Park are held off the Timeline
     and every count as deliveries, but their carrier charge is Coates's: Coates organises the transport, so the
     TPORT COST on those rows is a delivery cost and stays with Coates transport (Andrew Fisher, 25 Sep 2026). The
     loads with no reference carry the same column and the same carrier charge, so they are read the same way.
     Each row once, as written; Internal is still a Coates truck; a row with no figure is still not in. */
  const schedRow = r => { const t = r.transport_cost; if (!t) return null;
    return t.internal ? {amount: null, internal: true, plus: false, as_written: t.as_written}
         : t.amount != null ? {amount: t.amount, internal: false, plus: !!t.plus, as_written: t.as_written} : null; };
  const xFence = (((DATA.plant_lines || {}).fencing_rows_not_plant) || []).map(r => ({a: {key: r.task_id}, t: schedRow(r)})).filter(x => x.t);
  const xUnref = (DATA.unreferenced || []).map(r => ({a: {key: r.task_id}, t: schedRow(r)})).filter(x => x.t);
  xFence.forEach(x => tRows.push(x)); xUnref.forEach(x => tRows.push(x));
  const tcs = tRows.map(x => x.t);
  const tFig = tcs.filter(t => t.amount != null);
  const tCounted = tRows.filter(x => x.t.amount != null && !ourRefs.has(x.a.key));
  const schedT = {amount: cents(tFig.reduce((s, t) => s + t.amount, 0)), refs: tFig.length, plus: tFig.filter(t => t.plus).length, internal: tcs.filter(t => t.internal).length,
                  counted: cents(tCounted.reduce((s, x) => s + x.t.amount, 0)), counted_refs: tCounted.length, by_our_line: tFig.length - tCounted.length,
                  unread: tcs.filter(t => t.amount == null && !t.internal).length};
  schedT.fencing = {rows: xFence.filter(x => x.t.amount != null).length, amount: cents(xFence.reduce((s, x) => s + (x.t.amount || 0), 0))};
  schedT.unref = {rows: xUnref.filter(x => x.t.amount != null).length, amount: cents(xUnref.reduce((s, x) => s + (x.t.amount || 0), 0))};
  /* what else is on the Costs tab as a charge — the fencing dockets are counted on their own line, so they are not read twice */
  const other = allCosts().filter(c => c.usable && c.from !== 'record');
  const otherAmt = sumOf(other, 'amount');
  const OT = R.all.ours.transport;
  const T = trackerFigures(day);
  /* the race weekend is what we charge (Andrew Fisher, 25 Sep 2026): the Pricing tab's event hours at the card's
     hourly rates — typed there, or the tracker's race-day hours of the people charged as each role */
  const EH = eventHoursTotal();
  /* v5.83 — the people over the event are charged by the Coates Event Labour Scope (Andrew Fisher, 25 Sep 2026:
     what currently gets charged to the V8s, editable because it may change) — worked out on the Pricing tab with any
     change a person made; the tracker's own race-day hours are Coates's wages, a cost, hours only */
  const SF = scopeFigures();
  const rq = DATA.rehire_quotes && DATA.rehire_quotes.totals ? cents((DATA.rehire_quotes.totals.sub_totals || 0) + (DATA.rehire_quotes.totals.delivery_and_pickup || 0)) : null;
  /* v5.81 — the rehire quotes are a cost Coates bears once Andrew Fisher says they are approved (24 Sep 2026: all
     approved, the final total may still change — sources/pricing/rehire_toilets/quotes.json, authorisation):
     counted at the quotes' figures ex GST, flagged provisional because the final total may change; before that word
     they were a comparison line only */
  const rqAuth = (DATA.rehire_quotes && DATA.rehire_quotes.authorisation) || null;
  const rqApproved = !!(rq != null && rqAuth && rqAuth.state === 'approved');
  const charge = {contracts: C.charge, contracts_lines: C.charge_lines, contracts_all: C.lines, contracts_unknown: C.unknown, contracts_differs: C.differs.length,
                  differs_charge: C.differs_charge, differs_prebill: C.differs_prebill, subhire: C.subhire.charge, delivery: C.transport.charge,
                  by_branch: R.branches.filter(g => g.contract && g.contract.lines).map(g => ({code: g.code, name: g.name, charge: g.contract.charge, charge0: g.contract.charge0, lines: g.contract.lines, unknown: g.contract.unknown, differs: g.contract.differs.length})),
                  labour: cents(labour), labour_ticks: labourTicks, labour_unknown: labourUnknown,
                  race: SF ? {amount: SF.total, scope: true, people_amount: SF.people, at: SF.at, hours: SF.hours, edits: SF.edits, provisional: SF.provisional,
                              document: SF.document, typed: 0, from_tracker: 0, unpriced_hours: 0, unpriced_people: [], people: T.race.people.size, worked_hours: T.race.hours, days: EVENT_DAYS.slice()}
                           : {amount: EH.total != null ? cents(EH.total) : null, hours: T.race.hours, typed: EH.typed, from_tracker: EH.tracker,
                              unpriced_hours: T.race.unpriced_hours, unpriced_people: T.race.unpriced_people, people: T.race.people.size, days: EVENT_DAYS.slice()},
                  fencing: fd.charged, fencing_dockets: fd.dockets, other: otherAmt, other_lines: other.length,
                  card_hire: cents(cardHire), card_transport: cents(cardTransportCharge)};
  charge.total = cents(charge.contracts + charge.labour + (charge.race.amount || 0) + charge.fencing + charge.other);
  const cost = {race_hours: SF ? T.race.hours : 0, transport: {ours: OT.amount, ours_lines: OT.lines, ours_priced: OT.priced, ours_awaiting: OT.awaiting, schedule: schedT, card_cost: cents(cardTransportCost),
                            amount: cents((OT.amount || 0) + schedT.counted)},
                labour: WF.present ? Object.assign({people: T.people.filter(p => p.hours).length, rule: WF.hours_rule}, T.labour) : null,
                accommodation: WF.present ? T.accommodation : null,
                meals: WF.present ? T.meals : null,
                misc: WF.present ? T.misc : null,
                fencing_paid: fd.cost, fencing_margin: fd.margin, fencing_margin_dockets: fd.margin_dockets,
                /* v5.81 — the green book: what Coates pays Advanced for labour and truck hours, a cost only (Andrew
                   Fisher, 25 Sep 2026) */
                fencing_labour: (() => { const G = greenBookTotals(); return G.notes ? G : null; })(),
                rehire_quoted: rq, rehire_approved: rqApproved, rehire_auth: rqAuth, rehire: rqApproved ? rq : null, subhire_lines: C.subhire.lines};
  cost.known = cents((OT.amount || 0) + schedT.counted + (cost.accommodation ? cost.accommodation.amount : 0) + (cost.meals ? cost.meals.amount : 0) + (cost.misc ? cost.misc.amount : 0) + (fd.cost || 0)
                     + (cost.fencing_labour && cost.fencing_labour.rate != null ? cost.fencing_labour.amount : 0) + (rqApproved ? rq : 0));
  /* what is not in the difference yet — said in full on the page, and in a breath in the email's cap */
  const missing = [], short = [];
  const miss = (l, sh) => { missing.push(l); short.push(sh); };
  miss(cost.labour ? (SF ? `wages — ${fmtNum(Math.round((cost.labour.hours + cost.race_hours) * 10) / 10)} h on the tracker (${fmtNum(cost.labour.hours)} h build and demob, ${fmtNum(cost.race_hours)} h over the race weekend), no wage rate supplied, so hours only`
                           : `labour — ${fmtNum(cost.labour.hours)} h on the tracker outside the race weekend, no wage rate supplied, so hours only`) : 'labour — no tracker read for this build', SF ? 'wages in hours only' : 'labour hours only');
  if (SF) miss('what Coates pays for the people on the event labour scope who are not on the tracker — the fence team of six among them — is not on the record', 'event staff not on the tracker');
  if (charge.race.unpriced_hours) miss(`race weekend — ${fmtNum(charge.race.unpriced_hours)} h by ${charge.race.unpriced_people.join(', ')} with no card role yet, so not priced`, `${fmtNum(charge.race.unpriced_hours)} race-weekend h not priced`);
  if (cost.accommodation && cost.accommodation.unpriced) miss(`accommodation — ${cost.accommodation.unpriced} night${cost.accommodation.unpriced === 1 ? '' : 's'} for ${cost.accommodation.unpriced_for.join(', ')} with no rate yet`, `${cost.accommodation.unpriced} nights unpriced`);
  /* transport: what the schedule's TPORT COST column and our own lines carry is in; the loads with neither are not */
  if (!OT.lines && !schedT.counted) miss('transport — no figure yet: no TPORT COST on the schedule and no line of ours recorded', 'no transport cost yet');
  else miss(`transport — only the loads with a figure are in: ${schedT.counted_refs} load${schedT.counted_refs === 1 ? '' : 's'} from the schedule's TPORT COST column (${money0(schedT.counted)}${schedT.plus ? ', each written with a plus, so at least that' : ''})${OT.lines ? ` and ${OT.priced} line${OT.priced === 1 ? '' : 's'} of ours (${money0(OT.amount)})` : ''}; ${schedT.internal} marked Internal are a Coates truck; the rest of the loads carry no transport figure yet`, 'transport only partly in');
  if (OT.awaiting) miss(`transport — ${OT.awaiting} of our line${OT.awaiting === 1 ? '' : 's'} awaiting a figure`, `${OT.awaiting} transport line${OT.awaiting === 1 ? '' : 's'} awaiting a figure`);
  if (C.subhire.lines) miss(`what Coates pays for the ${C.subhire.lines} subhired line${C.subhire.lines === 1 ? '' : 's'} on the contracts — not on the record`, 'subhire buys not on the record');
  if (rq != null && !rqApproved) miss(`rehire toilets — ${money0(rq)} ex GST quoted by ${DATA.rehire_quotes.supplier.name}, unsigned; a cost only if authorised`, `rehire quote ${money0(rq)} unsigned`);
  /* what is in the figure but still moving — said beside it, never counted as missing */
  const caveats = [];
  const caveats_short = [];
  if (SF && SF.provisional) { caveats.push(`event labour is in at the scope as it stands${SF.edits ? ` with ${SF.edits} change${SF.edits === 1 ? '' : 's'}` : ''} — its access-plan times are still marked to be updated off the 2026 access plan`); caveats_short.push('event labour times still to be updated'); }
  if (rqApproved) { caveats.push(`the rehire toilets are in at the quotes' figures (${money0(rq)}) — approved on ${fmtDay(rqAuth.stated_on).dm}, with the final total still able to change`); caveats_short.push('rehire toilet total not final'); }
  if (C.unknown) miss(`${C.unknown} contract line${C.unknown === 1 ? '' : 's'} with no rate yet on the charge side`, `${C.unknown} contract lines unrated`);
  if (C.differs.length) miss(`${C.differs.length} contract line${C.differs.length === 1 ? '' : 's'} where Baseplan's prebill reads differently — ${money0(C.differs_charge)} by the rule, ${money0(C.differs_prebill)} prebilled`, `${C.differs.length} to settle`);
  if (schedT.counted && schedT.plus) { caveats.push(`the schedule's transport figures are in as written — ${schedT.plus} of them with a plus after the figure, which is the figure and more`); caveats_short.push(`${schedT.plus} transport figures are minimums`); }
  const difference = cents(charge.total - cost.known);
  /* v5.83 — what the page prints: each total rounded once to the dollar, and the difference as the one less the other,
     so the three figures add up as printed; the streams are split to those same printed totals */
  const difference0 = Math.round(charge.total) - Math.round(cost.known);
  const streams = moneyStreams({C, fd, charge, cost, OT, schedT, rq, rqApproved, T});
  const categories = costCategories({cost, fd, rq, rqApproved, OT, schedT, T, C});
  /* what the crew's wages could come to before the difference so far is gone — the difference divided by the
     tracker's hours outside the race weekend; arithmetic on the two figures above, not a rate anybody gave */
  const hrsOut = cost.labour ? Math.round((cost.labour.hours + (cost.race_hours || 0)) * 10) / 10 : 0;
  const breakeven = difference > 0 && hrsOut > 0 ? cents(difference / hrsOut) : null;
  return {as_at: day, charge, cost, difference, difference0, missing, missing_short: short, caveats, caveats_short, streams, categories, breakeven, breakeven_hours: hrsOut,
          servicing: DATA.toilet_servicing || null,
          tracker: WF.present ? {workbook: WF.workbook, supplied_on: WF.supplied_on, supplied_by: WF.supplied_by, period: WF.period} : null};
}
/* v5.83 — BY STREAM. Andrew Fisher, 25 Sep 2026: a cost is what Coates pays; a charge is what Coates bills the V8s,
   and everything on hire is a charge; management read these figures, so they must be presented correctly — and the
   rehire toilets work like the fencing: the V8s are charged at Coates's own rates, the supplier is paid, and what is
   between the two is the margin. So every contract line lands in one stream by what it is, the fencing dockets, the
   race weekend and the labour ticked in theirs, and every known cost in the stream it belongs to. The streams add up
   to the two totals to the cent, so the table and the headline can never disagree; a side nothing is known on says
   so and is never shown as nought. */
const STREAM_OF_KIND = {toilet: 'toilets', building: 'buildings', container: 'buildings', furniture: 'buildings', accessory: 'buildings',
                        vms: 'traffic', barrier: 'traffic', trakmat: 'traffic', forklift: 'plant', 'forklift accessory': 'plant', access: 'plant',
                        generator: 'power', 'lighting tower': 'power'};
const STREAMS = [
  {key: 'fencing', name: 'Fencing', who: 'Advanced Temporary Fencing — charged at the 2026 card, paid at their own sheet'},
  {key: 'toilets', name: 'Toilets and servicing', who: 'Event Portables rehire — charged at our rates, paid to Event Portables'},
  {key: 'buildings', name: 'Buildings, containers and furniture', who: 'our own fleet (KINP)'},
  {key: 'traffic', name: 'VMS, water barriers and track mat', who: 'our own fleet (STPS)'},
  {key: 'plant', name: 'Forklifts and access', who: 'MEAD and NVAC'},
  {key: 'power', name: 'Generators and lighting towers', who: 'NVAC'},
  {key: 'other_hire', name: 'Other hire', who: 'contract lines of another kind'},
  {key: 'transport', name: 'Delivery and transport', who: 'charged on the contracts; paid to the carriers'},
  {key: 'crew', name: 'People — event staff and crew costs', who: 'charged: the Coates Event Labour Scope · paid: the tracker — nights, meals, expenses; wages in hours'},
  {key: 'other', name: 'Other charge lines', who: 'lines given to the build'}];
function moneyStreams(X){
  const cents = n => Math.round(n * 100) / 100;
  const S = new Map(STREAMS.map(s => [s.key, Object.assign({}, s, {charge: 0, charge_known: false, lines: 0, unrated: 0, differs: 0, subhired: 0, cost: 0, cost_known: false, notes: []})]));
  ONHIRE_ROWS.forEach(r => {
    const ch = contractCharge(r);
    const k = r.charge_line && !r.subhired ? 'transport' : (STREAM_OF_KIND[r.kind] || 'other_hire');
    const s = S.get(k); s.lines++;
    if (typeof ch.amount === 'number') { s.charge += ch.amount; s.charge_known = true; } else s.unrated++;
    if (ch.differs) s.differs++;
    if (r.subhired) s.subhired++; });
  const add = (k, v, side) => { const s = S.get(k); if (v == null) return; s[side] += v; s[side + '_known'] = true; };
  add('fencing', X.fd.charged || null, 'charge');
  add('crew', X.charge.race.amount, 'charge');
  if (X.charge.labour_ticks) add('crew', X.charge.labour, 'charge');
  if (X.charge.other_lines) add('other', X.charge.other, 'charge');
  add('fencing', X.fd.cost || null, 'cost');
  if (X.cost.fencing_labour && X.cost.fencing_labour.rate != null) add('fencing', X.cost.fencing_labour.amount, 'cost');
  if (X.rqApproved) add('toilets', X.rq, 'cost');
  if (X.OT.lines || X.schedT.counted) add('transport', cents((X.OT.amount || 0) + X.schedT.counted), 'cost');
  ['accommodation', 'meals', 'misc'].forEach(k => { if (X.cost[k]) add('crew', X.cost[k].amount, 'cost'); });
  /* what each stream is still waiting on, in its own words */
  const pl = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
  S.forEach(s => {
    if (s.unrated) s.notes.push(`${s.unrated} of ${pl(s.lines, 'contract line')} with no rate yet — the charge for ${s.unrated === 1 ? 'it' : 'them'} is missing`);
    if (s.differs) s.notes.push(`${pl(s.differs, 'line')} to settle with the branch`);
    if (s.subhired) s.notes.push(`${pl(s.subhired, 'subhired line')} — what Coates pays for ${s.subhired === 1 ? 'it' : 'them'} is not on the record`); });
  const f = S.get('fencing'); f.notes.unshift(`${pl(X.fd.dockets, 'docket')}${X.cost.fencing_labour ? ` · green-book labour ${hoursTxt(X.cost.fencing_labour.hours)} h` : ''}`);
  const tl = S.get('toilets');
  if (!X.rqApproved && X.rq != null) tl.notes.unshift(`Event Portables quoted ${money0(X.rq)} — unsigned, so not counted`);
  if (X.rqApproved) tl.notes.unshift(`Event Portables ${money0(X.rq)}, approved — the final total may change`);
  const TS = DATA.toilet_servicing;
  if (TS && TS.at_card_total) tl.notes.push(`servicing is on no contract line: the same servicing at our card's pump-out rates would be ${money0(TS.at_card_total)} — not charged yet`);
  const tr = S.get('transport');
  tr.notes.push(X.schedT.counted || X.OT.lines ? `cost: the schedule's TPORT COST figures${X.OT.lines ? ' and our own lines' : ''} — only the loads with a figure${X.schedT.fencing && X.schedT.fencing.rows ? `, the ${X.schedT.fencing.rows} fencing semis to Phillip Park among them (${money0(X.schedT.fencing.amount)}; Coates organises their transport — Andrew Fisher, 25 Sep 2026)` : ''}${X.schedT.unref && X.schedT.unref.rows ? ` and ${X.schedT.unref.rows} load${X.schedT.unref.rows === 1 ? '' : 's'} with no reference (${money0(X.schedT.unref.amount)})` : ''}` : 'cost: no transport figure yet');
  if (X.charge.card_transport) tr.notes.push(`charged: the delivery lines on the contracts; for comparison, the 2026 card's transport charge for the schedule is ${money0(X.charge.card_transport)}`);
  const cr = S.get('crew');
  if (X.charge.race.scope) cr.notes.push(`charged: the event labour scope — ${fmtNum(X.charge.race.hours)} h of people and ${money0(X.charge.race.at)} accommodation and travel${X.charge.race.edits ? ` (${X.charge.race.edits} change${X.charge.race.edits === 1 ? '' : 's'})` : ''}`);
  if (X.cost.labour) cr.notes.push(X.charge.race.scope ? `wages: ${fmtNum(Math.round((X.cost.labour.hours + (X.cost.race_hours || 0)) * 10) / 10)} h on the tracker, no wage rate — hours only` : `wages: ${fmtNum(X.cost.labour.hours)} h outside the race weekend, no wage rate — hours only`);
  if (!X.charge.race.scope && X.charge.race.amount == null && X.charge.race.hours) cr.notes.push(`race weekend: ${fmtNum(X.charge.race.hours)} h, not priced until each person has a card role`);
  if (X.cost.accommodation && X.cost.accommodation.unpriced) cr.notes.push(`${pl(X.cost.accommodation.unpriced, 'night')} with no rate yet`);
  const out = [...S.values()].filter(s => s.lines || s.charge_known || s.cost_known || ['fencing', 'toilets', 'transport', 'crew'].includes(s.key))
    .map(s => Object.assign(s, {charge: cents(s.charge), cost: cents(s.cost), difference: (s.charge_known || s.cost_known) ? cents(s.charge - s.cost) : null}));
  /* the columns as printed: each split to the dollar so the rows add to the totals printed under them, and each
     row's difference is its charge less its cost as printed — the table adds up across and down */
  const c0 = dollarSplit(out.map(s => s.charge_known ? s.charge : 0), X.charge.total), k0 = dollarSplit(out.map(s => s.cost_known ? s.cost : 0), X.cost.known);
  out.forEach((s, i) => { s.charge0 = c0[i]; s.cost0 = k0[i]; s.difference0 = (s.charge_known || s.cost_known) ? c0[i] - k0[i] : null; });
  return out;
}
/* v5.83 — WHAT COATES PAYS, BY THE EIGHT CATEGORIES management expect every cost recorded against
   (print/sources/cost_categories.json, as written). Each known cost goes to the category it is: the tracker's hours
   by employer — Coates's own people are internal labour, a labour-hire firm's are an external contractor's — hours
   only while no wage rate is given; the Event Portables rehire and the subhired contract lines under rehire; the
   tracker's equipment repairs under equipment; Advanced (their sheet and the green book) under fencing; nights,
   meals, the other expenses and the transport Coates pays under other event-related expenses. The dollars add up to
   the known cost to the cent. A category nothing is known in says so. */
function costCategories(X){
  const cents = n => Math.round(n * 100) / 100;
  const key = c => /internal labour/i.test(c) ? 'internal' : /external contractor/i.test(c) ? 'external' : /rehire/i.test(c) ? 'rehire'
    : /equipment/i.test(c) ? 'equipment' : /fencing/i.test(c) ? 'fencing' : /installation/i.test(c) ? 'installation'
    : /buy invoicing|branch/i.test(c) ? 'branch' : /other/i.test(c) ? 'other' : null;
  const cats = COST_CATS.map(c => ({category: c, key: key(c), amount: 0, known: false, hours: null, parts: []}));
  const at = k => cats.find(c => c.key === k);
  const put = (k, amount, words) => { const c = at(k); if (!c) return; if (amount != null) { c.amount += amount; c.known = true; } c.parts.push(words); };
  const T = X.T;
  const internal = e => /coates/i.test(e || '');
  /* v5.83 — with the event labour scope charging the people over the event, the tracker's race-day hours are wages
     like the rest: counted here, in hours, beside the build and demob hours */
  const withRace = !!X.cost.race_hours;
  const band = list => list.reduce((b, p) => ({hours: b.hours + (p.hours || 0) + (withRace ? (p.race || 0) : 0), race: b.race + (withRace ? (p.race || 0) : 0), ordinary: b.ordinary + (p.ordinary || 0), at_1_5: b.at_1_5 + (p.at_1_5 || 0), at_2: b.at_2 + (p.at_2 || 0)}), {hours: 0, race: 0, ordinary: 0, at_1_5: 0, at_2: 0});
  const worked = p => (p.hours || 0) + (withRace ? (p.race || 0) : 0);
  const inP = T.people.filter(p => worked(p) && internal(p.employer)), exP = T.people.filter(p => worked(p) && !internal(p.employer));
  const bi = band(inP), be = band(exP);
  const r1 = n => Math.round(n * 10) / 10;
  if (inP.length) { const c = at('internal'); if (c) { c.hours = r1(bi.hours); c.parts.push(`${fmtNum(r1(bi.hours))} h by ${inP.map(p => p.name).join(', ')} — build and demob ${fmtNum(r1(bi.ordinary))} ordinary, ${fmtNum(r1(bi.at_1_5))} at ×1.5, ${fmtNum(r1(bi.at_2))} at ×2${bi.race ? `, and ${fmtNum(r1(bi.race))} over the race weekend` : ''}; no wage rate given, so hours only`); } }
  if (exP.length) { const c = at('external'); if (c) { c.hours = r1(be.hours); const emp = [...new Set(exP.map(p => p.employer || 'employer not stated'))].join(', '); c.parts.push(`${fmtNum(r1(be.hours))} h by ${exP.map(p => p.name).join(', ')} (${emp})${be.race ? `, ${fmtNum(r1(be.race))} of them over the race weekend` : ''} — no hourly rate given, so hours only`); } }
  if (X.rqApproved) put('rehire', X.rq, `Event Portables, four quotes approved — ${money0(X.rq)} ex GST, the final total may change`);
  else if (X.rq != null) put('rehire', null, `Event Portables quoted ${money0(X.rq)} — unsigned, so not counted`);
  if (X.C.subhire.lines) put('rehire', null, `${X.C.subhire.lines} subhired contract line${X.C.subhire.lines === 1 ? '' : 's'} — what Coates pays for them is not on the record`);
  const misc = (T.lines || []).filter(c => c.kind === 'misc' && c.usable && c.amount != null);
  const isEquip = m => /equip|generator|fuel|r&m|repair/i.test(m.type || '');
  const eq = cents(misc.filter(isEquip).reduce((s, m) => s + m.amount, 0)), mo = cents(misc.filter(m => !isEquip(m)).reduce((s, m) => s + m.amount, 0));
  if (eq) put('equipment', eq, `the tracker's equipment lines (${[...new Set(misc.filter(isEquip).map(m => m.type))].join(', ')}) — ${money(eq)}`);
  if (X.fd.cost) put('fencing', X.fd.cost, `Advanced, paid at their own sheet — ${money(X.fd.cost)}`);
  if (X.cost.fencing_labour && X.cost.fencing_labour.rate != null) put('fencing', X.cost.fencing_labour.amount, `the green book, Advanced's labour and truck hours — ${hoursTxt(X.cost.fencing_labour.hours)} h × ${money(X.cost.fencing_labour.rate)} = ${money(X.cost.fencing_labour.amount)}`);
  if (X.cost.accommodation) put('other', X.cost.accommodation.amount, `accommodation — ${money(X.cost.accommodation.amount)} for ${X.cost.accommodation.nights - X.cost.accommodation.unpriced} nights${X.cost.accommodation.unpriced ? ` (${X.cost.accommodation.unpriced} more with no rate yet)` : ''}`);
  if (X.cost.meals) put('other', X.cost.meals.amount, `meals away from home — ${money(X.cost.meals.amount)}`);
  if (mo) put('other', mo, `other expenses on the tracker (${[...new Set(misc.filter(m => !isEquip(m)).map(m => m.type || 'untyped'))].join(', ')}) — ${money(mo)}`);
  const tr = cents((X.OT.amount || 0) + X.schedT.counted);
  if (X.OT.lines || X.schedT.counted) put('other', tr, `transport Coates pays — ${money(tr)}: the schedule's TPORT COST figures${X.OT.lines ? ' and our own lines' : ''}, only the loads with a figure`);
  else put('other', null, 'transport Coates pays — no figure yet');
  cats.forEach(c => { c.amount = cents(c.amount); if (!c.parts.length && c.key === 'installation') c.parts.push('the crew\'s installation hours are under internal labour'); });
  return cats;
}
/* v5.83 — what Coates pays, under the eight categories management expect every cost recorded against, as the
   expectation words them (print/sources/cost_categories.json); what each holds comes from costCategories() and
   the dollars add up to the known cost on the card above */
function costCategoryCard(expect){
  const M = moneySummary();
  const cats = M.categories || [];
  const hrs = Math.round(cats.reduce((s, c) => s + (c.hours || 0), 0) * 10) / 10;
  return `<div class="card" id="costCats">
    <div class="notice info"><b>Management's expectation, as written</b>${esc((expect || {}).expectation_as_written || 'The expectation is that all costs are allocated and recorded against the correct categories, including:')}
      ${COST_CATS.map(c => esc(c)).join('; ')}. <span class="w" style="color:var(--mute)">${esc((expect || {}).authority || '')}</span></div>
    <div class="paycats">${cats.map(c => `<div class="paycat${c.known ? '' : c.hours ? ' hrs' : ' none'}" data-cat="${esc(c.key || '')}">
        <span class="pc-name">${esc(c.category)}</span>
        <span class="pc-amt">${c.known ? esc(money(c.amount)) : c.hours ? esc(fmtNum(c.hours)) + ' h' : '<span class="todo">nothing recorded</span>'}${c.known && c.hours ? ` <small>+ ${esc(fmtNum(c.hours))} h</small>` : ''}</span>
        <span class="pc-sub">${esc(c.parts.join(' · '))}</span></div>`).join('')}</div>
    <div class="paytot"><span>Coates pays — known, across the eight</span><b>${esc(money(M.cost.known))}</b>
      <span class="w">${hrs ? `and ${esc(fmtNum(hrs))} h of wages on the tracker with no rate, so not in dollars` : ''}</span></div>
  </div>`;
}
/* the summary card at the head of the Costs tab — the three figures, the streams, the verdict, then the two sides;
   the working under More info. v5.83 — laid out for management (Andrew Fisher, 25 Sep 2026): a charge is what Coates
   bills the V8s, a cost is what Coates pays, and every stream reads the same way the fencing does — what we charge,
   what Coates pays, the difference — adding up to the three figures above it. */
function marginCard(){
  const M = moneySummary();
  const c = M.charge, k = M.cost;
  const ln = (label, amt, sub, cls) => `<div class="ln${cls ? ' ' + cls : ''}"><span class="lb">${label}${sub ? `<small>${sub}</small>` : ''}</span><span class="amt">${amt}</span></div>`;
  const m0 = v => v == null ? '<span class="todo">—</span>' : esc(money0(v));
  const sd = v => v == null ? '<span class="todo">—</span>' : `<b class="${v < 0 ? 'neg' : 'pos'}">${v < 0 ? '−' + esc(money0(-v)) : esc(money0(v))}</b>`;
  const hrs = k.labour;
  const pl = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
  const TS = M.servicing;
  return `<div class="card money nosfold" id="moneyCard">
    <div class="hubtitle"><h3>Are we making money?</h3>
      <span class="w" style="font-size:12px;color:var(--mute)">as at ${esc(fmtDate(M.as_at))} · AUD ex GST</span></div>
    <p class="hint moneydef">A <b>charge</b> is what Coates bills the V8s — everything on hire is a charge. A <b>cost</b> is what Coates pays. The two are never added together (Andrew Fisher, 25 Sep 2026).</p>
    <div class="kpis" style="margin-top:10px">
      <div class="kpi"><div class="v">${m0(c.total)}</div><div class="l">We charge the V8s</div></div>
      <div class="kpi"><div class="v">${m0(k.known)}</div><div class="l">Coates pays — known so far</div></div>
      <div class="kpi ${M.difference0 < 0 ? 'alert' : ''}"><div class="v">${m0(M.difference0)}</div><div class="l">Difference so far</div></div>
      <div class="kpi alert"><div class="v">${M.missing.length}</div><div class="l">Not in it yet</div></div>
    </div>
    <div class="tblwrap streamwrap"><table class="streamtbl"><thead><tr><th>Stream</th><th class="num">We charge</th><th class="num">Coates pays</th><th class="num">Difference</th><th>Still to come</th></tr></thead>
      <tbody>${M.streams.map(s => `<tr data-stream="${esc(s.key)}"><td><b>${esc(s.name)}</b><br><span class="w">${esc(s.who)}</span></td>
        <td class="num" data-l="We charge">${s.charge_known ? m0(s.charge0) : '<span class="todo">—</span>'}</td>
        <td class="num" data-l="Coates pays">${s.cost_known ? m0(s.cost0) : '<span class="todo">—</span>'}</td>
        <td class="num" data-l="Difference">${s.cost_known ? sd(s.difference0) : `<span class="w" title="no cost is set against this stream yet — its wages and transport are counted in their own streams">${s.charge_known ? esc(money0(s.charge0)) : '—'}<br><small>before costs</small></span>`}</td>
        <td class="stnote">${esc(s.notes.join(' · '))}</td></tr>`).join('')}
      <tr class="total"><td><b>Total</b></td><td class="num" data-l="We charge"><b>${m0(c.total)}</b></td><td class="num" data-l="Coates pays"><b>${m0(k.known)}</b></td><td class="num" data-l="Difference">${sd(M.difference0)}</td><td class="stnote">not a margin yet — ${esc(M.missing_short.join(' · '))}</td></tr></tbody></table></div>
    <p class="hint roundnote" style="margin:4px 0 0;font-size:11px;color:var(--mute)">Dollars rounded so every column adds to its total and every row across; what Coates pays under the eight categories, below, is to the cent.</p>
    <div class="verdict ${M.difference0 < 0 ? 'neg' : ''}"><b>${esc(money0(c.total))} charged against ${esc(money0(k.known))} of known cost — ${M.difference0 < 0 ? esc(money0(-M.difference0)) + ' behind' : esc(money0(M.difference0)) + ' ahead'} so far.</b> Not a margin yet — ${pl(M.missing.length, 'thing')} not in it.${M.breakeven != null ? ` The biggest is the crew's wages: ${esc(fmtNum(M.breakeven_hours))} h on the tracker with no wage rate, and the difference so far covers them only up to ${esc(money(M.breakeven))} an hour on average.` : ''}</div>
    <div class="ledger">
      <div class="side"><h4>We charge the V8s <small>Coates → the V8s</small></h4>
        ${ln('On the contracts, by the rate', m0(c.contracts), `${c.contracts_lines} of ${c.contracts_all} lines${c.contracts_unknown ? ` · ${c.contracts_unknown} no rate` : ''}${c.contracts_differs ? ` · ${c.contracts_differs} to settle` : ''}`)}
        ${c.race.scope ? ln('Event labour — the scope', m0(c.race.amount), `${esc(fmtNum(c.race.hours))} h of people ${esc(money0(c.race.people_amount))} + accommodation and travel ${esc(money0(c.race.at))}${c.race.edits ? ` · ${pl(c.race.edits, 'change')}` : ''}`)
          : ln('Labour over the race weekend', c.race.amount != null ? m0(c.race.amount) : '<span class="todo">—</span>', c.race.hours ? `${esc(fmtNum(c.race.hours))} h on ${esc(c.race.days.map(d => fmtDay(d).dm).join(', '))}${c.race.unpriced_hours ? ` · ${esc(fmtNum(c.race.unpriced_hours))} h need a card role` : ' · by the hour'}` : (c.race.amount != null ? 'typed on the Pricing tab' : 'no race-day hours yet'))}
        ${ln('Labour ticked on references', c.labour_ticks ? m0(c.labour) : '<span class="todo">—</span>', c.labour_ticks ? pl(c.labour_ticks, 'tick') : 'nothing ticked yet')}
        ${ln('Fencing — dockets at the 2026 card', c.fencing ? m0(c.fencing) : '<span class="todo">—</span>', pl(c.fencing_dockets, 'docket'))}
        ${c.other_lines ? ln('Other charge lines', m0(c.other), pl(c.other_lines, 'line')) : ''}
        ${ln('We charge the V8s', m0(c.total), '', 'total')}
      </div>
      <div class="side"><h4>Coates pays <small>our own costs — kept apart</small></h4>
        ${ln('Transport', k.transport.schedule.counted || k.transport.ours_lines ? m0(k.transport.amount) : '<span class="todo">—</span>', k.transport.schedule.counted || k.transport.ours_lines ? `${k.transport.schedule.counted ? `the schedule's TPORT COST on ${pl(k.transport.schedule.counted_refs, 'load')}${k.transport.schedule.plus ? ', each with a plus' : ''}` : ''}${k.transport.ours_lines ? `${k.transport.schedule.counted ? ' · ' : ''}${pl(k.transport.ours_priced, 'line')} of ours${k.transport.ours_awaiting ? ` (${k.transport.ours_awaiting} awaiting a figure)` : ''}` : ''} · the other loads not yet` : 'none recorded yet')}
        ${ln('Labour — build and demob', hrs ? `${esc(fmtNum(hrs.hours))} h` : '<span class="todo">—</span>', hrs ? 'hours only — no wage rate' : 'no tracker read')}
        ${k.race_hours ? ln('Labour — race weekend', `${esc(fmtNum(k.race_hours))} h`, 'the tracker\'s race days — wages, hours only; charged through the scope') : ''}
        ${ln('Accommodation', k.accommodation ? m0(k.accommodation.amount) : '<span class="todo">—</span>', k.accommodation ? `${pl(k.accommodation.nights, 'night')}${k.accommodation.unpriced ? ` · ${k.accommodation.unpriced} with no rate yet` : ''}` : '')}
        ${ln('Meals away from home', k.meals ? m0(k.meals.amount) : '<span class="todo">—</span>', k.meals ? `${pl(k.meals.lines, 'line')}${k.meals.awaiting ? ` · ${k.meals.awaiting} awaiting` : ''}` : '')}
        ${ln('Misc and other expenses', k.misc ? m0(k.misc.amount) : '<span class="todo">—</span>', k.misc ? `${pl(k.misc.lines, 'line')}${k.misc.awaiting ? ` · ${k.misc.awaiting} awaiting` : ''}` : '')}
        ${ln('Fencing — paid to the contractor', k.fencing_paid ? m0(k.fencing_paid) : '<span class="todo">—</span>', "the crew's own sheet")}
        ${k.fencing_labour ? ln('Fencing labour — the green book', k.fencing_labour.rate != null ? m0(k.fencing_labour.amount) : '<span class="todo">no rate</span>', `${esc(hoursTxt(k.fencing_labour.hours))} h on ${pl(k.fencing_labour.notes, 'service note')}${k.fencing_labour.rate != null ? ` × ${esc(money(k.fencing_labour.rate))}` : ''} · what we pay Advanced`) : ''}
        ${k.rehire_approved ? ln('Rehire toilets — approved', m0(k.rehire), `${esc(DATA.rehire_quotes.supplier.name)} · <b>provisional, the final total may change</b>`) : ''}
        ${ln('Coates pays — known', m0(k.known), '', 'total')}
        ${k.rehire_quoted != null && !k.rehire_approved ? ln('Rehire toilets — quoted, unsigned', m0(k.rehire_quoted), 'a cost only if authorised; not added', 'faint') : ''}
        ${k.subhire_lines ? ln('Subhire buys', '<span class="todo">not on the record</span>', `for the ${pl(k.subhire_lines, 'subhired contract line')}`, 'faint') : ''}
      </div>
    </div>
    ${moreInfo('costs|ledger', `<p class="hint"><b>Not in it yet:</b> ${esc(M.missing.join('; '))}.${M.caveats.length ? ` <b>Provisional in the figure:</b> ${esc(M.caveats.join('; '))}.` : ''}</p>
      ${TS && TS.lines && TS.lines.length ? `<p class="hint"><b>The toilet servicing, at our rates.</b> The rehire toilets are charged like the fencing — at Coates's own rates, as if the gear were ours, with Event Portables paid for it (Andrew Fisher, 25 Sep 2026). The hire is on the contracts at the card's own hire rate; the servicing is on no contract line. The same servicing at the street card's pump-out rates: ${esc(TS.lines.map(l => `${fmtNum(l.qty)} × ${l.description} (theirs ${money(l.their_rate)}) at the card's ${l.card_line} ${money(l.card_rate)} = ${money(l.at_card)}`).join('; '))} — ${esc(money0(TS.at_card_total))} in all, against ${esc(money0(TS.their_total))} Event Portables charge for the same three. ${TS.not_on_the_card && TS.not_on_the_card.length ? `${esc(TS.not_on_the_card.map(l => l.description).join(', '))} have no line on the card and are not priced here. ` : ''}A comparison only — never added, because it is on no contract and no invoice.</p>` : ''}
      <p class="hint"><b>The contracts by branch:</b> ${esc(c.by_branch.map(b => `${b.code} ${money0(b.charge0) || '—'}`).join(' · '))}${c.subhire ? ` · including subhired ${esc(money0(c.subhire))}` : ''}${c.delivery ? ` · delivery ${esc(money0(c.delivery))}` : ''}. Rate 1 as the whole-event bill, or a day rate from when it went in for VMS, forklifts and water barriers — by the rate, never by the prebill amount (Andrew Fisher, 24 Sep 2026). For comparison only, never added: the Pricing tab's 2026 street card prices the schedule's hire at ${esc(money0(c.card_hire))} and its transport at ${esc(money0(c.card_transport))} — an estimate from the schedule, not the bill.</p>
      ${c.race.scope ? `<p class="hint"><b>Event labour</b> is charged by ${esc(c.race.document)} — what currently gets charged to the V8s for people over the event (Andrew Fisher, 25 Sep 2026): ${esc(fmtNum(c.race.hours))} h of people on ${esc(c.race.days.map(d => fmtDay(d).dm).join(', '))} and the entertainment nights, ${esc(money0(c.race.people_amount))}, and accommodation and travel, ${esc(money0(c.race.at))} — worked out and changed on the Pricing tab. The tracker's ${esc(fmtNum(c.race.worked_hours || 0))} h on the race days are counted with the wages, in hours only — the scope, not those hours, is what is charged.</p>` : ''}
      ${c.race.scope ? '' : `<p class="hint"><b>The race weekend</b> (${esc(c.race.days.map(d => fmtDate(d)).join(', '))}) is what we charge, not our cost (Andrew Fisher, 25 Sep 2026): the tracker's hours on those days at the card's hourly event rates, by the role each person is charged as — set under People below; an hour typed on the Pricing tab's event card wins for its day and role.${(() => { const rs = ((DATA.charge_basis || {}).labour_hourly || {}).rates_stated; return rs ? ` Flat — no weekend loading (${esc(rs.by)}, ${esc(fmtDate(rs.on))}); the ×1.5 and ×2 of the hours rule band the build and demob hours on our side only.` : ''; })()} ${c.race.amount != null ? `${esc(money0(c.race.amount))} priced` : 'Nothing priced yet'}${c.race.unpriced_hours ? `; ${esc(fmtNum(c.race.unpriced_hours))} h by ${esc(c.race.unpriced_people.join(', '))} have no role yet` : ''}.</p>`}
      ${hrs ? `<p class="hint"><b>Labour outside the race weekend:</b> ${esc(fmtNum(hrs.hours))} h — ${esc(fmtNum(hrs.to_date))} h worked to ${esc(fmtDay(M.as_at).dm)}, ${esc(fmtNum(hrs.planned))} h planned · ${esc(fmtNum(hrs.ordinary))} h ordinary, ${esc(fmtNum(hrs.at_1_5))} h at ×1.5, ${esc(fmtNum(hrs.at_2))} h at ×2 · ${esc(Object.entries(hrs.by_employer).map(([e, v]) => `${e} ${fmtNum(v.hours)} h`).join(' · '))}. No wage rate was supplied, so no dollar is put on an hour (Andrew Fisher, 24 Sep 2026: hours only).${M.breakeven != null ? ` For scale only: the difference so far divided by these hours is ${esc(money(M.breakeven))} an hour — arithmetic on the two figures, not a rate anybody gave.` : ''}</p>` : ''}
      <p class="hint"><b>Transport:</b> ${k.transport.schedule.refs ? `the schedule's TPORT COST column reads ${esc(money0(k.transport.schedule.amount))} on ${pl(k.transport.schedule.refs, 'reference')}${k.transport.schedule.plus ? ` (${k.transport.schedule.plus} with a plus)` : ''} — what Coates pays for those loads, so it is counted${k.transport.schedule.by_our_line ? ` (${k.transport.schedule.by_our_line} of them replaced by our own line for the same reference)` : ''}; ${k.transport.schedule.internal} marked Internal are a Coates truck, no carrier charge` : 'the schedule carries no TPORT COST figure'}${k.transport.card_cost ? `; the card's transport cost to Coates on its lines, ${esc(money0(k.transport.card_cost))}, is a comparison only, never added` : ''}.</p>
      <p class="hint">The cost side is Andrew Fisher's labour, accommodation, meals and expense tracker${M.tracker ? ` (<span class="mono">${esc(M.tracker.workbook)}</span>, ${esc(fmtDate(M.tracker.supplied_on))})` : ''} as changed on this page, the schedule's transport costs and the transport lines people record here, what fencing is paid at the crew's sheet${k.fencing_labour ? ", Advanced's labour and truck hours on the green book at their Labour rate (a cost only — the V8s pay for it inside the fencing installation rates; Andrew Fisher, 25 Sep 2026)" : ''}${k.rehire_approved ? ' and the approved rehire quotes' : ''}. A date still to come is a plan, not a cost incurred. Nothing on either side is estimated, and the two are never added across.</p>`)}
  </div>`;
}
/* ------------------------------------------------------------------ our lines on the page
   One card per kind of line: the lines, Change and Remove on each, and a form a named person adds or changes one
   with. Transport keeps the ids it has always had (#ourTransport, #ourForm, #ourSave, #ourCancel, #ourDateSay). */
function ourIds(kind){
  return kind === 'transport' ? {card: 'ourTransport', form: 'ourForm', save: 'ourSave', cancel: 'ourCancel', say: 'ourDateSay'}
    : {card: 'our-' + kind, form: 'ourForm-' + kind, save: 'ourSave-' + kind, cancel: 'ourCancel-' + kind, say: 'ourDateSay-' + kind};
}
function ourCell(c, col){
  const K = OUR_KIND[c.kind];
  switch (col) {
    case 'date': return `<span style="white-space:nowrap" title="${esc(c.id)}">${esc(c.date ? fmtDay(c.date).dow + ' ' + fmtDay(c.date).dm : '—')}</span>${EVENT_DAYS.includes(c.date) && c.kind === 'labour' ? ' <span class="chip act" title="a race day — these hours are charged, not a cost">race day</span>' : ''}${c.kind === 'transport' || c.kind === 'misc' ? `<br><span class="mono" style="font-size:11px;color:var(--mute)">${esc(c.id)}</span>` : ''}`;
    case 'branch': return c.branch ? `<span class="chip ref mono" title="${esc(branchWords(c.branch))}">${esc(c.branch)}</span>` : '<span class="todo" title="no branch code on the line">no branch</span>';
    case 'ref': return c.ref ? (assetDeleted(c.ref) ? `<b>${esc(c.ref)}</b>` : `<button class="linkish" data-open="${esc(c.ref)}"><b>${esc(c.ref)}</b></button>`) : '<span class="w" style="color:var(--mute)">the job</span>';
    case 'carrier': return c.carrier ? esc(c.carrier) : '<span class="todo">—</span>';
    case 'route': return c.route_from || c.route_to ? `${esc(c.route_from || '?')} → ${esc(c.route_to || '?')}` : '<span class="todo">—</span>';
    case 'person': return c.person ? `<b>${esc(c.person)}</b>` : '<span class="todo">—</span>';
    case 'shift': return `${c.start && c.finish ? esc(c.start + '–' + c.finish) : '<span class="todo">—</span>'}${c.break_min ? ` <span class="w" style="color:var(--mute)">· ${esc(String(c.break_min))} min break</span>` : ''}`;
    case 'hours': return c.hours != null ? `<b>${esc(fmtNum(c.hours))}</b> h` : '<span class="chip crit">no hours</span>';
    case 'what': return `${esc(c.description || (c.type || ''))}${c.supplier ? ` <span class="w" style="color:var(--mute)">· ${esc(c.supplier)}</span>` : ''}${c.who ? ` <span class="w" style="color:var(--mute)">· ${esc(c.who)}</span>` : ''}${c.hotel ? esc(c.hotel) : ''}${c.note ? '<br><span class="w" style="font-size:12px;color:var(--mute)">' + esc(c.note) + '</span>' : ''}${c.problems && c.problems.length ? '<br><span class="chip crit" title="' + esc(c.problems.join('; ')) + '">incomplete</span>' : ''}`;
    case 'type': return c.type ? `<span class="chip">${esc(c.type)}</span>` : '<span class="todo">—</span>';
    case 'amount': return c.amount != null ? `<b>${esc(money(c.amount))}</b>${c.rate_from === 'person' ? `<br><span class="w" style="font-size:11px;color:var(--mute)">the person's rate</span>` : ''}` : `<span class="chip cand" title="no figure yet — add it when it is known">${c.kind === 'accommodation' ? 'no rate yet' : 'awaiting a figure'}</span>`;
    case 'reference': return c.reference ? '<span class="mono">' + esc(c.reference) + '</span>' : '<span class="todo">—</span>';
    case 'recorded': return c._where === 'tracker' ? `<span class="w" style="color:var(--mute)" title="as the tracker has it — change it here and the change travels">as supplied</span>`
      : `${esc(c.updated_by || c.recorded_by || 'unnamed')}<br>${whereChip(c._where)}${c.updated_at ? '<br><span class="w" style="color:var(--mute)">' + esc(fmtStamp(c.updated_at)) + '</span>' : ''}`;
  }
  return '';
}
const OUR_COLS = {
  transport: [['date', 'Date'], ['branch', 'Branch'], ['ref', 'Ref · load'], ['carrier', 'Carrier'], ['route', 'From → to'], ['what', 'What moved'], ['amount', 'Cost ex GST', 'num'], ['reference', 'Docket · invoice'], ['recorded', 'Recorded']],
  labour: [['date', 'Day'], ['person', 'Person'], ['shift', 'Start–finish'], ['hours', 'Hours', 'num'], ['what', 'Note'], ['recorded', 'Recorded']],
  accommodation: [['date', 'Night of'], ['person', 'Person'], ['amount', 'Rate ex GST', 'num'], ['what', 'Hotel · note'], ['recorded', 'Recorded']],
  meals: [['date', 'Day'], ['person', 'Person'], ['amount', 'Amount ex GST', 'num'], ['what', 'Note'], ['recorded', 'Recorded']],
  misc: [['date', 'Day'], ['type', 'Type'], ['what', 'What'], ['amount', 'Amount ex GST', 'num'], ['reference', 'Receipt'], ['recorded', 'Recorded']],
};
function ourField(K, fd, ed, ids){
  const v = ed && ed[fd.name] != null ? ed[fd.name] : '';
  const T = trackerFigures();
  const opts = list => list.map(x => `<option value="${esc(x)}">`).join('');
  const known = f => [...new Set(ourCosts().map(c => c[f]).filter(Boolean))].sort();
  let input;
  if (fd.type === 'date') input = `<input type="date" name="${fd.name}" value="${esc(v)}"${fd.req ? ' required' : ''}><span class="w oursay" ${K.key === 'transport' ? 'id="ourDateSay"' : 'id="' + ids.say + '"'} style="text-transform:none;letter-spacing:0;color:var(--ink)">${v ? esc(fmtDate(v)) : ''}</span>`;
  else if (fd.type === 'branch') input = `<select name="branch"><option value="">— none —</option>${branchOptions().replace(`value="${esc(v)}"`, `value="${esc(v)}" selected`)}</select>`;
  else if (fd.type === 'ref') input = `<input name="ref" list="ourRefs" value="${esc(v)}" placeholder="${esc(fd.ph || '')}"><datalist id="ourRefs">${opts(allAssets().filter(a => !a._cancelled).map(a => a.key).sort())}</datalist>`;
  else if (fd.type === 'person') input = `<input name="person" list="ourPeople-${K.key}" value="${esc(v)}" placeholder="who"><datalist id="ourPeople-${K.key}">${opts(T.people.map(p => p.name))}</datalist>`;
  else if (fd.type === 'role') input = `<select name="charged_as"><option value="">— not charged by the hour —</option>${eventRoles().map(r => `<option value="${esc(r.role)}"${v === r.role ? ' selected' : ''}>${esc(r.role)} · ${esc(money(r.rate))}</option>`).join('')}</select>`;
  else if (fd.type === 'select') input = `<select name="${fd.name}"><option value="">—</option>${fd.options.map(o => `<option${v === o ? ' selected' : ''}>${esc(o)}</option>`).join('')}</select>`;
  else if (fd.type === 'time') input = `<input type="time" name="${fd.name}" value="${esc(v)}">`;
  else if (fd.type === 'money' || fd.type === 'number') input = `<input name="${fd.name}" inputmode="decimal" value="${v === '' ? '' : esc(String(v))}" placeholder="${esc(fd.ph || '')}">`;
  else input = `<input name="${fd.name}"${fd.list ? ` list="ourList-${K.key}-${fd.name}"` : ''} value="${esc(v)}" placeholder="${esc(fd.ph || '')}">${fd.list ? `<datalist id="ourList-${K.key}-${fd.name}">${opts(known(fd.name))}</datalist>` : ''}`;
  return `<label${fd.wide ? ' class="wide"' : ''}>${esc(fd.label)}${input}</label>`;
}
function ourKindCard(kind, opts){
  const o = opts || {}, K = OUR_KIND[kind], ids = ourIds(kind);
  const list = ourCosts().filter(c => c.kind === kind);
  const T = ourTotals(list);
  const edRaw = state.ourEdit ? ourCostOf(state.ourEdit) : null, ed = edRaw && edRaw.kind === kind ? edRaw : null;
  const ro = capability() !== 'edit';
  const cols = OUR_COLS[kind];
  const table = `<div class="tblwrap"><table class="ledgertbl"><thead><tr>${cols.map(([k, h, cls]) => `<th${cls ? ` class="${cls}"` : ''}>${esc(h)}</th>`).join('')}<th></th></tr></thead>
    <tbody>${list.length ? list.map(c => `<tr class="${c.usable ? '' : 'stop'}${ed && ed.id === c.id ? ' editing' : ''}">${cols.map(([k, h, cls]) => `<td${cls ? ` class="${cls}"` : ''}>${ourCell(c, k)}</td>`).join('')}
      <td><div class="acts">${ro ? '' : `<button class="btn tiny" data-ourEdit="${esc(c.id)}">Change</button><button class="btn tiny" data-ourDel="${esc(c.id)}" title="take this line off the record — the removal travels to every copy">Remove</button>`}${K.money && kind !== 'accommodation' ? `<a class="btn tiny" href="${ourCostMailto(c)}">Email</a>` : ''}</div></td></tr>`).join('')
      : `<tr><td colspan="${cols.length + 1}" class="empty">${esc(o.empty || 'Nothing recorded yet.')}${ro ? '' : ' Add the first line below.'}</td></tr>`}</tbody>
    ${K.money && T.priced > 1 ? `<tfoot><tr class="total"><td colspan="${cols.findIndex(x => x[0] === 'amount')}"><b>Total of the ${T.priced} priced lines</b>${T.awaiting ? ` <span class="w" style="color:var(--mute)">· ${T.awaiting} awaiting a figure, not in it</span>` : ''}</td><td class="num"><b>${esc(money(T.amount))}</b></td><td colspan="${cols.length - cols.findIndex(x => x[0] === 'amount')}"></td></tr></tfoot>` : ''}</table></div>`;
  const form = ro ? '' : `<form class="ourform" id="${ids.form}" data-kind="${kind}" autocomplete="off">
      <div class="hd">${ed ? `Changing <b class="mono">${esc(ed.id)}</b>` : `Add ${K.key === 'misc' ? 'an' : 'a'} ${esc(K.label.toLowerCase())}${K.key === 'transport' ? ' cost of ours' : ''}`} <span class="w" style="font-weight:400;color:var(--mute)">· recorded as ${esc((S.operator || '').trim() || 'nobody yet — put your name in Recording as')}</span></div>
      <div class="grid">${K.fields.map(fd => ourField(K, fd, ed, ids)).join('')}</div>
      <div class="acts"><button type="submit" class="btn primary" id="${ids.save}">${ed ? 'Save the change' : 'Add the line'}</button>${ed ? `<button type="button" class="btn" id="${ids.cancel}">Cancel</button>` : ''}</div>
    </form>`;
  return {list, T, table, form, ed};
}
/* the transport we pay for — its own card, with the branch on every line */
function ourTransportCard(){
  const X = ourKindCard('transport', {empty: 'No transport cost of ours recorded yet.'});
  const byB = ourByBranch(X.list), T = X.T;
  return `<div class="card nosfold" id="ourTransport">
    <div class="hubtitle"><h3>Transport — our costs <span class="chip ref">${X.list.length}</span> <span class="chip crit" title="the other side of the ledger — what transport costs Coates, never what is charged">cost to us · never a charge</span></h3>
      <span class="w" style="font-size:12px;color:var(--mute)">${T.priced ? esc(money(T.amount)) + ' ex GST across ' + T.priced + ' priced line' + (T.priced === 1 ? '' : 's') : 'no priced line yet'}${T.awaiting ? ` · ${T.awaiting} awaiting a figure` : ''}${T.problems ? ` · ${T.problems} incomplete` : ''}</span></div>
    ${byB.length ? `<div class="w" style="font-size:12px;margin:8px 0">${byB.map(b => `<span class="chip ref mono" title="${b.priced} priced line${b.priced === 1 ? '' : 's'}${b.awaiting ? ', ' + b.awaiting + ' awaiting a figure' : ''}">${esc(b.code || 'no branch')} ${b.priced ? esc(money0(b.amount)) : '—'}</span>`).join(' ')}</div>` : ''}
    ${X.table}
    ${X.form}
    ${moreInfo('costs|transport', `<p class="hint">Transport is one of our own costs, tracked with its branch code; the people given access add the details as they get them, and everything updates (Andrew Fisher, 24 Sep 2026). A line typed here by a named person is on every copy of the record, on its branch's plate and in the summary above the moment it is saved. Leave the cost empty until the invoice lands; the line is then <i>awaiting a figure</i> and out of every total.</p>`)}
  </div>`;
}
function wireOurLines(pane){
  pane.querySelectorAll('form.ourform').forEach(form => {
    const K = OUR_KIND[form.dataset.kind]; if (!K) return;
    const ids = ourIds(K.key);
    form.onsubmit = ev => { ev.preventDefault();
      const f = {}; K.fields.forEach(fd => { const el = form.elements[fd.name]; f[fd.name] = el ? el.value : ''; });
      const cur = state.ourEdit ? ourCostOf(state.ourEdit) : null;
      const ok = cur && cur.kind === K.key ? setOurCost(state.ourEdit, f) : addOurCost(K.key, f);
      if (ok) { state.ourEdit = null; bump(); } };
    const cancel = form.querySelector('#' + ids.cancel); if (cancel) cancel.onclick = () => { state.ourEdit = null; renderCosts(); };
    /* the browser draws the date field its own way round; the day is written out beside it (the 14 Sep 2026 audit) */
    const dEl = form.elements.date, dSay = form.querySelector('#' + ids.say);
    if (dEl && dSay) dEl.oninput = () => { dSay.textContent = dEl.value ? fmtDate(dEl.value) : ''; };
    /* a shift's hours follow its start, finish and break until somebody types the hours themselves */
    if (K.key === 'labour') { const hE = form.elements.hours; let typed = false;
      if (hE) hE.oninput = () => { typed = true; };
      ['start', 'finish', 'break_min'].forEach(n => { const el = form.elements[n]; if (el) el.oninput = () => { if (typed || !hE) return; const h = shiftHours(form.elements.start.value, form.elements.finish.value, form.elements.break_min.value); hE.value = h == null ? '' : String(h); }; }); }
  });
  pane.querySelectorAll('[data-ourEdit]').forEach(b => b.onclick = () => { const c = ourCostOf(b.dataset.ouredit); if (!c) return;
    state.ourEdit = c.id; SFOLD_OPEN.add('costs|' + c.kind); renderCosts(); const f = $('#' + ourIds(c.kind).form); if (f) f.scrollIntoView({block: 'nearest'}); });
  pane.querySelectorAll('[data-ourDel]').forEach(b => b.onclick = () => { const c = ourCostOf(b.dataset.ourdel); if (!c) return;
    if (!confirm(`Take ${c.id} off the record${c.amount != null && OUR_KIND[c.kind] && OUR_KIND[c.kind].money ? ' (' + money(c.amount) + ')' : ''}? The removal travels to every copy.`)) return;
    if (removeOurCost(c.id)) { if (state.ourEdit === c.id) state.ourEdit = null; bump(); } });
  /* the People table: a rate a night and a race-weekend role, saved as they are chosen, named and stamped */
  pane.querySelectorAll('[data-prate]').forEach(el => el.onchange = () => { if (setOurPerson(el.dataset.prate, {accommodation_rate: el.value})) bump(); else renderCosts(); });
  pane.querySelectorAll('[data-prole]').forEach(el => el.onchange = () => { if (setOurPerson(el.dataset.prole, {charged_as: el.value})) bump(); else renderCosts(); });
}
/* his tracker — labour, nights, meals and expenses — as the page's own lines, live and editable; the detail folded */
function workforceCard(){
  if (!WF.present) return `<div class="card"><div class="hubtitle"><h3>Labour, accommodation, meals and expenses</h3></div><p class="norate">${esc(WF.why || 'no tracker read for this build')}.</p></div>`;
  const T = trackerFigures(), L = T.labour, A = T.accommodation, Mm = T.meals, E = T.misc, RW = T.race;
  const h = n => esc(fmtNum(n));
  const ro = capability() !== 'edit';
  const EH = eventHoursTotal();
  const roleOf = n => eventRoles().find(r => r.role === n) || null;
  const fold = (key, title, inner) => `<details class="sfold more" data-sfold="costs|${key}"${SFOLD_OPEN.has('costs|' + key) ? ' open' : ''}><summary>${esc(title)}</summary><div class="sfoldbody">${inner}</div></details>`;
  const kc = k => ourKindCard(k);
  const shifts = kc('labour'), nights = kc('accommodation'), meals = kc('meals'), misc = kc('misc');
  return `<div class="card nosfold" id="workforce">
    <div class="hubtitle"><h3>Labour, accommodation, meals and expenses</h3>
      <span class="w" style="font-size:12px;color:var(--mute)">Andrew Fisher's tracker, as changed here · ex GST · a date still to come is a plan, not a cost incurred</span></div>
    <div class="kpis" style="margin-top:10px">
      <div class="kpi"><div class="v">${h(L.hours)}<small> h</small></div><div class="l">Labour — build and demob</div><div class="q">${h(L.to_date)} h worked, ${h(L.planned)} h planned · hours only</div></div>
      <div class="kpi"><div class="v">${h(L.ordinary)}<small> h</small></div><div class="l">Ordinary hours</div><div class="q">${h(L.at_1_5)} h at ×1.5 · ${h(L.at_2)} h at ×2 — his rule, shift by shift</div></div>
      ${SCOPE ? `<div class="kpi"><div class="v">${h(RW.hours)}<small> h</small></div><div class="l">Race weekend — worked</div><div class="q">wages, hours only · the people over the event are charged by the event labour scope on the Pricing tab — ${esc(money0((scopeFigures() || {}).total))}</div></div>` : ''}
      ${SCOPE ? '' : `<div class="kpi"><div class="v">${EH.total != null ? esc(money0(EH.total)) : h(RW.hours) + '<small> h</small>'}</div><div class="l">Race weekend — charged</div><div class="q">${h(RW.hours)} h over ${esc(EVENT_DAYS.map(d => fmtDay(d).dm).join(', '))}${((DATA.charge_basis || {}).labour_hourly || {}).rates === 'flat' ? ' · flat rates' : ''}${RW.unpriced_hours ? ` · ${h(RW.unpriced_hours)} h need a role` : ''}</div></div>`}
      <div class="kpi"><div class="v">${esc(money0(A.amount))}</div><div class="l">Accommodation</div><div class="q">${A.nights} nights${A.unpriced ? ` · ${A.unpriced} with no rate yet` : ''}</div></div>
      <div class="kpi"><div class="v">${esc(money0(Mm.amount))}</div><div class="l">Meals away</div><div class="q">${Mm.lines} line${Mm.lines === 1 ? '' : 's'}</div></div>
      <div class="kpi"><div class="v">${esc(money0(E.amount))}</div><div class="l">Other expenses</div><div class="q">${E.lines} line${E.lines === 1 ? '' : 's'}</div></div>
    </div>
    <h4 class="subhd">People <span>${SCOPE ? 'their hours and their rate a night — the people over the event are charged by the event labour scope, not person by person' : 'their rate a night, and the card role their race-weekend hours are charged as'}</span></h4>
    <div class="tblwrap"><table class="ledgertbl people"><thead><tr><th>Person</th><th>Type · employer</th><th class="num">Build &amp; demob h</th><th class="num">Race weekend h</th>${SCOPE ? '' : '<th>Charged as on race weekend</th><th class="num">Charge</th>'}<th class="num">Rate a night</th><th class="num">Nights</th></tr></thead>
      <tbody>${T.people.map(p => { const r = roleOf(p.charged_as);
        return `<tr><td><b>${esc(p.name)}</b></td><td>${esc([p.type, p.employer].filter(Boolean).join(' · ') || '—')}</td><td class="num">${h(p.hours)}</td><td class="num">${p.race ? h(p.race) : '—'}</td>
        ${SCOPE ? '' : `<td>${ro ? esc(p.charged_as || '—') : `<select data-prole="${esc(p.name)}" title="the card role ${esc(p.name)}'s race-weekend hours are charged at"><option value="">— not charged by the hour —</option>${eventRoles().map(x => `<option value="${esc(x.role)}"${p.charged_as === x.role ? ' selected' : ''}>${esc(x.role)} · ${esc(money(x.rate))}</option>`).join('')}</select>`}</td>
        <td class="num">${p.race ? (r ? `<b>${esc(money(Math.round(p.race * r.rate * 100) / 100))}</b>` : '<span class="chip cand">needs a role</span>') : '—'}</td>`}
        <td class="num">${ro ? (p.rate != null ? esc(money(p.rate)) : '<span class="chip cand">no rate yet</span>') : `<input class="rate" data-prate="${esc(p.name)}" inputmode="decimal" value="${p.rate != null && p.rate !== '' ? esc(String(p.rate)) : ''}" placeholder="no rate yet" title="${esc(p.name)}'s accommodation rate a night, ex GST — every night of theirs with no rate of its own takes it">`}</td>
        <td class="num">${p.nights ? `${p.nights}${p.nights_unpriced ? `<br><span class="w" style="font-size:11px;color:var(--mute)">${p.nights_unpriced} unpriced</span>` : ''}` : '—'}</td></tr>`; }).join('')}</tbody></table></div>
    ${EH.typed ? `<p class="hint" style="margin:6px 0 0">${EH.typed} day-role${EH.typed === 1 ? ' is' : 's are'} typed on the Pricing tab's event card and ${EH.typed === 1 ? 'wins' : 'win'} over the tracker for ${EH.typed === 1 ? 'its' : 'their'} day and role.</p>` : ''}
    ${fold('labour', `Shifts — ${shifts.list.length}`, shifts.table + shifts.form)}
    ${fold('accommodation', `Accommodation — ${nights.list.length} nights`, nights.table + nights.form)}
    ${fold('meals', `Meals away from home — ${meals.list.length}`, meals.table + meals.form)}
    ${fold('misc', `Misc and other expenses — ${misc.list.length}`, misc.table + misc.form)}
    ${fold('weeks', `By week — ${T.weeks.length}`, `<div class="tblwrap"><table class="ledgertbl"><thead><tr><th>Week</th><th>From</th><th class="num">Coates CNA h</th><th class="num">External h</th><th class="num">Salary h</th><th class="num">All h</th><th class="num">of which race weekend</th><th class="num">Nights</th><th class="num">Accommodation</th><th class="num">Meals</th><th class="num">Other</th><th class="num">Total $</th></tr></thead>
      <tbody>${T.weeks.map(w => `<tr class="${w.from > todayIso() ? 'planned' : ''}"><td><b>${esc(w.week)}</b>${w.from > todayIso() ? ' <span class="chip" title="still to come — planned, not incurred">planned</span>' : ''}</td><td>${esc(fmtDay(w.from).dm)}</td><td class="num">${h(w.cna)}</td><td class="num">${h(w.external)}</td><td class="num">${h(w.salary)}</td><td class="num"><b>${h(w.hours)}</b></td><td class="num">${w.race ? h(w.race) : '—'}</td><td class="num">${w.nights}</td><td class="num">${esc(money(w.accommodation) || '—')}</td><td class="num">${esc(money(w.meals) || '—')}</td><td class="num">${esc(money(w.other) || '—')}</td><td class="num"><b>${esc(money(w.total) || '—')}</b></td></tr>`).join('')}</tbody></table></div>`)}
    ${moreInfo('costs|tracker', `<p class="hint">The hours rule, stated ${esc(fmtDate(WF.hours_rule.stated_on || '2026-09-24'))}: a standard day of ${esc(String((WF.hours_rule.weekday || {}).ordinary_hours))} h, the next ${esc(String((WF.hours_rule.weekday || {}).then_at_1_5))} h at ×1.5 and the rest at ×2; Saturday ×1.5 for the first ${esc(String((WF.hours_rule.saturday || {}).at_1_5))} h and ×2 after; Sunday ×2 for every hour — applied shift by shift; ${h(L.weighted)} weighted hours outside the race weekend (ordinary + 1.5 × the ×1.5 hours + 2 × the ×2 hours). No dollar is put on an hour — hours only (24 Sep 2026). ${SCOPE ? `The people over the event are charged by the Coates Event Labour Scope on the Pricing tab (25 Sep 2026), not person by person; the tracker's race-day hours are shown here as worked, in hours only, and counted with the wages.` : `The race weekend is what we charge, not our cost (25 Sep 2026) — at the card's hourly event rates by each person's role; Saturday and Sunday are charged at the card's hourly rate, as written, with no loading added.`}</p>
      <p class="hint">The tracker is a starting point, to be taken with a grain of salt, and it has to be editable (Andrew Fisher, 25 Sep 2026): every shift, night, meal, expense and person here can be changed, added to or taken off by a named person, and the change travels with the record; the tracker's own line stays underneath as what was supplied (<span class="mono">${esc(WF.workbook)}</span>, ${esc(fmtDate(WF.supplied_on))}).</p>
      <ul style="margin:0;padding-left:18px;font-size:12.5px;line-height:1.55">${(WF.summary_notes || []).map(n => `<li>${esc(n)}</li>`).join('')}${((WF.setup || {}).notes || []).map(n => `<li>${esc(n)}</li>`).join('')}</ul>`)}
  </div>`;
}
function renderCosts(){
  const q = state.q.trim().toLowerCase();
  const all = allCosts(), by = costsByCategory(all), T = costTotals(all), fd = fenceDerived();
  const local = all.filter(c => c._where === 'local').length;
  const hay = c => [c.id, c.category, costShort(c.category), c.description, c.supplier, c.reference, c.ref, c.area, c.note, c.recorded_by, c.updated_by, c.date, c.po_no, costBranchOf(c).code, kindLabel(costKindOf(c))].filter(Boolean).join(' ').toLowerCase();
  const filt = state.costFilter || 'all';
  const shown = all.filter(c => !q || q.split(/\s+/).filter(Boolean).every(t => hay(c).includes(t)))
                   .filter(c => filt === 'all' ? true : filt === 'problems' ? !c.usable : filt === 'local' ? c._where === 'local' : c.category === filt);
  const expect = DATA.cost_categories || {};
  const shownT = costTotals(shown);
  /* v5.83 — COSTS & CHARGES, AS MANAGEMENT READ THEM. Andrew Fisher, 25 Sep 2026: a cost is what Coates pays; a
     charge is what Coates bills the V8s, and everything on hire is a charge; management look at this page. So the
     tab says which is which at the top, gives the three figures and the streams (marginCard), puts what Coates pays
     under the eight categories management expect every cost recorded against, and puts what we charge the V8s by
     branch, with the charge lines on the record under it. The eight categories hold costs only — a charge is never
     shown under a cost category. */
  $('#pane-costs').innerHTML = paneHeadingHtml('costs') + `
  <div class="hubhead"><div><h2>Costs &amp; charges — what we charge the V8s, and what Coates pays</h2>
    <div class="sub">${esc(DATA.event.name)} · as at ${esc(fmtDate(todayIso()))} · a charge is what Coates bills the V8s, everything on hire among it; a cost is what Coates pays · AUD ex GST · the two kept apart and never added across</div></div>
    <div class="daynav"><button class="btn" id="printCosts">Print</button> <a class="btn" href="${costsSummaryMailto(all)}">Email the summary</a></div></div>
  ${marginCard()}
  <h3 class="sec" style="margin-top:6px">What Coates pays <span>by the eight categories management expect every cost recorded against</span></h3>
  ${costCategoryCard(expect)}
  ${ourTransportCard()}
  ${workforceCard()}
  <h3 class="sec" style="margin-top:6px">What we charge the V8s <span>by branch — the contracts by the rate, and the charge lines on the record</span></h3>
  ${branchCostCard()}
  <div class="card">
    <div class="hubtitle"><h3>Charge lines on the record <span class="chip ref">${shown.length}${shown.length !== all.length ? ' of ' + all.length : ''}</span></h3>
      <div class="filters" style="margin:0">
        ${[['all', 'All ' + all.length], ['problems', 'Incomplete ' + T.problems], ['local', LW() + ' ' + local]].map(([k, l]) => `<button data-cf="${k}" aria-pressed="${filt === k}">${esc(l)}</button>`).join('')}
        ${by.filter(b => b.lines).map(b => `<button data-cf="${esc(b.category)}" aria-pressed="${filt === b.category}" title="show the ${esc(b.short.toLowerCase())} lines only">${esc(b.short)} ${b.lines}</button>`).join('')}
      </div></div>
    ${!['all', 'problems', 'local'].includes(filt) ? `<p class="norate" style="margin:6px 0 0">Showing <b>${esc(filt)}</b> only — <button class="linkish" data-cf="all">show every category</button></p>` : ''}
    <div class="tblwrap" style="margin-top:8px"><table class="costtbl"><thead><tr><th>Date</th><th>Category</th><th>What</th><th class="num">Amount ex GST</th><th class="num">Hours</th><th>Supplier · paper</th><th>Branch · kind</th><th>For</th><th>Recorded</th><th></th></tr></thead>
    <tbody>${shown.length ? shown.map(c => `<tr class="${c.usable ? '' : 'stop'}">
      <td style="white-space:nowrap">${esc(c.date ? fmtDate(c.date).slice(0, 10) : '—')}<br><span class="mono" style="font-size:11px;color:var(--mute)">${esc(c.id)}</span></td>
      <td><span class="chip">${esc(costShort(c.category))}</span>${c.problems.length ? '<br><span class="chip crit" title="' + esc(c.problems.join('; ')) + '">incomplete</span>' : ''}</td>
      <td>${esc(c.description || '')}${c.note ? '<br><span class="w" style="font-size:12px;color:var(--mute)">' + esc(c.note) + '</span>' : ''}</td>
      <td class="num">${c.amount != null ? '<b>' + esc(money(c.amount)) + '</b>' : '<span class="todo" title="no amount typed">—</span>'}</td>
      <td class="num">${c.hours != null || c.overtime_hours != null ? `${c.hours != null ? esc(c.hours) : '0'}${c.overtime_hours ? ' <span class="w" style="color:var(--mute)">+ ' + esc(c.overtime_hours) + ' OT</span>' : ''}` : '—'}</td>
      <td style="font-size:12.5px">${c.supplier ? '<b>' + esc(c.supplier) + '</b>' : ''}${c.reference ? (c.supplier ? '<br>' : '') + '<span class="mono">' + esc(c.reference) + '</span>' : ''}${!c.supplier && !c.reference ? '—' : ''}${c.po_no ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">PO <span class="mono">${esc(c.po_no)}</span></span>` : ''}</td>
      <td style="font-size:12.5px">${(() => { const b = costBranchOf(c); return b.code ? `<span class="chip ref mono" title="${esc(b.why)}">${esc(b.code)}</span>` : '<span class="todo" title="' + esc(b.why) + '">no branch</span>'; })()}<br><span class="w" style="color:var(--mute)" title="${esc(costKindWhy(c))}">${esc(kindLabel(costKindOf(c)))}</span></td>
      <td>${c.ref ? (assetDeleted(c.ref) ? `<b>${esc(c.ref)}</b> <span class="w" style="font-size:11.5px;color:var(--mute)" title="${esc((deletionOf(c.ref) || {}).note || 'deleted')}">reference deleted — the money stays on the job</span>` : `<button class="linkish" data-open="${esc(c.ref)}"><b>${esc(c.ref)}</b></button>`) : ''}${c.area ? (c.ref ? '<br>' : '') + `<button class="linkish" data-area="${esc(c.area)}">${esc(c.area)}</button> <span class="w" style="color:var(--mute)">fencing area</span>` : ''}${!c.ref && !c.area ? '<span class="w" style="color:var(--mute)">the job</span>' : ''}</td>
      <td style="font-size:12px;white-space:nowrap">${esc(c.recorded_by || 'unnamed')}<br>${whereChip(c._where)}${c.updated_at && c.updated_at !== c.recorded_on ? '<br><span class="w" style="color:var(--mute)">changed ' + esc(fmtStamp(c.updated_at)) + '</span>' : ''}</td>
      <td><div class="acts">${c.docket ? `<button class="btn" data-docket="${esc(c.docket)}" title="open the docket this line is worked out from">Docket</button>` : ''}<a class="btn" href="${costMailto(c)}">Email</a></div></td>
    </tr>`).join('') : `<tr><td colspan="10" class="empty">${all.length ? 'Nothing matches.' : 'No cost on the record yet. Nothing is typed on this page: a line arrives from the record — the fencing dockets at the crew\'s own sheet — or from what Andrew Fisher gives the build.'}</td></tr>`}</tbody>
    ${shown.length > 1 ? `<tfoot><tr class="total"><td colspan="3"><b>Total of the ${shown.length} lines shown</b> <span class="w" style="color:var(--mute)">usable lines only${shownT.problems ? ` — ${shownT.problems} incomplete left out` : ''}</span></td>
      <td class="num"><b>${esc(money(shownT.amount) || '$0.00')}</b></td><td class="num">${shownT.hours || shownT.overtime_hours ? `${shownT.hours}${shownT.overtime_hours ? ' + ' + shownT.overtime_hours + ' OT' : ''}` : '—'}</td><td colspan="5"></td></tr></tfoot>` : ''}</table></div>
    <p class="norate" style="margin-top:8px">${esc((DATA.ops || {}).cost_basis || 'Every figure in this table is what Coates charges the V8s. Nothing is typed on the page: a line is here because the record carries it — the fencing dockets at the 2026 card — or because Andrew Fisher gave it to the build. AUD ex GST; nothing is estimated.')}
      A docket recorded on the Fencing tab fills in here as soon as it is usable; ${local ? `the ${local} ${esc(LW())} line${local === 1 ? ' is' : 's are'} from before v5.79 and stay${local === 1 ? 's' : ''} on the record until it is exported and the package rebuilt.` : 'nothing on this tab is waiting to be exported.'}</p>
  </div>
  <p class="maphint">Every line in that table is a charge — what Coates bills the V8s — and names its category, where it came from and, where it helps, the asset or fencing area it was for. What Coates pays is above it, under the eight cost categories. Nothing is typed on this tab:
    a line fills in from the record, or is given to the build. Print gives the money summary, what Coates pays by the eight categories, the branches and the lines shown, in landscape; Email sends the summary as text.</p>`;
  const pane = $('#pane-costs');
  $('#printCosts').onclick = printCosts;
  wireOurLines(pane);
  pane.querySelectorAll('[data-cf]').forEach(b => b.onclick = () => { const k = b.dataset.cf; state.costFilter = (filt === k && k !== 'all') ? 'all' : k; renderCosts(); });
  pane.querySelectorAll('[data-docket]').forEach(b => b.onclick = () => { state.q = b.dataset.docket; const qb = $('#q'); if (qb) { qb.value = state.q; $('#qx').hidden = false; } go('fencing'); });
  pane.querySelectorAll('[data-open]').forEach(b => b.onclick = () => openAsset(b.dataset.open));
  pane.querySelectorAll('[data-area]').forEach(b => b.onclick = () => { state.q = b.dataset.area; const qb = $('#q'); if (qb) { qb.value = state.q; $('#qx').hidden = false; } go('fencing'); });
}

/* ------------------------------------------------------------------ the variance registers
   Two, because they are shaped differently. Plant variances hang off a GC500 reference. Fencing has no
   references at all — only week sheets and metre totals — so a fencing variance names a sheet and a fence
   type. Forcing them into one table would mean half the columns were always empty. */
/* Everything a variance can be found by: its id, the reference, the sheet, the words in it, and the names
   against it. The search box reached the map, the register and the plant pages but stopped at this tab, so
   typing a reference here quietly showed you every variance on the job. */
function varMatches(v, q){
  if (!q) return true;
  const hay = [v.id, v.ref, v.sheet, v.fence_type, v.type, v.asked, v.supplied, v.reason,
               v.authorised_by, v.recorded_by, v.chargeable, v.authority_state]
    .filter(Boolean).join(' ').toLowerCase();
  return q.split(/\s+/).filter(Boolean).every(t => hay.includes(t));
}
function renderVariances(){
  const q = state.q.trim().toLowerCase();
  const all = allVariances();
  const shown = all.filter(v => varMatches(v, q));
  const plant = shown.filter(v => v.scope === 'plant');
  const fence = shown.filter(v => v.scope === 'fencing');
  const un = all.filter(v => v.authority_state === 'unattributed').length;
  const local = all.filter(v => v._where === 'local').length;
  /* THE FOUR STATES ADD UP TO THE TOTAL. Outside audit, 17 Sep 2026 (B07): "1 recorded · 0 with a name and a
     date · 0 nobody has signed" beside a row that said "recorded only" — the row's state fell between the two
     figures, so the summary said nobody was waiting on anything while the row said somebody was. Everything that
     is not authorised is awaiting authorisation, and the plate says how that splits, in the rows' own words. */
  const authorised = all.filter(v => v.authority_state === 'authorised').length;
  const named = all.filter(v => v.authority_state === 'named, undated').length;
  const recOnly = all.filter(v => v.authority_state === 'recorded only').length;
  const awaiting = all.length - authorised;
  const split = [recOnly ? fmtNum(recOnly) + ' recorded only' : null, named ? fmtNum(named) + ' named, undated' : null,
                 un ? fmtNum(un) + ' with nobody named' : null].filter(Boolean).join(' · ');
  $('#pane-variances').innerHTML = paneHeadingHtml('variances') + `
   <div class="card">
     <h3>Variances</h3>
     <p class="sub">Where what was supplied differs from what was asked for. <b>Nothing here is priced</b>, and
       that is a commercial decision rather than a missing rate card: plant hire is priced on the
       <button class="linkish" data-go="pricing">Pricing tab</button> at the 2026 ${esc(CARD_WORD)} card, and fencing is
       priced at the same card's fencing lines on the <button class="linkish" data-go="fencing">Fencing tab</button>.
       Whether a particular difference is chargeable, and at what, is for Coates and iEDM to agree — so this page
       records what the person entering it said, including &ldquo;to be agreed&rdquo;, which is the honest answer
       most of the time. A rate card existing does not make a variance agreed.</p>
     ${q ? `<p class="norate">Filtered by <b>${esc(state.q.trim())}</b> — showing ${shown.length} of
       ${all.length}. The counts below are for the whole job, not the filter.</p>` : ''}
     <div class="kpis">
       ${kpi(all.length, 'recorded in total')}
       ${kpi(authorised, 'authorised — a name and a date')}
       ${kpi(awaiting, 'awaiting authorisation', awaiting > 0)}
       ${kpi(all.filter(v => v.chargeable === 'to be agreed').length, 'chargeable to be agreed')}
     </div>
     ${awaiting ? `<p class="norate" style="margin-top:-4px">Awaiting authorisation: ${esc(split)}. A variance recorded by somebody is not a variance
       somebody has authorised — the Authority column on each row says which.</p>` : ''}
     ${local ? `<div class="notice"><b>${local} of these are ${SYNC.on ? 'in the shared record' : 'in this browser only'}</b>They are not on the
       committed record until you Export and the package is rebuilt.${SYNC.on ? '' : ' Anyone else opening this file will not see them.'}</div>` : ''}
     ${un ? `<div class="notice warn"><b>${un} variance${un>1?'s have':' has'} nobody named against
       ${un>1?'them':'it'}</b>An unattributed variance is an observation, not an agreed variation. It should
       not be quoted to iEDM or put in a claim until somebody authorises it.</div>` : ''}
     ${legend()}
     <div><button class="btn" id="vNewPlant">Raise a plant variance</button>
       <button class="btn" id="vNewFence">Raise a fencing variance</button></div>
   </div>
   ${varTable('Plant', plant, false)}
   ${varTable('Fencing', fence, true)}
   <div class="card"><h3>What the fencing figures are measured against</h3>
     <p class="sub">${esc(DATA.fencing.authority)}</p>
     <div class="tblwrap"><table><thead><tr><th>Week sheet</th><th>Phase</th><th>As written</th>
       <th>Stated totals</th></tr></thead><tbody>${
       (DATA.fencing.week_sheets||[]).map(w => `<tr><td><b>${esc(w.sheet)}</b>${w.rolled_forward === false ? '<br><span class="chip act" title="the 2026 file still carries ' + esc(String(w.year || '')) + ' dates on this sheet">not rolled forward</span>' : ''}</td><td>${esc(w.phase||'')}</td>
         <td>${esc(w.span||'')}</td><td>${Object.entries(w.totals||{})
           .filter(([,v]) => v).map(([k,v]) =>
             /* Raise the variance from the line it is about, with the sheet, the fence type and the stated
                figure already filled in. Retyping a week-sheet name from memory into a blank form is how you
                get a variance filed against the wrong week. */
             `<button class="linkish" data-fence="${esc(w.sheet)}" data-ft="${esc(k)}" data-fq="${esc(v)}"
                title="raise a variance against this line">${esc(k)}: <b>${esc(v)}</b></button>`).join('<br>') ||
           '<span class="chip">none stated</span>'}</td></tr>`).join('')}</tbody></table></div>
   </div>`;
  $('#vNewPlant').onclick = () => varDialog({scope:'plant', recorded_by:S.operator||''});
  $('#vNewFence').onclick = () => varDialog({scope:'fencing', recorded_by:S.operator||''});
  $('#pane-variances').querySelectorAll('[data-open]').forEach(b => b.onclick = () => openAsset(b.dataset.open));
  $('#pane-variances').querySelectorAll('[data-map]').forEach(b => b.onclick = () => showOnMap(b.dataset.map));
  $('#pane-variances').querySelectorAll('[data-vedit]').forEach(b => b.onclick = () =>
    varDialog({}, b.dataset.vedit));
  $('#pane-variances').querySelectorAll('[data-fence]').forEach(b => b.onclick = () => varDialog({
    scope:'fencing', sheet:b.dataset.fence, fence_type:b.dataset.ft, asked:b.dataset.fq,
    type:'quantity', recorded_by:S.operator||''}));
}
/* The colour code, written down. A colour system nobody has been told the rules of is decoration — this is
   the same five states the chips use, in the same order, on every page that shows them. */
const CODE = [
  ['',     'not recorded', 'Nobody has entered anything. Not the same as nothing having happened.'],
  ['ok',   'stated',       'The source says so in words.'],
  ['cand', 'assumed',      'Inferred or a candidate. Worth confirming before you rely on it.'],
  ['act',  'differs',      'What was supplied is not what was asked for. This is the one that costs money.'],
  ['crit', 'unresolved',   'Something is blocked on this, or nobody has put their name to it.'],
];
function legend(){
  return `<div class="ccode"><b>Colour code</b>${CODE.map(([c, name, what]) =>
    `<span class="lg"><i class="chip ${c}">${esc(name)}</i><em>${esc(what)}</em></span>`).join('')}</div>`;
}

function kpi(n, label, alert){
  return `<div class="kpi${alert ? ' alert' : ''}"><div class="v">${esc(n)}</div>
    <div class="l">${esc(label)}</div></div>`;
}
function varTable(title, list, fencing){
  return `
  <div class="card">
    <h3>${esc(title)} variances <span class="chip ref">${list.length}</span></h3>
    ${list.length ? `<div class="tblwrap"><table>
      <thead><tr><th>ID</th><th>${fencing ? 'Week sheet · fence type' : 'GC500 ID'}</th><th>Kind</th>
        <th>Asked for</th><th>Supplied</th><th>Why</th><th>Authority</th><th>Chargeable</th></tr></thead>
      <tbody>${list.map(v => `<tr>
        <td><b>${esc(v.id)}</b><br>${whereChip(v._where)}
          ${v._where === 'local'
            ? `<br><button class="linkish" data-vedit="${esc(v.id)}">edit</button>`
            : '<br><span class="w" style="font-size:11px;color:var(--mute)" '
              + 'title="it is in sources/ops/as_supplied.json — edit it there and rebuild">on the record</span>'}</td>
        <td>${fencing ? esc(v.sheet||'') + '<br><span class="w" style="font-size:11.5px;color:var(--mute)">'
                        + esc(v.fence_type||'') + '</span>'
             : (v.ref ? `<button class="linkish" data-open="${esc(v.ref)}"><b>${esc(v.ref)}</b></button>`
                          + `<br><button class="linkish" data-map="${esc(v.ref)}">on the map</button>` : '—')}</td>
        <td><span class="chip">${esc(v.type)}</span></td>
        <td>${esc(v.asked)}${v.qty_asked != null ? ' ×'+esc(v.qty_asked) : ''}</td>
        <td><b>${esc(v.supplied)}</b>${v.qty_supplied != null ? ' ×'+esc(v.qty_supplied) : ''}</td>
        <td>${esc(v.reason||'')}</td>
        <td><span class="chip ${AUTH_CHIP[v.authority_state]||''}">${esc(v.authority_state)}</span>
          <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(v.authority_note||'')}</span></td>
        <td><span class="chip ${CHARGE_CHIP[v.chargeable]||''}">${esc(v.chargeable)}</span></td></tr>`).join('')}
      </tbody></table></div>`
    : `<p class="norate">None recorded. That is not the same as none having happened — it means nobody has
       entered one.</p>`}
  </div>`;
}

/* ------------------------------------------------------------------ raising a variance
   Four kinds, and every one of them wants a name against it. The form does not refuse an unattributed
   variance — on site you often record the fact first and chase the authority afterwards — but it says plainly
   what an unattributed one is worth, and the registers keep showing that until somebody fixes it. */
function varDialog(seed, editId){
  /* Same dialog for both. A variance typed at 6am on a phone will have a typo in it sooner or later, and
     "start again" is not a fix when the thing you are correcting is a commercial record. */
  const editing = editId ? (S.variances||[]).find(v => v.id === editId) : null;
  if (editing) seed = Object.assign({}, editing);
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role','dialog');
  d.setAttribute('aria-modal','true'); d.setAttribute('aria-label','Raise a variance');
  const fencing = seed.scope === 'fencing';
  const types = Object.entries(DATA.variance_types || {});
  d.innerHTML = `
   <div class="dh"><div><h2>${editing ? 'Edit ' + esc(editing.id) : 'Raise a variance'}</h2>
     <div class="sub">${fencing ? 'Fencing' : 'Plant'} · saved in this browser until you export</div></div>
     <button class="close" id="vClose" aria-label="Close" title="Close">&times;</button></div>
   <div class="db"><div class="form">
    ${fencing ? `
      <div class="row2">
        <div class="f"><label>Week sheet</label><select id="vSheet">${
          (DATA.fencing.week_sheets||[]).map(w =>
            `<option value="${esc(w.sheet)}"${seed.sheet===w.sheet?' selected':''}>${esc(w.sheet)} — ${
              esc(w.phase||'')} ${esc(w.span||'')}</option>`).join('')
        }</select></div>
        <div class="f"><label>Fence type</label><select id="vFence">${
          (DATA.fencing.fence_types||[]).map(t =>
            `<option${seed.fence_type===t?' selected':''}>${esc(t)}</option>`).join('')}</select></div>
      </div>` : `
      <div class="f"><label>GC500 reference</label>
        <input id="vRef" value="${esc(seed.ref||'')}" placeholder="e.g. GN01"></div>`}
    <div class="f"><label>What kind of variance</label><select id="vType">${
      types.map(([k,desc]) => `<option value="${esc(k)}"${seed.type===k?' selected':''}>${esc(k)} — ${esc(desc)}</option>`).join('')}</select></div>
    <div class="row2">
      <div class="f"><label>Asked for</label><input id="vAsked" value="${esc(seed.asked||'')}"></div>
      <div class="f"><label>Supplied</label><input id="vSup" value="${esc(seed.supplied||'')}"
        placeholder="or 'nothing' if it never came"></div>
    </div>
    <div class="row2">
      <div class="f"><label>Qty asked</label><input id="vQa" type="number" min="0" step="1"
        value="${esc(seed.qty_asked ?? '')}"></div>
      <div class="f"><label>Qty supplied</label><input id="vQs" type="number" min="0" step="1"
        value="${esc(seed.qty_supplied ?? '')}"></div>
    </div>
    <div class="f"><label>Why</label><textarea id="vWhy" rows="2"
      placeholder="e.g. no 200kVA available in the Brisbane fleet for the window">${esc(seed.reason||'')}</textarea></div>
    <div class="row2">
      <div class="f"><label>Authorised by</label><input id="vAuth" value="${esc(seed.authorised_by||'')}"
        placeholder="who agreed to it"></div>
      <div class="f"><label>Authorised on</label><input id="vAuthOn" type="date"
        value="${esc(seed.authorised_on||'')}"></div>
    </div>
    <div class="row2">
      <div class="f"><label>Chargeable</label><select id="vChg">${
        (DATA.chargeable_states||['to be agreed']).map(c =>
          `<option${seed.chargeable===c?' selected':''}>${esc(c)}</option>`).join('')}</select></div>
      <div class="f"><label>Recorded by</label><input id="vRec" value="${esc(seed.recorded_by||'')}"></div>
    </div>
    <div class="notice info"><b>What makes this stand up</b>A variance with a name and a date against it is an
      agreed variation. Without them it is an observation — still worth recording, and still worth nothing in a
      commercial conversation until somebody puts their name to it.</div>
   </div></div>
   <div class="df"><button class="btn primary" id="vSave">${editing ? 'Save changes' : 'Save variance'}</button>
     <button class="btn" id="vCancel">Cancel</button>
     ${editing ? '<button class="btn" id="vDel">Set aside</button>' : ''}</div>`;
  mounted(document.body.appendChild(d));
  /* closing redraws every view through bump(), so a variance raised from the drawer appears in the drawer's
     own list and on the register at once */
  const shut = () => { d.remove(); bump(); };
  $('#vClose', d).onclick = shut; $('#vCancel', d).onclick = shut;
  const del = $('#vDel', d);
  if (del) del.onclick = () => {
    const who = whoAmI(); if (!who) return;
    if (!confirm('Set aside ' + editing.id + '? It is kept, with your name and the time, and can be put back from Tools → Edit.')) return;
    if (!setAside('variances', editing.id, who)) return;
    save(); shut(); flash(editing.id + ' set aside by ' + who + ' — Put back is under Tools → Edit.');
  };
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  const first = d.querySelector('input,select,textarea'); if (first) first.focus();
  $('#vSave', d).onclick = () => {
    const val = id => { const el = $('#'+id, d); return el ? (el.value||'').trim() : ''; };
    const num = id => { const v = val(id); return v === '' ? null : safeNum(v); };
    const v = {id: nextVarId(), scope: seed.scope, type: val('vType'),
               asked: val('vAsked'), supplied: val('vSup'),
               qty_asked: num('vQa'), qty_supplied: num('vQs'),
               reason: val('vWhy'), authorised_by: val('vAuth') || null,
               authorised_on: val('vAuthOn') || null, chargeable: val('vChg') || 'to be agreed',
               recorded_by: val('vRec') || null, recorded_on: todayIso()};
    if (fencing) { v.sheet = val('vSheet'); v.fence_type = val('vFence'); } else { v.ref = val('vRef'); }
    if (!v.asked || !v.supplied) { flash('Both "asked for" and "supplied" are needed — that is the whole record.'); return; }
    if (!fencing && !v.ref) { flash('A plant variance needs a GC500 reference.'); return; }
    if (editing) {
      v.id = editing.id;                       // the id is the record's identity — an edit is not a new one
      v.recorded_on = editing.recorded_on || v.recorded_on;
      S.variances = S.variances.map(x => x.id === editing.id ? v : x);
    } else {
      S.variances = (S.variances||[]).concat([v]);
    }
    if (v.recorded_by) { S.operator = v.recorded_by; const w = $('#who'); if (w) w.value = S.operator; }
    save(); shut();
    flash(v.id + (editing ? ' updated' : ' saved') +
      ' in this browser. Export and rebuild to put it on the record.');
  };
}

/* ------------------------------------------------------------------ the driver's drop sheet
   One A4 page a driver can hold. What it is, where it goes, how a truck gets there, who to ring, and a receipt.
   Built from the same data as everything else, so it can never disagree with the map it was printed from.

   The one thing on it that matters more than the layout: the position is a drawing callout, not a survey. A
   driver who reads it as GPS-accurate puts a 12 m building in the wrong spot. So that line is printed large, at
   the top of the "where" panel, not in the footer where nobody reads it. */
/* One drop, one page — the same sheet the day's run produces, and no other. Andrew Fisher, 13 Sep 2026:
   the drop-off A4 print-outs are to be one page only, with the receipt section removed.

   There were two designs of this sheet: this one, printed from an asset, and the day's, printed from the map.
   Two designs is one too many. The older one ran to two pages on a busy asset and still carried a Receipt box —
   driver, rego, arrived, departed, signature — which Andrew had already taken off the day's sheet on the same
   day: it was not necessary — the sheet is for drivers, so they know exactly where to go. So it is gone from here
   too, and there is one design left. What a driver is handed is now the same page whichever button printed it,
   which also means it can only ever be wrong in one place instead of two. */
function dropSheet(key){
  const a = allAssets().find(x => x.key === key);
  if (!a) return;
  /* The day the drop sits on, and the events behind it — the same row the day's print would use. A delivery
     wins over a collection where an asset has both, because that is the sheet somebody standing at a truck is
     asking for. An asset on no day at all still gets its page: the header says so rather than refusing. */
  let d = null, events = null, kind = 'deliveries';
  for (const x of programmeDays()) {
    const inRow = x.deliveries.find(r => r.a.key === key);
    if (inRow) { d = x; events = inRow.events; kind = 'deliveries'; break; }
    if (!d) { const out = x.removals.find(r => r.a.key === key);
              if (out) { d = x; events = out.events; kind = 'removals'; } }
  }
  if (!d) {
    const eff = effectiveDates(a);
    d = {iso: eff.in || a.first_date || todayIso(), sheet: null, phase: ''};
    events = (a.events || []).filter(e => e.movement !== 'remove');
    if (!events.length) events = a.events || [];
  }
  printPages([dropPage(a, events || [], 1, 1, d, kind)]);
}


/* A small compass drawn from the derived orientation. Rotated so N points where north actually is on the
   photograph — which, on these sheets, is roughly to the left. */
/* Andrew Fisher, 13 Sep 2026: the compass matters — N, E, S and W.

   All four points, not just north. A driver told to head north-west from the gate has to turn the picture into
   a direction, and one letter makes him do that in his head at the wheel of a tilt tray. Four letters and he
   reads it off the page. Every letter is placed from the SAME derived orientation as the needle — there is no
   north arrow on any supplied sheet, so the whole rose stands or falls on that one figure, and it is the one
   the page already says it derived and how confident it is. Each letter is counter-rotated so it sits the
   right way up on the paper however far round the rose is turned. */
function compassRose(o, cls){
  if (!o) return '';
  const rot = o.north_deg_clockwise_from_sheet_top;
  const pt = (letter, deg) => `<span class="${cls}-cp" style="transform:translate(-50%,-50%) rotate(${rot + deg}deg) translateY(calc(-1 * var(--cpr, 3.1mm))) rotate(${-(rot + deg)}deg)">${letter}</span>`;
  return `<span class="${cls}-rose" aria-hidden="true">
    <span class="${cls}-needle" style="transform:rotate(${rot}deg)"></span>
    ${pt('N', 0)}${pt('E', 90)}${pt('S', 180)}${pt('W', 270)}</span>`;
}
/* Dates are written the way the site writes them — Mon 14 Sep 2026, 24-hour clock — from fixed names rather
   than the browser's locale, which in en-AU spells September "Sept" and switches the clock to am/pm. */
const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const two = n => String(n).padStart(2, '0');
function fmtDate(iso){
  const d = new Date(String(iso).slice(0, 10) + 'T00:00:00');
  return isNaN(d) ? String(iso) : `${DOW[d.getDay()]} ${two(d.getDate())} ${MON[d.getMonth()]} ${d.getFullYear()}`;
}
function fmtDay(iso){ const d = new Date(String(iso).slice(0, 10) + 'T00:00:00');
  return isNaN(d) ? {dow:'', dm:String(iso)} : {dow:DOW[d.getDay()], dm:`${two(d.getDate())} ${MON[d.getMonth()]}`}; }

/* ------------------------------------------------------- asked for, and what turned up */
function suppliedBlock(a){
  const rows = itemRows(a), loc = localSupplied(a.key), com = CROW.get(a.key) || {};
  const nums = (com.asset_numbers_supplied || []).concat(loc.asset_numbers || []);
  const mine = allVariances().filter(v => v.scope === 'plant' && v.ref === a.key);
  const body = rows.map((r, i) => `
    <tr>
      <td>${esc(r.asked)}${r.qty_asked != null ? ' <span class="w" style="color:var(--mute)">×'+esc(r.qty_asked)+'</span>' : ''}</td>
      <td><input data-sup="${i}" value="${esc(r.supplied || '')}" placeholder="what turned up"
            style="width:100%;min-width:9rem"></td>
      <td><input data-supq="${i}" type="number" min="0" step="1" value="${esc(r.qty_supplied ?? '')}"
            placeholder="qty" style="width:5rem"></td>
      <td>${r.state === 'differs' ? '<span class="chip act">differs</span>'
          : r.state === 'as asked' ? '<span class="chip ok">as asked</span>'
          : '<span class="chip">not recorded</span>'}${r.where ? ' ' + whereChip(r.where) : ''}</td>
    </tr>`).join('');
  /* v5.81 — ONE PLACE FOR A NUMBER. Andrew Fisher, 24 Sep 2026: no doubling up — the reference number links to
     the asset number. The number that arrived is typed once, under "Asset numbers on P58" below, and it counts
     everywhere; this card no longer asks for it a second time. The card's story is under Details. */
  return `
  <div class="card" style="margin:0 0 14px">
    <h3>What was asked for, and what we supplied</h3>
    <p class="sub">The left column is the schedule and is never edited here. Fill in the right when the item
      lands. A blank is <b>not recorded</b> — it does not mean it came as asked. The asset number that arrived
      goes under <b>Asset numbers</b> below, once, and counts everywhere.</p>
    ${rows.length ? `<div class="tblwrap"><table>
      <thead><tr><th>Asked for</th><th>Supplied</th><th>Qty</th><th>State</th></tr></thead>
      <tbody>${body}</tbody></table></div>`
      : '<p class="norate">No item type on this reference, so there is nothing to compare.</p>'}
    <div class="form" style="margin-top:12px">
      <div class="row2">
        <div class="f"><label>Recorded by</label><input id="supBy" value="${esc(loc.recorded_by || S.operator || '')}"></div>
        <div class="f"><label>On</label><input id="supOn" type="date" value="${esc(loc.recorded_on || '')}"></div>
      </div>
      <div><button class="btn" id="supSave">Save what was supplied</button>
        <button class="btn" id="varAdd">Raise a variance</button></div>
    </div>
    ${nums.length ? `<p class="norate">Recorded on site: <b class="mono">${nums.map(esc).join(', ')}</b></p>` : ''}
    ${mine.length ? `<div style="margin-top:10px">
      <button class="linkish" id="toVar">See all ${mine.length} variance${mine.length>1?'s':''} on the register →</button>
      ${mine.map(v => `
      <div class="acc"><b>${esc(v.id)}</b> <span class="chip">${esc(v.type)}</span>
        <span class="chip ${AUTH_CHIP[v.authority_state]||''}">${esc(v.authority_state)}</span>
        ${whereChip(v._where)}<br>
        <span class="w" style="font-size:12px">${esc(v.asked)} → <b>${esc(v.supplied)}</b>${
          v.reason ? ' · ' + esc(v.reason) : ''}</span></div>`).join('')}</div>` : ''}
  </div>`;
}

function wireSupplied(a){
  const rows = itemRows(a);
  /* After a supplied value changes, the tab behind the drawer is redrawn and the state chip on this row is
     patched in place. The drawer is not redrawn — focus is on its way to the next box. */
  const after = i => { render();
    const fresh = itemRows(a)[i], tr = $('#drawer').querySelector(`[data-sup="${i}"]`), cell = tr && tr.closest('tr').lastElementChild;
    if (cell && fresh) cell.innerHTML = (fresh.state === 'differs' ? '<span class="chip act">differs</span>'
      : fresh.state === 'as asked' ? '<span class="chip ok">as asked</span>' : '<span class="chip">not recorded</span>')
      + (fresh.where ? ' ' + whereChip(fresh.where) : ''); };
  $('#drawer').querySelectorAll('[data-sup]').forEach(el => {
    el.onchange = () => { setSupplied(a.key, rows[+el.dataset.sup].asked, {supplied: el.value.trim() || null}); after(+el.dataset.sup); };
  });
  $('#drawer').querySelectorAll('[data-supq]').forEach(el => {
    el.onchange = () => {
      /* v5.58 — a supplied quantity is a count. "1.5" of a fridge is not a count; it is refused and said, and
         the box keeps what was typed so the person can see it. Blank clears it, as before. (The 19 Sep 2026
         audit: a decimal quantity was being kept as typed here and truncated elsewhere — one rule now.) */
      if (el.value !== '' && wholeQty(el.value) == null && el.value.trim() !== '0') {
        flash('A supplied quantity is a whole number of things \u2014 \u201c' + el.value.slice(0, 20) + '\u201d was not recorded.'); return; }
      setSupplied(a.key, rows[+el.dataset.supq].asked,
        {qty_supplied: el.value === '' ? null : (el.value.trim() === '0' ? 0 : wholeQty(el.value))}); after(+el.dataset.supq); };
  });
  const save1 = $('#supSave');
  if (save1) save1.onclick = () => {
    const num = (($('#supNum') || {}).value || '').trim();   /* v5.81 — the box is gone; a number is typed once, below */
    S.supplied = S.supplied || {};
    const r = S.supplied[a.key] || (S.supplied[a.key] = {items:[]});
    if (num) { r.asset_numbers = (r.asset_numbers || []); if (!r.asset_numbers.includes(num)) r.asset_numbers.push(num); }
    r.recorded_by = ($('#supBy').value || '').trim() || null;
    r.recorded_on = $('#supOn').value || null;
    if (r.recorded_by) { S.operator = r.recorded_by; const w = $('#who'); if (w) w.value = S.operator; }
    bump();
    flash('Saved in this browser. Export and rebuild to put it on the record.');
  };
  const va = $('#varAdd');
  if (va) va.onclick = () => varDialog({scope:'plant', ref:a.key,
    asked:(a.item_types||[])[0] || '', recorded_by:S.operator || ''});
  const tv = $('#toVar');
  if (tv) tv.onclick = () => { state.q = a.key; const qb = $('#q'); if (qb) qb.value = a.key;
    $('#drawer').classList.remove('on'); $('#scrim').classList.remove('on'); go('variances'); };
}

/* ------------------------------------------------------------------ drawer */
/* What a driver on the phone needs, in one message. Andrew Fisher, 12 Sep 2026: from his own phone, an option to
   send the delivery location, its details and the map location to another phone, because drivers will ring
   him. Every line is read off the record — the map location and its callout,
   what the thing is, the asset number where there is one, the day and the load time as the schedule writes it.
   Nothing is invented; a line with nothing behind it is left out rather than filled in. */
function dropText(a, opts){
  const o = opts || {};
  const L = [];
  const ev = (a.events || []).find(e => e.movement !== 'remove') || (a.events || [])[0] || {};
  L.push(`GC500 · ${a.key}${a.name ? ' — ' + a.name : ''}`);
  const lk = (a.drawing_links || [])[0];
  const callout = lk && String(lk.label) !== String(a.key) ? ' · callout ' + lk.label : '';
  const sheet = lk ? ' on ' + lk.sheet : (a.drawing ? ' on ' + a.drawing : '');
  L.push(`Map location: ${a.key}${callout}${sheet}`);
  const types = (a.item_types || []).join(', ');
  const nums = (a.asset_numbers || []).filter(n => String(n).toUpperCase() !== 'MISCITEM');
  const sub = (rentalOf(a.key) || {}).subhires || [];
  L.push(`${types || a.product || 'item'}${nums.length ? ' · asset no. ' + nums.join(', ')
          : sub.length ? ' · subhired, no asset number' : ' · no asset number recorded — write it on the ground'}`);
  const clash = clashOf(a);
  if (clash) L.push((clash.grade === 'contradiction' ? 'CHECK THE PLATE: ' : 'ALREADY DELIVERED ELSEWHERE: ') + clash.words);
  const d = deliveryOf(a.key), eff = effectiveDates(a);
  /* V11 audit, P01. This read `eff.first` — the FIRST scheduled date on the asset — where every other surface
     reads `eff.in`, the day it is actually coming. A drop scheduled on 15 Sep and moved to 18 Sep was copied,
     texted and emailed to a driver as "Due 2026-09-15" while the screen, the timeline and the printed sheet all
     said the 18th. One projection, effectiveDates(), and every output reads the same field of it. */
  const day = (eff && eff.in) || a.first_date;
  if (day) L.push(`Due ${fmtDate(day)}${eff && eff.in_moved && eff.in_plan ? ' (moved from ' + fmtDate(eff.in_plan) + ')' : ''}${d.eta ? ' · planned on site ' + d.eta : ''}${ev.load_time ? ' · load time ' + ev.load_time + ' (as the schedule writes it)' : ''}`);
  /* V11 audit, P02. The destination, and only a destination.

     `w.main || ev.location` put the raw schedule cell back the moment the projection rejected it — which is the
     one case the projection exists for. T0023's cell reads "event container from eags", which names where the
     thing is coming FROM; destinationOf() declines to state that as a destination, and this line then stated it
     anyway, in a message going to a driver. The fallback is gone. Where there is no destination the message
     says so and says what to do, and the source's own wording travels beside it, labelled as the source's. */
  const w = whereText(a), W = w.w;
  if (w.main && w.main !== a.key) L.push(`Drop: ${w.main}${w.also ? ' (' + w.also + ')' : ''} (${W.source})`);
  else {
    L.push(`Drop: DESTINATION NOT RECORDED — confirm before dispatch`);
    if (W.raw && W.raw !== a.key) L.push(`  the schedule's own wording: "${W.raw}" — not confirmed as a destination`);
    else if (ev.location && ev.location !== a.key) L.push(`  the schedule's own wording: "${ev.location}" — not confirmed as a destination`);
  }
  if (ev.carrier) L.push(`Carrier: ${ev.carrier}`);
  /* Directions, in the message itself. A drop card carries a Navigate button, but a card is only made for a load
     somebody has paired — and a driver rung at four in the morning about a single drop has no card. The map link
     is the official Google Maps address scheme, opens in whatever maps app the phone already has, and nothing is
     contacted until he taps it. The coordinates are written out beside it so a phone with no data still has
     something a person can key in. Andrew Fisher, 13 Sep 2026, asked that the drop message show the location too. */
  const nt = navTargetFor(a), ll = nt ? nt.ll : null;
  if (ll && nt.pinned) {
    L.push(`Directions: ${navUrl(ll)}`);
    L.push(`Or key in: ${ll.text} — the spot ${nt.fix.by || 'somebody'} pinned standing at ${fixLabel(nt.key)} (${fixQuality(nt.fix.acc).word}).`);
  } else if (ll) {
    L.push(`Directions: ${navUrl(ll)}`);
    L.push(`Or key in: ${ll.text} — that is the area, not the exact spot. The plan puts it where the card shows.`);
  } else {
    /* No coordinate rather than a wrong one, and the reason in the message. A driver who gets a text with no
       Directions line and no explanation assumes it was forgotten and drives off to find out. */
    const op = offPlanFor(a), mv = movedFor(a);
    L.push(mv ? `LOCATION CHANGED — the pin needs checking. ${movedWords(mv)} Ring before you leave.`
              : `No sat nav point for this one. ${op ? offPlanWords(op) + ' ' : ''}Ring for the exact spot before you leave.`);
  }
  if (o.link) L.push(`The drop card, with the pictures: ${o.link}`);
  L.push('Sent from the GC500 delivery record.');
  return L.join('\n');
}

/* The drop, written as an email somebody actually wants to open. Andrew Fisher, 13 Sep 2026: an email attaches the
   PDF and puts the drop location in the email itself, with the details and pictures, nicely formatted.

   Email is not a web page: every mail client throws away a stylesheet, most throw away flexbox and grid, and
   Outlook renders through Word. So this is written the way email has always had to be written — one column,
   tables for layout, colours and sizes inline on every element. It is dull HTML on purpose, because dull HTML
   is the kind that arrives looking the way it left.

   The pictures come from dropPics(), which cuts the same four windows the printed sheet prints, so the email
   and the paper can never show a different spot. How they are carried depends on where the email is going:

     opts.cid   the pictures are attachments the service sends with the message and the body points at them by
                name (cid:), which is the only way an inline picture reliably survives Outlook and Gmail
     otherwise  the pictures are data: URIs, which is right for the clipboard — pasting into a compose window
                makes the client turn them into its own attachments

   Nothing in here is a second reading of anything: every figure, every instruction and every document name is
   the same function the drop sheet and the map use. */
function dropEmailHtml(a, pics, opts){
  const o = opts || {};
  const e = esc;
  const link = (a.drawing_links || [])[0];
  const where = whereText(a);
  const dv = deliveryOf(a.key) || {}, L = LIGHT[dv.state] || {word: '', label: ''};
  const eff = effectiveDates(a);
  const ev = (a.events || []).find(x => x.movement !== 'remove') || (a.events || [])[0] || {};
  const pt = aerialPointFor(a), ll = pt ? lonLatOf(pt.ax, pt.ay) : null;
  const op = pt ? null : offPlanFor(a);
  const nums = (a.asset_numbers || []).filter(n => String(n).toUpperCase() !== 'MISCITEM');
  const clash = clashOf(a);   /* a number on two references is said beside the number (B01) */
  const gate = heavyGate(), rules_c = DATA.driver_rules || {}, site = DATA.site || {};
  const swms = swmsFor(a);
  const qty = [...new Set((a.events || []).map(x => x.quantity_display).filter(v => v && v !== 'blank'))].join(' / ');
  const carrier = [...new Set((a.events || []).map(x => x.carrier).filter(Boolean))].join(' / ');
  const contacts = dropContacts().concat((site.contacts || []).map(c => ({role: c.role, name: c.name, phone: c.phone})))
    .filter(c => c.phone);
  const race = raceFirstDay ? raceFirstDay() : null;
  const toRace = race && eff.in ? daysBetween(todayIso(), race) : null;

  /* The GC500 palette, written out here rather than referenced, because an email carries no stylesheet with it. */
  const INK = '#14181d', DARK = '#1b1f24', OR = '#ff6a13', OR2 = '#ffa257',
        PAPER = '#ffffff', TINT = '#f7f4f1', RULE = '#e3ded8', MUTE = '#7b746d', RED = '#a4320a';
  const SANS = "'Segoe UI',Helvetica,Arial,sans-serif";
  const W = 600, PAD = 'padding-left:26px;padding-right:26px';
  const eyebrow = (txt, col) => `<div style="font:700 10px/1 ${SANS};letter-spacing:.16em;text-transform:uppercase;color:${col || MUTE}">${txt}</div>`;
  const row = inner => `<tr><td style="${PAD}">${inner}</td></tr>`;
  const gap = h => `<tr><td style="font-size:0;line-height:0;height:${h}px">&nbsp;</td></tr>`;

  /* The two numbers, side by side, the same way they sit at the top of the printed sheet. */
  /* v5.71 — TWENTY NUMBERS STILL FIT ON ONE SHEET. Andrew Fisher gave WC07's twenty toilet asset numbers on
     22 Sep 2026, and one number per line at thirty point is six hundred points of column: the sheet ran to a
     second page, and one drop is one page. So a long list is set in columns and stepped down in size, and the
     common case — a handful of numbers — is left exactly as it was. Laid out as a table rather than with
     columns or flex because this same markup is what goes out as an email, and Outlook understands tables.
     Measured at 1,093 points against A4's 1,043 before; the three-column setting brings WC07 back inside. */
  const assetNosBlock = (ns) => {
    if (ns.length <= 4) return ns.map(e).join('<br>');
    const per = ns.length > 8 ? 3 : 2;
    const size = ns.length > 8 ? '17px' : '22px';
    const cells = ns.map((x, i) =>
      (i && i % per === 0 ? '</tr><tr>' : '') +
      `<td style="padding:0 12px 3px 0;font:800 ${size}/1.25 ${SANS};color:${INK};` +
      `letter-spacing:-.01em;white-space:nowrap">${e(x)}</td>`).join('');
    return `<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>${cells}</tr></table>`;
  };
  const idCell = (label, big, sub, accent) => `<td width="50%" valign="top" style="width:50%;padding:0">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="${TINT}"
           style="background:${TINT};border:1px solid ${RULE};border-top:4px solid ${accent || OR};border-radius:6px">
      <tr><td style="padding:11px 14px 13px">
        ${eyebrow(label)}
        <div style="font:800 30px/1.05 ${SANS};color:${INK};letter-spacing:-.02em;padding-top:7px">${big}</div>
        ${sub ? `<div style="font:400 11.5px/1.4 ${SANS};color:${MUTE};padding-top:5px">${sub}</div>` : ''}
      </td></tr></table></td>`;

  const pic = (src, cap, i) => `<tr><td style="padding:0 0 14px">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="border:1px solid ${INK};border-radius:6px;overflow:hidden">
        <tr><td style="font-size:0;line-height:0">
          <img src="${o.cid ? 'cid:gc500pic' + i : src}" width="546" alt="${e(cap)}"
               style="display:block;width:100%;max-width:546px;height:auto;border:0"></td></tr>
        <tr><td bgcolor="${INK}" style="background:${INK};padding:7px 12px 8px">
          <div style="font:700 10px/1.2 ${SANS};letter-spacing:.1em;text-transform:uppercase;color:${OR2}">${e(cap)}</div>
        </td></tr></table></td></tr>`;

  const steps = [];
  steps.push(['Come over the Sundale Bridge.', 'That is the way in for trucks on this job.']);
  if (gate) steps.push(['Come in here:', e(tidyNote(gate.text)) + '.']);
  if (rules_c.escort) steps.push([e(rules_c.escort), 'Pull up at the gate and wait.']);
  /* F05: a destination the record does not hold is NAMED as missing. This step used to print the product's
     own name — "It goes at FWF" — because whereText() fell back to a.name when the schedule said nothing. */
  if (where.main) steps.push(['It goes at ' + e(where.main) + (/[.!?]$/.test(where.main) ? '' : '.'), pt ? 'The close image shows the planned area; confirm the exact position before you unload.' : '']);
  else steps.push([e(where.w.fallback), pt ? 'The close image shows the planned area; confirm the exact position before you unload.' : 'Ring the supervisor and get the exact position before you leave the yard.']);
  if (!pt) steps.push(['Ring the supervisor before you leave the yard.', op ? e(offPlanWords(op)) : 'There is no photo of this spot — get the exact position confirmed first.']);
  steps.push(['Not sure? Ring. Do not guess.', 'The numbers are at the bottom of this email.']);
  const step = (n, head, tail) => `<tr>
    <td width="30" valign="top" style="width:30px;padding:0 10px 10px 0">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="24"><tr>
        <td bgcolor="${OR}" align="center" height="24" style="background:${OR};width:24px;height:24px;border-radius:12px;
            font:800 12px/24px ${SANS};color:#ffffff">${n}</td></tr></table></td>
    <td valign="top" style="padding:0 0 10px;font:400 14px/1.45 ${SANS};color:${INK}">
      <b style="color:${INK}">${head}</b>${tail ? ' <span style="color:' + MUTE + '">' + tail + '</span>' : ''}</td></tr>`;

  return `<div style="margin:0;padding:0;background:${TINT};-webkit-text-size-adjust:100%">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="${TINT}" style="background:${TINT}">
<tr><td align="center" style="padding:0">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="${W}" bgcolor="${PAPER}"
       style="width:${W}px;max-width:${W}px;background:${PAPER};font-family:${SANS};color:${INK}">

  <tr><td bgcolor="${OR}" style="background:${OR};font-size:0;line-height:0;height:5px">&nbsp;</td></tr>
  <tr><td bgcolor="${DARK}" style="background:${DARK};${PAD};padding-top:22px;padding-bottom:20px">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
      <td valign="top" style="padding:0">
        ${eyebrow(e(DATA.brand.org), OR2)}
        <div style="font:800 27px/1.15 ${SANS};color:#ffffff;letter-spacing:-.02em;padding-top:9px">${eff.in ? 'Delivery — ' + e(fmtDate(eff.in)) : 'Delivery'}</div>
        <div style="font:400 13px/1.4 ${SANS};color:#b9b2ab;padding-top:5px">${e(DATA.event.name)}${
          toRace != null && toRace > 0 ? ' &middot; ' + toRace + ' days to race day' : ''}</div>
      </td>
      <td valign="top" align="right" style="padding:0;width:130px">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="right"><tr>
          <td bgcolor="${OR}" align="center" style="background:${OR};border-radius:6px;padding:9px 16px 10px">
            <div style="font:800 24px/1 ${SANS};color:#ffffff;letter-spacing:-.01em">${e(a.key)}</div>
          </td></tr>
          ${dv.eta ? `<tr><td align="center" style="padding-top:7px;font:400 11.5px/1.3 ${SANS};color:#b9b2ab">on site ${e(dv.eta)}</td></tr>` : ''}
        </table></td>
    </tr></table>
  </td></tr>

  ${gap(20)}
  ${row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
      ${idCell('Map location', e(a.key), link && link.label ? 'callout ' + e(link.label) + ' on ' + e(link.sheet) : (a._given ? 'schedule row ' + e(a.task_id) + ' — reference given on site' : 'not shown on a drawing'))}
      <td width="14" style="width:14px;font-size:0">&nbsp;</td>
      ${idCell('Asset no.', nums.length ? assetNosBlock(nums) : '<span style="font-size:17px;font-weight:400;color:' + MUTE + '">not recorded</span>',
               nums.length ? [(nums.length > 1 ? nums.length + ' numbers on this drop' : ''), (clash ? '<b style="color:' + RED + '">' + (clash.grade === 'contradiction' ? 'Check the plate: ' : 'Delivered elsewhere: ') + e(clash.short) + '</b>' : '')].filter(Boolean).join('<br>')
                           : 'write the number that turns up')}
    </tr></table>`)}

  ${gap(14)}
  ${row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
      style="border-left:5px solid ${OR}"><tr><td style="padding:2px 0 2px 15px">
      ${eyebrow('Where it goes')}
      <div style="font:800 23px/1.25 ${SANS};color:${INK};letter-spacing:-.015em;padding-top:6px">${
        where.main ? e(where.main) : '<span style="font-weight:400;color:' + MUTE + '">' + e(where.w.fallback) + '</span>'}</div>
      <div style="font:400 11.5px/1.4 ${SANS};color:${MUTE};padding-top:4px">${e(where.w.source)}</div>
      ${where.also ? `<div style="font:400 12.5px/1.4 ${SANS};color:${MUTE};padding-top:5px">${e(where.also)}</div>` : ''}
    </td></tr></table>`)}

  ${gap(18)}
  ${pics && pics.list.length ? row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
      ${pics.list.map((x, i) => pic(x[0], x[1], i + 1)).join('')}
      <tr><td style="font:400 11.5px/1.45 ${SANS};color:${MUTE};padding:0 0 4px">
        <b style="color:${INK}">The ring is where the plan puts it, not a GPS fix.</b>
        Check the exact spot with the supervisor before you set it down.</td></tr>
    </table>`) : ''}

  ${gap(6)}
  ${row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
      ${[['What', e((a.item_types || []).join(', ') || a.product || '—')],
         ['Quantity', qty ? e(qty) : '<span style="color:' + MUTE + '">not written</span>'],
         ['Carrier', carrier ? e(carrier) : '<span style="color:' + MUTE + '">not written</span>']]
        .map(([k, v], i) => `${i ? '<td width="10" style="width:10px;font-size:0">&nbsp;</td>' : ''}
          <td valign="top" style="padding:0"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
            style="border:1px solid ${RULE};border-radius:5px"><tr><td style="padding:9px 11px 10px">
            ${eyebrow(k)}<div style="font:700 15px/1.3 ${SANS};color:${INK};padding-top:5px">${v}</div>
          </td></tr></table></td>`).join('')}
    </tr></table>`)}

  ${gap(18)}
  ${row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="${TINT}"
      style="background:${TINT};border:1px solid ${RULE};border-radius:6px">
      <tr><td style="padding:15px 17px 16px">
        ${eyebrow('How to get there', INK)}
        ${(() => { const run = ll ? depotRun(ll) : null; return (run || ll) ? `
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="${PAPER}"
                 style="background:${PAPER};border-radius:5px;margin:11px 0 13px"><tr><td style="padding:10px 12px;
                 font:400 13px/1.45 ${SANS};color:${INK}">${
            run ? `<b>From ${e(DATA.depot.name)}</b> — ${e(run.text)}${run.routed ? ' <span style="color:' + MUTE + '">(TomTom, typical traffic for a Monday 06:30 start — a planning figure; your satnav is live)</span>' : ''}.${
              /* v5.55 — a stale minute count on a driver's sheet is worse than none: he plans his morning on
                 it. Past two days the sheet says so and offers today's run instead. */
              (() => { const gg = run.routed ? snapAge(run.taken_at) : null, lu = liveRunUrl();
                return (gg && gg.stale && lu) ? `<br><span style="color:${MUTE}">That figure is ${e(gg.words)}. <a href="${e(lu)}" style="color:${OR};font-weight:700">Check the run live</a> before you set off.</span>` : ''; })()}` : ''}${
            ll ? `<br><b>Sat nav:</b> <span style="font-family:Consolas,monospace;font-size:12.5px">${e(ll.text)}</span>
                  <span style="color:${MUTE}">— it drops you at the area, not on the spot.</span>` : ''}${
            (() => { const n = nearestStreet(a.key); return n ? `<br><b>Nearest street:</b> ${e(n.address.replace(/, QLD, \d{4}$/, ''))} <span style="color:${MUTE}">(TomTom's nearest address to the drawn spot${n.distance_m != null ? ', about ' + e(String(n.distance_m)) + ' m from it' : ''} — for finding the street, not the site's address)</span>` : ''; })()}${
            /* v5.51 — the EXACT spot, where somebody has pinned it: the drop and each building inside it, for
               the demob crew who go to a building. Andrew Fisher, 18 Sep 2026: the exact location. */
            (() => { const fx = [a.key].concat(pinUnits(a).map(u => fixKey(a.key, u))).map(k => [k, fixOf(k)]).filter(x => x[1] && x[1].lat != null);
              return fx.length ? '<br><br><b>Pinned on site' + (fx.length > 1 ? ' — one per building' : '') + ':</b>' + fx.map(([k, f]) => {
                const q = fixQuality(f.acc), pk = fixParse(k);
                return '<br>' + (pk.unit ? '<b>Asset ' + e(pk.unit) + '</b> ' : '<b>' + e(pk.ref) + '</b> ')
                  + '<a href="' + e(navUrl({lat: f.lat, lon: f.lon})) + '" style="font-family:Consolas,monospace;font-size:12.5px;color:' + INK + '">' + f.lat.toFixed(6) + ', ' + f.lon.toFixed(6) + '</a>'
                  + ' <span style="color:' + MUTE + '">' + e(q.word) + (f.by ? ' · ' + e(f.by) : '') + (f.at ? ' ' + e(fmtStamp(f.at)) : '') + '</span>'
                  + ' <a href="' + e(walkUrl({lat: f.lat, lon: f.lon})) + '" style="color:' + OR + ';font-weight:700">walk to it</a>'
                  + ' <a href="' + e(earthUrl({lat: f.lat, lon: f.lon})) + '" style="color:' + MUTE + '">see it in Earth</a>'; }).join('')
                + '<br><span style="color:' + MUTE + '">A pin is where the phone stood when it was pressed \u2014 the number beside it is how sure the phone was. '
                + 'Driving directions stop at the nearest road; <b>walk to it</b> goes to the pin itself, which is the one that puts you on the spot.</span>' : ''; })()}${
            /* v5.54 — THE WAY IN, for the driver who has never been here. Andrew Fisher, 20 Sep 2026: a picture and
               a pinned entry point showing how to get to the location. It reads
               above nothing and below the pins on purpose: find the turn-in first, then the spot. */
            /* v5.55 — a position put there from outside reaches the driver too, and is never dressed up as a
               pin. Only shown when nobody has stood at that thing; the moment somebody does, the pin above
               replaces it. */
            (() => { const bp = bestPinFor(a); if (bp) return '';
              const pu = bestPlaceFor(a); if (!pu) return '';
              const pp = pu.place;
              return '<br><br><b>Placed, not pinned \u2014 nobody has stood at this yet:</b><br>'
                + '<a href="' + e(navUrl({lat: pp.lat, lon: pp.lon})) + '" style="font-family:Consolas,monospace;font-size:12.5px;color:' + INK + '">'
                + pp.lat.toFixed(6) + ', ' + pp.lon.toFixed(6) + '</a>'
                + ' <span style="color:' + MUTE + '">' + e(placeWords(pp)) + (pp.by ? ' \u00b7 ' + e(pp.by) : '') + (pp.at ? ' ' + e(fmtStamp(pp.at)) : '') + '</span>'
                + '<br><span style="color:' + MUTE + '">Somebody put this where it should go, from the drawing or the map. It has no accuracy because nobody measured it. Treat it as the area, and tell the office when you find the spot.</span>'; })()}${
            (() => { const en = entryOf(a.key); if (!en || en.lat == null) return '';
              const q = fixQuality(en.acc), d = entryToDrop(a.key);
              return '<br><br><b>Way in — where to turn off the street:</b><br>'
                + '<a href="' + e(navUrl({lat: en.lat, lon: en.lon})) + '" style="font-family:Consolas,monospace;font-size:12.5px;color:' + INK + '">'
                + en.lat.toFixed(6) + ', ' + en.lon.toFixed(6) + '</a>'
                + ' <span style="color:' + MUTE + '">' + e(q.word) + (en.by ? ' · ' + e(en.by) : '') + (en.at ? ' ' + e(fmtStamp(en.at)) : '')
                + (d ? ' · ' + d.m + ' m from ' + e(d.basis) : '') + '</span>'
                + ' <a href="' + e(walkUrl({lat: en.lat, lon: en.lon})) + '" style="color:' + OR + ';font-weight:700">walk to it</a>'
                + ' <a href="' + e(earthUrl({lat: en.lat, lon: en.lon})) + '" style="color:' + MUTE + '">see it in Earth</a>'
                + '<br><span style="color:' + MUTE + '">Pinned on site by the person who put it there, standing at the turn-in.</span>'; })()}
          </td></tr></table>` : '<div style="height:11px;font-size:0">&nbsp;</div>'; })()}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
          ${steps.map((s, i) => step(i + 1, s[0], s[1])).join('')}</table>
        ${(rules_c.ppe || []).length ? `<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
          style="border-left:4px solid ${OR};margin-top:4px"><tr><td style="padding:2px 0 2px 11px;
          font:400 12.5px/1.45 ${SANS};color:${INK}"><b>PPE on site:</b> ${rules_c.ppe.map(e).join(' &middot; ')}</td></tr></table>` : ''}
      </td></tr></table>`)}

  ${(() => { /* v5.51 — the button goes to the PINNED spot when there is one, and says so; else to the drawing's area */
      const pf = (bestPinFor(a) || {}).fix || null;   /* v5.54 — the newest pin, not the first key */
      const to = pf && pf.lat != null ? {lat: pf.lat, lon: pf.lon} : ll;
      return to ? gap(16) + row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
      <td bgcolor="${OR}" align="center" style="background:${OR};border-radius:6px">
        <a href="${e(navUrl(to))}" style="display:block;padding:17px 14px;font:800 17px/1 ${SANS};
           color:#ffffff;text-decoration:none;letter-spacing:.01em">${pf && pf.lat != null ? 'Open the pinned spot in maps' : 'Open it in maps'} &nbsp;&rarr;</a>
      </td></tr></table>`) : ''; })()}

  ${(swms.docs.length || swms.gaps.length) ? gap(16) + row(`
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
           style="border:1px solid ${INK};border-left:6px solid ${OR};border-radius:6px">
      <tr><td style="padding:13px 15px 14px;font:400 12.5px/1.5 ${SANS};color:${INK}">
        <div style="font:800 15px/1.3 ${SANS};color:${INK};padding-bottom:6px">Before you load: read the SWMS for this job.</div>
        ${swms.docs.length ? '<b>Your SWMS:</b> ' + swms.docs.map(d => e(String(d.title || '').split(' — ')[0])).join('<br>&nbsp;&nbsp;&nbsp;&nbsp;&middot; ') + '<br>' : ''}
        ${swms.gaps.length ? `<b style="color:${RED}">No SWMS in this package for ${e(swms.gaps.join(' or '))}.</b>
          Ring the supervisor for the one that covers it.<br>` : ''}
        <span style="color:${MUTE}">${(() => { const u = docsQrUrl(); return u
          ? 'Open them on the GC500 page: <a href="' + e(u) + '" style="color:' + INK + ';font-weight:700">Documents</a>.'
          : 'They are on the GC500 page, under Documents.'; })()} Read yours before you arrive and keep it on you.</span>
      </td></tr></table>`) : ''}

  ${contacts.length ? gap(16) + row(`
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="${DARK}"
           style="background:${DARK};border-radius:6px">
      <tr><td style="padding:14px 16px 15px">
        <div style="font:800 15px/1.3 ${SANS};color:#ffffff;padding-bottom:9px">Anything wrong — ring, do not guess.</div>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
          ${contacts.map(c => `<tr>
            <td valign="top" style="padding:0 0 7px;font:400 12.5px/1.4 ${SANS};color:#b9b2ab">
              ${eyebrow(e(c.role), OR2)}
              <span style="color:#ffffff;font-size:13.5px">${e(c.name)}</span>
              <a href="tel:${e(String(c.phone).replace(/[^0-9+]/g, ''))}"
                 style="color:${OR2};font-weight:800;font-size:14px;text-decoration:none">${e(c.phone)}</a>
            </td></tr>`).join('')}
          <tr><td style="padding:3px 0 0;font:400 12.5px/1.4 ${SANS};color:#b9b2ab">
            ${eyebrow('Emergency', OR2)}
            <a href="tel:000" style="color:#ffffff;font-weight:800;font-size:15px;text-decoration:none">000</a>
          </td></tr></table>
      </td></tr></table>`) : ''}

  ${gap(20)}
  ${row(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
      style="border-top:1px solid ${RULE}"><tr><td style="padding:13px 0 26px;font:400 10.5px/1.6 ${SANS};color:${MUTE}">
      <b style="color:${INK}">${e(DATA.brand.org)}</b> &middot; ${e(DATA.event.name)} &middot; Author: ${e(DATA.brand.author || 'Andrew Fisher')}<br>
      Read from the record as at ${e(fmtDate(todayIso()))} &middot; dataset ${e(String(DATA.dataset_sha256 || '').slice(0, 12))}<br>
      A blank is a number nobody has recorded yet — never a zero, never a guess.
    </td></tr></table>`)}

</table></td></tr></table></div>`;
}
function dropEmailSubject(a){
  const eff = effectiveDates(a);
  return `${DATA.event.name} · ${a.key}${a.name ? ' — ' + a.name : ''}${eff.in ? ' · ' + fmtDate(eff.in) : ''}`;
}
/* Text this drop. Andrew Fisher, 13 Sep 2026, asked whether the same thing could go by text. It can, and the
   right shape for it is not a picture: a text carries a link to the drop card, which opens the pictures, the
   directions and a Navigate button on the driver's own phone, costs one message instead of several, and reaches
   handsets that squash an MMS to porridge. Where a card has been made for a load, its own link goes; where none
   has, the viewing link to this asset does.

   Nothing is sent without somebody typing a number and pressing Send. That was the rule for the texts from the
   start and it has not changed. */
function dropSmsText(a){
  const rec = (S.loads && Object.values(S.loads).find(l => (l.keys || []).includes(a.key) && l.card && webLink(l.card.url))) || null;
  const s = shareBase();
  const link = rec ? rec.card.url : (s.shared ? s.url + '#asset/' + encodeURIComponent(a.key) : null);
  return dropText(a, {link});
}
async function smsDropBox(a){
  let ready = false, today = null;
  try { const r = await fetch('/api/sms', {headers: {'x-gc500-token': tokenOf()}}); const j = await r.json();
        ready = !!j.configured && !SYNC.readonly; today = j.today || null; } catch (e) {}
  const text = dropSmsText(a);
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 31; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
  d.innerHTML = `<div class="dh"><div><h2>Text ${esc(a.key)}</h2>
      <div class="sub">${ready ? 'Goes from this service through ClickSend. The link opens the card with the pictures.'
        : 'Texting is not switched on here, so this copies the words for you to send yourself.'}</div></div>
    <button class="close" aria-label="Close" title="Close">&times;</button></div>
    <div class="db">
      ${ready ? `<div class="f"><label for="smTo">Send to</label>
        <input id="smTo" type="tel" inputmode="tel" autocomplete="off" placeholder="0429 352 788 — a few, separated by commas"></div>` : ''}
      <div class="f"><label for="smTx">The message</label>
        <textarea id="smTx" rows="7" style="width:100%;font:inherit">${esc(text)}</textarea></div>
      <p class="hint" id="smMsg">${today ? esc(today.left + ' of today\'s ' + today.cap + ' left') : ''}</p>
      <div class="df" style="padding:0">
        ${ready ? `<button class="btn ghost" id="smDry">Check it, send nothing</button>
                   <button class="btn primary" id="smGo">Send</button>` : ''}
        <button class="btn" id="smCopy">Copy the words</button>
        <a class="btn" id="smOpen" href="sms:?&body=${encodeURIComponent(text)}">Open a text message</a>
      </div>
    </div>`;
  mounted(document.body.appendChild(d));
  const close = () => d.remove();
  d.querySelector('.close').onclick = close;
  const msg = d.querySelector('#smMsg');
  d.querySelector('#smCopy').onclick = async () => {
    try { await navigator.clipboard.writeText(d.querySelector('#smTx').value); flash('Copied.'); }
    catch (e) { msg.textContent = 'Your browser would not let the page copy — select the words and copy them.'; }
  };
  if (ready) {
    const run = async dry => {
      const to = d.querySelector('#smTo').value.split(/[,;\s]+/).map(x => x.trim()).filter(Boolean);
      if (!to.length) { msg.textContent = 'Put a number in first.'; return; }
      const go = d.querySelector('#smGo'), dv = d.querySelector('#smDry');
      go.disabled = dv.disabled = true; msg.textContent = dry ? 'Checking…' : 'Sending…';
      try {
        const r = await fetch('/api/sms', {method: 'POST',
          headers: {'Content-Type': 'application/json', 'x-gc500-token': tokenOf(),
                    'x-gc500-who': (S.operator || '').trim() || 'unnamed'},
          body: JSON.stringify({to, text: d.querySelector('#smTx').value, dry_run: !!dry})});
        const j = await r.json();
        if (!r.ok) msg.innerHTML = '<b>Nothing was sent.</b> ' + esc(j.error || ('the service answered ' + r.status));
        else if (dry) msg.innerHTML = 'It reads fine: <b>' + j.messages + '</b> message'
          + (j.messages === 1 ? '' : 's') + ', ' + j.shape.parts + ' part' + (j.shape.parts === 1 ? '' : 's')
          + ' each. Nothing has been sent.';
        else { msg.innerHTML = '<b>Sent</b> to ' + esc(j.to.join(', ')) + '.'; setTimeout(close, 2400); }
      } catch (e) { msg.textContent = 'Nothing was sent: ' + (e && e.message || e); }
      finally { go.disabled = dv.disabled = false; }
    };
    d.querySelector('#smGo').onclick = () => run(false);
    d.querySelector('#smDry').onclick = () => run(true);
    d.querySelector('#smTo').focus();
  }
}
/* Can this copy of the page ask the service to send an email? Only the hosted edition has a service at all, and
   only an editing link may send — the same rule the texts follow. The answer is asked for once and kept, so a
   button does not go to the network every time somebody opens an asset. */
const MAILER = {asked: false, ready: false, why: '', today: null};
async function mailerState(force){
  if (MAILER.asked && !force) return MAILER;
  MAILER.asked = true;
  if (DATA.edition !== 'hosted' || !SYNC.backend) { MAILER.ready = false; MAILER.why = 'file'; return MAILER; }
  try {
    const r = await fetch('/api/email', {headers: {'x-gc500-token': tokenOf()}});
    const j = await r.json();
    MAILER.ready = !!j.configured && !SYNC.readonly;
    MAILER.why = j.configured ? (SYNC.readonly ? 'view' : '') : 'not set up';
    MAILER.today = j.today || null;
    MAILER.atOnce = j.at_once || 20;
  } catch (e) { MAILER.ready = false; MAILER.why = 'service did not answer'; }
  return MAILER;
}
/* Hand the email to the service to send: the body the page composed, the four pictures as inline attachments so
   they survive Outlook and Gmail (a data: URI does not), and the addresses somebody typed. */
async function sendDropEmail(a, to, dry){
  const pics = await dropPics(a); // a failed known picture must stop sending, not silently disappear
  const html = dropEmailHtml(a, pics, {cid: true});
  const attachments = (pics ? pics.list : []).map((x, i) => ({
    content: String(x[0]).split(',')[1] || '', type: 'image/jpeg',
    filename: a.key + '-' + (i + 1) + '.jpg', content_id: 'gc500pic' + (i + 1)}));
  const r = await fetch('/api/email', {
    method: 'POST',
    headers: {'Content-Type': 'application/json', 'x-gc500-token': tokenOf(), 'x-gc500-who': (S.operator || '').trim() || 'unnamed'},
    body: JSON.stringify({to, subject: dropEmailSubject(a), html, attachments, dry_run: !!dry}),
  });
  let j = null; try { j = await r.json(); } catch (e) {}
  return {ok: r.ok, status: r.status, j: j || {}};
}
/* The send box. Nothing goes out without somebody typing an address into it and pressing Send — Andrew Fisher's
   rule for the texts, kept for the email: no message leaves this page on its own. */
function emailSendBox(a){
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 31; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
  d.innerHTML = `<div class="dh"><div><h2>Email ${esc(a.key)}</h2>
      <div class="sub">The whole drop — where it goes, the four pictures, the directions, the SWMS and the numbers.</div></div>
    <button class="close" aria-label="Close" title="Close">&times;</button></div>
    <div class="db">
      <div class="f"><label for="emTo">Send to</label>
        <input id="emTo" type="text" inputmode="email" autocomplete="off"
               placeholder="name@coates.com.au — separate a few with commas"></div>
      <p class="hint" id="emMsg">${MAILER.today ? esc(MAILER.today.left + ' of today\'s ' + MAILER.today.cap + ' left') : ''}</p>
      <div class="df" style="padding:0">
        <button class="btn ghost" id="emDry">Check it, send nothing</button>
        <button class="btn primary" id="emGo">Send</button>
        <button class="btn" id="emCopy">Copy it instead</button>
      </div>
    </div>`;
  mounted(document.body.appendChild(d));
  const close = () => d.remove();
  d.querySelector('.close').onclick = close;
  const to = () => d.querySelector('#emTo').value.split(/[,;\s]+/).map(x => x.trim()).filter(Boolean);
  const msg = d.querySelector('#emMsg');
  const run = async dry => {
    const list = to();
    if (!list.length) { msg.textContent = 'Put an address in first.'; return; }
    const go = d.querySelector('#emGo'), dv = d.querySelector('#emDry');
    go.disabled = dv.disabled = true; msg.textContent = dry ? 'Checking…' : 'Building the pictures and sending…';
    try {
      const r = await sendDropEmail(a, list, dry);
      if (!r.ok) { msg.innerHTML = '<b>Nothing was sent.</b> ' + esc(r.j.error || ('the service answered ' + r.status)); }
      else if (dry) { msg.innerHTML = 'It reads fine: <b>' + r.j.to.length + '</b> address'
        + (r.j.to.length === 1 ? '' : 'es') + ', ' + r.j.attachments.length + ' pictures, '
        + (r.j.bytes / 1024).toFixed(0) + ' kB. Nothing has been sent.'; }
      else { msg.innerHTML = '<b>Sent</b> to ' + esc(r.j.to.join(', ')) + '.'
        + (r.j.today ? ' ' + r.j.today.left + ' of today\'s ' + r.j.today.cap + ' left.' : '');
        setTimeout(close, 2600); }
    } catch (e) { msg.textContent = 'Nothing was sent: ' + (e && e.message || e); }
    finally { go.disabled = dv.disabled = false; }
  };
  d.querySelector('#emGo').onclick = () => run(false);
  d.querySelector('#emDry').onclick = () => run(true);
  d.querySelector('#emCopy').onclick = async () => { if (await copyDropEmail(a)) close(); };
  d.querySelector('#emTo').focus();
}
/* Put the formatted email on the clipboard, pictures and all, so it can be pasted straight into Outlook or
   Gmail. A mailto: link cannot do this — it carries plain text and it cannot attach anything, which is an
   operating-system limit and not something a page can work round. Pasting can: the compose window takes the
   HTML, and turns the pictures into its own attachments on the way in. The plain text goes on the clipboard
   beside it, so a client that wants text gets the same words rather than a tag soup. */
async function copyDropEmail(a){
  let pics = null;
  try { pics = await dropPics(a); } catch (e) { flash('Email was not copied: ' + (e.message || 'a picture could not load') + '. Please retry.'); return false; }
  const html = dropEmailHtml(a, pics);
  const text = dropText(a, {});
  try {
    if (window.ClipboardItem && navigator.clipboard && navigator.clipboard.write) {
      await navigator.clipboard.write([new ClipboardItem({
        'text/html': new Blob([html], {type: 'text/html'}),
        'text/plain': new Blob([text], {type: 'text/plain'}),
      })]);
      flash(pics && pics.list.length ? 'Email copied with the pictures. Paste it into a new message — then attach the printed sheet if you want the PDF.' : 'Email copied. No location pictures are available for this reference.');
      return true;
    }
  } catch (e) {}
  try { await navigator.clipboard.writeText(text);
        flash('Your browser would not take the formatted version, so the plain words are copied instead.');
        return false; } catch (e) {}
  emailFallback(a, html, text, !!(pics && pics.list.length));
  return false;
}
/* Where the clipboard is refused altogether — an old browser, or a page not allowed to write to it — the email
   is put on the screen to be copied by hand rather than lost. */
function emailFallback(a, html, text, hasPictures){
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 31; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
  d.innerHTML = `<div class="dh"><div><h2>Email for ${esc(a.key)}</h2>
      <div class="sub">${hasPictures ? 'Select it all and copy — it pastes into Outlook with the pictures.' : 'Select it all and copy — no location pictures are available for this reference.'}</div></div>
    <button class="close" aria-label="Close" title="Close">&times;</button></div>
    <div class="db"><div id="emlBody" contenteditable="true" style="border:1px solid var(--rule);border-radius:8px;
      padding:10px;max-height:52vh;overflow:auto;background:#fff">${html}</div></div>`;
  mounted(document.body.appendChild(d));
  d.querySelector('.close').onclick = () => d.remove();
  const b = d.querySelector('#emlBody');
  const r = document.createRange(); r.selectNodeContents(b);
  const s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
}
/* the phone's own share sheet where there is one (Messages, WhatsApp, mail); the clipboard where there is not */
async function shareDrop(a){
  const rec = (S.loads && Object.values(S.loads).find(l => (l.keys || []).includes(a.key) && l.card && webLink(l.card.url))) || null;
  const text = dropText(a, {link: rec ? rec.card.url : null});
  try {
    if (navigator.share) { await navigator.share({title: 'GC500 · ' + a.key, text}); return; }
  } catch (e) { if (e && e.name === 'AbortError') return; }
  try { await navigator.clipboard.writeText(text); flash('Copied — paste it into a message.'); return; } catch (e) {}
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
  d.innerHTML = `<div class="dh"><div><h2>Send ${esc(a.key)}</h2><div class="sub">Copy this and send it however you like.</div></div>
    <button class="close" aria-label="Close" title="Close">&times;</button></div>
    <div class="db"><textarea rows="10" style="width:100%;font:inherit" readonly>${esc(text)}</textarea>
    <p><a class="btn" href="sms:?&body=${encodeURIComponent(text)}">Open a text message</a></p></div>`;
  mounted(document.body.appendChild(d));
  d.querySelector('.close').onclick = () => d.remove();
  const ta = d.querySelector('textarea'); ta.focus(); ta.select();
}

/* ------------------------------------------------------------------ which photograph stands for this product
   Andrew Fisher's own mapping, and nothing beyond it. The picture is of the PRODUCT at that size, never of the
   asset, and a product he has not supplied a photograph for gets none — not a near-enough one from the same
   discipline. Two examples of why the list is short on purpose:

     FWF is the most-scheduled product on this job, 68 rows of it, and it is a single fresh-water-flush cubicle.
     The only photograph of one in the package is a 250 px thumbnail its own manifest marks "not used on a card".
     So an FWF row shows NO picture. Putting the eight-door block on it — the nearest toilet photograph there is
     — would have a driver looking for a six-metre block when a single cubicle is what is going on the truck.

     A Ticket Box 6m is a portable building at a size we have a photograph for, and it is not that product. No
     picture.

   `says` is what the card prints under the picture. It names the product class, so nobody reads the photograph
   as a picture of the thing they are collecting. */
function productPhoto(a, opts){
  const P = (DATA.product_photos || {});
  const prod = String(a.product || a.discipline || '').toLowerCase();
  /* An asset is one reference and can carry more than one type — the schedule puts a building and its fridge on
     the same row. The photograph is only shown when EVERY type on the reference maps to the same picture: two
     different products under one reference have no single photograph, and picking one of them would caption the
     card with the wrong object. */
  const types = (a.item_types || []).map(x => String(x).toLowerCase().trim()).filter(Boolean);
  const notes = String((a.events || []).map(e => e.note || '').join(' ')).toLowerCase();
  const pick = k => P[k] ? {key: k, src: P[k].src, kind: P[k].kind || 'photo', says: P[k].says} : null;
  const keyFor = t => {
    if (prod.indexOf('portable building') > -1 || prod.indexOf('building') > -1) {
      /* only the plain site-office sizes Andrew Fisher mapped. A ticket box and an event container are their own
         products at the same size and there is no photograph of either; a 3.6 m building was never mapped. */
      if (/^building\s*(4\.8|6)\s*m?\b/.test(t)) return 'buildings_6x3';
      if (/^building\s*(9\.6|12)\s*m?\b/.test(t)) return 'buildings_12x3';
      /* the two Andrew Fisher added on 14 Sep: the 3.6 m building and the event container. A ticket box is still
         its own product with no picture. */
      if (/^building\s*3\.6\s*m?\b/.test(t)) return 'buildings_3p6';
      if (/event container/.test(t)) return 'event_container';
      if (/ticket box/.test(t)) return 'ticket_box';
      return null;
    }
    if (prod.indexOf('toilet') > -1 || prod.indexOf('amenit') > -1) {
      /* the three real Coates pictures Andrew Fisher saved off the catalogue on 14 Sep, matched to the item
         types the schedule actually writes. A waste tank still has no picture and shows none. */
      if (/accessible/.test(t)) return 'toilet_access';
      if (/trailer/.test(t)) return 'toilet_trailer';
      /* 16Pan Block wears the eight-door block photograph. It IS a smaller unit and the page said so; Andrew
         Fisher, 14 Sep 2026: the 16-pan block uses the same picture, the 6 m block photo being a smaller unit. His call,
         made knowing the difference, and the caption says which unit is in the picture. */
      if (/\b16\s*pan\b|16pan/.test(t)) return 'toilets_8door';
      if (/toilet block/.test(t)) return (/\b8\b|eight/.test(t + ' ' + notes)) ? 'toilets_8door' : 'toilets_mf';
      if (/\bfwf\b/.test(t)) return 'toilet_fwf';
      if (/waste tank/.test(t)) return 'waste_tank';
      return null;
    }
    if (prod.indexOf('lighting tower') > -1 || prod.indexOf('light tower') > -1) return 'light_tower';
    /* GENERATORS ARE SIZED, and each picture names the MODEL it is. Andrew Fisher, 14 Sep 2026: each generator
       picture matches its size. The register runs 20 kVA to 350 kVA and those
       are not the same object on a gate. Coates' own catalogue splits at 50 kVA and reuses one picture across
       a band, so this does the same and says which model is in the picture. A row with no size on it gets no
       picture: there is nothing to match. */
    if (prod.indexOf('generator') > -1) {
      const kv = (t.match(/(\d+(?:\.\d+)?)\s*kva/) || [])[1];
      if (!kv) return null;
      const n = parseFloat(kv);
      return n < 50 ? 'gen_qas14' : n <= 100 ? 'gen_qas80' : n < 200 ? 'gen_qas150' : 'gen_qas200';
    }
    /* Only the ROUGH TERRAIN rows. The photograph is a rough-terrain machine — big knobbly tyres, high
       clearance — and a standard warehouse forklift does not look like that. The STD and 5T rows show no
       picture until there is a photograph of one. */
    if (/forklift/.test(prod + ' ' + t) && /\brt\b|rough\s*terrain/.test(t)) return 'forklift_rt';
    /* the standard machine Andrew sent is a 3 t class counterbalance (MI30D) — it stands for the 2.5 and 3.5 t
       standard rows. A 5 t is a visibly bigger machine and stays without until there is a picture of one. */
    if (/forklift/.test(prod + ' ' + t) && /\b(2\.5|3\.0|3\.5)\s*t\b/.test(t)) return 'forklift_std';
    /* the schedule writes the product as WFB and the item type as TL2 — match what it writes, not the prose */
    if (/^wfb$|water[- ]filled barrier/.test(prod) || /^tl2$/.test(t)) return 'water_barriers';
    /* the Coates VMS trailer, saved off the catalogue by Andrew Fisher on 14 Sep — the schedule writes VMS as both
       the product and the item type */
    if (/^vms$|variable message/.test(prod) || /^vms$/.test(t)) return 'vms_trailer';
    if (/trakmat|ground protection/.test(prod + ' ' + t)) return 'trakmat';
    /* MADE PICTURES ARE ONLY SHOWN WHERE THEY HAVE BEEN CHECKED AGAINST A REAL COATES SOURCE.
       Andrew Fisher, 14 Sep 2026: never guess how equipment looks, colours included. He caught this and
       he was right. Checked against coates.com.au the same afternoon:
         · a Coates portable toilet is TEAL with a YELLOW roof, and the accessible one is BLUE. Every toilet
           picture made that morning was Coates orange. Not a near miss — the wrong object.
         · Coates splits diesel generators at 50 kVA, not at the 60/150 boundaries invented here, and the real
           sets are an orange canopy on a GREY skid.
         · a Coates lighting tower carries a tall vertical mast with four small LED heads at the top, not a
           short mast with four big floodlights.
       So a picture goes back in only once it is checked, and until then a reference shows the honest empty
       slot it showed before. A wrong picture is worse than no picture: an empty slot tells a driver to go and
       look, and a confident wrong one tells him he already knows.
       The water barrier is the exception and the reason the rule works — it is checked against the yard
       photograph Andrew supplied on 11 Sep, orange MASH TL-2, and it carries that marking on its face. */
    return null;
  };
  if (!types.length) return null;
  if (opts && opts.each) {
    /* one picture PER PRODUCT on the reference, for the five references that carry two — WC31 is an accessible
       toilet AND a sixteen-pan block, and one picture of either would misdescribe it. Both, each captioned, is
       the honest card. Only returned when every product on the reference has its own picture. */
    const each = types.map(t => ({type: t, pic: pick(keyFor(t))}));
    if (each.length < 2 || each.some(e => !e.pic)) return null;
    const seen = new Set(); const out = [];
    each.forEach(e => { if (!seen.has(e.pic.key)) { seen.add(e.pic.key); out.push(e); } });
    return out;
  }
  const keys = [...new Set(types.map(keyFor))];
  if (keys.length !== 1 || !keys[0]) return null;
  return pick(keys[0]);
}
/* what to say where there is no picture — this is information, not an empty box: it tells Andrew Fisher which
   product photographs are worth sending, and it stops anybody assuming the absence is a loading fault */
function productPhotoGap(a){
  const types = (a.item_types || []).filter(Boolean);
  const prod = String(a.product || a.discipline || 'this product').trim();
  if (types.length > 1) return 'More than one product on this reference (' + types.join(', ') + ') \u2014 no single photograph stands for it.';
  return 'No reference photograph supplied for ' + String(types[0] || prod).toLowerCase() + '.';
}
/* ------------------------------------------------------------------ an equipment card
   Andrew Fisher, 14 Sep 2026: product photos, bold references, asset-number pills and visible planning gaps.
   The gaps are the point: an asset number nobody has recorded, a position nothing places, a row the demob weeks
   never mention. They are shown as amber chips with their words, in the same key as everywhere else. */
function equipmentCard(a, opts){
  const o = opts || {};
  const ph = productPhoto(a);
  const d = deliveryOf(a.key);
  const nums = a.asset_numbers || [];
  const ev = effectiveDates(a);
  const gaps = [];
  if (!nums.length) gaps.push('Asset number missing');
  if (!aerialPointFor(a)) gaps.push(movedFor(a) ? 'Position changed, not confirmed' : 'Drop position not verified');
  if (!ev.out) gaps.push('No demob row in the schedule');
  return `<button type="button" class="cut eqc${o.on ? ' on' : ''}" data-eq="${esc(a.key)}" aria-pressed="${!!o.on}"
      aria-label="${esc(a.key)} ${esc(a.name || a.item || '')}${gaps.length ? ', ' + gaps.length + ' to check' : ''}"><span class="face">
    <span class="eqstat">${dstat(a, {size: 'sm'})}${doneChip(a)}${navBtn(a, {small: true, quiet: true})}</span>
    ${(() => {
      const shot = dropPhotosOf(a.key)[0], sr = shot ? photoFor(shot) : {state: 'none'};
      if (shot && sr.state === 'ready') return `<span class="eqpic"><img src="${esc(sr.url)}" alt="${esc(dropPhotoSays(a.key, shot))}" loading="lazy" data-dphimg>
          <span class="eqpl live">On site</span></span>
        <span class="eqcap">${esc(dropPhotoSays(a.key, shot))}</span>`;
      /* F03: somebody photographed this drop and the picture cannot be found. Saying so beats quietly showing
         a catalogue picture of the product in its place — the missing photograph is the thing to act on. */
      if (shot && sr.state !== 'none') return `<span class="eqpic">${photoBlock(sr, shot, a.key)}</span>
        <span class="eqcap">${esc(dropPhotoSays(a.key, shot))}</span>`;
      /* A made picture never wears the word "photo". Three different claims, three different tabs: ORANGE
         "On site" is a photograph of this drop, dark "Reference photo" is a photograph of the product, and
         "Illustration" is a picture nobody took. */
      if (ph) return `<span class="eqpic"><img src="${ph.src}" alt="${esc((ph.kind === 'made' ? 'Illustration of a ' : '') + ph.says)}" loading="lazy">
          <span class="eqpl${ph.kind === 'made' ? ' made' : ''}">${ph.kind === 'made' ? 'Illustration' : 'Reference photo'}</span></span>
        <span class="eqcap">${esc(ph.says)} — ${ph.kind === 'made'
          ? 'a made picture, not this unit'
          : 'the product, not this one'}</span>`;
      const pair = productPhoto(a, {each: true});
      if (pair) return `<span class="eqpair">${pair.map(e => `<span class="eqpic"><img src="${e.pic.src}" alt="${esc(e.pic.says)}" loading="lazy">
          <span class="eqpl${e.pic.kind === 'made' ? ' made' : ''}">${e.pic.kind === 'made' ? 'Illustration' : 'Reference photo'}</span></span>`).join('')}</span>
        <span class="eqcap">${esc(pair.map(e => e.type).join(' + '))} — two products on one reference, one picture of each; the products, not these units</span>`;
      return `<span class="eqnopic"><i aria-hidden="true">—</i>${esc(productPhotoGap(a))}</span>`;
    })()}
    <span class="eqk">${esc((a.discipline || '').toUpperCase())}</span>
    ${refPlate(a.key, 30)}
    <span class="eqn">${esc(a.name || a.item || a.key)}</span>
    <span class="eqi">${esc([a.product, a.item].filter(Boolean).join(' · ') || '—')}</span>
    <span class="eqpills">
      ${nums.length ? nums.slice(0, 2).map(n => `<span class="pill plan">Asset <b>${esc(n)}</b></span>`).join('') : ''}
      ${nums.length > 2 ? `<span class="pill none">and ${nums.length - 2} more</span>` : ''}
      ${gaps.map(g => `<span class="pill gap">${esc(g)}</span>`).join('')}
    </span>
    <span class="cutfoot"><span class="lab">${o.on ? 'Selected' : 'Open'} <i aria-hidden="true">↗</i></span>
      <span class="slash" aria-hidden="true">//</span></span>
  </span></button>`;
}
/* ------------------------------------------------------------------ a load time, as the workbook writes it
   The Load Time column arrived in the 12 Sep 2026 revision, and across the whole schedule it is written six
   different ways:

     blank (211 rows) · four digits, 1200 and 1300 · three digits, 930, 830, 430, 500, 600 ·
     two times in one cell, 0500/0830 and 0530/0530 and "0700 OR 0730" · NA · and "Black Diamond", twice,
     which is a carrier's name sitting in the load-time column.

   The page has never turned these into a time of day and it does not start now. It prints what the cell says,
   gives the plain reading where there is only one, and asks the question where there is more than one — because
   "430" is 04:30 to the yard and half past four in the afternoon to anybody reading it cold, and a truck booked
   on the wrong one of those is a truck that turns up twelve hours out. */
function loadTimeRead(v){
  const raw = String(v == null ? '' : v).trim();
  const two = n => String(n).padStart(2, '0');
  if (!raw) return {raw: null, state: 'none', reads: null, say: 'not stated on the schedule row'};
  if (/^(na|n\/a|tbc|tba)$/i.test(raw))
    return {raw, state: 'none', reads: null, say: 'the row says ' + raw.toUpperCase() + ' — no load time given'};
  /* two times in one cell: 0500/0830, 0530/0530, "0700 OR 0730" */
  if (/\d/.test(raw) && /(\/|\bor\b)/i.test(raw))
    return {raw, state: 'check', reads: null,
            say: 'the cell gives more than one time. Confirm which of them this load is on before it is booked.'};
  if (/^\d{1,2}:\d{2}\s*(am|pm)?$/i.test(raw))
    return {raw, state: 'clear', reads: raw, say: 'written as a time of day, and reads one way'};
  if (/^\d{4}$/.test(raw)) {
    const h = Number(raw.slice(0, 2)), m = Number(raw.slice(2));
    if (h <= 23 && m <= 59)
      return {raw, state: 'clear', reads: raw.slice(0, 2) + ':' + raw.slice(2),
              say: 'four digits — ' + raw.slice(0, 2) + ':' + raw.slice(2) + ' on a 24-hour clock, and reads one way'};
  }
  if (/^\d{3}$/.test(raw)) {
    const h = Number(raw.slice(0, 1)), m = raw.slice(1);
    if (Number(m) <= 59)
      return {raw, state: 'check', reads: '0' + h + ':' + m,
              say: 'three digits. With the leading zero put back it is ' + two(h) + ':' + m + ', but the same column '
                 + 'carries four-digit times, so it could as easily have been meant as ' + two(h + 12) + ':' + m
                 + '. Confirm with whoever wrote the row before the truck is booked.'};
  }
  if (!/\d/.test(raw))
    return {raw, state: 'check', reads: null,
            say: 'the cell holds no time at all — it reads “' + raw + '”, which looks like it belongs in another '
               + 'column. Confirm what was meant; this page will not guess a time from it.'};
  return {raw, state: 'check', reads: null,
          say: 'not a form this page can read as a time. Confirm it before the truck is booked.'};
}
/* ------------------------------------------------------------------ the load brief
   Andrew Fisher, 14 Sep 2026: carrier, docket, equipment and load time in one clear view, with the supplied 930
   still flagged for clarification.

   Every field on it is headed AS SUPPLIED, because every one of them is a cell somebody typed into the schedule
   and none of it has been confirmed by the carrier through this page. */
/* v5.81 — THE SCHEDULE'S OWN TRANSPORT COST. The 24 Sep 2026 workbook carries a TPORT COST column: "$996.32+",
   "$290+", 1151.62, "Internal". It is read as written — the "+" is the workbook's mark (read as: and the rest, ex
   GST — not settled) and is kept; Internal is a Coates truck, no carrier charge. One figure per reference, from
   the first placement row that carries one; it is shown beside the carrier and counted on the Pricing tab as
   what the schedule says transport costs, apart from the card's transport charge. */
function transportCostOf(a){
  const e = (a.events || []).find(x => x.transport_cost && (x.transport_cost.amount != null || x.transport_cost.internal || x.transport_cost.as_written));
  if (!e) return null;
  const t = e.transport_cost;
  if (t.internal) return {amount: null, internal: true, plus: false, as_written: t.as_written, words: 'Internal — Coates truck', note: 'no carrier charge on the row', event: e};
  if (t.amount != null) return {amount: t.amount, internal: false, plus: !!t.plus, as_written: t.as_written, words: money(t.amount) + (t.plus ? '+' : ''),
                                 note: t.plus ? 'the workbook writes a plus after it — the figure and more, ex GST; not settled' : 'as written on the row', event: e};
  return {amount: null, internal: false, plus: !!t.plus, as_written: t.as_written, words: String(t.as_written), note: 'not a figure this page can read', event: e};
}
function loadBrief(a){
  const evs = (a.events || []).filter(e => e.carrier || e.dd || e.load_time);
  if (!evs.length) return '';
  const e = evs[0];
  const lt = loadTimeRead(e.load_time);
  const flags = [];
  if (lt.state === 'check') flags.push('Load time format unconfirmed');
  if (!aerialPointFor(a)) flags.push(movedFor(a) ? 'New drop position not confirmed' : 'Exact drop position unverified');
  if (!e.dd) flags.push('No delivery docket on the row');
  if (!e.carrier) flags.push('No carrier on the row');
  const clash = clashOf(a);
  if (clash) flags.push(clash.grade === 'contradiction'
    ? 'Asset number on two references — ' + clash.short + '; check the plate'
    : 'Asset number already delivered elsewhere — ' + clash.short);
  const nums = a.asset_numbers || [];
  return `<div class="lbrief">
    <div class="lbhead"><div><p class="lbk">Transport · ${esc((e.phase || '').toUpperCase())}</p><h3>Load brief</h3></div>
      <div class="lbwhen"><span>Schedule row</span><b>${esc(e.date_display ? fmtDate(e.date) : (e.date || '—'))}</b></div></div>
    <div class="cut lbband"><span class="face">
      <span class="lbcar"><span class="lbck">Carrier, as supplied</span>
        <b>${esc(e.carrier || 'none on this row')}</b></span>
      <span class="lbtime ${lt.state}"><span class="lbck">Load time<br>as supplied</span>
        <b class="racenum">${esc(lt.raw || '—')}</b>
        <span class="lbtf">${lt.state === 'check' ? (lt.reads ? 'Reads ' + esc(lt.reads) + ' \u2014 confirm' : 'Confirm what this means')
          : lt.state === 'none' ? 'Not stated' : 'Reads one way'}</span></span>
    </span></div>
    <div class="lbrow"><span class="lbck">Docket / reference, as supplied</span>
      <b>${esc(e.dd || 'none on this row')}</b></div>
    ${(() => { const tc = transportCostOf(a); if (!tc) return ''; return `<div class="lbrow"><span class="lbck">Transport cost, as the schedule writes it</span>
      <b>${esc(tc.words)}</b>${tc.note ? ` <span class="w" style="color:var(--mute)">${esc(tc.note)}</span>` : ''}</div>`; })()}
    <div class="lbkit">
      <span class="lbref racenum">${esc(a.key)}</span>
      <div><b>${esc(a.name || a.item || a.key)}</b>
        <span class="lbpills">
          ${(a.item_types || []).slice(0, 2).map(t => `<span class="pill none">${esc(t)}</span>`).join('')}
          ${nums.length ? `<span class="pill plan">Asset <b>${esc(nums[0])}</b></span>` : '<span class="pill gap">No asset number</span>'}
          ${e.quantity_display ? `<span class="pill none">Qty <b>${esc(e.quantity_display)}</b></span>` : ''}
        </span></div>
    </div>
    ${flags.length ? `<div class="lbflag"><span class="lbfi" aria-hidden="true">!</span>
      <div><b>Clarification needed</b><p>${flags.map(esc).join(' · ')}</p></div></div>` : ''}
    <details class="dcsrc lbnotes"><summary>View notes</summary>
      <table class="dcsrctbl"><tbody>
        <tr><td>Load time</td><td>${esc(lt.say)}</td></tr>
        <tr><td>Schedule activity</td><td>${esc(e.activity || 'nothing written in the activity cell')}</td></tr>
        <tr><td>Movement</td><td>${esc(e.movement || '—')}${e.movement_stated ? ' — stated on the row' : ' — ' + esc(e.movement_basis || 'inferred')}</td></tr>
        <tr><td>Row notes</td><td>${esc(e.note || 'none')}</td></tr>
        <tr><td>Source cell</td><td>${esc(e.source_range || '—')}</td></tr>
      </tbody></table>
    </details>
  </div>`;
}
/* ------------------------------------------------------------------ the driver card, on screen
   Andrew Fisher, 14 Sep 2026: the important details impossible to miss — a bold orange reference panel, clear
   building identification and highlighted asset details, with an unverified location shown as unverified.

   This is the printed drop sheet's three most important facts, on screen, at the top of the drawer: WHICH map
   location, WHAT it is, and WHETHER anybody has confirmed where it goes on the ground. The last one is the
   reason the card exists. A drop whose position is a drawing match and nothing more says so, in a band nobody
   can read past, with the words a driver needs — because the alternative is a card that looks equally confident
   about a position somebody measured and a position nobody has ever stood on. */
function driverCard(a){
  const c = contractOf(a.key), d = deliveryOf(a.key);
  const nums = (a.asset_numbers || []);
  const ev = effectiveDates(a);
  const mv = movedFor(a), off = offPlanFor(a);
  const pt = aerialPointFor(a);
  const link = (a.drawing_links || [])[0] || null;
  /* what is actually known about where this goes, in the order it matters */
  const pos = mv ? {tone: 'gap', kick: 'Drop position · changed', head: 'Confirm the new position',
                    say: movedWords(mv) + ' The drawing below is the PREVIOUS plan, kept for context — it is not where this now goes.'}
            : off ? {tone: 'gap', kick: 'Drop position · unverified', head: 'Confirm the exact drop point',
                     say: offPlanWords(off) + ' Ring the supervisor before you leave the yard.'}
            /* blue, not green, and no tick. Delivery, completion and LOCATION CONFIDENCE are three different
               facts, and this one is only ever "the drawing says here" until somebody stands on the spot. */
            : pt ? {tone: 'plan', kick: 'Drawing position · confirm exact spot', head: 'Where the plan puts it — not yet verified on the ground',
                    say: 'A drawing match, not a GPS fix and not a checked position. Confirm the exact spot with the supervisor before you set it down.'}
            : {tone: 'gap', kick: 'Drop position · unverified', head: 'Confirm the exact drop point',
               say: 'Nothing on the 2026 drawings places this one, so this card cannot say where it goes on the ground. Ring the supervisor before you leave the yard.'};
  return `<div class="dcard">
    <div class="dcbar"><span><b>${esc(DATA.brand.org)}</b><em>${esc(DATA.event.name)}</em></span>
      <span class="pill ${d.recorded ? 'good' : 'none'}">${esc(deliveryView(a).label)}</span></div>
    <div class="dchead"><h3>Driver drop card</h3><span>${esc((a.discipline || '').toUpperCase())}${
      ev.in ? ' · ' + esc(fmtDay(ev.in).dm.toUpperCase()) : ''}</span></div>
    <div class="dcmain">
      <div class="cut dcref"><span class="face">
        <span class="dcrk">Reference</span>
        <b class="racenum">${esc(a.key)}</b>
        <span class="dcrf">${a._given ? `schedule row ${esc(a.task_id)}` : esc(DATA.event.short || 'GC500') + ' / 2026'}</span>
        <span class="slash" aria-hidden="true">//</span>
      </span></div>
      <div class="dcwhat">
        <p class="dcp">${esc((a.product || a.discipline || '').toUpperCase())}</p>
        <h4>${esc(a.name || a.item || a.key)}</h4>
        ${a.item && a.item !== a.name ? `<p class="dci">${esc(a.item)}</p>` : ''}
        <div class="dcpills">
          ${nums.length ? nums.slice(0, 3).map(n => `<span class="pill plan">Asset <b>${esc(n)}</b></span>`).join('')
            : '<span class="pill none">No asset number on this one yet</span>'}
          ${nums.length > 3 ? `<span class="pill none">and ${nums.length - 3} more</span>` : ''}
          ${(() => { const x = clashOf(a); return x ? `<span class="pill gap" title="${esc(x.words)}">${
            x.grade === 'contradiction' ? 'Check the plate — ' : 'Delivered elsewhere — '}${esc(x.short)}</span>` : ''; })()}
          ${c.id ? `<span class="pill good">Rental <b>${esc(c.id)}</b></span>` : ''}
          ${ev.in ? `<span class="pill load">Due in <b>${esc(fmtDay(ev.in).dm)}</b></span>` : ''}
        </div>
      </div>
    </div>
    <div class="dcpos ${pos.tone}">
      <span class="dcpi" aria-hidden="true">${pos.tone === 'good' ? '✓' : pos.tone === 'plan' ? '◎' : '?'}</span>
      <div><p class="dcpk">${esc(pos.kick)}</p><b>${esc(pos.head)}</b><p>${esc(pos.say)}</p></div>
    </div>
    ${givenRefBlock(a)}
    ${pinBlock(a)}
    <details class="dcsrc"><summary>View source details</summary>
      <table class="dcsrctbl"><tbody>
        <tr><td>Drawing</td><td>${link ? esc(link.sheet + ' · callout ' + link.label) : 'no callout on the 2026 sheets'}</td></tr>
        <tr><td>How it was matched</td><td>${link ? esc(link.state + ' — ' + link.evidence) : 'nothing to match'}</td></tr>
        <tr><td>Where it goes</td><td>${(() => { const w = destinationOf(a); return w.known
            ? esc(w.text) + ' <span class="w">· ' + esc(w.source) + '</span>'
            : '<span class="w">' + esc(w.fallback) + '</span>'; })()}</td></tr>
        <tr><td>Ground position</td><td>${(() => { const g = pt && lonLatOf(pt.ax, pt.ay);
          return g ? esc(g.text) + ' \u2014 read off the drawing through the photograph, not surveyed'
                   : 'none this card will stand behind'; })()}</td></tr>
        ${/* v5.49 — the position somebody RECORDED standing at it, beside the one the drawing gives. Never
             instead of it: the drawing is the plan, this is what happened, and the gap between the two is the
             useful part. Andrew Fisher, 18 Sep 2026. */ ''}
        <tr><td>Recorded on site</td><td>${(() => { const keys = [a.key].concat(pinUnits(a).map(u => fixKey(a.key, u))).filter(k => fixOf(k));
          if (!keys.length) return '<span class="w">nothing pinned yet — see Where it actually is, above</span>';
          return keys.map(k => { const f = fixOf(k), q = fixQuality(f.acc); return `<span class="mono">${esc(fixLabel(k))}: ${f.lat.toFixed(6)}, ${f.lon.toFixed(6)}</span> <span class="chip ${q.cls}">${esc(q.word)}</span>`; }).join('<br>'); })()}</td></tr>
        <tr><td>Schedule row</td><td>${esc(((a.events || [])[0] || {}).sheet || '—')}${
          (a.events || [])[0] && (a.events || [])[0].date_display ? ' · ' + esc((a.events || [])[0].date_display) : ''}</td></tr>
      </tbody></table>
    </details>
  </div>`;
}
/* v5.51 — WHERE IT ACTUALLY IS, IN THE OPEN. The pin sat in a folded "View source details" table, one row for
   the reference; Andrew Fisher, 18 Sep 2026, wanted it where a thumb finds it and one for EACH building. This
   is that: the reference, then every asset number known against it, each with its own pin, its own fix and
   its own Navigate — for the demob crew, who go to a building, not to a reference. */
/* v5.53 — the reference a plant line was given, or the box to give it one. Only a schedule row carried under
   its task id gets this; everything else already has the reference the drawing gave it. */
function givenRefBlock(a){
  if (!isPlantLine(a)) return '';
  const can = capability() === 'edit';
  if (a._given) {
    const g = a._given;
    return `<div class="givenblock on">
      <div class="sect">Reference given</div>
      <p class="sub"><b>${esc(a.key)}</b> is the schedule's row <b>${esc(a.task_id)}</b>, given this reference by <b>${esc(g.by || 'unnamed')}</b>${g.at ? ' · ' + esc(fmtStamp(g.at)) : ''}. The row keeps its task id underneath; every page uses the reference.</p>
      ${can ? `<button class="btn ghost" data-refoff="${esc(a.task_id)}" title="The row goes back to ${esc(a.task_id)}; what was recorded under ${esc(a.key)} goes with it">Take the reference off</button>` : ''}
    </div>`;
  }
  return `<div class="givenblock">
    <div class="sect">Give it a reference</div>
    <p class="sub"><b>${esc(a.key)}</b> is the schedule's own task id for a row nothing was drawn for — nobody on site calls it that. Give it the reference the site uses and every page uses it from then on; the row keeps its task id underneath.</p>
    ${can ? `<div class="liveform about"><input type="text" id="giveRefIn" placeholder="P70, GN30, WC90…" maxlength="12" autocapitalize="characters" autocomplete="off" aria-label="The reference to give ${esc(a.key)}">
      <button class="btn" data-refgive="${esc(a.key)}">Give it</button></div>
      <p class="sub">Letters and digits, one nobody else has. Anything already recorded against ${esc(a.key)} moves across with it.</p>` : '<p class="sub">Somebody with the edit link can give it one.</p>'}
  </div>`;
}
function pinBlock(a){
  const units = pinUnits(a);
  const row = (key, head, sub) => {
    const f = fixOf(key), pl = placeOf(key);
    /* v5.55 — the form for putting one there from outside. One row, always the same shape, whether or not
       anything is here yet: two numbers and the words for where they came from. */
    const placeForm = `<div class="placeform" id="pf_${esc(key).replace(/[^A-Za-z0-9]/g, '_')}" hidden>
        <input type="text" class="pfll" inputmode="decimal" placeholder="-27.985151, 153.429601" aria-label="latitude and longitude for ${esc(fixLabel(key))}">
        <input type="text" class="pfhow" placeholder="where it came from — e.g. read off D001" aria-label="how this position was arrived at">
        <button class="btn ghost pfsave" data-placesave="${esc(key)}">Put it there</button>
        <button class="btn ghost pfcancel" data-placecancel="${esc(key)}">Cancel</button>
        <span class="w">A placed position carries no accuracy, because there is none — it says who put it there and what they went off.</span>
      </div>`;
    if (!f && !pl) return `<div class="pinrow"><div class="pinwho"><b>${esc(head)}</b>${sub ? `<span class="w">${esc(sub)}</span>` : ''}</div>
      <div class="pinwhat"><span class="w">no position yet</span>
        <button class="btn ghost pinbtn" data-pin="${esc(key)}" title="take the phone's satellite fix where you are standing and record it against ${esc(fixLabel(key))}">Pin where it stands</button>
        <button class="btn ghost" data-placeopen="${esc(key)}" title="put a position on ${esc(fixLabel(key))} from the drawing or the map, without standing at it">Place it from outside</button>
        ${placeForm}</div></div>`;
    if (!f) {
      const ll2 = {lat: pl.lat, lon: pl.lon};
      return `<div class="pinrow on placed"><div class="pinwho"><b>${esc(head)}</b>${sub ? `<span class="w">${esc(sub)}</span>` : ''}</div>
        <div class="pinwhat">
          <span class="mono">${pl.lat.toFixed(6)}, ${pl.lon.toFixed(6)}</span>
          <span class="chip cand" title="Nobody has stood at this. It was put here from the drawing or the map by the person named, at the time shown.">${esc(placeWords(pl))}</span>
          ${pl.outside ? `<span class="chip cand">${esc(pl.away_m != null ? (pl.away_m >= 1000 ? (pl.away_m / 1000).toFixed(1) + ' km off the drawn site' : pl.away_m + ' m off the drawn site') : 'off the drawn site')}</span>` : ''}
          <span class="w pinby">${esc(pl.by || 'unnamed')}${pl.at ? ' · ' + fmtStamp(pl.at) : ''}${pl.source ? ' · ' + esc(pl.source) : ''}</span>
          <span class="pinacts">
            <a class="btn ghost" href="${navUrl(ll2)}" target="_blank" rel="noopener noreferrer" title="Driving directions — ends at the nearest road.">Drive there</a>
            <a class="btn ghost" href="${walkUrl(ll2)}" target="_blank" rel="noopener noreferrer" title="Walking directions to where somebody put it. Nobody measured this spot, so walk to it and then look around.">Walk to it</a>
            <a class="btn ghost" href="${earthUrl(ll2)}" target="_blank" rel="noopener noreferrer" title="Google Earth, tilted over where somebody put it — the quickest way to see whether it looks right.">Earth</a>
            <button class="btn ghost pinbtn" data-pin="${esc(key)}" title="stand at it and this is replaced by the real thing">Pin where it stands</button>
            <button class="btn ghost" data-placeopen="${esc(key)}">Move it</button>
            <button class="btn ghost pinoff" data-placeoff="${esc(key)}">Take it off</button></span>
          ${placeForm}
        </div></div>`;
    }
    const q = fixQuality(f.acc), ll = {lat: f.lat, lon: f.lon};
    return `<div class="pinrow on"><div class="pinwho"><b>${esc(head)}</b>${sub ? `<span class="w">${esc(sub)}</span>` : ''}</div>
      <div class="pinwhat">
        <span class="mono">${f.lat.toFixed(6)}, ${f.lon.toFixed(6)}</span>
        <span class="chip ${q.cls}">${esc(q.word)}</span>
        ${f.off != null ? `<span class="chip ${f.off > 25 ? 'crit' : 'ref'}">${f.off} m from the drawing</span>` : ''}
        ${/* v5.54 — a pin outside the drawn site is kept and said, never refused and never nudged onto the
              sheet. No distance-from-the-drawing is shown for it, because the drawing does not cover it. */ ''}
        ${f.outside ? `<span class="chip cand" title="The position is recorded exactly as the phone gave it. It sits ${esc(f.outside)}, so there is no mark for it on the sheet and no distance from the drawing.">${
            esc(f.away_m != null ? (f.away_m >= 1000 ? (f.away_m / 1000).toFixed(1) + ' km off the drawn site' : f.away_m + ' m off the drawn site') : 'off the drawn site')}</span>` : ''}
        <span class="w pinby">${esc(f.by || 'unnamed')}${f.at ? ' · ' + fmtStamp(f.at) : ''}${
          f.n ? ' · best of ' + esc(String(f.n)) + ' reading' + (f.n === 1 ? '' : 's') : ''}${
          pl ? ' · a placed position is underneath this one and is not what anybody is sent to' : ''}</span>
        <span class="pinacts">
          <a class="btn ghost" href="${navUrl(ll)}" target="_blank" rel="noopener noreferrer" title="Driving directions. A truck route — it ends at the nearest road, not on the spot.">Drive there</a>
          <a class="btn ghost" href="${walkUrl(ll)}" target="_blank" rel="noopener noreferrer" title="Walking directions to this pin itself. Driving snaps to the nearest road; walking does not, so this is the one that puts you within the metres the phone measured.">Walk to the spot</a>
          <a class="btn ghost" href="${earthUrl(ll)}" target="_blank" rel="noopener noreferrer" title="Google Earth, tilted over this pin — see the shape of the place before you go.">Earth</a>
          <button class="btn ghost pinbtn" data-pin="${esc(key)}">Pin again</button>
          <button class="btn ghost pinoff" data-pinoff="${esc(key)}">Take it off</button></span>
      </div></div>`;
  };
  return `<div class="pinblock">
    <div class="sect">Where it actually is</div>
    <p class="sub">Standing at it, press the button. It watches the satellite fix for a few seconds and keeps the tightest reading the phone gave, recorded against this with that accuracy, your name and the time — wherever you are standing, on the drawn site or off it. The drawing is never moved: this sits beside it, and the gap between the two is the useful part. ${units.length ? 'One per building, because a pin on one is not a pin on the other.' : ''}</p>
    ${row(a.key, a.key, units.length ? 'the drop as a whole' : (a.name || ''))}
    ${units.map(u => row(fixKey(a.key, u), 'Asset ' + u, unitWordsFor(a, u))).join('')}
    ${entryRow(a)}
  </div>`;
}
/* v5.54 — THE WAY IN, on its own line under the positions. Andrew Fisher, 20 Sep 2026, asked for a picture and a
   pinned entry point showing how to get to the location, and said whose: his photograph, and a pin he places.
   It sits in this block because it is the same kind
   of thing — somebody stood somewhere and pressed a button — and it is kept apart from the positions above
   because it answers a different question. The distance to the drop is worked out now, not stored, and it says
   what it was measured against rather than implying a survey. */
function entryRow(a){
  const e = entryOf(a.key);
  if (!e) return `<div class="pinrow"><div class="pinwho"><b>Way in</b><span class="w">where a truck turns off the street</span></div>
    <div class="pinwhat"><span class="w">not pinned yet</span>
      <button class="btn ghost pinbtn" data-pinentry="${esc(a.key)}" title="stand at the turn-in and press this: the phone's satellite fix is recorded as the way in to ${esc(a.key)}">Pin the way in</button></div></div>`;
  const q = fixQuality(e.acc), ll = {lat: e.lat, lon: e.lon}, d = entryToDrop(a.key);
  return `<div class="pinrow on"><div class="pinwho"><b>Way in</b><span class="w">where a truck turns off the street</span></div>
    <div class="pinwhat">
      <span class="mono">${e.lat.toFixed(6)}, ${e.lon.toFixed(6)}</span>
      <span class="chip ${q.cls}">${esc(q.word)}</span>
      ${d ? `<span class="chip ref" title="Measured on the ground from the way in to ${esc(d.basis)} — not a driving distance and not a route.">${d.m} m from ${esc(d.basis)}</span>` : ''}
      ${e.outside ? `<span class="chip cand" title="Recorded exactly as the phone gave it. It sits ${esc(e.outside)}, so there is no mark for it on the sheet.">${
          esc(e.away_m != null ? (e.away_m >= 1000 ? (e.away_m / 1000).toFixed(1) + ' km off the drawn site' : e.away_m + ' m off the drawn site') : 'off the drawn site')}</span>` : ''}
      <span class="w pinby">${esc(e.by || 'unnamed')}${e.at ? ' · ' + fmtStamp(e.at) : ''}${
        e.n ? ' · best of ' + esc(String(e.n)) + ' reading' + (e.n === 1 ? '' : 's') : ''}</span>
      <span class="pinacts">
        <a class="btn ghost" href="${navUrl(ll)}" target="_blank" rel="noopener noreferrer" title="Driving directions to the turn-in — this is the one for a truck.">Drive to the way in</a>
        <a class="btn ghost" href="${walkUrl(ll)}" target="_blank" rel="noopener noreferrer" title="Walking directions to the turn-in itself.">Walk to it</a>
        <a class="btn ghost" href="${earthUrl(ll)}" target="_blank" rel="noopener noreferrer" title="Google Earth, tilted over the turn-in — a gate in a fence line reads as fence on a map and as a gate in Earth.">Earth</a>
        <button class="btn ghost pinbtn" data-pinentry="${esc(a.key)}">Pin again</button>
        <button class="btn ghost pinoff" data-entryoff="${esc(a.key)}">Take it off</button></span>
    </div></div>`;
}
/* what the record says the numbered thing is, if it says */
function unitWordsFor(a, no){
  const u = unitsOf(a.key).find(x => x.asset_no === no);
  return u && u.label ? u.label : (a.item || a.name || '');
}
/* v5.58 — which drawer sections this device has closed. Open unless a person closed one here; nothing is hidden
   by default and the choice never leaves this device. */
/* v5.81 — CLOSED UNLESS OPENED. Management, 24 Sep 2026 (through Andrew Fisher): most of a drop's details do not
   need to be showing — break them down into drop-downs that open for the details.
   Every drawer section folds closed by default now; a section a person opens on this device stays open here. */
function dsectOpen(name){ try { return localStorage.getItem('gc500.dsect.' + name) === 'open'; } catch (e) { return false; } }
function dsectWire(){
  document.querySelectorAll('#drawer details.dsect').forEach(d => {
    d.addEventListener('toggle', () => { try { localStorage.setItem('gc500.dsect.' + d.id.replace(/^dsect/, '').toLowerCase(), d.open ? 'open' : 'closed'); } catch (e) {} });
  });
}
function openAsset(key, opts){
  const a = allAssets().find(x => x.key === key);
  if (!a) return;
  const keep = !!(opts && opts.keep);                 // a redraw of a drawer that is already open
  /* A REDRAW KEEPS ITS PLACE, WHOEVER ASKS FOR IT. Andrew Fisher, 23 Sep 2026: after entering an asset number, the
     drawer scrolled back to the top by itself. The save path (bump) put the scroll position back
     after its own redraw, but three other things redraw an open drawer with {keep:true} — the shared record
     echoing a change back (syncRedraw), the reports poll, the document registry settling — and each of them
     replaced the drawer's HTML and left it at the top, which on a phone is where the whole delivery panel lives.
     So the keeping is done HERE, once, for every caller: the drawer's own scroll (a phone) and its body's (a
     laptop), the field that had focus, and the caret in it, are read before the redraw and put back after. */
  const dr0 = $('#drawer');
  const held = keep && dr0 && dr0.classList.contains('on') ? (() => {
    const db = dr0.querySelector('.db'), el = document.activeElement;
    const inDrawer = el && dr0.contains(el);
    const field = inDrawer && /^(INPUT|TEXTAREA)$/.test(el.tagName) && !/^(checkbox|radio|button|file)$/.test(el.type || '');
    return {dtop: dr0.scrollTop, top: db ? db.scrollTop : 0, id: inDrawer ? el.id : null,
            /* where the field sat on the screen: a redraw can add content ABOVE it (the second number on a
               building turns "qty not readable" into "2 buildings" with a costed line each, and gives the new
               unit its own place-it block), and the same scroll position would then leave the box a screen
               lower. The box is put back where the thumb was, not the scrollbar. */
            anchor: inDrawer && el.id ? el.getBoundingClientRect().top : null,
            value: field ? el.value : null,   /* what was typed and not yet saved survives the redraw */
            sel: field && typeof el.selectionStart === 'number' ? [el.selectionStart, el.selectionEnd] : null};
  })() : null;
  if (held) { try { openAssetDraw(a, key, keep); } finally { openAssetRestore(held); } } else openAssetDraw(a, key, keep);
}
function openAssetRestore(held){
  const dr = $('#drawer'); if (!dr) return;
  const db = dr.querySelector('.db'); if (db) db.scrollTop = held.top;
  dr.scrollTop = held.dtop;
  if (held.id) { const f = document.getElementById(held.id);
    if (f && dr.contains(f)) { try { f.focus({preventScroll: true}); } catch (e) { try { f.focus(); } catch (e2) {} }
      if (held.value != null && f.value !== held.value && /^(INPUT|TEXTAREA)$/.test(f.tagName)) try { f.value = held.value; } catch (e) {}
      if (held.sel && typeof f.setSelectionRange === 'function') try { f.setSelectionRange(held.sel[0], held.sel[1]); } catch (e) {}
      if (held.anchor != null) { const d = f.getBoundingClientRect().top - held.anchor;
        if (Math.abs(d) > 1) { const sc = dr.scrollHeight > dr.clientHeight + 1 ? dr : db;   /* whichever one scrolls: the drawer (a phone) or its body (a laptop) */
          if (sc) { sc.scrollTop += d; held.dtop = dr.scrollTop; held.top = db ? db.scrollTop : 0; } } } } }
  /* a phone lays the drawer out after the frame; hold the place through it */
  requestAnimationFrame(() => { if (db && Math.abs(db.scrollTop - held.top) > 1) db.scrollTop = held.top; if (Math.abs(dr.scrollTop - held.dtop) > 1) dr.scrollTop = held.dtop; });
}
function openAssetDraw(a, key, keep){
  state.sel = key;
  const links = (a.drawing_links||[]).map(l =>
    `<div class="ev"><span>${esc(l.sheet)} · callout <b>${esc(l.label)}</b><br>
      <span class="w" style="font-size:11.5px;color:var(--mute)">${esc(l.evidence)}</span></span>
     <span class="chip cand">${esc(l.state)}</span></div>`).join('') ||
    '<p class="norate">No drawing link. The reference does not appear as a callout on the 2026 sheets.</p>';
  /* v5.58 — A PHYSICAL NUMBER INSIDE A REFERENCE TWICE IS SAID, AND OFFERED A FIX. P20 carried air conditioner
     1180683 as two active rows, entered 73 seconds apart on 16 Sep, and both counted (the 19 Sep 2026 audit).
     The Add button now refuses a repeat; this is for the ones already in the record. Nothing is changed here by
     itself: the notice names both rows and offers to set the LATER one aside, in the name of whoever presses it,
     through the same removal every other accessory uses — so both events stay on the record, Put back is one
     press away, and the count reads 1. Only an exact same-number match is called a double; two unnumbered
     rows of the same type are two rows and are left alone. */
  const doubled = (() => {
    const byNo = new Map();
    (a.accessories || []).forEach(x => { const n = String(x.asset_no || '').trim(); if (n) (byNo.get(n) || byNo.set(n, []).get(n)).push(x); });
    return [...byNo.entries()].filter(([, xs]) => xs.length > 1).map(([no, xs]) => {
      const sorted = xs.slice().sort((p, q) => String(p.added_at || p.source_task || '').localeCompare(String(q.added_at || q.source_task || '')));
      return {no, rows: sorted, later: sorted[sorted.length - 1]}; });
  })();
  const doubledNotice = doubled.length ? doubled.map(d => `<div class="notice warn dbl"><b>Asset no. ${esc(d.no)} is inside ${esc(a.key)} ${d.rows.length} times.</b>
      ${d.rows.map(x => esc(String(x.type || 'accessory')) + (x.added_at ? ' \u2014 added ' + esc(fmtStamp(x.added_at)) + (x.added_by ? ' by ' + esc(x.added_by) : '') : x.source_task ? ' \u2014 from schedule row ' + esc(x.source_task) : '')).join('; ')}.
      One physical thing cannot be inside a building twice, and both rows are being counted.
      <button type="button" class="btn sm" data-dbloff="${esc(d.later._accId)}" title="Set the later entry aside, in your name. Nothing is deleted and Put back is under the list.">Set the later one aside</button></div>`).join('') : '';
  const acc = doubledNotice + (a.accessories.length ? a.accessories.map((x,i) => `
    <div class="acc"><span><b>${esc(x.type)}</b>${x.qty>1?' ×'+x.qty:''}
      ${x.qty_stated===false?'<span class="chip cand">qty assumed 1</span>':''}
      ${x._added?'<span class="chip act">added here</span>':''}
      <br><span class="w">as written: “${esc(x.as_written)}”</span>${x._identifies ? `<br><span class="w" style="font-size:11px;color:var(--mute)">this is the schedule\u2019s \u201c${esc(x._identifies)}\u201d, now with its number</span>` : x._identifiedBy ? `<br><span class="w" style="font-size:11px;color:var(--mute)">identified on site as asset ${esc(x._identifiedBy)}</span>` : ''}${x._fromUnit ? `<br><span class="w" style="font-size:11px;color:var(--mute)">recorded on site${x.added_by ? ' by ' + esc(x.added_by) : ''}${x.added_at ? ' \u00b7 ' + esc(fmtStamp(x.added_at)) : ''}</span>` : ''}${x.description ? `<br><span class="w">${esc(x.description)}</span>` : ''}${x.edited_at ? `<br><span class="w" style="font-size:11px;color:var(--mute)">edited ${esc(fmtStamp(x.edited_at))}${x.edited_by ? ' by ' + esc(x.edited_by) : ''}</span>` : ''}</span>
      <span class="accr"><span class="mono">${x.asset_no ? assetNo(x.asset_no) : '<span class="chip">no asset no.</span>'}</span>
      ${x._added ? `<button class="btn ghost sm" data-accedit="${esc(x._accId)}" title="Change this ${esc(String(x.type || 'accessory').toLowerCase())} — its number, quantity or description — rather than adding another">Edit</button>` : ''}
      <button class="btn ghost sm" data-accoff="${esc(x._accId)}"
        title="Take the ${esc(String(x.type || 'accessory').toLowerCase())} off ${esc(a.key)} — ${
          x._fromUnit ? 'it was recorded on site as a unit; this takes it out of that record, and recording it again puts it back'
          : x._added ? 'it was added here and can be put straight back' : 'the schedule keeps its own record of it'}">Take off</button></span></div>`).join('')
    : '<p class="norate">Nothing recorded inside this one. If there is, add it below — it will stay with the record.</p>')
    /* Taken off, and still readable. An accessory the schedule listed is never rubbed out: it moves down here
       with a way back, so a person who takes the wrong one off does not have to retype it, and so a reader can
       always see that the schedule asked for something this reference has not got. */
    /* v5.81 — taken off is folded away, not struck through (Andrew Fisher, 24 Sep 2026: crossing out looks
       messy), and each row can go for good: Delete leaves no row, no Put back and no crossing-out */
    + ((a._accessoriesTakenOff || []).length ? `<details class="sfold accoff"><summary>Taken off · ${(a._accessoriesTakenOff || []).length}${a._accessoriesOnTheSchedule ? ' — still on the schedule, not counted here' : ''}</summary><div class="sfoldbody">${
      (a._accessoriesTakenOff || []).map(x => `<div class="acc gone"><span><b>${esc(x.type)}</b>${x.qty>1?' ×'+x.qty:''}
        <br><span class="w">as written: “${esc(x.as_written)}”</span></span>
        <span class="accr"><span class="mono">${x.asset_no ? esc(x.asset_no) : '—'}</span>
        <button class="btn ghost sm" data-accback="${esc(x._accId)}"
          title="Put the ${esc(String(x.type || 'accessory').toLowerCase())} back on ${esc(a.key)}">Put back</button>
        <button class="btn ghost sm danger" data-accgone="${esc(x._accId)}"
          title="Delete this ${esc(String(x.type || 'accessory').toLowerCase())}${x.asset_no ? ' (asset no. ' + esc(x.asset_no) + ')' : ''} from ${esc(a.key)} for good — no row, no Put back, on every copy of the record">Delete for good</button></span></div>`).join('')}</div></details>` : '');
  const evs = (a.events||[]).map(e => `
    <div class="ev"><span><b>${esc(e.date_display || e.date || 'no date')}</b> · ${esc(e.sheet)}
      <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(e.item||'')} ${
        e.quantity_display?'· qty '+esc(e.quantity_display):''} ${e.note?'· '+esc(e.note):''}</span></span>
     <span class="chip ${e.movement==='remove'?'ref':'act'}">${esc(e.movement)}${
        e.movement_stated?'':' (inferred)'}</span></div>`).join('') || '<p class="norate">No scheduled events.</p>';

  $('#drawer').innerHTML = `
   <div class="dh"><div><div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap"><h2 id="drawerTitle">${refPlate(a.key, 26)}</h2>${
       a._cancelled ? cancelBtn(a.key, true) : dstat(a, {size: 'sm'}) + doneChip(a) + levelChip(a) + stepsChip(a) + doneBtn(a.key, true) + levelBtn(a.key, true) + stepsBtn(a.key, true) + nextDayBtn(a.key, true) + cancelBtn(a.key, true)}</div>
     <div class="sub">${esc(a.name||'')} · ${esc(a.discipline)}${(() => { const c = contractOf(a.key); return c.id ? ` · Rental ID <b class="mono">${esc(c.id)}</b>${c.c && c.c.customer_code ? ' · ' + esc(c.c.customer_code) : ''}` : ''; })()}</div>
     ${/* the mark leads its own line under the name: beside the plate it ran under the Navigate button on a
          phone-width drawer, and a mark half hidden is worse than one a line lower. Under the name, not above
          it, so the first line under the plate is still what the thing IS — every reader of this header,
          person or test, takes that line as the name. */ ''}
     ${a._cancelled ? `<div class="sub" style="color:var(--tl-red)"><span class="nomark big" role="img" aria-label="cancelled">${noGlyph(20)}<b>cancelled</b></span> — <b>${esc(rowOffWords(a.key).replace(/^cancelled\.?\s*(\u2014\s*)?/i, ''))}</b>. Off every day, list, count and drop sheet. It is still on the schedule and still here; put it back from its day on the Timeline.</div>` : ''}</div>
    <div class="dhacts">
      ${navBtn(a, {primary: true})}
      <button class="btn" id="dshare" title="send this drop — the map location, what it is, the asset number, the day and where it goes — to a driver's phone">Send to a phone</button>
      <button class="close" id="dclose" aria-label="Close" title="Close">&times;</button></div></div>
   <div class="db">
    <div class="dnav" id="drawerNav" hidden><button class="btn ghost" id="prevAsset">‹ Prev</button><span id="drawerPos" class="w"></span><button class="btn ghost" id="nextAsset">Next ›</button></div>
    ${/* v5.56 — what the person on the ground reported off the drop card, first, because it is the newest thing
          anybody knows about this reference. It sits above the record and never inside it: a report is somebody's
          word with the name they typed, and it changes no light, no date and no figure here. */ ''}
    ${reportedCard(a.key)}
    ${movedLine(a.key)}${(a._movedFrom || []).length ? `<div class="notice info movedline"><b>Carries the record moved from ${esc(a._movedFrom.map(m => m.from).join(', '))}</b> — ${esc(a._movedFrom.map(m => (m.by || 'unnamed') + (m.at ? ' · ' + fmtStamp(m.at) : '')).join('; '))}.</div>` : ''}
    ${/* Andrew Fisher, 15 Sep 2026: too little room to scroll on the Timeline when opening what is coming in.
          On a Samsung phone the five precision tags stack one to a row, and
          they were inside the FIXED header — about 250 CSS px of the screen that could never scroll away, on
          top of another 175 of plate, instrument and name. The record itself got a 150px window to read in.
          The tags are not controls; they are what the header's claims are based on, so they belong at the top
          of the thing that scrolls, not pinned above it. The header keeps what a person needs at any moment:
          the reference, its light, Navigate, Send to a phone and Close. */ ''}
    ${precisionTags(a)}
    ${deliveryCard(a)}
    ${breakdownCard(a)}
    <details class="dsect" id="dsectRecord"${dsectOpen('record') ? ' open' : ''}><summary>The record — type, dates, position</summary>
    <dl class="kv">
     <dt>Type</dt><dd>${esc((a.item_types||[]).join(', ')||'—')}</dd>
     <dt>Asset no.</dt><dd class="mono">${a.asset_numbers.length?assetNosOf(a, {bare: true}):
        '<span class="chip">not supplied by the schedule</span>'}</dd>
     <dt>On site</dt><dd>${a.first_date?esc(a.first_date)+(a.last_date&&a.last_date!==a.first_date?' → '+esc(a.last_date):''):'—'}
       ${a.weeks_between_first_and_last?`<br><span class="w" style="font-size:11.5px;color:var(--mute)">${a.weeks_between_first_and_last} weeks between first and last scheduled date</span>`:''}</dd>
     <dt>Demob-week row</dt><dd>${a.demob_covered?'<span class="chip ok">yes</span>':'<span class="chip">no</span>'}
       <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.demob_state)}</span></dd>
     ${a.reference_state ? `<dt>Reference</dt><dd><span class="chip crit">unresolved</span>
        <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.reference_state)}</span></dd>` : ''}
     ${a.origin === 'drawing' ? `<dt>Schedule</dt><dd><span class="chip cand">on the drawing only</span>
        <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.schedule_state || '')}</span>${a.schedule_note ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.schedule_note)}</span>` : ''}</dd>` : ''}
     ${a.shared_row_note ? `<dt>Shared row</dt><dd><span class="chip cand">one row, two references</span>
        <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.shared_row_note)}</span></dd>` : ''}
     ${a.tower_series ? `<dt>Tower series</dt><dd><span class="chip ${a.tower_series === 'circuit' ? 'act' : 'ref'}">${a.tower_series === 'circuit' ? 'circuit — light spread drawn (LTC)' : 'keyed on D024 (LT)'}</span>${a.key_location ? `<br><span class="w">${esc(a.key_location)}</span>` : ''}
        ${a.series_note ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.series_note)}</span>` : ''}</dd>` : ''}
     ${(a.asset_number_caveats||[]).length ? `<dt>Asset number</dt><dd><span class="chip crit">check this</span>
        <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.asset_number_caveats.join(' '))}</span></dd>` : ''}
     <dt>Off-hire</dt><dd>${{'stated':'<span class="chip ok">removed by a schedule row</span>',
        'demob row':'<span class="chip ok">closed by a demob-week row</span>',
        'none':'<span class="chip crit">nothing takes it off site</span>'}[a.offhire_state] || ''}
        <br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.offhire_note||'')}</span></dd>
     <dt>Position</dt><dd><span class="chip ${a.linked_to_2026_sheet===false?'crit':'cand'}">${esc(a.position_state)}</span>${
        a.link_year_note?`<br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(a.link_year_note)}</span>`:''}</dd>
     ${satelliteBlock(a)}
    </dl>
    </details>
    ${/* v5.58 — THE DRIVER'S CARD IS WHAT YOU SEND, NOT WHAT YOU READ. It repeated the header — the plate, the
          name, the asset number, the day — a hand's width below the header, on every phone, every time. It is
          all still here, one tap away, with the load brief beside it. */ ''}
    <details class="dsect" id="dsectDriver"${dsectOpen('driver') ? ' open' : ''}><summary>Driver's card and load brief</summary>
    ${driverCard(a)}
    ${loadBrief(a)}
    </details>
    ${/* v5.58 — THE MONEY IN ONE PLACE, AND OUT OF THE WAY OF THE DAY. The 19 Sep 2026 audit found the drawer
          putting hire weeks, days charged, what is on hire, labour ticks, the weeks override, the contract, the
          branch and the hire start all between a person and the thing they opened the drawer for. They are all
          still here, unchanged, under one heading that opens and closes and remembers which on this device. Open
          by default, so nothing anybody relies on is hidden. */ ''}
    <details class="dsect" id="dsectHire"${dsectOpen('hire') ? ' open' : ''}><summary>Hire and costs</summary>
    <dl class="kv">
     <dt>Weeks on site</dt><dd>${(() => { const w = assetWeeks(a);
        return (w.w == null ? '<span class="chip">unknown</span>' : '<b>' + w.w + '</b>'
                 + (w.assumed ? ' <span class="chip cand">assumed</span>' : '')) +
          '<br><span class="w" style="font-size:11.5px;color:var(--mute)">' + esc(w.basis) + ' — how long it is there, which is not what is charged</span>'; })()}</dd>
     <dt>Days charged</dt><dd>${(() => { const sp = chargeSpanOf(a);
        const head = sp.days == null ? '<span class="chip crit">none</span>' : '<b>' + esc(String(sp.days)) + '</b>';
        const b = sp.basis && sp.basis.key ? ' <span class="chip ' + (sp.basis.key === 'from_delivery' ? 'act' : 'ok') + '">' + (sp.basis.key === 'from_delivery' ? 'from the day it goes in' : 'over the event') + '</span>' : '';
        return head + b + '<br><span class="w" style="font-size:11.5px;color:var(--mute)">' + esc(sp.why) + '</span>'; })()}</dd>
     <dt>What is on hire</dt><dd>${(() => { const t = assetTotal(a);
        if (!t.lines.length) return '<span class="chip">no item type on this reference</span>';
        return t.lines.map(l => (l.priceable ? '<b>' + l.qty + '</b> × ' : '<span class="chip crit">qty not readable</span> ')
          + esc(l.item)
          + (l.total != null ? ' — <b>' + money(l.total) + '</b>' : '')
          + (l.days != null && l.per === 'day' ? '<br><span class="w" style="font-size:11.5px;color:var(--mute)">' + esc(String(l.days)) + ' day' + (l.days === 1 ? '' : 's')
              + ' × ' + esc(money(l.rate)) + (l.qty != null ? ' × ' + esc(String(l.qty)) : '')
              + (l.days_floored ? ' — the card\'s minimum hire for this line; the charge window is ' + esc(String(l.window_days)) + ' day' + (l.window_days === 1 ? '' : 's') : '') + '</span>' : '')
          + (l.priceable ? '' : '<br><span class="w" style="font-size:11.5px;color:var(--mute)">'
              + esc(l.quantity_state) + '</span>')).join('<br>'); })()}</dd>
     <dt>Labour on this reference</dt><dd>${labourTicksHtml(a)}</dd>
    </dl>
    <div class="form" style="margin:-4px 0 12px">
      <div class="row2"><div class="f"><label>Override weeks on hire</label>
        <input id="wkBox" type="number" min="0" step="0.5" value="${esc(S.weeks[a.key] ?? '')}"
          placeholder="leave blank to use the schedule"></div>
        <div style="align-self:end"><button class="btn" id="wkSave">Set weeks</button></div></div>
    </div>
    ${contractBlock(a)}
    ${branchBlock(a)}
    ${(() => { const hs = hireStartOf(a.key), rent = rentalOf(a.key); const rs = rent && rent.from ? rent.from : null;
      /* v5.81 — one line (management, 24 Sep 2026): what is charged from when; the reading of it is the box's title */
      return `<div class="sect">Hire starts</div><div class="form" style="margin-bottom:12px"><p class="hint" style="margin:0 0 6px" title="The hire days on Pricing follow the schedule's span until a day is typed here. Type the day the hire is charged from if it is not the day it lands.">${
        hs ? 'Charged from <b>' + esc(fmtDate(hs.iso)) + '</b> — ' + esc(hs.by || 'unnamed') + (hs.at ? ' · ' + esc(fmtStamp(hs.at)) : '') + (rs && rs !== hs.iso ? ' · the rental system says ' + esc(fmtDate(rs)) : '')
           : rs ? 'On hire from <b>' + esc(fmtDate(rs)) + '</b> — the rental system; no hire start typed.'
           : 'No hire start typed — the schedule\'s span.'}</p>
        <div class="row2"><div class="f"><label for="hsBox">Charged from</label><input id="hsBox" type="date" value="${esc(hs ? hs.iso : '')}"></div>
          <div style="align-self:end"><button class="btn" id="hsSave">Set hire start</button></div></div></div>`; })()}
    ${(() => { const cur = mapRefOf(a.key), ch = mapChoices(a.key); const curV = cur ? cur.kind + '|' + cur.id : ''; const groups = [...new Set(ch.map(c => c.group))];
      return `</details><div class="sect">Map attached</div><div class="form" style="margin-bottom:12px">${cur ? mapRefLine(a.key) : '<p class="hint" style="margin:0 0 6px">No map attached. Pick a drawing the page carries, or a map uploaded to the service (on the admin page or the Documents tab, kind Map / drawing / plate — say which reference it is for and it lands here first).</p>'}
        <div class="row2"><div class="f"><label for="mapRefSel">Map for ${esc(a.key)}</label><select id="mapRefSel"><option value="">— no map attached —</option>${groups.map(g => `<optgroup label="${esc(g)}">${ch.filter(c => c.group === g).map(c => `<option value="${esc(c.kind + '|' + c.id)}"${c.kind + '|' + c.id === curV ? ' selected' : ''}>${esc(c.name)}</option>`).join('')}</optgroup>`).join('')}${
          cur && !ch.some(c => c.kind + '|' + c.id === curV) ? `<option value="${esc(curV)}" selected>${esc(cur.name)} (not in the library now)</option>` : ''}</select></div></div></div>`; })()}
    ${filedMapBlock(a)}
    ${costCard(a)}
    ${suppliedBlock(a)}
    ${a.locations && a.locations.length>1?`<p class="norate">Also written as: ${a.locations.slice(1).map(esc).join(' · ')}</p>`:''}
    ${a.unparsed_notes && a.unparsed_notes.length?`<div class="notice"><b>Notes the parser did not classify</b>${
      a.unparsed_notes.map(esc).join(' · ')}</div>`:''}

    ${/* v5.58 — ONE PANEL FOR WHAT IS INSIDE. The 19 Sep 2026 audit: "Inside this asset" (the accessories —
          fridges, air conditioners, chairs, off the schedule or added here) and "What is inside" (the units —
          the things recorded on site with their own asset numbers and drawing places) read as two competing
          answers to one question. They are two kinds of record and both stay; they now sit under one heading,
          each part saying which kind it is, and the building itself is never counted as one of its contents. */ ''}
    <div class="sect contents">Contents and accessories</div>
    ${contentsClashLine(a)}
    <p class="hint" style="margin:0 0 6px"><b>Accessories</b> — ${a.accessories.reduce((s,x)=>s+(x.qty||1),0)} on ${esc(a.key)}: what the schedule put inside it, and what was attached here.</p>
    ${acc}
    ${/* v5.81 — ONE WAY IN. Andrew Fisher, 24 Sep 2026: adding an accessory is a drop-down — pick the type (an
          aircon, say), add the asset number, attach it to the building — less clutter, no doubling up, one pin,
          and the reference number linked to the asset number. So: the type from
          the list, the asset number, Attach — and the reference carries the number from then on. The building is
          the thing pinned on the map; what is inside it is not pinned again. Quantity and a description are
          under "more", for the rare row that needs them. */ ''}
    <div class="form" style="margin-top:10px" id="accForm">
      <div class="row2">
        <div class="f"><label id="accFormLabel" for="accType">Attach an accessory — pick the type</label>
          <select id="accType">${['Air conditioner','Fridge','Zip boiler','Sink with tap','Microwave','Hydration station','Urn',
            'Whiteboard','Folding table','Swivel chair','Stackable chair','Chair','Desk',
            'Heater','Water cooler','Other'].map(t=>`<option>${t}</option>`).join('')}</select></div>
        <div class="f"><label for="accNo">Asset number</label><input id="accNo" inputmode="numeric" placeholder="e.g. 1322583"></div>
      </div>
      <details class="sfold" id="accMore"><summary>More — quantity, description</summary><div class="sfoldbody"><div class="row2">
        <div class="f"><label for="accQty">Quantity</label><input id="accQty" type="number" min="1" value="1"></div>
        <div class="f"><label for="accDesc">Description (optional)</label><input id="accDesc" placeholder="e.g. 2 door, left hinge"></div>
      </div></div></details>
      <div><button class="btn primary" id="accAdd">Attach to ${esc(a.key)}</button> <button class="btn ghost" id="accEditCancel" hidden>Cancel edit</button></div>
    </div>
    <details class="sfold" id="unitsFold"${(Array.isArray(a._unitsNotContents) ? a._unitsNotContents : []).length ? ' open' : ''}><summary>Other things standing under ${esc(a.key)} — a second building, boards${(Array.isArray(a._unitsNotContents) ? a._unitsNotContents : []).length ? ' · ' + (a._unitsNotContents || []).length : ''}</summary><div class="sfoldbody">${unitBlockInline(a)}</div></details>

    <div class="sect">Asset numbers on ${esc(a.key)}</div>
    ${clashLine(a)}
    <div class="form">
      ${(a.asset_numbers || []).length ? `<ul class="numlist">${(a.asset_numbers || []).map(n => {
        const src = ((a._numberSources || {})[n] || []).join(', ') || ((a._numbersOnTheSchedule || []).includes(n) ? 'the schedule' : 'typed here');
        /* v5.59 — a number that is a thing INSIDE the building (or beside it) says so, so nobody reads a fridge's
           number as a second building */
        const inside = (a._contentsNumbers || []).includes(String(n)) ? ((a.accessories || []).find(x => String(x.asset_no || '').trim() === String(n)) || {}).type
          || ((unitsOf(a.key).find(u => String(u.asset_no || '').trim() === String(n)) || {}).label) || 'contents' : null;
        return `<li><b class="mono">${esc(n)}</b>
          <span class="w">${esc(src)}</span>${numberIsReference(a, n) ? ` <span class="chip ref" title="from the schedule, on a thing nothing has put on site yet — the plan's reference, not a number seen standing there (Andrew Fisher, 24 Sep 2026)">reference · not yet in</span>` : ''}${inside ? ` <span class="chip" title="a thing inside or beside the building, not the building — it gets no labour lines and no photograph places of its own">${esc(String(inside).toLowerCase())} — not the building</span>` : ''}
          ${numberIsOursAlone(a.key, n)
            ? `<button class="btn ghost sm danger" data-numgone="${esc(n)}" title="Remove ${esc(n)} from ${esc(a.key)} for good \u2014 it was only ever typed here, so nothing will record it having been on ${esc(a.key)}">Remove</button>`
            : `<button class="btn ghost sm danger" data-numoff="${esc(n)}" title="Remove ${esc(n)} from ${esc(a.key)} for good \u2014 on every copy of the record; the schedule's own paper is not rewritten, and the number will not come back from it">Remove</button>`}</li>`;
      }).join('')}</ul>` : '<p class="norate">No asset number on this one yet.</p>'}
      <div class="row2">
        <div class="f"><label for="numAdd">Add the number that turned up</label>
          <input id="numAdd" placeholder="Coates asset number"></div>
        <div><button class="btn" id="numBtn">Add number</button></div>
      </div>
    </div>

    <div class="sect">Where ${esc(a.key)} goes</div>
    <div class="form">
      <p class="sub">The schedule says <b>${esc((a._locationMoved && a._locationMoved.from) ||
        (a.locations || []).find(l => l && l !== a.key) || 'nothing about where this one goes')}</b>.
        Type over it when it moves. The schedule's own wording is kept either way.</p>
      <div class="row2">
        <div class="f"><input id="locBox" maxlength="120" placeholder="where it actually goes"
          value="${esc((S.locations || {})[a.key] || '')}"></div>
        <div><button class="btn" id="locSave">Save where it goes</button>
          ${(S.locations || {})[a.key] ? '<button class="btn ghost" id="locClear">Back to the schedule</button>' : ''}</div>
      </div>
      ${a._locationMoved ? `<p class="sub">Moved by a person${a._locationMoved.at
        ? ' on ' + esc(fmtStamp(a._locationMoved.at)) : ''}.</p>` : ''}
    </div>

    ${dropPhotoBlock(a)}

    ${filedPhotoBlock(a)}

    <details class="dsect" id="dsectHistory"${dsectOpen('history') ? ' open' : ''}><summary>History and sources</summary>
    <div class="sect">Drawing links</div>${links}

    <div class="sect">Scheduled events (${(a.events||[]).length})</div>${evs}
    </details>

    <div class="sect">Your note</div>
    <div class="form"><div class="f">
      <textarea id="noteBox" rows="3" placeholder="Anything the schedule does not say — condition, who signed for it, where it actually ended up.">${esc(a._note||'')}</textarea>
      <div class="hint">${SYNC.on ? 'Saved in the shared record.' : 'Saved in this browser only. Use Export to keep it.'}</div></div>
      <div><button class="btn" id="noteSave">Save note</button></div></div>
   </div>
   <div class="df"><button class="btn ghost" id="dclose2">Close</button>
     <button class="btn primary" id="dropSheet">Print drop sheet</button>
     <button class="btn" id="emailRich" title="Copies the whole drop — where it goes, the four pictures, the directions, the SWMS and the numbers — formatted. Paste it straight into Outlook.">Email with pictures</button>
     <a class="btn ghost" id="emailAsset" href="${assetMailto(a)}" title="Opens your mail app with the words only. A mail link cannot carry pictures or an attachment — use Email with pictures for that.">Plain email</a>
     <button class="btn" id="textDrop" title="Text a driver a link that opens the card with the pictures, the directions and a Navigate button">Text it</button>
     <button class="btn" id="copyLink" title="Copy a link that opens this asset">Copy link</button>
     <button class="btn" id="toPlant">Plant page</button>
     <button class="btn danger" id="deleteAsset" title="Delete ${esc(a.key)} for good — off every page and every copy of the record, with no put-back. Cancel is the one that keeps it on the schedule.">Delete</button>
     ${mapSheetFor(a) ? `<button class="btn" id="showOnMap">Show on the map</button>`
       : (a.drawing_links||[]).length ? `<span class="hint">${esc(a.drawing_links[0].sheet)} is not one of the
         sheets carried in this file, so there is nothing to show here.</span>` : ''}</div>`;
  wireSupplied(a);
  wireDelivery(a);
  wireContract(a);
  wireBranch(a);
  wireCostCard(a);
  const wasOpen = $('#drawer').classList.contains('on');
  /* ONE FOREGROUND AT A TIME. An outside re-audit of the live site, 16 Sep 2026, B3: with Tools left open, a
     search for WC17 opened the drawer underneath it and the menu sat over the asset's details. Two surfaces
     competing for the front is a person reading round an obstacle, so opening a drawer shuts the menus that
     have nothing to do with it. The drawer keeps its own return-focus element, so Escape still walks back to
     wherever the person came from — a menu we closed for them is not somewhere to put them back. */
  if (!wasOpen) moreClose();
  $('#drawer').classList.add('on'); $('#drawer').setAttribute('aria-hidden','false'); $('#scrim').classList.add('on'); syncInert();
  /* The drawer covers the whole screen on a phone. It has to close with Escape, and focus has to move into it and
     come back out, or a keyboard user is stranded behind the scrim with the page still scrolling underneath.
     A redraw of an open drawer keeps the element focus will go back to, and swaps the key handler rather than
     stacking a second one. */
  if (!wasOpen) state.drawerReturn = document.activeElement;
  if (state.drawerKey) document.removeEventListener('keydown', state.drawerKey);
  const close = () => { $('#drawer').classList.remove('on'); $('#drawer').setAttribute('aria-hidden','true');
    $('#scrim').classList.remove('on'); syncInert(); document.removeEventListener('keydown', onKey); state.drawerKey = null;
    state.drawerClose = null;
    unmountLiveMap($('#satbox'));   /* v5.51 — the live map gives its WebGL context back when the drawer shuts */
    leaveDrawerHash();
    if (state.satRO) { state.satRO.disconnect(); state.satRO = null; }
    const rt = state.drawerReturn; state.drawerReturn = null;
    if (rt && rt.focus && document.contains(rt)) try { rt.focus(); } catch (e) {} };
  state.drawerClose = close;
  const onKey = ev => {
    /* A nested dialog owns its own keys, even if its handler just removed it from the document. */
    const owner = ev.target && ev.target.closest && ev.target.closest('.drawer');
    if (owner && owner !== $('#drawer')) return;
    if (ev.key === 'Escape') { ev.preventDefault(); close(); return; }
    if (ev.key !== 'Tab') return;
    const f = [...$('#drawer').querySelectorAll(
      'a[href],button:not([disabled]),input:not([disabled]),select,textarea,[tabindex]:not([tabindex="-1"])')]
      .filter(el => el.offsetParent !== null);
    if (!f.length) return;
    const first = f[0], last = f[f.length - 1];
    if (ev.shiftKey && document.activeElement === first) { ev.preventDefault(); last.focus(); }
    else if (!ev.shiftKey && document.activeElement === last) { ev.preventDefault(); first.focus(); }
  };
  document.addEventListener('keydown', onKey); state.drawerKey = onKey;
  /* Position the satellite window once the drawer is laid out, and keep it centred when the panel resizes. */
  state.satPt = aerialPointFor(a);
  positionSat();
  if (state.satRO) state.satRO.disconnect();
  const sb = $('#satbox');
  if (sb && window.ResizeObserver) { state.satRO = new ResizeObserver(() => positionSat()); state.satRO.observe(sb); }
  $('#drawer').querySelectorAll('[data-satz]').forEach(b => b.onclick = () => {
    state.satZoom = b.dataset.satz;
    if (satLiveOn()) { satLiveSet(false); unmountLiveMap($('#satbox')); const lb = $('#drawer').querySelector('[data-satlive]'); if (lb) lb.classList.remove('on'); }
    $('#drawer').querySelectorAll('[data-satz]').forEach(x => x.classList.toggle('on', x === b));
    positionSat();
  });
  /* v5.51 — Live: the map takes the window; a zoom button hands it back to the photograph */
  { const lb = $('#drawer').querySelector('[data-satlive]');
    if (lb) lb.onclick = () => {
      const on = !satLiveOn(); satLiveSet(on); lb.classList.toggle('on', on);
      $('#drawer').querySelectorAll('[data-satz]').forEach(x => x.classList.toggle('on', !on && x.dataset.satz === satZoom().k));
      if (on) mountLiveMap($('#satbox'), a, state.satPt); else unmountLiveMap($('#satbox'));
    };
    if (lb && satLiveOn()) mountLiveMap($('#satbox'), a, state.satPt); }
  const stm = $('#satToMap');
  if (stm) stm.onclick = () => { const sh = mapSheetFor(a); if (sh) { state.sheet = sh.key; close(); go('map'); } };
  { const sp = spotOf(a), words = sp ? sp.words : null;
    const fb3 = $('#satFly'); if (fb3) fb3.onclick = () => mountFlyAround($('#satgoogle'), Number(fb3.dataset.lat), Number(fb3.dataset.lon), a, words);
    const svb = $('#satSv'); if (svb) svb.onclick = () => mountStreetView($('#satgoogle'), Number(svb.dataset.lat), Number(svb.dataset.lon), a, words); }
  const fb = $('#dclose'); if (fb && !keep) fb.focus();
  $('#dclose').onclick = close; $('#dclose2').onclick = close;
  { const sb = $('#dshare'); if (sb) sb.onclick = () => shareDrop(a); }
  const so = $('#showOnMap'); if (so) so.onclick = () => {
    /* v5.79 — the same ringed landing the search gives: zoomed on the pill, circled, named above the map */
    const at = mapPlaceFor(a), sh = mapSheetFor(a);
    if (at) { close(); mapLocate(at.sheet.key, at.label, a.key, {marker: at.marker}); }
    else if (sh) { state.sheet = sh.key; state.sel = a.key; close(); go('map'); }
  };
  const tp = $('#toPlant'); if (tp) tp.onclick = () => { close(); showPlantGroup(a.key); };
  const dx = $('#deleteAsset'); if (dx) dx.onclick = () => deleteDialog(a.key);
  const cl = $('#copyLink'); if (cl) cl.onclick = () => copyLink('asset/' + a.key, a.key);
  const bn = $('#bdReport'); if (bn) bn.onclick = () => breakdownDialog({ref: a.key});
  $('#drawer').querySelectorAll('[data-bedit]').forEach(b => b.onclick = () => breakdownDialog(null, b.dataset.bedit));
  const bt = $('#toBreakdowns'); if (bt) bt.onclick = () => { state.q = a.key; const qb = $('#q'); if (qb) { qb.value = a.key; $('#qx').hidden = false; } state.bdFilter = 'all'; close(); go('breakdowns'); };
  /* walk the list the drawer was opened from — the register, a plant group, a day */
  const lst = state.list || [], at = lst.indexOf(a.key);
  const nav = $('#drawerNav');
  if (nav) { if (at >= 0 && lst.length > 1) {
      nav.hidden = false;
      $('#prevAsset').disabled = at <= 0; $('#nextAsset').disabled = at >= lst.length - 1;
      $('#drawerPos').textContent = (at + 1) + ' of ' + lst.length;
      $('#prevAsset').onclick = () => { if (at > 0) openAsset(lst[at - 1]); };
      $('#nextAsset').onclick = () => { if (at < lst.length - 1) openAsset(lst[at + 1]); };
    } else nav.hidden = true; }
  setHash('asset/' + a.key);
  const ds = $('#dropSheet'); if (ds) ds.onclick = () => dropSheet(a.key);
  /* Andrew Fisher, 13 Sep 2026: an email attaches the PDF and puts the drop location in the email itself, with the
     details and pictures, nicely formatted. On a phone the share sheet does it in one tap — Outlook,
     Gmail, WhatsApp, whatever is on the handset. Everywhere else the formatted email goes on the clipboard and
     is pasted into a new message, because a mail LINK carries plain text and cannot attach anything. */
  const td = $('#textDrop'); if (td) td.onclick = () => smsDropBox(a);
  const er = $('#emailRich');
  if (er) er.onclick = async () => {
    er.disabled = true; const was = er.textContent; er.textContent = 'Getting the pictures…';
    try {
      const m = await mailerState();
      if (m.ready) emailSendBox(a); else await copyDropEmail(a);
    } finally { er.disabled = false; er.textContent = was; }
  };
  /* TAKING AN ACCESSORY OFF. Andrew Fisher, 16 Sep 2026: an option to remove accessories.
     It works exactly as taking an asset number off works, and for the same reason: the schedule is
     never rewritten, the removal is written down with its time so the merge carries it, and putting it back is
     written down too — because the absence of a tombstone is not a restoration, and an older copy that still
     holds the removal would otherwise take it off again behind the person's back (TR-07, in a third coat). */
  $$('[data-accoff]').forEach(btn => btn.onclick = () => {
    if (!mayWrite('an accessory')) return;
    const id = btn.dataset.accoff;
    const x = (a.accessories || []).find(y => y._accId === id) || {};
    /* v5.59 — a row that came in through the on-site unit record comes out through it: the unit is taken out
       (dropped here, or tombstoned where it was committed), in the presser's name. Where that unit had put its
       number on the schedule's unnumbered one, the schedule's row stays, without the number — the schedule still
       asks for the thing — and a second Take off sets that aside too. Recording the unit again puts it back. */
    if (x._fromUnit) {
      const ok = unitRemove(a.key, {asset_no: x.asset_no || '', label: x.as_written || ''});
      if (ok && x._alsoUnit && !String(id).startsWith('unit|'))
        flash((x.type || 'The accessory') + (x.asset_no ? ' ' + x.asset_no : '') + ' is out of the on-site record for ' + a.key
          + '. The schedule still lists a ' + String(x.type || 'accessory').toLowerCase() + ' without a number — take that off too if there is none.');
      return;
    }
    tomb('acc/' + a.key + '/' + id);
    bump();
    flash(String(x.type || 'The accessory') + ' is off ' + a.key + '.'
      + (x._added ? ' It was added here — Put back is under the list.'
                  : ' The schedule still lists it — nothing was rubbed out, and Put back is under the list.'));
  });
  /* v5.58 — EDIT AN ACCESSORY RATHER THAN ADD ANOTHER. The 19 Sep 2026 audit: the only actions were Take off and
     Put back, so putting a serial on a fridge that was already listed meant adding a second fridge. Edit loads
     the row into the form; Save changes writes the number, the quantity and the description back onto THAT row.
     The row's identity — what it is, the words it was added with, the moment it was added — does not move, so a
     merge with another copy still knows it is the same fridge and does not make two. */
  let accEditing = null;
  const accFormReset = () => { accEditing = null;
    const b = $('#accAdd'), c = $('#accEditCancel'), l = $('#accFormLabel');
    if (b) b.textContent = 'Attach to ' + a.key; if (c) c.hidden = true; if (l) l.textContent = 'Attach an accessory — pick the type';
    ['#accNo', '#accDesc'].forEach(id => { const el = $(id); if (el) el.value = ''; });
    const q = $('#accQty'); if (q) q.value = '1'; };
  dsectWire();
  foldStories($('#drawer'));
  $$('[data-accedit]').forEach(btn => btn.onclick = () => {
    if (!mayWrite('an accessory')) return;
    const id = btn.dataset.accedit;
    const x = (a.accessories || []).find(y => y._accId === id); if (!x) return;
    accEditing = id;
    const sel = $('#accType'); if (sel) { if (![...sel.options].some(o => o.value === x.type)) { const o = document.createElement('option'); o.textContent = x.type; sel.appendChild(o); } sel.value = x.type; }
    $('#accQty').value = String(x.qty || 1); $('#accNo').value = x.asset_no || ''; $('#accDesc').value = x.description || '';
    { const m = $('#accMore'); if (m) m.open = true; }
    $('#accAdd').textContent = 'Save changes to this ' + String(x.type || 'accessory').toLowerCase();
    $('#accEditCancel').hidden = false; $('#accFormLabel').textContent = 'Editing';
    $('#accForm').scrollIntoView({block: 'nearest'}); $('#accNo').focus();
  });
  { const c = $('#accEditCancel'); if (c) c.onclick = accFormReset; }
  $$('[data-dbloff]').forEach(btn => btn.onclick = () => {
    if (!mayWrite('an accessory')) return;
    const id = btn.dataset.dbloff;
    const x = (a.accessories || []).find(y => y._accId === id) || {};
    tomb('acc/' + a.key + '/' + id);
    bump();
    flash('The later ' + String(x.type || 'entry') + (x.asset_no ? ' (asset no. ' + x.asset_no + ')' : '') + ' is set aside on ' + a.key
      + ' \u2014 the count reads one. Both entries stay on the record; Put back is under the list if that was wrong.');
  });
  $$('[data-accgone]').forEach(btn => btn.onclick = () => {
    if (!mayWrite('an accessory')) return;
    const id = btn.dataset.accgone;
    const x = (a._accessoriesTakenOff || []).find(y => y._accId === id) || {};
    const who = whoAmI(); if (!who) return;
    /* the row that was added in this page goes out of the record too; the tombstone is what keeps it out */
    const base = String(id).replace(/#\d+$/, '');
    if (x._added && S.accessories[a.key]) { S.accessories[a.key] = S.accessories[a.key].filter(r => accIdOf(r) !== base); if (!S.accessories[a.key].length) delete S.accessories[a.key]; }
    tomb('acc/' + a.key + '/' + id, who); tomb('accgone/' + a.key + '/' + id, who);
    bump();
    flash(String(x.type || 'The accessory') + (x.asset_no ? ' ' + x.asset_no : '') + ' is deleted from ' + a.key + ' for good by ' + who + '. Typing it again is the only way back.');
  });
  $$('[data-accback]').forEach(btn => btn.onclick = () => {
    if (!mayWrite('an accessory')) return;
    const id = btn.dataset.accback;
    const x = (a._accessoriesTakenOff || []).find(y => y._accId === id) || {};
    untomb('acc/' + a.key + '/' + id);
    bump();
    flash(String(x.type || 'The accessory') + ' is back on ' + a.key
      + ' — recorded, with the time, so no older copy takes it off again.');
  });
  $('#accAdd').onclick = () => {
    if (!mayWrite('an accessory')) return;
    const t = $('#accType').value;
    if (accEditing) {
      const q = wholeQty($('#accQty').value);
      if (q == null) { flash('Quantity has to be a whole number of 1 or more \u2014 "' + $('#accQty').value + '" was not saved.'); $('#accQty').focus(); return; }
      const no = $('#accNo').value.trim(), d = $('#accDesc').value.trim();
      if (no) {
        const other = (a.accessories || []).find(x => x._accId !== accEditing && String(x.asset_no || '').trim() === no);
        if (other) { flash('Asset no. ' + no + ' is already on another ' + String(other.type || 'accessory') + ' inside ' + a.key + ' \u2014 not saved. One number, one thing.'); return; }
      }
      const who = whoAmI(); if (!who) return;
      const rows = S.accessories[a.key] || [];
      const row = rows.find(x => accIdOf(x) === accEditing.replace(/#\d+$/, ''));
      if (!row) { flash('That row is from the schedule and cannot be edited here \u2014 take it off and add the right one.'); accFormReset(); return; }
      row.qty = q; row.qty_stated = true;
      row.asset_no = no || null; row.asset_no_state = no ? 'entered here' : 'not supplied';
      if (d) row.description = d; else delete row.description;
      row.edited_at = new Date().toISOString(); row.edited_by = who;   /* the row carries its own who and when */
      accFormReset(); bump();
      flash(String(row.type) + ' on ' + a.key + ' updated' + (no ? ' \u2014 asset no. ' + no : '') + '. Same row, same history.');
      return;
    }
    /* v5.58 — A QUANTITY IS THE NUMBER TYPED OR IT IS REFUSED. parseInt('1.5') is 1, and this quietly stored
       1 for anything somebody typed with a decimal in it (the 19 Sep 2026 audit). Nothing here rounds, floors
       or guesses: a positive whole number goes in, anything else is said back to the person and nothing is
       added. The box keeps what they typed so they can see what was refused. */
    const q = wholeQty($('#accQty').value);
    if (q == null) { flash('Quantity has to be a whole number of 1 or more \u2014 "' + $('#accQty').value + '" was not added. Type the count, not a fraction.'); $('#accQty').focus(); return; }
    const no = $('#accNo').value.trim(), d = $('#accDesc').value.trim();
    /* v5.58 — THE SAME PHYSICAL NUMBER IS NOT ADDED TWICE. P20 had air conditioner 1180683 entered twice, 73
       seconds apart, and both rows counted (the 19 Sep 2026 audit). An asset number is a physical thing: if an
       accessory carrying it is already inside this reference, that is the accessory, and pressing Add does
       not make a second one. The existing row is named so the person can edit it, and if it had been taken
       off, that is said too, with Put back where to find it. */
    if (no) {
      const dupOn = (a.accessories || []).find(x => String(x.asset_no || '').trim() === no);
      if (dupOn) { flash('Asset no. ' + no + ' is already inside ' + a.key + ' as ' + String(dupOn.type || 'an accessory') + ' \u2014 nothing added. '
                         + (dupOn._fromUnit ? 'It is in the on-site unit record; take that one off first if it is wrong.' : 'Edit that one rather than adding another.')); $('#accNo').focus(); return; }
      const dupOff = (a._accessoriesTakenOff || []).find(x => String(x.asset_no || '').trim() === no);
      if (dupOff) { flash('Asset no. ' + no + ' was ' + String(dupOff.type || 'an accessory') + ' on ' + a.key + ' and has been taken off \u2014 nothing added. Put back is under the list.'); return; }
    }
    const at = new Date().toISOString();
    /* adding the same thing again after taking it off is a putting-back, and is recorded as one */
    untomb('acc/' + a.key + '/' + accIdOf({type: t, as_written: (q>1?q+'x ':'')+t+(d?' — '+d:''), added_at: at}));
    (S.accessories[a.key] = S.accessories[a.key] || []).push({
      type:t, qty:q, qty_stated:true, as_written:(q>1?q+'x ':'')+t+(d?' — '+d:''),
      asset_no:no||null, asset_no_state:no?'entered here':'not supplied',
      origin:'added in this page', source_task:null, _added:true,
      added_at:at, added_by:S.operator||null});
    bump();
    flash(t + (q>1?' ×'+q:'') + ' is attached to ' + a.key + (no ? ' — asset no. ' + no + ' is on this reference' : '') + '.');
  };
  /* the phone keyboard's Go/Enter adds the number too — a person should not have to find the button */
  { const nb = $('#numAdd'); if (nb) nb.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); const b = $('#numBtn'); if (b) b.click(); } }; }
  $('#numBtn').onclick = () => {
    const v = $('#numAdd').value.trim(); if (!v) return;
    if ((a.asset_numbers || []).includes(v)) return flash(v + ' is already on ' + a.key + '.');
    untomb('num/' + a.key + '/' + v);                        // typing it again is a putting-back, and is recorded as one
    if (numberErased('num/' + a.key + '/' + v)) { delete S.notes['num/' + a.key + '/' + v]; stampIt('notes', 'num/' + a.key + '/' + v); }   // v5.79 — an erased typo typed again is a number again, and the Journal may say so
    /* the box is emptied BEFORE the redraw: the redraw keeps whatever is in the field that has focus (so a
       half-typed number survives a sync), and a number just saved is not half-typed — left there it would sit in
       the box with Enter offering "already on" (23 Sep 2026). After the redraw the cursor goes back in the box,
       whichever of Enter or the button was used, so the next number can be typed straight away. */
    $('#numAdd').value = '';
    (S.assetNumbers[a.key] = S.assetNumbers[a.key] || []).push(v); bump();
    { const nb = $('#numAdd'); if (nb) { try { nb.focus({preventScroll: true}); } catch (e) {} } }
    flash(v + ' is now on ' + a.key + ' — it counts everywhere the page counts asset numbers.');
  };
  /* Taking a number off. Andrew Fisher, 13 Sep 2026: press a map location and change the assigned asset number if
     needed. A number is never rubbed out of the sources — it is set aside, with the day it was set
     aside, so the schedule still reads the way it was written and every other copy of the record learns of the
     removal at the next merge instead of quietly putting it back. */
  (() => { const hb = $('#hsSave'); if (hb) hb.onclick = () => { if (!setHireStart(a.key, $('#hsBox').value)) render(); };
    const ms = $('#mapRefSel'); if (ms) ms.onchange = () => { const v = ms.value; const opt = ms.options[ms.selectedIndex]; const [kind, ...rest] = String(v).split('|');
      if (!v) { if (!setMapRef(a.key, '', '', '')) render(); } else if (!setMapRef(a.key, rest.join('|'), opt ? opt.textContent.replace(/ \(not in the library now\)$/, '') : rest.join('|'), kind)) render(); };
    $$('#drawer [data-moveback]').forEach(b => b.onclick = () => { if (!confirm('Put the record back on ' + b.dataset.moveto + ' from ' + b.dataset.moveback + '?')) return; if (moveRecord(b.dataset.moveback, b.dataset.moveto)) openAsset(b.dataset.moveto); });
    $$('#drawer [data-mapsheet]').forEach(b => b.onclick = () => { const c = $('#dclose'); if (c) c.click();
      /* v5.79 — ringed on the sheet named, when its callout is drawn there */
      const sh = DATA.sheets.find(x => x.key === b.dataset.mapsheet);
      const l = sh && (a.drawing_links || []).find(x => x.sheet === sh.sheet_id);
      const m = l && (sh.markers || []).find(x => x.marker_kind !== 'note' && (l.tag_id && x.tag ? x.tag === l.tag_id : x.label === l.label));
      if (m) { mapLocate(sh.key, String(m.label), a.key, {marker: m}); return; }
      state.sheet = b.dataset.mapsheet; state.sel = a.key; go('map'); });
    $$('#drawer .movedline [data-k]').forEach(b => b.onclick = () => openAsset(b.dataset.k)); })();
  $$('[data-numoff]').forEach(btn => btn.onclick = () => {
    const n = btn.dataset.numoff;
    const fromSchedule = (a._numbersOnTheSchedule || []).includes(n);
    S.assetNumbers[a.key] = (S.assetNumbers[a.key] || []).filter(x => x !== n);
    if (!S.assetNumbers[a.key].length) delete S.assetNumbers[a.key];
    /* EVERY removal leaves a record, not just the removal of a number the schedule already had. From an outside
       audit of 14 Sep 2026, TR-01: a number somebody typed on site and then took off left no tombstone at all,
       so the next merge with an older copy quietly put it back — and an asset number that comes back from the
       dead ends up printed on a drop sheet. The absence of a value is not a deletion; a deletion is a thing that
       has to be written down and carried, and this writes it down for typed numbers exactly as it always did
       for the schedule's. */
    tomb('num/' + a.key + '/' + n);
    /* v5.79 — FOR GOOD. Andrew Fisher, 23 Sep 2026, with the drawer's "Taken off — still on the schedule, not
       counted here: … Put back" in front of him, asked for deleting it for good to be an option. So a
       removed number is gone from the page: no list of what was taken off, no Put back. The tombstone stays in
       the record because it is what carries the removal to every other copy at the next merge — without it an
       older phone would hand the number straight back (TR-01, 14 Sep 2026) — and the Journal keeps the line that
       says who removed it and when, which is a record, not an option. Typing the number again is the only way
       back, and is recorded as one. */
    bump(); flash(n + ' is off ' + a.key + ' for good' + (fromSchedule ? ' \u2014 on every copy of the record; the schedule\u2019s own paper is not rewritten.' : '.'));
  });
  /* v5.76 — the number that was only ever typed here is erased outright: no tombstone, no history, because
     there was nothing before it was typed. v5.79 — one press, like the other Remove; typing it again is the way
     back, and there is nothing to confirm because there is nothing that cannot be typed again. */
  $$('[data-numgone]').forEach(btn => btn.onclick = () => {
    const n = btn.dataset.numgone;
    if (!numberErase(a.key, n)) { flash(n + ' could not be erased here \u2014 it is on the schedule, already recorded on '
      + 'site, or held by the rental system, so it is removed for good the other way.'); tomb('num/' + a.key + '/' + n); bump(); return; }
    flash(n + ' is off ' + a.key + ' for good. Nothing records it having been there.');
  });
  if ($('#locSave')) $('#locSave').onclick = () => {
    const v = $('#locBox').value.trim();
    S.locations = S.locations || {};
    if (v) S.locations[a.key] = v; else delete S.locations[a.key];
    stampIt('locations', a.key); bump();
    flash(v ? 'Where ' + a.key + ' goes is now "' + v + '" — on the map, the day and the drop sheet.'
            : a.key + ' is back to where the schedule puts it.');
  };
  if ($('#locClear')) $('#locClear').onclick = () => {
    delete (S.locations || {})[a.key]; stampIt('locations', a.key); bump();
    flash(a.key + ' is back to where the schedule puts it.');
  };
  /* the things inside it: one form records a unit, one button takes one out — and bump() redraws the drawer,
     the map and the register from the same record */
  wireUnitForm($('#drawer'));
  $$('#drawer [data-udel]').forEach(b => b.onclick = () => unitRemove(a.key, {asset_no: b.dataset.udelno || '', label: b.dataset.udel || ''}));
  /* the other reference claiming one of this one's asset numbers — one press to go and look at it */
  $$('#drawer .notice [data-k]').forEach(b => b.onclick = () => openAsset(b.dataset.k));
  /* the drop photographs. The drawer is redrawn by bump(), so every one of these says what happened in the
     block's own line as well as the flash — on a phone at the circuit the flash is often gone before it is read. */
  (() => {
    const msg = w => { const m = $('#dphMsg'); if (m) m.textContent = w; flash(w); };
    $$('[data-dphadd]').forEach(inp => inp.onchange = async () => {
      const f = inp.files && inp.files[0];
      inp.value = '';                                   // so picking the same file twice still fires
      if (f) await dropPhotoAdd(a.key, Number(inp.dataset.dphadd), f, msg, inp.dataset.dphunit || '');
    });
    $$('[data-dphdel]').forEach(b => b.onclick = () => dropPhotoRemove(a.key, Number(b.dataset.dphdel), msg, b.dataset.dphunit || ''));
    /* a photograph filed against this reference on the service, put into one of the drop sheet's places */
    $$('[data-fileduse]').forEach(b => b.onclick = () => filedPhotoUse(a.key, b.dataset.fileduse, msg));
    $$('[data-dphreuse]').forEach(sel => sel.onchange = () => { const id = sel.value; if (!id) return;
      filedPhotoUse(a.key, id, msg, sel.dataset.dphunit || '', Number(sel.dataset.dphreuse)); });
    /* The caption keeps itself when the box is left or Enter is pressed — no Save to remember. It only writes
       when the words actually changed, so tabbing through the drawer never stamps the record. */
    $$('[data-dphcap]').forEach(box => {
      const keep = () => {
        const i = Number(box.dataset.dphcap), v = box.value.trim(), u = box.dataset.dphunit || '';
        const list = dropPhotoSlots(a.key, u).map((x, n) => x && Object.assign({}, x, {slot: n})).filter(Boolean);
        const hit = list.find(x => x.slot === i);
        if (!hit || (hit.caption || '') === v) return;
        hit.caption = v;
        dropPhotoGroupSet(a.key, u, list); bump();
        msg(v ? 'That photograph now reads \u201c' + v + '\u201d.' : 'Caption cleared \u2014 it reads ' + (DROP_SLOTS[i] || {}).lab + ' again.');
      };
      box.onblur = keep;
      box.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); keep(); box.blur(); } };
    });
    $$('[data-dphopen]').forEach(i => i.onclick = () => window.open(i.dataset.dphopen, '_blank', 'noopener'));
  })();
  $('#noteSave').onclick = () => { if (!mayWrite('a note')) return; const who = whoAmI(); if (!who) return;
    S.notes[a.key] = $('#noteBox').value; stampIt('notes', a.key, who); bump(); flash('Note saved.'); };
  $('#wkSave').onclick = () => {
    if (!mayWrite('the weeks')) return;
    const who = whoAmI(); if (!who) return;
    const v = $('#wkBox').value.trim();
    if (v === '') delete S.weeks[a.key]; else S.weeks[a.key] = v;
    stampIt('weeks', a.key, who); bump();
  };
  /* labour per piece: a tick on this reference, by name */
  $('#drawer').querySelectorAll('input[data-lab]').forEach(cb => cb.onchange = () => {
    /* the first part carries the building where there is more than one — "WC15/u1327226" (v5.55) */
    const [who, disc, item, line] = cb.dataset.lab.split('|');
    const p = fixParse(who);
    if (!setLabour(p.ref, disc, item, line, cb.checked, p.unit)) { cb.checked = !cb.checked; return; }
    openAsset(p.ref, {keep: true});   /* the subtotal under the ticks moves with the tick */
  });
  /* V11 audit, F04: the drawer went into the page after render() had finished, so nothing had told its
     twelve fields what this link may do. The audit opened a fresh P33 drawer on a view-only link and found
     every one of them enabled. */
  mounted($('#drawer'));
}
$('#scrim').onclick = () => { const c = $('#dclose'); if (c) c.click();
  else { $('#drawer').classList.remove('on'); $('#scrim').classList.remove('on'); syncInert(); } };
/* While any dialog is open the page behind it is inert — no focus, no clicks, no scrolling into it — which is
   what makes the drawer a modal rather than a panel over a live page. Dialogs made on the fly (breakdown,
   variance, import, clashes) are children of body, so the observer sees them come and go. */
function syncInert(){ const app = document.querySelector('.app'); if (!app) return;
  const open = !!document.querySelector('body > .drawer.on'); try { app.inert = open; } catch (e) {} document.body.classList.toggle('modal-open', open); }
new MutationObserver(() => syncInert()).observe(document.body, {childList: true});

/* ------------------------------------------------------------------ moving an asset onto a day */
function cancelDialog(key){
  const a = assetOf(key); if (!a) return;
  if (!mayWrite('a cancellation')) return;
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', 'Cancel ' + key);
  const when = effectiveDates(a).in;
  d.innerHTML = `<div class="dh"><div><h2>Cancel ${esc(key)}</h2><div class="sub">${esc(a.name || '')}${when ? ' · due in ' + esc(fmtDate(when)) : ''}</div></div>
    <button class="close" id="cxClose" aria-label="Close" title="Close">&times;</button></div>
    <div class="db"><div class="form">
      <div class="f"><label for="cxWhy">Why</label><input id="cxWhy" list="cxWhys" placeholder="no longer needed · mis-delivery · customer cancelled …" autocomplete="off">
        <datalist id="cxWhys"><option value="No longer needed"><option value="Mis-delivery"><option value="Customer cancelled"><option value="Duplicated on the schedule"></datalist></div>
      <div class="hint">It comes off every day, list, count and drop sheet, wears the ring-and-bar on the register, the map and the timeline, and stays on the schedule with your name and this reason. It can be put back from the same button.</div>
    </div></div>
    <div class="df"><button class="btn primary" id="cxSave">Cancel ${esc(key)}</button><button class="btn ghost" id="cxKeep">Keep it</button></div>`;
  mounted(document.body.appendChild(d));
  const shut = () => d.remove();
  $('#cxClose', d).onclick = shut; $('#cxKeep', d).onclick = shut;
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  const go_ = () => { const why = ($('#cxWhy', d).value || '').trim();
    if (!why) { flash('Say why — a cancellation with no reason is a mistake waiting to be found.'); $('#cxWhy', d).focus(); return; }
    if (setRowOff(key, true, why)) { shut(); render(); } };
  $('#cxSave', d).onclick = go_;
  $('#cxWhy', d).addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); go_(); } });
  $('#cxWhy', d).focus();
}
function addToDayDialog(iso){
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', 'Add an asset to this day');
  const list = allAssets().slice().sort((x, y) => x.key.localeCompare(y.key));
  d.innerHTML = `<div class="dh"><div><h2>Add an asset to ${esc(fmtDate(iso))}</h2><div class="sub">Its plan date is kept and shown beside the new one as “moved from”.</div></div>
    <button class="close" id="adClose" aria-label="Close" title="Close">&times;</button></div>
    <div class="db"><div class="form">
      <div class="f"><label for="adKey">GC500 reference</label><input id="adKey" list="adKeys" placeholder="type a reference — P09, GN01, WC12" autocomplete="off">
        <datalist id="adKeys">${list.map(a => `<option value="${esc(a.key)}">${esc(a.key)} · ${esc(a.name || (a.item_types || []).join(', ') || '')}${a.first_date ? ' · plan ' + esc(fmtDay(a.first_date).dm) : ''}</option>`).join('')}</datalist></div>
      <div class="f"><label>Which way</label><select id="adWhich"><option value="in">Due in on this day</option><option value="out">Due out on this day</option></select></div>
      <div class="hint">A move carries your name from “Recording as”. Clearing the date on the day view or in the drawer puts it back on the plan.</div>
    </div></div>
    <div class="df"><button class="btn primary" id="adSave">Move it here</button><button class="btn ghost" id="adCancel">Cancel</button></div>`;
  mounted(document.body.appendChild(d));
  const shut = () => d.remove();
  $('#adClose', d).onclick = shut; $('#adCancel', d).onclick = shut;
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  $('#adSave', d).onclick = () => {
    const key = ($('#adKey', d).value || '').trim().toUpperCase();
    if (!allAssets().some(a => a.key === key)) { flash(key ? key + ' is not a reference in this file.' : 'Type a reference first.'); return; }
    if (setDate(key, iso, $('#adWhich', d).value)) shut();
  };
  $('#adKey', d).focus();
}

/* Board 4, "04 / precision tags": four facts about the record itself, each named, on every drawer.
   SOURCE — who the delivery state came from; REVISION — the drawing the position is read from and its
   revision as printed on the sheet; LOCATION — how far the position can be trusted; SYNC — where this copy of
   the record lives right now. None of them is decoration: each one is read from the record the moment the
   drawer draws, and each says "none" rather than guess. */
/* Superior Audit, 15 Sep 2026, F08. P33's evidence line said "shared record" and its Source pill said
   "Site entry · this browser", about the same delivery, three centimetres apart. Both were reporting something
   true and neither said which question it was answering. Three different questions were sharing one pill:

     WHO OBSERVED IT      a person on site, or the Coates rental system, or nobody yet
     WHERE IT IS KEPT     the shared record, this browser, the synced folder, or the last build
     WHAT THE LINK IS DOING   live, connecting, offline, view only

   The second of those is not evidence about the delivery at all — it is a fact about this copy of the page —
   and inferring "typed in this browser" from "a browser is showing it" was exactly the wrong inference.
   Three questions, three tags, each labelled with the question it answers. */
function observationOf(d){
  if (!d.recorded) return {word: 'No entry yet', why: 'nobody has recorded a delivery for this reference'};
  if (d.where === 'rental') return {word: 'Rental system', why: 'the Coates rental system has it on hire from its start date — nobody set a light'};
  return {word: 'A person on site', why: (d.by ? d.by + ' set it' : 'somebody set it') + (d.set_at ? ' at ' + fmtStamp(d.set_at) : '') + ' on site'};
}
function storedOf(d){
  if (!d.recorded) return {word: 'Nothing to keep', why: 'there is no delivery record for this reference yet'};
  if (d.where === 'rental') return {word: 'Rental system', why: 'read from the Coates rental data in this build'};
  if (d.where === 'committed') return {word: 'In the build', why: 'read from the committed file at the last rebuild'};
  if (SYNC.on) return {word: 'Shared record', why: 'in the shared record everyone who opens this link sees; not yet exported to the build'};
  if (FOLDER.status === 'live') return {word: 'Shared folder', why: 'kept in the folder OneDrive syncs — everyone connected to it shares it'};
  return {word: 'This browser', why: 'saved in this browser and nowhere else yet — export it to keep it'};
}
function precisionTags(a){
  const d = deliveryOf(a.key), link = (a.drawing_links || [])[0];
  const obs = observationOf(d), kept = storedOf(d);
  const doc = link ? ((DATA.docs || {}).docs || []).find(x => (x.sheet_ids || []).includes(link.sheet)) : null;
  const rev = link ? (link.sheet.split('-')[0] + (doc && (doc.rev_on_page || doc.revision) ? ' rev ' + (doc.rev_on_page || doc.revision) : ' · rev not on file')) : 'No drawing';
  const mv = movedFor(a), pt = aerialPointFor(a);
  const loc = mv ? 'Changed · pin needs checking' : pt ? 'Needs confirmation' : link ? 'Drawn · not placed' : 'No position';
  const sync = SYNC.status === 'live' ? (SYNC.readonly ? 'Live · view only' : 'Live') : SYNC.status === 'file' ? 'No service behind this copy'
             : SYNC.status === 'connecting' ? 'Connecting' : SYNC.status === 'unreachable' ? 'Offline · will send' : 'Snapshot';
  const tag = (k, kicker, v, title) => `<span class="ptag ${k}" title="${esc(title)}"><small>${kicker}</small><b>${esc(v)}</b></span>`;
  return `<div class="ptags">
    ${tag('src', 'Observed by', obs.word, obs.why)}
    ${tag('kept', 'Kept in', kept.word, kept.why)}
    ${tag('rev', 'Revision', rev, 'the drawing the position is read from, and the revision printed on it')}
    ${tag('loc', 'Location', loc, 'how far the position can be trusted — a drawing match is never a checked spot')}
    ${tag('sync', 'This link', sync, 'what this copy of the page is doing right now — not a fact about the delivery')}
  </div>`;
}
/* ------------------------------------------------------------------ the delivery card in the drawer */
function deliveryCard(a){
  const d = deliveryOf(a.key), L = LIGHT[d.state], eff = effectiveDates(a);
  const hist = d.history.slice().reverse().slice(0, 6);
  return `
  <div class="card" style="margin:0 0 14px">
    <h3>Delivery</h3>
    <div class="tlcard one">
      <div>${lightSet(a.key)}</div>
      <div class="since" title="Press a lens to set it — red not on site, amber in transit, green on site">${d.recorded
          ? `set ${esc(fmtStamp(d.set_at))} by <b>${esc(d.by || 'unnamed')}</b> ${whereChip(d.where)}`
          : 'no delivery recorded yet'}</div>
    </div>
    ${(() => { const r = rentalOf(a.key); if (!r) return '';
      return `<div class="tlcard" style="display:block"><div class="k" style="font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);font-weight:700;margin-bottom:4px">On hire — Coates rental system</div>
        <ul style="margin:0;padding:0;list-style:none;font-size:12.5px;line-height:1.5">${r.lines.map(x => `<li>${assetNo(x.asset_no)} ${esc(x.description || '')}
          <span class="w" style="color:var(--mute)">· branch ${esc(x.branch_code || '—')} · contract ${esc(x.rental_contract || '—')}${x.delivery_number ? ' · delivery ' + esc(x.delivery_number) : ''}${x.start_date ? ' · from ' + esc(fmtDate(x.start_date)) + (x.start_time ? ' ' + esc(x.start_time) : '') : ''}${x.demob_date ? ' · off hire ' + esc(fmtDate(x.demob_date)) : ''}</span></li>`).join('')}</ul>
        ${!r.machines.length && r.accessories.length ? `<p class="norate" style="margin:8px 0 0">Only an accessory is on hire here — the ${esc((r.accessories[0].description || '').toLowerCase())}, the rental system's own miscellaneous line. An attachment is not the machine, so it does not put this line on site and it counts as none. If the machine is there, set the light yourself.</p>` : ''}</div>`; })()}
    <div class="tlcard tickcard">
      ${/* v5.81 — the ticks say what they are and when; the reading of them is a tooltip, not a paragraph (management, 24 Sep 2026).
            The Steps tick is offered only where the card prices steps on this item — the labour rule (Andrew Fisher, 24 Sep 2026:
            only where the description mentions it; not as per the reference, not added). */ ''}
      <div class="tickrow">${doneBtn(a.key)}${levelBtn(a.key)}${mentionsSteps(a) ? stepsBtn(a.key) : ''}</div>
      <div title="Complete: in position, set up and checked. Levelled: the final check for a building, toilet or tank. The light says it arrived; the tick says it is done.">
        <span class="${d.done ? 'tick big' : 'tick big off'}">${d.done ? '✓ Complete' : 'Not ticked complete'}</span>
        <div class="since">${d.done
          ? `${esc(fmtStamp(d.done_at))} · <b>${esc(d.done_by || 'unnamed')}</b> ${whereChip(d.done_where)}${
              d.levelled ? `<br>${levelGlyph(12)} positioned and levelled — closed off ${esc(fmtStamp(d.levelled_at))} · <b>${esc(d.levelled_by || 'unnamed')}</b> ${whereChip(d.levelled_where)}` : ''}${
              mentionsSteps(a) && deliveryOf(a.key).steps ? '<br><span class="w" style="color:var(--mute)">steps installed \u2014 ' + esc(deliveryOf(a.key).steps_by || 'unnamed') + ', ' + esc(fmtStamp(deliveryOf(a.key).steps_at)) + '</span>' : ''}`
          : d.done_at ? `un-ticked ${esc(fmtStamp(d.done_at))} · <b>${esc(d.done_by || 'unnamed')}</b> ${whereChip(d.done_where)}`
          : ''}</div>
      </div>
    </div>
    <div class="form" style="margin-top:12px">
      <div class="row2">
        <div class="f"><label for="date-${esc(a.key)}">Due in on</label>
          <input id="date-${esc(a.key)}" type="date" data-date="${esc(a.key)}" value="${esc(eff.in || '')}">
          <div class="hint">${eff.in ? `<b>${esc(fmtDay(eff.in).dow + ' ' + fmtDay(eff.in).dm)}</b>` : ''}${eff.in_moved ? ` · moved from ${esc(fmtDate(eff.in_plan || ''))} by ${esc(eff.in_by || 'unnamed')} ${esc(fmtStamp(eff.in_at || ''))} ${whereChip(eff.in_where || 'local')}`
            : a.first_date ? ' · plan date' : 'no date on the schedule'}</div></div>
        <div class="f"><label for="eta-${esc(a.key)}">Planned time to site</label>
          <input id="eta-${esc(a.key)}" type="time" step="300" data-eta="${esc(a.key)}" value="${esc(d.eta || '')}">
          <div class="hint">${d.eta ? (d.eta_where === 'local' ? LW() : 'shared record') : ''}</div></div>
      </div>
      <div class="f"><label for="outdate-${esc(a.key)}">Due out on</label>
        <input id="outdate-${esc(a.key)}" type="date" data-outdate="${esc(a.key)}" value="${esc(eff.out || '')}">
        <div class="hint">${eff.out ? `<b>${esc(fmtDay(eff.out).dow + ' ' + fmtDay(eff.out).dm)}</b>` : ''}${eff.out_moved ? ` · moved from ${esc(fmtDate(eff.out_plan || ''))} by ${esc(eff.out_by || 'unnamed')} ${esc(fmtStamp(eff.out_at || ''))}`
          : eff.out_plan ? ' · plan date' : 'no off-site date on the plan'}</div></div>
      <div class="f"><label for="dnote-${esc(a.key)}">Delivery note</label>
        <input id="dnote-${esc(a.key)}" data-dnote="${esc(a.key)}" value="${esc(d.note || '')}"
          placeholder="e.g. crane on site from 06:00, driver rang from the gate"></div>
    </div>
    ${hist.length ? `<details class="sfold"><summary>Light history · ${hist.length}</summary><div class="sfoldbody"><ul class="tlhist" aria-label="Traffic light history">${hist.map(h =>
      `<li><span class="tl ${(LIGHT[h.state]||LIGHT['not on site']).c}"><i></i></span>
        <span>${esc((LIGHT[h.state]||{label:h.state}).label)}</span>
        <span class="w" style="color:var(--mute)">${esc(fmtStamp(h.at))} · ${esc(h.by || 'unnamed')}</span></li>`).join('')}</ul></div></details>` : ''}
  </div>`;
}
function wireDelivery(a){
  const n = $('#drawer').querySelector('[data-dnote]');
  if (n) n.onchange = () => setDeliveryNote(a.key, n.value);
}

/* ------------------------------------------------------------------ add an asset */
/* "Give it a reference": the Add tab opens with the schedule row's own words filled in and the row named, so the
   asset that comes out of it says where it came from and the row leaves the unreferenced list */
function giveReference(taskId){
  if (!mayWrite('that reference')) return;
  const r = (DATA.unreferenced || []).find(x => x.task_id === taskId); if (!r) return;
  const disc = [...new Set(DATA.assets.map(a => a.discipline))].includes(r.discipline) ? r.discipline : 'Other';
  /* the rental extract's lines for this row: one plant number fills the box, several go into the note so nobody
     picks one at random; the branch code is offered on the form and only becomes a record when it is saved */
  const oh = onhireForRow(taskId), nums = oh.filter(x => x.asset_no_is_plant_number).map(x => x.asset_no);
  const codes = [...new Set(oh.map(x => x.branch_code))];
  const rowNos = (r.asset_numbers || []);
  const onhireNote = oh.length
    ? ` The rental system has ${oh.length} line${oh.length === 1 ? '' : 's'} against this row on contract ${[...new Set(oh.map(x => x.rental_contract))].join(', ')}`
      + `${codes.length ? ' (branch ' + codes.join(', ') + ')' : ''}`
      + `${nums.length ? ', asset numbers ' + nums.join(', ') : ''}`
      + `${oh[0].demob_date ? ', off hire ' + fmtDate(oh[0].demob_date) : ''} — ${(ONHIRE_STATE[oh[0].match.state] || {}).word || oh[0].match.state}.`
    : '';
  state.addPrefill = {srcRow: r.task_id, disc, type: r.item || r.product || '', loc: r.location || '', from: r.date || '',
                      no: rowNos[0] || (nums.length === 1 ? nums[0] : ''),
                      branch: codes.length === 1 ? codes[0] : '',
                      note: `From schedule row ${r.task_id} (${r.sheet || ''}${r.source_range ? ' ' + r.source_range : ''}): ${unrefWords(r)}${r.activity ? ' · ' + r.activity : ''}${r.notes ? ' · ' + r.notes : ''} — the row carried no GC500 reference.${onhireNote}`};
  go('add');
}
/* ------------------------------------------------------------------ THE EDIT TABLE
   Andrew Fisher, 16 Sep 2026: an edit page where people can edit or add — the date, the description, the map location
   and perhaps the day rate — because dates, descriptions and map locations change; whatever is added or changed
   here updates everywhere else, and editing has to be really easy.

   Asked which shape he wanted, he chose a table you edit in place: no forms, no Save button per row, no second
   copy of anything. A box on this page is the record's own field with a cursor in it.

   THE ONE RULE THIS PAGE IS BUILT ON. Nothing here owns a value. Every box writes through the setter every
   other surface already writes through — setDesc, setLocationText, setDate, and the same S.rates the Pricing
   page types into — and every box reads back out of the same projection every other surface reads. So a word
   typed here is on the register, in the drawer, on the map's titles, in the load brief, on the advice email and
   on every printed sheet before the cursor leaves the box, and there is nothing to keep in step because there
   is only ever one value.

   AND THE SCHEDULE IS NEVER RUBBED OUT. A typed description, destination or date sits OVER the schedule's,
   which stays in the build and is printed under the box in grey with the words "the schedule says". Clearing a
   box puts the schedule's own answer straight back. That is the rule the whole file has kept since the first
   day and it is not relaxed for a page whose job is editing.

   THE RATE IS THE ONE COLUMN THAT IS NOT PER REFERENCE, and it says so. A rate belongs to an item TYPE on the
   card — "Portable buildings | 3m x 3m site office" — so typing one changes every reference of that type, and
   the cell names how many. A typed rate is PER WEEK, because that is what the arithmetic multiplies and what
   the Pricing page has always meant by it; the card's daily rate is shown beside it, read-only, so "the day
   rate if available" is on the page without a weekly box quietly being filled with a daily figure. */
var EDIT = {q: '', disc: '', only: '', sort: 'date'};
const EDIT_ONLY = [['', 'everything'], ['changed', 'typed over here'], ['nodate', 'no date at all'],
                   ['noloc', 'nowhere to go'], ['norate', 'no rate'], ['soon', 'due in the next 14 days']];
function editTouched(a){
  return !!(a._nameTyped || a._locationMoved || a._itemTyped || a._qtyTyped || effectiveDates(a).in_moved || effectiveDates(a).out_moved);
}
function editSchedName(a){ return String(a._nameOnTheSchedule == null ? (a.name || '') : a._nameOnTheSchedule).trim(); }
function editSchedLoc(a){
  return String((a._locationMoved && a._locationMoved.from) || (a.locations || []).find(l => l && l !== a.key) || '').trim();
}
function editRateKey(a){
  const item = (a.item_types || [])[0] || a.product || null;
  return item ? {k: a.discipline + '|' + item, disc: a.discipline, item} : null;
}
function editRateShare(rk){
  return allAssets().filter(a => { const r = editRateKey(a); return r && r.k === rk; }).length;
}
function editRows(){
  const q = EDIT.q.trim().toLowerCase();
  const soon = addDays(todayIso(), 14);
  const rows = allAssets().filter(a => {
    if (EDIT.disc && a.discipline !== EDIT.disc) return false;
    const ed = effectiveDates(a);
    if (EDIT.only === 'changed' && !editTouched(a)) return false;
    if (EDIT.only === 'nodate' && ed.in) return false;
    if (EDIT.only === 'noloc' && ((a.locations || []).some(l => l && l !== a.key))) return false;
    if (EDIT.only === 'norate') { const r = editRateKey(a); if (r && rateFor(r.disc, r.item, a.key).value != null) return false; }
    if (EDIT.only === 'soon' && !(ed.in && ed.in >= todayIso() && ed.in <= soon)) return false;
    if (!q) return true;
    return [a.key, a.name, a.discipline, (a.item_types || []).join(' '), (a.locations || []).join(' '),
            (a.asset_numbers || []).join(' ')].join(' ').toLowerCase().indexOf(q) >= 0;
  });
  const by = EDIT.sort;
  return rows.sort((x, y) => {
    if (by === 'ref') return x.key.localeCompare(y.key, undefined, {numeric: true});
    if (by === 'disc') return (x.discipline || '').localeCompare(y.discipline || '') || x.key.localeCompare(y.key, undefined, {numeric: true});
    const dx = effectiveDates(x).in || '9999', dy = effectiveDates(y).in || '9999';
    return dx.localeCompare(dy) || x.key.localeCompare(y.key, undefined, {numeric: true});
  });
}
/* A redraw of this page replaces every box on it, so the cursor and the scroll are put back exactly where the
   person left them — otherwise typing a date on row 90 throws them to the top of the table, which is the fault
   that makes an "editable" page unusable on a phone. */
function editKeepPlace(){
  const pane = $('#pane-edit'); if (!pane) return null;
  const el = document.activeElement;
  const id = el && pane.contains(el) ? el.id : null;
  const wrap = pane.querySelector('.edwrap');
  return {id, sel: id && el.setSelectionRange ? [el.selectionStart, el.selectionEnd] : null,
          y: window.scrollY, x: wrap ? wrap.scrollLeft : 0};
}
function editPutBack(p){
  if (!p) return;
  const pane = $('#pane-edit'); if (!pane) return;
  const wrap = pane.querySelector('.edwrap'); if (wrap && p.x) wrap.scrollLeft = p.x;
  if (p.y) window.scrollTo(0, p.y);
  if (!p.id) return;
  const el = document.getElementById(p.id); if (!el) return;
  try { el.focus({preventScroll: true}); } catch (e) { el.focus(); }
  if (p.sel && el.setSelectionRange) { try { el.setSelectionRange(p.sel[0], p.sel[1]); } catch (e) {} }
}
function editSchedLine(word, said){
  return said ? `<div class="edwas">the schedule says <b>${esc(said)}</b></div>`
              : `<div class="edwas">the schedule says nothing about the ${esc(word)}</div>`;
}
/* A DATE BOX READS THE BROWSER'S LOCALE, NOT OURS. A native date input on a machine set to the United States
   draws 09/16/2026 and there is no way to make it draw anything else. So the day is written out underneath in
   the form this job uses — Wed 16 Sep 2026 — and that line, not the box, is what a person reads. */
function editDayLine(iso, moved, plan){
  if (!iso) return `<div class="edwas">no day set</div>`;
  const f = fmtDay(iso);
  return `<div class="edwas"><b>${esc(f.dow + ' ' + f.dm + ' ' + iso.slice(0, 4))}</b>${
    moved ? ' · the schedule says ' + (plan ? esc(fmtDay(plan).dm + ' ' + plan.slice(0, 4)) : 'nothing') : ''}</div>`;
}
/* What the row IS right now, in four words, so the edit table can be read as a status list and a person never
   has to open the register to see whether the thing they are re-dating has already turned up. */
function editStateLine(a){
  const v = deliveryView(a), d = deliveryOf(a.key);
  const inside = unitsOf(a.key).length;
  const bits = [];
  if (d.done) bits.push('<span class="tick sm" title="complete">✓</span>');
  if (d.levelled) bits.push(`<span class="tick sm lvl" title="positioned and levelled">${levelGlyph(10)}</span>`);
  if (d.steps) bits.push(`<span class="tick sm stp" title="steps installed">${stepsGlyph(10)}</span>`);
  return `<div class="edstate"><span class="edlt ${esc(v.c)}" aria-hidden="true"></span>${esc(v.short)}${
    bits.length ? ' ' + bits.join('') : ''}${inside ? ` <span class="w">· ${inside} inside</span>` : ''}</div>`;
}
/* WHO TYPED IT, under the box. Andrew Fisher, 16 Sep 2026: name the person making the change. Every typed-over
   field carries its name and time in `by`/`stamps`; this prints them. */
function editByLine(t){
  if (!t) return '';
  return `<div class="edby">${esc(t.by || 'unnamed')}${t.at ? ' · ' + esc(fmtStamp(t.at)) : ''}</div>`;
}
/* the item TYPE box: a selection of every type the job knows for that trade, plus "add new…" which asks for
   the words — so a chosen type always matches a rate line and a plate's own item names */
function editItemSelect(a){
  const k = a.key, cur = (a.item_types || [])[0] || '';
  const opts = itemTypeOptions(a.discipline);
  if (cur && !opts.includes(cur)) opts.push(cur);
  return `<select id="ed-item-${esc(k)}" class="edbox edsel" data-ed="item" data-k="${esc(k)}" aria-label="Item type of ${esc(k)}${a._itemTyped ? ' — typed over the schedule' : ''}">
    <option value=""${cur ? '' : ' selected'}>— no item type —</option>
    ${opts.map(o => `<option value="${esc(o)}"${o === cur ? ' selected' : ''}>${esc(o)}</option>`).join('')}
    <option value="__new__">add new…</option></select>`;
}
function editRow(a){
  const k = a.key, ed = effectiveDates(a), rk = editRateKey(a);
  const typedDesc = a._nameTyped, typedLoc = a._locationMoved, typedItem = a._itemTyped, typedQty = a._qtyTyped;
  const r = rk ? rateFor(rk.disc, rk.item, k) : null;
  const typedRate = rk ? (S.rates || {})[rk.k] : null;
  const rateBy = rk ? {by: stampBy('rates', rk.k), at: (S.stamps || {})['rates/' + rk.k] || null} : null;
  const card = r && r.card ? r.card : null;
  const share = rk ? editRateShare(rk.k) : 0;
  const off = !!a._cancelled;
  const line0 = (a.charge_lines || [])[0] || null;
  const qtyNow = typedQty ? typedQty.to : (line0 ? line0.quantity : null);
  const qtySched = a._qtyOnTheSchedule;
  const qtyWhy = line0 && !typedQty && line0.quantity == null ? (line0.quantity_state || 'no quantity') : null;
  return `<tr data-k="${esc(k)}"${off ? ' class="edoff"' : ''}>
    <td><button class="linkish" data-k="${esc(k)}" title="Open ${esc(k)}"><b>${esc(k)}</b></button>
      <div class="edwas">${esc(a.discipline || '')}${off ? ' · <b>cancelled</b>' : ''}</div>
      ${off ? '' : editStateLine(a)}
      <button class="linkish edoffbtn" data-edoff="${esc(k)}" data-on="${off ? '1' : '0'}">${off ? 'Put back' : 'Set aside'}</button>
      ${a._movedTo && !a._movedTo.returned ? `<div class="edwas">moved to <b>${esc(a._movedTo.to)}</b> · ${esc(a._movedTo.by || 'unnamed')}</div><button class="linkish edoffbtn" data-moveback="${esc(a._movedTo.to)}" data-moveto="${esc(k)}">Put it back</button>`
        : a._movedTo ? `<div class="edwas">its copy went back to <b>${esc(a._movedTo.to)}</b></div>`
        : `<button class="linkish edoffbtn" data-edmove="${esc(k)}" title="Move what was recorded against ${esc(k)} to another reference">Move to…</button>`}
      ${(a._movedFrom || []).length ? `<div class="edwas">carries the record from <b>${esc(a._movedFrom.map(m => m.from).join(', '))}</b></div>` : ''}</td>
    <td>${editItemSelect(a)}
      ${typedItem ? editSchedLine('item type', typedItem.from) + editByLine(typedItem) : ''}</td>
    <td class="edqtyc"><input id="ed-qty-${esc(k)}" class="edbox edqty" type="number" min="1" max="${MAX_QTY}" step="1" inputmode="numeric"
        data-ed="qty" data-k="${esc(k)}" value="${esc(qtyNow == null ? '' : qtyNow)}" placeholder="—"
        aria-label="How many ${esc(k)} asks for${typedQty ? ' — typed over the schedule' : ''}">
      ${typedQty ? `<div class="edwas">the schedule says <b>${qtySched != null ? esc(qtySched) : 'nothing readable'}</b></div>` + editByLine(typedQty)
        : qtyWhy ? `<div class="edwas">${esc(qtyWhy)}</div>` : ''}</td>
    <td><input id="ed-desc-${esc(k)}" class="edbox" type="text" maxlength="160" data-ed="desc" data-k="${esc(k)}"
        value="${esc(a.name || '')}" placeholder="what it is"
        aria-label="What ${esc(k)} is${typedDesc ? ' — typed over the schedule' : ''}">
      ${typedDesc ? editSchedLine('description', typedDesc.from) + editByLine(typedDesc) : ''}</td>
    <td><input id="ed-in-${esc(k)}" class="edbox edday" type="date" data-ed="in" data-k="${esc(k)}"
        value="${esc(ed.in || '')}" aria-label="Day ${esc(k)} is due in">
      ${editDayLine(ed.in, ed.in_moved, ed.in_plan)}${ed.in_moved ? editByLine({by: ed.in_by, at: ed.in_at}) : ''}</td>
    <td><input id="ed-out-${esc(k)}" class="edbox edday" type="date" data-ed="out" data-k="${esc(k)}"
        value="${esc(ed.out || '')}" aria-label="Day ${esc(k)} is due out">
      ${editDayLine(ed.out, ed.out_moved, ed.out_plan)}${ed.out_moved ? editByLine({by: ed.out_by, at: ed.out_at}) : ''}</td>
    <td><input id="ed-loc-${esc(k)}" class="edbox" type="text" maxlength="120" data-ed="loc" data-k="${esc(k)}"
        value="${esc((a.locations || []).find(l => l && l !== k) || '')}" placeholder="where it goes"
        aria-label="Where ${esc(k)} goes${typedLoc ? ' — typed over the schedule' : ''}">
      <div class="edmapline">${typedLoc ? editSchedLine('place', typedLoc.from) + editByLine(typedLoc) : ''}
        <button class="linkish edmap" data-edmap="${esc(k)}" title="Show ${esc(k)} on the map">${
          (a.drawing_links || []).length ? esc((a.drawing_links[0] || {}).sheet || '') + ' · callout ' + esc((a.drawing_links[0] || {}).label || '')
          : 'no callout on a drawing — open the map'}</button></div>
      ${(() => { const cur = mapRefOf(k), ch = mapChoices(k); const curV = cur ? cur.kind + '|' + cur.id : '';
        const groups = [...new Set(ch.map(c => c.group))];
        return `<select id="ed-mapref-${esc(k)}" class="edbox edsel edmapref" data-ed="map" data-k="${esc(k)}" aria-label="Map attached to ${esc(k)}">
          <option value="">— no map attached —</option>${groups.map(g => `<optgroup label="${esc(g)}">${ch.filter(c => c.group === g).map(c => `<option value="${esc(c.kind + '|' + c.id)}"${c.kind + '|' + c.id === curV ? ' selected' : ''}>${esc(c.name)}</option>`).join('')}</optgroup>`).join('')}${
          cur && !ch.some(c => c.kind + '|' + c.id === curV) ? `<option value="${esc(curV)}" selected>${esc(cur.name)} (not in the library now)</option>` : ''}</select>${
        cur ? editByLine({by: cur.by, at: cur.at}) : ''}`; })()}</td>
    <td class="num">${rk ? `<input id="ed-rate-${esc(k)}" class="edbox edrate" type="number" min="0" step="0.01"
        data-ed="rate" data-k="${esc(k)}" data-rk="${esc(rk.k)}" value="${esc(typedRate == null ? '' : typedRate)}"
        placeholder="—" aria-label="Rate per week for ${esc(rk.item)}">
      <div class="edwas">${card && card.rate != null
          ? esc(money(card.rate)) + ' ' + esc(card.kind === 'daily' ? 'a day on the card' : card.kind === 'flat' ? 'flat on the card' : card.kind + ' on the card')
          : 'no rate on the card'}${share > 1 ? ' · <b>' + share + ' references</b> share this rate' : ''}</div>${
      typedRate != null && String(typedRate).trim() !== '' ? editByLine(rateBy) : ''}`
      : '<span class="norate">no item type — no rate to set</span>'}
      ${(() => { const hs = hireStartOf(k); const rent = rentalOf(k); const rs = rent && rent.from ? rent.from : null;
        return `<div class="edhire"><label class="edlbl" for="ed-hire-${esc(k)}">Hire starts</label>
          <input id="ed-hire-${esc(k)}" class="edbox edday" type="date" data-ed="hire" data-k="${esc(k)}" value="${esc(hs ? hs.iso : '')}" aria-label="Day the hire of ${esc(k)} is charged from">
          ${hs ? editDayLine(hs.iso, false, null) + editByLine(hs) : `<div class="edwas">${rs ? 'the rental system starts it <b>' + esc(fmtDate(rs)) + '</b>' : 'no hire start recorded — the schedule\'s span is charged'}</div>`}${
          hs && rs && rs !== hs.iso ? `<div class="edwas">the rental system says <b>${esc(fmtDate(rs))}</b></div>` : ''}</div>`; })()}</td>
  </tr>`;
}
function renderEdit(){
  const place = editKeepPlace();
  const rows = editRows(), all = allAssets();
  const discs = [...new Set(all.map(a => a.discipline).filter(Boolean))].sort();
  const touched = all.filter(editTouched);
  const ro = !canEdit();
  /* ON A PHONE THE FIRST SCREEN IS THE TABLE. The explanation and the four filters between them filled a
     390 px screen top to bottom, so a person standing at the gate scrolled past half a page of prose to reach
     row one. Both fold on a narrow screen and stay open on a laptop, where there is room for them. */
  const wide = TAB_WIDE.matches;
  $('#pane-edit').innerHTML = paneHeadingHtml('edit') + `
  <div class="notice ${ro ? 'warn' : 'info'}"><b>${ro ? 'This is a view-only link — nothing here can be typed.'
      : 'Type in a box and it is recorded — there is no Save button.'}</b>
    ${ro ? 'Open the editing link to change any of it.'
      : `<details class="edhow"${wide ? ' open' : ''}><summary>What that means</summary>
        Every box on this page is the same field the register, the drawer, the map, the load brief, the advice
        email and the printed sheets read, so a change is on all of them the moment you leave the box. Nothing
        here rubs out the schedule: what it asked for stays underneath in grey, and emptying a box puts it
        straight back.</details>`}</div>
  <div class="card">
    <div class="hubtitle"><h3>Edit</h3>
      <span class="chip ${touched.length ? 'act' : 'ref'}">${touched.length} typed over</span>
      <span class="chip ref">${rows.length} of ${all.length} shown</span></div>
    <details class="edfold"${wide ? ' open' : ''}><summary>Find, filter and order — ${esc(
      (EDIT_ONLY.find(([v]) => v === EDIT.only) || ['', 'everything'])[1])}${EDIT.disc ? ' · ' + esc(EDIT.disc) : ''}${
      EDIT.q ? ' · “' + esc(EDIT.q) + '”' : ''}</summary>
    <div class="edbar">
      <div class="f"><label for="edQ">Find</label>
        <input id="edQ" type="search" data-ro placeholder="reference, name, place, asset number" value="${esc(EDIT.q)}"></div>
      <div class="f"><label for="edDisc">Trade</label>
        <select id="edDisc" data-ro><option value="">every trade</option>${
          discs.map(d => `<option value="${esc(d)}"${EDIT.disc === d ? ' selected' : ''}>${esc(d)}</option>`).join('')}</select></div>
      <div class="f"><label for="edOnly">Show</label>
        <select id="edOnly" data-ro>${EDIT_ONLY.map(([v, w]) =>
          `<option value="${esc(v)}"${EDIT.only === v ? ' selected' : ''}>${esc(w)}</option>`).join('')}</select></div>
      <div class="f"><label for="edSort">In order of</label>
        <select id="edSort" data-ro><option value="date"${EDIT.sort === 'date' ? ' selected' : ''}>the day it is due in</option>
          <option value="ref"${EDIT.sort === 'ref' ? ' selected' : ''}>the reference</option>
          <option value="disc"${EDIT.sort === 'disc' ? ' selected' : ''}>the trade</option></select></div>
      <div class="f"><label>&nbsp;</label><button class="btn ghost" id="edAdd">Add a reference</button></div>
    </div></details>
    ${rows.length ? `<div class="tblwrap edwrap"><table class="progtbl edtbl">
      <thead><tr><th>Reference</th><th>Item type</th><th class="edqtyc">Qty</th><th>What it is</th><th>Due in</th><th>Due out</th><th>Where it goes</th>
        <th class="num">Rate <span class="w">per week</span></th></tr></thead>
      <tbody>${rows.map(editRow).join('')}</tbody></table></div>`
    : `<p class="norate">Nothing matches that. Clear the boxes above to see the whole job.</p>`}
    <p class="norate" style="margin-top:10px">A rate belongs to an item type on the card, not to one reference —
      the cell says how many share it. A rate typed here is per week and overrides the card, exactly as it does on
      Pricing; the card's own daily rate is printed under the box and is never changed by anything here.</p>
  </div>
  ${touched.length ? `<div class="card"><h3>What has been typed over (${touched.length})</h3>
    <div class="tblwrap"><table class="progtbl">
      <thead><tr><th>Reference</th><th>Field</th><th>The schedule</th><th>Now</th><th>Who, and when</th></tr></thead>
      <tbody>${touched.map(a => { const ed = effectiveDates(a), out = [];
        const line = (field, was, now, who, at) => `<tr>
          <td><button class="linkish" data-k="${esc(a.key)}"><b>${esc(a.key)}</b></button></td>
          <td>${esc(field)}</td>
          <td>${was ? esc(was) : '<span class="norate">nothing</span>'}</td>
          <td><b>${esc(now)}</b></td>
          <td>${esc(who || 'unnamed')}${at ? ' · ' + esc(fmtStamp(at)) : ''}</td></tr>`;
        if (a._itemTyped) out.push(line('item type', a._itemTyped.from, a._itemTyped.to, a._itemTyped.by, a._itemTyped.at));
        if (a._qtyTyped) out.push(line('quantity', a._qtyTyped.from == null ? '' : String(a._qtyTyped.from), String(a._qtyTyped.to), a._qtyTyped.by, a._qtyTyped.at));
        if (a._nameTyped) out.push(line('what it is', a._nameTyped.from, a._nameTyped.to, a._nameTyped.by, a._nameTyped.at));
        if (a._locationMoved) out.push(line('where it goes', a._locationMoved.from, a._locationMoved.to, a._locationMoved.by, a._locationMoved.at));
        /* v5.54 — a day corrected at the source (corrections.json) is listed here too, so one page shows every
           change from the workbook; it is named as a schedule correction because emptying the box does not undo it */
        if (ed.in_moved) out.push(line(ed.in_where === 'schedule correction' ? 'due in — schedule correction, at the source' : 'due in', ed.in_plan ? fmtDate(ed.in_plan) : '', fmtDate(ed.in), ed.in_by, ed.in_at));
        if (ed.out_moved) out.push(line('due out', ed.out_plan ? fmtDate(ed.out_plan) : '', fmtDate(ed.out), ed.out_by, ed.out_at));
        return out.join(''); }).join('')}</tbody></table></div>
    <p class="norate" style="margin-top:8px">Each of these is a change somebody typed. The schedule's own answer is
      in the column beside it and is still in the file — empty the box on the table above and it comes back. A line
      marked <i>schedule correction</i> was corrected out loud and applied at the build (sources/2026_Schedule/corrections.json):
      the workbook still says what it said, and the box cannot undo it.</p></div>` : ''}
  ${(() => { const aside = asideList(); if (!aside.length) return ''; return `<div class="card"><h3>Set aside (${aside.length})</h3>
    <p class="sub">Nothing is ever deleted. Each of these was removed by a named person and is kept here whole; Put back returns it, with the return written down too.</p>
    <div class="tblwrap"><table class="progtbl">
      <thead><tr><th>What</th><th>Reference</th><th>Detail</th><th>Set aside by, and when</th><th></th></tr></thead>
      <tbody>${aside.map(e => { const w = asideWords(e); return `<tr>
        <td>${esc(w.what)}<div class="edwas mono">${esc(e.id)}</div></td>
        <td>${w.ref ? `<button class="linkish" data-k="${esc(w.ref)}"><b>${esc(w.ref)}</b></button>` : '<span class="norate">—</span>'}</td>
        <td>${w.desc ? esc(w.desc) : '<span class="norate">—</span>'}</td>
        <td>${esc(e.by || 'unnamed')}${e.at ? ' · ' + esc(fmtStamp(e.at)) : ''}</td>
        <td>${ro ? '' : `<button class="btn ghost" data-putback="${esc(e.id)}">Put back</button>`}</td></tr>`; }).join('')}</tbody></table></div></div>`; })()}`;
  const pane = $('#pane-edit');
  pane.querySelectorAll('.linkish[data-k]').forEach(b => b.onclick = () => openAsset(b.dataset.k));
  pane.querySelectorAll('[data-edmap]').forEach(b => b.onclick = () => { state.sel = b.dataset.edmap; go('map'); });
  const add = $('#edAdd'); if (add) add.onclick = () => go('add');
  /* set aside a reference (cancel it, with a reason) or put it back — the same setRowOff every other page uses */
  pane.querySelectorAll('[data-edoff]').forEach(b => b.onclick = () => {
    const k = b.dataset.edoff, on = b.dataset.on === '1';
    if (on) { if (setRowOff(k, false, '')) render(); return; }
    const why = window.prompt('Set ' + k + ' aside — why? (It stays on the schedule and can be put back.)', '');
    if (why == null) return;
    if (setRowOff(k, true, String(why).trim())) render();
  });
  pane.querySelectorAll('[data-edmove]').forEach(b => b.onclick = () => moveDialog(b.dataset.edmove));
  pane.querySelectorAll('[data-moveback]').forEach(b => b.onclick = () => {
    if (!confirm('Put the record back on ' + b.dataset.moveto + ' from ' + b.dataset.moveback + '?')) return;
    if (moveRecord(b.dataset.moveback, b.dataset.moveto)) render(); });
  pane.querySelectorAll('[data-putback]').forEach(b => b.onclick = () => {
    if (!mayWrite('a set-aside record')) return;
    const who = whoAmI(); if (!who) return;
    const id = b.dataset.putback;
    if (putBack(id, who)) { bump(); flash(id + ' put back by ' + who + '.'); render(); }
  });
  const f = (id, set) => { const el = $('#' + id); if (el) el.onchange = () => { set(el.value); render(); }; };
  f('edDisc', v => EDIT.disc = v); f('edOnly', v => EDIT.only = v); f('edSort', v => EDIT.sort = v);
  const q = $('#edQ');
  /* the find box redraws as you type, so it keeps its own cursor across the redraw like every other box here */
  if (q) q.oninput = () => { EDIT.q = q.value; render(); };
  pane.querySelectorAll('[data-ed]').forEach(el => { el.onchange = () => {
    const k = el.dataset.k, v = el.value;
    if (el.dataset.ed === 'desc') { if (!setDesc(k, v)) render(); }
    else if (el.dataset.ed === 'item') {
      if (v === '__new__') {
        const words = window.prompt('The new item type, in the words the rate card would use (for example "Building 6m" or "50kva"):', '');
        if (words == null || !String(words).trim()) { render(); return; }
        if (!setItemType(k, words)) render();
      } else if (!setItemType(k, v)) render();
    }
    else if (el.dataset.ed === 'qty') { if (!setQty(k, v)) render(); }
    else if (el.dataset.ed === 'hire') { if (!setHireStart(k, v)) render(); }
    else if (el.dataset.ed === 'map') { const opt = el.options[el.selectedIndex]; const [kind, ...rest] = String(v).split('|');
      if (!v) { if (!setMapRef(k, '', '', '')) render(); }
      else if (!setMapRef(k, rest.join('|'), opt ? opt.textContent.replace(/ \(not in the library now\)$/, '') : rest.join('|'), kind)) render(); }
    else if (el.dataset.ed === 'loc') { if (!setLocationText(k, v)) render(); }
    else if (el.dataset.ed === 'in') { if (!setDate(k, v, 'in')) render(); }
    else if (el.dataset.ed === 'out') { if (!setDate(k, v, 'out')) render(); }
    else if (el.dataset.ed === 'rate') {
      if (!mayWrite('a rate')) { render(); return; }
      const rk = el.dataset.rk;
      S.rates = S.rates || {};
      if (String(v).trim() === '') delete S.rates[rk]; else S.rates[rk] = v;
      stampIt('rates', rk, whoAmI() || ''); bump();
      flash(String(v).trim() === '' ? rk.split('|')[1] + ' is back on the card’s rate.'
        : rk.split('|')[1] + ' set to ' + money(safeNum(v, MAX_RATE) || 0) + ' a week — every reference of that type.');
    }
  }; });
  editPutBack(place);
}
/* EVERY CALLOUT ON A DRAWING THAT NOTHING STANDS AT, for the Add page's reference picker. Andrew Fisher,
   16 Sep 2026: every single reference available to pick from a drop-down, or add a new one. A callout resolves to an asset exactly as the map resolves it — by
   the drawing's own tag, then by its label, then by what a person has recorded as standing there — and the
   ones left over are the places on iEDM's own sheets with nothing recorded at them. Picking one links the new
   reference to that place, so it shows on the map where the drawing puts it. Nothing here is a reference the
   schedule already carries. */
function emptyCallouts(){
  const out = [];
  const all = allAssets();
  (DATA.sheets || []).forEach(sh => {
    const byLabel = new Map(), byTag = new Map();
    all.forEach(a => (a.drawing_links || []).forEach(l => {
      if (l.sheet !== sh.sheet_id) return;
      if (l.tag_id) { if (!byTag.has(l.tag_id)) byTag.set(l.tag_id, []); byTag.get(l.tag_id).push(a.key); }
      else { if (!byLabel.has(l.label)) byLabel.set(l.label, []); byLabel.get(l.label).push(a.key); }
    }));
    (sh.markers || []).forEach(m => {
      if (m.marker_kind === 'note' || !m.label) return;
      const linked = (m.tag ? byTag.get(m.tag) : null) || byLabel.get(m.label) || null;
      const unit = (typeof unitAt === 'function') ? unitAt(sh.sheet_id, m.label) : null;
      if (linked || unit) return;
      out.push({sheet: sh.sheet_id, key: sh.key, label: String(m.label), tag: m.tag || null, title: sh.title || sh.sheet_id});
    });
  });
  return out.sort((x, y) => x.sheet.localeCompare(y.sheet) || x.label.localeCompare(y.label, undefined, {numeric: true}));
}
function renderAdd(){
  const pre = state.addPrefill || null; state.addPrefill = null;
  const v = k => esc(pre && pre[k] != null ? pre[k] : '');
  $('#pane-add').innerHTML = paneHeadingHtml('add') + `
  <div class="notice info"><b>Where this goes</b>
   An asset added here is saved in this browser and marked <span class="chip act">added</span> everywhere it
   appears, so it is never mistaken for something the schedule supplied. Export writes it to a JSON file you can
   send on or import somewhere else.</div>
  <div class="card"><h3>Add an asset</h3>
   <p class="sub">Use this for anything on site that the schedule does not carry — a building that turned up
   unlisted, a genset swapped in, a toilet moved to a new stand.</p>
   <div class="form">
    ${pre && pre.srcRow ? `<div class="notice info"><b>Giving schedule row ${esc(pre.srcRow)} a reference.</b> The row's own words are filled in below — check them, type the reference, and the row leaves the day's “no reference” list.</div>` : ''}
    ${pre && pre.callout ? `<div class="notice info"><b>Adding what stands at callout ${esc(pre.callout)} on ${esc(pre.sheet)}.</b> The place is filled in below; the new reference will show on the map there as soon as it is saved.</div>` : ''}
    <input type="hidden" id="aSheet" value="${esc(pre && pre.callout ? pre.sheet : '')}"><input type="hidden" id="aCallout" value="${esc(pre && pre.callout ? pre.callout : '')}">
    <div class="row2">
     <div class="f"><label>Reference *</label><input id="aKey" placeholder="P70, WC90, GN30…" value="${pre && pre.callout && !pre.srcRow ? '' : ''}">
       <div class="hint">The reference people will use on site. It must be unique. Or pick a place on a drawing that nothing stands at:</div>
       <select id="aPick" aria-label="A callout on a drawing with nothing recorded at it"><option value="">— a callout with nothing at it (${emptyCallouts().length}) —</option>${
         emptyCallouts().map(c => `<option value="${esc(c.sheet)}|${esc(c.label)}"${pre && pre.sheet === c.sheet && pre.callout === c.label ? ' selected' : ''}>${esc(c.sheet)} · callout ${esc(c.label)}</option>`).join('')}</select></div>
     <div class="f"><label>Discipline *</label><select id="aDisc"><option value="">— pick the trade —</option>${
       [...new Set(DATA.assets.map(a=>a.discipline))].sort().concat(['Other'])
        .map(d=>`<option${pre && pre.disc === d ? ' selected' : ''}>${esc(d)}</option>`).join('')}</select>
       <div class="hint">Nothing is picked for you — the first trade on the list used to be, and a building added in a hurry became Furniture.</div></div>
    </div>
    <div class="f"><label>Name</label><input id="aName" placeholder="What it is used for — Race Medical, Gate 5 Ticket Box…"></div>
    <div class="row2">
     <div class="f"><label>Type</label><select id="aTypeSel" aria-label="Item type"><option value="">— pick the item type —</option>${
         itemTypeOptions().map(t => `<option value="${esc(t)}"${pre && pre.type === t ? ' selected' : ''}>${esc(t)}</option>`).join('')}<option value="__new__"${pre && pre.type && !itemTypeOptions().includes(pre.type) ? ' selected' : ''}>add new…</option></select>
       <input id="aType" placeholder="the new type, in the rate card's words — Building 6m, 50kva…" value="${v('type')}" style="margin-top:6px${pre && pre.type && !itemTypeOptions().includes(pre.type) ? '' : ';display:none'}">
       <div class="hint">Every type the job and the rate card know is in the list, so a chosen type always lands on a rate line.</div></div>
     <div class="f"><label>Coates asset number</label><input id="aNo" placeholder="Leave blank if you do not have it" value="${v('no')}"></div>
    </div>
    <div class="row2">
     <div class="f"><label>Branch code</label><input id="aBranch" list="branchcodes-add" maxlength="${BRANCH_MAX}" placeholder="the branch it is on hire from" value="${v('branch')}">
       <datalist id="branchcodes-add">${branchOptions()}</datalist>
       <div class="hint">${pre && pre.branch ? 'from the rental extract for this row — check it before saving' : 'leave blank if nobody has told you'}</div></div>
    </div>
    <div class="row2">
     <div class="f"><label>On site from</label><input id="aFrom" type="date" value="${v('from')}"></div>
     <div class="f"><label>Off site by</label><input id="aTo" type="date"></div>
    </div>
    <div class="f"><label>Where it is</label><input id="aLoc" placeholder="Plain words — the crew has to find it" value="${v('loc')}"></div>
    <div class="f"><label>Schedule row it gives a reference to</label><input id="aSrcRow" placeholder="Blank unless this is one of the schedule's rows with no reference — T0002, T0003…" value="${v('srcRow')}">
      <div class="hint">${unreferencedRows().length ? `${unreferencedRows().length} schedule row${unreferencedRows().length === 1 ? '' : 's'} still carr${unreferencedRows().length === 1 ? 'ies' : 'y'} no reference — they are listed on their day on the Timeline tab, each with a “Give it a reference” button.` : 'Every schedule row now carries a reference.'}</div></div>
    <div class="f"><label>Note</label><textarea id="aNote" rows="2" placeholder="Why it was added, who authorised it, anything the next person needs.">${v('note')}</textarea></div>
    <div><button class="btn primary" id="aSave">Add asset</button></div>
   </div>
  </div>
  <div class="card"><h3>Who is entering this</h3>
   <p class="sub">Stamped on everything you add, so a record can be traced to a person.</p>
   <div class="form"><div class="f"><label>Your name</label>
     <input id="op" value="${esc(S.operator||'')}" placeholder="Name"></div></div>
  </div>
  ${(S.added||[]).filter(a => !assetDeleted(a.key)).length?`<div class="card"><h3>Added in this browser (${(S.added||[]).filter(a => !assetDeleted(a.key)).length})</h3>
   <div class="tblwrap"><table><thead><tr><th>Ref</th><th>Name</th><th>Type</th><th>Schedule row</th><th>Added</th><th></th></tr></thead>
   <tbody>${S.added.map((a,i)=>assetDeleted(a.key)?'':`<tr><td><b>${esc(a.key)}</b></td><td>${esc(a.name||'')}</td>
    <td>${esc((a.item_types||[]).join(', '))}</td><td class="mono">${a.source_row ? esc(a.source_row) : '<span class="todo">—</span>'}</td><td class="mono">${esc((a.added_at||'').slice(0,10))} ${esc(a.added_by||'')}</td>
    <td><button class="btn danger" data-del="${i}" title="Delete ${esc(a.key)} for good — no put-back">Delete</button></td></tr>`).join('')}</tbody></table></div></div>`:''}`;
  $('#op').onchange = e => { S.operator = e.target.value.trim(); const w = $('#who'); if (w) w.value = S.operator; save(); };
  /* the type list: a chosen line fills the type; "add new…" opens the box for the words */
  const tsel = $('#aTypeSel'), tbox = $('#aType');
  if (tsel && tbox) tsel.onchange = () => { if (tsel.value === '__new__') { tbox.style.display = ''; tbox.value = ''; tbox.focus(); }
    else { tbox.style.display = 'none'; tbox.value = tsel.value; } };
  /* the callout list: picking a place fills the sheet and callout the save reads, and offers the label as the
     reference when the box is empty — a person can still type any reference over it */
  const pick = $('#aPick');
  if (pick) pick.onchange = () => { const [sheet, label] = (pick.value || '|').split('|');
    $('#aSheet').value = sheet || ''; $('#aCallout').value = label || '';
    const asRef = label ? label.toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 8) : '';
    if (sheet && label && !$('#aKey').value.trim() && /^[A-Z]/.test(asRef)) $('#aKey').value = asRef;
    if (sheet && label) $('#aLoc').value = $('#aLoc').value || (sheet + ' · callout ' + label); };
  $('#aSave').onclick = () => {
    const key = $('#aKey').value.trim().toUpperCase();
    if (!key) return flash('A reference is needed — that is what people will call it on site.');
    if (!/^[A-Z][A-Z0-9]{0,7}(-[A-Z0-9]{1,4})?$/.test(key)) return flash('A reference is letters and digits — GN15, P48, LT07 — up to eight characters, with one dash at most.');
    if (!$('#aDisc').value) return flash('Pick the trade — nothing here is guessed for you.');
    if (allAssets().some(a => a.key === key)) return flash(key + ' already exists. Open it and add to it instead.');
    if (tombedHere(key)) return flash(key + ' was deleted in this record earlier — pick a different reference, or the deletion would take the new one.');
    { const dx = deletionOf(key); if (dx) return flash(key + ' was deleted for good' + (dx.by ? ' by ' + dx.by : '') + (dx.at ? ' on ' + fmtStamp(dx.at) : '') + ' — a deleted reference is never re-used. Pick a different one.'); }
    const who = whoAmI(); if (!who) return;
    const from = $('#aFrom').value || null, to = $('#aTo').value || null;
    const day = v => !v || (/^\d{4}-\d{2}-\d{2}$/.test(v) && !isNaN(new Date(v + 'T00:00:00')));
    if (!day(from) || !day(to)) return flash('A date has to be a real day.');
    if (from && to && to < from) return flash('The out day (' + fmtDate(to) + ') is before the in day (' + fmtDate(from) + ') — swap them.');
    const no = $('#aNo').value.trim(), t = $('#aType').value.trim();
    const srcRow = ($('#aSrcRow') && $('#aSrcRow').value.trim().toUpperCase()) || null;
    if (srcRow && !(DATA.unreferenced || []).some(r => r.task_id === srcRow)) return flash(srcRow + ' is not one of the schedule rows without a reference — leave the row blank unless this asset is one of them.');
    /* a place on a drawing, when the asset was added from an empty callout on the map */
    const sheetId = ($('#aSheet') && $('#aSheet').value) || null, callout = ($('#aCallout') && $('#aCallout').value) || null;
    const links = sheetId && callout && DATA.sheets.some(s => s.sheet_id === sheetId) ? [{sheet: sheetId, label: callout, source: 'recorded on site'}] : [];
    const added = {key, discipline:$('#aDisc').value, name:$('#aName').value.trim()||null,
      item_types:t?[t]:[], asset_numbers:no?[no]:[], accessories:[],
      first_date:from, last_date:to,
      locations:[$('#aLoc').value.trim()].filter(Boolean),
      asset_no_state:no?'entered here':'not supplied',
      source_row: srcRow,
      added_at:new Date().toISOString(), added_by:who};
    if (links.length) Object.assign(added, {drawing_links: links, linked_to_2026_sheet: true,
      position_state: 'entered by hand at a drawing callout — confirm the exact spot on the ground'});
    S.added.push(added);
    if ($('#aNote').value.trim()) S.notes[key] = $('#aNote').value.trim();
    /* the rental extract's branch code follows the row that carried it — offered on the form, recorded here in
       this person's name like any other branch, never written by the extract itself */
    const br = ($('#aBranch') && $('#aBranch').value.trim()) || '';
    if (br) { S.branch = S.branch || {}; S.branch[key] = normBranch(br); stampIt('branch', key); }
    save(); flash(key + ' added by ' + who + (srcRow ? ' — schedule row ' + srcRow + ' now has a reference.' : '.') + (br ? ' Branch ' + normBranch(br) + ' recorded.' : '')); render(); openAsset(key);
  };
  /* Andrew Fisher, 23 Sep 2026: removing an asset deletes it for good. The set-aside with a way
     back (16 Sep) stays for the other lists; an asset a person removes is deleted, here as in the drawer. */
  $('#pane-add').querySelectorAll('[data-del]').forEach(b => b.onclick = () => {
    const gone = S.added[+b.dataset.del]; if (!gone || !gone.key) return;
    deleteDialog(gone.key); });
}

/* ------------------------------------------------------------------ pricing */
/* Every number that reaches the arithmetic comes from a person typing or a file being imported, so every one of
   them goes through here first. A value that is not a finite, positive, sensible number becomes null, and null
   renders as unknown — never as zero, never as NaN, never as Infinity. Before this gate existed, a hand-typed
   "eight" in an imported records file put $7,068 into the running total that no row on the page showed, a typed
   -5 produced a negative subtotal and a quietly cheaper quote, and 1e999 rendered the total as "$∞". */
const MAX_WEEKS = 520, MAX_RATE = 1e7;
function safeNum(v, max){
  /* Andrew Fisher's audit, 12 Sep 2026: Number([5]) is 5 and Number('   ') is 0, so an array or a run of spaces
     could arrive from a file as a typed rate. A number is a number, or text that is nothing but a number. */
  if (v == null || typeof v === 'boolean') return null;
  if (typeof v !== 'number' && typeof v !== 'string') return null;
  if (typeof v === 'string' && v.trim() === '') return null;
  const n = Number(v);
  if (!Number.isFinite(n) || n < 0 || n > max) return null;
  return n;
}
function safeWeeks(v){ return safeNum(v, MAX_WEEKS); }
/* A QUANTITY IS A WHOLE NUMBER OF THINGS, one or more. Anything else typed or imported — 0, 1.5, "ten", -3, an
   empty box — is not a quantity and reads as null, which every surface shows as unknown and never as a count.
   Zero is refused on purpose: a reference that asks for nothing is set aside, not counted as nought. */
const MAX_QTY = 9999;
function safeInt(v, max){
  const n = safeNum(v, max);
  if (n == null || n < 1 || Math.floor(n) !== n) return null;
  return n;
}
/* ------------------------------------------------------------------ the 2026 rate card (street since 25 Sep 2026, circuit before)
   Andrew Fisher, 11 Sep 2026: run with the circuit card for everything (the working position then), and mark what is
   transport and what is charge. The card is matched by hand to every item type on the job (pipeline/rate_match.py) and the
   page prices from it unless somebody types a rate over the top — a typed rate is a decision and wins, but the
   card figure stays visible beside it so the difference is never hidden. Three things the card settles:
     · the rate follows what was ASKED FOR, never what was sent (a 30 kVA asked for and a 40 kVA sent is
       charged as the 30 kVA);
     · a line prices by its own heading — a DAILY rate × days on site, a FLAT rate once, PER METRE for fencing;
     · transport is a separate pair, cost to Coates and charge to the customer, and neither is folded into hire. */
const RM = DATA.rate_match || null;
/* v5.82 — the card this event prices from, in a word, read from the choice on the record (pipeline/rate_card_2026.py):
   the street card since 25 Sep 2026 (Andrew Fisher: the contracts bill 70 days of the daily rate, not 42), the circuit
   card before it. Every sentence that names the card reads this, so the words cannot say one card while the money is another. */
const CARD_WORD = RM && /^street/.test(RM.card || '') ? 'street' : RM && /^circuit/.test(RM.card || '') ? 'circuit' : 'rate';
const CARD_DAYS = RM && /70 days/.test(RM.card_is || '') ? 70 : RM && /42 days/.test(RM.card_is || '') ? 42 : null;
const RM_ITEMS = new Map(((RM && RM.items) || []).map(e => [e.discipline + '|' + e.item, e]));
const RM_ACC = new Map(((RM && RM.accessories) || []).map(e => [e.item, e]));
const RM_BY_ASSET = new Map(((RM && RM.by_asset) || []).map(e => [e.key, e]));
/* the card's own figure for an item type — or, for an ambiguous type, the line the asset's own name settles */
function cardRate(disc, item, key){
  let e = RM_ITEMS.get(disc + '|' + item) || null;
  if (e && e.state === 'ambiguous' && key && RM_BY_ASSET.has(key) && RM_BY_ASSET.get(key).rate_line) {
    const ba = RM_BY_ASSET.get(key), cand = (e.candidates || []).find(c => c.rate_line === ba.rate_line);
    if (cand) { const cur = cand.rates.of_this_year || {}; const h = Object.keys(cur).find(k => k.startsWith('Daily Rate'));
      return {kind: 'daily', rate: h ? cur[h] : null, line: ba.rate_line, state: 'settled by the asset\'s own name', why: ba.why, transport: null, source: 'card',
              minimum_hire: cand.minimum_hire || null, labour_per_piece: cand.labour_per_piece || null}; }
  }
  if (!e) return {kind: null, rate: null, line: null, state: 'not on the card matching', why: null, transport: null, source: null};
  return {kind: e.rate_kind || null, rate: e.priceable ? e.rate : null, line: e.rate_line, state: e.state, why: e.why || e.not_priceable_because,
          transport: e.transport || null, source: 'card', basis: e.rate_basis, hire_rate: e.hire_rate, candidates: e.candidates || null,
          /* the fewest days this line is charged for, and the labour that can be ticked on a piece of it — both
             read off the card by pipeline/rate_match.py, neither held here */
          minimum_hire: e.minimum_hire || null, labour_per_piece: e.labour_per_piece || null};
}
function cardAccRate(type){
  const e = RM_ACC.get(type); if (!e) return {kind: null, rate: null, line: null, state: 'not on the card matching', why: null};
  return {kind: e.rate_kind || null, rate: e.priceable ? e.rate : null, line: e.rate_line, state: e.state, why: e.why || e.not_priceable_because, transport: e.transport || null, basis: e.rate_basis};
}
/* The rate the arithmetic uses. A typed rate is per week and wins. Otherwise the card: a daily line is priced per
   day, a flat line once. Returns {value, per, source} so the caller knows what it is multiplying by. */
function rateFor(disc, item, key){
  const typed = safeNum(S.rates[disc + '|' + item], MAX_RATE);
  if (typed != null) return {value: typed, per: 'week', source: 'typed', card: cardRate(disc, item, key)};
  const c = cardRate(disc, item, key);
  if (c.rate != null && c.kind === 'daily') return {value: c.rate, per: 'day', source: 'card', card: c};
  if (c.rate != null && c.kind === 'flat') return {value: c.rate, per: 'flat', source: 'card', card: c};
  if (c.rate != null && c.kind === 'per metre') return {value: c.rate, per: 'metre', source: 'card', card: c};
  return {value: null, per: null, source: null, card: c};
}
/* v5.59 — WHAT THE CARD HAS NO LINE FOR BECAUSE IT IS PART OF THE BUILDING. The 2026 card prices a portable
   building and, under Furniture, a fridge, an urn, a sink, a microwave, a boiler, tables and chairs. It has no
   line for an air conditioner anywhere, on either card: an air conditioner is fitted to the building and travels
   in its hire. When Andrew Fisher's recorded air conditioners were folded into the contents (v5.59) they would
   have read as "no rate on the card" and blocked every building's accessory money as unknown — the fridge's
   money vanishing because of a thing that was never a separate charge. So a type in this list is carried as PART
   OF THE BUILDING: shown, with its number, charged nothing here, said in words, and not blocking. A typed rate
   still wins, so if one IS chargeable it can be priced by name. */
const PART_OF_THE_BUILDING = {'Air conditioner': 'fitted to the building — no separate line on the 2026 card; travels in the building\u2019s hire',
                              'Heater': 'fitted to the building — no separate line on the 2026 card'};
function accRateFor(type){
  const typed = safeNum(S.accRates[type], MAX_RATE);
  if (typed != null) return {value: typed, per: 'week', source: 'typed', card: cardAccRate(type)};
  if (PART_OF_THE_BUILDING[type]) return {value: 0, per: 'flat', source: 'part of the building', card: {kind: 'flat', rate: 0, line: null, state: 'part of the building', why: PART_OF_THE_BUILDING[type]}, part_of_building: true};
  const c = cardAccRate(type);
  if (c.rate != null && c.kind === 'flat') return {value: c.rate, per: 'flat', source: 'card', card: c};
  if (c.rate != null && c.kind === 'daily') return {value: c.rate, per: 'day', source: 'card', card: c};
  return {value: null, per: null, source: null, card: c};
}
/* ------------------------------------------------------------------ does the quantity's unit match the rate's?
   Superior Audit, 15 Sep 2026, F06. The Trakmat line was matched to the card's "Track Mat (per metre)", given
   the schedule's quantity of 20, and priced at $5,674.24 — into the hire subtotal, no qualification. Lower on
   the same page the record asked, in its own words, whether that 20 means twenty mats or twenty metres. The
   page was therefore charging a number it had already told the reader it could not read.

   A match to a rate LINE is not a match of DIMENSIONS. The line's name declares the unit it prices in; the
   schedule's cell either carries a unit or it does not. Where the two cannot be reconciled the line is UNIT
   UNRESOLVED: its money is worked out and shown, labelled as a scenario, and kept out of the resolved subtotal
   until somebody says which unit the cell meant. Nothing is converted — twenty mats never silently becomes
   twenty metres — and the schedule's raw 20 is kept exactly as written. */
const UNIT_WORDS = {metre: 'metre', meter: 'metre', m: 'metre', lm: 'metre', panel: 'panel', panels: 'panel',
                    gate: 'gate', gates: 'gate', each: 'each', ea: 'each', unit: 'each', units: 'each',
                    item: 'each', items: 'each', mat: 'each', mats: 'each'};
function unitWord(s){
  const k = String(s == null ? '' : s).trim().toLowerCase().replace(/[.\s]+$/, '');
  return UNIT_WORDS[k] || null;
}
/* the unit a rate line prices in, read off the line's own name — "Track Mat (per metre)" prices metres */
function rateLineUnit(line){
  const m = String(line || '').match(/\(\s*per\s+([A-Za-z]+)\s*\)|\bper\s+([A-Za-z]+)\b/i);
  return m ? unitWord(m[1] || m[2]) : null;
}
function unitCheck(l, r){
  const line = (r && r.card && r.card.line) || '';
  const declared = rateLineUnit(line);
  const given = unitWord(l && (l.unit || l.quantity_unit));
  if (!declared) return {resolved: true, declared: null, given: given, why: ''};
  if (declared === 'each') return {resolved: true, declared: declared, given: given, why: ''};
  if (given && given === declared) return {resolved: true, declared: declared, given: given, why: ''};
  if (given && given !== declared) return {resolved: false, declared: declared, given: given,
    why: 'the card line “' + line + '” prices by the ' + declared + '; the schedule writes this quantity in ' + given + 's'};
  return {resolved: false, declared: declared, given: null,
    why: 'the card line “' + line + '” prices by the ' + declared + '; the schedule writes '
         + (l && l.quantity != null ? l.quantity : 'a quantity') + ' with no unit, so ' + declared
         + 's and items cannot be told apart'};
}
/* ============================================================ WHEN A THING IS CHARGED FOR, AND FOR HOW FEW DAYS
   Andrew Fisher, 17 Sep 2026: labour is charged per piece of equipment, and the only hourly labour charged is over the
   event; forklifts, VMS and water barriers are charged from when they go in, everything else only over the event;
   the event dates are 23, 24 and 25 October; and the buildings probably carry minimum hire days.

   Until this, the page charged the whole time a thing was on site: its first scheduled day to its off-hire, or
   to the end of the programme where nothing took it off. That is how long the thing is THERE, and on an event it
   is not what the customer pays for — a building goes in weeks before the first race day and comes out the week
   after. The two numbers were being used as though they were one.

   So the charged window is now one of two, and which one a thing takes is read off its discipline
   (sources/pricing/charge_basis.json, his rule, his name, that day):
     · from the day it goes in until the day it comes off — forklifts, VMS, water barriers;
     · the three race days — everything else.
   Both ends are billed: 23, 24 and 25 October is three days, not two.

   And the days charged are never fewer than the minimum hire the card itself writes for that line — on the street
   card this event prices from since 25 Sep 2026, 70 days for the buildings and the toilet blocks (their own hire
   rate divided by their own daily rate), 21 for the FWF single and the accessible toilet (42 and 14 on the circuit
   card before it), 7 for everything in the traffic management block, which says "min 7 days Hire" on its heading.
   That minimum is arithmetic on the card, not a figure anybody typed here.

   Nothing is deleted. The old span — how long the thing is on site — is still worked out, still shown, and now
   sits beside the charged window so the difference can be read rather than guessed at. */
const CB = DATA.charge_basis || null;
const EVENT_DAYS = (CB && CB.event_days) || [];
const FROM_DELIVERY_DISC = (CB && CB.bases && CB.bases.from_delivery && CB.bases.from_delivery.applies_to_disciplines) || [];
function eventWindow(){
  if (!EVENT_DAYS.length) return null;
  return {from: EVENT_DAYS[0], to: EVENT_DAYS[EVENT_DAYS.length - 1], days: EVENT_DAYS.length};
}
/* both ends billed */
function daysInclusive(from, to){
  if (!from || !to) return null;
  const d = (new Date(from + 'T00:00:00')).getTime(), e = (new Date(to + 'T00:00:00')).getTime();
  if (!Number.isFinite(d) || !Number.isFinite(e) || e < d) return null;
  return Math.round((e - d) / 86400000) + 1;
}
function chargeBasisOf(disc){
  if (!CB) return {key: null, is: null, why: 'no charge basis has been supplied with this build'};
  if (FROM_DELIVERY_DISC.indexOf(disc) >= 0)
    return {key: 'from_delivery', is: CB.bases.from_delivery.is, why: CB.bases.from_delivery.why};
  return {key: 'event_only', is: CB.bases.event_only.is, why: CB.bases.event_only.why};
}
/* The days this reference is charged for, before any minimum. Every answer says where it came from, and an
   answer nobody can work out is null with the reason beside it — never nought. */
function chargeSpanOf(a){
  const basis = chargeBasisOf(a.discipline);
  /* weeks typed by hand are a deliberate instruction and still win, as they always have */
  const stored = movedAway(a.key) ? null : S.weeks[a.key];
  if (stored != null && stored !== '') {
    const w = safeWeeks(stored);
    if (w != null) return {basis: basis, days: w * 7, from: null, to: null, typed: true,
                           why: 'the weeks entered by hand on this reference', firm: true};
    return {basis: basis, days: null, from: null, to: null, typed: true, firm: false,
            why: 'the weeks entered by hand ("' + String(stored).slice(0, 20) + '") is not a number between 0 and '
                 + MAX_WEEKS + ' — nothing on this reference can be priced until it is'};
  }
  if (!basis.key) {
    const w = assetWeeks(a);
    return {basis: basis, days: w.w == null ? null : w.w * 7, from: null, to: null, firm: !!w.firm,
            why: w.basis};
  }
  if (basis.key === 'event_only') {
    const ev = eventWindow();
    if (!ev) return {basis: basis, days: null, from: null, to: null, firm: false,
                     why: 'the charge basis carries no event days'};
    return {basis: basis, days: ev.days, from: ev.from, to: ev.to, firm: true,
            why: 'the ' + ev.days + ' race days, ' + fmtDate(ev.from) + ' to ' + fmtDate(ev.to)};
  }
  /* from the day it goes in until the day it comes off. A typed hire start moves the day it goes in; nothing
     moves the day it comes off except the record itself, and where the record does not take it off, nothing is
     charged and the page says so. No end date is ever assumed here. */
  const hs = hireStartOf(a.key);
  const goIn = hs ? hs.iso : a.first_date;
  const h = a.hire || {};
  /* an asset added in this page carries the on-site and off-site days the person typed; its off-site day is
     the day it comes off — a typed date, not an assumption */
  const off = h.offhire_date || (a._added ? (a.last_date || null) : null) || null;
  if (!goIn) return {basis: basis, days: null, from: null, to: null, firm: false,
                     why: 'nothing on the record says what day this goes in'};
  if (!off) return {basis: basis, days: null, from: goIn, to: null, firm: false, noEnd: true,
                    why: 'nothing on the record takes this off site, so there is no day to charge to — '
                         + (h.offhire === 'none' ? 'no schedule row removes it and the rental system carries no off-hire' : String(h.offhire || 'no off-hire'))};
  const d = daysInclusive(goIn, off);
  if (d == null) return {basis: basis, days: null, from: goIn, to: off, firm: false,
                         why: 'the day it comes off (' + fmtDate(off) + ') is before the day it goes in (' + fmtDate(goIn) + ')'};
  return {basis: basis, days: d, from: goIn, to: off, firm: true,
          why: 'from ' + fmtDate(goIn) + (hs ? ' (the hire start typed by ' + (hs.by || 'unnamed') + ')' : '')
               + ' to ' + fmtDate(off) + ' — ' + d + ' day' + (d === 1 ? '' : 's') + ', both ends charged'};
}
/* The fewest days this rate line is charged for, off the card. Null where the card does not say. */
const MAX_MIN_DAYS = 365;
function minHireFor(disc, item, key){
  const k = disc + '|' + item, typed = (S.minDays || {})[k];
  if (typed != null && String(typed).trim() !== '') {
    const n = Number(typed);
    if (Number.isFinite(n) && n >= 0 && n <= MAX_MIN_DAYS)
      return {days: n, from: 'typed over the card by ' + (stampBy('minDays', k) || 'unnamed'), typed: true,
              basis: n === 0 ? 'no minimum — typed as nought' : n + ' days, typed over the card\'s own minimum'};
    /* a typed value that is not a number of days is not a minimum, and it does not quietly fall back to the card's */
    return {days: null, from: 'typed, but not a number of days between 0 and ' + MAX_MIN_DAYS, typed: true, invalid: true, basis: String(typed)};
  }
  const c = cardRate(disc, item, key);
  const m = c && c.minimum_hire;
  return (m && typeof m.days === 'number') ? m : null;
}
function setMinDays(disc, item, v){
  if (!mayWrite('a minimum hire')) return false;
  const who = whoAmI(); if (!who) return false;
  const k = disc + '|' + item;
  S.minDays = S.minDays || {};
  if (String(v == null ? '' : v).trim() === '') delete S.minDays[k]; else S.minDays[k] = String(v).trim();
  stampIt('minDays', k, who); save(); bump();
  return true;
}
/* The days finally charged on one line: the window, never fewer than the card's minimum. */
function chargedDays(span, min){
  if (min && min.invalid) return {days: null, floored: false, min: null, invalid: true};
  if (!span || span.days == null) return {days: null, floored: false, min: min ? min.days : null};
  if (!min || !(min.days > 0) || span.days >= min.days)
    return {days: span.days, floored: false, min: min ? min.days : null};
  return {days: min.days, floored: true, min: min.days, window: span.days};
}
/* one line's money: the days charged, with the card's minimum hire underneath; a flat or per-metre rate ignores
   the span, as it always has — furniture is priced once for the event and fencing once per metre */
function lineMoney(r, qty, days){
  if (r.value == null || qty == null) return null;
  if (r.per === 'flat') return r.value * qty;
  if (r.per === 'metre') return r.value * qty;
  if (days == null) return null;
  if (r.per === 'week') return r.value * qty * (days / 7);
  if (r.per === 'day') return r.value * qty * days;
  return null;
}
const PROG_END = DATA.weeks.length ? DATA.weeks[DATA.weeks.length - 1].end : null;

/* How long is this asset on hire?
   Three answers, in order of how much the source actually tells us. The basis travels with the number so a total
   is never read as more certain than the dates behind it. */
/* Seven assets link only to a sheet this file does not carry — six to 2025 sheets and one to D016. Their
   "Show on the map" button used to do nothing at all, with no message. */
/* Where this asset's callout sits on the aerial photograph, as a fraction of it.
   Prefers a 2026 sheet: the circuit is re-set every year, so a 2025 callout is a weaker guide to where something
   is this year, and the panel says so when that is all there is. */
/* Somebody has typed a destination over the schedule's, and nobody has confirmed where the new one is on the
   ground. From an outside audit of 14 Sep 2026, its first priority: "New destination text can keep the old
   map/QR/navigation point … text-only move invalidates old navigation until checked."

   It was right, and it was reproducible: typing "Moved to the north compound" changed the words on every page
   while the coordinate, the Navigate button, the QR and both aerial pictures went on pointing at the old
   callout. A driver was told the thing had moved and handed directions to where it used to be.

   So a move takes the old point OFF until a new one is confirmed. The drawing is kept and shown as what it is —
   the previous plan — and the page says the pin needs checking. This is the CP1 rule in a second coat: a
   position nobody has confirmed is never presented as one that has been. Putting the schedule's own wording
   back (the Clear button beside the location box) restores the point with it, because then the plan is the
   destination again. */
function movedFor(a){
  const m = a && a._locationMoved;
  if (!m || !m.to) return null;
  return {to: m.to, from: m.from || null, at: m.at || null};
}
function movedWords(mv){
  if (!mv) return '';
  return 'The drop was moved to "' + mv.to + '"' + (mv.at ? ' on ' + fmtDate(String(mv.at).slice(0, 10)) : '')
       + ', and nobody has confirmed where that is on the ground yet — so the old point is not offered as the destination.';
}
function aerialPointFor(a){
  if (movedFor(a)) return null;
  const links = a.drawing_links || [];
  const order = links.filter(l => (l.year || 2026) === 2026).concat(links.filter(l => (l.year || 2026) !== 2026));
  for (const l of order) {
    const sh = DATA.sheets.find(s => s.sheet_id === l.sheet);
    if (!sh) continue;
    const m = (sh.markers || []).find(x => x.ax != null && (l.tag_id && x.tag ? x.tag === l.tag_id : x.label === l.label));
    if (m) {
      /* The bubble is where the number is printed; tx/ty is where its arrow lands. Use the arrow when there is
         one — on D022 and D023 it is 20 to 100 points away, which is a whole compound on this sheet. */
      const useArrow = m.tx != null;
      return {ax: useArrow ? m.tx : m.ax, ay: useArrow ? m.ty : m.ay,
              bubbleAx: m.ax, bubbleAy: m.ay, fromArrow: useArrow,
              arrowPt: m.t_from_label_pt, bends: m.t_bends,
              sheet: sh, label: l.label, year: l.year || 2026, method: l.method, marker: m};
    }
  }
  return null;
}
/* The callout is on the sheet, and the sheet cannot say where it is on the ground. iEDM draw some references
   off the main plan — a legend key, an off-site reference note, a detail inset drawn at its own scale in a
   corner of the page. The sheet is registered to the photograph by its main plan and by nothing else, so a
   callout drawn outside it has no position on that photograph. This is what says so, by name, instead of the
   page quietly showing a point in the water. CP1 on D022 is the one that started this: it is drawn in the
   Cypress Avenue carpark inset. */
function offPlanFor(a){
  for (const l of (a.drawing_links || [])) {
    const sh = DATA.sheets.find(s => s.sheet_id === l.sheet);
    if (!sh) continue;
    const m = (sh.markers || []).find(x => x.off_plan && (l.tag_id && x.tag ? x.tag === l.tag_id : x.label === l.label));
    if (m) return {region: m.off_plan, sheet: sh, label: l.label, marker: m};
  }
  return null;
}
/* The same fact in one sentence, for a printed page. "an inset" rather than the region's own name where the
   name would mean nothing to a driver. */
function offPlanWords(op){
  if (!op) return '';
  const r = String(op.region || '');
  const what = /inset/i.test(r) ? 'in the ' + r.replace(/\s*inset$/i, '') + ' inset — a separate small plan in the corner of the sheet'
             : /legend/i.test(r) ? 'in the legend'
             : /off-?site/i.test(r) ? 'in an off-site reference note'
             : 'outside the main plan';
  return 'Callout ' + op.label + ' is drawn ' + what + ', not on the main plan, '
       + 'so this sheet does not say where it is on the ground.';
}
/* ------------------------------------------------------------------ what a location looks like
   A window onto the aerial photograph, centred on the asset's callout. The photograph is whichever aerial the
   build embedded (DATA.aerial_note says which: the registered Queensland 2022 imagery, or the one inside the
   supplied 26003 drawings) — no tile service, nothing fetched. Every sheet is drawn over the same frame at the
   same origin and scale, so a callout on a sheet is a point on the photograph.

   What this is NOT, and the panel says so: a surveyed position. The marker sits where the callout text reads
   clearly on the drawing, which is near the thing and is not the thing. */
const SAT_ZOOM = [
  {k:'wide',   f:0.30, label:'Wide'},
  {k:'medium', f:0.12, label:'Closer'},
  {k:'close',  f:0.05, label:'Closest'},
];
function satZoom(){ return SAT_ZOOM.find(z => z.k === (state.satZoom || 'medium')) || SAT_ZOOM[1]; }
/* the live map is a per-device choice, remembered like the zoom: a phone that wants the live map keeps it */
function satLiveOn(){ if (state.satLive == null) { try { state.satLive = localStorage.getItem('gc500.satlive') === '1'; } catch (e) { state.satLive = false; } } return !!state.satLive; }
function satLiveSet(on){ state.satLive = !!on; try { localStorage.setItem('gc500.satlive', on ? '1' : '0'); } catch (e) {} }

const COMPASS = ['north','north-east','east','south-east','south','south-west','west','north-west'];
function compassOf(bearing){ return COMPASS[Math.round(((bearing % 360) + 360) % 360 / 45) % 8]; }

/* A bearing from one point on the photograph to another. With the registered Queensland imagery the frame is
   georeferenced, so the bearing is measured and the straight-line distance is stated in metres. Without it
   (the drawing's own photograph) the bearing is only as good as the derived orientation and no distance is
   ever stated, because the picture carries no scale. */
function bearingBetween(ax, ay, bx, by){
  const o = DATA.orientation;
  if (!o) return null;
  const px = DATA.aerial_hi_px || [4760, 2994];
  /* the pixels are square, so scale the fractions back to pixels before taking an angle */
  const dx = (bx - ax) * px[0], dy = (by - ay) * px[1];
  if (!dx && !dy) return null;
  const onSheet = (Math.atan2(dx, -dy) * 180 / Math.PI + 360) % 360;
  const bearing = (o.sheet_top_bearing_deg + onSheet) % 360;
  const g = DATA.georef;
  const metres = g ? Math.hypot(dx, dy) * g.m_per_frame_px_ground * (g.frame_px[0] / px[0]) : null;
  return {bearing, compass: compassOf(bearing), onSheet, metres};
}

/* Where a point on the photograph is on the ground — WGS84 latitude and longitude — through the registration.
   Fractions of the frame → frame pixels → Web Mercator metres (the fitted affine) → degrees. Null without a
   georeference. The precision shown is honest: five decimals is about a metre, which is what the fit is. */
function lonLatOf(ax, ay){
  const g = DATA.georef;
  if (!g || !g.basemap_px_to_epsg3857) return null;
  const A = g.basemap_px_to_epsg3857, u = ax * g.frame_px[0], v = ay * g.frame_px[1];
  const x = A[0][0] * u + A[0][1] * v + A[0][2], y = A[1][0] * u + A[1][1] * v + A[1][2];
  const R = 6378137;
  const lon = x / R * 180 / Math.PI;
  const lat = (2 * Math.atan(Math.exp(y / R)) - Math.PI / 2) * 180 / Math.PI;
  return {lat, lon, text: lat.toFixed(6) + ', ' + lon.toFixed(6)};
}
/* v5.49 — A RECORDED PIN ON THE DRAWING. A callout carries both readings: ax/ay is where it sits on the
   registered frame and fx/fy is where it sits on this sheet's own picture. The two are a straight linear
   relation per sheet, so the sheet's own callouts calibrate it — no new transform is invented, and a sheet
   with fewer than three usable callouts gets no pin rather than a guessed one. */
const _sheetFitCache = {};
function sheetFitOf(sh){
  const id = sh && sh.sheet_id; if (!id) return null;
  if (_sheetFitCache[id] !== undefined) return _sheetFitCache[id];
  const ms = (sh.markers || []).filter(m => m.ax != null && m.fx != null && m.ay != null && m.fy != null);
  let fit = null;
  if (ms.length >= 3) {
    const fitOne = (u, w) => { const n = u.length, su = u.reduce((a, b) => a + b, 0), sw = w.reduce((a, b) => a + b, 0);
      const suu = u.reduce((a, b) => a + b * b, 0), suw = u.reduce((a, b, i) => a + b * w[i], 0);
      const den = n * suu - su * su; if (Math.abs(den) < 1e-12) return null;
      return {k: (n * suw - su * sw) / den, c: (sw * suu - su * suw) / den}; };
    const fx = fitOne(ms.map(m => m.ax), ms.map(m => m.fx)), fy = fitOne(ms.map(m => m.ay), ms.map(m => m.fy));
    if (fx && fy && Math.abs(fx.k) > 1e-9 && Math.abs(fy.k) > 1e-9) {
      /* prove it on the callouts it was fitted to: a fit that cannot put them back is not used */
      const err = Math.max.apply(null, ms.map(m => Math.max(Math.abs(fx.k * m.ax + fx.c - m.fx), Math.abs(fy.k * m.ay + fy.c - m.fy))));
      if (err < 0.02) fit = {fx: fx, fy: fy, err: err, on: ms.length};
    }
  }
  _sheetFitCache[id] = fit;
  return fit;
}
function sheetPointOf(sh, ax, ay){
  const f = sheetFitOf(sh); if (!f) return null;
  const x = f.fx.k * ax + f.fx.c, y = f.fy.k * ay + f.fy.c;
  return (x < -0.05 || x > 1.05 || y < -0.05 || y > 1.05) ? null : {fx: x, fy: y};
}
function fmtMetres(m){ return m == null ? '' : m < 1000 ? Math.round(m / 5) * 5 + ' m' : (m / 1000).toFixed(1) + ' km'; }
/* ---- WHERE IT ACTUALLY WENT. Andrew Fisher, 18 Sep 2026: a button that pinpoints where you are standing on the
   maps, so when a building is placed and its details filled in, one press records exactly where it is.

   Standing at the thing, press the button, and the phone's own satellite fix is written down against that
   reference: latitude, longitude, the accuracy the phone reports, the time, and who pressed it. It is a
   RECORDED position and it sits BESIDE the drawn one — the drawing is never overwritten, because the drawing
   is what was planned and this is what happened, and where the two differ that difference is worth having.

   On the honest bit: a phone fix is not 100% accurate and this page will not pretend it is. Whatever the
   device reports as its accuracy is shown with the fix, every time, so a rubbish fix can be seen for what it
   is and taken again. Nothing is smoothed, averaged or rounded into looking better than it was.

   Nothing leaves the page. The browser asks the person for permission, the fix comes from the device, and it
   is written to the same record everything else is written to. No map provider is contacted. Geolocation needs
   a secure page: on the hosted link it works, and a file opened off the phone's storage may refuse it, which
   is said plainly rather than failing silently. */
function frameOf(lat, lon){
  const g = DATA.georef;
  if (!g || !g.basemap_px_to_epsg3857) return null;
  const R = 6378137, A = g.basemap_px_to_epsg3857;
  const x = lon * Math.PI / 180 * R;
  const y = R * Math.log(Math.tan(Math.PI / 4 + lat * Math.PI / 360));
  /* invert the fitted affine: [x y] = A · [u v 1] */
  const a = A[0][0], b = A[0][1], c = A[1][0], d = A[1][1], det = a * d - b * c;
  if (!det) return null;
  const px = x - A[0][2], py = y - A[1][2];
  const u = (d * px - b * py) / det, v = (a * py - c * px) / det;
  return {ax: u / g.frame_px[0], ay: v / g.frame_px[1]};
}
/* metres on the ground between two frame fractions, through the registration's own scale */
function frameMetres(p, q){
  const g = DATA.georef;
  if (!g || !p || !q) return null;
  const dx = (p.ax - q.ax) * g.frame_px[0], dy = (p.ay - q.ay) * g.frame_px[1];
  return Math.hypot(dx, dy) * g.m_per_frame_px_ground;
}
function fixOf(key){ return (S.fixes || {})[key] || null; }
/* v5.54 — of every pin taken against this drop (the drop itself and each building in it), the one to steer by:
   the most recently taken, and where two share a moment the tighter of the two. Order in the list is not
   evidence of anything and must never decide this. */
/* v5.55 — A PIN WEARS ITS REFERENCE. Andrew Fisher, 21 Sep 2026, looking at the satellite board: a pin is called by
   its reference — P2, P3 — not by anything else.

   He is right, and it was. A pin taken against a building inside P13 was labelled 7356 — the last four digits
   of asset number 1097356 — so a board full of pins read 7356, 1961, 1969, 0599 and told nobody which drop
   any of them was. The reference is the name every person on this job actually uses: it is on the schedule,
   on the drop sheet, on the plate, in the radio call. An asset number is how a machine is identified in the
   rental system, and it is not how anybody standing on the ground says where they are.

   So the reference leads, always. The asset number only appears as a tail when the same reference carries more
   than one pin and the reference alone could not tell them apart — and even then it reads P13·7356, not 7356. */
function pinTag(key){
  const pk = fixParse(key);
  if (!pk.unit) return pk.ref;
  const others = Object.keys(S.fixes || {}).filter(k => {
    const q = fixParse(k); return q.ref === pk.ref && q.unit && (S.fixes[k] || {}).lat != null;
  });
  return others.length > 1 ? pk.ref + '·' + String(pk.unit).slice(-4) : pk.ref;
}
function bestPinFor(a){
  if (!a) return null;
  const keys = [a.key].concat(pinUnits(a).map(u => fixKey(a.key, u)));
  let win = null;
  keys.forEach(k => {
    const f = fixOf(k); if (!f || f.lat == null) return;
    if (!win) { win = {key: k, fix: f}; return; }
    const ta = String(f.at || ''), tb = String(win.fix.at || '');
    if (ta > tb) { win = {key: k, fix: f}; return; }
    if (ta === tb) {
      const aa = f.acc == null ? Infinity : f.acc, bb = win.fix.acc == null ? Infinity : win.fix.acc;
      if (aa < bb) win = {key: k, fix: f};
    }
  });
  return win;
}
/* v5.51 — A PIN PER BUILDING. Andrew Fisher, 18 Sep 2026: some locations have two buildings, but the costs and
   the options belong to each building — toilet building, toilet, container, sewage — so two assets are priced
   one each; and pinning each one exactly is what makes demob easy.

   So a fix is recorded against the REFERENCE (where the drop is) or against ONE ASSET NUMBER inside it (which
   building, exactly) — the same two groups the drop photographs use, because WC16 is two toilet blocks and a
   pin on one is not a pin on the other. The key is the reference alone, or reference/u<asset number>; the
   collection, the stamps, the sync and the export are the ones the reference pin already has. */
function fixKey(ref, unit){ const u = unitKey(unit); return u ? ref + '/u' + u : ref; }
function fixParse(key){ const m = String(key || '').match(/^([^/]+)(?:\/u(.+))?$/); return m ? {ref: m[1], unit: m[2] || ''} : {ref: '', unit: ''}; }
function fixLabel(key){ const p = fixParse(key); return p.unit ? p.ref + ' \u00b7 asset ' + p.unit : p.ref; }
/* the things a pin can be taken against: the reference, then every asset number known against it */
function pinUnits(a){ return dropPhotoUnits(a); }
function pinTargetOk(key){
  const p = fixParse(key); if (!p.ref || !isRef(p.ref)) return false;
  if (!p.unit) return true;
  const a = allAssets().find(x => x.key === p.ref);
  return !!a && pinUnits(a).includes(p.unit);
}
/* How good is the fix? The words are the device's number, not a judgement dressed up as one. */
function fixQuality(acc){
  if (acc == null) return {word: 'accuracy not reported', cls: 'cand'};
  if (acc <= 8)  return {word: '±' + Math.round(acc) + ' m', cls: 'ok'};
  if (acc <= 20) return {word: '±' + Math.round(acc) + ' m — usable', cls: 'act'};
  return {word: '±' + Math.round(acc) + ' m — poor, worth taking again', cls: 'crit'};
}
/* v5.54 — TAKING A FIX, ONCE, PROPERLY — used by every pin the page records: where a thing stands, and the
   way in to it. One sampler, so a second kind of pin can never quietly be less careful than the first.

   getCurrentPosition hands back the FIRST position that satisfies the options, and on a phone the first one is
   almost always the worst: the receiver has not settled, so it answers from the cell towers or a stale cache at
   twenty, forty, sometimes ninety metres, and three seconds later it would have said four. The old code took
   that first answer and wrote it down as the spot. A crew then walked to a pin that was never where anybody
   stood.

   So it watches instead of asking once, and keeps the tightest reading it has seen. Three ways it ends, and it
   takes whichever comes first. Good enough: the phone says 5 m or better and it has said it more than once.
   Settled: nothing new has come in for a couple of seconds, so the receiver has given what it has and waiting
   longer buys nothing. Out of time: the window closes and the tightest reading so far is the one. A receiver
   that never improves is not a reason to keep somebody standing in the sun.

   Nothing is invented: what comes back is a reading the device actually gave, and how many it chose from goes
   with it so the pin can be judged later rather than trusted blind. */
var PIN_GOOD_M = 5, PIN_WINDOW_MS = 8000, PIN_IDLE_MS = 2500, PIN_MIN_SAMPLES = 2;
function takeBestFix(done, fail){
  if (!navigator.geolocation) { flash('This browser will not give a location at all, so there is nothing to record.'); if (fail) fail(); return; }
  if (!window.isSecureContext && location.protocol === 'file:')
    flash('Asking anyway — but a file opened from storage is often refused a location. The hosted link always works.');
  let best = null, seen = 0, watch = null, settled = false, timer = null, idle = null;
  flash('Getting a fix — hold still. It watches for a few seconds and keeps the tightest reading.');
  const stop = function(){
    if (watch != null) { try { navigator.geolocation.clearWatch(watch); } catch (e) {} watch = null; }
    clearTimeout(timer); clearTimeout(idle);
  };
  const finish = function(){
    if (settled) return; settled = true; stop();
    if (!best) { flash('No position good enough to write down. Nothing recorded.'); if (fail) fail(); return; }
    done(best, seen);
  };
  timer = setTimeout(finish, PIN_WINDOW_MS);
  watch = navigator.geolocation.watchPosition(function(pos){
    const c = pos && pos.coords; if (!c || c.latitude == null || c.longitude == null) return;
    seen++;
    const acc = (c.accuracy == null ? Infinity : c.accuracy);
    if (!best || acc < best.acc) best = {lat: c.latitude, lon: c.longitude, acc: acc};
    if (seen >= PIN_MIN_SAMPLES && best.acc <= PIN_GOOD_M) { finish(); return; }
    clearTimeout(idle); idle = setTimeout(finish, PIN_IDLE_MS);
  }, function(err){
    if (best) { finish(); return; }
    if (settled) return; settled = true; stop();
    flash(err && err.code === 1 ? 'The location was refused. Allow location for this page in the browser, then press it again.'
        : err && err.code === 3 ? 'No fix in ' + Math.round(PIN_WINDOW_MS / 1000) + ' seconds — step into the open and press it again.'
        : 'No location available just now. Nothing recorded.');
    if (fail) fail();
  }, {enableHighAccuracy: true, timeout: PIN_WINDOW_MS, maximumAge: 0});
}
/* v5.54 — WHEREVER HE STANDS. Andrew Fisher, 21 Sep 2026: a pinned location is exactly where he pins it — no
   made-up data.

   The reading is written down exactly as the device gave it, and what cannot be derived from it is left NULL
   and said out loud — no frame position invented for an off-frame pin, no distance from a drawing that does
   not reach the spot. Used by both kinds of pin, so neither can drift from the other. */
function fixRecordFrom(b, samples, who, ref, unit, drawnFor){
  const fr = frameOf(b.lat, b.lon);
  const onFrame = !!fr && fr.ax >= -0.25 && fr.ax <= 1.25 && fr.ay >= -0.25 && fr.ay <= 1.25;
  let awayM = null;
  if (!onFrame) { const mid = lonLatOf(0.5, 0.5); if (mid) awayM = Math.round(haversineKm(mid, {lat: b.lat, lon: b.lon}) * 1000); }
  return {lat: b.lat, lon: b.lon,
          acc: (b.acc === Infinity ? null : Math.round(b.acc * 10) / 10),
          at: new Date().toISOString(), by: who,
          ax: onFrame ? fr.ax : null, ay: onFrame ? fr.ay : null,
          off: (onFrame && drawnFor) ? Math.round(frameMetres(fr, drawnFor)) : null,
          outside: onFrame ? null : (fr ? 'outside the area the drawings cover' : 'this file carries no georeference'),
          away_m: awayM, ref: ref, unit: unit || null,
          n: samples, took: 'best of ' + samples + ' reading' + (samples === 1 ? '' : 's')};
}
function fixOffWords(f){
  if (!f || !f.outside) return '';
  return ' · recorded, but it is ' + f.outside
       + (f.away_m != null ? ' (' + (f.away_m >= 1000 ? (f.away_m / 1000).toFixed(1) + ' km' : f.away_m + ' m') + ' from the drawn site)' : '')
       + ', so it will not show a mark on the sheet';
}
function pinMyLocation(key, done){
  if (!mayWrite('a recorded position')) return;
  if (!pinTargetOk(key)) { flash(String(key || '') + ' is not a reference, or not an asset number known against one, in this file — nothing recorded.'); return; }
  const who = whoAmI(); if (!who) return;
  const had = fixOf(key), pk = fixParse(key);
  takeBestFix(function(b, samples){
    const drawn = aerialPointFor(assetOf(pk.ref) || {key: pk.ref});
    S.fixes = S.fixes || {};
    S.fixes[key] = fixRecordFrom(b, samples, who, pk.ref, pk.unit, drawn);
    /* a pin replaces the pin that was there — one spot per thing, never two */
    supersedePins(key, who);
    stampIt('fixes', key, who); bump();
    const F = S.fixes[key], q = fixQuality(F.acc);
    flash(fixLabel(key) + (had ? ' re-pinned' : ' pinned') + ' where you are standing — ' + b.lat.toFixed(6) + ', ' + b.lon.toFixed(6)
          + ' · ' + q.word + ' · ' + F.took + (F.off != null ? ' · ' + F.off + ' m from where the drawing puts it' : '')
          + fixOffWords(F) + (had ? '. The pin that was here is gone.' : '.') + ' The drawing is untouched.');
    if (done) done(F);
  });
}
/* v5.54 — ONE PIN PER THING. Andrew Fisher, 21 Sep 2026: a new pinned location replaces the old one.

   Re-pinning the SAME thing already replaced it: S.fixes[key] is one slot, not a list. What did not get
   removed was the rougher pin on the drop above it. Pin WC16 standing at the gate, then walk in and pin the
   building inside it, and both stayed — and the drop's pin won the Navigate button, because the button took
   the first key in the list and the reference is always first. The newer, tighter pin was outranked by the
   very pin it was taken to replace, and the crew got sent back to the gate.

   So a pin on a BUILDING clears the drop-level pin for that drop. The drop pin said "it is somewhere in here";
   the building pin says where. It never touches another building's pin — those are separate things, and Andrew
   asked for one each on 18 Sep. Anything in that drop still unpinned falls back to the drawing position, the
   same as before anyone pinned anything, so nothing is left with no position at all. */
function supersedePins(key, who){
  const pk = fixParse(key);
  if (!pk.ref || !pk.unit) return;              /* pinning the drop itself supersedes nothing finer than it */
  const f = (S.fixes || {})[pk.ref];
  if (!f || f.lat == null) return;
  delete S.fixes[pk.ref];
  stampIt('fixes', pk.ref, who);
}
/* v5.54 — THE WAY IN. Andrew Fisher, 20 Sep 2026: for a map location, a picture and a pinned entry point showing
   how to get to it — and, asked whose picture and whose pin: his photograph, and a pin he places.

   So it is his. Not read off a map, not derived from the drawing, not the nearest street TomTom could find: he
   stands at the turn-in and presses it, through the same sampler the drop pin uses, under the same rule — the
   reading is written exactly as the phone gave it, and anything that cannot be derived from it is left null
   rather than approximated. One per drop: the way in is a property of getting to the place, not of each
   building once you are standing in it.

   It is deliberately NOT kept in S.fixes. A fix answers "where is the thing". An entry answers "where do I turn
   off the street to reach it". A truck driver who has never been here wants the entry; a demob crew looking for
   building 1097356 wants the fix. Fuse the two and one of those people is always sent to the wrong end of the
   job. */
function entryOf(ref){ return (S.entries || {})[ref] || null; }
/* How far the way in is from the thing itself — worked out when it is shown, never stored, because the drop
   pin can move after the entry was taken and a stored number would quietly go stale. Measured against the
   pinned position where there is one, and the drawing's callout where there is not; null when neither exists,
   and the caller says which it was rather than implying a survey. */
function entryToDrop(ref){
  const e = entryOf(ref); if (!e || e.lat == null) return null;
  const a = assetOf(ref); if (!a) return null;
  const best = bestPinFor(a);
  let to = null, basis = null;
  if (best && best.fix && best.fix.lat != null) { to = {lat: best.fix.lat, lon: best.fix.lon}; basis = 'the pinned spot'; }
  else { const pt = aerialPointFor(a), ll = pt ? lonLatOf(pt.ax, pt.ay) : null;
         if (ll) { to = ll; basis = "the drawing's callout"; } }
  if (!to) return null;
  return {m: Math.round(haversineKm(e, to) * 1000), basis: basis};
}
function pinEntry(ref, done){
  if (!mayWrite('an entry point')) return;
  if (!isRef(ref)) { flash(String(ref || '') + ' is not a reference in this file — nothing recorded.'); return; }
  const who = whoAmI(); if (!who) return;
  const had = entryOf(ref);
  takeBestFix(function(b, samples){
    S.entries = S.entries || {};
    S.entries[ref] = fixRecordFrom(b, samples, who, ref, null, null);
    stampIt('entries', ref, who); bump();
    const E = S.entries[ref], q = fixQuality(E.acc), d = entryToDrop(ref);
    flash('Way in to ' + ref + (had ? ' re-pinned' : ' pinned') + ' where you are standing — '
          + b.lat.toFixed(6) + ', ' + b.lon.toFixed(6) + ' · ' + q.word + ' · ' + E.took
          + (d ? ' · ' + d.m + ' m from ' + d.basis : '') + fixOffWords(E)
          + (had ? '. The entry that was here is gone.' : '.'));
    if (done) done(E);
  });
}
/* Take the way in off again — named and timed like everything else. What is left is the drop's own position,
   exactly as it was before anybody recorded a way in. */
function clearEntry(ref){
  if (!mayWrite('an entry point')) return;
  const who = whoAmI(); if (!who) return;
  if (!(S.entries || {})[ref]) return;
  delete S.entries[ref];
  stampIt('entries', ref, who); bump();
  flash(ref + ' — the recorded way in is taken off. Directions go to the drop itself again.');
}
/* v5.55 — A POSITION PUT THERE FROM OUTSIDE. Andrew Fisher, 21 Sep 2026: an option to pin things from outside, which
   then updates everything inside.

   Everything above this needs somebody standing at the thing with a phone. That is the best position there is
   and it is also the one you cannot have at 9pm the night before, or for the forty references nobody has walked
   to yet, or for a drop iEDM have drawn and Coates have not yet been to. So a position can also be PLACED: put
   where it goes from the drawing or by dropping it on the map, by a named person, at a stated time.

   It is deliberately NOT a pin, and the page never lets the two be read as each other. A pin carries the number
   the phone reported and means "somebody stood here". A placed position carries no accuracy at all — because
   there is none to carry — and means "somebody put it here". Writing a made-up accuracy against a placed
   position would be the exact fake data Andrew ruled out the same morning: a pinned location is exact wherever
   it is pinned, and no data is made up.

   And a pin always wins. Somebody standing at the thing knows more than somebody at a desk, however recently
   the desk was updated — so a stood-at pin outranks a placed position for Navigate, for the drop sheet and for
   every mark on every map, no matter which came last. */
function placeOf(key){ return (S.places || {})[key] || null; }
/* of every position PLACED against this drop — the drop itself and each building in it — the newest */
function bestPlaceFor(a){
  if (!a) return null;
  const keys = [a.key].concat(pinUnits(a).map(u => fixKey(a.key, u)));
  let win = null;
  keys.forEach(k => {
    const p = placeOf(k); if (!p || p.lat == null) return;
    if (!win || String(p.at || '') > String(win.place.at || '')) win = {key: k, place: p};
  });
  return win;
}
/* What to call it on the page. Never a number, because there is no number — the words say who put it there and
   what they went off, and nothing more is claimed. */
function placeWords(p){
  if (!p) return '';
  return 'placed, not measured' + (p.how ? ' · ' + p.how : '');
}
function placeHere(key, lat, lon, opts){
  if (!mayWrite('a placed position')) return null;
  if (!pinTargetOk(key)) { flash(String(key || '') + ' is not a reference, or not an asset number known against one, in this file — nothing recorded.'); return null; }
  const who = whoAmI(); if (!who) return null;
  const la = Number(lat), lo = Number(lon);
  if (!isFinite(la) || !isFinite(lo) || la < -90 || la > 90 || lo < -180 || lo > 180) {
    flash('That is not a latitude and longitude — nothing placed.'); return null;
  }
  const o = opts || {}, pk = fixParse(key), had = placeOf(key);
  const fr = frameOf(la, lo);
  const onFrame = !!fr && fr.ax >= -0.25 && fr.ax <= 1.25 && fr.ay >= -0.25 && fr.ay <= 1.25;
  let awayM = null;
  if (!onFrame) { const mid = lonLatOf(0.5, 0.5); if (mid) awayM = Math.round(haversineKm(mid, {lat: la, lon: lo}) * 1000); }
  S.places = S.places || {};
  S.places[key] = {lat: la, lon: lo, at: new Date().toISOString(), by: who,
                   /* how it was arrived at, in the words of whoever did it — never a guess and never blank */
                   how: String(o.how || 'placed on the map'),
                   source: o.source || null, note: o.note || null,
                   ax: onFrame ? fr.ax : null, ay: onFrame ? fr.ay : null,
                   outside: onFrame ? null : (fr ? 'outside the area the drawings cover' : 'this file carries no georeference'),
                   away_m: awayM, ref: pk.ref, unit: pk.unit || null};
  stampIt('places', key, who); bump();
  const P = S.places[key], stood = fixOf(key);
  flash(fixLabel(key) + (had ? ' moved' : ' placed') + ' at ' + la.toFixed(6) + ', ' + lo.toFixed(6)
        + ' · ' + placeWords(P)
        + (stood ? '. There is a pin here from somebody who stood at it, and that is still what Navigate uses.'
                 : '. Nobody has stood at it yet — a pin taken on site will replace this everywhere.'));
  return P;
}
function clearPlace(key){
  if (!mayWrite('a placed position')) return;
  const who = whoAmI(); if (!who) return;
  if (!(S.places || {})[key]) return;
  delete S.places[key];
  stampIt('places', key, who); bump();
  flash(fixLabel(key) + ' — the placed position is taken off.');
}
/* Take it off again: a recorded position is set aside the way everything else is, with a name and a time. */
function clearMyLocation(key){
  if (!mayWrite('a recorded position')) return;
  const who = whoAmI(); if (!who) return;
  if (!(S.fixes || {})[key]) return;
  delete S.fixes[key];
  stampIt('fixes', key, who); bump();
  flash(fixLabel(key) + ' — recorded position taken off. The drawing position is what is left, as it always was.');
}
/* ---- A LIVE MAP UNDER THE POSITION, ON THE HOSTED LINK ONLY (v5.51). Andrew Fisher, 18 Sep 2026: he has a
   Mapbox account — and then the token for it, a public one made for this page and restricted in Mapbox's
   console to the hosted address, so it works from nowhere else.

   What it adds: a satellite map with street names under the position of a reference and under a recorded pin,
   that pans and zooms past the edge of the drawing, with a Where-am-I control that follows the phone. It is
   a WINDOW on the world, not a record: nothing on it is written down, and the drawing stays the drawing.

   WHERE THE KEY LIVES. Not in this file. It is typed once on the hosted page and kept in the shared record
   (mapKeys/mapbox, stamped with a name and a time like everything else), so every phone on the link gets the
   map and rotating the key in Mapbox is the same paste again with no rebuild. It never travels in the record
   export — a file handed round by email carries no key — and the map is never even offered on a file opened
   from storage: there is no address for Mapbox to trust, so a key could do nothing there but leak.

   WHAT LEAVES THE PAGE, AND ONLY WHEN LIVE IS PRESSED: map-tile requests to api.mapbox.com carrying the key
   and this page's ORIGIN (the address, never the path with the link's token in it — the referrer is set to
   strict-origin-when-cross-origin for this document at the moment the map library is asked for, because the
   service answers every page with no-referrer, and Mapbox checks the referrer against the key's address list;
   with none sent, a restricted key is refused). The Where-am-I control uses the phone's own location, which
   Mapbox never sees. Nothing is fetched from any map service until somebody presses Live. */
const LIVEMAP = {gl: null, loading: null, map: null, note: null, VERSION: '3.30.0', env: undefined};
function liveMapPossible(){
  return location.protocol === 'https:' && typeof window.WebGL2RenderingContext !== 'undefined';
}
/* The key, from wherever it honestly is: the service's own variable first (MAPBOX_TOKEN on Railway — Andrew set
   it there on 18 Sep 2026 and the service hands it to the page behind the link token), else the one pasted on
   the hosted page and kept in the shared record. Asked of the service once per page load. */
function liveMapKey(){
  if (LIVEMAP.env && LIVEMAP.env.token) return LIVEMAP.env;
  const k = (S.mapKeys || {}).mapbox;
  return k && typeof k.token === 'string' && LIVEMAP_PK.test(k.token) ? k : null;
}
async function liveMapKeyFromService(){
  if (LIVEMAP.env !== undefined) return LIVEMAP.env;
  if (!liveMapPossible()) { LIVEMAP.env = null; return null; }
  try {
    const opts = {cache: 'no-store'}, t = wxToken(); if (t) opts.headers = {'x-gc500-token': t};
    const r = await fetch('/api/map-key', opts);
    if (r.ok) { const j = await r.json(); LIVEMAP.env = j && LIVEMAP_PK.test(String(j.token || '')) ? {token: j.token, by: 'the service (MAPBOX_TOKEN)', at: null, from: 'service'} : null;
      GMAPS_ENV = j && j.google && GOOGLE_KEY.test(String(j.google.key || '')) ? {key: j.google.key, by: 'the service (GOOGLE_MAPS_KEY)', at: null, from: 'service', restrictedTo: j.google.restrictedTo || null} : null; }
    else LIVEMAP.env = null;
  } catch (e) { LIVEMAP.env = null; }
  return LIVEMAP.env;
}
/* a public Mapbox token: pk., a base64url body, a base64url signature. Nothing else is ever kept. */
const LIVEMAP_PK = /^pk\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{16,}$/;
function setLiveMapKey(tok){
  if (!mayWrite('the live map key')) return false;
  const who = whoAmI(); if (!who) return false;
  tok = String(tok || '').trim();
  if (/^sk\./.test(tok)) { flash('That is a SECRET Mapbox token (sk.). It must never go on a web page — nothing saved. Make a public one (pk.) in the Mapbox console with this address under URL restrictions.'); return false; }
  if (!LIVEMAP_PK.test(tok)) { flash('That does not read as a Mapbox public token — it starts pk. and has two dot-separated parts after it. Copy it again with the console\'s copy button; nothing saved.'); return false; }
  S.mapKeys = S.mapKeys || {};
  S.mapKeys.mapbox = {token: tok, at: new Date().toISOString(), by: who, restrictedTo: location.origin};
  stampIt('mapKeys', 'mapbox', who); bump();
  if (LIVEMAP.map) { try { LIVEMAP.map.remove(); } catch (e) {} LIVEMAP.map = null; }
  flash('Live map key saved for everybody on this link — ' + who + ', ' + fmtWhen(S.mapKeys.mapbox.at) + '. Press Live under any position to use it.');
  return true;
}
function clearLiveMapKey(){
  if (!mayWrite('the live map key')) return false;
  const who = whoAmI(); if (!who) return false;
  if (!(S.mapKeys || {}).mapbox) return false;
  delete S.mapKeys.mapbox;
  stampIt('mapKeys', 'mapbox', who); bump();
  if (LIVEMAP.map) { try { LIVEMAP.map.remove(); } catch (e) {} LIVEMAP.map = null; }
  flash('Live map key taken off. The map stops for everybody on this link; the drawing and the photograph are untouched.');
  return true;
}
/* A recorded moment, read back in Brisbane wherever the page is opened. It used to leave the timezone to the
   device, which is right for a clock and wrong for a fact: the TomTom snapshot taken at 15:13 on the Gold Coast
   printed as "05:13" on a machine set to UTC, and nothing on the card said which clock it was using. A time on
   this page is a time on site. Same rule as the drop photographs and Today itself — Andrew Fisher, 14 Sep 2026:
   Today comes from the current date in Australia/Brisbane. */
/* the zone is written out rather than read from EVENT_TZ, which is declared further down this file: a const
   is in its temporal dead zone until then, so a call made while the script is still evaluating would throw. */
function fmtWhen(iso){ try { const d = new Date(iso); return isNaN(d) ? '' : d.toLocaleString('en-AU', {timeZone: 'Australia/Brisbane', hour12: false, day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'}); } catch (e) { return ''; } }
function loadMapboxGl(){
  if (LIVEMAP.gl) return Promise.resolve(LIVEMAP.gl);
  if (LIVEMAP.loading) return LIVEMAP.loading;
  /* the referrer, for this document only: the origin and nothing more (see the note above) */
  let m = document.querySelector('meta[name="referrer"]');
  if (!m) { m = document.createElement('meta'); m.name = 'referrer'; document.head.appendChild(m); }
  m.content = 'strict-origin-when-cross-origin';
  const base = 'https://api.mapbox.com/mapbox-gl-js/v' + LIVEMAP.VERSION + '/mapbox-gl';
  LIVEMAP.loading = new Promise((res, rej) => {
    const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = base + '.css'; document.head.appendChild(css);
    const sc = document.createElement('script'); sc.src = base + '.js'; sc.async = true;
    sc.onload = () => { if (window.mapboxgl) { LIVEMAP.gl = window.mapboxgl; res(LIVEMAP.gl); } else rej(new Error('mapboxgl did not appear')); };
    sc.onerror = () => rej(new Error('the map library could not be fetched from api.mapbox.com'));
    document.head.appendChild(sc);
  }).catch(e => { LIVEMAP.loading = null; throw e; });
  return LIVEMAP.loading;
}
/* metres → a ring of lon/lat points, for the accuracy circle round a recorded fix */
function circleAround(lat, lon, r, n){
  const pts = [], R = 6378137, dLat = r / R * 180 / Math.PI, dLon = dLat / Math.cos(lat * Math.PI / 180);
  for (let i = 0; i <= (n || 48); i++) { const t = i / (n || 48) * Math.PI * 2; pts.push([lon + dLon * Math.cos(t), lat + dLat * Math.sin(t)]); }
  return pts;
}
function liveMapNote(box, html, cls){
  let n = box.querySelector('.livenote');
  if (!n) { n = document.createElement('div'); n.className = 'livenote'; box.appendChild(n); }
  n.className = 'livenote' + (cls ? ' ' + cls : ''); n.innerHTML = html;
}
/* Mount the live map in the satellite window for one reference. Never called on a file:// page. */
async function mountLiveMap(box, a, pt){
  if (!box || !pt) return;
  const ll = lonLatOf(pt.ax, pt.ay);
  if (!ll) { liveMapNote(box, 'No georeference in this file, so there is nothing to put a map under.'); return; }
  liveMapNote(box, 'Asking the service for the map key…');
  await liveMapKeyFromService();
  const key = liveMapKey();
  if (!key) {
    liveMapNote(box, capability() === 'edit'
      ? `<b>Live map is not set up on this link yet.</b> Paste the Mapbox public token (pk.…) made for this address:
         <span class="liveform"><input type="text" id="liveKeyIn" placeholder="pk.…" autocomplete="off" spellcheck="false" inputmode="text">
         <button class="btn tiny" id="liveKeySave">Save for everybody</button></span>
         <span class="sub">It goes to the shared record, not into this file. About this file › Live map says what it does.</span>`
      : '<b>Live map is not set up on this link yet.</b> Somebody with the edit link pastes the Mapbox key once, under About this file › Live map.', 'form');
    const sv = box.querySelector('#liveKeySave'), inp = box.querySelector('#liveKeyIn');
    if (sv && inp) sv.onclick = () => { if (setLiveMapKey(inp.value)) mountLiveMap(box, a, pt); };
    return;
  }
  liveMapNote(box, 'Loading the map from Mapbox…');
  let gl;
  try { gl = await loadMapboxGl(); }
  catch (e) { liveMapNote(box, '<b>The map library could not be fetched from api.mapbox.com.</b> No signal, or that address is blocked on this network. The photograph is still here — press Closer.', 'warn'); return; }
  const n = box.querySelector('.livenote'); if (n) n.remove();
  if (LIVEMAP.map) { try { LIVEMAP.map.remove(); } catch (e) {} LIVEMAP.map = null; }
  let el = box.querySelector('.livemap');
  if (!el) { el = document.createElement('div'); el.className = 'livemap'; box.appendChild(el); }
  el.innerHTML = '';
  gl.accessToken = key.token;
  /* the fixes that belong to this reference — the drop, and each building inside it (v5.51) */
  const mine = Object.keys(S.fixes || {}).filter(k => fixParse(k).ref === a.key && S.fixes[k] && S.fixes[k].lat != null).map(k => Object.assign({key: k}, S.fixes[k]));
  const fx = mine[0] || null;
  const centre = fx ? [fx.lon, fx.lat] : [ll.lon, ll.lat];
  let map;
  try {
    /* v5.83 — free to turn and tilt, like every map here (Andrew Fisher, 25 Sep 2026); the compass sets north up */
    map = new gl.Map({container: el, style: 'mapbox://styles/mapbox/satellite-streets-v12', center: centre, zoom: 17.2, bearing: sheetBearing(),
                      attributionControl: true, cooperativeGestures: true, dragRotate: true, pitchWithRotate: true, touchPitch: true});
  } catch (e) { liveMapNote(box, '<b>The map could not start on this device</b> (' + esc(String(e && e.message || e)) + '). The photograph is still here.', 'warn'); return; }
  LIVEMAP.map = map;
  map.addControl(new gl.NavigationControl({showCompass: true, visualizePitch: true}), 'top-right');
  map.addControl(new gl.ScaleControl({unit: 'metric', maxWidth: 120}), 'bottom-right');
  map.addControl(new gl.GeolocateControl({positionOptions: {enableHighAccuracy: true}, trackUserLocation: true, showUserHeading: true, fitBoundsOptions: {maxZoom: 18}}), 'top-right');
  let refused = false;
  map.on('error', ev => {
    const er = ev && ev.error, st = er && (er.status || (er.message && (er.message.match(/\b(401|403)\b/) || [])[1]));
    if (!refused && (st == 401 || st == 403)) {
      refused = true;
      liveMapNote(box, '<b>Mapbox refused the key from this address</b> (' + st + '). In the Mapbox console the key\'s URL restriction has to include <span class="mono">' + esc(location.origin) + '</span>, and it has to be a public key (pk.). The photograph is still here.', 'warn');
    }
  });
  /* the drawn position, and the recorded one beside it if there is one — the same two the drawing shows */
  new gl.Marker({color: '#e8641b'}).setLngLat([ll.lon, ll.lat])
    .setPopup(new gl.Popup({offset: 22, closeButton: false}).setText(a.key + ' — where the drawing puts it (callout, not a survey)')).addTo(map);
  /* v5.54 — and the way in, in its own green, on the map a driver actually opens. This is the satellite
     picture: the turn-in is the one thing on it a driver cannot work out for himself from the road layout,
     because a gate in a fence line looks like fence until somebody has stood at it. */
  /* v5.55 — a placed position on the satellite too, hollow, and only while nobody has stood at it */
  const putHere = (!mine.length) ? bestPlaceFor(a) : null;
  if (putHere) {
    const pp = putHere.place;
    const el2 = document.createElement('div');
    el2.style.cssText = 'width:20px;height:20px;border-radius:50%;border:2.5px dashed #c98a1a;background:transparent';
    new gl.Marker({element: el2}).setLngLat([pp.lon, pp.lat])
      .setPopup(new gl.Popup({offset: 16, closeButton: false}).setText(fixLabel(putHere.key) + ' — ' + placeWords(pp)
        + ' by ' + (pp.by || 'somebody') + '. Nobody has stood at it yet.')).addTo(map);
  }
  const ent = entryOf(a.key);
  if (ent && ent.lat != null) {
    const ed = entryToDrop(a.key);
    new gl.Marker({color: '#0a8f5b'}).setLngLat([ent.lon, ent.lat])
      .setPopup(new gl.Popup({offset: 22, closeButton: false}).setText('Way in to ' + a.key + ' — pinned by '
        + (ent.by || 'somebody') + ' standing at the turn-in, ' + fixQuality(ent.acc).word
        + (ed ? ' · ' + ed.m + ' m from ' + ed.basis : ''))).addTo(map);
  }
  if (mine.length) {
    mine.forEach(f => new gl.Marker({color: '#1d5fc4'}).setLngLat([f.lon, f.lat])
      .setPopup(new gl.Popup({offset: 22, closeButton: false}).setText(fixLabel(f.key) + ' — recorded by ' + (f.by || 'somebody') + ' standing at it, ' + fixQuality(f.acc).word)).addTo(map));
    map.on('load', () => {
      if (LIVEMAP.map !== map) return;
      mine.forEach((f, i) => { if (f.acc == null) return;
        try {
          map.addSource('fixacc' + i, {type: 'geojson', data: {type: 'Feature', geometry: {type: 'Polygon', coordinates: [circleAround(f.lat, f.lon, f.acc)]}}});
          map.addLayer({id: 'fixacc-fill' + i, type: 'fill', source: 'fixacc' + i, paint: {'fill-color': '#1d5fc4', 'fill-opacity': 0.18}});
          map.addLayer({id: 'fixacc-line' + i, type: 'line', source: 'fixacc' + i, paint: {'line-color': '#1d5fc4', 'line-width': 1.5}});
        } catch (e) {} });
    });
    /* all of them in frame, with the drawn position */
    try { const b = new gl.LngLatBounds([ll.lon, ll.lat], [ll.lon, ll.lat]); mine.forEach(f => b.extend([f.lon, f.lat]));
      if (ent && ent.lat != null) b.extend([ent.lon, ent.lat]);   /* v5.54 — the way in opens in frame too */
      map.fitBounds(b, {padding: 48, maxZoom: 18.5, duration: 0}); } catch (e) {}
  }
  /* every other recorded pin, small and grey, so what the crews have actually placed shows round about */
  Object.keys(S.fixes || {}).forEach(k => {
    const f = S.fixes[k]; if (fixParse(k).ref === a.key || !f || f.lat == null) return;
    new gl.Marker({color: '#8a9096', scale: 0.6}).setLngLat([f.lon, f.lat])
      .setPopup(new gl.Popup({offset: 14, closeButton: false}).setText(fixLabel(k) + ' — recorded by ' + (f.by || 'somebody') + ', ' + fixQuality(f.acc).word)).addTo(map);
  });
}
/* The About card: what the live map is, where its key is, and the paste box for it (edit level, hosted only). */
function liveMapAboutCard(){
  const hosted = liveMapPossible();
  const rec = (S.mapKeys || {}).mapbox, env = LIVEMAP.env;
  /* v5.86 - About used to say "not asked yet" until somebody pressed Live; it asks now, and redraws with the answer */
  if (hosted && env === undefined) liveMapKeyFromService().then(() => { const ab = $('#pane-about'); if (ab && !ab.hidden) renderAbout(); }).catch(() => {});
  const tail = t => t && t.length > 6 ? '…' + t.slice(-6) : '';
  const cap = capability();
  let status;
  if (!hosted) status = `<div class="notice"><b>Not in this copy.</b> The live map is only offered on the hosted link — a file opened from storage has no address for Mapbox to trust, so a key could do nothing here but leak. The embedded photograph above is what this copy has, and it works with no signal.</div>`;
  else if (env && env.token) status = `<div class="notice ok"><b>On, from the service.</b> The key is the service's own variable (set on Railway by Andrew Fisher), ending <span class="mono">${esc(tail(env.token))}</span>. It is handed to every phone on this link on purpose — a public key, restricted in Mapbox to this address.</div>`;
  else if (rec && rec.token) status = `<div class="notice ok"><b>On, from the shared record.</b> Key ending <span class="mono">${esc(tail(rec.token))}</span>, pasted by <b>${esc(rec.by || '')}</b> ${esc(fmtWhen(rec.at))}. Every phone on this link gets it.</div>`;
  else if (env === undefined) status = `<div class="notice"><b>Not asked yet.</b> The service is asked for the key the first time Live is pressed under a position.</div>`;
  else status = `<div class="notice warn"><b>Not set up on this link.</b> No key on the service (the Railway variable MAPBOX_TOKEN) and none pasted here.</div>`;
  const form = hosted && cap === 'edit' ? `
    <div class="f" style="margin-top:8px">
      <label for="liveKeyAbout">Mapbox public token (pk.…) for this address</label>
      <div class="liveform about"><input type="text" id="liveKeyAbout" placeholder="pk.…" autocomplete="off" spellcheck="false" value="">
        <button class="btn" id="liveKeyAboutSave">Save for everybody</button>${rec && rec.token ? '<button class="btn ghost" id="liveKeyAboutClear">Take it off</button>' : ''}</div>
      <p class="sub">Goes to the shared record with your name and the time — not into this file, and never into a record export. A secret token (sk.) is refused. The service's own variable, when set, is used ahead of this.</p>
    </div>` : '';
  const gk = googleMapKey() || (S.mapKeys || {}).google;
  const gform = hosted && cap === 'edit' ? `
    <div class="f" style="margin-top:8px">
      <label for="googleKeyAbout">Google Maps Platform browser key (AIza…) for this address, with the Map Tiles API on it</label>
      <div class="liveform about"><input type="text" id="googleKeyAbout" placeholder="AIza…" autocomplete="off" spellcheck="false" value="">
        <button class="btn" id="googleKeyAboutSave">Save for everybody</button>${gk && gk.key ? '<button class="btn ghost" id="googleKeyAboutClear">Take it off</button>' : ''}</div>
      <p class="sub">Goes to the shared record with your name and the time — not into this file, and never into a record export. A service-account secret is refused. Restrict the key in Google Cloud to this address and to the Map Tiles API, so it draws from here and from nowhere else.</p>
    </div>` : '';
  const g3d = `<div class="card" id="sat3dCard"><h3>3D satellite (Google · CesiumJS)</h3>
   <p class="sub">Map → <b>Satellite · 3D</b>: the circuit and its buildings as Google photographs them, in three dimensions, flown to from above the straight — or to the thing the search found, ringed. Added at Andrew Fisher's request, 24 Sep 2026.</p>
   ${!hosted ? `<div class="notice"><b>Not in this copy.</b> The 3D board is only offered on the hosted link, like the live map.</div>`
     : gk && gk.key && gk.from === 'service' ? `<div class="notice ok"><b>On, from the service.</b> The key is the service's own variable (GOOGLE_MAPS_KEY, set on Railway by Andrew Fisher), ending <span class="mono">${esc(tail(gk.key))}</span>. It is handed to every phone on this link; a key pasted below is used only when the service has none.</div>`
     : gk && gk.key ? `<div class="notice ok"><b>On.</b> Key ending <span class="mono">${esc(tail(gk.key))}</span>, pasted by <b>${esc(gk.by || '')}</b> ${esc(fmtWhen(gk.at))}. Every phone on this link can open the board.</div>`
     : `<div class="notice warn"><b>Not set up on this link.</b> No Google key pasted here yet — the Satellite · 3D button stays off the Map tab until one is.</div>`}
   <p class="sub">What leaves the page, and only while the board is open: tile requests to tile.googleapis.com carrying the key and this page's address, and the CesiumJS library from cesium.com. Google bills each opening of the board (one root-tileset request a session) to the account the key belongs to, which is why it never opens by itself.</p>
   ${gform}
  </div>`;
  return g3d + `<div class="card" id="liveMapCard"><h3>Live map (Mapbox)</h3>
   <p class="sub">A live satellite map with street names under any position on this page — press <b>Live</b> beside the photograph in a reference's drawer. It pans and zooms past the edge of the drawing and follows the phone with the Where-am-I control. A window on the world, not a record: nothing on it is written down, the drawing is never moved by it.</p>
   ${status}
   <p class="sub">What leaves the page, and only when Live is pressed: map-tile requests to api.mapbox.com carrying the key and this page's address (the address only — never the path with the link's token in it). Your own location goes to Mapbox's map on your screen and nowhere else. The map library (Mapbox GL JS v${esc(LIVEMAP.VERSION)}) is fetched from api.mapbox.com at that moment and not before. Map data © Mapbox © OpenStreetMap contributors, credited on the map itself.</p>
   ${form}
  </div>`;
}
function wireLiveMapAbout(){
  const sv = $('#liveKeyAboutSave'), inp = $('#liveKeyAbout'), cl = $('#liveKeyAboutClear');
  if (sv && inp) sv.onclick = () => { if (setLiveMapKey(inp.value)) { inp.value = ''; renderAbout(); } };
  if (cl) cl.onclick = () => { if (clearLiveMapKey()) renderAbout(); };
  const gs = $('#googleKeyAboutSave'), gi = $('#googleKeyAbout'), gc = $('#googleKeyAboutClear');
  if (gs && gi) gs.onclick = () => { if (setGoogleMapKey(gi.value)) { gi.value = ''; renderAbout(); } };
  if (gc) gc.onclick = () => { if (clearGoogleMapKey()) renderAbout(); };
}
function unmountLiveMap(box){
  if (LIVEMAP.map) { try { LIVEMAP.map.remove(); } catch (e) {} LIVEMAP.map = null; }
  if (!box) return;
  box.querySelectorAll('.livemap, .livenote').forEach(e => e.remove());
}
/* Outbound links — the official Google Maps URL scheme, which is a link anyone may make. They open OUTSIDE this
   page, in whatever maps app the phone or laptop already has, and nothing is contacted unless somebody taps one.
   Nothing on this page depends on them. */
function navUrl(ll){ return `https://www.google.com/maps/dir/?api=1&destination=${ll.lat.toFixed(6)},${ll.lon.toFixed(6)}&travelmode=driving`; }
/* v5.55 — WALKING, FOR THE LAST FIFTY METRES. Andrew Fisher, 21 Sep 2026: navigation and locations accurate to the
   point, so a person can walk to the right spot.

   Driving directions SNAP THE DESTINATION TO A ROAD. That is the right thing for a truck and the wrong thing
   for a person: a pin taken standing at a building forty metres inside a compound sends the driving route to
   the kerb on the nearest street, and whoever follows it arrives at a kerb and starts guessing. The pin was
   accurate to three metres and the navigation threw that away at the last step.

   Walking mode does not snap. It routes to the coordinate itself, down the footpath and through the gate, so
   the three metres the phone measured are the three metres you arrive within. So both are offered wherever a
   real position exists — drive to get there, walk for the last bit — and walking is never offered against a
   drawing callout, because a callout is where a label reads clearly on a sheet and walking to it precisely
   would be walking precisely to the wrong place. */
function walkUrl(ll){ return `https://www.google.com/maps/dir/?api=1&destination=${ll.lat.toFixed(6)},${ll.lon.toFixed(6)}&travelmode=walking`; }
function streetViewUrl(ll){ return `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${ll.lat.toFixed(6)},${ll.lon.toFixed(6)}`; }
/* v5.55 — THE SPOT, IN THREE DIMENSIONS, BEFORE ANYBODY HAS BEEN. Andrew Fisher, 21 Sep 2026, asked whether
   this page could reach Google Earth. It cannot — there is no Earth in here to read, and there never will be.
   What it can do is hand a person the exact spot and let Earth open on it.

   That is the better half of the bargain anyway. A description of a picture is worth very little; the picture
   itself, tilted over, at the coordinate somebody actually pinned, answers the questions a drawing cannot —
   the shape of a compound, what is overhead, whether the gate is the one you think it is.

   Camera: 250 m out and tilted 45 degrees, which is close enough to read a yard and far enough to see what is
   around it. Earth's own controls take it from there. The coordinate is the same one every other link on the
   row uses, to six decimal places — about eleven centimetres — so all of them land on the same spot. */
function earthUrl(ll){
  return `https://earth.google.com/web/@${ll.lat.toFixed(6)},${ll.lon.toFixed(6)},0a,250d,35y,0h,45t,0r`;
}
/* Directions from the depot most loads leave from, so dispatch can see the live run time in their maps app. */
// The carrier's times are LOAD times at Coates Kingston — when the truck is loaded and leaves — not arrivals on
// site (Andrew Fisher, 11 Sep 2026).
//
// What time they actually get there is a second statement of his, made the same day: by the time they reach the
// Gold Coast it is past 07:00. That is the fact this page shows. The arithmetic — load time plus a 70-minute run
// worked out from distance and speed — puts the first Monday trucks on site at 05:40, and he says that is not
// what happens; it allows nothing for loading, for the escort, or for getting a wide load into the precinct. So
// the arithmetic is kept and labelled as the earliest it could arithmetically be, and the stated fact is what a
// person reads. Where the two disagree, the man who runs the job wins.
function runMins(){ const r = (DATA.transport || {}).kingston_run; return r && r.minutes_rounded != null ? r.minutes_rounded : null; }
/* ------------------------------------------------------------------ what the run figure is made of
   Superior Audit, 15 Sep 2026, F09. The Timeline said the 70-minute figure was "distance and speed only, no
   loading, no escort, no precinct". The figure is road_km / truck_kmh * 60 + precinct_min, and precinct_min is
   ten. The page was describing an arithmetic it had not done and contradicting, three lines away, the basis
   string the pipeline had written out beside the number.

   The words are now GENERATED from the same assumptions object the minutes are, so the two cannot drift: what
   is in the figure is listed because it is in the figure, and what is not in it is listed because the
   assumptions object has no term for it. Change PLANNING in pipeline/depot.py and this sentence changes with
   the number, in the same rebuild. */
function runParts(){
  const r = (DATA.transport || {}).kingston_run || {};
  const A = r.assumptions || {};
  const inIt = [];
  if (r.road_km != null) inIt.push('about ' + Math.round(r.road_km) + ' km by road'
    + (A.road_factor ? ' (' + r.line_km + ' km straight line × ' + A.road_factor + ')' : ''));
  if (A.truck_kmh) inIt.push('at ' + A.truck_kmh + ' km/h for a truck');
  if (A.precinct_min) inIt.push(A.precinct_min + ' min for the last kilometre through the precinct');
  /* the terms the assumptions object does not carry — named, so nobody reads the figure as an arrival */
  const notIn = ['loading', 'the escort', 'waiting at the gate', 'traffic on the day'];
  return {mins: r.minutes_rounded != null ? r.minutes_rounded : null, inIt: inIt, notIn: notIn, basis: r.basis || ''};
}
function runWords(){
  const p = runParts();
  if (p.mins == null) return '';
  return p.inIt.join(', ') + '. It allows nothing for ' + p.notIn.join(', ') + ', so it is never the expected arrival.';
}
function arrivalAfter(){ const a = (DATA.transport || {}).arrival; return a && a.after ? a.after : null; }
function loadTimesLine(){
  const t = DATA.transport || {}, dep = (DATA.depot || {}).name || 'Coates Kingston', m = runMins(), a = t.arrival;
  const who = t.time_meaning ? ` (stated ${esc(t.time_meaning.stated_on)})` : '';
  return `Times are <b>load times at ${esc(dep)}</b> — the truck is loaded and leaves — not arrivals on site${who}.` +
    (a ? ` On the ground they are <b>on the Gold Coast after ${esc(a.after)}</b>, whatever the load time —
      stated ${esc(a.stated_on)} — ${esc(a.as_stated)}.` : '') +
    (m != null ? ` The ${m}-minute figure beside a load is
      <span class="chip cand" title="${esc((t.kingston_run || {}).basis || '')}">the earliest it could arithmetically be</span>
      — ${esc(runWords())}` : '');
}
function loadLi(l){
  const aft = arrivalAfter();
  const site = aft ? ` <span class="w" style="color:var(--mute)">· on the Gold Coast after <b>${esc(aft)}</b>${
      l.site_eta ? ` <span title="the earliest it could arithmetically be — load time plus the ${runMins()}-minute run: ${esc(runWords())}">(arithmetic ${esc(l.site_eta)})</span>` : ''}</span>`
    : l.site_eta ? ` <span class="w" style="color:var(--mute)">· on site from about <b>${esc(l.site_eta)}</b></span>` : '';
  /* "Early" is about the driver's start at Kingston, not about being at the gate before the site opens — those
     were the same thing while the arithmetic stood, and they are not now. */
  const early = l.early ? ` <span class="chip cand" title="loads at ${esc(l.time_24h || '')} — before 06:00 — so it is an early start for the driver and the branch. It is not early on site: ${esc(((DATA.transport || {}).arrival || {}).means || 'arrival is after the window opens')}">early load</span>` : '';
  const rec = loadOf(l), drop = loadDrop(l), id = loadId(l);
  const refs = rec.keys.length
    ? rec.keys.map(k => `<button class="linkish" data-k="${esc(k)}"><b>${esc(k)}</b></button>`).join(' ')
    : '<span class="todo" title="the carrier\'s list names the item, not the reference — pair it here">not paired</span>';
  return `<li><span class="tm" title="load time at ${esc((DATA.depot || {}).name || 'Coates Kingston')}">${esc(l.time)}</span>${esc(l.item)}${site}${early}
    <div class="loadrow">
      <span class="w" style="color:var(--mute)">carries</span> ${refs}
      ${drop.text ? `<span class="w" style="color:var(--mute)">· drops at</span> ${esc(drop.text)}` : ''}
      ${rec.card && webLink(rec.card.url) ? `<a class="chip ok" href="${esc(rec.card.url)}" target="_blank" rel="noopener" title="the card a driver opens — made ${esc(fmtStamp(rec.card.at || ''))}">drop card</a>`
        : rec.card ? `<span class="chip crit" title="the link on this load is not a web address — it came from a file and is not opened">drop card link refused</span>` : ''}
      <button class="btn tiny" data-load-pair="${esc(id)}" title="Say which references this load carries and where it drops">${rec.keys.length ? 'Change' : 'Pair it'}</button>
      ${rec.keys.length || rec.drop ? `<button class="btn tiny primary" data-load-card="${esc(id)}" title="Make the page a driver opens for this load">${rec.card ? 'Remake card' : 'Drop card'}</button>` : ''}
    </div></li>`;
}
/* Board 4, "01 / pit board": one dark board a load. The load's number on the day in racing numerals, what the
   carrier wrote and when it loads at Kingston, the references a person has paired to it as plates, the drop
   point, and the light of what is on it — labelled as separate evidence, because the carrier's list is not a
   record of arrival. Everything on it is the same record loadLi reads. */
function pitBoard(l, i){
  const rec = loadOf(l), drop = loadDrop(l), id = loadId(l), aft = arrivalAfter();
  const refs = rec.keys.map(k => { const a = assetOf(k); return `<div class="pbref"><button type="button" class="linkish plateb" data-k="${esc(k)}" aria-label="Open ${esc(k)}">${refPlate(k, 17)}</button><span class="pbname">${esc(a && a.name ? a.name : (a && (a.item_types || []).join(', ')) || k)}</span></div>`; }).join('');
  const lights = rec.keys.slice(0, 3).map(k => dstat(k, {size: 'sm', bare: true})).join('');
  return `<div class="cut dark pitboard" data-load="${esc(id)}"><span class="face">
    <div class="pbk">Dispatch<br>load line-up</div>
    <div class="pbpill"><span class="pill load">Carrier manifest</span>${l.early ? `<span class="pill gap" title="loads before 06:00 — an early start at Kingston, not an early arrival on site">early load</span>` : ''}</div>
    <div class="pbnum racenum">Load ${two(i + 1)}</div>
    <div class="pbwhat"><b class="pbtime tm">${esc(l.time)}</b> at ${esc((DATA.depot || {}).name || 'Coates Kingston')} · ${esc(l.item)}${aft ? ` · on the Gold Coast after <b>${esc(aft)}</b>` : ''}${
      l.site_eta ? ` <span class="pbar" title="the earliest it could arithmetically be — load time plus the ${runMins()}-minute run: ${esc(runWords())}">(arithmetic ${esc(l.site_eta)})</span>` : ''}${l.carrier ? ' · ' + esc(l.carrier) : ''}</div>
    <div class="pbrefs">${refs || `<div class="pbnone">Not paired to a reference yet — the carrier's list names the item, not the drop.</div>`}</div>
    ${drop.text ? `<div class="pbdrop"><span>drops at</span><b>${esc(drop.text)}</b></div>` : ''}
    <div class="pbev">${lights || dstat({key: '__none__'}, {size: 'sm', bare: true})}<span>Delivery evidence<br>separate</span></div>
    <div class="pbacts">${rec.keys.length === 1 ? navBtn(assetOf(rec.keys[0]), {small: true, quiet: true}) : ''}<button type="button" class="btn ghost" data-load-pair="${esc(id)}">${rec.keys.length ? 'Change the pairing' : 'Pair it'}</button>${
      rec.keys.length || rec.drop ? `<button type="button" class="btn primary" data-load-card="${esc(id)}">${rec.card ? 'Remake the drop card' : 'Drop card'}</button>` : ''}${
      rec.card && webLink(rec.card.url) ? `<a class="btn" href="${esc(rec.card.url)}" target="_blank" rel="noopener">View load brief <i aria-hidden="true">→</i></a>` : ''}</div>
  </span></div>`;
}
/* Pairing a load: which references are on this truck, and where it drops. Both are typed by a person — the
   carrier's list carries neither, and the carrier has asked for the drop point. */
function loadPairDialog(id){
  const l = (((DATA.transport || {}).carrier || {}).loads || []).find(x => loadId(x) === id);
  if (!l) return;
  const rec = loadOf(id), due = programmeDays().find(d => d.iso === l.date);
  const onDay = due ? due.deliveries.map(r => r.a) : [];
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
  d.setAttribute('aria-label', 'Pair carrier load ' + l.n);
  d.innerHTML = `
   <div class="dh"><div><h2>Load ${esc(l.n)} — ${esc(fmtDate(l.date))}</h2>
     <div class="sub">${esc(l.item)} · loads ${esc(l.time_24h || '')} at ${esc((DATA.depot || {}).name || 'Kingston')}${arrivalAfter() ? ' · on the Gold Coast after ' + esc(arrivalAfter()) : l.site_eta ? ' · on site about ' + esc(l.site_eta) : ''}</div></div>
     <button class="btn" id="lpClose" aria-label="Close">Close</button></div>
   <div class="db">
     <div class="notice info"><b>The carrier's list does not say what is on the truck.</b> It names the item and the load
       time only, so the reference and the drop point are recorded here, by you. The carrier has asked for a drop point
       per load — this is where that is written down.</div>
     <div class="form">
       <div class="f"><label for="lpKeys">References on this load</label>
         <input id="lpKeys" value="${esc(rec.keys.join(', '))}" placeholder="P01, P03 — comma separated">
         <div class="hint">${onDay.length ? 'Due in on this day: ' + onDay.slice(0, 12).map(a => esc(a.key)).join(', ') + (onDay.length > 12 ? '…' : '') : 'Nothing is scheduled in on this day under a reference.'}</div></div>
       ${onDay.length ? `<div class="filters" id="lpPick">${onDay.map(a => `<button data-pick="${esc(a.key)}" aria-pressed="${rec.keys.includes(a.key)}" title="${esc((a.item_types || []).join(', ') || a.product || '')}">${esc(a.key)}</button>`).join('')}</div>` : ''}
       <div class="f"><label for="lpDrop">Where it drops</label>
         <input id="lpDrop" value="${esc(rec.drop || '')}" maxlength="200" placeholder="Gate 2, east of the ECC — plain words a driver can follow">
         <div class="hint">${(() => { const dd = loadDrop(id); return dd.text && !rec.drop ? 'Leave blank to use ' + esc(dd.text) + ' (' + esc(dd.basis || '') + ')' : 'Leave blank to use the drawing callout of the first reference.'; })()}</div></div>
     </div>
     ${rec.by ? `<p class="norate">Last set by ${esc(rec.by)} ${esc(fmtStamp(rec.at || ''))} ${rec.where === 'committed' ? '(committed)' : '(' + esc(LW()) + ')'}.</p>` : ''}
   </div>
   <div class="df"><button class="btn primary" id="lpSave">Save the pairing</button>
     <button class="btn" id="lpClear">Unpair</button></div>`;
  const scrim = document.createElement('div'); scrim.className = 'scrim on'; scrim.style.zIndex = 29;
  const shut = () => { d.remove(); scrim.remove(); bump(); };
  document.body.appendChild(scrim); document.body.appendChild(d);
  scrim.onclick = shut; d.querySelector('#lpClose').onclick = shut;
  d.querySelectorAll('[data-pick]').forEach(b => b.onclick = () => {
    const box = d.querySelector('#lpKeys');
    const now = box.value.split(',').map(s => s.trim().toUpperCase()).filter(Boolean);
    const k = b.dataset.pick;
    const next = now.includes(k) ? now.filter(x => x !== k) : now.concat([k]);
    box.value = next.join(', ');
    b.setAttribute('aria-pressed', String(next.includes(k)));
  });
  d.querySelector('#lpSave').onclick = () => {
    const keys = d.querySelector('#lpKeys').value.split(',').map(s => s.trim()).filter(Boolean);
    const bad = keys.filter(k => !isRef(k.toUpperCase()));
    if (bad.length) { flash(bad.join(', ') + (bad.length === 1 ? ' is not a reference' : ' are not references') + ' in this file — nothing saved.'); return; }
    if (setLoadKeys(id, keys) !== false) { setLoadDrop(id, d.querySelector('#lpDrop').value); flash('Load ' + l.n + ' paired to ' + (keys.length ? keys.join(', ') : 'nothing') + '.'); shut(); }
  };
  d.querySelector('#lpClear').onclick = () => { if (setLoadKeys(id, []) !== false) { setLoadDrop(id, ''); flash('Load ' + l.n + ' unpaired.'); shut(); } };
}
/* Make the card and put it on the service. In a file edition there is no service, so the card opens in a window
   to be read or printed — the same page, without a link to send. */
async function makeDropCard(id){
  const l = (((DATA.transport || {}).carrier || {}).loads || []).find(x => loadId(x) === id);
  if (!l) return;
  if (!whoAmI()) return;
  const rec = loadOf(id);
  if (!rec.keys.length && !rec.drop) { flash('Pair the load first — a card with no drop point is no use to a driver.'); return; }
  flash('Making the card…');
  let html;
  try { html = await cardHtmlFor(l); }
  catch (e) { flash('Could not build the card: ' + (e.message || e)); return; }
  const lead = (TEAM.people || []).find(p => p.lead) || null;
  const expires = addDays(l.date, 1);
  if (!SYNC.backend || !SYNC.backend.makeCard) {
    const w = window.open('', '_blank');
    if (w) { w.document.write(html); w.document.close(); flash('This file has no service behind it, so the card opened in a window — print it, or use the hosted link to make one you can send.'); }
    else flash('The card could not open — allow pop-ups, or use the hosted link.');
    return;
  }
  try {
    const r = await SYNC.backend.makeCard({
      token: rec.card && rec.card.token, load: loadId(l), run_date: l.date, expires,
      title: 'Load ' + l.n + ' · ' + (rec.keys.join(', ') || l.item),
      /* v5.56 — the references on this load travel with the card, so a report that comes back off it says
         which things on the job it is about rather than just which load */
      keys: rec.keys,
      contact: lead ? {name: lead.name, phone: lead.mobile || ''} : null,
      html,
    });
    S.loads = S.loads || {};
    const keep = S.loads[id] || (S.loads[id] = {keys: rec.keys, drop: rec.drop});
    keep.card = {token: r.token, url: location.origin + r.url, at: new Date().toISOString(), by: S.operator || null, expires};
    stampIt('loads', id); save(); bump();
    cardMadeDialog(l, keep.card, expires);
  } catch (e) { flash(String(e.message || e)); }
}
/* ------------------------------------------------------------------ sending a text
   A drop card is only any use if the driver has the link in his hand at four in the morning. This is how it gets
   there, and it is deliberately three decisions in a row — who, what, and then a second press — because a text is
   the one thing in this package that reaches somebody in the dark and cannot be taken back.

   Nothing here holds a key. The page asks the service to send; the service holds Andrew Fisher's ClickSend
   details as Railway variables and counts the day against its cap. A view link cannot send at all. */
const SMS_GSM = '@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞÆæßÉ !"#¤%&\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà';
const SMS_EXT = '\f^{}\\[~]|€';
/* The same arithmetic the service does, so the count under the box is the count that gets charged. One curly
   quote or one em dash tips the whole message into the 70-character alphabet — which is how a 120-character
   message quietly becomes two. */
function smsShape(text){
  const s = String(text == null ? '' : text);
  let units = 0, plain = true; const odd = [];
  for (const ch of s) {
    if (SMS_GSM.indexOf(ch) >= 0) units += 1;
    else if (SMS_EXT.indexOf(ch) >= 0) units += 2;
    else { plain = false; if (odd.indexOf(ch) < 0 && odd.length < 8) odd.push(ch); }
  }
  if (!plain) return {encoding: 'UCS-2', units: s.length, parts: s.length <= 70 ? 1 : Math.ceil(s.length / 67), not_plain: odd};
  return {encoding: 'GSM-7', units, parts: units <= 160 ? 1 : Math.ceil(units / 153), not_plain: []};
}
function smsPlain(text){          // the same words, written so they fit the 160-character alphabet
  return String(text).replace(/[‘’‛]/g, "'").replace(/[“”]/g, '"')
    .replace(/[–—]/g, '-').replace(/…/g, '...').replace(/ /g, ' ').replace(/[•·]/g, '-');
}
function smsLooksMobile(n){ const d = String(n || '').replace(/[^\d+]/g, ''); return /^(\+?61|0)?4\d{8}$/.test(d); }
/* Numbers already on this job — the team as the build received it. Nothing is scraped from anywhere else, and a
   number typed into the box is used for that send and recorded with it, not added to a list. */
function smsJobNumbers(){
  return (TEAM.people || []).filter(p => smsLooksMobile(p.mobile || p.phone))
    .map(p => ({name: p.name, role: p.event_role || '', number: p.mobile || p.phone}));
}
function smsCan(){ return !!(SYNC.backend && SYNC.backend.sendSms && !SYNC.readonly); }

/* The panel itself. Handed a container and the words to start with. */
function smsPanel(root, text){
  const can = smsCan();
  const people = smsJobNumbers();
  root.innerHTML = `
   <div class="card">
     <h4 style="margin:0 0 6px;font-size:14px">${can ? 'Send it as a text' : 'Send it as a text yourself'}</h4>
     ${can ? `<div class="smswho">${people.map((p, i) => `<button class="chip" type="button" data-smsnum="${esc(p.number)}"
        aria-pressed="false" title="${esc(p.role)}">${esc(p.name.split(' ')[0])} · ${esc(p.number)}</button>`).join('')}</div>
     <div class="f"><label for="smsTo">Numbers — a mobile each, commas between</label>
       <input id="smsTo" inputmode="tel" placeholder="0412 345 678, 0413 000 111"></div>` : ''}
     <div class="f"><label for="smsMsg">The message</label>
       <textarea id="smsMsg" rows="4"></textarea>
       <div class="hint" id="smsCount"></div></div>
     <div class="acts">
       ${can ? `<button class="btn primary" id="smsSend">Send</button>` : ''}
       <button class="btn" id="smsCopy">Copy the message</button>
       <a class="btn" id="smsOwn" href="#">Open it in my own Messages</a>
     </div>
     <div class="hint" id="smsState">${can ? 'Checking the service…' : 'This file has no service behind it, so the message is copied for you to send from your own phone.'}</div>
     <div id="smsOut"></div>
   </div>`;
  const box = root.querySelector('#smsMsg');
  box.value = text;
  const count = root.querySelector('#smsCount');
  const own = root.querySelector('#smsOwn');
  const redraw = () => {
    const sh = smsShape(box.value);
    const to = can ? smsRead(root.querySelector('#smsTo').value).good.length : 0;
    count.innerHTML = `${sh.units} characters · <b>${sh.parts} text${sh.parts === 1 ? '' : 's'}</b> each`
      + (can && to ? ` · ${to} number${to === 1 ? '' : 's'} = ${to * sh.parts} message${to * sh.parts === 1 ? '' : 's'}` : '')
      + (sh.not_plain.length ? ` · <span class="warn">${esc(sh.not_plain.join(' '))} ${sh.not_plain.length === 1 ? 'is not' : 'are not'} in the plain alphabet,
          so every text is 70 characters instead of 160 — <button class="btn tiny" type="button" id="smsFix">write it plainly</button></span>` : '');
    own.href = 'sms:?&body=' + encodeURIComponent(box.value);
    const fix = root.querySelector('#smsFix');
    if (fix) fix.onclick = () => { box.value = smsPlain(box.value); redraw(); };
  };
  box.oninput = redraw;
  root.querySelector('#smsCopy').onclick = e => {
    const done = () => { e.target.textContent = 'Copied'; };
    if (navigator.clipboard) navigator.clipboard.writeText(box.value).then(done, done); else done();
  };
  if (!can) { redraw(); return; }

  const toBox = root.querySelector('#smsTo');
  toBox.oninput = redraw;
  root.querySelectorAll('[data-smsnum]').forEach(b => b.onclick = () => {
    const now = toBox.value.split(',').map(s => s.trim()).filter(Boolean);
    const n = b.dataset.smsnum;
    const has = now.some(x => x.replace(/\D/g, '') === n.replace(/\D/g, ''));
    toBox.value = (has ? now.filter(x => x.replace(/\D/g, '') !== n.replace(/\D/g, '')) : now.concat([n])).join(', ');
    b.setAttribute('aria-pressed', String(!has));
    redraw();
  });

  const state = root.querySelector('#smsState');
  const send = root.querySelector('#smsSend');
  let left = null;
  SYNC.backend.sms(6).then(info => {
    if (!info.configured) {
      left = 0; send.disabled = true;
      state.innerHTML = '<span class="warn">Texting is not switched on for this service yet.</span> The message can still be copied or sent from your own phone.';
      return;
    }
    left = info.today.left;
    state.innerHTML = `${info.today.left} of today's ${info.today.cap} left`
      + (info.from ? ` · they arrive from <b>${esc(info.from)}</b>` : ' · they arrive from a ClickSend number, so a reply will not reach you — put a number to ring in the words')
      + (info.sent.length ? ` · <button class="btn tiny" type="button" id="smsSeen">the last ${info.sent.length}</button>` : '');
    const seen = root.querySelector('#smsSeen');
    if (seen) seen.onclick = () => {
      seen.remove();
      root.querySelector('#smsOut').innerHTML = '<ul class="smslog">' + info.sent.map(m =>
        `<li><b>${esc(m.to)}</b> · ${esc(fmtStamp(m.at))} · ${esc(String(m.status || '').toLowerCase())}${m.by ? ' · ' + esc(m.by) : ''}<br><span class="meta">${esc(m.text)}</span></li>`).join('') + '</ul>';
    };
  }).catch(e => { state.innerHTML = '<span class="warn">' + esc(String(e.message || e)) + '</span>'; send.disabled = true; });

  send.onclick = async () => {
    const read = smsRead(toBox.value);
    if (read.bad.length) { flash(read.bad.join(', ') + (read.bad.length === 1 ? ' is not a mobile number' : ' are not mobile numbers') + ' — nothing sent.'); return; }
    if (!read.good.length) { flash('No numbers — nothing sent.'); return; }
    if (!box.value.trim()) { flash('No message — nothing sent.'); return; }
    const sh = smsShape(box.value);
    const n = read.good.length * sh.parts;
    if (send.dataset.sure !== '1') {
      send.dataset.sure = '1';
      send.textContent = `Press again to send ${n} message${n === 1 ? '' : 's'} to ${read.good.length} number${read.good.length === 1 ? '' : 's'}`;
      setTimeout(() => { if (send.dataset.sure === '1') { send.dataset.sure = ''; send.textContent = 'Send'; } }, 8000);
      return;
    }
    send.dataset.sure = ''; send.disabled = true; send.textContent = 'Sending…';
    try {
      const r = await SYNC.backend.sendSms({to: read.good, text: box.value});
      const went = (r.messages || []).filter(m => String(m.status || '').toUpperCase().indexOf('SUCCESS') >= 0);
      root.querySelector('#smsOut').innerHTML = '<ul class="smslog">' + (r.messages || []).map(m =>
        `<li><b>${esc(m.to)}</b> · ${String(m.status || '').toUpperCase().indexOf('SUCCESS') >= 0 ? 'sent' : esc(String(m.status || 'not sent').toLowerCase())}${m.why ? ' — ' + esc(m.why) : ''}</li>`).join('') + '</ul>';
      state.innerHTML = `${went.length} of ${(r.messages || []).length} sent · ${r.today.left} of today's ${r.today.cap} left`;
      flash(r.error ? r.error : went.length + ' text' + (went.length === 1 ? '' : 's') + ' sent.');
    } catch (e) { flash(String(e.message || e)); }
    send.disabled = false; send.textContent = 'Send';
  };
  redraw();
}
/* numbers as they are actually written down, split into the ones that read and the ones that do not */
function smsRead(s){
  const good = [], bad = [];
  String(s || '').split(/[,;\n]/).map(x => x.trim()).filter(Boolean).forEach(x => {
    const d = x.replace(/[^\d+]/g, '');
    if (smsLooksMobile(d) || /^\+[1-9]\d{7,14}$/.test(d)) { if (good.indexOf(x) < 0) good.push(x); } else bad.push(x);
  });
  return {good, bad};
}

/* ONE RULE FOR EVERY CODE ON THIS PAGE.

   V11 audit: three codes were built here, each with `margin: 2`, and qrcode-generator's margin is in the SAME
   PIXELS as cellSize — not in modules. So the drop card (cellSize 4) carried half a module of quiet zone and
   the navigation and documents codes (cellSize 3) carried two thirds of one. ISO/IEC 18004 asks for four
   modules of clear space on all four sides, and a phone camera reading a code off a printed page in a truck
   at night is exactly the case that needs it: less quiet zone is how a code that scans on a screen fails on
   paper. The margin is derived from the cell so the two can never drift apart again, and `scalable` keeps the
   output vector, so the code is drawn at the printer's resolution rather than upscaled from a bitmap. */
const QR_QUIET_MODULES = 4;
function qrSvg(text, cell){
  if (typeof qrcode !== 'function' || !text) return '';
  const c = cell || 3;
  try {
    const q = qrcode(0, 'M'); q.addData(String(text)); q.make();
    return q.createSvgTag({cellSize: c, margin: c * QR_QUIET_MODULES, scalable: true});
  } catch (e) { return ''; }
}

/* what to do with the link once it exists: send it, copy it, or hold a phone up to it */
function cardMadeDialog(l, card, expires){
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
  d.setAttribute('aria-label', 'Drop card for load ' + l.n);
  const qr = qrSvg(card.url, 4);
  const body = `GC500 load ${l.n} - ${fmtDay(l.date).dow} ${fmtDay(l.date).dm}, load Kingston ${l.time_24h || ''}. ${loadDrop(l).text || 'Drop point on the card'}. Details and nav: ${card.url}`;
  d.innerHTML = `
   <div class="dh"><div><h2>Drop card — load ${esc(l.n)}</h2><div class="sub">${esc(fmtDate(l.date))} · expires ${esc(fmtDate(expires))}</div></div>
     <button class="btn" id="cmClose" aria-label="Close">Close</button></div>
   <div class="db">
     <div class="notice info"><b>This link opens one load and nothing else.</b> It is not the view link: it holds this
       load's drop point, the site rules and one telephone number, and it stops working the day after the run.</div>
     <div class="f"><label for="cmUrl">The link</label><input id="cmUrl" readonly value="${esc(card.url)}"></div>
     <div class="acts" style="margin-bottom:12px">
       <button class="btn primary" id="cmCopy">Copy the link</button>
       <a class="btn" href="${esc(card.url)}" target="_blank" rel="noopener">Open it as a driver would</a>
     </div>
     ${qr ? `<div class="card" style="text-align:center"><div style="max-width:220px;margin:0 auto">${qr}</div>
       <p class="norate">Hold a driver's phone to this, or print it onto the paperwork.</p></div>` : ''}
     <div id="cmSms"></div>
     <p class="norate">Nothing sends on its own. A text leaves when you press Send, to the numbers in the box, with
       those words in front of you — and every one is on the record with the time, the number and what it cost.</p>
   </div>
   <div class="df"><button class="btn" id="cmWithdraw">Withdraw this card</button></div>`;
  const scrim = document.createElement('div'); scrim.className = 'scrim on'; scrim.style.zIndex = 29;
  const shut = () => { d.remove(); scrim.remove(); bump(); };
  document.body.appendChild(scrim); document.body.appendChild(d);
  scrim.onclick = shut; d.querySelector('#cmClose').onclick = shut;
  const copy = (text, btn, word) => { const done = () => { btn.textContent = word; setTimeout(() => bump(), 10); };
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, done); else done(); };
  d.querySelector('#cmCopy').onclick = e => copy(card.url, e.target, 'Copied');
  smsPanel(d.querySelector('#cmSms'), smsPlain(body));
  d.querySelector('#cmWithdraw').onclick = async e => {
    if (e.target.dataset.sure !== '1') { e.target.dataset.sure = '1'; e.target.textContent = 'Press again to withdraw'; return; }
    try { await SYNC.backend.withdrawCard(card.token);
      const id = loadId(l); if (S.loads[id]) { delete S.loads[id].card; stampIt('loads', id); save(); }
      flash('The card is withdrawn — that link now shows a number to ring.'); shut();
    } catch (err) { flash(String(err.message || err)); }
  };
}

/* ------------------------------------------------------------------ the carrier's loads, and a driver's card
   The carrier's list (Brendan Gill, 11 Sep 2026) is 22 loads with a day, an item and a load time at Kingston —
   no driver, no contact, and no reference saying which building is on which truck. The carrier has asked for a
   drop point per load. Pairing a load to the references it carries is therefore a record a person makes here,
   like a light: it carries their name, and until it is made the load has nowhere to go and says so.

   A drop card is one load's page, made from that pairing and handed to a driver. It is deliberately not the view
   link: it holds one load, it expires, and it carries one telephone number. */
function loadId(l){ return l.date + '#' + l.n; }
function loadOf(l){
  const id = typeof l === 'string' ? l : loadId(l);
  const loc = (S.loads || {})[id] || null;
  const com = ((COMMITTED.loads || {})[id]) || null;
  const src = loc || com;
  return {keys: (src && src.keys) || [], drop: (src && src.drop) || '', by: src && src.by, at: src && src.at,
          where: loc ? 'local' : com ? 'committed' : null, card: (src && src.card) || null};
}
function loadAssets(l){
  const keys = loadOf(l).keys;
  return keys.map(k => allAssets().find(a => a.key === k)).filter(Boolean);
}
/* pair a load to the references it carries; an empty list unpairs it */
function setLoadKeys(l, keys){
  if (!mayWrite('the load pairing')) return false;
  const id = typeof l === 'string' ? l : loadId(l);
  const who = whoAmI(); if (!who) return false;
  const clean = [...new Set((keys || []).map(k => String(k).trim().toUpperCase()).filter(isRef))];
  S.loads = S.loads || {};
  const rec = S.loads[id] || (S.loads[id] = {});
  rec.keys = clean; rec.by = who; rec.at = new Date().toISOString();
  if (!rec.keys.length && !rec.drop && !rec.card) delete S.loads[id];
  stampIt('loads', id); save();
  return true;
}
function setLoadDrop(l, text){
  if (!mayWrite('the drop point')) return false;
  const id = typeof l === 'string' ? l : loadId(l);
  const who = whoAmI(); if (!who) return false;
  S.loads = S.loads || {};
  const rec = S.loads[id] || (S.loads[id] = {});
  const v = String(text || '').trim().slice(0, 200);
  if (v) rec.drop = v; else delete rec.drop;
  rec.by = who; rec.at = new Date().toISOString();
  if (!(rec.keys || []).length && !rec.drop && !rec.card) delete S.loads[id];
  stampIt('loads', id); save();
  return true;
}
/* where this load is going, in the words the card will use: the pairing's own text first, then the drawing
   callout of the first reference, then nothing — and nothing is said as nothing, not as "the circuit" */
function loadDrop(l){
  const rec = loadOf(l), as = loadAssets(l);
  if (rec.drop) return {text: rec.drop, basis: 'typed against this load by ' + (rec.by || 'somebody'), pt: as.length ? aerialPointFor(as[0]) : null};
  const a = as[0], link = a ? (a.drawing_links || [])[0] : null;
  if (a && link) return {text: (a.name ? a.name + ' — ' : '') + 'callout ' + link.label + ' on ' + link.sheet,
                         basis: 'the drawing callout for ' + a.key + ' — a drawing position, not a survey', pt: aerialPointFor(a)};
  if (a) return {text: a.name || a.key, basis: 'the reference this load is paired to; no drawing callout for it', pt: null};
  return {text: null, basis: null, pt: null};
}
/* the aerial around a point, as a picture the card can carry on its own */
function cropDataUrl(pt, f, outW){
  return new Promise((resolve, reject) => {
    if (!pt || !DATA.aerial_hi) return resolve(null);
    const src = new Image();
    src.onerror = () => reject(new Error('The location picture could not load. Retry when your connection is available.'));
    src.onload = () => {
      try {
        const W = src.naturalWidth, H = src.naturalHeight;
        const winW = W * f, winH = winW * 0.62;
        let x0 = pt.ax * W - winW / 2, y0 = pt.ay * H - winH / 2;
        x0 = Math.max(0, Math.min(W - winW, x0)); y0 = Math.max(0, Math.min(H - winH, y0));
        const w = Math.min(outW || 900, Math.round(winW)), h = Math.round(w * (winH / winW));
        const c = document.createElement('canvas'); c.width = w; c.height = h;
        const g = c.getContext('2d');
        g.drawImage(src, x0, y0, winW, winH, 0, 0, w, h);
        /* the cross goes on the picture itself — the card carries no script to place one */
        const cx = (pt.ax * W - x0) / winW * w, cy = (pt.ay * H - y0) / winH * h;
        g.strokeStyle = '#ff6a13'; g.lineWidth = Math.max(3, w / 220); g.beginPath();
        g.arc(cx, cy, Math.max(14, w / 42), 0, Math.PI * 2); g.stroke();
        g.beginPath(); g.moveTo(cx - w / 28, cy); g.lineTo(cx + w / 28, cy);
        g.moveTo(cx, cy - w / 28); g.lineTo(cx, cy + w / 28); g.stroke();
        resolve(c.toDataURL('image/jpeg', 0.78));
      } catch (e) { reject(e); }
    };
    src.src = DATA.aerial_hi;
  });
}
/* The callout on iEDM's drawing, cut to a picture that can travel — the same window the printed sheet shows,
   with the same ring drawn round the bubble rather than across it. */
function sheetDataUrl(a, outW, ratio){
  return new Promise((resolve, reject) => {
    const link = (a.drawing_links || [])[0], sh = mapSheetFor(a);
    const mk = sh ? ((sh.markers || []).find(m => (m.keys || []).includes(a.key))
                  || (sh.markers || []).find(m => link && String(m.label) === String(link.label))) : null;
    if (!mk || !sh || !sh.src || !Number.isFinite(mk.fx) || !Number.isFinite(mk.fy)) return resolve(null);
    const R = ratio || 0.62;
    sheetSrc(sh.key).then(src => {
      try {
        const W = src.naturalWidth, H = src.naturalHeight;
        const winW = Math.min(W, W * SHEET_F), winH = Math.min(H, winW * R);
        const x0 = Math.max(0, Math.min(W - winW, mk.fx * W - winW / 2));
        const y0 = Math.max(0, Math.min(H - winH, mk.fy * H - winH / 2));
        const w = Math.min(outW || 900, Math.round(winW)), h = Math.round(w * (winH / winW));
        const c = document.createElement('canvas'); c.width = w; c.height = h;
        const g = c.getContext('2d');
        g.drawImage(src, x0, y0, winW, winH, 0, 0, w, h);
        const cx = (mk.fx * W - x0) / winW * w, cy = (mk.fy * H - y0) / winH * h;
        /* round the bubble, never across it — the same rule the printed sheet follows */
        const bub = Number(mk.bub) > 0 ? (w * (Number(mk.bub) / SHEET_F)) : (w / 14);
        g.strokeStyle = '#ff6a13'; g.lineWidth = Math.max(3, bub * 0.085);
        g.beginPath(); g.arc(cx, cy, bub * 0.75, 0, Math.PI * 2); g.stroke();
        resolve(c.toDataURL('image/jpeg', 0.8));
      } catch (e) { reject(e); }
    }, reject);
  });
}
/* The four pictures the drop sheet prints, as pictures that can be sent. Same windows, same order, same rings —
   whatever a person is handed, on paper or in a message, is the same four views of the same spot. */
function dropPics(a){
  const pt = aerialPointFor(a);
  /* Sized for a message, not for paper. The pictures show at 560 px wide in a mail client, so 820 is already
     more than any screen will use — and an email nobody can download on a patchy site is an email nobody reads.
     The printed sheet cuts its own, larger, from the same windows. */
  return Promise.all([
    pt ? cropDataUrl(pt, SITE_F, 820) : Promise.resolve(null),
    sheetDataUrl(a, 820),
    pt ? cropDataUrl(pt, WIDE_F, 780) : Promise.resolve(null),
    pt ? cropDataUrl(pt, CLOSE_F, 780) : Promise.resolve(null),
  ]).then(([site, sheet, wide, close]) => ({site, sheet, wide, close,
    list: [[site, 'The whole site — which end you are going to'],
           [sheet, 'On the drawing' + ((a.drawing_links || [])[0] ? ' — callout ' + ((a.drawing_links || [])[0].label) : '')],
           [wide, 'Wide — orient from the gate'],
           /* F05: the planned area, not a verified position — the email and the driver card say it too */
           [close, 'Close — the planned area; confirm the exact position']].filter(x => x[0])}));
}
const cardEsc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
/* The card a driver opens. A page of its own: no script (the service serves it under a policy that forbids one),
   no link back into the app, no telephone number but the one, and every uncertain thing labelled. */
async function cardHtmlFor(l){
  const as = loadAssets(l), drop = loadDrop(l), rec = loadOf(l);
  const site = DATA.site || {}, acc = DATA.access || {}, rules = DATA.driver_rules || {};
  const gate = heavyGate();
  const lead = (TEAM.people || []).find(p => p.lead) || null;
  /* v5.51 — the card navigates to the pinned spot when the load's drop has one (the reference's own pin, else
     a building's); the picture and the satnav line still show the drawing's area, labelled as such */
  const pinT = (as.length === 1 ? navTargetFor(as[0]) : null);
  const ll = pinT && pinT.pinned ? pinT.ll : (drop.pt ? lonLatOf(drop.pt.ax, drop.pt.ay) : null);
  const pic = await cropDataUrl(drop.pt, 0.16, 900);
  const eta = l.site_eta || null;
  const what = as.length
    ? as.map(a => { const rows = itemRows(a);
        const qty = rows.length ? rows.map(r => r.qty_asked != null ? r.qty_asked : 'not written').join(' + ') : null;
        return `${a.key}${a.name ? ' — ' + a.name : ''} · ${(a.item_types || []).join(', ') || a.product || a.discipline}`
             + (qty ? ' · qty ' + qty : ''); })
    : [l.item + (l.product && l.product !== l.item ? ' (' + l.product + ')' : '')];
  const docs = transportDocs().map(d => (d.doc_ref || d.title || '').split(' · ')[0]);
  const speed = (acc.general_notes || []).filter(n => /SPEED|km\/h/i.test(n)).map(n => String(n).replace(/^\d+\.\s*/, ''));
  const tel = lead && lead.mobile ? String(lead.mobile).replace(/[^0-9+]/g, '') : '';
  return `<!doctype html><html lang="en-AU"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GC500 drop card — load ${cardEsc(l.n)}</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#12100e;color:#f7f4f1;font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.w{max-width:680px;margin:0 auto;padding:0 16px 34px}
header{background:#1b1815;border-bottom:3px solid #ff6a13;padding:14px 16px;margin-bottom:16px}
header b{display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#ff9a4d}
header span{display:block;font-size:13px;color:#c9c2bb;margin-top:2px}
h1{font-size:26px;line-height:1.15;margin:0 0 4px}
.sub{color:#c9c2bb;font-size:14px;margin:0 0 16px}
.box{background:#1b1815;border:1px solid #3a332d;border-radius:10px;padding:12px 14px;margin:0 0 12px}
.box h2{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#ff9a4d;margin:0 0 6px}
.big{font-size:20px;font-weight:700;margin:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media (max-width:420px){.grid{grid-template-columns:1fr}}
ul{margin:6px 0 0;padding-left:20px} li{margin:0 0 3px}
img{display:block;width:100%;border-radius:8px;border:1px solid #3a332d;margin-top:8px}
a.btn{display:block;text-align:center;background:#ff6a13;color:#12100e;font-weight:800;text-decoration:none;
  padding:16px;border-radius:10px;margin:12px 0;font-size:18px}
a.call{background:#f7f4f1;color:#12100e}
.warn{border-color:#ff6a13;background:#2a1a0e}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.fine{color:#9c938b;font-size:12.5px;line-height:1.45;margin:14px 0 0}
/* v5.56 — the part of the card the person on the ground fills in. Big targets, high contrast, one column:
   it is answered standing beside a building in the dark with gloves on. */
.rep{border-color:#5c4a36;background:#1f1a14}
.q{border:1px solid #3a332d;border-radius:8px;padding:10px 12px;margin:0 0 10px}
.q legend{font-size:13px;font-weight:700;color:#f7f4f1;padding:0 6px}
.opt{display:block;padding:11px 4px;font-size:16px;border-bottom:1px solid #2b2521;cursor:pointer}
.opt:last-of-type{border-bottom:0}
.opt input{width:22px;height:22px;vertical-align:-5px;margin-right:8px;accent-color:#ff6a13}
.clr{background:none;border:0;color:#9c938b;font-size:12.5px;text-decoration:underline;padding:6px 0;cursor:pointer}
.fld{display:block;margin:0 0 10px}
.fld span{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#ff9a4d;margin:0 0 4px}
.fld input,.fld textarea{width:100%;font:inherit;padding:11px 12px;border-radius:8px;border:1px solid #3a332d;
  background:#12100e;color:#f7f4f1}
input[type=file]{width:100%;font:inherit;color:#c9c2bb;margin-top:6px}
.act{display:block;width:100%;text-align:center;background:#2b2521;color:#f7f4f1;border:1px solid #5c4a36;
  font:inherit;font-weight:700;padding:14px;border-radius:10px;margin:8px 0;cursor:pointer}
.act.send{background:#ff6a13;color:#12100e;border-color:#ff6a13;font-size:18px;font-weight:800;margin-top:14px}
.act[disabled]{opacity:.55}
.warnt{color:#ffb37a;font-weight:700}
.okt{color:#8fd694;font-weight:700}
details summary{cursor:pointer;padding:6px 0}
</style></head><body>
<header><b>Coates Industrial Solutions · GC500</b><span>${cardEsc(DATA.event.name)} · ${cardEsc(DATA.event.race_dates_as_supplied)}</span></header>
<div class="w">
  <h1>Load ${cardEsc(l.n)} — ${cardEsc(fmtDate(l.date))}</h1>
  <p class="sub">Drop card for the driver. Keep it on your phone until the load is down.</p>

  <div class="box"><h2>What is on the truck</h2>
    <ul>${what.map(x => '<li>' + cardEsc(x) + '</li>').join('')}</ul>
    ${as.length ? '' : '<p class="fine">The carrier\'s list names the item, not the reference. Confirm what you have with the yard before you leave.</p>'}
  </div>

  <div class="grid">
    <div class="box"><h2>Load at ${cardEsc((DATA.depot || {}).name || 'Coates Kingston')}</h2><p class="big">${cardEsc(l.time_24h || l.time || '')}</p>
      <p class="fine">${cardEsc((DATA.depot || {}).address || '')}</p></div>
    <div class="box"><h2>On site about</h2><p class="big">${cardEsc(eta || '—')}</p>
      <p class="fine">${eta ? 'A planning figure — the load time plus the run from Kingston, not a booked slot.' : 'No planning time for this load.'}</p></div>
  </div>

  <div class="box"><h2>Where it goes</h2>
    <p class="big">${drop.text ? cardEsc(drop.text) : 'Not confirmed'}</p>
    <p class="fine">${drop.basis ? cardEsc(drop.basis) + '. ' : 'Nobody has set a drop point for this load yet. '}Do not set down until the site supervisor confirms the spot.</p>
    ${pic ? `<img src="${pic}" alt="The drop area on the site photograph, marked with a cross">` : ''}
    ${ll ? `<p class="fine">Satnav: <b class="mono">${cardEsc(ll.text)}</b> — the drawing's spot for this reference, good to within a metre or so. It is a drawing position, not a surveyed one: drive to it, then take the spot from the supervisor.</p>` : ''}
  </div>
  ${ll ? `<a class="btn" href="${cardEsc(navUrl(ll))}">${pinT && pinT.pinned ? 'Navigate to the pinned spot' : 'Navigate to the drop area'}</a>` : ''}

  <div class="box warn"><h2>Before you drive in</h2>
    <ul>
      ${rules.escort ? '<li><b>' + cardEsc(rules.escort) + '</b> Stop at the entry and wait for your escort.</li>' : ''}
      ${gate ? '<li>Enter at the heavy-vehicle gate: ' + cardEsc(gate.text.replace(/ · /g, ' — ')) + '.</li>' : ''}
      ${(rules.ppe || []).length ? '<li>PPE on site: ' + cardEsc(rules.ppe.join(', ')) + '.</li>' : ''}
      ${speed.length ? '<li>' + cardEsc(speed.join(' ')) + ' Follow the traffic controllers.</li>' : ''}
      <li>Site hours ${cardEsc(site.hours || '')} ${cardEsc(site.hours_days || '')}${site.hours_qualifier ? ' — ' + cardEsc(String(site.hours_qualifier).replace(/\.$/, '')) : ''}.</li>
    </ul>
  </div>

  ${tel ? `<a class="btn call" href="tel:${cardEsc(tel)}">Call ${cardEsc(lead.name)} — ${cardEsc(lead.mobile)}</a>` : ''}
  <p class="fine">One number on this card on purpose. Ring it for anything about this load.</p>

  ${docs.length ? `<div class="box"><h2>Paperwork for moving a building</h2>
    <ul>${docs.map(d => '<li>' + cardEsc(d) + '</li>').join('')}</ul>
    <p class="fine">Your own copies — this card does not carry the documents.</p></div>` : ''}

  ${cardReportSection(as)}

  <p class="fine">Made ${cardEsc(fmtDate(todayIso()))} from the Coates GC500 delivery record. The photograph is a
  registered aerial with the drop area marked; it is not a survey and the cross is a drawing position. Site rules are
  iEDM's, as issued in the induction. If this link has stopped working, ring the number above.</p>
</div>
<${'scr' + 'ipt'}>${cardReportScript()}<${'/scr' + 'ipt'}>
</body></html>`;
}
/* ------------------------------------------------------------------ v5.56 — WHAT CAME BACK OFF THE CARDS
   The other half of the two-way card. A report is somebody on the ground saying what they did, with the name
   they typed on it. It is NEVER a Coates record, and this page never quietly turns one into the other:

   · reports live in their own place (REPORTS), not in the record (S). Nothing here writes to S at all.
   · every one is shown as reported, with the name given, the time, and the words "nobody has checked this".
   · a light on the register stays exactly where a person at Coates set it. A report sits BESIDE it and says
     what the driver said, so an editor sees both and decides. Two facts, side by side, neither pretending to
     be the other.
   · a card token grants nothing, so the reports only load on the hosted edit link. On the file edition there
     is no service, so the page says so and shows nothing in its place. */
let REPORTS = {tried: false, at: null, by_key: {}, by_load: {}, total: 0, error: null};
async function loadReports(){
  /* v5.84 — a view link may not read the card reports; the service says 403 and this page said so on every
     load in the console. The refusal is a fact the link already knows, so it is recorded here and never asked. */
  if (SYNC.claims === 'view') {
    REPORTS = {tried: true, at: null, by_key: {}, by_load: {}, total: 0, forbidden: true,
               error: 'this link can view the record but not the card reports'};
    return REPORTS;
  }
  if (!SYNC.backend || !SYNC.backend.reports) {
    REPORTS = {tried: true, at: null, by_key: {}, by_load: {}, total: 0,
               error: 'this file has no service behind it, so no card reports can be read'};
    return REPORTS;
  }
  try {
    const j = await SYNC.backend.reports();
    const byKey = {}, byLoad = {};
    Object.keys(j.reports || {}).forEach(token => {
      const pack = j.reports[token];
      (pack.reports || []).forEach(r => {
        const row = Object.assign({}, r, {token, card_title: pack.title, run_date: pack.run_date,
                                          card_withdrawn: pack.card_withdrawn, card_expired: pack.expired});
        (byLoad[r.load] = byLoad[r.load] || []).push(row);
        (r.keys || []).forEach(k => { (byKey[k] = byKey[k] || []).push(row); });
      });
    });
    const order = (a, b) => String(b.at).localeCompare(String(a.at));
    Object.values(byKey).forEach(v => v.sort(order));
    Object.values(byLoad).forEach(v => v.sort(order));
    REPORTS = {tried: true, at: new Date().toISOString(), by_key: byKey, by_load: byLoad,
               total: j.total || 0, error: null};
  } catch (e) {
    const msg = String(e.message || e);
    const forbidden = /can view the record but not/.test(msg);
    /* a moment's failure keeps what was read last time — the drawer does not go blank because of one 503 */
    REPORTS = {tried: true, at: REPORTS.at, by_key: REPORTS.by_key || {}, by_load: REPORTS.by_load || {},
               total: REPORTS.total || 0, error: msg, forbidden, failed_at: new Date().toISOString()};
  }
  return REPORTS;
}
/* v5.58 — THE REPORTS ARE READ ON THEIR OWN CLOCK, AND A BAD MOMENT DOES NOT STOP THEM FOR GOOD.
   The 19 Sep 2026 audit, SYNC-01 and SYNC-02: the reports were read only when the main record moved — so a
   driver's report on a quiet afternoon never appeared until somebody else changed something — and one passing
   error (a 503, a dropped connection) set an error that was never retried, so the page stopped reading reports
   for the rest of the session without a word.

   Now: read every 20 s while the page is open and visible, whatever the record is doing. A refusal that is a
   fact (403: this link may not read them) is remembered and not asked again. Anything else is tried again
   next round, and the footer line says the last read failed rather than saying nothing. A page in a hidden tab
   does not poll — it reads when it comes back. */
const REPORTS_EVERY_MS = 20000;
let reportsTimer = null;
function reportsPoll(){
  if (reportsTimer) return;
  const tick = () => {
    reportsTimer = null;
    if (document.hidden) { reportsTimer = setTimeout(tick, REPORTS_EVERY_MS); return; }
    if (REPORTS.forbidden) return;                            /* a fact, not a moment: not asked again */
    loadReports().then(r => {
      if (r && r.forbidden) return;
      /* v5.66 — A DRAWER THAT IS SHUT IS SHUT. Andrew Fisher, 22 Sep 2026: the side bar kept opening by itself
         wherever he was, with a photograph of P05's drawer sitting over the Map.

         This line means to REFRESH a drawer that is already open when new reports land — that is what
         {keep: true} is for. It asked `!drawer.hidden`, which is the DOM's hidden PROPERTY, and this drawer is
         never hidden that way: it is shown and hidden with the `on` class and aria-hidden, so `drawer.hidden`
         was false always and `!drawer.hidden` was true always. Closing the drawer does not clear state.sel
         either — the map still wants to know which reference is selected — so the two together meant that
         every reports poll re-opened the last reference somebody had looked at, over whatever they were doing.

         photoRedraw, which does the identical job for the photograph registry, asks the right question two
         hundred lines further down: classList.contains('on'). This asks the same one now. */
      const drawer = document.querySelector('#drawer');
      if (state.sel && drawer && drawer.classList.contains('on')) openAsset(state.sel, {keep: true});
      reportsTimer = setTimeout(tick, REPORTS_EVERY_MS);
    });
  };
  tick();
}
document.addEventListener('visibilitychange', () => { if (!document.hidden && !reportsTimer && REPORTS.tried && !REPORTS.forbidden) reportsPoll(); });
function reportsFor(key){ return (REPORTS.by_key || {})[key] || []; }
/* The latest answer per field across every report on a reference — the one a person reads. Later answers win
   over earlier ones for THAT field only, so a photograph sent at ten past does not rub out a levelling answer
   sent at ten. Each answer keeps who said it and when, because that is what makes it somebody's word. */
function reportedState(key){
  const rs = reportsFor(key);
  const out = {};
  /* oldest first so the newest overwrites */
  rs.slice().reverse().forEach(r => {
    Object.keys(r.fields || {}).forEach(f => {
      out[f] = {answer: r.fields[f], by: r.name_given, at: r.at, token: r.token};
    });
  });
  return out;
}
const REPORT_FIELD_WORDS = {delivered: 'Delivered', in_position: 'In final position',
  installed: 'Installed / set up', levelled: 'Levelled', stairs: 'Stairs fitted'};
function reportChip(f, v){
  const cls = v.answer === 'yes' ? 'ok' : v.answer === 'not applicable' ? '' : 'cand';
  return `<span class="chip ${cls}" title="${esc((v.by || 'somebody') + ' reported this on ' + fmtStamp(v.at)
    + ' — reported, not checked')}">${esc(REPORT_FIELD_WORDS[f] || f)}: ${esc(v.answer)}</span>`;
}
/* The card on a reference's drawer. It says what came back and, plainly, that nobody has checked it. */
function reportedCard(key){
  const rs = reportsFor(key);
  if (!rs.length) return '';
  const st = reportedState(key);
  const pins = rs.filter(r => r.pin);
  const pics = rs.reduce((n, r) => n + (r.photos || []).length, 0);
  /* a warning that somebody's word is not a record stays in view — it is not a story to fold (nosfold) */
  return `<div class="card reported nosfold">
    <div class="hubtitle" style="margin-bottom:4px"><h3>Reported from the drop card
      <span class="chip cand">${rs.length} report${rs.length === 1 ? '' : 's'}</span></h3>
      <span class="w" style="font-size:12px;color:var(--mute)">somebody's word, not a Coates record</span></div>
    <p class="norate"><b>Nobody at Coates has checked any of this.</b> It is what the person holding the drop
    card typed, with the name they gave. It changes no light, no date and no figure on this page — read it, then
    record what you believe on the record yourself.</p>
    ${Object.keys(st).length ? `<p style="margin:8px 0 4px">${Object.keys(REPORT_FIELD_WORDS)
      .filter(f => st[f]).map(f => reportChip(f, st[f])).join(' ')}</p>` : ''}
    <div class="tblwrap"><table><thead><tr><th>When</th><th>Who it says</th><th>Answered</th><th>Note</th><th>Position</th><th>Photos</th></tr></thead>
      <tbody>${rs.map(r => `<tr>
        <td style="white-space:nowrap">${esc(fmtStamp(r.at))}</td>
        <td>${r.name_given ? esc(r.name_given) : '<span class="todo" title="no name was typed on this report">no name given</span>'}
          <br><span class="w" style="font-size:11px;color:var(--mute)">not verified</span></td>
        <td>${Object.keys(r.fields || {}).length
          ? Object.keys(r.fields).map(f => esc((REPORT_FIELD_WORDS[f] || f) + ': ' + r.fields[f])).join('<br>')
          : '<span class="todo">nothing answered</span>'}</td>
        <td>${r.note ? esc(r.note) : '<span class="todo">—</span>'}</td>
        <td>${r.pin ? `${esc(r.pin.lat.toFixed(6))}, ${esc(r.pin.lon.toFixed(6))}<br>
            <span class="w" style="font-size:11px;color:var(--mute)">${r.pin.accuracy_m != null
              ? 'about ' + esc(Math.round(r.pin.accuracy_m)) + ' m either way' : 'no accuracy given'} · ${esc(r.pin.how)}</span>`
          : '<span class="todo">—</span>'}</td>
        <td>${(r.photos || []).length
          ? (r.photos || []).map((src, i) => `<img src="${esc(src)}" alt="Photograph ${i + 1} sent with the report by ${esc(r.name_given || 'somebody')} — a photograph of the drop, not a product reference photograph" style="width:64px;height:48px;object-fit:cover;border-radius:4px;margin:0 4px 4px 0">`).join('')
          : '<span class="todo">—</span>'}</td></tr>`).join('')}</tbody></table></div>
    ${pins.length ? `<p class="norate">A reported position is the phone's estimate where somebody stood, not a
      survey and not the planned spot. The planned position on this page is unchanged.</p>` : ''}
    ${pics ? `<p class="norate">${pics} photograph${pics === 1 ? '' : 's'} came with these reports. They are
      photographs of the drop on the day, not product reference photographs.</p>` : ''}
  </div>`;
}
/* ------------------------------------------------------------------ v5.56 — THE CARD ANSWERS BACK
   Andrew Fisher's brief of 19 Sep 2026. The person who took the load tells us what they actually did: delivered,
   in position, installed, levelled, stairs fitted — each its own answer, with a note, photographs and the spot
   they are standing on. Five things this holds to, and every one of them is a decision, not a detail:

   · TICKING DELIVERED TICKS NOTHING ELSE. Five separate questions, five separate answers, and "not answered" is
     its own state — never a quiet yes and never a quiet no. A driver can say the load is down without claiming
     anybody levelled it.
   · IT IS REPORTED, NOT RECORDED. Holding a card link is not proof of who you are. The name is what they typed.
     Everything that comes back is stored and shown as somebody's word, changes no figure, and waits for an
     editor. The card says that on its face so nobody thinks they have closed the job.
   · THE CARD STAYS ALMOST FROZEN. It carries one small script of its own and talks to one address — its own
     /report — and the page it is served from allows exactly that and nothing else. No library, no third party,
     no other card, nothing about the rest of the job.
   · A PIN IS AN ESTIMATE WITH A NUMBER ON IT. The phone's accuracy travels with the position and is shown, and
     when the phone will not give one there is a box to type it or a note to leave instead. Never a pin invented.
   · A SAVE THAT DID NOT LAND IS NOT A SAVE. The card says "not sent" and keeps what was typed, so a man in a
     dead spot at Macintosh Park can press it again when he has a bar of signal. */
function cardReportSection(as){
  /* which questions this load's own things can honestly be asked. Levelling and stairs are asked where the
     rate card offers them for what is on the truck — a water barrier is not levelled and has no stairs, so
     nobody is asked to answer "not applicable" fifteen times. */
  /* labourLinesFor returns {state, lines, …} — the question is whether the CARD carries that line for this
     item at all, and whether it is a line with money on it rather than one the card writes as N/A. A water
     barrier has no levelling line and no steps line, so nobody is asked about them. */
  const offers = (a, lineKey) => {
    const got = labourLinesFor(a.key, a.discipline, (a.item_types || [])[0] || a.product || a.discipline || '', lineKey);
    const L = ((got && got.lines) || []).find(x => x.key === lineKey);
    return !!(L && L.money !== 'absent');
  };
  const askInstall = as.some(a => offers(a, 'install'));
  const askLevel = as.some(a => offers(a, 'levelling'));
  const askSteps = as.some(a => offers(a, 'steps'));
  const q = [
    ['delivered',  'Delivered',        ['Yes', 'Not yet'], true],
    ['in_position','In final position',['Yes', 'Not yet'], true],
    ['installed',  'Installed / set up',['Yes', 'Not yet', 'Not applicable'], askInstall],
    ['levelled',   'Levelled',          ['Yes', 'Not yet', 'Not applicable'], askLevel],
    ['stairs',     'Stairs fitted',     ['Yes', 'Not yet', 'Not applicable'], askSteps],
  ].filter(x => x[3]);
  const rows = q.map(([k, label, answers]) => `
    <fieldset class="q"><legend>${cardEsc(label)}</legend>
      ${answers.map(a => `<label class="opt"><input type="radio" name="${cardEsc(k)}" value="${cardEsc(a.toLowerCase())}"> ${cardEsc(a)}</label>`).join('')}
      <button type="button" class="clr" data-clear="${cardEsc(k)}">Not answered</button>
    </fieldset>`).join('');
  return `
  <div class="box rep"><h2>Tell us what you did</h2>
    <p class="fine">Each one on its own. Saying the load is <b>delivered</b> says nothing about whether it is in
    position, installed, levelled or has its stairs on — answer only what you actually did. Leave anything you
    did not do unanswered; a blank is a blank, not a no.</p>
    <form id="rep" novalidate>
      ${rows}
      <label class="fld"><span>Your name</span>
        <input type="text" name="name" autocomplete="name" maxlength="80" placeholder="who is reporting"></label>
      <label class="fld"><span>Anything we should know</span>
        <textarea name="note" rows="3" maxlength="1200" placeholder="access, damage, where you actually put it, who you spoke to"></textarea></label>

      <fieldset class="q"><legend>Photographs</legend>
        <p class="fine">Up to six. They are shrunk on your phone before they are sent, so this works on a bad signal.</p>
        <input type="file" id="pics" accept="image/*" capture="environment" multiple>
        <div id="picnote" class="fine"></div></fieldset>

      <fieldset class="q"><legend>Where it actually is</legend>
        <p class="fine">Stand beside it, then press the button. Your phone will ask permission. The position is an
        estimate and its accuracy is shown — it does not replace the supervisor's word.</p>
        <button type="button" class="act" id="loc">Use my location</button>
        <div id="locnote" class="fine">No position sent.</div>
        <details><summary class="fine">The phone will not give a position</summary>
          <label class="fld"><span>Latitude</span><input type="text" id="latin" inputmode="decimal" placeholder="-27.9834"></label>
          <label class="fld"><span>Longitude</span><input type="text" id="lonin" inputmode="decimal" placeholder="153.4290"></label>
          <p class="fine">Typed by hand — it is recorded as placed by hand, not as your phone's reading.</p></details></fieldset>

      <button type="submit" class="act send" id="send">Send this report</button>
      <div id="sent" class="fine" role="status" aria-live="polite"></div>
      <p class="fine">This goes to Coates as <b>your report</b>, with the name you typed on it. It does not close
      the job, change a delivery record or sign anything off — somebody at Coates reads it and decides. If this
      says it did not send, the words you typed are still here; press it again when you have signal.</p>
    </form>
  </div>`;
}
/* The card's own script. One job, one address: its own /report. It is served under a policy that names this
   script by its hash, so nothing else can run on the card even if something got into the HTML. */
function cardReportScript(){
  return `(function(){
  var f=document.getElementById('rep'); if(!f) return;
  var out=document.getElementById('sent'), picnote=document.getElementById('picnote'), locnote=document.getElementById('locnote');
  var sendBtn=document.getElementById('send');
  function say(el,t,cls){ el.textContent=t; el.className='fine'+(cls?' '+cls:''); }
  f.querySelectorAll('[data-clear]').forEach(function(b){ b.addEventListener('click',function(){
    f.querySelectorAll('input[name="'+b.getAttribute('data-clear')+'"]').forEach(function(r){ r.checked=false; }); }); });

  /* v5.58 — FOUR THINGS THE FIRST CUT GOT WRONG, from the 19 Sep 2026 audit of this very script.
     1. One ID for the life of the page meant a SECOND report from the same card was thrown away as "already
        sent". An ID now belongs to one snapshot: it is kept while that snapshot is unsent (a retry on bad
        signal), and a new snapshot after an acknowledged send gets a new ID.
     2. Pressing Send while the photographs were still being shrunk sent the report without them. Send now
        waits for the pictures it can see to finish, and says so.
     3. Picking photographs a second time could send pictures from the FIRST pick that finished late. Every
        pick has a generation; a late result from an old pick is thrown away, and every object URL is freed.
     4. Pressing Send while the phone was still finding a fresh position sent the OLD position. A pending
        position request is tracked; Send waits for it. */
  var pics=[], picGen=0, picsPending=null, pin=null, pinPending=null, sending=false;
  var snap=null;      /* {id, body} — the one unsent snapshot, kept whole for a retry; null once acknowledged */
  var lastSent=null;  /* the last ACKNOWLEDGED snapshot: pressing Send again with nothing changed is a double-tap, not a second report */
  function newId(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,8); }

  document.getElementById('pics').addEventListener('change',function(e){
    var gen=++picGen;                                   /* everything from an earlier pick is now stale */
    var files=[].slice.call(e.target.files||[]).slice(0,6);
    pics=[];
    if(!files.length){ picsPending=null; say(picnote,''); return; }
    say(picnote,'Preparing '+files.length+' photograph'+(files.length===1?'':'s')+'…');
    picsPending=Promise.all(files.map(function(file){
      return new Promise(function(res){
        var img=new Image(), url=URL.createObjectURL(file);
        img.onload=function(){
          try{
            if(gen!==picGen) return res(null);          /* a later pick replaced this one: drop it */
            var w=img.naturalWidth,h=img.naturalHeight,max=1600,sc=Math.min(1,max/Math.max(w,h));
            var c=document.createElement('canvas'); c.width=Math.round(w*sc); c.height=Math.round(h*sc);
            c.getContext('2d').drawImage(img,0,0,c.width,c.height);
            res(c.toDataURL('image/jpeg',0.72));
          }catch(err){ res(null); } finally{ URL.revokeObjectURL(url); }
        };
        img.onerror=function(){ URL.revokeObjectURL(url); res(null); };
        img.src=url;
      });
    })).then(function(list){
      if(gen!==picGen) return;                          /* stale batch: the newer pick owns the note */
      pics=list.filter(Boolean);
      var lost=list.length-pics.length;
      say(picnote,pics.length+' photograph'+(pics.length===1?'':'s')+' ready to send.'+(lost?' '+lost+' could not be read and will not be sent.':''), lost?'warnt':'');
      picsPending=null;
    });
  });

  document.getElementById('loc').addEventListener('click',function(){
    if(!navigator.geolocation){ say(locnote,'This browser will not give a position. Type it by hand below, or leave a note instead.','warnt'); return; }
    pin=null;                                           /* a fresh request voids the old fix: it is not sent by mistake */
    say(locnote,'Asking your phone…');
    pinPending=new Promise(function(res){
      navigator.geolocation.getCurrentPosition(function(p){
        var acc=p.coords.accuracy;
        pin={lat:p.coords.latitude,lon:p.coords.longitude,accuracy_m:acc,how:'from the phone'};
        say(locnote,'Position taken: '+p.coords.latitude.toFixed(6)+', '+p.coords.longitude.toFixed(6)
          +(acc!=null&&isFinite(acc)?' — your phone says about '+Math.round(acc)+' m either way':' — your phone gave no accuracy'));
        res(true);
      },function(err){
        pin=null;
        say(locnote,'No position: '+(err&&err.code===1?'permission was refused':'your phone could not get a fix')
          +'. Type it by hand below, or leave a note instead.','warnt');
        res(false);
      },{enableHighAccuracy:true,timeout:15000,maximumAge:0});
    }).then(function(){ pinPending=null; });
  });

  function snapshotNow(){
    var fd=new FormData(f), fields={};
    ['delivered','in_position','installed','levelled','stairs'].forEach(function(k){ var v=fd.get(k); if(v) fields[k]=String(v); });
    var hand=null, la=parseFloat((document.getElementById('latin')||{}).value), lo=parseFloat((document.getElementById('lonin')||{}).value);
    if(!pin && isFinite(la) && isFinite(lo)) hand={lat:la,lon:lo,how:'placed by hand'};
    return {name:fd.get('name')||'',note:fd.get('note')||'',fields:fields,photos:pics.slice(),pin:pin||hand};
  }
  function sameBody(a,b){
    function comparable(x){
      var fields=Object.keys(x.fields||{}).sort().map(function(k){return [k,x.fields[k]];});
      var p=x.pin, pin=p?[p.lat,p.lon,p.accuracy_m==null?null:p.accuracy_m,p.how||null]:null;
      return [fields,x.note||'',pin,x.photos||[],x.name||''];
    }
    return JSON.stringify(comparable(a))===JSON.stringify(comparable(b));
  }

  f.addEventListener('submit',function(e){
    e.preventDefault();
    if(sending) return;
    var waits=[];
    if(picsPending){ waits.push(picsPending); }
    if(pinPending){ waits.push(pinPending); }
    if(waits.length){
      say(out,'Waiting for '+(picsPending&&pinPending?'the photographs and your position':picsPending?'the photographs to finish':'your position')+'…');
      sending=true; sendBtn.disabled=true;
      Promise.all(waits).then(function(){ sending=false; sendBtn.disabled=false; f.requestSubmit ? f.requestSubmit() : f.dispatchEvent(new Event('submit',{cancelable:true})); });
      return;
    }
    var body=snapshotNow();
    if(!Object.keys(body.fields).length && !body.note && !body.photos.length && !body.pin){
      say(out,'Nothing has been answered yet, so nothing was sent.','warnt'); return; }
    /* the same unsent snapshot keeps its ID (a retry); the same ALREADY-SENT snapshot keeps its ID too (a
       double-tap, answered "already sent"); anything different is a new report with a new ID */
    if(!snap || !sameBody(snap.body,body)){
      snap = (lastSent && sameBody(lastSent.body,body)) ? {id:lastSent.id, body:body} : {id:newId(), body:body};
    }
    body.id=snap.id;
    sending=true; sendBtn.disabled=true;
    say(out,'Sending…');
    fetch(location.pathname.replace(/\\/$/,'')+'/report',
      {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){ return r.json().then(function(j){ return {ok:r.ok,j:j}; }); })
      .then(function(r){
        sending=false; sendBtn.disabled=false;
        if(!r.ok){ say(out,'NOT SENT — '+((r.j&&r.j.error)||'the service refused it')+'. What you typed is still here; press it again.','warnt'); return; }
        lastSent=snap; snap=null;                       /* acknowledged: anything DIFFERENT next is a new report */
        var where=body.pin?(' Position sent: '+Number(body.pin.lat).toFixed(6)+', '+Number(body.pin.lon).toFixed(6)+(body.pin.accuracy_m!=null?' (about '+Math.round(body.pin.accuracy_m)+' m)':body.pin.how==='placed by hand'?' (typed by hand)':'')+'.'):'';
        var pics_n=body.photos.length?(' '+body.photos.length+' photograph'+(body.photos.length===1?'':'s')+' sent.'):'';
        say(out,(r.j.already?'Already sent — this is the same report, not a second one.'
          :'Sent. Coates has your report. It has not closed the job — somebody there reads it and decides.')+pics_n+where,'okt');
      })
      .catch(function(){ sending=false; sendBtn.disabled=false;
        say(out,'No confirmation received. Coates may already have this report. What you typed is still here; retry when you have signal — the same report keeps its ID.','warnt'); });
  });
})();`;
}
function depotUrl(ll){
  const d = DATA.depot; if (!d || !ll) return null;
  const origin = (d.lat != null && d.lon != null) ? `${d.lat},${d.lon}` : d.maps_query;
  return origin ? `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(origin)}&destination=${ll.lat.toFixed(6)},${ll.lon.toFixed(6)}&travelmode=driving` : null;
}
/* The run from the depot as a planning figure: straight-line distance (a fact, from the two positions), a road
   distance and a time from stated assumptions. Every figure is labelled as such wherever it is shown. */
function haversineKm(a, b){
  const R = 6371, r = Math.PI / 180, dLat = (b.lat - a.lat) * r, dLon = (b.lon - a.lon) * r;
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dLon / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
}
function depotRun(ll){
  const d = DATA.depot; if (!d || !ll || d.lat == null || d.lon == null || !d.planning) return null;
  /* v5.52 — A ROUTED FIGURE, WHEN THERE IS ONE. TomTom's run from the depot to the nearest of the circuit's
     anchor points, at a stated departure with typical traffic for that hour, taken at a stated moment; the
     straight-line assumption below is what the page carried before and is only used with no snapshot. */
  const T = DATA.tomtom, R = T && T.present && T.depot_runs;
  if (R && R.runs && R.runs.length) {
    const near = R.runs.map(r => Object.assign({d: haversineKm({lat: r.lat, lon: r.lon}, ll)}, r)).sort((a, b) => a.d - b.d)[0];
    const dep = fmtWhen(R.departure);
    /* HOW FAR THE ANCHOR IS FROM THE THING. The snapshot routes to the circuit's anchor points, not to each
       reference, so a figure is only the whole trip when the reference is at the anchor. That was invisible
       while the snapshot carried an anchor at each end. The 21 Sep 2026 snapshot carries ONE — the north end —
       so a reference at the south end was being handed a northern figure with nothing to say it was not theirs.
       The gap is stated rather than closed: no distance is invented, and the reader is told what the figure
       does and does not cover. */
    const offKm = near.d;
    const far = offKm >= 0.5;
    return {routed: true, road_km: near.km, minutes: near.min, to: near.to, taken_at: R.taken_at,
            from_anchor_km: Math.round(offKm * 10) / 10,
            text: `about ${Math.round(near.km)} km by road, about ${near.min} min`,
            detail: `TomTom's route from ${d.name} to ${near.to}, departing ${dep} with typical traffic for that hour, via ${R.via}; taken ${fmtWhen(R.taken_at)}${(() => { const g = snapAge(R.taken_at); return g && g.stale ? ' — ' + g.words + ', so treat the minutes as a planning figure and nothing more' : ''; })()}. ${R.vehicle}. ${R.planning_note}${far ? ` This spot is about ${offKm.toFixed(1)} km further on from ${near.to}, and that last bit is not in the figure.` : ''}`};
  }
  const line = haversineKm({lat: d.lat, lon: d.lon}, ll);
  const road = line * d.planning.road_factor;
  const mins = road / d.planning.truck_kmh * 60 + d.planning.precinct_min;
  return {routed: false, line_km: line, road_km: road, minutes: mins,
          text: `about ${Math.round(road)} km by road, allow about ${Math.round(mins / 5) * 5} min`,
          detail: `${line.toFixed(1)} km in a straight line; ${d.planning.basis}`};
}
/* v5.52 — the nearest street address TomTom knows to a reference's drawn spot: for saying where a thing is
   when somebody rings, not the site's address and not where the thing is to the metre */
function nearestStreet(key){
  const T = DATA.tomtom; if (!T || !T.present || !T.nearest) return null;
  const n = T.nearest.by_ref[key]; return n ? Object.assign({taken_at: T.nearest.taken_at}, n) : null;
}
/* v5.54 — HOW OLD IS IT. Andrew Fisher, 20 Sep 2026: TomTom and Mapbox used to their full potential, whenever
   they are needed.

   Every surface already said WHEN the snapshot was taken, and said plainly that it is a snapshot and not a
   live feed. None of them said how old that makes it. "As TomTom reported them at 18 Sep 23:05" reads exactly
   the same on the 19th and on the 25th, and during build week a three-day-old list of incidents is not a
   dated fact, it is a wrong one being read calmly. So the age is worked out against the day the page is
   opened, not the day it was built, and past two days it says so where the figure is used. */
function snapAge(at){
  if (!at) return null;
  const t = Date.parse(at); if (!isFinite(t)) return null;
  const days = Math.floor((Date.now() - t) / 86400000);
  if (days < 0) return null;
  return {days: days,
          words: days === 0 ? 'taken today' : days === 1 ? 'taken yesterday' : days + ' days old',
          stale: days >= 2};
}
/* v5.55 — WHEN THE STORED ONE HAS GONE OFF, OFFER A LIVE ONE. Andrew Fisher, 21 Sep 2026: TomTom was showing
   old updates.

   The snapshot is taken by hand through the TomTom connector and it ages; saying how old it is (v5.54) stops
   anybody being misled, but a warning is not a road. Google's own directions carry live traffic and a live
   arrival time, need no key and open on any phone — so past two days the page stops offering only a number
   from Tuesday and offers today's run as well. It is not a replacement for the snapshot, which is dated,
   attributable and on the record; it is the thing to press when the record has gone stale and a load is
   waiting. */
function liveRunUrl(){
  const d = DATA.depot || {}, T = DATA.tomtom || {};
  const to = ((T.depot_runs || {}).runs || [])[0];
  if (d.lat == null || !to || to.lat == null) return null;
  return 'https://www.google.com/maps/dir/?api=1&origin=' + d.lat.toFixed(6) + ',' + d.lon.toFixed(6)
       + '&destination=' + to.lat.toFixed(6) + ',' + to.lon.toFixed(6) + '&travelmode=driving';
}
function liveRunLink(at){
  const g = snapAge(at); if (!g || !g.stale) return '';
  const u = liveRunUrl(); if (!u) return '';
  return ` <a class="linkish" href="${u}" target="_blank" rel="noopener noreferrer" title="Google's own directions from the depot to the circuit, with live traffic and a live arrival time. Opens outside this page; nothing here is sent to it but the two positions.">check the run live</a>`;
}
function snapAgeChip(at){
  const g = snapAge(at); if (!g || !g.stale) return '';
  return `<span class="chip crit" title="Roads change. This was taken ${esc(fmtWhen(at))} and has not been refreshed since — the truck's own satnav is the live one.">${esc(g.words)} — refresh before relying on it</span>`;
}
/* the incidents TomTom reported round the circuit, as at the snapshot */
function roadsSnapshot(){
  const T = DATA.tomtom; if (!T || !T.present || !T.traffic) return null;
  return T.traffic;
}
/* A QR code of the navigation link, as inline SVG, for the printed drop sheet. Null when the encoder is absent. */
/* ------------------------------------------------------------------ Navigate, where a person stands
   Andrew Fisher, 15 Sep 2026: a direct link to maps from a location, so opening it gives navigation.

   The link itself already existed — navUrl() has been behind the QR code on the printed sheet and behind a
   tiny ghost button at the foot of a long paragraph in the satellite panel. Nobody standing in a yard at 05:00
   was going to find that. It is one control now, and it is put wherever a position is shown: the drawer, the
   equipment card, the day's pit board and the map's picker.

   Three rules it keeps, because a navigation link is a promise about where something is:
     · a reference whose destination somebody has TYPED OVER has no confirmed point, so it offers no Navigate
       at all — the drawing still points at where it used to go, and sending a driver there is worse than
       sending them nowhere;
     · the point comes from a callout on iEDM's sheet put over the photograph by the registration, so the
       button says PLANNED AREA and carries the registration's own error;
     · it opens in the person's own maps app, outside this page, and nothing is contacted until they press it. */
/* v5.51 — A PIN IS THE DESTINATION. Andrew Fisher, 18 Sep 2026: once a thing is pinned, the pin is the new
   destination and overrides any other. So every Navigate on this page — the drawer, the register row, the
   load, the drop card, the drop sheet, the QR on the printed sheet, the text to a driver — goes to the spot
   somebody pinned standing at it, when there is one: the reference's own pin first, else the first building's.
   Only with no pin at all does it fall back to the drawing's area. The drawing itself is not moved by this —
   the record still carries both, and says which one the directions are to. A reference somebody has MOVED
   with no confirmed ground position used to navigate nowhere; a pin is exactly that confirmation. */
function navTargetFor(a){
  if (!a) return null;
  /* v5.54 — the NEWEST pin wins, not the first key in the list. This used to walk [reference, then each
     building] and take the first one it found, so a drop-level pin taken at the gate on Monday outranked a
     building pin taken standing at the door on Tuesday, and Navigate sent the crew to the gate. A pin taken
     later is a pin taken knowing more; where two were taken at the same moment, the tighter one wins. */
  const best = bestPinFor(a);
  if (best) return {ll: {lat: best.fix.lat, lon: best.fix.lon, text: best.fix.lat.toFixed(6) + ', ' + best.fix.lon.toFixed(6)}, pinned: true, key: best.key, fix: best.fix};
  /* v5.55 — then a position somebody PUT there from outside. Better than the drawing's callout, which is where
     a label reads clearly on a sheet; worse than anybody standing at the thing, which is why it comes second. */
  const put = bestPlaceFor(a);
  if (put) return {ll: {lat: put.place.lat, lon: put.place.lon, text: put.place.lat.toFixed(6) + ', ' + put.place.lon.toFixed(6)},
                   pinned: false, placed: true, key: put.key, fix: null, place: put.place};
  if (movedFor(a)) return null;
  const pt = aerialPointFor(a);
  const ll = pt ? lonLatOf(pt.ax, pt.ay) : null;
  return ll ? {ll: ll, pinned: false, key: a.key, fix: null} : null;
}
function navPointFor(a){ const t = navTargetFor(a); return t ? t.ll : null; }
function navSays(a){
  const t = navTargetFor(a);
  if (t && t.pinned) {
    const f = t.fix, q = fixQuality(f.acc);
    return 'Opens your maps app with driving directions to the spot ' + (f.by || 'somebody') + ' pinned standing at '
         + fixLabel(t.key) + (f.at ? ' on ' + fmtStamp(f.at) : '') + ' (' + q.word + ') — the recorded position, not the drawing\'s area.';
  }
  if (t && t.placed) {
    const p = t.place;
    return 'Opens your maps app with driving directions to the spot ' + (p.by || 'somebody') + ' placed for '
         + fixLabel(t.key) + (p.at ? ' on ' + fmtStamp(p.at) : '') + ' \u2014 ' + placeWords(p)
         + '. Nobody has stood at it yet; a pin taken on site replaces this.';
  }
  const g = DATA.georef || {};
  const m = g.fit_worst_m != null ? ' (±' + g.fit_worst_m + ' m)' : '';
  return 'Opens your maps app with driving directions to the planned area for ' + ((a && a.key) || 'this drop')
       + m + ' — the callout on the drawing over the photograph, for finding the area, not for setting out.';
}
const NAV_PIN = '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">'
  + '<path d="M8 1.6c-2.4 0-4.3 1.9-4.3 4.3C3.7 9.2 8 14.4 8 14.4s4.3-5.2 4.3-8.5c0-2.4-1.9-4.3-4.3-4.3z" '
  + 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>'
  + '<circle cx="8" cy="5.9" r="1.6" fill="currentColor"/></svg>';
function navBtn(a, opts){
  const o = opts || {};
  const ll = o.ll || navPointFor(a);
  if (!ll) {
    if (o.quiet) return '';
    const mv = movedFor(a);
    return `<span class="navno" title="${esc(mv
      ? 'Somebody typed a new destination over the schedule\'s and nobody has confirmed where that is on the ground. The drawing still points at the old spot, so this page will not send anybody there.'
      : 'Nothing on any drawing in this pack puts this reference on the ground, so there is no position to navigate to.')}">${NAV_PIN}<span>${
      mv ? 'Moved — position to confirm' : 'No position to navigate to'}</span></span>`;
  }
  return `<a class="btn navbtn${o.small ? ' sm' : ''}${o.primary ? ' primary' : ''}" href="${esc(navUrl(ll))}"
    target="_blank" rel="noopener" data-nav="${esc((a && a.key) || '')}"
    title="${esc(navSays(a))}"${(navTargetFor(a) || {}).pinned ? ' data-pinned="1"' : ''}>${NAV_PIN}<span>Navigate</span>${(navTargetFor(a) || {}).pinned ? '<span class="navpinned" aria-hidden="true">pinned</span>' : ''}<span class="vh"> ${(navTargetFor(a) || {}).pinned ? 'to the spot pinned on site for' : 'to the planned area for'} ${esc((a && a.key) || 'this drop')}, opens your maps app</span></a>`;
}
function navQr(ll, key){
  return ll ? qrSvg(navUrl(ll), 3) : '';
}
/* Andrew Fisher, 13 Sep 2026: a working QR code that takes drivers to information such as Safe
   Transport of Portable Buildings — procedure, Pre-Transit Checklist — Site Accommodation Work Instruction,
   HS 81 — Guidance sheet for lifting portable buildings.

   One code, to the Transport & lifting section of the Documents tab, where all three sit together — so a driver
   scans once and has the set rather than three codes on one page. It is built from the SAME address rule as the
   copy button: never the editing token, the viewing link where this browser knows it. A working code or none:
   a sheet printed from the file on a laptop has no address to point at, so the page prints the names in words
   and says where they live instead of a square that opens nothing.

   It is nothing to do with this drop — it is the procedure for moving a building, the same on every sheet — so
   it says so on the page rather than sitting there looking like part of the directions. */
function swmsDocs(){ return ((DATA.docs || {}).docs || []).filter(d => d.kind === 'swms'); }
/* Which SWMS is THIS drop's. Andrew Fisher, 13 Sep 2026: a small QR code on each drop sheet gives drivers easy
   access to the relevant SWMS before arrival and while on site.

   Relevant means relevant, so it is worked out from what is being dropped rather than from a list somebody has
   to keep in step. Each drop is turned into the pieces of WORK it involves, in plain words; every document in
   the package carries its own applies_to tags, read off its scope-of-works line when the register was built;
   and the two are matched. Loading and unloading is on every drop because its scope IS loading and unloading a
   vehicle, so a driver always has at least one and the sheet never sends him off with nothing.

   The part that matters more: a piece of work with NO document in the package is named on the page as having
   none, rather than passing silently. The 26003 package has a SWMS for portable buildings and toilets and one
   for fencing and crowd control barriers; it has none for placing water-filled barriers, and a crew handed a
   sheet listing only the loading SWMS would reasonably read that as the lot. So the sheet says which one is
   missing, and stops saying it the moment that document is put in the package — the rule is the same either way.

   What this does NOT do is decide which control measures apply. That is the document's job, and the document is
   one scan away. A drop sheet that paraphrased a SWMS would become the thing people read instead of it. */
function swmsNeeds(a){
  const words = [a && a.discipline, ...((a && a.item_types) || []), a && a.product, a && a.name]
    .filter(Boolean).join(' ').toLowerCase();
  const need = [{tag: 'every_load', work: 'loading and unloading the truck'}];
  if (/portable building|\bbuilding\b|office|crib|ticket box|event container/.test(words))
    need.push({tag: 'buildings', work: 'installing and removing portable buildings'});
  if (/toilet|shower|ablution|amenit|\bfwf\b|waste tank|pan block/.test(words))
    need.push({tag: 'toilets', work: 'installing and removing toilets and amenities'});
  if (/water.?fill|water barrier|\bwfb\b|\btl2\b/.test(words))
    need.push({tag: 'water_barriers', work: 'placing water-filled barriers'});
  if (/crowd control|\bccb\b|fenc|hoarding/.test(words))
    need.push({tag: 'fencing', work: 'temporary fencing and crowd control barriers'});
  return need;
}
function swmsFor(a){
  const all = swmsDocs();
  const need = swmsNeeds(a);
  const has = t => all.filter(d => (d.applies_to || []).indexOf(t) > -1);
  const docs = [], gaps = [];
  const seen = new Set();
  need.forEach(n => {
    const hit = has(n.tag);
    if (!hit.length) { if (all.length) gaps.push(n.work); return; }
    hit.forEach(d => { if (!seen.has(d.id)) { seen.add(d.id); docs.push(d); } });
  });
  return {docs, gaps};
}
function docsQrUrl(){
  const s = shareBase();
  return s.shared ? s.url + '#docs' : null;
}
function docsQr(){
  return qrSvg(docsQrUrl(), 3);
}
/* The box as it prints: a code, a border of its own, sitting with the delivery instructions.

   Andrew Fisher, 13 Sep 2026: a clear bordered box near the delivery instructions.

   The code opens the Documents page, where the SWMS sit first and the transport and lifting procedures under
   them, so one scan is the lot. What the box SAYS is only ever what the build actually saw: a SWMS that has not
   been put in the package is not named, and where there is none at all the box says so in as many words instead
   of pointing a driver at an empty shelf. */
function docsBlock(a){
  const s = swmsFor(a), swms = s.docs, tr = transportDocs();
  if (!swms.length && !tr.length && !s.gaps.length) return '';
  /* The name a person would say out loud, once. Several of these carry their reference inside the title as well
     as in its own field ("Help Sheet 81" / "HS 81 — …"), and printing both reads like a filing error. */
  const say = d => {
    const title = String(d.title || d.name || '').split(' — ')[0].trim();
    const ref = String(d.doc_ref || '').split(' · ')[0].split(' v')[0].trim();
    const same = ref && title.replace(/[^a-z0-9]/gi, '').toLowerCase()
                         .indexOf(ref.replace(/[^a-z0-9]/gi, '').toLowerCase()) > -1;
    return esc(title + (ref && !same ? ' (' + ref + ')' : ''));
  };
  const building = a && (/portable building/i.test(a.discipline || '')
                         || /building/i.test((a.item_types || []).join(' ')));
  const bits = [];
  if (swms.length) bits.push('<b class="rs-dh">Your SWMS:</b> ' + swms.map(say).join(' · '));
  else bits.push('<b class="rs-dh">SWMS:</b> on the GC500 page under Documents — '
                 + '<b>read yours before you arrive</b>');
  if (tr.length && building) bits.push('<b class="rs-dh">Moving a building:</b> ' + tr.map(say).join(' · '));
  if (s.gaps.length) bits.push('<b class="rs-dh rs-warn">No SWMS in this package for ' + esc(s.gaps.join(' or '))
    + '.</b> Ring the supervisor for the one that covers it before you start.');
  const svg = docsQr();
  return `<div class="rs-docs">${svg ? `<div class="rs-dq">${svg}<span>scan for the<br>SWMS &amp; docs</span></div>` : ''}
    <div class="rs-dt"><b>Before you load: read the SWMS for this job.</b>
      ${bits.map(x => '<span>' + x + '</span>').join('')}
      <em>${svg ? 'Scan the code (Documents page, SWMS first).' : 'GC500 page, under Documents.'
        } Read yours before you arrive and keep it on you. Inside the light rail exclusion zone, the G-Link
        assessment as well.</em>
    </div></div>`;
}

/* The gate a truck uses, and which way the asset lies from it. D007 names one heavy-vehicle entry. */
function heavyGate(){
  const pts = (DATA.access || {}).points || [];
  return pts.find(p => p.kind === 'heavy') || null;
}

function gettingThere(pt){
  const acc = DATA.access;
  if (!acc || !pt) return '';
  const gate = heavyGate();
  const rows = [];
  if (gate) {
    const b = bearingBetween(gate.ax, gate.ay, pt.ax, pt.ay);
    rows.push(`<li><b>Heavy vehicles enter here.</b> ${esc(gate.text.replace(/ · /g, ' — '))}.
      ${b ? 'From that gate this location is to the <b>' + b.compass + '</b>' + (b.metres != null
            ? ', about <b>' + fmtMetres(b.metres) + '</b> in a straight line' : '') + '.' : ''}</li>`);
  }
  const others = (acc.points || []).filter(p => p.kind === 'entry' || p.kind === 'exit');
  if (others.length) {
    rows.push('<li>' + others.map(p => esc(p.text.replace(/ · /g, ' — '))).join('. ') + '.</li>');
  }
  const park = (acc.points || []).find(p => p.kind === 'parking');
  if (park) rows.push('<li>' + esc(park.text.replace(/ · /g, ' ')) + '</li>');
  const notes = (acc.general_notes || []).filter(n => /SPEED|ONE-WAY|AFTER HOURS|TOWED/i.test(n));
  return `<div class="getting">
    <div class="sath" style="border-radius:0"><span>Getting a truck to it</span></div>
    <ul class="gt">${rows.join('')}</ul>
    ${notes.length ? `<ul class="gt rules">${notes.map(n => '<li>' + esc(String(n)) + '</li>').join('')}</ul>` : ''}
    <p class="satcap sub">${esc(acc.authority)} ${esc(acc.date_warning)}</p>
  </div>`;
}

/* ------------------------------------------------------------------ photographs of the drop itself
   Andrew Fisher, 13 Sep 2026: two photos added to a location once a thing is dropped there — and, asked who would
   be holding the phone, he takes them himself.

   Two slots, because two is what he asked for and because two is what the drop sheet has room for. They are the
   two questions anybody ringing up about a drop actually asks: is it in the right place, and can a truck get
   back to it.

   THE PHOTOGRAPH IS EVIDENCE, AND IT IS NEVER CAPTIONED LIKE A PRODUCT PHOTOGRAPH. The page already carries
   Andrew's product reference pictures, and every one of those says "the product, not this one" on its face —
   the whole point being that nobody reads a stock picture as a picture of the thing in front of them. A drop
   photograph is the opposite: it IS the thing, on the day, and it is captioned with the reference, the time in
   Brisbane and who took it. The two must never be able to be read as each other, so they never share a word.

   Only the pointer lives in the record. The image goes to the same document library the service already keeps —
   /api/files to put one there, /f/<token>/<id> to open it — which is why a photograph needs the EDIT link and
   why the file edition of this page, which has no service behind it, shows the slots but cannot fill them.

   No `capture` attribute on the input, deliberately. With plain accept="image/*" both iOS and Android offer the
   camera AND the photo library in one sheet, so the same control works standing at the drop and sitting at a
   desk with the pictures already on the phone. Forcing `capture` would take the library away. */
/* v5.54 — a third place, for the way in. Andrew Fisher, 20 Sep 2026: a picture and a pinned entry point showing
   how to get to the location, and the picture is his.
   Slot 1 is the surrounds AT the drop — the ground under it and what is beside
   it. This one is the turn-in off the street, taken before you are there, for a driver who has never been. The
   two are different questions and a driver needs both. It is offered on each building's group as well as the
   drop's, which is one more empty box than a building strictly needs; that costs nothing and keeps one rule
   for every photograph rather than a special case that has to be maintained forever. */
/* v5.79 — AND TWO FROM THE AIR. Andrew Fisher, 24 Sep 2026: every location with pictures gets a couple of aerial
   shots too, from his DJI drone. Every group of places —
   the reference's, and each building's — gets two more, for his drone: one straight down on the unit and its
   ground, one along the way in. They take a picture the same way as the three from the ground (the same
   resize, the same pointer, the same Use an existing photo), print on the drop sheet after them in the same
   figures, and stay empty until he flies — an empty place says what it is for. */
const DROP_MAX = 5;
const DROP_SLOTS = [
  {lab: 'In position', hint: 'the unit where it actually ended up — far enough back to place it against something'},
  {lab: 'Access and surrounds', hint: 'the way in, the ground it is standing on, and what is around it'},
  {lab: 'Way in off the street', hint: 'the turn-in as a driver first sees it — the gate, the corner, what to look for'},
  {lab: 'Aerial — overhead', hint: 'from the drone, straight down: the unit and the ground round it, with a road or a compound edge in frame for scale', aerial: true},
  {lab: 'Aerial — the approach', hint: 'from the drone, looking along the way in: the street, the gate and the unit in one frame', aerial: true},
];
/* 1600 px on the long edge at 82% quality: about 300 kB a picture, where a phone's own file is 3 to 6 MB.
   Two on every one of the 193 references is then about 115 MB against the 5 GB the service has, and a photograph
   opens on a phone at the circuit instead of stalling on it. */
const DROP_PX = 1600, DROP_Q = 0.82;

/* Is this file one of ours? The name pattern dropPhotoName writes: drop_<REFERENCE>_<slot>_<stamp>.<ext>. */
function isDropPhotoName(n){ return /^drop_[A-Za-z0-9._-]+(?:_u[A-Za-z0-9._-]+)?_[1-9]\d*_\d{8}-\d{6}(?:_[A-Fa-f0-9]{16})?\.[A-Za-z0-9]+$/.test(String(n || '')); }
/* ------------------------------------------------------------------ the things inside a reference
   A reference counts. T0001 is "VMS x 8" — one row, eight boards, no positions. D025 is the opposite: twenty-
   seven numbered board LOCATIONS and no asset numbers. The join between them exists only on the ground, and
   these are it.

   A unit is {label, asset_no, sheet, callout}: the site's own name for the thing, its asset number, and where
   the drawing puts it. Label and callout are kept apart on purpose. vms1 is a BOARD; 01 is a PLACE. The
   schedule's own "VMS x 5 - Relocate" row on 19 Oct says in as many words that boards move between places, and
   a record that fused the two would quietly lie the first time one did. */
/* COMMITTED FIRST, THEN THIS BROWSER'S. Found 16 Sep 2026: the units were read out of S alone, so the fridge
   and the two air conditioners Andrew Fisher recorded inside P01 on 14 Sep — committed to the ops file, carried
   through every rebuild since — showed on the phone that typed them and on nothing else. A fresh copy of the
   page said P01 had nothing inside it.

   So both are read. A unit recorded on this device beats a committed one with the same asset number or the same
   name, which is the same precedence the ticks use: the committed record is what the last rebuild read, the
   local one is what somebody has done since. The two are never blended into one entry — whichever wins is
   shown whole, with its own name and its own time on it. */
/* v5.58 — WHAT MAKES TWO UNITS THE SAME UNIT. The 19 Sep 2026 audit: HRP holds two air conditioners, 1189901
   and 1127305, both called "Aircon". The old rule was "same number OR same name", so the second hid the first,
   and typing both numbers one after the other kept only the last. Two different physical things, one shown.

   The rule now: an asset number is the identity of a thing where it has one. Two units that both carry a number
   are the same unit only if the numbers match — whatever they are called. A name decides only where a number
   is missing on one side or both, because then the name is all there is. Names help you find a thing; they do
   not make two things one. */
function sameUnit(a, b){
  const an = String((a && a.asset_no) || '').trim(), bn = String((b && b.asset_no) || '').trim();
  if (an && bn) return an === bn;                                   /* two numbers: the numbers decide */
  const al = String((a && a.label) || '').trim(), bl = String((b && b.label) || '').trim();
  return !!(al && bl && al === bl);                                 /* a number missing: the name decides */
}
function unitsOf(ref){
  if (movedAway(ref)) return [];
  const com = ((CROW.get(ref) || {}).units || []).filter(u => u && (u.label || u.asset_no))
    .map(u => Object.assign({}, u, {_where: 'committed'}));
  const r = (S.units || {})[ref];
  const loc = (r && Array.isArray(r.units) ? r.units : []).filter(u => u && (u.label || u.asset_no))
    .map(u => Object.assign({}, u, {_where: 'local'}));
  const beaten = u => loc.some(x => sameUnit(u, x));
  return com.filter(u => !beaten(u) && !tombedHere(unitTombId(ref, u))).concat(loc);
}
/* Writing a unit down. Andrew Fisher, 14 Sep 2026: everything on the maps is clickable, and a place with no data can
   be added to — this is the way. A numbered place on a drawing that no schedule row
   names gets its record from a person standing there: which reference, the thing's own name, its asset
   number. One write, stamped, and the marker, the drawer, the register and the drop sheet all read it. */
/* what THIS browser holds, raw — the writers work on this, never on the folded list, or a committed unit
   would be copied into the local record the first time anybody touched anything else on the reference */
function unitsLocal(ref){
  const r = (S.units || {})[ref];
  return (r && Array.isArray(r.units) ? r.units : []).filter(u => u && (u.label || u.asset_no));
}
/* is this one the build read, rather than one typed here */
function unitIsCommitted(ref, u){
  return ((CROW.get(ref) || {}).units || []).some(x => x && sameUnit(u, x));
}
/* the id a committed unit is taken out by — its number where it has one, else its name */
function unitTombId(ref, u){
  return 'unit/' + ref + '/' + String((u && (u.asset_no || u.label)) || '');
}
function unitsSet(ref, list){
  S.units = S.units || {};
  const keep = (list || []).filter(u => u && (u.label || u.asset_no || u.callout));
  if (keep.length) S.units[ref] = {units: keep};
  else delete S.units[ref];
  stampIt('units', ref);
}
function unitAdd(ref, u){
  if (!mayWrite('that unit')) return false;
  if (!isRef(ref)) { flash(String(ref || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  const label = String(u.label || '').trim(), asset_no = String(u.asset_no || '').trim().replace(/\s+/g, '');
  const sheet = String(u.sheet || '').trim(), callout = String(u.callout || '').trim();
  if (!label && !asset_no) { flash('Give the unit a name or an asset number — one of the two is needed to tell it apart.'); return false; }
  if (asset_no && !/^[A-Za-z0-9-]{3,12}$/.test(asset_no)) { flash('An asset number is digits, sometimes with letters — 1322588, not ' + asset_no + '.'); return false; }
  if (callout && !sheet) { flash('A place on a drawing needs the drawing — pick the sheet.'); return false; }
  const list = unitsLocal(ref).slice();
  /* recording it again after taking it out is a putting-back, and is recorded as one */
  untomb(unitTombId(ref, {asset_no, label}));
  /* ONE PLACE, ONE THING. Design audit, 15 Sep 2026, A03: T0001 could put a board at D025 place 01 and T0002 could
     then put one at D025 place 1 — the same place, written two ways — and the marker answered with whichever
     was recorded first. Within one reference the later unit replaces the earlier at that place (below); across
     references the second is refused and told what is standing there, because the page has no way to know
     which of two people was right, and a person does. Records already in that state are not touched here —
     they need a person to choose. */
  if (sheet && callout) {
    const other = allUnits().find(x => x.ref !== ref && x.sheet === sheet && calloutKey(x.callout) === calloutKey(callout));
    if (other) { flash('Place ' + callout + ' on ' + sheet + ' already has ' + (other.label || 'asset ' + other.asset_no) + ' from ' + other.ref
                       + ' standing on it. Move that one first, or pick the place this one is really on.'); return false; }
  }
  /* the same place on the same sheet is one place: a second unit recorded there replaces the first, named */
  const clash = list.find(x => sheet && callout && x.sheet === sheet && calloutKey(x.callout) === calloutKey(callout));
  const same = list.find(x => sameUnit({asset_no, label}, x));
  const rec = {label: label || null, asset_no: asset_no || null, sheet: sheet || null, callout: callout || null, by: who, at: new Date().toISOString()};
  let out;
  if (same) out = list.map(x => x === same ? Object.assign({}, x, rec) : x);
  else out = list.concat([rec]);
  if (clash && clash !== same) out = out.filter(x => x !== clash);
  unitsSet(ref, out);
  bump(); buzz(30);
  flash((label || 'Asset ' + asset_no) + ' recorded inside ' + ref + (callout ? ' at ' + callout + (sheet ? ' on ' + sheet : '') : '') + ' by ' + who
        + (clash && clash !== same ? ' — it replaces ' + (clash.label || clash.asset_no) + ' at that place.' : '.'));
  return true;
}
/* Taking one out. Two kinds sit in the same list and they come out differently: one typed on this device is
   dropped from the local record, and one the BUILD read is set aside with a tombstone — it is in the committed
   ops file and the next rebuild would put it straight back otherwise, exactly as a schedule's asset number
   would. Either way the removal is written down, travels, and can be undone by recording it again. */
function unitRemove(ref, which){
  if (!mayWrite('that unit')) return false;
  const who = whoAmI(); if (!who) return false;
  const shown = unitsOf(ref);
  /* v5.59 — the unit is named by what it IS (its number, else its name), never by its position in a list: the
     drawer's list is the units that are not contents, so a position in it is not a position in the record */
  const gone = typeof which === 'number' ? shown[which]
    : shown.find(u => which && ((which.asset_no && String(u.asset_no || '') === String(which.asset_no))
                                || (!which.asset_no && which.label && String(u.label || '') === String(which.label))));
  if (!gone) return false;
  const local = unitsLocal(ref).filter(u => !((gone.asset_no && u.asset_no === gone.asset_no)
    || (!gone.asset_no && gone.label && u.label === gone.label)));
  unitsSet(ref, local);
  const committed = unitIsCommitted(ref, gone);
  if (committed) tomb(unitTombId(ref, gone));
  bump();
  flash((gone.label || gone.asset_no || 'the unit') + ' taken out of ' + ref + ' by ' + who
    + (committed ? ' — it came off the committed record, so the removal is written down and travels.' : '.'));
  return true;
}
/* the small form that records one unit — the drawer's block and the map's empty callout both use it */
function unitForm(ref, pre){
  const p = pre || {};
  const sheets = DATA.sheets.map(s => `<option value="${esc(s.sheet_id)}"${p.sheet === s.sheet_id ? ' selected' : ''}>${esc(s.sheet_id)} — ${esc(s.title)}</option>`).join('');
  return `<div class="form uform" data-uform="${esc(ref || '')}">
    <div class="row2">
      ${ref ? '' : `<div class="f"><label for="uRef">Reference</label><input id="uRef" list="refs-all" placeholder="P33, WC16, T0001…" autocomplete="off">
        <datalist id="refs-all">${allAssets().map(a => `<option value="${esc(a.key)}">${esc(a.name || '')}</option>`).join('')}</datalist>
        <div class="hint">the schedule row this thing belongs to</div></div>`}
      <div class="f"><label for="uNo">Coates asset number</label><input id="uNo" inputmode="numeric" placeholder="1322588" value="${esc(p.asset_no || '')}"></div>
      <div class="f"><label for="uLab">Its name on site</label><input id="uLab" placeholder="vms3, female block, north unit…" value="${esc(p.label || '')}"></div>
    </div>
    <div class="row2">
      <div class="f"><label for="uSheet">Drawing</label><select id="uSheet"><option value="">— not on a drawing —</option>${sheets}</select></div>
      <div class="f"><label for="uCall">Numbered place on it</label><input id="uCall" placeholder="033" value="${esc(p.callout || '')}"></div>
    </div>
    <div><button type="button" class="btn primary" data-usave>Record it</button></div>
  </div>`;
}
function wireUnitForm(root, after){
  const f = root.querySelector('[data-uform]'); if (!f) return;
  const go = () => {
    const ref = f.dataset.uform || ((f.querySelector('#uRef') || {}).value || '').trim().toUpperCase();
    const ok = unitAdd(ref, {asset_no: f.querySelector('#uNo').value, label: f.querySelector('#uLab').value,
                             sheet: f.querySelector('#uSheet').value, callout: f.querySelector('#uCall').value});
    if (ok && after) after(ref);
  };
  f.querySelector('[data-usave]').onclick = go;
  f.querySelectorAll('input').forEach(i => i.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); go(); } });
}
/* Every unit on the job, so a callout can be resolved without knowing which reference it belongs to. */
function allUnits(){
  const out = [];
  Object.entries(S.units || {}).forEach(([ref, r]) => {
    if (r && Array.isArray(r.units)) r.units.forEach(u => { if (u && (u.label || u.asset_no)) out.push(Object.assign({ref}, u)); });
  });
  return out;
}
/* What is standing at a numbered place on a drawing. The callout is compared as the drawing writes it, trimmed
   and case-folded, because a sheet writes 01 and a person types 1. */
const calloutKey = v => String(v == null ? '' : v).trim().toUpperCase().replace(/^0+(?=\d)/, '');
function unitAt(sheetId, callout){
  const c = calloutKey(callout);
  if (!c) return null;
  return allUnits().find(u => u.sheet === sheetId && calloutKey(u.callout) === c) || null;
}
/* One unit's whole story, in the words a person would say it: which board, its number, where it stands, what
   row it belongs to and what the record says about that row. */
function unitWords(u){
  if (!u) return '';
  const a = allAssets().find(x => x.key === u.ref);
  const d = deliveryOf(u.ref);
  const bits = [];
  if (u.label) bits.push(u.label);
  if (u.asset_no) bits.push('asset ' + u.asset_no);
  if (u.callout) bits.push('at ' + u.callout + (u.sheet ? ' on ' + u.sheet : ''));
  bits.push(u.ref + (a && a.name ? ' — ' + a.name : ''));
  bits.push(d.recorded ? deliveryView(a || u.ref).short.toLowerCase() + (d.done ? ', complete' : '')
                         + (d.set_at ? ' ' + fmtStamp(d.set_at) : '')
                       : 'no delivery recorded');
  return bits.join(' · ');
}
/* A photograph belongs to the reference, or to ONE UNIT inside it — `unit` is that unit's asset number. WC16 is
   two toilet blocks, 1322587 and 1322588, and Andrew Fisher photographed each one on 14 Sep 2026: two pictures
   of the reference would have had to leave one building out. Each group — the reference, and each unit — has
   its own DROP_MAX places. */
const unitKey = u => String(u == null ? '' : u).trim();
function dropPhotosOf(key){
  const r = (S.dropPhotos || {})[key];
  const list = r && Array.isArray(r.photos) ? r.photos : [];
  return list.filter(x => x && x.id);
}
function dropPhotoSlots(key, unit, opts){
  const u = unitKey(unit);
  const got = dropPhotosOf(key).filter(x => unitKey(x.unit) === u), out = [];
  for (let i = 0; i < DROP_MAX; i++) out.push(got.find(x => x.slot === i) || null);
  /* a photograph whose slot was lost — an older record, a hand-edited file — still gets shown, in the first
     free place, rather than disappearing because a number is missing */
  got.filter(x => typeof x.slot !== 'number' || !out.includes(x)).forEach(x => { const i = out.indexOf(null); if (i > -1) out[i] = x; });
  /* v5.59 — on a reference with ONE asset number, a photograph recorded against the reference is a photograph
     of that building: it is shown in that number's places (its own first), and the record is not rewritten.
     Where the number's own places are already full, the reference's photographs are shown AFTER them rather
     than not at all — a photograph the record holds is never hidden because the places ran out. The extra
     places are for showing only: nothing can be added into them, and each keeps its real home for its own
     Replace and Remove. */
  if (u && opts && opts.foldReference) {
    dropPhotoSlots(key, '').filter(Boolean).forEach(x => {
      if (out.some(y => y && String(y.id) === String(x.id))) return;
      const folded = Object.assign({}, x, {_fromReference: true});
      const i = out.indexOf(null);
      if (i > -1) out[i] = folded; else out.push(folded);
    });
  }
  return out;
}
/* the groups a reference's photographs fall into: the reference itself, then each asset number known against it */
/* v5.59 — the BUILDINGS on a reference: its own numbers, less anything that is a thing inside it (a fridge, an
   air conditioner, a waste tank). One place for that rule, read by the labour lines and the photograph slots. */
function buildingNumbersOf(a){
  const x = (a && a.key) ? a : allAssets().find(y => y.key === a);
  if (!x) return [];
  const base = Array.isArray(x._buildingNumbers) ? x._buildingNumbers : assetNumbersOf(x);
  return base.filter(n => !/^MISCITEM$/i.test(n));
}
function dropPhotoUnits(a){
  const nums = buildingNumbersOf(a);
  const extra = dropPhotosOf(a.key || a).map(x => unitKey(x.unit)).filter(u => u && !nums.includes(u));
  return nums.concat([...new Set(extra)]);
}
/* ------------------------------------------------------------------ resolving a photograph to a real file
   Superior Audit, 15 Sep 2026, F03. The P33 sheet printed two black rectangles where its photographs should
   have been: the page asked the service for `drop_P33_u453375_1_20260914-152751.jpg` while the file sitting on
   the service was `20260914_152751.jpg`, the name the phone gave it. The record held a pointer that had been
   BUILT from a naming rule rather than TAKEN from the upload's answer, so the two drifted the moment a picture
   reached the service by any other road — the Documents tab, the admin page, a restore from an export.

   The upload path was already right: it stores up.id, what the service called the file. This resolves what is
   already in the record, and it never reconstructs a name. An explicit service ID must match exactly. Only
   clearly legacy filename identities may use an unambiguous name match; collisions require review. If no
   verified match is on the service the answer is null, and null is DRAWN — "Photo unavailable" with the pointer that
   failed printed under it, because a black rectangle on a drop sheet looks like a photograph of the dark. */
function dropFileIndex(){
  const files = (DOCS && DOCS.files) || null;
  if (!files) return null;
  const exactId = new Map(), foldedId = new Map(), exactName = new Map(), foldedName = new Map();
  const add = (ix, key, file) => {
    if (!key) return;
    const list = ix.get(key) || [];
    if (!list.some(x => x.id === file.id)) list.push(file);
    ix.set(key, list);
  };
  Object.keys(files).forEach(key => {
    const value = files[key]; if (!value || typeof value !== 'object') return;
    const f = Object.assign({}, value, {id: String(value.id || key)});
    add(exactId, String(key), f); add(exactId, f.id, f);
    add(foldedId, String(key).toLowerCase(), f); add(foldedId, f.id.toLowerCase(), f);
