  const cents = n => Math.round(n * 100) / 100;
  list.forEach(g => { g.spend = cents(g.spend); g.out = g.spend; COST_KINDS.forEach(k => { g.kinds[k.key].amount = cents(g.kinds[k.key].amount); }); });
  const named = list.filter(g => g.code).sort((a, b) => (b.out + b.contract.charge) - (a.out + a.contract.charge) || (b.hire + b.transport) - (a.hire + a.transport) || a.code.localeCompare(b.code));
  const none = list.find(g => !g.code) || null;
  const all = {hire: list.reduce((s, g) => s + g.hire, 0), transport: list.reduce((s, g) => s + g.transport, 0), spend: cents(list.reduce((s, g) => s + g.spend, 0)),
               hours: list.reduce((s, g) => s + g.hours, 0), lines: rows.length, linked: rows.filter(r => branchOf(r.a.key).code).length,
               pos: poAll().length, invoiced: list.reduce((s, g) => s + g.invoiced, 0), kinds: {},
               contract: contractFigures(ONHIRE_ROWS), ours: {transport: ourTotals(OC.filter(c => c.kind === 'transport')), lines: OC}};
  COST_KINDS.forEach(k => all.kinds[k.key] = {amount: cents(list.reduce((s, g) => s + g.kinds[k.key].amount, 0)), hours: list.reduce((s, g) => s + g.kinds[k.key].hours, 0), lines: list.reduce((s, g) => s + g.kinds[k.key].lines, 0)});
  /* The figures as every page prints them: each column rounded as a set, so a branch plate, the Costs tab's
     table, the email and the print all show the same dollars and each column adds to its own total. */
  const col = (read, write) => { const d = dollarSplit(list.map(read)); list.forEach((g, i) => write(g, d[i])); };
  col(g => g.hire, (g, v) => g.hire0 = v);
