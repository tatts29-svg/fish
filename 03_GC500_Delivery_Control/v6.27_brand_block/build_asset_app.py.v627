  catch (e) { try { bmp = await createImageBitmap(file); } catch (e2) { bmp = null; } }
  if (!bmp) return {blob: file, w: null, h: null, shrunk: false};   // this browser will not decode it — send what we were handed
  const s = Math.min(1, DROP_PX / Math.max(bmp.width, bmp.height));
