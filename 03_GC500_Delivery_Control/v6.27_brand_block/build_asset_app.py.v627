  return true;
}
function mapRefOf(key){ const m = (S.mapRef || {})[key]; return m && m.id ? m : null; }
/* every map a reference could carry: the drawing sheets the page holds, then every map in the service's
   library — the ones filed against this reference first */
function mapChoices(key){
  const out = [];
  (DATA.sheets || []).forEach(sh => out.push({id: sh.key, name: (sh.sheet_id || sh.key) + ' · ' + (sh.title || ''), kind: 'sheet', group: 'Drawings in this page'}));
  try {
    const ix = photoIndex();
    if (ix.state === 'ready') Object.values(ix.files || {}).filter(f => f && f.kind === 'map').sort((x, y) => (String(y.ref || '') === String(key)) - (String(x.ref || '') === String(key)) || String(x.uploaded || '').localeCompare(String(y.uploaded || '')))
      .forEach(f => out.push({id: String(f.id), name: (f.title || f.name || f.id) + (f.ref ? ' · filed against ' + f.ref : ''), kind: 'file', group: 'Maps in the document library', filed: String(f.ref || '') === String(key)}));
  } catch (e) {}
  return out;
}
function mapRefLine(key){
  const m = mapRefOf(key); if (!m) return '';
  let open = '';
  if (m.kind === 'sheet') open = `<button class="linkish" data-mapsheet="${esc(m.id)}">open on the Map tab</button>`;
  else if (SYNC.backend && SYNC.backend.fileUrl) open = `<a href="${esc(SYNC.backend.fileUrl(m.id))}" target="_blank" rel="noopener">open the file</a>`;
  else open = '<span class="w">a file on the shared record\'s service — open it from the hosted link</span>';
  return `<div class="maprefline">Map attached: <b>${esc(m.name)}</b> — ${esc(m.by || 'unnamed')}${m.at ? ' · ' + esc(fmtStamp(m.at)) : ''} · ${open}</div>`;
}
/* Every item type the job knows, for the selection lists: the rate card's lines, every type on the register and
   the plant lines, and anything a person has typed already — one sorted list, so a type chosen here always
   matches what Pricing prices and the plates count. */
function itemTypeOptions(disc){
  const s = new Set();
  const take = (d, t) => { if (t && (!disc || !d || d === disc)) s.add(t); };
  (DATA.assets || []).forEach(a => (a.item_types || []).forEach(t => take(a.discipline, t)));
  PLANT_LINES.forEach(a => (a.item_types || []).forEach(t => take(a.discipline, t)));
  (S.added || []).forEach(a => (a.item_types || []).forEach(t => take(a.discipline, t)));
  Object.entries(S.items || {}).forEach(([k, t]) => { const a = DATA.assets.find(x => x.key === k) || PLANT_LINES.find(x => x.key === k) || (S.added || []).find(x => x.key === k); take(a ? a.discipline : null, t); });
  RM_ITEMS.forEach((e, k) => take(e.discipline, e.item));
  return [...s].sort((x, y) => x.localeCompare(y, undefined, {numeric: true, sensitivity: 'base'}));
}
/* Who is recording. The build refuses a light with nobody's name on it, so the page does too — kindly. */
function whoAmI(){
  const w = ($('#who') && $('#who').value.trim()) || (S.operator || '').trim();
  if (w) { if (S.operator !== w) { S.operator = w; save(); } return w; }
  const box = $('#who');
  if (box) { box.classList.remove('need'); void box.offsetWidth; box.classList.add('need'); box.focus(); }
  flash('Put your name in "Recording as" first — every light carries the name of whoever set it.');
  return null;
}
function setLight(key, state){
  if (!mayWrite('the delivery light')) return false;
  if (!LIGHT[state]) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const now = new Date().toISOString();
  d.state = state; d.set_at = now; d.by = who;
  d.history = (d.history || []).concat([{state, at: now, by: who}]).slice(-400);
  /* complete means in position, set up, checked — a thing that is not on site cannot be that. The tick comes off
     with the light, as a record (who, when), so "complete" and "not on site" can never both be true of one asset. */
  let untick = [];
  if (state !== 'on site' && deliveryOf(key).done) {
    d.done = false; d.done_by = who; d.done_at = now;
    d.done_history = (d.done_history || []).concat([{done: false, at: now, by: who, because: state}]).slice(-400);
    untick.push('complete');
    if (deliveryOf(key).steps) {
      d.steps = false; d.steps_by = who; d.steps_at = now;
      d.steps_history = (d.steps_history || []).concat([{steps: false, at: now, by: who, because: state}]).slice(-400);
      untick.push('steps installed');
    }
    if (deliveryOf(key).levelled) {
      d.levelled = false; d.levelled_by = who; d.levelled_at = now;
      d.levelled_history = (d.levelled_history || []).concat([{levelled: false, at: now, by: who, because: state}]).slice(-400);
      untick.push('positioned and levelled');
    }
  }
  bump(); buzz(30);
  /* the message NAMES the ticks that came off — "its complete tick came off" was untrue the moment a reference
     could carry three of them, and a person who had ticked steps that morning deserves to be told it went */
  if (untick.length) flash(key + ' set to ' + LIGHT[state].label.toLowerCase() + ' by ' + who + ' — its '
    + (untick.length === 1 ? untick[0] + ' tick' : untick.slice(0, -1).join(', ') + ' and ' + untick[untick.length - 1] + ' ticks')
    + ' came off with it, on the record.');
  return true;
}
/* Typed fields save and redraw the tab behind the drawer, but leave the drawer itself alone — redrawing an
   input while somebody is typing into it throws their cursor out. The drawer catches up the next time it is
   drawn, and the hint under the field is patched in place so the screen is never wrong in the meantime. */
function setEta(key, eta){
  if (!mayWrite('the planned time')) return false;
  if (!isRef(key)) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const v = String(eta || '').trim();
  if (/^([01]\d|2[0-3]):[0-5]\d$/.test(v)) d.eta = v; else delete d.eta;   // a time of day, 24-hour; anything else clears it
  stampIt('eta', key);
  if (deliveryEmpty(d)) delete S.delivery[key];
  save(); render();
  const box = document.getElementById('eta-' + key), hint = box && box.parentElement.querySelector('.hint');
  if (hint) hint.textContent = d.eta ? LW() : 'nobody has set a time yet';
}
function setDeliveryNote(key, note){
  if (!mayWrite('the note')) return false;
  if (!isRef(key)) return false;
  S.delivery = S.delivery || {};
  const d = S.delivery[key] || (S.delivery[key] = {});
  const v = String(note || '').trim();
  if (v) d.note = v; else delete d.note;
  stampIt('dnote', key);
  if (deliveryEmpty(d)) delete S.delivery[key];
  save(); render();
}
const fmtStamp = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso || '');
  try {
    const p = new Intl.DateTimeFormat('en-GB', {timeZone: 'Australia/Brisbane', day: '2-digit', month: '2-digit',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23'}).formatToParts(d);
    const value = k => (p.find(x => x.type === k) || {}).value || '';
    return `${value('day')} ${MON[Number(value('month')) - 1]} ${value('hour')}:${value('minute')}`;
  } catch (e) { return d.toISOString() + ' (UTC)'; }
};
/* The light as a chip. `full` adds the words; `eta` adds the planned time. */
function lightChip(a, opts){
  const o = opts || {}, d = deliveryOf(a.key || a), L = LIGHT[d.state];
  const title = d.where === 'rental'
    ? `${L.word} — on site: the Coates rental system has it on hire from ${fmtDate(d.rental.from)}${d.rental.from_time ? ' ' + d.rental.from_time : ''}${d.rental.numbers.length ? ' (asset no. ' + d.rental.numbers.filter(n => String(n).toUpperCase() !== 'MISCITEM').join(', ') + ')' : ''}. Nobody has set a light; set one to override it.`
    : d.recorded
    ? `${L.word} — ${L.label.toLowerCase()}, set ${fmtStamp(d.set_at)} by ${d.by || 'unnamed'}${d.where === 'local' ? ` (${LW()})` : d.where === 'rental' ? ' (rental system)' : ' (committed)'}`
    : 'No delivery record — nobody has recorded a delivery for this reference yet. That is not the same as a record saying it is not here.';
  return `<span class="tl ${d.recorded ? L.c : 'none'}${d.recorded && d.where === 'rental' ? ' hire' : ''}" role="img" title="${esc(title)}" aria-label="${esc(title)}"><i></i>${
    o.full ? (d.recorded ? esc(L.label) + (d.where === 'rental' ? ' <span class="w">on hire</span>' : '') : 'No delivery record') : ''}${
    o.eta && d.eta ? ` <span class="eta" title="planned time to site">${esc(d.eta)}</span>` : ''}</span>`;
}
/* The reference plate. `px` is the type size the surface wants; everything else on the plate scales from it. */
function refPlate(key, px, cls){
  const k = String(key == null ? '' : key);
  return `<span class="rplate${cls ? ' ' + cls : ''}"${px ? ` style="font-size:${px}px"` : ''}>${esc(k)}</span>`;
}
/* ------------------------------------------------------------------ the delivery status instrument
   The register row, the equipment card, the drawer and the printed sheet all call THIS, so one reference cannot
   read one way on a screen and another on paper: same resolved facts, same words, same lens. `size` picks the
   housing — 'sm' for a dense row, nothing for a card, 'lg' for the detail. `bare` drops the words for a spot
   that already carries them.
   Unknown lights no lens, and that is the whole reason the instrument exists. "Nobody has told us" and
   "somebody told us it is not here" are different facts, and for as long as they shared a red pip a person
   glancing down a register could not tell which one they were looking at. */
/* Which state each reference was last DRAWN in, so the power-on plays only when a state actually changes
   in front of the person — never on the first paint of 193 rows, never on a tab switch, never when a newer
   snapshot loads over the same states. The brief's own rule: distinguish hydration from an event. */
const LAMP_SEEN = new Map(); let LAMP_GEN = 0;
function lampJust(key, state){
  const prev = LAMP_SEEN.get(key);
  if (!prev) { LAMP_SEEN.set(key, {state, gen: -1}); return false; }          // first sight: no ceremony
  if (prev.state !== state) { LAMP_SEEN.set(key, {state, gen: LAMP_GEN}); return true; }
  return prev.gen === LAMP_GEN;                                              // same change, drawn again this pass
}
/* The housing. One SVG per instrument, all the materials shared from the defs at the top of the body. Drawn in
   a 156 x 60 space and scaled, so the row, the card, the drawer and the printed sheet are the same drawing at
   different sizes — not three approximations of each other. Three lenses at fixed positions: red left, amber
   centre, green right. */
const LAMP_COL = {r: '#ff3b2f', a: '#ffb300', g: '#2ee56f'};
const LAMP_CX = {r: 30, a: 78, g: 126};
function lampSvg(lit, w, h){
  /* one lens: the raised bezel, the recess, the LED array, the lamp (drawn for every lens, shown for one),
     the bezel's shadow on the array, the glass, the rim */
  const lens = c => `<g class="lens ${c}" transform="translate(${LAMP_CX[c]} 30)">
      <circle class="bz" r="22.4" fill="url(#hzBezel)"/>
      <circle class="bz2" r="20.3" fill="url(#hzBezelIn)"/>
      <circle class="gap" r="19.2" fill="#050506"/>
      <circle class="well" r="18" fill="url(#hzWell)"/>
      <circle class="dots off" r="18" fill="url(#hzDotsOff${c.toUpperCase()})"/>
      <g class="lamp">
        <circle class="bloom" r="29" fill="${LAMP_COL[c]}" opacity=".5" filter="url(#hzBloom)"/>
        <circle class="halo" r="20.6" fill="none" stroke="${LAMP_COL[c]}" stroke-width="3.2" opacity=".55" filter="url(#hzHalo)"/>
        <circle class="core" r="18" fill="url(#hzCore${c.toUpperCase()})"/>
        <circle class="dots on" r="18" fill="url(#hzDotsOn${c.toUpperCase()})"/>
        <circle class="hot" r="7" fill="#fff" opacity=".34" filter="url(#hzHot)"/>
      </g>
      <circle class="shade" r="18" fill="url(#hzShade)"/>
      <path class="rimhi" d="M-15.6 -9A18 18 0 0 1 -3 -17.7" fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="1" stroke-linecap="round"/>
      <ellipse class="glass" cx="-6" cy="-8.5" rx="9.5" ry="5.8" fill="url(#hzGlass)"/>
      <circle class="rim" r="18" fill="none" stroke="#000" stroke-opacity=".65" stroke-width="1"/></g>`;
  const bolt = (x, y) => `<g class="bolt" transform="translate(${x} ${y})"><circle r="2.6" fill="url(#hzBolt)"/>
      <circle r="2.6" fill="none" stroke="#000" stroke-opacity=".55" stroke-width=".6"/>
      <polygon points="1.15,0 .575,1 -.575,1 -1.15,0 -.575,-1 .575,-1" fill="#0a0a0b" fill-opacity=".85"/></g>`;
  const oct = 'M6 0H150L156 6V54L150 60H6L0 54V6Z';
  return `<svg class="hz" viewBox="0 0 156 60" width="${w}" height="${h}" aria-hidden="true" focusable="false">
    <path class="body" d="${oct}" fill="url(#hzBody)"/>
    <path class="sheen" d="${oct}" fill="url(#hzSheen)"/>
    <path class="panel" d="M9.2 4.4H146.8L151.6 9.2V50.8L146.8 55.6H9.2L4.4 50.8V9.2Z" fill="url(#hzPanel)" stroke="#000" stroke-opacity=".5" stroke-width=".8"/>
    <path class="bevel" d="M4.4 50.8V9.2L9.2 4.4H146.8" fill="none" stroke="#000" stroke-opacity=".55" stroke-width="1"/>
    <path class="bevel" d="M151.6 9.2V50.8L146.8 55.6H9.2" fill="none" stroke="#fff" stroke-opacity=".07" stroke-width="1"/>
    <path class="edge" d="${oct}" fill="none" stroke="#000" stroke-opacity=".8" stroke-width="1"/>
    <path class="edgehi" d="M1 53.6V6.4L6.4 1H149.6" fill="none" stroke="#fff" stroke-opacity=".18" stroke-width="1"/>
    ${bolt(5.6, 5.6)}${bolt(150.4, 5.6)}${bolt(5.6, 54.4)}${bolt(150.4, 54.4)}
    ${lens('r')}${lens('a')}${lens('g')}
  </svg>`;
}
const LAMP_SIZE = {sm: [78, 30], md: [106, 41], lg: [158, 61], xl: [234, 90]};
/* ------------------------------------------------------------------ the delivery status instrument
   The register row, the equipment card, the drawer and the printed sheet all call THIS, so one reference cannot
   read one way on a screen and another on paper: same resolved facts, same words, same lens. `size` picks the
   housing — 'sm' for a dense row, nothing for a card, 'lg' for the detail. `bare` drops the words for a spot
   that already carries them.
   Unknown lights no lens, and that is the whole reason the instrument exists. "Nobody has told us" and
   "somebody told us it is not here" are different facts, and for as long as they shared a red pip a person
   glancing down a register could not tell which one they were looking at. */
function dstat(a, opts){
  const o = opts || {}, key = a && a.key ? a.key : a, v = deliveryView(key), d = v.d;
  const known = v.recorded;
  const word = v.label, why = v.why, said = v.said;
  const state = v.c;
  const just = lampJust(key, state);
  const [w, h] = LAMP_SIZE[o.size || 'md'] || LAMP_SIZE.md;
  const cls = `dstat ${state}${known && d.where === 'rental' ? ' hire' : ''}${
      o.size ? ' ' + o.size : ''}${o.bare ? ' bare' : ''}${just ? ' just' : ''}${o.ctl ? ' ctl' : ''}`;
  const words = `<span class="ds-w"><b>${esc(word)}</b><em>${esc(why)}</em></span>`;
  /* the control edition: the SAME instrument, with a press target over each lens. The thing a person presses
     is the thing that shows the result — no second row of buttons pretending to be lamps. A role of group,
     because an image cannot hold buttons; the words stay in the flow so the state is still read out. */
  if (o.ctl) return `<span class="${cls}" title="${esc(said)}"
    >${lensBtns(key, d, !!o.labels, lampSvg(state, w, h))}${words}</span>`;
  return `<span class="${cls}" role="img" title="${esc(said)}" aria-label="${esc('Delivery: ' + said)}"
    >${lampSvg(state, w, h)}${words}</span>`;
}
/* The three press targets, one over each lens, wired once by delegation (below) so a row in any table can set
   a light. `labels` puts the state's words under each lens — the drawer's big control says its words, because a
   thumb on a phone gets no hover title. */
const LENS_OF = {'not on site': 'r', 'in transit': 'a', 'on site': 'g'};
function lensBtns(key, d, labels, svg){
  /* the buttons come BEFORE the drawing in the markup, so plain sibling selectors can light the lens under a
     hovered or focused button — no :has(), which the older site WebViews drop along with every rule around it */
  return `<span class="tlset hzc${labels ? ' big' : ''}" role="group" aria-label="Set the traffic light for ${esc(key)}">${
    LIGHT_ORDER.map(s => `<button type="button" class="lb ${LENS_OF[s]}" data-light="${esc(key)}" data-s="${s}" aria-pressed="${d.recorded && d.state === s}"
      title="${esc(LIGHT[s].word + ' — ' + LIGHT[s].label.toLowerCase())}" aria-label="${esc(LIGHT[s].word + ', ' + LIGHT[s].label.toLowerCase())}">${
      labels ? `<span class="tlw" aria-hidden="true">${esc(LIGHT[s].label)}</span>` : ''}</button>`).join('')}${svg}</span>`;
}
/* The setter on its own: the control edition of the instrument at the size the surface wants. */
function lightSet(key, small){
  return dstat(key, {size: small ? 'sm' : 'xl', ctl: true, labels: !small});
}
/* Capture phase, so a light or a time box sitting inside a clickable table row sets the light without also
   opening the row's drawer — by the time a bubbling listener saw the click the row would already have fired. */
document.addEventListener('click', e => {
  const b = e.target.closest('[data-light]');
  if (b) { e.stopPropagation(); e.preventDefault(); setLight(b.dataset.light, b.dataset.s); return; }
  /* THE TICK BUTTONS CARRY A REFERENCE; A MAP PIN CARRIES A FLAG. Both spell it `data-levelled`, and a handler
     that matched the attribute alone swallowed every click on a levelled pin — `closest('[data-levelled]')`
     found the marker, `isRef('1')` said no, and the branch had ALREADY called stopPropagation, so the pin's own
     handler never ran and the asset never opened. Every building Andrew Fisher levelled went dead on the map
     the moment he ticked it, from 15 Sep until this was found on 16 Sep by the four he reported that morning.
     So the guard comes FIRST: a match that does not name a reference in this file is not a tick button, and the
     click is left alone to reach whatever it was really on. Held by tests/test_accessories_off.py. */
  const tk = e.target.closest('[data-done]');
  if (tk && isRef(tk.dataset.done)) { e.stopPropagation(); e.preventDefault(); setDone(tk.dataset.done, !deliveryOf(tk.dataset.done).done); return; }
  const sp = e.target.closest('[data-steps]');
  if (sp && isRef(sp.dataset.steps)) { e.stopPropagation(); e.preventDefault(); setSteps(sp.dataset.steps, !deliveryOf(sp.dataset.steps).steps); return; }
  const lv = e.target.closest('[data-levelled]');
  if (lv && isRef(lv.dataset.levelled)) { e.stopPropagation(); e.preventDefault(); setLevelled(lv.dataset.levelled, !deliveryOf(lv.dataset.levelled).levelled); return; }
  /* the instrument's scope switch: a viewing choice, like the View date beside it. It writes nothing, so it
     stays live on a view-only link (data-ro), and it redraws only the page it is on. */
  const gs = e.target.closest('[data-gscope]');
  if (gs) { e.stopPropagation(); e.preventDefault();
    if (state.gscope !== gs.dataset.gscope) { state.gscope = gs.dataset.gscope; if (state.tab === 'progress') renderProgress(); else render(); }
    return; }
  const sf = e.target.closest('[data-sigfilter]');
  if (sf) { e.stopPropagation(); e.preventDefault();
    state.light = sf.dataset.sigfilter || null; state.disc = null; go('register'); return; }
  const ck = e.target.closest('[data-cancelk]');
  if (ck) { e.stopPropagation(); e.preventDefault(); cancelDialog(ck.dataset.cancelk); return; }
  const rk = e.target.closest('[data-restorek]');
  if (rk) { e.stopPropagation(); e.preventDefault(); if (setRowOff(rk.dataset.restorek, false)) render(); return; }
  const nd = e.target.closest('[data-nextday]');
  if (nd) { e.stopPropagation(); e.preventDefault(); const to = nextDayOf(nd.dataset.nextday);
    if (to && setDate(nd.dataset.nextday, to, 'in')) { buzz(30); render(); } return; }
  const fd = e.target.closest('[data-fdone]');
  if (fd) { e.stopPropagation(); e.preventDefault(); setFenceAreaDone(fd.dataset.fdone, !fenceAreaDone(fd.dataset.fdone).done); return; }
  /* v5.49 — the button that pins where you are standing, and the one that takes it off again. */
  const pin = e.target.closest('[data-pin]');
  if (pin) { e.stopPropagation(); e.preventDefault(); buzz(20); pinMyLocation(pin.dataset.pin, () => render()); return; }
  /* v5.53 — a reference given to a plant line, or taken off it */
  const rg = e.target.closest('[data-refgive]');
  if (rg) { e.stopPropagation(); e.preventDefault(); const inp = document.querySelector('#giveRefIn'); const ref = inp ? inp.value : '';
    if (giveLineReference(rg.dataset.refgive, ref)) { const g = givenRefOf(rg.dataset.refgive); render(); if (g) openAsset(g.ref); } return; }
  const ro = e.target.closest('[data-refoff]');
  if (ro) { e.stopPropagation(); e.preventDefault(); const id = ro.dataset.refoff; if (takeLineReferenceOff(id)) { render(); openAsset(id); } return; }
  const pnf = e.target.closest('[data-pinoff]');
  if (pnf) { e.stopPropagation(); e.preventDefault(); clearMyLocation(pnf.dataset.pinoff); render(); return; }
  const po = e.target.closest('[data-placeopen]');
  if (po) { e.stopPropagation(); e.preventDefault();
    const box = document.getElementById('pf_' + po.dataset.placeopen.replace(/[^A-Za-z0-9]/g, '_'));
    if (box) { box.hidden = !box.hidden; if (!box.hidden) { const cur = placeOf(po.dataset.placeopen);
      const i = box.querySelector('.pfll'); if (i) { if (cur) i.value = cur.lat.toFixed(6) + ', ' + cur.lon.toFixed(6); i.focus(); }
      const h = box.querySelector('.pfhow'); if (h && cur && cur.how) h.value = cur.how; } }
    return; }
  const pc = e.target.closest('[data-placecancel]');
  if (pc) { e.stopPropagation(); e.preventDefault();
    const box = document.getElementById('pf_' + pc.dataset.placecancel.replace(/[^A-Za-z0-9]/g, '_'));
    if (box) box.hidden = true; return; }
  const ps = e.target.closest('[data-placesave]');
  if (ps) { e.stopPropagation(); e.preventDefault();
    const key = ps.dataset.placesave;
    const box = document.getElementById('pf_' + key.replace(/[^A-Za-z0-9]/g, '_'));
    const raw = box ? (box.querySelector('.pfll') || {}).value || '' : '';
    const how = box ? ((box.querySelector('.pfhow') || {}).value || '').trim() : '';
    /* one box, both numbers, however they were pasted — a comma, a space, or both */
    const m = String(raw).trim().match(/^\s*(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (!m) { flash('Type the latitude and longitude as two numbers, like -27.985151, 153.429601 — nothing placed.'); return; }
    if (placeHere(key, m[1], m[2], {how: how || 'placed on the map'})) render();
    return; }
  const pof = e.target.closest('[data-placeoff]');
  if (pof) { e.stopPropagation(); e.preventDefault(); clearPlace(pof.dataset.placeoff); render(); return; }
  const pen = e.target.closest('[data-pinentry]');
  if (pen) { e.stopPropagation(); e.preventDefault(); buzz(20); pinEntry(pen.dataset.pinentry, () => render()); return; }
  const eof = e.target.closest('[data-entryoff]');
  if (eof) { e.stopPropagation(); e.preventDefault(); clearEntry(eof.dataset.entryoff); render(); return; }
  const cp = e.target.closest('[data-copypos]');
  if (cp) {
    e.stopPropagation(); e.preventDefault();
    const t = cp.dataset.copypos;
    (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject(new Error('no clipboard')))
      .then(() => flash('Copied ' + t), () => flash('Could not copy — the position is ' + t));
    return;
  }
  /* taking a branch code or a plant number off an on-hire line: the extract offers, a person accepts, and the
     record carries their name — the rental system never writes into the site record by itself */
  const tb = e.target.closest('[data-take-branch]');
  if (tb) { e.stopPropagation(); e.preventDefault();
    if (setBranch([tb.dataset.takeKey], tb.dataset.takeBranch)) bump();
    return; }
  const tn = e.target.closest('[data-take-nos]');
  if (tn) { e.stopPropagation(); e.preventDefault();
    const key = tn.dataset.takeKey, nos = tn.dataset.takeNos.split(',').filter(Boolean);
    if (!isRef(key)) { flash(key + ' is not a reference in this file — nothing recorded.'); return; }
    if (!whoAmI()) return;
    const have = new Set((S.assetNumbers[key] || []).concat((allAssets().find(x => x.key === key) || {}).asset_numbers || []));
    const add = nos.filter(n => !have.has(n));
    if (!add.length) { flash(key + ' already carries ' + (nos.length === 1 ? 'that asset number' : 'those asset numbers') + '.'); return; }
    S.assetNumbers[key] = (S.assetNumbers[key] || []).concat(add);
    bump(); flash(add.length + ' asset number' + (add.length === 1 ? '' : 's') + ' from the rental extract put on ' + key + '.');
    return; }
  if (e.target.closest('[data-eta],[data-dnote],[data-date],[data-outdate],[data-branch]')) e.stopPropagation();
}, true);
document.addEventListener('change', e => {
  const t = e.target;
  if (!t.matches) return;
  if (t.matches('[data-eta]')) setEta(t.dataset.eta, t.value);
  else if (t.matches('[data-date]')) { if (!setDate(t.dataset.date, t.value, 'in')) t.value = effectiveDates(allAssets().find(x => x.key === t.dataset.date) || {}).in || ''; }
  else if (t.matches('[data-outdate]')) { if (!setDate(t.dataset.outdate, t.value, 'out')) t.value = effectiveDates(allAssets().find(x => x.key === t.dataset.outdate) || {}).out || ''; }
});
/* Counts for a list of assets, the way the KPIs and the day cards want them. `red` is everything not on site,
   recorded or not; `none` is the part of that nobody has recorded. */
/* The four buckets are MUTUALLY EXCLUSIVE and they add up to the total: green + amber + red + none === total.
   `red` used to include every reference nobody had spoken about, so a register of 193 could show "Red 189" and
   "No record 189" side by side and invite anybody reading it to add them to 378. Recorded-not-on-site and
   nothing-recorded are two different facts with two different actions, and each now has its own count.
   Anything that wants the union — everything not on site — adds red + none and says so. */
function lightTally(list, asOf){
  /* A cancelled reference is counted as cancelled and kept out of the live total. It is not "nothing recorded":
     nothing is coming, and a count that says otherwise is a count somebody acts on. */
  /* With a day, the lights are replayed to that day (deliveryAsOf), so a scene or a plate set to 15 Sep counts
     the greens that were on BY 15 Sep, not today's. Outside audit, 17 Sep 2026 (B03): the Showcase on a past
     day showed that day's units beside today's green-light count, under a footer saying every figure followed
     the day. Without a day, it is the live record, as it always was. */
  const live = list.filter(a => !a._cancelled);
  const t = {green:0, amber:0, red:0, none:0, done:0, levelled:0, steps:0, needLevel:0, total:live.length, cancelled:list.length - live.length, asOf: asOf || null};
  live.forEach(a => { const d = asOf ? deliveryAsOf(a.key, asOf) : deliveryOf(a.key);
    if (!d.recorded) t.none++; else t[d.c]++;
    if (d.done) t.done++;
    if (needsLevel(a)) { t.needLevel++; if (d.levelled) t.levelled++; if (d.steps) t.steps++; } });
  return t;
}
/* The filter every list shares: all, red, amber, green, only the ones with nothing recorded, or only the ticked. */
function lightMatches(a){
  if (state.light === 'cancelled') return !!a._cancelled;
  if (a._cancelled) return !state.light;
  if (!state.light) return true;
  const d = deliveryOf(a.key);
  /* the filter matches the counts above it: pressing "Not on site 4" gives four rows, not four plus every
     reference nobody has recorded */
  return state.light === 'none' ? !d.recorded : state.light === 'done' ? d.done
       : state.light === 'levelled' ? d.levelled : state.light === 'steps' ? d.steps
       : (d.recorded && d.c === state.light);
}
/* Superior Audit, 15 Sep 2026, F10: "Scope labels need to travel with every number." The same filter drawn
   over the whole register and over one day's rows gave two different counts of the same-looking thing — 174
   against 157 — because the two populations are different. Neither number was wrong and neither said what it
   had been counted over, so a person comparing the two screens had no way to tell a fall from a filter.
   The scope is now named on the bar and in every button's own title, and it is derived from the list the bar
   is actually drawn over, so it cannot describe a population the bar is not counting. */
function lightBar(list, lead, scope){
  const t = lightTally(list);
  const whole = allAssets().length;
  const sc = scope || (t.total === whole ? 'all ' + fmtNum(whole) + ' register records'
                                         : 'the ' + fmtNum(t.total) + ' references in this view, of ' + fmtNum(whole) + ' on the register');
  const btn = (v, cls, word, n, title) => `<button type="button" data-lf="${v}" aria-pressed="${(state.light||'') === v}" title="${esc(title + ' — counted over ' + sc)}">${
    cls === 'tick' ? '<span class="tick sm" aria-hidden="true">✓</span>' : cls === 'lvl' ? `<span class="tick sm lvl" aria-hidden="true">${levelGlyph(11)}</span>` : cls ? `<span class="tl ${cls}"><i></i></span>` : ''}${esc(word)} <b>${n}</b></button>`;
  return `<div class="lightbar" role="group" aria-label="Filter by traffic light, counted over ${esc(sc)}"><span class="lead">${esc(lead || 'Show')}</span>
    ${btn('', '', 'All', t.total, 'every reference in this list')}
    ${btn('red', 'red', 'Not on site', t.red, 'somebody recorded these as not on site — a record, not a default')}
    ${btn('amber', 'amber', 'In transit', t.amber, 'on the truck, between the yard and the gate')}
    ${btn('green', 'green', 'On site', t.green, 'on the ground where it is going')}
    ${btn('none', 'none', 'No record', t.none, 'nobody has recorded anything for these — no lamp is lit, and this is not a record of absence')}
    ${btn('done', 'tick', 'Complete', t.done, 'ticked complete — in position, set up, checked')}
    ${t.needLevel ? btn('levelled', 'lvl', 'Levelled', t.levelled, 'positioned and levelled — the final check that closes a building, toilet or tank off; ' + t.needLevel + ' in this list can carry it') : ''}
    ${t.needLevel ? btn('steps', 'stp', 'Steps', t.steps, 'steps installed — its own check, separate from levelled; ' + t.needLevel + ' in this list can carry it') : ''}
    ${t.cancelled ? btn('cancelled', '', 'Cancelled', t.cancelled, 'called off by name and date — still on the schedule, still here, but not work outstanding and not counted in the figures beside it') : ''}
    <span class="lfscope">of ${esc(sc)}</span></div>`;
}
document.addEventListener('click', e => {
  const b = e.target.closest('[data-lf]'); if (!b) return;
  state.light = b.dataset.lf || null; render();
});
/* The press, acknowledged. One listener in the capture phase so it fires before anything re-renders, on every
   control the page has — a marker, a filter chip, a button, a card. It adds a class that removes itself; it
   changes no state, blocks nothing, and if the element is gone by the time the animation ends (a re-render, a
   tab change) nothing is left behind. Right-clicks and modified clicks are not presses and are left alone. */
document.addEventListener('pointerdown', e => {
  if (e.button !== 0 || e.ctrlKey || e.metaKey || motionOff()) return;
  const t = e.target.closest('button, .mk, .hubcard, .day, a.btn, [role=button]');
  if (!t || t.disabled) return;
  t.classList.remove('lit');
  void t.offsetWidth;                       /* restart the animation when the same thing is pressed twice */
  t.classList.add('lit');
  const off = () => { t.classList.remove('lit'); t.removeEventListener('animationend', off); };
  t.addEventListener('animationend', off, {once: true});
  setTimeout(off, 700);
}, true);
/* One asset by its reference, including anything added in this page. */
function assetOf(key){ return allAssets().find(a => a.key === key) || (givenRefOf(key) ? allAssets().find(a => a.key === givenRefOf(key).ref) || null : null); }
/* The trades on the sheet in front of you, each on its own chip.
   Most iEDM sheets are one trade and this stays out of the way. D024 is two — generators and light towers on one
   drawing — so on that sheet the chips are the thing that keeps them apart without redrawing anybody's sheet.
   The counts are assets on this sheet, and the word beside a count says what it counts (locations, for the
   barrier sheet), because a row is not always a thing. */
function discBar(onSheet){
  const ds = [...new Set(onSheet.map(a => a.discipline))].sort();
  if (ds.length < 2) { if (state.mapDisc) state.mapDisc = null; return ''; }
  if (state.mapDisc && !ds.includes(state.mapDisc)) state.mapDisc = null;
  /* THE SAME POPULATION AS THE LIGHTS BAR UNDER IT. The tester audit of 16 Sep 2026 read "All 48" on this row and
     "All 46" on the next: this row was counting the two cancelled references and the lights bar was not, and
     nothing on either said so. A cancelled reference keeps its marker (the drawing still puts it there) but it is
     not work outstanding, so it is out of the count here as it is everywhere else, and the button's own title
     says how many are cancelled. */
  const live = onSheet.filter(a => !a._cancelled), off = onSheet.length - live.length;
  const offWord = off ? ` (${off} cancelled reference${off === 1 ? '' : 's'} on this sheet not counted)` : '';
  const btn = (v, word, n, title) => `<button type="button" data-mapdisc="${esc(v)}" aria-pressed="${(state.mapDisc||'') === v}" title="${esc(title)}">${esc(word)} <b>${esc(n)}</b></button>`;
  return `<div class="lightbar" role="group" aria-label="Filter by trade"><span class="lead">Trade</span>
    ${btn('', 'All', String(live.length), 'every trade drawn on this sheet — ' + live.length + ' references' + offWord)}
    ${ds.map(d => { const n = live.filter(a => a.discipline === d).length, u = discUnit(d);
        return btn(d, d, u.one === 'asset' ? String(n) : discCount(d, n),
                   (u.why ? u.why + ' ' : '') + 'iEDM draw these on the same sheet; this shows them on their own.'); }).join('')}</div>`;
}

/* One change, every view. save() keeps it; render() redraws whichever tab is showing; the drawer, if it is open
   on the changed asset, is redrawn in place with its scroll position kept. Every edit path ends here so nothing
   can be typed into one tab and go missing from another. */
function bump(){
  /* save() says whether the browser actually kept the change. Throwing that away is how a full disk turns into
     a tick on the screen and nothing on the record — the 13 Sep audit's A04. The result is carried back to
     whoever called, and a refusal is said out loud rather than left to a flash that has already faded. */
  const kept = save(); render();
  if (kept === false) document.body.classList.add('unsaved'); else document.body.classList.remove('unsaved');
  damagedBanner();
  const dr = $('#drawer');
  bump.kept = kept;
  if (dr && dr.classList.contains('on') && state.sel && !document.body.classList.contains('dropping')) {
    /* Both, because which element scrolls depends on the width: on a laptop .db is the scroller inside a
       three-band drawer; on a phone the drawer itself is one scroll container and .db just flows in it.
       Reading and writing both costs nothing and means a redraw never throws the reader back to the top. */
    openAsset(state.sel, {keep:true});   /* openAsset keeps the scroll, the focus and the caret on a redraw (v5.78) */
  }
}

/* ------------------------------------------------------------------ tabs */
const TABS = [['today','Today'],['progress','Where we are'],['map','Map'],['docs','Documents'],['register','Register'],['plant','Plant'],['fencing','Fencing'],['prestarts','Pre-starts'],['coatesway','The Coates Way'],['journal','Journal'],['breakdowns','Breakdowns'],['variances','Variances'],
              ['costs','Costs'],['edit','Edit'],['add','Add an asset'],['pricing','Pricing'],['timeline','Timeline'],['about','About this file']];
/* v5.86 - SET ASIDE, NOT DELETED. Andrew Fisher, 25 Sep 2026: Variances, Journal and Add an asset come off the page. They
   are off the tab row, the More menu and the Tools views, their cards and buttons are hidden, and a link that still asks
   for one lands on Today and says so. The panes, their code and their records are untouched; taking a name out of this
   set puts the page back exactly as it was. */
const TABS_OFF = new Set(['variances', 'journal', 'add', 'breakdowns', 'register', 'edit']);   /* v5.91 - Breakdowns, Register and Edit set aside; the register is on the Plant page */
/* Superior Audit, 15 Sep 2026: "Today, Timeline, Register, Map, Documents, then a labelled More menu for
   commercial/support views." These are the ones a person on site opens; the commercial and support views are
   the ones a person at a desk opens, and they are all still one press away and still deep-linkable.

   WHERE WE ARE SITS BESIDE TODAY AND TIMELINE (Andrew Fisher, 15 Sep 2026). It was under More, which is where a
   person goes looking for a commercial page — and
   it is the page that answers whether we are on the programme, which is a site question asked all day. So it joins
   the primary row in the order the three are actually used: what is happening today, where the programme is,
   and what is coming. Nothing left the row to make space; the rule that the row stays ONE row at every width
   is held by tests/test_superior_audit.py, and it is a harder rule than the number of tabs on it. */
const TAB_PRIMARY = ['today', 'progress', 'timeline', 'plant', 'map', 'docs', 'coatesway'];   /* v5.91 - Plant, carrying the register, where Register was */
/* ONE ROW IS A HARDER RULE THAN SIX TABS. Six labels and More measure about 610 px; on a 390 px phone that is
   214 px of buttons off the edge, masked and scrolled by feel, which is the exact fault the Superior Audit
   fixed. So on a narrow screen Documents steps back into More.

   WHICH ONE STEPS BACK IS THE WHOLE DECISION, and it is not Where we are. Documents is what a person opens at
   a desk, or when they already know which drawing they want; Where we are answers whether we are on the programme,
   which is asked on the ground all day. So Andrew Fisher's three — Today, Where we are, Timeline — are side by
   side at EVERY width, on the phone in his hand as much as on the screen in the office, and the tab that moves
   is the one that costs least to move. Nothing is lost either way: More is one press, every deep link still
   works, and the More button says so when the open tab is under it.

   THE COATES WAY IS ON THE ROW (Andrew Fisher, 23 Sep 2026: on the main screen, not under More). It is the last of
   the primary views at every width. On a phone that made seven tabs
   and More, which no 13 px text row holds in 390 px — and a row that scrolls by feel is the fault above, not a
   fix — so under 640 px the row becomes the phone's own kind of tab bar: a glyph over a short label, every
   view in reach without a scroll, measured to fit 360 px. On a laptop the same glyphs sit beside the words.
   Documents steps back a little earlier (760 px, was 620) so seven words and More still fit a tablet. */
const TAB_WIDE = (() => { try { return matchMedia('(min-width: 760px)'); } catch (e) { return {matches: true}; } })();
function tabPrimary(){ return TAB_WIDE.matches ? TAB_PRIMARY : TAB_PRIMARY.filter(k => k !== 'docs'); }
/* the word on the tab, where the page's own name is too long for a row */
const TAB_SHORT = {coatesway: 'Coates Way'};
/* where a word breaks when the phone's bar folds a two-word view onto two lines: "Where / we are", never "Where we / are" */
const TAB_WORDS = {progress: 'Where <span class="nb">we are</span>'};
/* one glyph a view, 16 px on a 16 grid, drawn in currentColor so it takes the tab's own state — the phone's row
   is glyph-over-word, the laptop's is glyph-beside-word, and the same mark means the same view on both */
const TAB_GLYPH = {
  today: '<path d="M3 3.5h10v9.5H3z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3 6.5h10M5.5 2v2.5M10.5 2v2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="9.6" r="1.25" fill="currentColor"/>',
  progress: '<path d="M4 14V2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4.5 3h8l-2 2.75 2 2.75h-8z" fill="currentColor"/>',
  timeline: '<circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.8V8l2.3 1.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  register: '<path d="M2.5 3.5h11M2.5 8h11M2.5 12.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5.5 2.5v11" stroke="currentColor" stroke-width="1.2"/>',
  plant: '<path d="M2.5 13.5h11M3 13.5V7h4.5v6.5M9.5 13.5V4.5h3.5v9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M4.6 9.2h1.3M4.6 11.2h1.3M11 6.5h.8M11 8.7h.8M11 10.9h.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',   /* v5.92 - a plant yard: two sheds */
  map: '<path d="M8 14.5s4.4-4.3 4.4-7.6A4.4 4.4 0 0 0 3.6 6.9C3.6 10.2 8 14.5 8 14.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="8" cy="6.9" r="1.6" fill="currentColor"/>',
  docs: '<path d="M4 2h5.2L12.5 5.3V14H4z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 2v3.5h3.5M6 8.5h4.5M6 11h4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
  coatesway: '<path d="M8 1.4l1.1 1.6 1.9-.5.5 1.9 1.9.5-.5 1.9 1.6 1.1-1.6 1.1.5 1.9-1.9.5-.5 1.9-1.9-.5L8 14.6l-1.1-1.6-1.9.5-.5-1.9-1.9-.5.5-1.9L1.4 8 3 6.9l-.5-1.9 1.9-.5.5-1.9 1.9.5z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/><circle cx="8" cy="8" r="2.1" fill="none" stroke="currentColor" stroke-width="1.35"/>',
  more: '<circle cx="3.5" cy="8" r="1.4" fill="currentColor"/><circle cx="8" cy="8" r="1.4" fill="currentColor"/><circle cx="12.5" cy="8" r="1.4" fill="currentColor"/>'
};
const tabGlyph = k => TAB_GLYPH[k] ? `<svg class="tg" viewBox="0 0 16 16" aria-hidden="true" focusable="false">${TAB_GLYPH[k]}</svg>` : '';
/* Labels are part of each render, including asynchronous Documents refreshes. */
function paneHeadingHtml(tab){
  const label = (TABS.find(([key]) => key === tab) || [tab, tab])[1];
  return '<h2 class="panehead vh" id="panehead-' + esc(tab) + '">'
    + esc(label + ' — ' + DATA.event.name) + '</h2>' + (tab === 'map' ? '' : pageBanner(tab));
}
/* v5.54 — ONE ILLUSTRATIVE BANNER UNDER EACH PAGE HEADING BUT TODAY'S. Andrew Fisher, 19 Sep 2026, sent with the
   rest: a pack of fifteen AI-made scenes of the Coates #26, one per page, with Today keeping his own
   pit-lane photograph and the board on it. The pack's own rule, kept: "Operational maps and records remain
   authoritative" — so the picture is labelled an illustration, nothing on the page is read off it, it sits
   below the heading and above the work, it is one image per page whatever the filter, date or drawing, it
   loads only when its page is on the screen, and it is not printed. Centred; the sides give way on a phone and
   the car stays. If the picture is not in the file the page simply has no banner. */
function pageBanner(tab){
  const B = (DATA.pageBanners || {})[tab];
  if (!B || !B.src) return '';
  return `<figure class="rbhero pgban" data-banner="${esc(tab)}">
    <div class="rbwin"><img src="${B.src}" width="${B.width}" height="${B.height}" alt="${esc(B.scene)} — illustrative scene" loading="lazy" decoding="async"></div>
    <figcaption class="rbcap">${esc(B.scene)} <span>\u00b7 illustrative scene, not a drawing or a record</span></figcaption>
  </figure>`;
}
/* Skip is local navigation within the selected work view; it must not enter the route history. */
function skipCurrentWork(e){
  if (e) e.preventDefault();
  const pane = $('#pane-' + state.tab);
  if (!pane) return;
  pane.setAttribute('tabindex', '-1');
  try { pane.focus({preventScroll: true}); } catch (err) { pane.focus(); }
  pane.scrollIntoView({block: 'start', behavior: 'auto'});
}
$('#skipWork').onclick = skipCurrentWork;
function renderTabs(){
  const att = attention();
  const dot = (k) => k === 'variances' && att.variances ? `<i class="dot" title="${att.variances} variance${att.variances > 1 ? 's' : ''} with nobody's name"></i>`
                   : k === 'fencing' && att.fencing ? `<i class="dot" title="${att.fencing} line${att.fencing > 1 ? 's' : ''} over the quote"></i>`
                   : k === 'breakdowns' && att.breakdowns ? `<i class="dot" title="${att.breakdowns} open breakdown${att.breakdowns > 1 ? 's' : ''} stopping work"></i>`
                   : k === 'progress' && att.progress ? `<i class="dot" title="${att.progress} asset${att.progress > 1 ? 's' : ''} due in and not on site"></i>`
                   : k === 'costs' && att.costs ? `<i class="dot" title="${att.costs} cost line${att.costs > 1 ? 's' : ''} incomplete"></i>` : '';
  /* Superior Audit, 15 Sep 2026: five primary views across the nav row, then a labelled More holding the rest.
     Fifteen tabs in one strip was 732px of buttons in a 390px window, masked at the edge and scrolled by feel.
     Deep links are untouched — go() still takes any tab, #pricing still opens Pricing — and when the open tab
     lives under More the More button says so and reads as selected, so nobody loses where they are. */
  const inMore = k => !tabPrimary().includes(k);
  const tabBtn = ([k, l]) => `<button role="tab" id="tab-${k}" data-tab="${k}" aria-controls="pane-${k}"${TAB_SHORT[k] ? ` aria-label="${esc(l)}"` : ''}
       aria-selected="${state.tab===k}" tabindex="${state.tab===k?0:-1}">${tabGlyph(k)}<span class="tw">${TAB_WORDS[k] || esc(TAB_SHORT[k] || l)}</span>${dot(k)}</button>`;
  const editOk = k => k === 'edit' && typeof canEdit === 'function' && canEdit();   /* v5.99 */
  const hidden = TABS.filter(([k]) => inMore(k) && (!TABS_OFF.has(k) || editOk(k)));
  const here = hidden.find(([k]) => k === state.tab);
  const attnInMore = hidden.filter(([k]) => dot(k)).length;
  /* v5.96 - no More: the bar is the primary views, plus the one you are on when it is not one of them; every view
     is in Tools, and the attention behind the bar rides on the Tools button */
  /* v6.26 - Tools lives at the right end of the tab row (Andrew Fisher, 26 Sep 2026); the strip is rebuilt here, so the button
     is taken out first and put back after; its menu hangs off the body so the strip's sideways scroll never clips it; the
     phone's search button stays in the top row */
  const toolsNode = $('.tools'); if (toolsNode && toolsNode.parentElement) toolsNode.parentElement.removeChild(toolsNode);
  $('#tabs').innerHTML = tabPrimary().map(k => TABS.find(([x]) => x === k)).filter(Boolean).map(tabBtn).join('') + (here ? tabBtn(here) : '');
  { const sb = toolsNode ? toolsNode.querySelector('#searchBtn') : null, menu = toolsNode ? toolsNode.querySelector('#moreMenu') : null;
    if (sb) { sb.classList.add('sbtop'); $('.brandrow').appendChild(sb); }
    if (menu) document.body.appendChild(menu);
    if (toolsNode) $('#tabs').appendChild(toolsNode); }
  const tbtn = $('#moreBtn'); if (tbtn) { const d = tbtn.querySelector('.dot'); if (attnInMore && !d) tbtn.insertAdjacentHTML('beforeend', `<i class="dot" title="${attnInMore} view${attnInMore === 1 ? '' : 's'} want attention"></i>`); else if (!attnInMore && d) d.remove(); }
  /* data-goto, not data-tab: data-tab belongs to the five real role="tab" buttons, and a hidden duplicate
     carrying it makes "the Today tab" ambiguous to anything selecting on the page. */
  const tmm = $('#tabMoreMenu');
  if (tmm) tmm.innerHTML = hidden.map(([k, l]) => `<button type="button" role="menuitem" data-goto="${k}"${
    state.tab === k ? ' aria-current="page"' : ''}>${l}${dot(k)}</button>`).join('');
  /* the same list again in the primary bar's More menu, so a phone that has the bar open but the nav row
     scrolled away can still reach every view */
  const mv = $('#mmViews');
  if (mv) mv.innerHTML = TABS.filter(([k]) => !TABS_OFF.has(k) || editOk(k)).map(([k, l]) => `<button class="btn" role="menuitem" data-goto="${k}"${
    state.tab === k ? ' aria-current="page"' : ''}>${l}${dot(k)}</button>`).join('');
  const eb = $('#exportBtn');
  if (eb) { eb.innerHTML = 'Export' + (att.export ? `<i class="dot" title="${att.export} change${att.export > 1 ? 's' : ''} since the last export"></i>` : '');
    eb.title = att.export ? att.export + ' change' + (att.export > 1 ? 's' : '') + ' in this browser since the last export' : 'Export the records in this browser'; }
  const closeTabMore = () => { const m = $('#tabMoreMenu'), b = $('#tabMore');
    if (m) m.hidden = true; if (b) b.setAttribute('aria-expanded', 'false'); };
  $('#tabs').onclick = e => {
    const m = e.target.closest('#tabMore');
    if (m) { const menu = $('#tabMoreMenu'); const open = menu.hidden;
      menu.hidden = !open; m.setAttribute('aria-expanded', String(open));
      /* pin it under the More button, which has scrolled with the strip */
      if (open) { const r = m.getBoundingClientRect(), h = $('header.top').getBoundingClientRect();
        menu.style.left = Math.max(8, Math.min(r.left - h.left, h.width - menu.offsetWidth - 8)) + 'px';
        const f = menu.querySelector('button'); if (f) f.focus(); }
      return; }
    const b = e.target.closest('[role="tab"][data-tab]'); if (b) { closeTabMore();
      /* the tab you are already on, pressed again, takes you to its top — the one press every phone tab bar answers */
      if (b.dataset.tab === state.tab) { TAB_SCROLL[state.tab] = 0; navScrollTo(0); return; }
      /* v5.93 - the tapped tab lights up on this frame; its page is drawn on the next, so the press is answered at once */
      b.classList.add('busy'); requestAnimationFrame(() => setTimeout(() => { go(b.dataset.tab); }, 0)); } };
  const tm = $('#tabMoreMenu');
  if (tm) {
    tm.onclick = e => { const g = e.target.closest('[data-goto]'); if (g) { closeTabMore(); g.classList.add('busy'); requestAnimationFrame(() => setTimeout(() => go(g.dataset.goto), 0)); } };
    tm.onkeydown = e => {
      if (e.key === 'Escape') { closeTabMore(); const b = $('#tabMore'); if (b) b.focus(); e.preventDefault(); return; }
      if (!['ArrowDown','ArrowUp','ArrowLeft','ArrowRight','Home','End'].includes(e.key)) return;
      const items = [...tm.querySelectorAll('button')];
      const at = items.indexOf(e.target);
      const fwd = e.key === 'ArrowDown' || e.key === 'ArrowRight';
      const to = e.key === 'Home' ? 0 : e.key === 'End' ? items.length - 1
               : (at + (fwd ? 1 : -1) + items.length) % items.length;
      e.preventDefault(); if (items[to]) items[to].focus();
    };
  }
  $('#tabs').onkeydown = e => {
    if (e.key === 'Escape') { const menu = $('#tabMoreMenu');
      if (menu && !menu.hidden) { closeTabMore(); const b = $('#tabMore'); if (b) b.focus(); e.preventDefault(); } return; }
    if (!['ArrowLeft','ArrowRight','Home','End'].includes(e.key)) return;
    const btns = [...$('#tabs').querySelectorAll('[role="tab"]')];
    const at = btns.findIndex(b => b.dataset.tab === state.tab);
    const to = e.key === 'Home' ? 0 : e.key === 'End' ? btns.length - 1
             : (at + (e.key === 'ArrowRight' ? 1 : -1) + btns.length) % btns.length;
    e.preventDefault(); go(btns[to].dataset.tab);
    $('#tabs').querySelector(`[data-tab="${btns[to].dataset.tab}"]`).focus();
  };
}
const TAB_SCROLL = {};   /* each tab's reading position, by tab key (v5.79) */
/* v5.92 - the big figures on the race cards and the data cards count up when a page arrives: whole numbers only,
   the final text put back exactly as rendered, 640 ms, once per arrival; nothing for reduced motion or print */
function countUpFigures(tab){
  if (motionOff()) return;
  const pane = $('#pane-' + tab); if (!pane) return;
  /* the big figures are found by size, not by class: any bold whole number set 22 px or larger in the arriving pane */
  const els = [...pane.querySelectorAll('b, strong')].filter(el => /^[\d,]{1,7}$/.test(el.textContent.trim()) && !el.closest('.gidig, table, svg') && !el.dataset.counting && parseFloat(getComputedStyle(el).fontSize) >= 22).slice(0, 80);
  const t0 = performance.now(), D = 640;
  const items = els.map(el => { const txt = el.textContent.trim(), n = parseInt(txt.replace(/,/g, ''), 10); el.dataset.counting = '1'; return {el, txt, n, comma: txt.includes(',')}; }).filter(x => Number.isFinite(x.n) && x.n > 0);
  if (!items.length) return;
  const step = () => { const k = Math.min(1, (performance.now() - t0) / D), e = 1 - Math.pow(1 - k, 3);
    for (const it of items) { if (!it.el.isConnected) continue; const v = Math.round(it.n * e); it.el.textContent = k >= 1 ? it.txt : (it.comma ? v.toLocaleString('en-AU') : String(v)); }
    if (k < 1) requestAnimationFrame(step); else items.forEach(it => { delete it.el.dataset.counting; }); };
  requestAnimationFrame(step);
}
function go(tab){ if (!TABS.some(([k]) => k === tab)) tab = 'today';
  if (tab === 'register') tab = 'plant';   /* v5.91 - the register is on the Plant page */
  if (TABS_OFF.has(tab) && !(tab === 'edit' && typeof canEdit === 'function' && canEdit())) { const l = (TABS.find(([k]) => k === tab) || [])[1] || tab;   /* v5.99 - Edit stays open to an editing link, under Tools */ flash('The ' + l + ' page has been set aside (Andrew Fisher, 25 Sep 2026).'); tab = 'today'; }
  /* v5.57 — a pane about to be redrawn for the search is drawn now, not after the tab has moved: a redraw
     landing on the pane you just left is work nobody sees, and one landing a moment after you arrive is a flicker */
  if (typeof searchTimer !== 'undefined' && searchTimer) { clearTimeout(searchTimer); searchTimer = null; }
  const changed = tab !== state.tab;
  if (changed) { const m = $('main'); if (m && state.tab) TAB_SCROLL[state.tab] = m.scrollTop; }
  if (changed) delete RACE_RAN[tab];
  if (changed) GI_SEEN.clear();   /* v5.92 - the gauge sweeps up on every arrival, not once a session */
  if (changed) boardStop();
  state.tab = tab; setHash(tab); renderTabs();
  const skip = $('#skipWork'); if (skip) skip.setAttribute('href', '#pane-' + tab);
  document.querySelectorAll('.pane').forEach(p => {
    const on = p.id === 'pane-' + tab;
    p.classList.toggle('on', on);
    /* the arrival eases in once, on a real change of tab — a re-render of the same tab stays put */
    p.classList.remove('arrive');
    if (on && changed) { void p.offsetWidth; p.classList.add('arrive'); }
    /* The tab bar declares role="tablist" and the buttons role="tab". Without these the panels those tabs point
       at do not exist as far as a screen reader is concerned, which is worse than no ARIA at all. */
    /* V11 audit: this pointed every pane at `tab-<view>`, and only the five primary views have a button with
       that id. A deep link to Pricing therefore landed on a panel labelled by an element that does not exist,
       which a screen reader reports as nothing at all, and the focus stayed on BODY. Every pane is labelled by
       its own persistent heading, which exists whichever way the person arrived. */
    const k = p.id.replace('pane-', '');
    p.setAttribute('role', 'tabpanel');
    p.setAttribute('aria-labelledby', 'panehead-' + k);
    p.setAttribute('tabindex', '-1');
    if (on) p.removeAttribute('hidden'); else p.setAttribute('hidden', '');
    /* A PANE NOBODY IS LOOKING AT IS NOT KEPT. Outside audit, 17 Sep 2026: after opening the Register the page
       held 32,000 elements, 22,000 of them the Register's rows sitting hidden behind Today; Plant and Edit on top
       took it past 60,000. Every pane is drawn again from the record each time it is opened (render()), so the
       hidden copy is a stale page held for nothing — on a phone, held in the memory that scrolling needs. A
       hidden pane bigger than a few thousand elements is emptied on leaving; its filters live in `state`, and
       it comes back exactly as it would have anyway. Small panes stay, so a tab change on a phone stays cheap. */
    if (!on && changed && p.childElementCount && p.getElementsByTagName('*').length > 3000) p.innerHTML = '';
  });
  render();
  if (changed) countUpFigures(tab);   /* v5.92 */
  /* Every view gets a heading it is named by, put there after render so no page has to remember to add one,
     and the focus is MOVED to the pane on a real change of view — so a person on a keyboard or a screen reader
     is told where they have arrived instead of being left on BODY. */
  const pane = $('#pane-' + tab);
  if (pane) {
    const label = (TABS.find(([x]) => x === tab) || [tab, tab])[1];
    let h = pane.querySelector(':scope > .panehead');
    if (!h) { h = document.createElement('h2'); h.className = 'panehead vh'; pane.insertBefore(h, pane.firstChild); }
    h.id = 'panehead-' + tab;
    h.textContent = label + ' — ' + DATA.event.name;
    if (changed) { try { pane.focus({preventScroll: true}); } catch (e) { try { pane.focus(); } catch (e2) {} } }
  }
  /* v5.71 — a tab you have just opened starts at the top. Without this the browser kept whatever the pane
     before it had, which is how leaving the Map for Today landed on Today's bottom. A step back overrides
     this a moment later, in route(), with the position that entry actually had.
     v5.79 — A TAB REMEMBERS WHERE YOU WERE ON IT (Andrew Fisher, 23 Sep 2026, on scrolling). Read the register
     to row 60, check the timeline, come back: row 60, not row one. Each tab keeps its own reading position for
     the life of the page (TAB_SCROLL, written on the way out), a tab never seen before starts at the top, and
     the tab you are on, pressed again, goes to its top. The position is applied once and checked once more a
     frame later — only if the pane has since reset itself to the top, so a jump that lands on a row or a marker
     after go() is never fought. */
  if (changed) {
    const y = TAB_SCROLL[tab] || 0;
    const m = $('main');
    if (m) { m.scrollTop = y; if (y) requestAnimationFrame(() => { if (m.scrollTop === 0 && m.scrollHeight > y) m.scrollTop = y; }); }
  }
}

/* ------------------------------------------------------------------ today
   The front door. One screen that says what today looks like and takes you to the tab that does the work: what
   is due, how the lights stand, where fencing is against the quote, which variances still need a name, and
   what is sitting in this browser unexported. Every number here is read live from the same state every other
   tab reads, so it cannot disagree with them. */
function localCounts(){
  return {
    lights: Object.keys(S.delivery || {}).length,
    supplied: Object.keys(S.supplied || {}).length,
    variances: (S.variances || []).length,
    dockets: (S.fenceDockets || []).length,
    notes: Object.keys(S.notes || {}).filter(k => (S.notes[k] || '').trim()).length,
    added: (S.added || []).length,
    quote: S.fenceQuote ? 1 : 0,
    breakdowns: (S.breakdowns || []).length,
    contracts: Object.keys(S.contracts || {}).length,
    rental: Object.keys(S.rental || {}).length,
    branch: Object.keys(S.branch || {}).length,
    loads: Object.keys(S.loads || {}).length,
    costs: (S.costs || []).length,
  };
}
/* What needs somebody's attention, for the dots on the tabs and the Export button. */
function attention(){
  const un = allVariances().filter(v => v._where === 'local' && v.authority_state === 'unattributed').length;
  const over = fenceQuote() ? quoteWatch(allDockets()).filter(w => w.state === 'over quote').length : 0;
  const lc = localCounts();
  const anyLocal = Object.values(lc).some(n => n > 0);
  const stop = allBreakdowns().filter(b => b.open && b.severity === 'stops work').length;
  const late = progressAsOf(todayIso()).all.overdue;
  const badCosts = allCosts().filter(c => c._where === 'local' && !c.usable).length;
  return {variances: un, fencing: over, breakdowns: stop, progress: late, costs: badCosts, export: anyLocal && (S.changes || 0) > 0 ? (S.changes || 0) : 0};
}

/* ------------------------------------------------------------------ the programme rail
   Where this day sits in the calendar. The weeks come from the schedule (DATA.weeks), race day from the supplied
   race dates, the first truck from the carrier's list. Nothing moves and nothing is drawn over the picture — the
   car is Andrew Fisher's own photograph at the top of the page, not an illustration on the rail. */
const RACE_RAN = {};
function raceBounds(){
  const W = DATA.weeks || []; if (!W.length) return null;
  return {start: W[0].start, end: W[W.length - 1].end};
}
/* ONE CALENDAR, ONE DAY NUMBER. Outside audit, 17 Sep 2026 (B02): the Timeline said "Day 11 of 68" for 17 Sep
   and the Showcase, on the same date, said "Day 6 of 41" — the Showcase was counting the days the programme has
   deliveries on and calling it the programme position. Two figures for one thing, in front of a room. Every
   surface now reads the position off this one function: the 2026 schedule's first day to its last, inclusive,
   which is what the Timeline's rail has always drawn. The days-with-deliveries count is still a true figure,
   so the Showcase may say it — named as what it is, never as the day of the programme. */
function programmePosition(iso){
  const b = raceBounds(); if (!b) return null;
  const dn = d => Math.round(new Date(d + 'T00:00:00') / 86400000);
  const total = dn(b.end) - dn(b.start) + 1;
  const raw = dn(iso) - dn(b.start) + 1;
  const race = DATA.race_days || null;
  return {start: b.start, end: b.end, total, raw, n: raw < 1 ? 0 : raw > total ? total : raw,
          toRace: race ? dn(race[0]) - dn(iso) : null, toEnd: dn(b.end) - dn(iso),
          raceLen: race ? dn(race[1]) - dn(race[0]) : null,
          before: iso < b.start, after: iso > b.end};
}
/* the phase this day sits in, in the 2026 schedule's own words — the week it falls in, or the next one when the
   day is a weekend between weeks. Never guessed: if the schedule has no weeks, there is no phase. */
function progPhase(iso){
  const W = DATA.weeks || []; if (!W.length) return null;
  const here = W.find(w => iso >= w.start && iso <= w.end);
  const next = here ? null : W.find(w => w.start > iso);
  const w = here || next; if (!w) return null;
  const ph = String(w.phase || '');
  const word = ph === 'Event' ? 'Event week' : ph === 'Demob' ? 'Demob phase' : ph ? ph + ' phase' : w.sheet;
  const why = here ? `from the 2026 schedule — ${w.sheet} is a ${ph.toLowerCase()} week`
                   : `from the 2026 schedule — the next week is ${w.sheet} (${ph})`;
  return {word, why};
}

/* the programme rail. How far through the calendar this day sits, nothing more: the fill is elapsed days, the dot
   is the day, the notch is race start, and the three dates underneath bound it. It says so underneath in words,
   because calendar position is not work done — that is on the plates. With stats it carries the two figures over
   it; without, one line of words. The weeks stay as invisible hit areas so a week is still one press from its day. */
function raceStrip(atIso, key, withStats){
  const b = raceBounds(); if (!b) return '';
  const dn = iso => Math.round(new Date(iso + 'T00:00:00') / 86400000);
  const span = Math.max(1, dn(b.end) - dn(b.start));
  const total = span + 1;
  const pct = iso => Math.min(100, Math.max(0, (dn(iso) - dn(b.start)) / span * 100));
  const fd = iso => { const d = fmtDay(iso); return d.dow + ' ' + d.dm; };
  const dm = iso => fmtDay(iso).dm;
  const at = atIso < b.start ? b.start : atIso > b.end ? b.end : atIso;
  const p = pct(at), race = DATA.race_days, today = todayIso();
  const r = race ? pct(race[0]) : null;
  const tap = window.innerWidth > 640 && !(window.matchMedia && matchMedia('(pointer: coarse)').matches);
  const weeks = (DATA.weeks || []).map(w => {
    const a = pct(w.start), z = pct(w.end);
    const words = `${esc(w.sheet)} · ${esc(fd(w.start))} – ${esc(fd(w.end))}`;
    return tap ? `<button type="button" class="pweek" style="left:${a.toFixed(2)}%;width:${Math.max(0.6, z - a).toFixed(2)}%"
        data-week-day="${esc(w.start)}" title="${words}" aria-label="${esc(w.sheet)}, ${esc(fd(w.start))} to ${esc(fd(w.end))} — open the day view"></button>` : ''; }).join('');
  const pos = programmePosition(atIso);          /* the one calendar the Showcase reads too (B02) */
  const dayNo = pos.raw, toRace = pos.toRace, toEnd = pos.toEnd;
  const label = (atIso === today ? 'Today' : 'As at') + ' · ' + dm(at);
  const lcls = p < 10 ? ' left' : p > 90 ? ' right' : '';
  const stats = !withStats ? '' : `<div class="pstats">
    <div class="pstat"><b>${dayNo < 1 ? 0 : dayNo > total ? total : dayNo}</b><span>of ${total}</span>
      <em>Programme day</em><i>${esc(dm(b.start))} – ${esc(dm(b.end))}</i></div>
    <div class="pstat">${toRace == null ? `<b>${toEnd >= 0 ? toEnd : 0}</b><span>days</span><em>Until the end of demob</em><i>Ends ${esc(fd(b.end))}</i>`
      : toRace > 0 ? `<b>${toRace}</b><span>days</span><em>Until race weekend</em><i>Starts ${esc(fd(race[0]))}</i>`
      : toRace >= -(dn(race[1]) - dn(race[0])) ? `<b>Now</b><em>Race weekend</em><i>${esc(DATA.event.race_dates_as_supplied || fd(race[0]))}</i>`
      : `<b>${toEnd >= 0 ? toEnd : 0}</b><span>days</span><em>Until the end of demob</em><i>Ends ${esc(fd(b.end))}</i>`}</div>
  </div>`;
  const words = withStats ? '' : `<p class="pnote" style="margin-top:12px">Day <b>${dayNo < 1 ? 0 : dayNo > total ? total : dayNo}</b> of ${total}${
    toRace != null && toRace > 0 ? ` · <b>${toRace}</b> days to race day` : toRace != null && toRace >= -(dn(race[1]) - dn(race[0])) ? ' · <b>race weekend</b>' : ''
    } · <b>${toEnd >= 0 ? toEnd : 0}</b> days to the end of demob</p>`;
  return `<div class="pgm" data-race="${esc(key)}" style="--p:${p.toFixed(2)}%${r == null ? '' : `;--r:${r.toFixed(2)}%`}">
    ${stats}
    <div class="prail">
      <div class="pfill" style="width:${p.toFixed(2)}%"></div>${weeks}
      ${r == null ? '' : `<span class="pnotch" title="Race start ${esc(fd(race[0]))}"></span>`}
      <span class="pdot" aria-hidden="true"></span>
      <span class="plab${lcls}">${esc(label)}</span>
    </div>
    <div class="pends">
      <span class="a"><b>${esc(dm(b.start))}</b>Programme starts</span>
      ${r == null ? '' : `<span class="m"><b>${esc(dm(race[0]))}</b>Race start</span>`}
      <span class="z"><b>${esc(dm(b.end))}</b>End of demob</span>
    </div>
    <p class="pnote">Calendar position only · work completion is tracked on the plates</p>${words}
  </div>`;
}

/* the Today card: the phase, the rail with its two figures, what is next on the programme and the key dates.
   Every figure is read as at today — the milestone's own day view supplies what is due in and out on it. */
function progCard(today){
  if (!raceBounds()) return '';
  const ms = dsnMilestones(), days = programmeDays();
  const ph = progPhase(today);
  /* Today's own milestone IS the next one. It used to be skipped — `> today` — so on the morning of the first
     truck the card jumped past sixteen drops and six loads to a race weekend five weeks away with nothing due on
     it. The line under it already says "Today", so there is no confusion about which day is meant. */
  const nxt = ms.find(m => m.iso >= today) || null;
  const d = nxt ? days.find(x => x.iso === nxt.iso) : null;
  const inDays = nxt ? Math.round((new Date(nxt.iso + 'T00:00:00') - new Date(today + 'T00:00:00')) / 86400000) : null;
  const fd = iso => { const x = fmtDay(iso); return x.dow + ' ' + x.dm; };
  const race = DATA.race_days;
  const when = m => race && m.label === 'Race day' && DATA.event.race_dates_as_supplied
    ? esc(DATA.event.race_dates_as_supplied) : esc(fd(m.iso)) + ' ' + m.iso.slice(0, 4);
  const name = m => race && m.label === 'Race day' && race[1] && race[1] !== race[0] ? 'Race weekend' : m.label;
  return `<div class="card hubcard racecard island">
    <div class="phead"><h3>Where we are on the programme</h3>${
      ph ? `<span class="pphase" title="${esc(ph.why)}"><i></i>${esc(ph.word)}</span>` : ''}</div>
    ${raceStrip(today, 'today', true)}
    ${nxt ? `<div class="pnext">
      <div class="pnexthead"><span class="pnk">Next milestone</span><span class="pnin">${
        inDays === 0 ? 'Today' : inDays === 1 ? 'Tomorrow' : 'In ' + inDays + ' days'}</span></div>
      <h4>${esc(name(nxt))}</h4>
      <p>${esc(fd(nxt.iso))}${d && d.sheet ? ' · ' + esc(d.sheet) : ''}</p>
      ${d ? `<div class="pnfig"><span><b>${d.deliveries.length}</b>due in</span><span><b>${d.removals.length}</b>due out</span>${
        d.loads.length ? `<span><b>${d.loads.length}</b>carrier load${d.loads.length === 1 ? '' : 's'} listed</span>` : ''}</div>` : ''}
    </div>` : ''}
    <div class="pkeys">
      <div class="pkeyhead"><span>Key dates</span><span class="hubgo" data-go="progress" role="link" tabindex="0">Open Where we are →</span></div>
      <ul>${ms.map(m => `<li class="${m.iso < today ? 'done' : nxt && m.iso === nxt.iso ? 'next' : ''}"><span>${esc(name(m))}</span><b>${when(m)}</b></li>`).join('')}</ul>
    </div>
  </div>`;
}

/* after the strip is in the page: time the run by its length, then mark it as run so re-renders park the car */
/* after the rail is in the page: a week is a press away from its day view */
function raceMount(pane){
  pane.querySelectorAll('.pgm[data-race]').forEach(r => {
    RACE_RAN[r.dataset.race] = true;
    r.querySelectorAll('[data-week-day]').forEach(b => b.onclick = e => {
      e.stopPropagation(); state.day = b.dataset.weekDay; state.tlView = 'day'; go('timeline'); });
  });
}
/* ------------------------------------------------------------------ the working strip, above everything
   Andrew Fisher's picture of the #26 and the VMS trailer on the pit straight is the best thing on this page and
   nothing here touches it — not cropped, not scaled, not moved out of the way. What changed is what comes FIRST.
   Measured on 14 Sep 2026: on a 1366 x 768 screen the first working figure sat 1447 px down, so a person opening
   the page on the morning of a build day got two screens of artwork before a single number. The picture is worth
   scrolling to. It is not worth scrolling PAST.
   So the day, the counts and the one thing that needs doing go in a strip at the top, and the hero follows them
   exactly as it was. Every figure here is a link to where it can be acted on. */
/* v5.87 - THE SIGNAL HEAD. The lights as a real hooded signal: three lenses, the one lit is the state most of the
   job is in (on site, in transit, not on site); none lit when nothing has a light yet. The counts beside it are the
   fact; the lamp is the picture of it. */
function signalHead(t){
  const lit = Math.max(t.red, t.amber, t.green) > 0 ? (t.green >= t.amber && t.green >= t.red ? 'g' : t.amber >= t.red ? 'a' : 'r') : '';
  const lens = (cy, col, k) => `<g><path d="M30 ${cy - 26}h60a6 6 0 0 1 6 6v4H24v-4a6 6 0 0 1 6-6z" fill="#0c0c0c"/><circle cx="60" cy="${cy}" r="27" fill="#050505"/>
    <circle cx="60" cy="${cy}" r="24" fill="${col}" opacity="${lit === k ? 1 : .18}"/>${lit === k ? `<circle cx="60" cy="${cy}" r="28" fill="${col}" opacity=".55" filter="url(#sgGlow)"/>` : ''}
    <circle cx="60" cy="${cy}" r="24" fill="url(#sgDots)" opacity="${lit === k ? .35 : .15}"/>
    <circle cx="60" cy="${cy}" r="8" fill="none" stroke="#000" stroke-opacity=".28" stroke-width=".8"/><circle cx="60" cy="${cy}" r="13" fill="none" stroke="#000" stroke-opacity=".28" stroke-width=".8"/><circle cx="60" cy="${cy}" r="18" fill="none" stroke="#000" stroke-opacity=".28" stroke-width=".8"/>
    <ellipse cx="52" cy="${cy - 9}" rx="9" ry="5" fill="#fff" opacity="${lit === k ? .5 : .12}"/><circle cx="60" cy="${cy}" r="24" fill="none" stroke="#000" stroke-opacity=".7" stroke-width="2"/></g>`;
  return `<svg class="sighead" viewBox="0 0 120 300" aria-hidden="true"><defs><pattern id="sgDots" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.4" fill="#000"/></pattern>
    <linearGradient id="sgHouse" x1="0" x2="1"><stop offset="0" stop-color="#2a2a2a"/><stop offset=".5" stop-color="#101010"/><stop offset="1" stop-color="#232323"/></linearGradient>
    <filter id="sgGlow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6"/></filter></defs>
    <rect x="18" y="8" width="84" height="284" rx="16" fill="url(#sgHouse)" stroke="#3c3c3c" stroke-width="1.5"/>
    ${lens(60, '#ff3b30', 'r')}${lens(150, '#ffb000', 'a')}${lens(240, '#2fd66b', 'g')}</svg>`;
}
/* v6.10 - THE DAY POD (Andrew Fisher, 26 Sep 2026: the Today strip belongs in the banner). The strip's own arithmetic,
   in one place: the day it counts (today if it is a programme day, else the next), the entries due in on it, how many
   are recorded on site, how many are not recorded on site yet, and rows still needing a reference. */
function todayFigures(){
  const today = todayIso(), days = programmeDays();
  const dayNow = days.find(d => d.iso === today) || null, next = days.find(d => d.iso > today) || null, show = dayNow || next;
  const due = show ? show.deliveries : [];
  const onsite = due.filter(r => { const d = deliveryOf(r.a.key); return d.recorded && d.state === 'on site'; }).length;
  const R = show ? dayReview(show) : {review: 0, refs: 0, both: 0, total: 0};
  const waiting = due.filter(r => !deliveryOf(r.a.key).recorded).length;
  const redDue = due.filter(r => { const v = deliveryView(r.a); return v.recorded && v.negative; }).length;
  const split = [waiting ? fmtNum(waiting) + ' with no record' : null, redDue ? fmtNum(redDue) + ' recorded not on site' : null].filter(Boolean).join(' · ');
  const d = fmtDay(show ? show.iso : today);
  return {d, dayNow: !!dayNow, due: due.length, onsite, notYet: R.review, refs: R.refs, chase: R.total, both: R.both, list: due.map(r => r.a),   /* v6.20 - the list, for the banner's map */
    subDue: 'schedule entries', subOn: onsite === due.length && due.length ? 'all of them' : 'so far today', subNot: R.review ? split : 'nothing outstanding'};
}
function hzTodayPod(){
  const el = $('#hztd'); if (!el) return;
  let f; try { f = todayFigures(); } catch (e) { el.hidden = true; return; }
  const ICON = {cal: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
    seen: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.6 2.5L16 9.5"/></svg>',
    gap: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9.5 17h-19z"/><path d="M12 10v4M12 17.5v.5"/></svg>'};
  const fig = (n, lab, sub, go, icon, cls) => `<button type="button" class="tdf${cls ? ' ' + cls : ''}" data-go="${go}" title="Open ${go === 'plant' ? 'Plant' : 'the Timeline'}"><span class="tl">${lab}</span><span class="tn"><b>${fmtNum(n)}</b>${ICON[icon]}</span><span class="ts">${esc(sub)}</span></button>`;
  el.innerHTML = `<span class="tdday">${refPlate(f.d.dm.toUpperCase(), 19)}<span class="tdw"><b>${esc(f.d.dow)}</b> · ${f.dayNow ? 'today' : 'next programme day'}</span></span>
    <span class="tdrow">${fig(f.due, 'Due in', f.subDue, 'timeline', 'cal')}${fig(f.onsite, 'Recorded on site', f.subOn, 'plant', 'seen')}${fig(f.notYet, 'Not recorded on site', f.subNot, 'plant', 'gap', f.notYet ? 'gap' : '')}${f.refs ? fig(f.refs, f.refs === 1 ? 'Row needs a reference' : 'Rows need references', 'on the schedule', 'timeline', 'gap', 'gap') : ''}</span>`;
  if (!el.dataset.wired) { el.dataset.wired = '1'; el.addEventListener('click', e => { const b = e.target.closest('[data-go]'); if (b) go(b.dataset.go); }); }
  hzMapPins(f);
}
/* v6.20 - THE BANNER'S CIRCUIT MAP. DATA.hzmap is the registered aerial cropped to the circuit with the key-plan ring drawn on
   it (make_hzmap.py); a pin is placed by aerialPointFor - the Map tab's own arithmetic - turned into a fraction of the crop.
   The image is drawn contain-fit, so the pins are laid out from the drawn image's rectangle, and again when the panel resizes. */
const HZMAP = {init: false, pins: [], ro: null};
function hzMapInit(){
  const box = $('#hzmap'), M = DATA.hzmap; if (!box || HZMAP.init) return; HZMAP.init = true;
  if (getComputedStyle(box).display === 'none') { box.hidden = true; return; }   /* v6.22 - the map is out of the banner; nothing is fetched or drawn */
  if (!M || !M.src) { box.hidden = true; return; }
  const img = $('#hzmapImg'); img.src = M.src;
  const up = M.up_is_bearing_deg || 0, n = $('#hznorth'); if (n) n.style.transform = 'rotate(' + (-up).toFixed(2) + 'deg)';
  const lap = M.lap_length_m ? ' · lap ' + (M.lap_length_m / 1000).toFixed(2) + ' km' : '';
  box.dataset.lap = lap;
  let folded = false; try { folded = localStorage.getItem('gc500.hzmap') === 'folded'; } catch (e) {}
  const fold = $('#hzmapFold');
  const setFold = f => { box.classList.toggle('folded', f); fold.setAttribute('aria-expanded', String(!f));fold.textContent = f ? 'Show the map' : 'Fold the map'; try { localStorage.setItem('gc500.hzmap', f ? 'folded' : 'open'); } catch (e) {} if (!f) hzPinsLayout(); };
  setFold(folded); fold.onclick = () => setFold(!box.classList.contains('folded'));
  if ('ResizeObserver' in window) { HZMAP.ro = new ResizeObserver(() => hzPinsLayout()); HZMAP.ro.observe(box); }
  img.addEventListener('load', hzPinsLayout);
  $('#hzpins').addEventListener('click', e => { const p = e.target.closest('.hzpin'); if (p) { e.stopPropagation(); hzPinMenu(p.dataset.key, p); } });
  document.addEventListener('click', e => { if (!e.target.closest('.hzpinmenu')) hzPinMenuClose(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') hzPinMenuClose(); });
}
function hzMapPins(f){
  hzMapInit(); const box = $('#hzmap'), M = DATA.hzmap, host = $('#hzpins'); if (!box || box.hidden || !M) return;
  const [x0, y0, x1, y1] = M.crop, AW = M.aerial_px[0], AH = M.aerial_px[1];
  const pins = [], missing = [];
  for (const a of (f.list || [])) {
    let pt = null; try { pt = aerialPointFor(a); } catch (e) { pt = null; }
    if (!pt) { missing.push(a.key); continue; }
    const fx = (pt.ax * AW - x0) / (x1 - x0), fy = (pt.ay * AH - y0) / (y1 - y0);
    if (fx < 0 || fx > 1 || fy < 0 || fy > 1) { missing.push(a.key); continue; }
    const d = deliveryOf(a.key), light = d && d.light ? d.light : '';
    pins.push({key: a.key, fx, fy, light});
  }
  HZMAP.pins = pins;
  host.innerHTML = pins.map(p => `<button type="button" class="hzpin" data-key="${esc(p.key)}" data-fx="${p.fx.toFixed(4)}" data-fy="${p.fy.toFixed(4)}" aria-label="${esc(p.key)} — press for where to go"><span class="rplate">${esc(p.key)}</span><i class="stem"></i><i class="dot ${esc(p.light)}"></i></button>`).join('');
  const sub = $('#hzmapSub');
  if (sub) sub.textContent = (f.due ? fmtNum(f.due) + (f.due === 1 ? ' delivery due in ' : ' deliveries due in ') + (f.dayNow ? 'today' : 'on ' + f.d.dow + ' ' + f.d.dm) : 'nothing due in ' + (f.dayNow ? 'today' : 'on ' + f.d.dow + ' ' + f.d.dm))
    + (pins.length ? ' · ' + fmtNum(pins.length) + ' pinned' : '') + (missing.length ? ' · ' + fmtNum(missing.length) + ' without a position on the plan' : '') + (box.dataset.lap || '');
  hzPinsLayout();
}
function hzPinsLayout(){
  const box = $('#hzmap'), img = $('#hzmapImg'); if (!box || box.hidden || box.classList.contains('folded') || !img || !img.naturalWidth) return;
  const W = box.clientWidth, H = box.clientHeight, iw = img.naturalWidth, ih = img.naturalHeight;
  const sc = Math.min(W / iw, H / ih), dw = iw * sc, dh = ih * sc, ox = (W - dw) / 2, oy = (H - dh) / 2;   /* object-fit: contain, centred */
  for (const p of box.querySelectorAll('.hzpin')) { const x = ox + (+p.dataset.fx) * dw, y = oy + (+p.dataset.fy) * dh; p.style.left = x.toFixed(1) + 'px'; p.style.top = y.toFixed(1) + 'px'; p.hidden = x < -10 || x > W + 10 || y < -10 || y > H + 10; }
}
function hzPinMenuClose(){ const m = $('#hzpinmenu'); if (m) m.remove(); }
/* the pin's menu: exactly where it needs to go - the plan (the Map tab, the marker ringed), the satellite, the plan explorer
   opened on the reference, the 3D proof, and Navigate (the maps app at its coordinates) */
function hzPinMenu(key, pin){
  hzPinMenuClose(); const a = assetOf(key); if (!a) return;
  const box = $('#hzmap'); const place = (typeof mapPlaceFor === 'function') ? mapPlaceFor(a) : null; const spot = (typeof spotOf === 'function') ? spotOf(a) : null;
  const hosted = typeof machineHosted === 'function' && machineHosted();
  const items = [];
  if (place) items.push(['plan', 'The plan — ' + (place.sheet.sheet_id || place.sheet.title || 'the sheet') + ', callout ' + place.label]);
  if (place && spot) items.push(['sat', 'The satellite, at its pin']);
  if (hosted) items.push(['explorer', 'The plan explorer, on ' + key]);
  if (hosted) items.push(['proof3d', 'The 3D proof']);
  if (spot) items.push(['nav', 'Navigate there (opens your maps app)']);
  items.push(['open', 'Open ' + key + ' on Plant']);
  const m = document.createElement('div'); m.className = 'hzpinmenu'; m.id = 'hzpinmenu'; m.setAttribute('role', 'menu');
  m.innerHTML = `<b>${refPlate(key, 13)} <span>${esc((a.item_types || []).join(', ') || a.product || '')}${a.name ? ' · ' + esc(a.name) : ''}</span></b>` + items.map(([k, l]) => `<button type="button" role="menuitem" data-act="${k}">${esc(l)}</button>`).join('');
  box.appendChild(m);
  const r = pin.getBoundingClientRect(), br = box.getBoundingClientRect();
  let left = r.left - br.left + r.width / 2 - 90, top = r.bottom - br.top + 6;
  left = Math.max(6, Math.min(left, br.width - m.offsetWidth - 6)); if (top + m.offsetHeight > br.height - 6) top = Math.max(6, r.top - br.top - m.offsetHeight - 6);
  m.style.left = left + 'px'; m.style.top = top + 'px';
  m.onclick = e => { const b = e.target.closest('[data-act]'); if (!b) return; const act = b.dataset.act; hzPinMenuClose();
    if (act === 'plan') { state.fview = null; mapLocate(place.sheet.key, place.label, key, {marker: place.marker}); }
    else if (act === 'sat') { mapLocate(place.sheet.key, place.label, key, {marker: place.marker}); state.fview = 'map'; renderPass(); }
    else if (act === 'explorer') { MACHINE.find = key; machineOpen('explorer'); }
    else if (act === 'proof3d') { machineOpen('proof3d'); }
    else if (act === 'nav') { window.open(navUrl({lat: spot.lat, lon: spot.lon}), '_blank', 'noopener'); }
    else if (act === 'open') { go('plant'); openAsset(key); } };
  const first = m.querySelector('button'); if (first) first.focus();
}
function todayStrip(today, show, dayNow){
  const t = lightTally(allAssets());
  const due = show ? show.deliveries : [];
  const waiting = due.filter(r => !deliveryOf(r.a.key).recorded).length;
  const onsite = due.filter(r => { const d = deliveryOf(r.a.key); return d.recorded && d.state === 'on site'; }).length;
  /* F02: the same review the daily brief and the timeline carry, counted in one place. */
  const R = show ? dayReview(show) : {review: 0, refs: 0, both: 0, total: 0, sentence: ''};
  const refs = R.refs;
  const both = R.both;
  const chase = R.total;
  /* Design audit, 15 Sep 2026, A08: the strip showing the NEXT programme day's entries still wore today's date.
     The plate is the date of the entries it counts, and the tag says when that is not today. */
  const d = fmtDay(show ? show.iso : today);
  /* A05: the third tile read "0 no delivery record — nothing outstanding" beside a note counting one entry to
     review, because the tile counted only the unknowns while the review counts unknowns AND lights somebody
     set to not on site. The tile now counts what the review counts — entries not on site yet — and says how
     that splits, so the two never disagree about the same day. */
  const redDue = due.filter(r => { const v = deliveryView(r.a); return v.recorded && v.negative; }).length;
  const notYet = R.review;
  const splitWords = [waiting ? fmtNum(waiting) + ' with no record' : null, redDue ? fmtNum(redDue) + ' recorded not on site' : null].filter(Boolean).join(' · ');
  const tile = (n, lab, sub, go, cls) => `<button type="button" class="tsq${cls ? ' ' + cls : ''}"${
    go ? ` data-go="${esc(go)}"` : ' disabled'}><span class="tsqface"><b>${fmtNum(n)}</b><span>${esc(lab)}</span>${
    sub ? `<em>${esc(sub)}</em>` : ''}</span></button>`;
  return `<div class="card tstrip">
    <div class="tsday">${refPlate(d.dm.toUpperCase(), 21)}<span class="tsdow">${esc(d.dow)}${
      dayNow ? '' : ' · next programme day'}</span></div>
    <div class="tsq-row">
      ${tile(due.length, due.length === 1 ? 'due in' : 'due in', 'schedule entries', 'timeline')}
      ${tile(onsite, 'recorded on site', onsite === due.length && due.length ? 'all of them' : 'so far today', 'register')}
      ${/* "not recorded on site", not "not on site": an entry with no record is an entry nobody has recorded,
            and the tile must not read as the page having looked. Outside audit, 17 Sep 2026. */ ''}
      ${tile(notYet, 'not recorded on site', notYet ? splitWords : 'nothing outstanding', 'register', notYet ? 'gap' : '')}
      ${refs ? tile(refs, refs === 1 ? 'row needs a reference' : 'rows need references', 'on the schedule', 'timeline', 'gap') : ''}
    </div>
    <div class="tsnote">${R.review || refs
      ? `<b>${fmtNum(chase)}</b> thing${chase === 1 ? '' : 's'} to look at today${both
          ? ` — ${fmtNum(both)} ${both === 1 ? 'row is' : 'rows are'} in both groups above, so the two counts are not added together`
          : ', and nothing is in both groups above'}.`
      : due.length ? 'Every entry due in today has an outcome recorded.'
      : 'Nothing is due in on this day.'}</div>
  </div>`;
}
/* v5.52 — THE ROADS ROUND THE CIRCUIT, AS TOMTOM SAW THEM AT A STATED MOMENT. A closure on the Gold Coast
   Highway is a closure on the way to half the drops, so the day's page says what was reported and when — and
   says plainly that it is a snapshot taken when the build was made, not a live feed. Nothing is worked out
   here: the kind, the stretch, the times and the delay are TomTom's words and numbers. */
function roadsCard(){
  const R = roadsSnapshot(); if (!R) return '';
  const inc = R.incidents || [];
  const chip = k => /closure|closed/i.test(k) ? 'crit' : /works|lane/i.test(k) ? 'act' : 'cand';
  const span = i => {
    const a = i.start ? fmtWhen(i.start) : '', b = i.end ? fmtWhen(i.end) : '';
    return b ? `${a} – ${b}` : a ? `since ${a}, no end time given` : '';
  };
  /* v5.63 — THE CARD SAYS WHICH ROADS WERE LOOKED AT, because the answer changes with the snapshot.
     The box the incidents come from is in the snapshot itself. Measured on 21 Sep 2026 it was 3.4 x 3.9 km —
     the drawing frame and its approach roads — while the depot at Kingston sits 33 km north of it and the run
     is 54.8 km. So a closure on the M1, the one road every load actually drives, could not appear, and this
     card said "Roads round the circuit" as though that were the whole story. It now reads the box and says
     what it covers: widen the box when the snapshot is taken and the words widen with it, rather than a
     heading quietly overstating what was checked. */
  const B = R.bbox || {}, dep = DATA.depot || {};
  const reaches = Number.isFinite(B.south) && Number.isFinite(B.north) && Number.isFinite(dep.lat)
    && B.south <= dep.lat && dep.lat <= B.north && B.west <= dep.lon && dep.lon <= B.east;
  const area = reaches ? `between ${esc(dep.name || 'the depot')} and the circuit` : 'round the circuit';
  /* v5.55 — WHEN THE STORED ONE HAS GONE OFF, THE LIVE ONE LEADS. Andrew Fisher, 21 Sep 2026: TomTom was showing
     old updates.

     Saying how old the snapshot is (v5.54) stopped anybody being misled, and it did not stop the page putting
     Tuesday's incident list at the top of the card on a Friday. Roads are not a thing you store. A closure
     that was there on Tuesday is very likely gone, and the one that matters this morning is certainly not in
     the list — so at the top of the card, that list is worse than nothing, because it reads like an answer.

     Past two days the card turns over: live first, in as many words, and the snapshot demoted underneath as
     what it is — a dated record of what was checked when the build was made. Nothing is deleted and nothing is
     hidden; the order just stops lying about which one to trust at 4am with a load waiting. */
  /* A REPORT THAT HAS OUTLIVED ITS OWN END TIME. 21 Sep 2026, from the live review: at 22:39 the card was
     still listing incidents whose printed end times were earlier that afternoon. The card already said the
     whole snapshot was a snapshot, which is right, but a reader scanning fourteen lines has no reason to do
     the arithmetic on each one. So the ones whose stated end has gone by are marked as such and dimmed.

     It says the END TIME has passed, not that the road is clear. TomTom gave an expected end; whether the
     queue actually went is not a thing this page has any way of knowing, and saying it did would be inventing
     a clearance. */
  const gone = i => { const t = i && i.end ? Date.parse(i.end) : NaN; return isFinite(t) && t < Date.now(); };
  const g = snapAge(R.taken_at), stale = !!(g && g.stale);
  const live = liveRunUrl();
  const area_ll = (DATA.georef && lonLatOf(0.5, 0.5)) || null;
  const liveArea = area_ll ? 'https://www.google.com/maps/@' + area_ll.lat.toFixed(5) + ',' + area_ll.lon.toFixed(5) + ',15z/data=!5m1!1e1' : null;
  return `<div class="card roadscard"><h3>Roads ${area}</h3>
    ${stale ? `<div class="notice warn" style="margin:0 0 12px">
      <b>This is ${esc(g.words)}. Check the roads live before you back on it.</b>
      <div style="margin-top:7px;display:flex;flex-wrap:wrap;gap:8px">
        ${live ? `<a class="btn" href="${live}" target="_blank" rel="noopener noreferrer">The run from ${esc(dep.name || 'the depot')}, live</a>` : ''}
        ${liveArea ? `<a class="btn ghost" href="${liveArea}" target="_blank" rel="noopener noreferrer">Traffic round the circuit, live</a>` : ''}
      </div>
      <p class="fine" style="margin-top:7px">Google's own map, live traffic and a live arrival time. It opens outside this page and nothing goes to it but the two positions. What TomTom said when this build was made is below, kept as the dated record it is — a closure listed there has very likely gone, and one that matters this morning will not be in it.</p></div>` : ''}
    <p class="sub">${stale ? 'What TomTom said at' : 'As TomTom reported them at'} <b>${esc(fmtWhen(R.taken_at))}</b> ${snapAgeChip(R.taken_at)}${stale ? '' : liveRunLink(R.taken_at)} — a snapshot taken for this build, not a live feed. The truck's own satnav is live.${
      reaches ? '' : ` <b>The box checked is the circuit and its approach roads only</b>, so nothing on the run from ${esc(dep.name || 'the depot')} is in here.`}</p>
    ${/* v5.66 — AND A STALE LIST STARTS FOLDED. GC500 live review, 22 Sep 2026: "Collapse old traffic by
           default, show its age prominently and avoid current-tense wording."

           The card already demotes a stale snapshot below the live links and marks the reports whose own end
           time has gone. What it still did was open fourteen dated lines straight at the reader, which is the
           same fault one layer down: a list that long reads like an answer whether or not there is a notice
           above it. When the snapshot is stale the list folds, and the fold says how old it is and how many of
           its reports have outlived their stated window — so opening it is a decision rather than the default.
           Nothing is deleted, nothing is hidden, and a fresh snapshot is still open on arrival. */ ''}
    ${inc.length && stale ? `<details class="roadsold"><summary>${esc(fmtNum(inc.length))} ${inc.length === 1 ? 'report' : 'reports'} from ${esc(g.words)}${
        inc.filter(gone).length ? ` · ${esc(fmtNum(inc.filter(gone).length))} past ${inc.filter(gone).length === 1 ? 'its' : 'their'} stated end time` : ''} — open the dated list</summary>` : ''}
    ${inc.length ? `<ul class="roads">${inc.map(i => `<li${gone(i) ? ' class="spent"' : ''}>
      <span class="chip ${chip(i.kind)}">${esc(i.kind)}</span> <b>${esc(i.road)}</b>, ${esc(i.from)} to ${esc(i.to)}${i.length_m ? ` <span class="w">· ${esc(fmtMetres(i.length_m))}</span>` : ''}${
        gone(i) ? ` <span class="chip cand" title="TomTom gave this report an end time of ${esc(fmtWhen(i.end))}, and that time has passed. Whether the road actually cleared is not something this page knows.">its own end time has passed</span>` : ''}
      <br><span class="w">${esc(span(i))}${i.delay_s ? ` · about ${Math.round(i.delay_s / 60)} min delay` : ''}${i.probability && i.probability !== 'certain' ? ` · TomTom rates it ${esc(i.probability)}` : ''}</span>
      ${i.note ? `<br><span class="w">${esc(i.note)}</span>` : ''}</li>`).join('')}</ul>`
    : `<p class="norate">Nothing reported ${area} at that moment.</p>`}
    ${inc.length && stale ? '</details>' : ''}
    ${inc.filter(gone).length ? `<p class="fine">${inc.filter(gone).length} of these ${inc.length === 1 ? 'report' : 'reports'} ${inc.filter(gone).length === 1 ? 'has' : 'have'} passed the end time TomTom gave ${inc.filter(gone).length === 1 ? 'it' : 'them'}. That says the reported window is over, not that the road is clear.</p>` : ''}
    <p class="norate">Traffic and routes: TomTom.</p>
  </div>`;
}
function renderToday(){
  const today = todayIso();
  const days = programmeDays();
  const dayNow = days.find(d => d.iso === today) || null;
  const next = days.find(d => d.iso > today) || null;
  const show = dayNow || next;
  const t = lightTally(allAssets());
  const dockets = allDockets(), usable = dockets.filter(d => d.usable);
  const fcost = Math.round(usable.reduce((a, d) => a + d.cost_total, 0) * 100) / 100;
  const watch = fenceQuote() ? quoteWatch(dockets) : [];
  const over = watch.filter(w => w.state === 'over quote');
  const wk = weekOf(today);
  const fw = wk ? fenceByWeek(dockets).find(w => w.week === wk.sheet) : null;
  const vars = allVariances();
  const un = vars.filter(v => v.authority_state === 'unattributed').length;
  const lc = localCounts(), att = attention();
  const anyLocal = Object.values(lc).some(n => n > 0);
  const bdOpen = allBreakdowns().filter(b => b.open), bdStop = bdOpen.filter(b => b.severity === 'stops work');
  const rows = show ? show.deliveries.slice().sort(etaSort).slice(0, 6) : [];
  state.list = rows.map(r => r.a.key);
  const line = r => { const d = deliveryOf(r.a.key);
    return `<li class="hubrow"><span class="tm">${d.eta ? esc(d.eta) : '—:—'}</span><button class="linkish plateb" data-k="${esc(r.a.key)}" aria-label="Open ${esc(r.a.key)}">${refPlate(r.a.key, 15)}</button>${dstat(r.a, {size: 'sm', bare: true})}
      <span class="w" style="color:var(--mute)">${esc((r.a.item_types || []).join(', ') || r.a.product || '')}${r.a.name ? ' · ' + esc(r.a.name) : ''}<span class="anos">${assetNosLine(r.a)}</span></span></li>`; };
  $('#pane-today').innerHTML = paneHeadingHtml('today') + `
  <div class="dsnband">${dsnBoard(today, dsnState(today), 'video')}</div>   <!-- v6.10 - the day strip is the banner's day pod now -->
  <!-- F11, Superior Audit 15 Sep 2026: the brief ran to 880px and left roughly 400px of empty white beside it
       on every laptop, while the carrier loads and the circuit notes — the context a person reads the brief
       AGAINST — sat 3,000px further down the page. They share a row now, and the column stacks under the brief
       on anything narrower than 1180px. -->
  <div class="todaycols">
  ${dailyBrief(today)}
  ${((show && (show.loads.length || show.notes.length)) || roadsSnapshot()) ? `<aside class="sidecol">
    ${show && show.loads.length ? `<div class="card"><h3>Carrier loads ${dayNow ? 'today' : 'that day'}</h3>
      <p class="sub">${loadTimesLine()}</p>
      <ul>${show.loads.slice().sort((x, y) => x.time.localeCompare(y.time)).map(loadLi).join('')}</ul>
      <p class="norate">${esc(((DATA.transport || {}).carrier || {}).authority || '')}</p></div>` : ''}
    ${roadsCard()}
    ${show && show.notes.length ? `<div class="card"><h3>What D007 says the circuit is doing</h3>
      <ul>${show.notes.flatMap(n => n.items).map(i => `<li><span class="tm">${esc(i.time)}</span>${esc(i.text || '')}${i.bullets.length ? '<ul>' + i.bullets.map(b => '<li>' + esc(b) + '</li>').join('') + '</ul>' : ''}</li>`).join('')}</ul></div>` : ''}
  </aside>` : ''}
  </div>
  <div class="hubhead">
    <div><h2>${esc(fmtDate(today))}</h2>
      <div class="sub">${wk ? esc(weekWords(wk)) : 'outside every week on the 2026 schedule'} · ${esc(DATA.event.name)} · ${esc(DATA.event.race_dates_as_supplied)}</div></div>
    <div class="hubwho editonly">${!canEdit() ? '' : S.operator ? `Recording as <b>${esc(S.operator)}</b>` : '<button class="linkish" data-focus="who">Put your name in “Recording as” before you record anything</button>'}</div>
  </div>
  <!-- v5.87 - the three instruments first: the dial, the signal head, the programme; then the cards -->
  <div class="inst">
    <div class="card hubcard island lights">
      <div class="hubtitle"><h3>The lights</h3><span class="chip ref">${t.total} assets</span></div>
      <div class="hublights">
        ${signalHead(t)}
        <button class="hl" data-lf-go="green"><span class="tl green"><i></i></span><b>${t.green}</b> on site</button>
        <button class="hl" data-lf-go="amber"><span class="tl amber"><i></i></span><b>${t.amber}</b> in transit</button>
        <button class="hl" data-lf-go="red"><span class="tl red"><i></i></span><b>${t.red}</b> not on site</button>
        <button class="hl" data-lf-go="none"><span class="tl none"><i></i></span><b>${t.none}</b> no record</button>
        <button class="hl" data-lf-go="done"><span class="tick sm" aria-hidden="true">✓</span><b>${t.done}</b> complete</button>
        ${t.needLevel ? `<button class="hl" data-lf-go="levelled" title="positioned and levelled — the final check on a building, toilet or tank; ${t.needLevel} on the job can carry it"><span class="tick sm lvl" aria-hidden="true">${levelGlyph(11)}</span><b>${t.levelled}</b> <span class="w">of ${t.needLevel}</span> levelled</button>` : ''}
        ${t.needLevel ? `<button class="hl" data-lf-go="steps" title="steps installed — its own check, separate from levelled; ${t.needLevel} on the job can carry it"><span class="tick sm stp" aria-hidden="true">${stepsGlyph(11)}</span><b>${t.steps}</b> <span class="w">of ${t.needLevel}</span> steps</button>` : ''}
      </div>
      <div class="hubgo" data-go="register" role="link" tabindex="0">Open the register →</div>
    </div>
    ${(() => { const C = completionAsOf(today), P = C.P, v = verdictIn(P.all); return `
    <div class="card hubcard island dialcard${P.all.overdue || C.cls === 'crit' ? ' alert' : ''}">
      <div class="hubtitle"><h3>How far through the job we are</h3><span class="chip ${v.cls}">${esc(v.word)}</span></div>
      ${completionBlock(today, C, {note: false, scope: 'due'})}
      <p class="norate"><b>${P.all.onsite}</b> of <b>${P.all.due}</b> references due in are on site${P.all.complete ? ` · ✓ ${P.all.complete} complete` : ''}${
        P.all.overdue ? ` · <b style="color:var(--red)">${P.all.overdue}</b> overdue` : ''}${P.all.norecord ? ` · ${P.all.norecord} unrecorded` : ''} · ${P.all.next} due in the next ${PROG_NEXT_DAYS} days · fencing ${P.fenceLines.length ? (P.fenceLines.every(l => !l.behind) ? 'on track' : 'behind') : 'nothing planned yet'}</p>
      <div class="hubgo" data-go="progress" role="link" tabindex="0">Open the summary →</div>
    </div>`; })()}
    ${progCard(today)}
  </div>
  <div class="hub">
    <div class="card hubcard" data-go="timeline" data-day="${esc(show ? show.iso : '')}">
      <div class="hubtitle"><h3>${dayNow ? 'Due today' : next ? 'Next programme day' : 'Programme'}</h3>${show ? `<span class="chip ref">${esc(fmtDate(show.iso).slice(0, 10))}</span>` : ''}</div>
      ${show ? `<div class="hubbig"><b>${show.deliveries.length}</b> due in <span class="w">·</span> <b>${show.removals.length}</b> due out${show.loads.length ? ` <span class="w">·</span> ${show.loads.length} carrier load${show.loads.length === 1 ? '' : 's'} listed` : ''}</div>
        <ul class="hublist">${rows.map(line).join('')}${show.deliveries.length > rows.length ? `<li class="more">and ${show.deliveries.length - rows.length} more on the day view</li>` : ''}</ul>`
        : '<p class="norate">No programme day on or after today in the register.</p>'}
      <div class="hubgo">Open the day view →</div>
    </div>
    ${(() => { const v = adviceFor(today), lines = v.arrivals.slice(-4).reverse(); return `
    <div class="card hubcard advicecard" data-go="timeline" data-day="${esc(today)}">
      <div class="hubtitle"><h3>Delivered today</h3><span class="chip ${v.arrivals.length ? 'ok' : ''}">${v.arrivals.length} recorded on site</span></div>
      <div class="hubbig"><b>${v.arrivals.length}</b> recorded on site${v.ticks.length ? ` <span class="w">·</span> <span class="tick sm">✓ ${v.ticks.length}</span> complete` : ''}${
        v.levelled.length ? ` <span class="w">·</span> <span class="tick sm lvl">${levelGlyph(11)} ${v.levelled.length}</span> levelled` : ''}${
        (() => { const S_ = dueSplit(v); return S_.n ? ` <span class="w">·</span> <b>${S_.n}</b> due in not on site${
          S_.detail ? ` <span class="w" style="font-weight:400">(${esc(S_.detail)})</span>` : ''}` : ''; })()}${
        v.dueElsewhere.length ? ` <span class="w">·</span> ${v.dueElsewhere.length} due in already on site from another day` : ''}</div>
      ${lines.length ? `<ul class="hublist compact">${lines.map(r => { const b = branchOf(r.a.key); return `<li><span class="tm">${esc(timeOfStamp(r.at))}</span>${esc(r.a.key)}${r.a.name ? ' — ' + esc(r.a.name) : ''}
        <span class="w" style="color:var(--mute)">· ${b.code ? 'branch ' + esc(b.code) : 'no branch recorded'} · ${esc(r.by || 'unnamed')}</span></li>`; }).join('')}${
        v.arrivals.length > lines.length ? `<li class="more">and ${v.arrivals.length - lines.length} earlier today</li>` : ''}</ul>`
        : '<p class="norate">No light has been set on site today. This card shows what people recorded — it never assumes a delivery from the plan.</p>'}
      <div class="daynav" style="margin-top:8px">
        <button class="btn" data-advice="${esc(today)}" title="One page: what was recorded on site today, with times, branch codes and who recorded each one">Advice for today</button>
        <a class="btn" href="${adviceMailto(today)}" title="Opens your mail app with today's recorded arrivals written out">Email it</a>
      </div>
      <div class="hubgo">Open the day view →</div>
    </div>`; })()}
    ${show && show.unref.length ? `<div class="card hubcard unrefcard" data-go="timeline" data-day="${esc(show.iso)}">
      <div class="hubtitle"><h3>Also on the schedule ${dayNow ? 'today' : 'that day'} — no reference</h3><span class="chip cand">${show.unref.length} row${show.unref.length === 1 ? '' : 's'}</span></div>
      <ul class="hublist compact">${show.unref.slice(0, 4).map(r => `<li><span class="tm">${esc(r.quantity_display && r.quantity_display !== 'blank' ? r.quantity_display + ' ×' : '—')}</span>${esc(r.item || r.product || r.task_id)}
        <span class="w" style="color:var(--mute)">· ${esc(r.location || 'no location on the row')}${r.activity ? ' · ' + esc(r.activity) : ''} · <span class="mono">${esc(r.task_id)}</span></span></li>`).join('')}${
        show.unref.length > 4 ? `<li class="more">and ${show.unref.length - 4} more on the day view</li>` : ''}</ul>
      <p class="norate">Scheduled rows, not arrivals — the schedule names the work but no GC500 reference, so nothing here carries a light until somebody gives it one on the day view.</p>
      <div class="hubgo">Open the day view →</div>
    </div>` : ''}
    ${TEAM.people.length ? `<div class="card hubcard teamhub" data-go="about">
      <div class="hubtitle"><h3>Who to call</h3><span class="chip ref">${TEAM.people.length} on the team</span></div>
      <ul class="tm-list compact">${TEAM.people.filter(p => ['site', 'transport', 'install'].includes(p.group)).map(p => teamPerson(p, {compact: true})).join('')}</ul>
      <div class="hubgo">The whole team, with emails →</div>
    </div>` : ''}
    <div class="card hubcard${over.length ? ' alert' : ''}" data-go="fencing">
      <div class="hubtitle"><h3>Fencing</h3>${fenceQuote() ? (over.length ? `<span class="chip crit">${over.length} line${over.length > 1 ? 's' : ''} over the quote</span>` : '<span class="chip ok">within quote</span>') : '<span class="chip">no quote entered</span>'}</div>
      <div class="hubbig"><b>${usable.length}</b> docket${usable.length === 1 ? '' : 's'} <span class="w">·</span> <b>${esc(money(fcost) || '$0.00')}</b> charged</div>
      ${fw ? `<ul class="hublist compact">${fw.lines.filter(l => ['clean', 'scrim', 'ccb_event', 'ccb_demarc', 'v_gates'].includes(l.column) && (l.planned || l.done)).map(l =>
        `<li><span class="tm">${esc(fmtQty(l.done, l.unit))}</span>${esc(l.name)} done this week${!l.planned ? ' <span class="w" style="color:var(--mute)">· nothing planned this week</span>' : l.remaining != null ? ` <span class="w" style="color:var(--mute)">· ${l.remaining < 0 ? esc(fmtQty(-l.remaining, l.unit)) + ' over the plan' : esc(fmtQty(l.remaining, l.unit)) + ' still to do'}</span>` : ''}</li>`).join('')}</ul>` : ''}
      <div class="hubgo">Open fencing →</div>
    </div>
    <div class="card hubcard tabsoff${un ? ' alert' : ''}" data-go="variances">
      <div class="hubtitle"><h3>Variances</h3>${un ? `<span class="chip crit">${un} with nobody's name</span>` : vars.length ? '<span class="chip ok">all attributed</span>' : ''}</div>
      <div class="hubbig"><b>${vars.length}</b> on the register <span class="w">·</span> ${vars.filter(v => v._where === 'local').length} ${SYNC.on ? 'in the shared record' : 'in this browser only'}</div>
      <div class="hubgo">Open Plant →</div>
    </div>
    <div class="card hubcard tabsoff${bdStop.length ? ' alert' : ''}" data-go="breakdowns">
      <div class="hubtitle"><h3>Breakdowns</h3>${bdStop.length ? `<span class="chip crit">${bdStop.length} stopping work</span>` : bdOpen.length ? `<span class="chip act">${bdOpen.length} open</span>` : '<span class="chip ok">none open</span>'}</div>
      <div class="hubbig"><b>${bdOpen.length}</b> open <span class="w">·</span> ${allBreakdowns().length - bdOpen.length} fixed or closed</div>
      ${bdOpen.length ? `<ul class="hublist compact">${bdOpen.slice(0, 4).map(b => `<li><span class="chip ${BD_CHIP[b.severity] || ''}">${esc(b.severity)}</span><span class="w">${esc(b.ref || b.area || '')} — ${esc(b.what)}</span></li>`).join('')}${bdOpen.length > 4 ? `<li class="more">and ${bdOpen.length - 4} more</li>` : ''}</ul>` : ''}
      <div class="hubgo">Open the breakdowns →</div>
    </div>
    ${(() => { /* v5.83 — the Today card reads the money the way Costs &amp; charges does: what we charge the V8s, what Coates
         pays so far, the difference, and the streams that carry the most — one basis, the same figures */
      const C = allCosts(), T = costTotals(C), M = moneySummary();
      const sd = v => v < 0 ? '−' + money0(-v) : money0(v);
      const top = M.streams.filter(s => s.charge_known && s.charge > 0).sort((a, b) => b.charge - a.charge).slice(0, 4);
      return `
    <div class="card hubcard${T.problems || M.difference0 < 0 ? ' alert' : ''}" data-go="costs">
      <div class="hubtitle"><h3>Costs &amp; charges</h3>${T.problems ? `<span class="chip crit">${T.problems} incomplete</span>` : `<span class="chip cand" title="${esc(M.missing_short.join(' · '))}">${M.missing.length} not in it yet</span>`}</div>
      <div class="hubbig"><b>${esc(money0(M.charge.total))}</b> we charge the V8s, ex GST</div>
      <ul class="hublist compact">
        <li><span class="w">Coates pays — known so far</span><span class="tm">${esc(money0(M.cost.known))}</span></li>
        <li><span class="w"><b>Difference so far</b> — not a margin yet</span><span class="tm"${M.difference0 < 0 ? ' style="color:var(--red)"' : ''}>${esc(sd(M.difference0))}</span></li>
        ${top.map(s => `<li><span class="w">${esc(s.name)}${s.cost_known ? ` <span style="color:var(--mute)">· Coates pays ${esc(money0(s.cost0))}</span>` : ''}</span><span class="tm">${esc(money0(s.charge0))}</span></li>`).join('')}</ul>
      <div class="hubgo">Open costs &amp; charges →</div>
    </div>`; })()}
    <div class="card hubcard editonly${att.export ? ' alert' : ''}">
      <div class="hubtitle"><h3>Your records</h3>${att.export ? `<span class="chip crit">${att.export} change${att.export > 1 ? 's' : ''} since export</span>` : anyLocal && S.lastExport ? '<span class="chip ok">export recorded</span>' : anyLocal ? '<span class="chip">no export recorded</span>' : ''}</div>
      ${anyLocal ? `<ul class="hublist compact">${[['lights', 'traffic lights set'], ['supplied', 'supplied records'], ['variances', 'variances'], ['dockets', 'fencing dockets'], ['notes', 'notes'], ['added', 'assets added'], ['quote', 'fencing quote']]
        .concat([['breakdowns', 'breakdowns'], ['contracts', 'rental contracts'], ['rental', 'assets put on a Rental ID'], ['costs', 'cost lines']]).filter(([k]) => lc[k]).map(([k, w]) => `<li><span class="tm">${lc[k]}</span>${esc(w)}</li>`).join('')}</ul>
        <p class="norate">${S.lastExport ? 'Last export recorded on this device: ' + esc(fmtStamp(S.lastExport)) + '.' : 'No export has been recorded on this device.'}
          ${SYNC.on ? 'Shared-record mode — the header shows confirmation and any pending changes. Export keeps a separate file copy.'
            : FOLDER.status === 'live' ? 'Shared-folder mode — records are kept in the connected folder. Export keeps a separate file copy.'
            : 'Saved in this browser only — export after each session to keep a separate copy.'}</p>
        <div><button class="btn primary" data-export="1">Export now</button> <button class="btn" data-import="1">Import someone's file</button></div>`
        : '<p class="norate">Nothing recorded in this browser yet. Lights, supplied records, variances, dockets and notes all land here, and Export carries them to the record.</p>'}
      ${S.lastImport ? `<p class="norate" style="margin-top:8px">Last import ${esc(fmtStamp(S.lastImport.at))}${S.lastImport.from ? ' from ' + esc(S.lastImport.from) : ''}: ${esc(S.lastImport.summary || '')}</p>` : ''}
    </div>
    <div class="card hubcard" data-go="map">
      <div class="hubtitle"><h3>Map</h3><span class="chip ref">${DATA.sheets.length} sheets</span></div>
      <div class="hubsheets">${DATA.sheets.map(sh => `<button class="btn" data-sheet-go="${esc(sh.key)}">${esc(sh.title)}</button>`).join('')}</div>
      <div class="hubgo">Open the map →</div>
    </div>
    <div class="card hubcard" data-go="docs">
      ${(() => { /* F04: the teaser reads the SAME collection the Documents tab does. It used to read the build
                    catalogue's stored counts, so nothing uploaded since the build ever reached it. */
        const C = docCollection();
        /* WHAT THIS NUMBER COUNTS, ON ITS FACE. 21 Sep 2026, from the live review: this said "56 files" while
           the Documents tab said 144 listed — 56 from the build catalogue and 88 uploaded since. Both were
           right and they looked like a contradiction, because this one never said which of the two it was.
           It says so now. The uploaded count is only shown when the library has ALREADY been read for some
           other reason: Today is not going to fetch the whole document library to put a number in a chip. */
        return `<div class="hubtitle"><h3>Documents</h3><span class="chip ref" title="${DOCS.files ? 'The build catalogue and every file uploaded since, as last read by this page.' : 'The catalogue this build carries. Files uploaded since are added once the Documents tab has been read.'}">${fmtNum(C.items.length)} ${DOCS.files ? 'listed' : 'in this build'}</span>${(() => {
          const up = DOCS.files ? Object.keys(DOCS.files).length : null;
          return up ? `<span class="chip cand" title="Uploaded to the service since the build, as last read by this page.">${fmtNum(up)} uploaded since the build</span>` : '';
        })()}</div>
      <div class="hubbig">${safetyWords(C.items).words.split(' · ').map(w => w.replace(/^(\S+) /, '<b>$1</b> ')).join(' <span class="w">·</span> ')} <span class="w">·</span> <b>${C.countOf('transport')}</b> transport <span class="w">·</span> <b>${C.countOf('map')}</b> maps and plates <span class="w">·</span> <b>${C.countOf('pack')}</b> packs${
        C.photos ? ` <span class="w">·</span> <b>${C.photos}</b> photo${C.photos === 1 ? '' : 's'}` : ''}</div>
      <p class="norate">${C.countOf('swms') ? 'Browse the catalogue and open the available files — the SWMS, the drawings as issued, the A1 and A3 print set and the packs.' : 'No SWMS supplied yet. Browse the catalogue and open the available files — the drawings as issued, the A1 and A3 print set and the packs.'}${
        C.availabilityState === 'checking' ? ' Checking file availability…' : C.availabilityState === 'unchecked'
        ? ' Availability could not be checked; this does not mean the files are missing.'
        : C.unhosted ? ` <b>${fmtNum(C.available)}</b> of the ${fmtNum(C.items.length)} open from here; the rest are ${C.hosted ? 'not uploaded yet' : 'not beside this file'}.` : ''}</p>`; })()}
      <div class="hubgo">Open the documents →</div>
    </div>
    ${(() => { /* a number delivered against two references is a driver sent to the wrong place, so it is on
                  the day's own screen rather than waiting to be found. It names them and opens each one; it
                  never picks.

                  v5.73 — only where it is real. A number the plan lists against two references is a guide
                  (Andrew Fisher, 22 Sep 2026: an asset number is not locked in until it has been delivered and marked
                  as delivered) and does not belong on an alert card. Where exactly one side is delivered
                  the answer is already known, so it is a tidy-up listed quietly underneath, not a crisis. */
      const grades = claimGrades(); if (!grades.size) return '';
      const rows = [...grades.entries()].sort((x, y) => x[0].localeCompare(y[0]));
      const hard = rows.filter(([, g]) => g.grade === 'contradiction');
      const stale = rows.filter(([, g]) => g.grade === 'settled');
      if (!hard.length && !stale.length) return '';
      const who = (n, k, g) => `<button class="linkish" data-k="${esc(k)}">${esc(k)}</button>`
        + `<span class="w" style="color:var(--mute)"> (${esc(claimWhere(n, k))}${g.locked.includes(k) ? ', delivered' : ''}${
          (assetOf(k) || {})._cancelled ? ', cancelled' : ''})</span>`;
      return `<div class="card hubcard${hard.length ? ' alert' : ''} clashcard">
      <div class="hubtitle"><h3>${hard.length ? 'Asset numbers delivered against two references' : 'Plan lines overtaken by a delivery'}</h3>
        <span class="chip ${hard.length ? 'crit' : 'ref'}">${hard.length || stale.length} number${(hard.length || stale.length) === 1 ? '' : 's'}</span></div>
      ${hard.length ? `<p class="norate">One machine cannot be two buildings. These numbers have been delivered
        and marked delivered against more than one reference, so two drop sheets carry the same number and one
        of them sends a driver to the wrong place. Open either reference and take the number off the one it is
        not.</p>
      <ul class="hublist compact">${hard.slice(0, 6).map(([n, g]) => `<li><span class="tm mono">${esc(n)}</span> ${
        g.keys.map(k => who(n, k, g)).join(' <span class="w">and</span> ')}</li>`).join('')}${
        hard.length > 6 ? `<li class="more">and ${hard.length - 6} more</li>` : ''}</ul>` : ''}
      ${stale.length ? `<p class="norate"${hard.length ? ' style="margin-top:10px"' : ''}>${hard.length ? 'Separately — ' : ''}${
        stale.length} number${stale.length === 1 ? ' has' : 's have'} been delivered against one reference while
        another still lists ${stale.length === 1 ? 'it' : 'them'} on the plan. The delivered one is the record.
        Nothing is wrong on the ground; the plan line is just worth taking off.</p>
      <ul class="hublist compact">${stale.slice(0, 4).map(([n, g]) => `<li><span class="tm mono">${esc(n)}</span> ${
        who(n, g.locked[0], g)} <span class="w">— plan still lists</span> ${
        g.guide.map(k => who(n, k, g)).join(' <span class="w">and</span> ')}</li>`).join('')}${
        stale.length > 4 ? `<li class="more">and ${stale.length - 4} more</li>` : ''}</ul>` : ''}
    </div>`; })()}
    <div class="card hubcard editonly tabsoff" data-go="edit">
      ${(() => { /* Andrew Fisher, 16 Sep 2026: editing has to be really easy.
                    A page nobody can find is not easy, so the day's own screen carries it and says what has
                    already been changed there. */
        const all = allAssets(), touched = all.filter(editTouched);
        const soon = all.filter(a => { const d = effectiveDates(a).in; return d && d >= todayIso() && d <= addDays(todayIso(), 14); });
        return `<div class="hubtitle"><h3>Edit</h3><span class="chip ${touched.length ? 'act' : 'ref'}">${fmtNum(touched.length)} typed over</span></div>
      <div class="hubbig"><b>${fmtNum(all.length)}</b> references <span class="w">·</span> <b>${fmtNum(soon.length)}</b> due in the next fortnight</div>
      <p class="norate">Days, descriptions, where a thing goes and the rate, in one table you type straight into.
        A change here is on the register, the drawer, the map, the load brief, the advice email and every printed
        sheet at once — and the schedule's own wording stays underneath either way.</p>`; })()}
      <div class="hubgo">Open the edit table →</div>
    </div>
  </div>
  <p class="maphint">Press <b>/</b> to search from anywhere. Every card opens the tab that does the work; a link to any asset, day or tab can be copied and sent —
    <span class="mono">#asset/GN01</span>, <span class="mono">#day/2026-09-14</span>, <span class="mono">#fencing</span>.</p>`;
  const pane = $('#pane-today');
  raceMount(pane);
  wireBoard(pane, today, dsnState(today));   /* the clip, its sound and the board's pages */
  /* v5.88 - an instrument's Open line is the one thing on it that navigates (Andrew Fisher, 25 Sep 2026: a press
     anywhere on the gauge jumping to another tab was the wrong feel for an instrument) */
  pane.querySelectorAll('.island .hubgo[data-go]').forEach(g => { const f = ev => { ev.stopPropagation(); go(g.dataset.go); };
    g.onclick = f; g.onkeydown = ev => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); f(ev); } }; });
  pane.querySelectorAll('.hubcard[data-go]').forEach(c => {
    c.tabIndex = 0; c.setAttribute('role', 'link');
    const open = ev => { if (ev.target.closest('button,a,input')) return; if (c.dataset.day) { state.day = c.dataset.day; state.tlView = 'day'; } go(c.dataset.go); };
    c.onclick = open; c.onkeydown = ev => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); open(ev); } };
  });
  pane.querySelectorAll('[data-k]').forEach(b => { b.onclick = ev => { ev.stopPropagation(); openAsset(b.dataset.k); };
    if (b.getAttribute('role') === 'button') b.onkeydown = ev => {
      if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); ev.stopPropagation(); openAsset(b.dataset.k); } }; });
  pane.querySelectorAll('[data-lf-go]').forEach(b => b.onclick = ev => { ev.stopPropagation(); state.light = b.dataset.lfGo || null; state.disc = null; go('register'); });
  pane.querySelectorAll('[data-advice]').forEach(b => b.onclick = ev => { ev.stopPropagation(); adviceSheet(b.dataset.advice); });
  pane.querySelectorAll('[data-handover]').forEach(b => b.onclick = ev => { ev.stopPropagation(); handoverSheet(b.dataset.handover); });
  pane.querySelectorAll('[data-sheet-go]').forEach(b => b.onclick = ev => { ev.stopPropagation(); state.sheet = b.dataset.sheetGo; state.sel = null; state.zoom = 1; state.ox = 0; state.oy = 0; go('map'); });
  const ex = pane.querySelector('[data-export]'); if (ex) ex.onclick = () => $('#exportBtn').click();
  const im = pane.querySelector('[data-import]'); if (im) im.onclick = () => $('#importBtn').click();
  const wf = pane.querySelector('[data-focus="who"]'); if (wf) wf.onclick = () => whoFocus();
}

/* ------------------------------------------------------------------ map */
const SAT_BOARD = '__satellite';
/* v5.66 — ONE PIN A REFERENCE ON THE SATELLITE BOARD. Andrew Fisher, 22 Sep 2026: the pinned locations on the
   satellite maps show one for each thing, not several.

   A reference can carry several recorded positions — one for the reference itself and one for each building
   inside it, which is right in the reference's own drawer and wrong on a picture of the whole site: six pins
   within a few metres of each other read as six things rather than as one place somebody stood, and they hide
   each other and everything behind them.

   So the board shows ONE, and picks it in this order: the pin taken on the reference itself, because that is
   the reference's own position and not one of its parts; failing that the most accurate of the unit pins;
   failing that the most recent. Nothing is dropped from the record and nothing is hidden — the pin carries how
   many were recorded, the popup says so, and every one of them is still in the reference's drawer where it was
   taken. The sheets are left alone: a drawing of one front is the place where a building's own pin belongs. */
function satBoardPins(){
  const all = Object.entries(S.fixes || {}).filter(([k, f]) => f && f.lat != null)
    .map(([k, f]) => Object.assign({key: k}, fixParse(k), f));
  const byRef = new Map();
  all.forEach(p => { const r = p.ref || p.key; (byRef.get(r) || byRef.set(r, []).get(r)).push(p); });
  const best = (xs) => {
    const own = xs.filter(x => !x.unit);
    if (own.length) xs = own;                                   /* the reference's own pin wins outright */
    return xs.slice().sort((a, b) => {
      const aa = a.acc == null ? Infinity : a.acc, ab = b.acc == null ? Infinity : b.acc;
      if (aa !== ab) return aa - ab;                             /* then the one the phone was surest of */
      return String(b.at || '').localeCompare(String(a.at || ''));  /* then the most recent */
    })[0];
  };
  return [...byRef.entries()].map(([, xs]) => Object.assign({}, best(xs), {of: xs.length}));
}
function renderSatBoard(){
  const pins = satBoardPins();
  const latest = pins.slice().sort((a, b) => String(b.at || '').localeCompare(String(a.at || '')))[0];
  const drawn = allAssets().map(a => { const pt = aerialPointFor(a); const ll = pt && lonLatOf(pt.ax, pt.ay); return ll ? {key: a.key, name: a.name || a.item || '', lat: ll.lat, lon: ll.lon} : null; }).filter(Boolean);
  const keep = LIVEMAP.board && LIVEMAP.boardEl && document.body.contains(LIVEMAP.boardEl) && $('#pane-map').contains(LIVEMAP.boardEl);
  if (keep) {                       /* the map stays; only what is on it moves */
    satBoardData(pins, drawn);
    const c = $('#satcount'); if (c) c.innerHTML = satBoardCount(pins, latest);
    return;
  }
  const phone = window.matchMedia && window.matchMedia('(max-width:640px)').matches;
  $('#pane-map').innerHTML = paneHeadingHtml('map') + `
  <div class="card mapcard">
  <div class="maptools">
   <label class="sheetsel"><span class="vh">Sheet</span><select id="sheetSel" data-ro aria-label="Sheet">${DATA.sheets.map(s => `<option value="${s.key}">${esc(s.title)}</option>`).join('')}<option value="${SAT_BOARD}" selected>Satellite · pins</option></select></label>
   ${DATA.sheets.map(s => `<button class="btn sheetbtn" data-sheet="${s.key}">${esc(s.title)}</button>`).join('')}
   <button class="btn sheetbtn satbtn primary" data-sheet="${SAT_BOARD}">Satellite · pins</button>
   ${sat3dPossible() ? `<button class="btn sheetbtn satbtn" data-sheet="${SAT_3D}">Satellite · 3D</button>` : ''}
   ${DATA.edition === 'hosted' ? `<button class="btn sheetbtn satbtn" type="button" data-mopen="explorer">Plan on satellite</button><button class="btn sheetbtn satbtn" type="button" data-mopen="proof3d">3D proof</button>` : ''}
  </div>
  <p class="sub" id="satcount">${satBoardCount(pins, latest)}</p>
  <div class="satboard" id="satboard"><div class="livenote">Asking the service for the map key…</div></div>
  <p class="maphint" id="sathint"><b>The ground as it is, and where things were pinned.</b> Opens on the one question worth asking from across the whole site: where has somebody actually stood? Blue is a recorded pin — who pressed it, when, and how sure the phone was, in its popup. <b>Zoom in and the rest arrives as it becomes readable</b>: the names, then any plan position that disagrees with its pin by more than eight metres, joined to it by a dashed line, then the ring for the phone's accuracy. A plan position that the pin agrees with is not drawn — two dots on top of each other compare nothing, and the pin's popup gives the distance in words. Tap a pin for its reference. It updates as the record syncs; the photograph is Mapbox's, current-ish rather than this week's. Nothing here is written down — pins are taken in a reference's drawer.</p>
  </div>${pageBanner('map')}`;
  /* the same chooser as the sheets, wired the same way; leaving the board frees its WebGL context */
  $('#pane-map').querySelectorAll('[data-sheet]').forEach(b => b.onclick = () => {
    if (b.dataset.sheet !== SAT_BOARD) unmountSatBoard();
    if (b.dataset.sheet !== SAT_3D) unmountSat3D();
    state.sheet = b.dataset.sheet; state.zoom = 1; state.ox = 0; state.oy = 0; renderMap(); });
  const sel = $('#sheetSel'); if (sel) sel.onchange = () => { if (sel.value !== SAT_BOARD) unmountSatBoard(); if (sel.value !== SAT_3D) unmountSat3D(); state.sheet = sel.value; state.zoom = 1; state.ox = 0; state.oy = 0; renderMap(); };
  setHash('sheet/' + SAT_BOARD, {replace: location.hash === '#map'});
  mountSatBoard(pins, drawn);
}
function satBoardCount(pins, latest){
  /* the board shows one a reference; the count says so, and says how many were taken altogether, so the two
     numbers never have to be reconciled by somebody counting dots */
  const taken = pins.reduce((n, p) => n + (p.of || 1), 0);
  const more = taken - pins.length;
  return pins.length
    ? `<b>${pins.length}</b> reference${pins.length === 1 ? '' : 's'} pinned on the ground${more ? ` · ${taken} pins taken in all, one shown a reference — the rest are in each reference's drawer` : ''} · latest ${esc(latest.by || 'unnamed')}${latest.at ? ', ' + esc(fmtStamp(latest.at)) : ''} · updates as the record syncs`
    : 'No pins recorded yet — the first one taken in a reference\'s drawer shows here as soon as it syncs.';
}
/* v5.75 — THE RECORDED MARKS COME OFF THE MAPS. Andrew Fisher, 22 Sep 2026: the pins come off all the maps — too
   much — while pinning is still kept; it just does not show on any map.

   Three kinds of mark were being drawn on top of the drawing's own callouts: the blue pin somebody stood at
   (S.fixes), the green way in a truck turns off the street at (S.entries), and the dashed amber position put
   there from outside (S.places). Each was defensible on its own; together, on a sheet that already carries a
   callout for every reference, they are what he is describing.

   PINNING IS UNTOUCHED. The buttons still pin, the record still stores it, the drawer still says who stood
   where and when and how far off the drawing it came out, and every sheet, sheet email, drop sheet and driver
   card still says it IN WORDS. What has gone is the mark on the picture, nothing else.

   One switch. Setting this true puts all three back on every surface exactly as they were — nothing else in
   this file has to change, which is the point of it being one constant rather than a deletion. */
const SHOW_FIXES = false;
function satBoardGeo(pins, drawn){
  const feat = (lon, lat, props) => ({type: 'Feature', geometry: {type: 'Point', coordinates: [lon, lat]}, properties: props});
  /* v5.73 — ONE THING, ONE MARK. Andrew Fisher, 22 Sep 2026: the satellite pinning was a mess — overlapping and
     doubling up everything.

     He is right, and the doubling was structural. Every reference got a faint orange dot where the DRAWING
     puts it, all 193 of them, at every zoom — and a reference somebody had actually stood at ALSO got its blue
     pin, on top of its own orange dot, saying the same thing twice. Two marks, one thing, overlapping.

     The orange dot exists to compare plan against as-built, and that is worth keeping. But two dots on top of
     each other compare nothing: if the pin is where the drawing said, the drawing was right and there is
     nothing to look at. So the plan dot is drawn only where it still says something — where the pin came out
     more than PLAN_GAP_M from it — and then a hairline joins the two, so it reads as ONE fact, "this moved and
     here is how far", rather than as two dots to reconcile by eye. Everything else the pin's own popup
     already states in words, including the distance. */
  const PLAN_GAP_M = 8;
  const pinAt = new Map();
  pins.forEach(pn => { if (pn.lat != null) pinAt.set(pn.ref || pn.key, pn); });
  const moved = [];
  /* v5.75 — with the pins off the board, the plan dot is the only mark left, so there is nothing to thin it
     against and nothing to join it to: the doubling this filter existed to stop cannot happen. Dropping a dot
     now would leave a hole on the map for no reason a reader could see. */
  if (!SHOW_FIXES) return {
    moved: {type: 'FeatureCollection', features: []},
    pins: {type: 'FeatureCollection', features: []},
    rings: {type: 'FeatureCollection', features: []},
    puts: {type: 'FeatureCollection', features: []},
    ways: {type: 'FeatureCollection', features: []},
    drawn: {type: 'FeatureCollection', features: drawn.map(d => feat(d.lon, d.lat, {key: d.key, name: d.name}))},
  };
  drawn = drawn.filter(d => {
    const pn = pinAt.get(d.key);
    if (!pn) return true;                                     /* nobody has stood here: the plan is all there is */
    const m = haversineKm({lat: d.lat, lon: d.lon}, {lat: pn.lat, lon: pn.lon}) * 1000;
    if (m <= PLAN_GAP_M) return false;                         /* the drawing was right — nothing to compare */
    moved.push({type: 'Feature', geometry: {type: 'LineString', coordinates: [[d.lon, d.lat], [pn.lon, pn.lat]]},
                properties: {key: d.key, m: Math.round(m)}});
    return true;
  });
  return {
    moved: {type: 'FeatureCollection', features: moved},
    pins: {type: 'FeatureCollection', features: pins.map(p => feat(p.lon, p.lat, {key: p.key, ref: p.ref, unit: p.unit || '',
      /* the label under a collapsed pin is the REFERENCE, not the building inside it that happened to win */
      tail: (p.of || 1) > 1 ? p.ref : pinTag(p.key),
      of: p.of || 1,
      label: fixLabel(p.key), by: p.by || 'unnamed', at: p.at ? fmtStamp(p.at) : '', acc: fixQuality(p.acc).word, off: p.off}))},
    rings: {type: 'FeatureCollection', features: pins.filter(p => p.acc != null).map(p => ({type: 'Feature', geometry: {type: 'Polygon', coordinates: [circleAround(p.lat, p.lon, p.acc)]}, properties: {key: p.key}}))},
    drawn: {type: 'FeatureCollection', features: drawn.map(d => feat(d.lon, d.lat, {key: d.key, name: d.name}))},
    /* v5.54 — the ways in, on the board with everything else. A driver looking at the satellite picture wants
       the turn-in before the spot; a gate in a fence line reads as fence until somebody has stood at it. */
    /* v5.55 — positions put there from outside, hollow and amber, and only while nobody has stood at them */
    puts: {type: 'FeatureCollection', features: Object.entries(S.places || {})
      .filter(([k, pp]) => pp && pp.lat != null && !fixOf(k))
      .map(([k, pp]) => { const pk = fixParse(k);
        return feat(pp.lon, pp.lat, {key: k, ref: pk.ref, label: fixLabel(k), tail: pinTag(k),
                                     by: pp.by || 'unnamed', at: pp.at ? fmtStamp(pp.at) : '', how: placeWords(pp)}); })},
    ways: {type: 'FeatureCollection', features: Object.entries(S.entries || {})
      .filter(([r, e]) => e && e.lat != null)
      .map(([r, e]) => { const d = entryToDrop(r);
        return feat(e.lon, e.lat, {ref: r, by: e.by || 'unnamed', at: e.at ? fmtStamp(e.at) : '',
                                   acc: fixQuality(e.acc).word, away: d ? d.m + ' m from ' + d.basis : ''}); })},
  };
}
function satBoardData(pins, drawn){
  const map = LIVEMAP.board; if (!map || !map.isStyleLoaded || !map.getSource) return;
  const g = satBoardGeo(pins, drawn);
  try { ['pins', 'rings', 'drawn', 'moved', 'ways', 'puts'].forEach(n => { const src = map.getSource('sb-' + n); if (src) src.setData(g[n]); }); } catch (e) {}
}
async function mountSatBoard(pins, drawn){
  const el = $('#satboard'); if (!el) return;
  await liveMapKeyFromService();
  const key = liveMapKey();
  if (!key) {
    el.innerHTML = `<div class="livenote">${capability() === 'edit'
      ? '<b>Live map is not set up on this link yet.</b> Paste the Mapbox public token under About this file › Live map, or press Live in any reference\'s drawer.'
      : '<b>Live map is not set up on this link yet.</b> Somebody with the edit link pastes the Mapbox key once, under About this file › Live map.'}</div>`;
    return;
  }
  let gl;
  try { gl = await loadMapboxGl(); }
  catch (e) { el.innerHTML = '<div class="livenote warn"><b>The map library could not be fetched from api.mapbox.com.</b> No signal, or that address is blocked on this network. The drawing sheets are still here.</div>'; return; }
  if (!$('#satboard')) return;                              /* the person has moved on */
  el.innerHTML = '';
  if (LIVEMAP.board) { try { LIVEMAP.board.remove(); } catch (e) {} LIVEMAP.board = null; }
  gl.accessToken = key.token;
  const g = satBoardGeo(pins, drawn);
  const all = pins.map(p => [p.lon, p.lat]).concat(drawn.map(d => [d.lon, d.lat]));
  const b = all.length ? all.reduce((bb, c) => bb.extend(c), new gl.LngLatBounds(all[0], all[0])) : null;
  let map;
  try {
    /* v5.83 — FREE TO TURN. Andrew Fisher, 25 Sep 2026: every map can be spun round; this one had been locked. Drag with
       the right button (or Ctrl-drag) to turn and tilt, two fingers to twist on a phone; the compass sets north up. */
    map = new gl.Map({container: el, style: 'mapbox://styles/mapbox/satellite-streets-v12', attributionControl: true, cooperativeGestures: true,
                      dragRotate: true, pitchWithRotate: true, touchPitch: true,
                      center: b ? b.getCenter() : [153.42696, -27.98801], zoom: 15.2, bearing: sheetBearing()});
  } catch (e) { el.innerHTML = '<div class="livenote warn"><b>The map could not start on this device</b> (' + esc(String(e && e.message || e)) + ').</div>'; return; }
  LIVEMAP.board = map; LIVEMAP.boardEl = el;
  if (b) { try { map.fitBounds(b, {padding: 40, maxZoom: 17.5, duration: 0}); } catch (e) {} }
  map.addControl(new gl.NavigationControl({showCompass: true, visualizePitch: true}), 'top-right');
  map.addControl(new gl.ScaleControl({unit: 'metric', maxWidth: 140}), 'bottom-right');
  map.addControl(new gl.GeolocateControl({positionOptions: {enableHighAccuracy: true}, trackUserLocation: true, showUserHeading: true, fitBoundsOptions: {maxZoom: 18}}), 'top-right');
  let refused = false;
  map.on('error', ev => { const er = ev && ev.error, st = er && (er.status || (er.message && (er.message.match(/\b(401|403)\b/) || [])[1]));
    if (!refused && (st == 401 || st == 403)) { refused = true;
      const n = document.createElement('div'); n.className = 'livenote warn';
      n.innerHTML = '<b>Mapbox refused the key from this address</b> (' + st + '). In the Mapbox console the key\'s URL restriction has to include <span class="mono">' + esc(location.origin) + '</span>.'; el.appendChild(n); } });
  map.on('load', () => {
    if (LIVEMAP.board !== map) return;
    try {
      /* v5.73 — AND IT IS REVEALED BY ZOOM RATHER THAN ALL AT ONCE. At the whole-site view the board answers
         one question — where has somebody actually stood? — so it shows the pins and nothing else. Zoom in and
         the detail arrives as it becomes readable: the plan positions still worth comparing, then the labels,
         then the accuracy rings. A ten-metre circle drawn at the whole-site zoom is two pixels of blue haze
         over everything and tells nobody anything; the same circle at 17 is the thing you are looking at. */
      map.addSource('sb-moved', {type: 'geojson', data: g.moved});
      map.addLayer({id: 'sb-moved', type: 'line', source: 'sb-moved', minzoom: 15.5,
                    paint: {'line-color': '#ff6a13', 'line-width': 1.2, 'line-opacity': 0.75, 'line-dasharray': [2, 2]}});
      map.addSource('sb-drawn', {type: 'geojson', data: g.drawn});
      map.addLayer({id: 'sb-drawn', type: 'circle', source: 'sb-drawn', minzoom: SHOW_FIXES ? 15.5 : 0, paint: {'circle-radius': 4, 'circle-color': '#ff6a13', 'circle-opacity': 0.55, 'circle-stroke-color': '#fff', 'circle-stroke-width': 1, 'circle-stroke-opacity': 0.6}});
      map.addSource('sb-rings', {type: 'geojson', data: g.rings});
      map.addLayer({id: 'sb-rings-fill', type: 'fill', source: 'sb-rings', minzoom: 17, paint: {'fill-color': '#1d5fc4', 'fill-opacity': 0.16}});
      map.addLayer({id: 'sb-rings-line', type: 'line', source: 'sb-rings', minzoom: 17, paint: {'line-color': '#1d5fc4', 'line-width': 1.2}});
      map.addSource('sb-puts', {type: 'geojson', data: g.puts});
      map.addLayer({id: 'sb-puts', type: 'circle', source: 'sb-puts', paint: {'circle-radius': 7, 'circle-color': 'rgba(0,0,0,0)', 'circle-stroke-color': '#c98a1a', 'circle-stroke-width': 2.5}});
      map.addLayer({id: 'sb-puts-label', type: 'symbol', source: 'sb-puts', minzoom: 16.5, layout: {'text-field': ['get', 'tail'], 'text-size': 10, 'text-offset': [0, 1.25], 'text-anchor': 'top', 'text-font': ['DIN Pro Bold', 'Arial Unicode MS Bold'], 'text-allow-overlap': false, 'text-optional': true},
                    paint: {'text-color': '#fff', 'text-halo-color': '#c98a1a', 'text-halo-width': 1.4}});
      map.addSource('sb-ways', {type: 'geojson', data: g.ways});
      map.addLayer({id: 'sb-ways', type: 'circle', source: 'sb-ways', paint: {'circle-radius': 7, 'circle-color': '#0a8f5b', 'circle-stroke-color': '#fff', 'circle-stroke-width': 2}});
      map.addLayer({id: 'sb-ways-label', type: 'symbol', source: 'sb-ways', minzoom: 16.5, layout: {'text-field': ['get', 'ref'], 'text-size': 10, 'text-offset': [0, 1.25], 'text-anchor': 'top', 'text-font': ['DIN Pro Bold', 'Arial Unicode MS Bold'], 'text-allow-overlap': false, 'text-optional': true},
                    paint: {'text-color': '#fff', 'text-halo-color': '#0a8f5b', 'text-halo-width': 1.4}});
      map.addSource('sb-pins', {type: 'geojson', data: g.pins});
      map.addLayer({id: 'sb-pins', type: 'circle', source: 'sb-pins', paint: {'circle-radius': 7, 'circle-color': '#1d5fc4', 'circle-stroke-color': '#fff', 'circle-stroke-width': 2}});
      map.addLayer({id: 'sb-pins-label', type: 'symbol', source: 'sb-pins', minzoom: 16, layout: {'text-field': ['get', 'tail'], 'text-size': 11, 'text-offset': [0, 1.25], 'text-anchor': 'top', 'text-font': ['DIN Pro Bold', 'Arial Unicode MS Bold'], 'text-allow-overlap': false, 'text-optional': true},
                    paint: {'text-color': '#fff', 'text-halo-color': '#1d5fc4', 'text-halo-width': 1.4}});
      const pop = new gl.Popup({closeButton: false, offset: 12});
      map.on('click', 'sb-pins', ev => { const p = ev.features[0].properties;
        pop.setLngLat(ev.features[0].geometry.coordinates).setHTML(`<b>${esc(p.label)}</b><br>${esc(p.by)}${p.at ? ' · ' + esc(p.at) : ''}<br>${esc(p.acc)}${p.off != null && p.off !== '' ? ' · ' + esc(String(p.off)) + ' m from the drawing' : ''}${
          Number(p.of) > 1 ? `<br><span style="color:#666">${esc(String(p.of))} pins recorded on ${esc(p.ref)} — this is the one shown; all of them are in its drawer</span>` : ''
        }<br><button class="btn tiny" data-satopen="${esc(p.ref)}">Open ${esc(p.ref)}</button>`).addTo(map); });
      map.on('click', 'sb-puts', ev => { const p = ev.features[0].properties;
        pop.setLngLat(ev.features[0].geometry.coordinates).setHTML(`<b>${esc(p.label)}</b><br>${esc(p.how)}<br>${esc(p.by)}${p.at ? ' · ' + esc(p.at) : ''}<br><span style="color:#666">Nobody has stood at it yet.</span><br><button class="btn tiny" data-satopen="${esc(p.ref)}">Open ${esc(p.ref)}</button>`).addTo(map); });
      map.on('click', 'sb-ways', ev => { const p = ev.features[0].properties;
        pop.setLngLat(ev.features[0].geometry.coordinates).setHTML(`<b>Way in to ${esc(p.ref)}</b><br>pinned by ${esc(p.by)}${p.at ? ' · ' + esc(p.at) : ''}<br>${esc(p.acc)}${p.away ? ' · ' + esc(p.away) : ''}<br><button class="btn tiny" data-satopen="${esc(p.ref)}">Open ${esc(p.ref)}</button>`).addTo(map); });
      /* v5.76 — Andrew Fisher, 22 Sep 2026: an orange dot is clickable and takes you to its thing. They were
         clickable, but a press opened a bubble carrying a button that opened the reference — two presses for
         one intention, and on a phone the bubble lands under a thumb. Now the dot IS the way in: one press and
         the reference's drawer opens. The name is on the hover title instead, so nothing is lost on a desktop
         and nothing is in the way on a phone. */
      map.on('click', 'sb-drawn', ev => { const p = ev.features[0].properties;
        pop.remove(); openAsset(p.key); });
      ['sb-pins', 'sb-ways', 'sb-puts', 'sb-drawn'].forEach(l => { map.on('mouseenter', l, () => map.getCanvas().style.cursor = 'pointer'); map.on('mouseleave', l, () => map.getCanvas().style.cursor = ''); });
    } catch (e) {}
  });
  el.addEventListener('click', ev => { const b2 = ev.target.closest('[data-satopen]'); if (b2) { ev.preventDefault(); openAsset(b2.dataset.satopen); } });
}
function unmountSatBoard(){ if (LIVEMAP.board) { try { LIVEMAP.board.remove(); } catch (e) {} LIVEMAP.board = null; LIVEMAP.boardEl = null; } }
/* ------------------------------------------------------------------ v5.80 — THE SITE IN 3D
   Andrew Fisher, 24 Sep 2026: add a 3D satellite view using CesiumJS and Google Photorealistic 3D Tiles — and he
   has the Google APIs for it. So, on the hosted link, beside Satellite · pins:
   Satellite · 3D, the circuit and its buildings as Google photographs them, in three dimensions, flown to from
   above the start-finish straight. The tiles come from Google (tile.googleapis.com) with a browser key he
   pastes on the About tab — a key restricted in Google's console to this address, the same footing as the
   Mapbox one: it lives in the shared record with a name and a time, never in this file and never in an export.
   CesiumJS is fetched from cesium.com only when the board is opened. Nothing is drawn on the ground but the
   ring of the thing the search found (the pins are off every map, 22 Sep) — a searched asset lands here too.
   Google bills each opening of the board to Andrew's Google account, so it opens on a press and never by
   itself, and the board says so. */
const SAT_3D = '__satellite3d';
const CESIUM = {VERSION: '1.120', lib: null, loading: null, viewer: null, el: null, tileset: null, target: null};
const GOOGLE_KEY = /^AIza[0-9A-Za-z_-]{30,}$/;
/* v5.86 - the Google key the service holds (GOOGLE_MAPS_KEY on Railway, set by Andrew Fisher, 25 Sep 2026), read with
   the Mapbox one in the same answer from /api/map-key and used ahead of a key pasted on About */
let GMAPS_ENV;
function googleMapKey(){ if (GMAPS_ENV && GMAPS_ENV.key) return GMAPS_ENV; const k = (S.mapKeys || {}).google; return k && typeof k.key === 'string' && GOOGLE_KEY.test(k.key) ? k : null; }
function sat3dPossible(){ return liveMapPossible() && !!googleMapKey(); }
function setGoogleMapKey(key){
  if (!mayWrite('the 3D satellite key')) return false;
  const who = whoAmI(); if (!who) return false;
  key = String(key || '').trim();
  if (/BEGIN PRIVATE KEY|"private_key"|service_account/i.test(key)) { flash('That is a service-account secret, not a browser key. It must never go on a web page — nothing saved. Make an API key in Google Cloud, restrict it to this address and the Map Tiles API, and paste that.'); return false; }
  if (!GOOGLE_KEY.test(key)) { flash('That does not read as a Google API key — one starts AIza and runs about 39 characters. Copy it again from the Google Cloud console; nothing saved.'); return false; }
  S.mapKeys = S.mapKeys || {};
  S.mapKeys.google = {key, at: new Date().toISOString(), by: who, restrictedTo: location.origin};
  stampIt('mapKeys', 'google', who); bump(); unmountSat3D();
  flash('3D satellite key saved for everybody on this link — ' + who + ', ' + fmtWhen(S.mapKeys.google.at) + '. Map → Satellite · 3D opens it.');
  return true;
}
function clearGoogleMapKey(){
  if (!mayWrite('the 3D satellite key')) return false;
  const who = whoAmI(); if (!who) return false;
  if (!(S.mapKeys || {}).google) return false;
  delete S.mapKeys.google; stampIt('mapKeys', 'google', who); bump(); unmountSat3D();
  flash('3D satellite key taken off. The 3D board closes for everybody on this link.');
  return true;
}
/* CesiumJS, from cesium.com, once, and only when the board is opened. A page that already carries a Cesium
   (a test's stub, a later bundle) is used as it is. */
function loadCesium(){
  if (window.Cesium) { CESIUM.lib = window.Cesium; return Promise.resolve(CESIUM.lib); }
  if (CESIUM.loading) return CESIUM.loading;
  const base = 'https://cesium.com/downloads/cesiumjs/releases/' + CESIUM.VERSION + '/Build/Cesium/';
  window.CESIUM_BASE_URL = base;
  CESIUM.loading = new Promise((res, rej) => {
    const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = base + 'Widgets/widgets.css'; document.head.appendChild(css);
    const sc = document.createElement('script'); sc.src = base + 'Cesium.js'; sc.async = true;
    sc.onload = () => { if (window.Cesium) { CESIUM.lib = window.Cesium; res(CESIUM.lib); } else rej(new Error('Cesium did not appear')); };
    sc.onerror = () => rej(new Error('CesiumJS could not be fetched from cesium.com'));
    document.head.appendChild(sc);
  }).catch(e => { CESIUM.loading = null; throw e; });
  return CESIUM.loading;
}
/* where the board flies: the circuit's frame centre, or the thing the search found */
function sat3dTarget(){
  const f = state.found, a = f && f.key ? assetOf(f.key) : null;
  if (a) { const pt = aerialPointFor(a); const ll = pt && lonLatOf(pt.ax, pt.ay); if (ll) return {lat: ll.lat, lon: ll.lon, key: f.key, name: a.name || '', height: 260, pitch: -48}; }
  const c = lonLatOf(.5, .5); return c ? {lat: c.lat, lon: c.lon, key: null, name: '', height: 900, pitch: -38} : null;
}
function renderSat3D(){
  const k = googleMapKey(), tgt = sat3dTarget();
  /* THE BOARD STAYS UP ACROSS A RE-RENDER. The hosted page redraws the open tab whenever the record syncs (every
     few seconds when anyone on the link saves anything), and the pin board survives that by keeping its map and
     moving only what is on it. This board must too: a rebuild is a second Cesium viewer and a second opening of
     Google's tiles — billed again — and the view the person had lined up is thrown away. So while the viewer is
     mounted in this pane only the words and the ring are refreshed, and the camera moves only when the search
     result changed (tests/test_live_map.py holds one viewer across a re-render). */
  const keep = CESIUM.viewer && CESIUM.el && document.body.contains(CESIUM.el) && $('#pane-map').contains(CESIUM.el);
  if (keep) { sat3dRefresh(tgt); return; }
  $('#pane-map').innerHTML = paneHeadingHtml('map') + `
  <div class="card mapcard">
  <div class="maptools">
   <label class="sheetsel"><span class="vh">Sheet</span><select id="sheetSel" data-ro aria-label="Sheet">${DATA.sheets.map(s => `<option value="${s.key}">${esc(s.title)}</option>`).join('')}<option value="${SAT_BOARD}">Satellite · pins</option><option value="${SAT_3D}" selected>Satellite · 3D</option></select></label>
   ${DATA.sheets.map(s => `<button class="btn sheetbtn" data-sheet="${s.key}">${esc(s.title)}</button>`).join('')}
   <button class="btn sheetbtn satbtn" data-sheet="${SAT_BOARD}">Satellite · pins</button>
   <button class="btn sheetbtn satbtn primary" data-sheet="${SAT_3D}">Satellite · 3D</button>
   ${DATA.edition === 'hosted' ? `<button class="btn sheetbtn satbtn" type="button" data-mopen="explorer">Plan on satellite</button><button class="btn sheetbtn satbtn" type="button" data-mopen="proof3d">3D proof</button>` : ''}
  </div>
  <p class="sub" id="sat3dwords">${sat3dWords(tgt)}</p>
  <div class="satboard sat3d" id="sat3d"><div class="livenote">Opening the 3D view — Google's tiles and CesiumJS are fetched now, on this press…</div></div>
  <p class="maphint"><b>Google's photorealistic 3D tiles</b>, drawn by CesiumJS. Nothing is drawn on the ground but the ring of the thing the search found; the pins stay off every map. Each opening of this board is billed by Google to Andrew's account (one root-tileset request a session), which is why it opens only when pressed and never by itself. The key is a browser key restricted to this address, kept in the shared record and never in an export (About → 3D satellite). What leaves the page while it is open: tile requests to tile.googleapis.com carrying the key and this page's address, and the library from cesium.com.</p>
  </div>${pageBanner('map')}`;
  $('#pane-map').querySelectorAll('[data-sheet]').forEach(b => b.onclick = () => {
    if (b.dataset.sheet !== SAT_3D) unmountSat3D();
    state.sheet = b.dataset.sheet; state.zoom = 1; state.ox = 0; state.oy = 0; renderMap(); });
  const sel = $('#sheetSel'); if (sel) sel.onchange = () => { if (sel.value !== SAT_3D) unmountSat3D(); state.sheet = sel.value; state.zoom = 1; state.ox = 0; state.oy = 0; renderMap(); };
  setHash('sheet/' + SAT_3D, {replace: location.hash === '#map'});
  mountSat3D($('#sat3d'), k, tgt);
}
function sat3dWords(tgt){
  return (tgt && tgt.key ? 'Flying to <b>' + esc(tgt.key) + (tgt.name ? ' — ' + esc(tgt.name) : '') + '</b>, ringed where the drawing puts it.' : 'The circuit from above the start-finish straight, in three dimensions.') + ' Drag to look round, scroll to zoom, right-drag to tilt.';
}
/* the ring of what the search found, and the flight to it — drawn on a mounted viewer; the ring is redrawn from
   the record on every call, the camera moves only when the found thing changed */
function sat3dPlace(viewer, C, tgt, fly){
  viewer.entities.removeAll();
  if (tgt && tgt.key) {
    const orange = C.Color.fromCssColorString('#ff6a13');
    viewer.entities.add({position: C.Cartesian3.fromDegrees(tgt.lon, tgt.lat), name: tgt.key,
      ellipse: {semiMajorAxis: 9, semiMinorAxis: 9, material: orange.withAlpha(.16), outline: true, outlineColor: orange, outlineWidth: 4, classificationType: C.ClassificationType.CESIUM_3D_TILE},
      label: {text: tgt.key + (tgt.name ? ' · ' + tgt.name : ''), font: '700 15px system-ui, sans-serif', fillColor: C.Color.WHITE, outlineColor: C.Color.BLACK, outlineWidth: 4, style: C.LabelStyle.FILL_AND_OUTLINE,
              verticalOrigin: C.VerticalOrigin.BOTTOM, pixelOffset: new C.Cartesian2(0, -14), disableDepthTestDistance: Number.POSITIVE_INFINITY}});
  }
  if (fly && tgt) { const hb = sheetBearing(), hr = C.Math.toRadians(hb), d = (tgt.height / 6378137) * (180 / Math.PI) * 1.1;   /* v5.90 - the D001 way round */
    viewer.camera.flyTo({destination: C.Cartesian3.fromDegrees(tgt.lon - Math.sin(hr) * d / Math.cos(C.Math.toRadians(tgt.lat)), tgt.lat - Math.cos(hr) * d, tgt.height), orientation: {heading: hr, pitch: C.Math.toRadians(tgt.pitch), roll: 0}, duration: 0}); }
  CESIUM.target = tgt ? (tgt.key || '') : null;
  if (viewer.scene && viewer.scene.requestRender) viewer.scene.requestRender();
}
function sat3dRefresh(tgt){
  const w = $('#sat3dwords'); if (w) w.innerHTML = sat3dWords(tgt);
  const C = CESIUM.lib, viewer = CESIUM.viewer; if (!C || !viewer || !CESIUM.tileset) return;   /* still on its way: mountSat3D places it when the tiles land */
  const want = tgt ? (tgt.key || '') : null;
  sat3dPlace(viewer, C, tgt, want !== CESIUM.target);
}
async function mountSat3D(box, k, tgt){
  if (!box) return;
  if (!k) { liveMapNote(box, '<b>No 3D key on this link.</b> An editor pastes the Google browser key on About → 3D satellite.', 'warn'); return; }
  if (!tgt) { liveMapNote(box, '<b>No georeference in this build</b> — the drawings are not registered to the ground, so there is nowhere to fly.', 'warn'); return; }
  let C; try { C = await loadCesium(); } catch (e) { liveMapNote(box, '<b>The 3D library could not be fetched</b> — ' + esc(e.message) + '. The drawings and the satellite board are untouched.', 'warn'); return; }
  if (!document.body.contains(box)) return;
  try {
    unmountSat3D();
    box.querySelectorAll('.livenote').forEach(e => e.remove());
    const viewer = new C.Viewer(box, {baseLayer: false, imageryProvider: false, terrainProvider: undefined, baseLayerPicker: false, geocoder: false, homeButton: false, sceneModePicker: false,
      navigationHelpButton: false, animation: false, timeline: false, fullscreenButton: false, infoBox: false, selectionIndicator: false, requestRenderMode: true, maximumRenderTimeChange: Infinity, shouldAnimate: false});
    CESIUM.viewer = viewer; CESIUM.el = box;
    if (viewer.scene && viewer.scene.globe) viewer.scene.globe.show = false;
    if (viewer.scene && viewer.scene.skyAtmosphere) viewer.scene.skyAtmosphere.show = false;
    const url = 'https://tile.googleapis.com/v1/3dtiles/root.json?key=' + encodeURIComponent(k.key);
    const tileset = await C.Cesium3DTileset.fromUrl(url, {showCreditsOnScreen: true});
    if (CESIUM.viewer !== viewer) return;   /* the board was closed while the tiles were on their way */
    viewer.scene.primitives.add(tileset); CESIUM.tileset = tileset;
    /* the target may have moved on while the tiles were on their way (a search landed) — place what stands now */
    sat3dPlace(viewer, C, sat3dTarget() || tgt, true);
  } catch (e) {
    unmountSat3D();
    liveMapNote(box, '<b>The 3D view could not open</b> — ' + esc(String(e && e.message || e).slice(0, 160)) + '. If Google refused the key, check it is restricted to this address and the Map Tiles API is enabled on it.', 'warn');
  }
}
function unmountSat3D(){ if (CESIUM.viewer) { try { CESIUM.viewer.destroy(); } catch (e) {} CESIUM.viewer = null; CESIUM.tileset = null; CESIUM.el = null; CESIUM.target = null; } }
/* v5.81 — GOOGLE'S OWN 3D MAP, FLOWN ROUND THE SPOT. Maps JavaScript API, the maps3d library (Map3DElement, beta as
   of Sept 2026): the library is fetched on the press with the browser key, a <gmp-map-3d> is put in the box centred
   on the callout's ground position, and flyCameraAround takes one slow turn round it. Nothing is drawn on the
   ground. What leaves the page: the library request and the map's tile requests to Google, carrying the key and
   this page's address. A key without the Maps JavaScript API enabled is refused by Google, and the box says so. */
const GMAPS = {loading: null, ready: false};
function loadGoogleMaps3D(key){
  if (GMAPS.ready && window.google && google.maps && google.maps.importLibrary) return Promise.resolve();
  if (GMAPS.loading) return GMAPS.loading;
  GMAPS.loading = new Promise((ok, no) => {
    const sc = document.createElement('script');
    sc.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) + '&v=beta&libraries=maps3d&loading=async';
    sc.async = true;
    /* v5.89 - the loader defines importLibrary a moment after its own script has loaded; wait for it (up to 10 s) */
    sc.onload = () => { const t0 = Date.now(); (function poll(){ if (window.google && google.maps && typeof google.maps.importLibrary === 'function') { GMAPS.ready = true; ok(); }
      else if (Date.now() - t0 > 10000) { GMAPS.loading = null; no(new Error('the Maps JavaScript library loaded but importLibrary never appeared')); } else setTimeout(poll, 50); })(); };
    sc.onerror = () => { GMAPS.loading = null; no(new Error('the Maps JavaScript library could not be fetched')); };
    document.head.appendChild(sc);
  });
  return GMAPS.loading;
}
async function mountFlyAround(box, lat, lon, a, where){
  if (!box) return;
  const k = googleMapKey(); if (!k) { liveMapNote(box, '<b>No Google key on this link.</b> An editor pastes the browser key on About → 3D satellite.', 'warn'); return; }
  box.innerHTML = '<div class="livenote">Opening Google\'s 3D map — the library and its tiles are fetched now, on this press…</div>';
  try {
    await loadGoogleMaps3D(k.key);
    const lib = await google.maps.importLibrary('maps3d');
    if (!document.body.contains(box)) return;
    box.innerHTML = '';
    const wrap = document.createElement('div'); wrap.className = 'satboard satfly'; box.appendChild(wrap);
    const map = new lib.Map3DElement({center: {lat, lng: lon, altitude: 0}, range: 220, tilt: 62, heading: 20, mode: lib.MapMode ? lib.MapMode.HYBRID : 'HYBRID'});
    wrap.appendChild(map);
    const cap = document.createElement('p'); cap.className = 'satcap';
    cap.innerHTML = `<b>Google 3D · flying round ${esc(a.key)}</b> — one slow turn about ${esc(where || 'the callout\'s ground position')} (${esc(lat.toFixed(6))}, ${esc(lon.toFixed(6))}). Drag to look round; the turn stops when you do. Google's imagery, Google's map — a drawing registered to the ground, not a survey. <button type="button" class="btn ghost tiny" id="satFlyOff">Close</button>`;
    box.appendChild(cap);
    $('#satFlyOff').onclick = () => { box.innerHTML = ''; };
    const start = () => { try { map.flyCameraAround({camera: {center: {lat, lng: lon, altitude: 0}, tilt: 62, range: 220}, durationMillis: 36000, rounds: 1}); } catch (e) {} };
    if (map.addEventListener) map.addEventListener('gmp-steadychange', ev => { if (ev && ev.isSteady) start(); }, {once: true}); else setTimeout(start, 1500);
    map.addEventListener && map.addEventListener('gmp-error', ev => liveMapNote(box, '<b>Google refused the 3D map</b> — ' + esc(String((ev && ev.error && ev.error.message) || 'no reason given').slice(0, 160)) + '. Check the key is restricted to this address and the Maps JavaScript API is enabled on it.', 'warn'));
  } catch (e) {
    liveMapNote(box, '<b>The 3D map could not open</b> — ' + esc(String(e && e.message || e).slice(0, 160)) + '. The drawing and the satellite board are untouched.', 'warn');
  }
}
/* v5.83 — STREET VIEW YOU CAN TURN. Andrew Fisher, 25 Sep 2026: every map can be spun round, and the street
   photograph was a still. This is Google's own panorama in the page (Maps JavaScript API, streetView library): the
   nearest outdoor panorama within 120 m of the spot, turned to face it, and free to look round, move along the street
   and zoom. What leaves the page, on this press only: the library and the panorama requests to Google, carrying the
   key and this page's address. Where Google has no panorama that close it says so, and offers Google Maps outside
   this page instead. */
function svHeading(fromLat, fromLon, toLat, toLon){
  const r = Math.PI / 180, y = Math.sin((toLon - fromLon) * r) * Math.cos(toLat * r),
        x = Math.cos(fromLat * r) * Math.sin(toLat * r) - Math.sin(fromLat * r) * Math.cos(toLat * r) * Math.cos((toLon - fromLon) * r);
  return ((Math.atan2(y, x) / r) + 360) % 360;
}
function svMetres(aLat, aLon, bLat, bLon){
  const r = Math.PI / 180, dLat = (bLat - aLat) * r, dLon = (bLon - aLon) * r,
        h = Math.sin(dLat / 2) ** 2 + Math.cos(aLat * r) * Math.cos(bLat * r) * Math.sin(dLon / 2) ** 2;
  return 2 * 6371008.8 * Math.asin(Math.min(1, Math.sqrt(h)));
}
function gmapsOutside(lat, lon, pano){
  return pano ? 'https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=' + lat.toFixed(6) + ',' + lon.toFixed(6)
              : 'https://www.google.com/maps/search/?api=1&query=' + lat.toFixed(6) + ',' + lon.toFixed(6);
}
async function mountStreetView(box, lat, lon, a, where){
  if (!box) return;
  const k = googleMapKey();
  const outside = `<a class="btn ghost tiny" href="${esc(gmapsOutside(lat, lon, true))}" target="_blank" rel="noopener">Street View in Google Maps ↗</a>`;
  if (!k) { liveMapNote(box, '<b>No Google key on this link.</b> An editor pastes the browser key on About → 3D satellite. ' + outside, 'warn'); return; }
  box.innerHTML = '<div class="livenote">Finding the nearest Street View to the spot — the library and the panorama are fetched now, on this press…</div>';
  try {
    await loadGoogleMaps3D(k.key);
    const lib = await google.maps.importLibrary('streetView');
    if (!document.body.contains(box)) return;
    const svc = new lib.StreetViewService();
    const req = {location: {lat, lng: lon}, radius: 120};
    if (lib.StreetViewSource && lib.StreetViewSource.OUTDOOR) req.sources = [lib.StreetViewSource.OUTDOOR];
    if (lib.StreetViewPreference && lib.StreetViewPreference.NEAREST) req.preference = lib.StreetViewPreference.NEAREST;
    let found = null;
    try { found = (await svc.getPanorama(req)).data; } catch (e) { found = null; }
    if (!document.body.contains(box)) return;
    if (!found || !found.location || !found.location.latLng) {
      box.innerHTML = '';
      liveMapNote(box, '<b>Google has no Street View within 120 m of the spot.</b> ' + outside, 'warn'); return; }
    const pl = found.location.latLng, plat = pl.lat(), plon = pl.lng();
    const heading = svHeading(plat, plon, lat, lon), dist = svMetres(plat, plon, lat, lon);
    box.innerHTML = '';
    const wrap = document.createElement('div'); wrap.className = 'satboard svpano'; box.appendChild(wrap);
    new lib.StreetViewPanorama(wrap, {pano: found.location.pano, pov: {heading, pitch: 0}, zoom: 0, addressControl: true,
      fullscreenControl: true, motionTracking: false, motionTrackingControl: false, linksControl: true, panControl: true, enableCloseButton: false});
    const cap = document.createElement('p'); cap.className = 'satcap';
    cap.innerHTML = `<b>Street View · facing ${esc(a.key)}</b> — Google's nearest outdoor panorama, ${esc(String(Math.round(dist)))} m from ${esc(where || 'the callout\'s ground position')}${found.imageDate ? ', photographed ' + esc(String(found.imageDate)) : ''}, turned to face it. Drag to look round, the arrows to move along the street. The street, not the thing itself. ${outside}`;
    box.appendChild(cap);
  } catch (e) {
    box.innerHTML = '';
    liveMapNote(box, '<b>Street View could not open</b> — ' + esc(String(e && e.message || e).slice(0, 160)) + '. The key needs the Maps JavaScript API enabled and this address allowed. ' + outside, 'warn');
  }
}
/* v5.83 — the plain map of the spot: Mapbox's satellite with street names, the spot marked in the colour of what
   it is (blue a pin somebody stood at, hollow white a position somebody placed, orange the drawing's area), free to
   turn, tilt and zoom. The key is the service's MAPBOX_TOKEN or the one pasted on this link, never in this file. */
async function mountFoundMap(box, lat, lon, a, t){
  if (!box) return;
  const outside = `<a class="btn ghost tiny" href="${esc(gmapsOutside(lat, lon, false))}" target="_blank" rel="noopener">Google Maps ↗</a>`;
  box.innerHTML = '<div class="livenote">Opening the map of the spot — fetched now, on this press…</div>';
  const key = liveMapKey() || await liveMapKeyFromService();
  if (!document.body.contains(box)) return;
  if (!key) { box.innerHTML = ''; liveMapNote(box, '<b>No Mapbox key on this link</b> (the Railway variable MAPBOX_TOKEN, or one pasted under About → Live map). ' + outside, 'warn'); return; }
  let gl; try { gl = await loadMapboxGl(); } catch (e) { box.innerHTML = ''; liveMapNote(box, '<b>The map library could not be fetched from api.mapbox.com.</b> ' + outside, 'warn'); return; }
  if (!document.body.contains(box)) return;
  box.innerHTML = '';
  const el = document.createElement('div'); el.className = 'satboard fvmap'; box.appendChild(el);
  gl.accessToken = key.token;
  let map;
  try {
    map = new gl.Map({container: el, style: 'mapbox://styles/mapbox/satellite-streets-v12', center: [lon, lat], zoom: 18, bearing: sheetBearing(),
                      attributionControl: true, cooperativeGestures: true, dragRotate: true, pitchWithRotate: true, touchPitch: true});
  } catch (e) { liveMapNote(box, '<b>The map could not start on this device</b> (' + esc(String(e && e.message || e)) + '). ' + outside, 'warn'); return; }
  map.addControl(new gl.NavigationControl({showCompass: true, visualizePitch: true}), 'top-right');
  map.addControl(new gl.ScaleControl({unit: 'metric', maxWidth: 120}), 'bottom-right');
  const colour = t && t.pinned ? '#2f7de1' : t && t.placed ? '#ffffff' : '#e8641b';
  /* v5.86 - the spot glows: a dot in the pin's colour with a ring breathing out from it */
  const mkEl = document.createElement('div'); mkEl.className = 'fvmk'; mkEl.style.setProperty('--mkc', colour);
  mkEl.innerHTML = '<i class="fvpulse" aria-hidden="true"></i><b></b>';
  new gl.Marker({element: mkEl, anchor: 'center'}).setLngLat([lon, lat]).addTo(map);
  const cap = document.createElement('p'); cap.className = 'satcap';
  cap.innerHTML = `<b>Map · ${esc(a.key)}</b> — Mapbox satellite with street names, the spot marked. Two fingers to turn and tilt, the compass for north. © Mapbox © OpenStreetMap. ${outside}`;
  box.appendChild(cap);
}
/* v5.83 — WHERE IT IS, IN THREE VIEWS. Andrew Fisher, 25 Sep 2026: a search should come up with where the thing is —
   where it is pinned, in 3D satellite and Street View, and the plain map where there is one. The ringed drawing
   stays below; above it, one view at a time (three live maps at once is too much for a phone), 3D first. The spot
   is the one Navigate uses: the newest pin somebody stood at, else a position somebody placed, else the drawing's
   area — and the card says which. Views are billed per opening, so each opens on its own press, and the search is
   the press for the first. On a copy opened from storage there is no address for Google or Mapbox to trust, so it
   offers Google Maps outside the page instead. */
const FV = {at: null, tab: null, node: null};
function spotOf(a){
  if (!a) return null;
  const t = navTargetFor(a); if (!t || !t.ll) return null;
  const words = t.pinned ? 'the pin ' + ((t.fix && t.fix.by) || 'somebody') + ' took standing at it' + (t.fix && t.fix.at ? ' (' + fmtStamp(t.fix.at) + ')' : '')
              : t.placed ? 'the position ' + ((t.place && t.place.by) || 'somebody') + ' placed for it — nobody has stood at it yet'
              : 'the drawing\'s area for it — a callout registered to the ground, not a survey';
  return {a, t, lat: t.ll.lat, lon: t.ll.lon, words};
}
function foundViewTarget(){ const f = state.found; return f && f.key ? spotOf(assetOf(f.key)) : null; }
function foundViewsHtml(){
  const f = state.found, a = f && f.key ? assetOf(f.key) : null; if (!a) return '';
  const v = spotOf(a);
  const opts = foundViewOptions(a, v); if (!opts.length) return '';
  const tab = opts.some(o => o.k === state.fview && o.on) ? state.fview : (opts.find(o => o.on) || {}).k;
  const b = o => `<button type="button" role="tab" data-fv="${o.k}" aria-selected="${tab === o.k}"${o.on ? '' : ' disabled title="' + esc(o.why || '') + '"'}>${esc(o.label)}${o.n ? ' <small>' + o.n + '</small>' : ''}</button>`;
  const nav = v && v.t && v.t.pinned ? navBtn(a, {small: true, quiet: true}) : '';
  const outside = v && !liveMapPossible() ? `<p class="norate fvnote">The satellite, 3D satellite and Street View of it open on the hosted link — on this copy, <a href="${esc(gmapsOutside(v.lat, v.lon, false))}" target="_blank" rel="noopener">Google Maps ↗</a> (${esc(v.lat.toFixed(6))}, ${esc(v.lon.toFixed(6))}).</p>` : '';
  return `<div class="card fviews" id="fviews">
    <div class="fvhead"><span class="fvwords"><b>Where it is · ${esc(a.key)}</b> <small>${v ? esc(v.words) : 'no position on the ground yet — the drawing\'s callout and the pictures are what there is'}</small></span>
      ${nav ? `<span class="fvnav">${nav}</span>` : ''}
      <div class="fvtabs" role="tablist" aria-label="View">${opts.map(b).join('')}</div></div>
    <div class="fvbox" id="fvbox" role="tabpanel"></div>${outside}</div>`;
}
/* v5.86 - WHAT A SEARCH CAN SHOW, only where each exists (Andrew Fisher, 25 Sep 2026): the photographs of the drop and
   of the product, the aerial photograph centred on the callout, Mapbox's satellite, Google's 3D satellite and Street
   View, and Navigate when somebody has pinned the spot - with the spot glowing in every view. A view that needs a key
   the page does not have is shown greyed and says what it needs; a view with nothing behind it is not shown at all. */
function foundViewOptions(a, v){
  const out = [];
  const pics = foundPictures(a);
  if (pics.length) out.push({k: 'pics', label: 'Pictures', n: pics.length, on: true});
  if (DATA.aerial_hi && aerialPointFor(a)) out.push({k: 'aerial', label: 'Aerial', on: true});
  if (v && liveMapPossible()) {
    const g = !!googleMapKey(), why = 'needs the Google key — GOOGLE_MAPS_KEY on the service, or About → 3D satellite';
    out.push({k: 'map', label: 'Satellite', on: true});
    out.push({k: '3d', label: '3D satellite', on: g, why});
    out.push({k: 'sv', label: 'Street View', on: g, why});
  }
  return out;
}
function foundPictures(a){
  const out = [];
  if (SYNC.backend && SYNC.backend.fileUrl) dropPhotosOf(a.key).forEach(shot => {
    const sr = photoFor(shot);
    if (sr && sr.state === 'ready' && sr.url) out.push({kind: 'drop', url: sr.url, open: SYNC.backend.fileUrl(shot.id), says: dropPhotoSays(a.key, shot)});
    else if (sr && sr.state !== 'none') out.push({kind: 'drop', pending: sr, shot, says: dropPhotoSays(a.key, shot)});   /* on the record, library still being read - said, never hidden */
  });
  const ph = productPhoto(a);
  if (ph && ph.src) out.push({kind: ph.kind === 'made' ? 'made' : 'ref', url: ph.src, open: null, says: ph.says || ''});
  return out;
}
function mountFoundPics(box, a){
  const pics = foundPictures(a), drops = pics.filter(p => p.kind === 'drop').length;
  box.innerHTML = `<div class="fvpics">${pics.map(p => `<figure class="fvpic">${p.pending ? photoBlock(p.pending, p.shot, a.key) : `${p.open ? `<a href="${esc(p.open)}" target="_blank" rel="noopener">` : ''}<img src="${esc(p.url)}" alt="${esc(p.says)}" loading="lazy" decoding="async">${p.open ? '</a>' : ''}`}
      <figcaption><span class="eqpl${p.kind === 'drop' ? ' live' : p.kind === 'made' ? ' made' : ''}">${p.kind === 'drop' ? 'On site' : p.kind === 'made' ? 'Illustration' : 'Reference photo'}</span> ${esc(p.says)}</figcaption></figure>`).join('')}</div>
    <p class="satcap">${drops ? drops + ' photograph' + (drops === 1 ? '' : 's') + ' of this drop on the record' : 'No photograph of this drop on the record yet'}${pics.some(p => p.kind !== 'drop') ? ' · the product picture is the product, not this unit' : ''}. A photograph of the drop opens full size in a new tab.</p>`;
}
function mountFoundAerial(box, a){
  const pt = aerialPointFor(a); if (!pt || !DATA.aerial_hi) { box.innerHTML = ''; return; }
  const z = satZoom();
  box.innerHTML = `<div class="satbox fvaer"><img src="${DATA.aerial_hi}" alt="Aerial photograph centred on callout ${esc(pt.label)}" loading="lazy" decoding="async"><i class="fvpulse" aria-hidden="true"></i></div>
    <p class="satcap"><b>Aerial · ${esc(a.key)}</b> — the Queensland aerial photograph centred on callout ${esc(pt.label)}${pt.sheet && pt.sheet.sheet_id ? ' on ' + esc(pt.sheet.sheet_id) : ''}: the drawing registered to the photograph, a callout's place and not a survey. ${esc(z.label)} view.</p>`;
  const bx = box.querySelector('.fvaer'), im = bx.querySelector('img');
  placeCrop(bx, im, pt, z.f);
}
function wireFoundViews(){
  const card = $('#fviews'), box = $('#fvbox'); if (!card || !box) return;
  const f = state.found, a = f && f.key ? assetOf(f.key) : null; if (!a) return;
  const v = spotOf(a), opts = foundViewOptions(a, v);
  const tab = opts.some(o => o.k === state.fview && o.on) ? state.fview : (opts.find(o => o.on) || {}).k; if (!tab) return;
  const mount = k => {
    state.fview = k;
    card.querySelectorAll('[data-fv]').forEach(b => b.setAttribute('aria-selected', String(b.dataset.fv === k)));
    box.innerHTML = '';
    if (k === 'pics') mountFoundPics(box, a);
    else if (k === 'aerial') mountFoundAerial(box, a);
    else if (k === '3d') mountFlyAround(box, v.lat, v.lon, v.a, v.words);
    else if (k === 'sv') mountStreetView(box, v.lat, v.lon, v.a, v.words);
    else mountFoundMap(box, v.lat, v.lon, v.a, v.t);
    FV.at = state.found.at; FV.tab = k; FV.node = box;
  };
  card.querySelectorAll('[data-fv]').forEach(b => { if (!b.disabled) b.onclick = () => mount(b.dataset.fv); });
  /* the same search and the same view: put the open one back rather than open (and bill) it again - the maps only;
     the pictures and the aerial cost nothing and are drawn fresh, so a photograph that has just been read appears */
  if (tab !== 'pics' && tab !== 'aerial' && FV.at === state.found.at && FV.tab === tab && FV.node && FV.node !== box && FV.node.childNodes.length) {
    box.replaceWith(FV.node); FV.node.id = 'fvbox'; return; }
  mount(tab);
}
/* v5.79 — THE RING. What the search found, circled on the sheet it is drawn on: the ring stands at the marker's
   own place, behind the pill, until the next search or the × on the strip. On another sheet nothing is drawn,
   but the strip still says where the thing is and takes you back to it. */
function foundRing(sh){
  const f = state.found; if (!f || f.sheet !== sh.key || f.fx == null) return '';
  return `<i class="mkfound" id="mkfound" style="left:${(f.fx * 100).toFixed(3)}%;top:${(f.fy * 100).toFixed(3)}%" aria-hidden="true"></i>`;
}
function sizeFoundRing(){
  const f = state.found, ring = $('#mkfound'); if (!f || !ring) return;
  const mk = foundMarkerEl(f); if (!mk) return;
  /* round the pill with room to spare, whatever its width — a label like "GN01+1" is wider than "P33" */
  const d = Math.max(64, Math.round(Math.hypot(mk.offsetWidth * 1.22, mk.offsetHeight * 1.22) + 22));
  ring.style.width = ring.style.height = d + 'px';
}
/* the pill the ring belongs to: by the unit it stands for, else by the reference it links, else by the label */
function foundMarkerEl(f){
  const mks = [...document.querySelectorAll('#pane-map .mk:not(.gpsmk)')];
  return (f.unit && mks.find(m => m.dataset.unit && m.dataset.unit === f.unit))
      || (f.key && mks.find(m => (m.dataset.keys || '').split(',').includes(f.key)))
      || mks.find(m => calloutKey(m.dataset.label) === calloutKey(f.label)) || null;
}
function foundBar(sh){
  const f = state.found; if (!f) return '';
  const a = f.key ? assetOf(f.key) : null, here = f.sheet === sh.key;
  const fsh = DATA.sheets.find(x => x.key === f.sheet) || {};
  const what = f.unit ? esc(f.unit) + (f.key ? ' <small>inside ' + esc(f.key) + '</small>' : '')
             : f.key ? esc(f.key) + (a && a.name ? ' — ' + esc(a.name) : '')
             : 'Callout ' + esc(f.label);
  const nums = a ? assetNumbersOf(a) : [];
  const where = 'callout ' + esc(f.label) + ' on ' + esc(fsh.sheet_id || f.sheet) + (fsh.title ? ' · ' + esc(fsh.title) : '');
  return `<div class="foundbar" role="status" aria-live="polite"><i class="fring" aria-hidden="true"></i>
    <span class="fwords"><b>${what}</b>${nums.length ? ' · <span>asset no. ' + nums.map(esc).join(', ') + '</span>' : ''}
      <small>${here ? 'Ringed at ' + where + '. The ring stays until you search again.' : 'Ringed at ' + where + ' — not this sheet.'}</small></span>
    ${here ? '' : `<button type="button" class="btn" data-sheet-go-found="${esc(f.sheet)}">Show it</button>`}
    ${f.key ? `<button type="button" class="btn" data-found-open="${esc(f.key)}">Open the record</button>` : ''}
    <button type="button" class="fx" data-found-off aria-label="Take the ring off" title="Take the ring off">&times;</button></div>`;
}
/* v5.83 — which way north is on a drawing sheet, clockwise from its top, when the page knows it: the circuit sheets
   share one frame, registered to the ground (DATA.orientation); a sheet with its own frame (D007, D016) does not
   say, and its North-up button stays off rather than guess. */
function mapNorthDeg(sh){
  const o = DATA.orientation || {};
  if (!sh || sh.circuit_frame === false || typeof o.north_deg_clockwise_from_sheet_top !== 'number') return null;
  return o.north_deg_clockwise_from_sheet_top;
}
function renderMap(){
  /* v5.52 — THE SATELLITE PIN BOARD, on the hosted link only. Andrew Fisher, 18 Sep 2026: a new, blank satellite
     image that becomes an updated pinned image as the job goes. Mapbox's
     satellite, no drawing on it, every recorded pin on it, and it updates as the record syncs. */
  if (state.sheet === SAT_BOARD && liveMapPossible()) { renderSatBoard(); return; }
  if (state.sheet === SAT_3D && sat3dPossible()) { renderSat3D(); return; }
  if (state.sheet === SAT_BOARD || state.sheet === SAT_3D) state.sheet = null;
  const sh = DATA.sheets.find(s => s.key === state.sheet) || DATA.sheets[0];
  /* v5.83 — a turn belongs to the sheet it was made on: another sheet opens as printed */
  if (state.rotSheet !== sh.key) { state.rot = 0; state.rotSheet = sh.key; }
  const q = state.q.trim().toLowerCase();
  const hits = new Set(allAssets().filter(a => q && matches(a, q))
    .flatMap(a => (a.drawing_links||[]).filter(l => l.sheet === sh.sheet_id).map(l => l.label)));
  /* D024 numbers gensets, big screens, keyed towers and circuit towers from 001/01 alike, so a marker is matched
     to an asset by the drawing's tag (genset:001, tower:05, lighting:05) whenever both sides carry one, and by
     the bare label only when one side does not. */
  const byLabel = new Map(), byTag = new Map();
  allAssets().forEach(a => (a.drawing_links||[]).forEach(l => {
    if (l.sheet !== sh.sheet_id) return;
    if (l.tag_id) { if (!byTag.has(l.tag_id)) byTag.set(l.tag_id, []); byTag.get(l.tag_id).push(a.key); }
    else { if (!byLabel.has(l.label)) byLabel.set(l.label, []); byLabel.get(l.label).push(a.key); }
  }));
  /* A callout resolves by the drawing's own tag, then by its label, and — where neither finds anything —
     by what a person has recorded as standing there. That last one is what makes D025 work at all: its
     twenty-seven VMS callouts match no schedule row, because the schedule has a single row of eight for the
     lot of them and gives it no position. */
  const linkedTo = m => (m.tag ? byTag.get(m.tag) : null) || byLabel.get(m.label) || null;
  const unitOn = m => unitAt(sh.sheet_id, m.label);

  const onSheet = allAssets().filter(a => (a.drawing_links||[]).some(l => l.sheet === sh.sheet_id));
  const mks = sh.markers.map((m, i) => {
    const unit = unitOn(m);
    const linked = linkedTo(m) || (unit ? [unit.ref] : null);
    const cls = ['mk'];
    if (m.marker_kind === 'note') cls.push('note');
    if (q) cls.push(hits.has(m.label) ? 'hit' : 'dim');
    if (state.sel && linked && linked.includes(state.sel)) cls.push('sel');
    /* The light on the pill's shoulder. Several assets on one callout show the furthest-along of them, and the
       title spells each one out. The filter bar fades the pills whose light is not the one asked for. */
    let light = null;
    if (linked && linked.length) {
      const ds = linked.map(k => deliveryOf(k));
      const best = ds.find(d => d.c === 'green') || ds.find(d => d.c === 'amber') || ds[0];
      light = best.recorded ? best.c : 'none';
      if (state.light && !linked.some(k => lightMatches({key:k}))) cls.push('off');
      /* iEDM draw the generators and the light towers on one sheet (D024 "GENS & LTS"). Andrew Fisher asked on
         11 Sep 2026 for the two to be kept apart, and they are: separate in the register, separate in every
         count, and separable here — the sheet stays as iEDM issued it and the filter fades the other trade. */
      if (state.mapDisc && !linked.some(k => (assetOf(k) || {}).discipline === state.mapDisc)) cls.push('off');
    } else if ((state.light || state.mapDisc) && m.marker_kind !== 'note') cls.push('off');
    /* F01: a marker's title used to read "T0024: red (no record)" — a colour beside a denial of the colour. */
    const lightWords = linked ? linked.map(k => `${k}: ${deliveryView(k).short.toLowerCase()}`).join('; ') : '';
    const bdOpen = linked ? linked.flatMap(k => breakdownsFor(k)).filter(b => b.open) : [];
    const bdWords = bdOpen.length ? ` — ${bdOpen.length} open breakdown${bdOpen.length > 1 ? 's' : ''}: ${bdOpen.map(b => b.what).join('; ')}` : '';
    const doneKeys = linked ? linked.filter(k => deliveryOf(k).done) : [];
    const doneWords = doneKeys.length ? ` — complete: ${doneKeys.join(', ')}` : '';
    const lvlKeys = linked ? linked.filter(k => deliveryOf(k).levelled) : [];
    const lvlWords = lvlKeys.length ? ` — positioned and levelled: ${lvlKeys.join(', ')}` : '';
    const stpKeys = linked ? linked.filter(k => deliveryOf(k).steps) : [];
    const stpWords = stpKeys.length ? ` — steps installed: ${stpKeys.join(', ')}` : '';
    /* a cancelled reference keeps its marker — the drawing still puts it there — and wears the ring-and-bar on
       its shoulder so nobody drives to it */
    const offKeys = linked ? linked.filter(k => (assetOf(k) || {})._cancelled) : [];
    const offWords = offKeys.length ? ` — CANCELLED: ${offKeys.map(k => k + ' (' + rowOffWords(k) + ')').join('; ')}` : '';
    /* Andrew Fisher, 12 Sep 2026: pressing WC05 on the map should say what it is — Event Operations Compound Toilet - Combo
       Block (Tanked). The code is what the marker wears; what the thing IS belongs in the words that come with
       it, so nobody has to hold the register in their head to know what WC05 is. */
    const named = linked ? linked.map(k => { const a = assetOf(k); return a && a.name ? k + ' — ' + a.name : k; }).join(' · ') : '';
    /* A marker whose destination somebody has typed over is drawn as needing checking, not as a place to go.
       The pill still sits on the callout, because that is where the drawing puts it — what has changed is that
       it is no longer the answer to "where does this go". */
    const movedKeys = linked ? linked.filter(k => movedFor(assetOf(k) || {})) : [];
    const movedWord = movedKeys.length ? ' — LOCATION CHANGED, pin needs checking: '
      + movedKeys.map(k => k + ' → ' + (movedFor(assetOf(k)) || {}).to).join('; ') : '';
    const t = unit ? unitWords(unit) + doneWords + lvlWords + stpWords + bdWords + movedWord + offWords
            : linked ? named + ' · callout ' + m.label + ' · ' + lightWords + doneWords + lvlWords + stpWords + bdWords + movedWord + offWords
            : (m.label || '');
    /* The visible text is a three-character truncation and note markers show nothing at all, so without an
       explicit label these are buttons with no accessible name. */
    const name = unit ? unitWords(unit)
               : (linked ? linked.map(k => { const a = assetOf(k); return a && a.name ? k + ', ' + a.name : k; }).join('; ') + ' — callout ' + m.label
                         : 'callout ' + (m.label || 'unlabelled') + ', no schedule row linked');
    /* The face of the marker is the GC500 ID — P01, GN01, WB02 — because that is what everybody on site calls
       the thing and what they search for. The drawing's own callout number (001) stays in the title and the
       accessible name. Unlinked callouts fall back to their number. Two assets on one callout show the first
       and a count. */
    const face = m.marker_kind === 'note' ? ''
               : unit && unit.label ? esc(String(unit.label).slice(0, 5))
               : linked && linked.length > 1 ? esc(linked[0]) + '+' + (linked.length - 1)
               : linked ? esc(linked[0])
               : esc(String(m.label||'').slice(0,4));
    if (movedKeys.length) cls.push('movedloc');
    if (offKeys.length && offKeys.length === (linked || []).length) cls.push('cancelled');
    if (linked && linked.length) cls.push('id'); else if (m.marker_kind !== 'note') cls.push('co');
    return `<button class="${cls.join(' ')}" style="left:${(m.fx*100).toFixed(3)}%;top:${(m.fy*100).toFixed(3)}%"
      data-label="${esc(m.label)}" data-keys="${esc((linked||[]).join(','))}"${unit ? ` data-unit="${esc(unit.label || '')}"` : ''} title="${esc(t)}"${light ? ` data-lt="${light}"` : ''}${
      doneKeys.length && doneKeys.length === linked.length ? ' data-complete="1"' : ''}${
      lvlKeys.length && lvlKeys.length === linked.length ? ' data-levelled="1"' : ''}${
      stpKeys.length && stpKeys.length === linked.length ? ' data-steps="1"' : ''}
      aria-label="${esc(name + (lightWords ? ' — ' + lightWords : '') + doneWords + lvlWords + stpWords + bdWords + movedWord + offWords)}">${face}${bdOpen.length ? `<i class="bdx" title="${esc(bdWords.slice(3))}">!</i>` : ''}${
      doneKeys.length && doneKeys.length === linked.length ? '<i class="okx" title="complete">✓</i>' : ''}${
      stpKeys.length && stpKeys.length === linked.length ? '<i class="stpx" title="steps installed"></i>' : ''}${
      offKeys.length ? `<i class="nox" title="cancelled">${noGlyph(12)}</i>` : ''}</button>`;
  }).join('');

  /* v5.49 — and the positions people RECORDED standing at the thing, on the same sheet, in their own mark so
     nobody mistakes one for the other. The callout is where the drawing puts it; this is where it went. */
  const pins = !SHOW_FIXES ? '' : Object.entries(S.fixes || {}).map(([k, f]) => {
    if (!f || f.ax == null) return '';
    const pk = fixParse(k);            /* v5.51 — a pin on one building inside the reference sits on the same sheet */
    /* v5.53 — a pin on a reference with no callout on any sheet (a plant line given a reference and pinned where
       it stands) still shows, on every sheet that is the circuit's own frame: the pin is a position on the
       ground and the sheet is a picture of the ground */
    if (!onSheet.some(a => a.key === pk.ref) && !(sh.circuit_frame !== false && isRef(pk.ref) && !mapSheetFor(assetOf(pk.ref)))) return '';
    const sp = sheetPointOf(sh, f.ax, f.ay); if (!sp) return '';
    const q = fixQuality(f.acc), lab = fixLabel(k);
    return `<button class="mk gpsmk${pk.unit ? ' unit' : ''}" style="left:${(sp.fx * 100).toFixed(3)}%;top:${(sp.fy * 100).toFixed(3)}%"
      data-keys="${esc(pk.ref)}" data-label="${esc(lab)}"
      title="${esc(lab + ' — recorded on site by ' + (f.by || 'unnamed') + (f.at ? ' at ' + fmtStamp(f.at) : '') + ' · ' + q.word
        + (f.off != null ? ' · ' + f.off + ' m from where the drawing puts it' : ''))}"
      aria-label="${esc(lab + ' recorded position')}"><i class="gpsx">◎</i><i class="gpsu">${esc(pinTag(k))}</i></button>`;
  }).join('');

  /* v5.54 — and the ways in, in a mark of their own. A pin says where the thing is; an entry says where a
     truck turns off the street to reach it, and the two must never be read as each other on a sheet. */
  const ways = !SHOW_FIXES ? '' : Object.entries(S.entries || {}).map(([ref, e]) => {
    if (!e || e.ax == null) return '';
    if (!onSheet.some(a => a.key === ref) && !(sh.circuit_frame !== false && isRef(ref) && !mapSheetFor(assetOf(ref)))) return '';
    const sp = sheetPointOf(sh, e.ax, e.ay); if (!sp) return '';
    const q = fixQuality(e.acc), d = entryToDrop(ref);
    return `<button class="mk gpsmk way" style="left:${(sp.fx * 100).toFixed(3)}%;top:${(sp.fy * 100).toFixed(3)}%"
      data-keys="${esc(ref)}" data-label="${esc(ref + ' \u00b7 way in')}"
      title="${esc('Way in to ' + ref + ' — recorded on site by ' + (e.by || 'unnamed') + (e.at ? ' at ' + fmtStamp(e.at) : '') + ' \u00b7 ' + q.word
        + (d ? ' \u00b7 ' + d.m + ' m from ' + d.basis : ''))}"
      aria-label="${esc('way in to ' + ref)}"><i class="gpsx">\u21b1</i><i class="gpsu">${esc(ref)}</i></button>`;
  }).join('');

  /* v5.55 — and the positions somebody PUT there from outside, hollow, so a glance tells you nobody has stood
     at that one yet. A placed mark disappears the moment a pin is taken against the same thing. */
  const puts = !SHOW_FIXES ? '' : Object.entries(S.places || {}).map(([k, pp]) => {
    if (!pp || pp.ax == null || fixOf(k)) return '';
    const pk = fixParse(k);
    if (!onSheet.some(a => a.key === pk.ref) && !(sh.circuit_frame !== false && isRef(pk.ref) && !mapSheetFor(assetOf(pk.ref)))) return '';
    const sp = sheetPointOf(sh, pp.ax, pp.ay); if (!sp) return '';
    const lab = fixLabel(k);
    return `<button class="mk gpsmk put${pk.unit ? ' unit' : ''}" style="left:${(sp.fx * 100).toFixed(3)}%;top:${(sp.fy * 100).toFixed(3)}%"
      data-keys="${esc(pk.ref)}" data-label="${esc(lab + ' \u00b7 placed')}"
      title="${esc(lab + ' \u2014 ' + placeWords(pp) + ' by ' + (pp.by || 'unnamed') + (pp.at ? ' at ' + fmtStamp(pp.at) : '') + '. Nobody has stood at it yet.')}"
      aria-label="${esc(lab + ' placed position')}"><i class="gpsx">\u25cb</i><i class="gpsu">${esc(pinTag(k))}</i></button>`;
  }).join('');

  const phone = window.matchMedia && window.matchMedia('(max-width:640px)').matches;
  $('#pane-map').innerHTML = paneHeadingHtml('map') + `
  <details class="notice info mapabout"${phone ? '' : ' open'}><summary><b>What a marker is</b></summary>
   A marker sits where the callout text sits on the drawing. It is the label, not the asset — the bubble is placed
   where it reads clearly on the sheet, not where the thing goes. ${DATA.summary.with_drawing_link} of
   ${DATA.summary.assets} assets have a drawing link, and every one of them is a candidate until someone confirms
   it on site.</details>
  <div class="card mapcard">
  <div class="maptools">
   <label class="sheetsel"><span class="vh">Sheet</span><select id="sheetSel" data-ro aria-label="Sheet">${DATA.sheets.map(s => `<option value="${s.key}"${s.key===sh.key?' selected':''}>${esc(s.title)}</option>`).join('')}</select></label>
   ${DATA.sheets.map(s => `<button class="btn sheetbtn ${s.key===sh.key?'primary':''}" data-sheet="${s.key}">${esc(s.title)}</button>`).join('')}
   ${liveMapPossible() ? `<button class="btn sheetbtn satbtn" data-sheet="${SAT_BOARD}" title="Mapbox's satellite photograph with every recorded pin on it — no drawing, updates as the crews pin things">Satellite · pins</button>` : ''}
   ${sat3dPossible() ? `<button class="btn sheetbtn satbtn" data-sheet="${SAT_3D}" title="The circuit in three dimensions — Google's photorealistic 3D tiles, drawn by CesiumJS; opens on this press">Satellite · 3D</button>` : ''}
   ${DATA.edition === 'hosted' ? `<button class="btn sheetbtn satbtn" type="button" data-mopen="explorer">Plan on satellite</button><button class="btn sheetbtn satbtn" type="button" data-mopen="proof3d">3D proof</button>` : ''}
  </div>
  ${discBar(onSheet)}
  ${onSheet.length ? lightBar(onSheet, 'Lights on this sheet') : ''}
  ${foundBar(sh)}
  ${foundViewsHtml()}
  <div class="mapstage" id="stage">
    <div class="maprot" id="maprot" style="--rot:${state.rot}deg;transform:rotate(${state.rot}deg)">
    <div class="mapinner" id="inner" style="--z:${state.zoom};transform:translate(${state.ox}px,${state.oy}px) scale(${state.zoom})">
      <img src="${sh.src}" alt="${esc(sh.subtitle)}" loading="lazy" decoding="async">
      ${foundRing(sh)}${mks}${pins}${ways}${puts}
    </div>
    </div>
    <div class="zoomctl">
      <button data-z="in" title="Zoom in">+</button>
      <button data-z="out" title="Zoom out">&minus;</button>
      <button data-z="reset" title="Fit, and turn back to the drawing as printed">&#8634;</button>
    </div>
    <div class="rotctl">
      <button data-r="l" title="Turn the drawing left" aria-label="Turn the drawing left">&#10226;</button>
      <button data-r="n" title="${mapNorthDeg(sh) == null ? 'This sheet does not say which way north is' : 'North at the top — press again for the drawing as printed'}" aria-label="North up"${mapNorthDeg(sh) == null ? ' disabled' : ''}><span class="rotn" id="rotn" style="transform:rotate(${mapNorthDeg(sh) == null ? 0 : mapNorthDeg(sh) + state.rot}deg)">N</span></button>
      <button data-r="r" title="Turn the drawing right" aria-label="Turn the drawing right">&#10227;</button>
    </div>
    ${sh.m_across ? '<span class="sbar map" id="mapbar"></span>' : ''}
  </div>
  ${sh.circuit_frame === false && sh.own_frame ? `<div class="notice warn" style="margin-top:10px">
    <b>This sheet is not the circuit.</b> ${esc(sh.own_frame.is)} — so the picture is iEDM's own, exactly as they
    issued it, and nothing on it is a position on the circuit map. Read from ${esc(sh.own_frame.read_from)}.
    ${esc(sh.own_frame.so)} <span class="w">Found by ${esc(sh.own_frame.found_by)}.</span></div>` : ''}
  <p class="maphint"><b>${esc(sh.subtitle)}</b> — drag to pan, scroll or pinch to zoom, twist with two fingers (or Shift and scroll) to turn it, N for north at the top, click a marker for the
  asset. ${q ? `Highlighting <b>${hits.size}</b> callout${hits.size===1?'':'s'} matching “${esc(state.q)}”.`
    : 'Type in the search box to highlight matching callouts.'} The dot on a marker's shoulder is its traffic
  light — red not on site, amber in transit, green on site; a hollow red has nothing recorded yet. A red
  <b>!</b> on the other shoulder is an open breakdown.${
    state.light ? ` Showing only <b>${esc(state.light === 'none' ? 'no record' : state.light)}</b>; the rest are faded.` : ''}</p>
  </div>${pageBanner('map')}`;

  setHash('sheet/' + sh.key, {replace: location.hash === '#map'});
  /* the ring round what the search found: sized to the pill it circles, and its strip's two buttons */
  sizeFoundRing();
  wireFoundViews();
  $('#pane-map').querySelectorAll('[data-found-open]').forEach(b => b.onclick = () => openAsset(b.dataset.foundOpen));
  $('#pane-map').querySelectorAll('[data-found-off]').forEach(b => b.onclick = () => { state.found = null; renderMap(); });
  $('#pane-map').querySelectorAll('[data-sheet-go-found]').forEach(b => b.onclick = () => { const f = state.found; if (f) mapLocate(f.sheet, f.label, f.key, {unit: f.unit}); });
  $('#pane-map').querySelectorAll('[data-sheet]').forEach(b => b.onclick = () => {
    if (state.sheet === SAT_BOARD && b.dataset.sheet !== SAT_BOARD) unmountSatBoard();
    if (b.dataset.sheet !== SAT_3D) unmountSat3D();
    state.sheet = b.dataset.sheet; state.zoom = 1; state.ox = 0; state.oy = 0; renderMap(); });
  const sel = $('#sheetSel'); if (sel) sel.onchange = () => { if (state.sheet === SAT_BOARD && sel.value !== SAT_BOARD) unmountSatBoard(); if (sel.value !== SAT_3D) unmountSat3D(); state.sheet = sel.value; state.zoom = 1; state.ox = 0; state.oy = 0; renderMap(); };
  $('#pane-map').querySelectorAll('[data-mapdisc]').forEach(b => b.onclick = () => {
    state.mapDisc = b.dataset.mapdisc || null; renderMap(); });
  $('#pane-map').querySelectorAll('.mk').forEach(b => b.onclick = ev => {
    ev.stopPropagation();
    /* Pills overlap where the drawing crowds its callouts. When more than one marker sits under the finger, or
       one marker carries several assets, the page asks which — it never opens the topmost and hopes. A keyboard
       activation has no point on the screen and opens the marker it was on. */
    const under = (ev.clientX || ev.clientY) ? document.elementsFromPoint(ev.clientX, ev.clientY).filter(el => el.classList && el.classList.contains('mk')) : [b];
    const cands = []; const seen = new Set();
    (under.length ? under : [b]).forEach(el => { const keys = (el.dataset.keys || '').split(',').filter(Boolean);
      if (keys.length) keys.forEach(k => { if (!seen.has(k)) { seen.add(k); cands.push({key: k, label: el.dataset.label}); } });
      else if (!seen.has('#' + el.dataset.label)) { seen.add('#' + el.dataset.label); cands.push({key: null, label: el.dataset.label}); } });
    const linked = cands.filter(c => c.key);
    /* Clicking a numbered place opens the reference it belongs to WITH THAT BOARD MARKED. Without the mark a
       tap on 03 opens "VMS x 8" and leaves somebody counting down a list of eight to find the one they just
       pressed — which is the whole thing Andrew Fisher asked for, missed by one step. */
    if (linked.length === 1 && cands.length === 1) {
      state.unit = (under.length ? under : [b])[0].dataset.unit || null;
      openAsset(linked[0].key); return;
    }
    state.unit = null;
    if (!linked.length) { emptyCallout(sh, cands.map(c => c.label)); return; }
    pickMarker(cands, ev.clientX, ev.clientY);
  });
  wireMap();
}
/* A numbered place nobody has claimed. It is still a place on the drawing, so a person standing at it can
   say what is there: record a unit of an existing reference at this callout, or add an asset the schedule
   never carried, already pointed at this place. Andrew Fisher, 14 Sep 2026: a callout with no data can be added to,
   and this is the way. */
function emptyCallout(sh, labels){
  const label = labels[0] || '', where = 'callout ' + label + ' on ' + sh.sheet_id;
  document.querySelectorAll('.mkpick').forEach(e => e.remove());
  const d = document.createElement('div'); d.className = 'mkpick'; d.setAttribute('role', 'dialog'); d.setAttribute('aria-label', 'Nothing recorded at ' + where);
  const can = !SYNC.readonly;
  d.innerHTML = `<div class="mkpick-h"><b>${esc(where)}</b> — no schedule row names this place<button class="close" aria-label="Close" title="Close">&times;</button></div>
    ${labels.length > 1 ? `<p class="norate" style="margin:0 6px 6px">${labels.length} callouts sit under your finger: ${esc(labels.join(', '))}. This records against ${esc(label)}; zoom in to reach the others.</p>` : ''}
    ${can ? `<p class="norate" style="margin:0 6px 8px">If something is standing here, say what: the reference it belongs to, its asset number, its name on site. The marker lights up from this record.</p>
      ${unitForm(null, {sheet: sh.sheet_id, callout: label})}
      <div class="mkpick-or"><span>or</span></div>
      <button type="button" class="mkpick-i" data-addhere><b>Add an asset the schedule does not carry</b><span class="w">opens Edit, under Tools, with this place filled in</span></button>`
        : `<p class="norate" style="margin:0 6px 8px">This link can view the record but not add to it.</p>`}`;
  mounted(document.body.appendChild(d));
  const close = () => { d.remove(); document.removeEventListener('keydown', onKey); };
  const onKey = e => { if (e.key === 'Escape') { e.preventDefault(); close(); } };
  document.addEventListener('keydown', onKey);
  d.querySelector('.close').onclick = close;
  wireUnitForm(d, ref => { close(); state.unit = null; renderMap(); });
  const add = d.querySelector('[data-addhere]');
  if (add) add.onclick = () => { close(); state.addPrefill = {loc: where, sheet: sh.sheet_id, callout: label}; go('edit'); };   /* v5.99 - the Add page is set aside; Edit carries Add an asset */
  const first = d.querySelector('input'); if (first) first.focus();
}
/* the choice when a tap could mean more than one asset */
function pickMarker(cands, x, y){
  cands = cands.filter(c => c.key).concat(cands.filter(c => !c.key));      // the assets first, the bare callouts after
  document.querySelectorAll('.mkpick').forEach(e => e.remove());
  const d = document.createElement('div'); d.className = 'mkpick'; d.setAttribute('role', 'dialog'); d.setAttribute('aria-label', 'Which one?');
  d.innerHTML = `<div class="mkpick-h"><b>${cands.filter(c => c.key).length} assets under your finger</b> — which one?<button class="close" aria-label="Close" title="Close">&times;</button></div>
    ${cands.map(c => c.key ? `<button type="button" class="mkpick-i" data-pick="${esc(c.key)}">${lightChip({key: c.key})}<b>${esc(c.key)}</b> <span>${esc((allAssets().find(a => a.key === c.key) || {}).name || '')}</span><span class="w">callout ${esc(c.label)}</span></button>`
                             : `<div class="mkpick-i w">callout ${esc(c.label)} — no schedule row linked</div>`).join('')}`;
  mounted(document.body.appendChild(d));
  const close = () => { d.remove(); document.removeEventListener('keydown', onKey); };
  const onKey = e => { if (e.key === 'Escape') { e.preventDefault(); close(); } };
  document.addEventListener('keydown', onKey);
  d.querySelector('.close').onclick = close;
  d.querySelectorAll('[data-pick]').forEach(b => b.onclick = () => { close(); openAsset(b.dataset.pick); });
  const first = d.querySelector('[data-pick]'); if (first) first.focus();
}

function wireMap(){
  const stage = $('#stage'), inner = $('#inner');
  if (!stage) return;
  const sh = DATA.sheets.find(s => s.key === state.sheet) || DATA.sheets[0];
  const mapBar = () => {
    const bar = $('#mapbar');
    if (!bar || !sh.m_across) return;
    const r = stage.getBoundingClientRect();
    const mPerPx = sh.m_across / (r.width * state.zoom);
    const nice = [5, 10, 20, 25, 50, 100, 200, 250, 500, 1000];
    const target = 140 * mPerPx;
    const m = nice.reduce((a, b) => Math.abs(Math.log(b / target)) < Math.abs(Math.log(a / target)) ? b : a, nice[0]);
    bar.style.width = (m / mPerPx).toFixed(1) + 'px';
    bar.textContent = m >= 1000 ? (m / 1000) + ' km' : m + ' m';
    bar.title = 'Scale bar — ' + bar.textContent + ' on the ground at this zoom';
  };
  const rotEl = $('#maprot'), north = mapNorthDeg(sh);
  const apply = () => { inner.style.setProperty('--z', state.zoom);
    inner.style.transform = `translate(${state.ox}px,${state.oy}px) scale(${state.zoom})`;
    if (rotEl) { rotEl.style.setProperty('--rot', state.rot + 'deg'); rotEl.style.transform = `rotate(${state.rot}deg)`; }
    const n = $('#rotn'); if (n && north != null) n.style.transform = `rotate(${north + state.rot}deg)`;
    mapBar(); };
  mapBar();
  /* v5.83 — THE DRAWING TURNS ABOUT THE MIDDLE OF THE STAGE (Andrew Fisher, 25 Sep 2026: every map can be spun
     round). The pan and zoom stay in the drawing's own frame, so a point on the screen is turned back into that
     frame before it is used: a drag moves the drawing the way the finger went, and a pinch or a wheel zooms about
     the point under it, whichever way the drawing is turned. Turned back to 0 the arithmetic is exactly what it was. */
  const unturn = (x, y, r) => { const a = -state.rot * Math.PI / 180, c = Math.cos(a), s = Math.sin(a), mx = r.width / 2, my = r.height / 2;
    return {x: mx + (x - mx) * c - (y - my) * s, y: my + (x - mx) * s + (y - my) * c}; };
  const unturnD = (dx, dy) => { const a = -state.rot * Math.PI / 180, c = Math.cos(a), s = Math.sin(a); return {x: dx * c - dy * s, y: dx * s + dy * c}; };
  const turnTo = deg => { state.rot = Math.round((((deg % 360) + 540) % 360 - 180) * 10) / 10; clamp(); apply(); };
  const clamp = () => {
    /* Measure the image rather than assuming every sheet is 2020x1427. The aerial is 2020x1271, so the
       hard-coded ratio let it pan 205px off its own frame at 2.25x zoom. */
    const im = stage.querySelector('.mapinner img');
    const ratio = (im && im.naturalWidth) ? (im.naturalHeight / im.naturalWidth) : 1427/2020;
    const r = stage.getBoundingClientRect(), w = r.width * state.zoom, h = (r.width * ratio) * state.zoom;
    if (state.rot) {
      /* turned, the drawing's edges no longer run along the stage's, so it is held by its middle instead: some of
         it always covers the centre of the stage and it can never be lost off the side */
      state.ox = Math.min(r.width / 2, Math.max(r.width / 2 - w, state.ox));
      state.oy = Math.min(r.height / 2, Math.max(r.height / 2 - h, state.oy));
      return;
    }
    state.ox = Math.min(0, Math.max(r.width - w, state.ox));
    state.oy = Math.min(0, Math.max(Math.min(0, r.height - h), state.oy));
  };
  stage.querySelectorAll('[data-r]').forEach(b => b.onclick = () => {
    const k = b.dataset.r;
    if (k === 'l') turnTo(state.rot - 15);
    else if (k === 'r') turnTo(state.rot + 15);
    else if (k === 'n' && north != null) turnTo(Math.abs(((state.rot + north) % 360 + 360) % 360) < 0.5 ? 0 : -north);
  });
  stage.querySelectorAll('[data-z]').forEach(b => b.onclick = () => {
    const k = b.dataset.z;
    if (k === 'reset') { state.zoom = 1; state.ox = 0; state.oy = 0; state.rot = 0; }
    else {
      const r = stage.getBoundingClientRect(), cx = r.width/2, cy = r.height/2, old = state.zoom;
      state.zoom = Math.min(8, Math.max(1, state.zoom * (k === 'in' ? 1.5 : 1/1.5)));
      state.ox = cx - (cx - state.ox) * (state.zoom/old);
      state.oy = cy - (cy - state.oy) * (state.zoom/old);
    }
    clamp(); apply();
  });
  stage.addEventListener('wheel', e => {
    e.preventDefault();
    if (e.shiftKey) { turnTo(state.rot + ((e.deltaY || e.deltaX) < 0 ? -5 : 5)); return; }
    const r = stage.getBoundingClientRect(), old = state.zoom;
    const { x: cx, y: cy } = unturn(e.clientX - r.left, e.clientY - r.top, r);
    state.zoom = Math.min(8, Math.max(1, state.zoom * (e.deltaY < 0 ? 1.18 : 1/1.18)));
    state.ox = cx - (cx - state.ox) * (state.zoom/old);
    state.oy = cy - (cy - state.oy) * (state.zoom/old);
    clamp(); apply();
  }, {passive:false});
  let drag = null;
  const pts = new Map();
  /* every finger is tracked by its pointerId; a cancel (the browser taking the gesture, a call coming in, a palm)
     clears the lot, and a pointer the browser never released is dropped when a new gesture starts — so a stale
     pointer can never pair with a new finger and read as a pinch that drifts the map */
  stage.addEventListener('pointerdown', e => {
    if (e.target.closest('.mk') || e.target.closest('.zoomctl') || e.target.closest('.rotctl')) return;
    if (pts.size >= 2) { pts.clear(); drag = null; }
    pts.set(e.pointerId, e); try { stage.setPointerCapture(e.pointerId); } catch (err) {}
    if (pts.size === 1) drag = {x:e.clientX, y:e.clientY, ox:state.ox, oy:state.oy};
  });
  stage.addEventListener('pointermove', e => {
    if (!pts.has(e.pointerId)) return;
    pts.set(e.pointerId, e);
    if (pts.size === 2) {
      const [a, b] = [...pts.values()];
      const d = Math.hypot(a.clientX-b.clientX, a.clientY-b.clientY);
      const ang = Math.atan2(b.clientY - a.clientY, b.clientX - a.clientX) * 180 / Math.PI;
      if (drag && drag.d) {
        const r = stage.getBoundingClientRect(), old = state.zoom;
        /* the twist first: two fingers turning turn the drawing by the same angle (small wobbles are ignored, so a
           plain pinch does not creep round) */
        let dAng = ang - drag.ang; dAng = ((dAng + 540) % 360) - 180;
        if (Math.abs(dAng) > 0.4) { state.rot = Math.round((((state.rot + dAng) % 360 + 540) % 360 - 180) * 10) / 10; }
        state.zoom = Math.min(8, Math.max(1, state.zoom * (d/drag.d)));
        const { x: cx, y: cy } = unturn((a.clientX+b.clientX)/2 - r.left, (a.clientY+b.clientY)/2 - r.top, r);
        state.ox = cx - (cx - state.ox) * (state.zoom/old);
        state.oy = cy - (cy - state.oy) * (state.zoom/old);
        clamp(); apply();
      }
      drag = {d, ang};
    } else if (drag && drag.x != null) {
      const m = unturnD(e.clientX - drag.x, e.clientY - drag.y);
      state.ox = drag.ox + m.x;
      state.oy = drag.oy + m.y;
      clamp(); apply();
    }
  });
  const up = e => { pts.delete(e.pointerId); if (pts.size < 2) drag = null; try { stage.releasePointerCapture(e.pointerId); } catch (err) {} };
  const cancel = () => { pts.clear(); drag = null; };
  stage.addEventListener('pointerup', up); stage.addEventListener('pointercancel', cancel); stage.addEventListener('lostpointercapture', up);
  window.addEventListener('blur', cancel); document.addEventListener('visibilitychange', () => { if (document.visibilityState !== 'visible') cancel(); });
}

/* ------------------------------------------------------------------ register */
function renderRegister(){
  const byDisc = allAssets().filter(a => matches(a, state.q.trim().toLowerCase()))
    .filter(a => !state.disc || a.discipline === state.disc);
  const list = byDisc.filter(lightMatches);
  state.list = list.map(a => a.key);
  const discs = [...new Set(allAssets().map(a => a.discipline))].sort();
  $('#pane-register').innerHTML = paneHeadingHtml('register') + `
  <div class="card">
  <div class="hubtitle" style="margin-bottom:10px"><h3>Register <span class="chip ref">${list.length} of ${allAssets().length}</span></h3>
    <span class="w" style="font-size:12px;color:var(--mute)">every asset the schedule carries, plus anything added here</span></div>
  <div class="filters">
    ${(() => { const tot = askedTot;
      return `<button data-d="" aria-pressed="${!state.disc}" title="every thing on the job, on ${allAssets().length} references${esc(offWords(allAssets()))}">All ${esc(fmtNum(tot(allAssets())))}</button>
    ${discs.map(d => { const mine = allAssets().filter(a => a.discipline === d), n = tot(mine), u = discUnit(d);
      const where = `${esc(fmtNum(n))} across ${discCount(d, mine.length - offCount(mine))}${u.why ? ' — ' + esc(u.why) : ''}${esc(offWords(mine))}`;
      return `<button data-d="${esc(d)}" aria-pressed="${state.disc===d}" title="${where}">${esc(d)} ${esc(fmtNum(n))}</button>`; }).join('')}`; })()}
  </div>
  ${lightBar(byDisc)}
  <div class="daynav" style="margin-top:10px">
    <button class="btn" data-regview="list" aria-pressed="${(state.regView || 'list') === 'list'}">List</button>
    <button class="btn" data-regview="cards" aria-pressed="${state.regView === 'cards'}"
      title="every one on its own card, with the product photograph where Andrew Fisher has supplied one and what still needs checking on it">Cards</button>
  </div>
  ${state.disc && discUnit(state.disc).one !== 'asset' ? barrierNotice() : ''}
  ${(() => { const n = state.disc ? (byDisc.find(a => a.series_note) || {}).series_note : null;
     return n ? `<div class="notice info" style="margin-top:8px"><b>Two series on the drawing</b>${esc(n)}</div>` : ''; })()}
  </div>
  ${/* v5.56 — the barriers fold sits under the register when the barriers are what you are looking at. It is
       keyed on the discipline the barriers rows carry, not on the unit word, because that word is "location". */
    state.disc === 'Water-filled barriers' ? barriersCard() : ''}
  ${contractsCard(list.map(a => a.key))}
  ${branchCard(list.map(a => a.key))}
  ${state.regView === 'cards' ? `<div class="card">
    <div class="hubtitle" style="margin-bottom:2px"><h3>Equipment cards</h3>
      <span class="w" style="font-size:12px;color:var(--mute)">${(() => {
        /* a two-product reference carrying a picture of each counts as pictured; its kind is the kind of its
           pictures, and it counts as photographed only if every one is a photograph */
        const pics = list.map(a => productPhoto(a) || (productPhoto(a, {each: true}) || null)).filter(Boolean)
          .map(p => Array.isArray(p) ? {kind: p.every(e => e.pic.kind !== 'made') ? 'photo' : 'made'} : p);
        const shot = pics.filter(p => p.kind !== 'made').length, made = pics.length - shot;
        return esc(fmtNum(pics.length) + ' of ' + fmtNum(list.length) + ' carry a picture'
          + (pics.length ? ' — ' + fmtNum(shot) + ' photographed, ' + fmtNum(made) + ' illustrated' : '')); })()}</span></div>
    <p class="norate" style="margin:6px 0 0">Three kinds of picture and every one says which it is, on the
      picture itself. <b>On site</b> in orange is a photograph of this drop, taken on the day. <b>Reference
      photo</b> is a photograph Andrew Fisher supplied of the product — that product at that size, not this
      particular unit. <b>Illustration</b> is a picture nobody took: made so a driver knows what shape to look
      for on a gate, accurate to the product and evidence of nothing. Anything with none of the three shows an
      empty slot rather than a near-enough picture of something else.</p>
    ${list.length ? `<div class="eqgrid">${list.slice(0, 120).map(a => equipmentCard(a, {on: state.sel === a.key})).join('')}</div>${
      list.length > 120 ? `<p class="norate">Showing the first 120. Narrow it with the filters or the search above.</p>` : ''}`
      : '<p class="norate">Nothing matches the filter.</p>'}
  </div>` : ''}
  <div class="card"${state.regView === 'cards' ? ' hidden' : ''}>
  <div class="tblwrap"><table>
   <thead><tr><th>Ref</th><th>Light</th><th>Name</th><th>Type</th><th>Asset number</th><th>Rental ID</th><th>Branch</th><th class="num">Inside it</th>
   <th>Scheduled</th><th>Due</th><th>Off-hire</th><th>Drawing</th></tr></thead>
   <tbody>${list.length ? list.map(a => { const d = deliveryOf(a.key), c = contractOf(a.key); return `
    <tr class="click ${rowClass(a)}" data-k="${esc(a.key)}">
     <td class="refcell">${refPlate(a.key, 15)}${a._added?' <span class="chip act">added</span>':''}${a.origin === 'drawing' ? ` <span class="chip cand" title="${esc(a.schedule_state || 'drawn on the sheet; no schedule row names it')}">drawing only</span>` : ''}${bdBadge(a.key)}</td>
     <td>${lightCell(a)}</td>
     <td>${esc(a.name || '—')}</td>
     <td>${esc((a.item_types||[]).join(', ') || '—')}</td>
     <td class="mono">${a.asset_numbers.length ? assetNosOf(a, {bare: true}) :
        '<span class="chip">not supplied</span>'}</td>
     <td>${c.id ? contractShort(c.c, c.id) : '<span class="todo" title="no Rental ID recorded">—</span>'}</td>
     <td>${branchChip(a.key)}</td>
     <td class="num">${a.accessories.length ? a.accessories.reduce((s,x)=>s+(x.qty||1),0) : '—'}</td>
     <td style="white-space:nowrap">${(() => { const e = effectiveDates(a);
        return (e.in ? esc(e.in) : '—') + (e.in_moved ? ` <span class="chip act" title="the plan said ${esc(e.in_plan || 'nothing')}">moved</span>` : '')
          + (e.out && e.out !== e.in ? ' → ' + esc(e.out) + (e.out_moved ? ` <span class="chip act" title="the plan said ${esc(e.out_plan || 'nothing')}">moved</span>` : '') : ''); })()}</td>
     <td class="t">${d.eta ? `<b title="planned time to site${d.eta_where === 'committed' ? ' (committed)' : ` (${LW()})`}">${esc(d.eta)}</b>`
        : '<span class="todo" title="no planned time to site has been set">—</span>'}</td>
     <td>${offhireChip(a)}</td>
     <td>${a.reference_state ? '<span class="chip crit">unresolved ref</span> ' : ''}${(a.drawing_links||[]).length ? `<span class="chip ${a.linked_to_2026_sheet===false?'crit':'cand'}">${esc(a.drawing_links[0].label)} ${a.linked_to_2026_sheet===false?'2025 sheet only':'candidate'}</span>` :
        '<span class="chip">no link</span>'}</td>
    </tr>`; }).join('') : '<tr><td colspan="12" class="empty">Nothing matches that search.</td></tr>'}
   </tbody></table></div>
  <p class="maphint">${list.length} of ${allAssets().length} assets shown. Click a row for the detail, the
  accessories inside it and everything the schedule says about it. Tap a light to set it — red not on site,
  amber in transit, green on site. A hollow red is a reference nobody has recorded anything for.</p>
  </div>
  ${onhireCard()}`;
  $('#pane-register').querySelectorAll('[data-d]').forEach(b => b.onclick = () => {
    state.disc = b.dataset.d || null; renderRegister(); });
  /* the list or the cards — a way of looking, kept in state like every other one, and writing nothing */
  $('#pane-register').querySelectorAll('[data-regview]').forEach(b => b.onclick = () => {
    state.regView = b.dataset.regview; renderRegister(); });
  $('#pane-register').querySelectorAll('[data-eq]').forEach(b => b.onclick = () => openAsset(b.dataset.eq));
  $('#pane-register').querySelectorAll('[data-k]').forEach(r => r.onclick = () => openAsset(r.dataset.k));
  wireContractsCard($('#pane-register'), list.map(a => a.key));
  wireBranchCard($('#pane-register'), list.map(a => a.key));
  wireOnhireCard($('#pane-register'));
  $('#pane-register').querySelectorAll('.onhire [data-k]').forEach(b => b.onclick = ev => { ev.stopPropagation(); openAsset(b.dataset.k); });
}

/* ------------------------------------------------------------------ master plant pages
   Grouped by product, because that is how the yard and the site talk about it — generators, light towers,
   toilets, buildings — not by the schedule's discipline column, which puts the one light tower in with the
   fourteen generators. Buildings carry a contents breakdown because what is inside the building is half of
   what was hired. */
const PLANT_GROUP_WORDS = {'Access': 'Forklifts & access', 'VMS': 'VMS boards', 'Trakmat': 'Track mat', 'WFB': 'Water-filled barriers',
                           'Toilet': 'Toilets & amenities', 'Portable Building': 'Portable buildings', 'Generator': 'Generators', 'Light Tower': 'Lighting towers'};
function plantGroups(){
  const by = new Map();
  allAssets().forEach(a => {
    const g = PLANT_GROUP_WORDS[a.product] || a.product || a.discipline || 'Uncategorised';
    if (!by.has(g)) by.set(g, []);
    by.get(g).push(a);
  });
  return [...by.entries()].sort((x, y) => y[1].length - x[1].length);
}
/* v5.91 - the Plant page carries the asset register beneath the plant lines: the register's own pane is moved in
   under it and drawn by its own renderer, so every filter, search and light it had still works there */
let REG_PANE = null;
function plantCarriesRegister(){
  if (!REG_PANE) REG_PANE = $('#pane-register');
  const host = $('#pane-plant'); if (!REG_PANE || !host) return;
  REG_PANE.classList.remove('pane', 'on', 'arrive'); REG_PANE.classList.add('inplant'); REG_PANE.removeAttribute('hidden'); REG_PANE.removeAttribute('role');
  host.appendChild(REG_PANE);
  renderRegister();
}
function renderPlant(){
  const q = state.q.trim().toLowerCase();
  const groups = plantGroups();
  const only = state.plantGroup && groups.some(([g]) => g === state.plantGroup) ? state.plantGroup : null;
  const shown = only ? groups.filter(([g]) => g === only) : groups;
  const cs = COMMITTED.summary || {};
  state.list = shown.flatMap(([, list]) => list.filter(a => (!q || matches(a, q)) && lightMatches(a)).map(a => a.key));
  $('#pane-plant').innerHTML = paneHeadingHtml('plant') + `
   <div class="card">
     <div class="hubtitle"><h3>Plant — what was asked for, and what we supplied</h3>
       <div class="regviewsw" role="group" aria-label="View"><button type="button" class="btn sm" data-plantview="list" aria-pressed="${state.plantView !== 'cards'}">List</button><button type="button" class="btn sm" data-plantview="cards" aria-pressed="${state.plantView === 'cards'}">Cards</button></div></div>
     <p class="sub">One page per plant type, every reference with its register facts: name and type, scheduled dates,
       due, off-hire, asset numbers, Rental ID and branch, what was asked for and what turned up, and its drawing
       link. Open any reference here or on the Map to fill it in.</p>
     <div class="filters">
       ${(() => { /* the chips count things, never schedule rows — Andrew Fisher, 12 Sep 2026: plant shows total
            numbers (more than 7 VMS, more than 1 trackmat). Seven rows move twenty-two
            boards; one row lays twenty track mats. The same unitsAsked() the plates read. */
          const tot = askedTot;
          return `<button class="btn${only ? '' : ' primary'}" data-pg="" title="every thing on the job${esc(offWords(allAssets()))}">All ${esc(fmtNum(tot(allAssets())))}</button>
       ${groups.map(([g, list]) => { const d = (list[0] || {}).discipline, live = list.length - offCount(list);
          return `<button class="btn${only === g ? ' primary' : ''}"
          data-pg="${esc(g)}" title="${esc(fmtNum(tot(list)))} across ${d ? discCount(d, live) : live}${esc(offWords(list))}">${esc(g)} ${esc(fmtNum(tot(list)))}</button>`; }).join('')}`; })()}
     </div>
     ${legend()}
     ${lightBar(shown.flatMap(([, list]) => list).filter(a => !q || matches(a, q)))}
     <p class="norate">Committed at the last rebuild: <b>${cs.items_recorded_as_supplied ?? 0}</b> of
       <b>${cs.items_asked ?? 0}</b> asked-for items have a supplied record, <b>${cs.items_differing ?? 0}</b>
       of them differ. Anything captured since is marked
       <span class="chip cand">${LW()}</span>.</p>
   </div>
   ${shown.map(([g, list]) => plantTable(g, list.filter(a => (!q || matches(a, q)) && lightMatches(a)))).join('')}
   <div class="regsum">${contractsCard(state.list)}${branchCard(state.list)}</div>`;
  /* v5.95 - the register's own views, on this page */
  $('#pane-plant').querySelectorAll('[data-plantview]').forEach(b => b.onclick = () => { state.plantView = b.dataset.plantview; renderPlant(); });
  $('#pane-plant').querySelectorAll('[data-eq]').forEach(b => b.onclick = () => openAsset(b.dataset.eq));
  $('#pane-plant').querySelectorAll('[data-k]').forEach(r => r.onclick = ev => { ev.stopPropagation(); openAsset(r.dataset.k); });
  $('#pane-plant').querySelectorAll('[data-pg]').forEach(b => b.onclick = () => {
    state.plantGroup = b.dataset.pg || null; render();
  });
  $('#pane-plant').querySelectorAll('[data-open]').forEach(b => b.onclick = () => openAsset(b.dataset.open));
  $('#pane-plant').querySelectorAll('[data-map]').forEach(b => b.onclick = () => showOnMap(b.dataset.map));
}
function plantTable(group, list){
  if (!list.length) return '';
  const isBuilding = /building/i.test(group);
  const items = list.flatMap(a => itemRows(a));
  const done = items.filter(r => r.state !== 'not recorded').length;
  const pct = items.length ? Math.round(done / items.length * 100) : 0;
  return `
  <div class="card">
    <h3>${esc(group)} <span class="chip ref" title="references on this page">${list.length} reference${list.length === 1 ? '' : 's'}</span></h3>
    <div class="prog" role="img" aria-label="${esc(done)} of ${esc(items.length)} asked-for item lines recorded as supplied">
      <div class="track"><i style="width:${pct}%"></i></div>
      <span>${esc(done)} of ${esc(items.length)} asked-for item line${items.length === 1 ? '' : 's'} recorded${pct ? ' · ' + pct + '%' : ''}</span>
    </div>
    ${state.plantView === 'cards' ? `<div class="eqgrid">${list.map(a => equipmentCard(a, {on: state.sel === a.key})).join('')}</div>` : `<div class="tblwrap"><table>
      <thead><tr><th>GC500 ID</th><th>Light</th><th>Dates</th><th>Asset no. · contract</th><th>Description asked for</th>
        <th>Description supplied</th><th>State</th>${isBuilding ? '<th>What comes with it</th>' : ''}</tr></thead>
      <tbody>${list.map(a => {
        const rows = itemRows(a), com = CROW.get(a.key) || {}, d = deliveryOf(a.key);
        const rent = rentalOf(a.key);
        /* a plant line's numbers come from the rental system, and the tynes line is named as what it is */
        const rentNums = rent ? rent.lines.map(r => r.asset_no).filter(Boolean) : [];
        const miscDesc = rent ? (rent.lines.find(r => String(r.asset_no || '').toUpperCase() === 'MISCITEM') || {}).description : null;
        const nums = [...new Set((a.asset_numbers||[]).concat(com.asset_numbers_supplied||[],
                                                 (localSupplied(a.key).asset_numbers)||[], rentNums))];
        const asked = rows.map(r => esc(r.asked) + (r.qty_asked != null ? ' ×' + esc(r.qty_asked) : ''))
                          .join('<br>') || '—';
        /* An empty cell reads as a quiet dash, not a chip. Every row on this page starts empty, and 150 rows
           of five identical grey "not recorded" chips is a wall the eye slides off — the one row somebody has
           actually filled in disappears into it. The dash keeps the meaning and gives the recorded values
           somewhere to stand out from. */
        const sup = rows.map(r => r.supplied
              ? '<b>' + esc(r.supplied) + '</b>' + (r.qty_supplied != null ? ' ×' + esc(r.qty_supplied) : '')
              : '<span class="todo" title="nobody has recorded what turned up — this is not the same as it '
                + 'arriving as asked">—</span>').join('<br>');
        const st = rows.some(r => r.state === 'differs') ? '<span class="chip act">differs</span>'
                 : rows.length && rows.every(r => r.state === 'as asked') ? '<span class="chip ok">as asked</span>'
                 : '<span class="todo">—</span>';
        return `<tr class="${rowClass(a)}">
          <td><button class="linkish" data-open="${esc(a.key)}"><b>${esc(a.key)}</b></button>
            ${isPlantLine(a) ? (a._given
              ? `<br><span class="chip ref" title="the schedule's row ${esc(a.task_id)}, given this reference by ${esc(a._given.by || 'unnamed')}${a._given.at ? ' on ' + esc(fmtStamp(a._given.at)) : ''}">row ${esc(a.task_id)} · reference given</span>`
              : `<br><span class="chip cand" title="a schedule row with no drawing reference, carried under the schedule's own task id — open it to give it a reference">plant line</span>`)
              + `<br><span class="w" style="font-size:11px;color:var(--mute)">${esc(a.name || '')}</span>`
              : `<br><span class="w" style="font-size:11px;color:var(--mute)">${esc(a.name || '')}${(a.item_types || []).length ? ' · ' + esc(a.item_types.join(', ')) : ''}</span>`}${
            a._added ? ' <span class="chip act">added</span>' : ''}${a.origin === 'drawing' ? ` <span class="chip cand" title="${esc(a.schedule_state || 'drawn on the sheet; no schedule row names it')}">drawing only</span>` : ''}${
            (a.drawing_links || []).length ? `<br><span class="chip ${a.linked_to_2026_sheet === false ? 'crit' : 'cand'}" title="drawing link">${esc(a.drawing_links[0].label)}${a.linked_to_2026_sheet === false ? ' · 2025 sheet only' : ''}</span>` : ''}
            ${mapSheetFor(a) ? `<br><button class="linkish" data-map="${esc(a.key)}">on the map</button>` : ''}
            ${a.reference_state ? '<br><span class="chip crit">unresolved ref</span>' : ''}${bdBadge(a.key)}</td>
          <td>${lightCell(a)}${rent && rent.from ? `<div class="w" style="font-size:11px;color:var(--mute);margin-top:2px">on hire from ${esc(fmtDay(rent.from).dm)}${rent.from_time ? ' ' + esc(rent.from_time) : ''}${rent.off ? ' · off hire ' + esc(fmtDay(rent.off).dm) : ''}</div>` : ''}${
            rent && !rent.machines.length && rent.acc_from ? `<div class="w" style="font-size:11px;color:var(--mute);margin-top:2px" title="an attachment on hire — not the machine, so it does not put this line on site">accessory on hire from ${esc(fmtDay(rent.acc_from).dm)} — the machine is not on the extract</div>` : ''}</td>
          <td class="t" style="white-space:nowrap"><div>due ${a.first_date ? esc(fmtDay(a.first_date).dm) : '<span class="todo">—</span>'}${
            d.eta ? ' <b>' + esc(d.eta) + '</b>' : ''}</div><div class="w" style="font-size:11px;color:var(--mute)">${(() => { const e = effectiveDates(a);
            return 'scheduled ' + (e.in ? esc(e.in) : '—') + (e.in_moved ? ` <span class="chip act" title="the plan said ${esc(e.in_plan || 'nothing')}">moved</span>` : '')
              + (e.out && e.out !== e.in ? ' → ' + esc(e.out) + (e.out_moved ? ` <span class="chip act" title="the plan said ${esc(e.out_plan || 'nothing')}">moved</span>` : '') : ''); })()}</div><div style="margin-top:3px">${offhireChip(a)}</div></td>
          <td class="mono">${nums.length ? nums.map(n => assetNo(n, {bare: true, desc: miscDesc})).join('<br>')
             : '<span class="todo" title="the schedule does not carry an asset number for this reference">—</span>'}<div style="margin-top:3px">${(() => { const c = contractOf(a.key), acc = a.accessories || [];
            return (c.id ? contractShort(c.c, c.id) : '<span class="todo" title="no Rental ID recorded">—</span>') + ' ' + branchChip(a.key)
              + (acc.length ? `<div class="w" style="font-size:11px;color:var(--mute)">${acc.reduce((s, x) => s + (x.qty || 1), 0)} inside it</div>` : ''); })()}</div></td>
          <td>${asked}</td><td>${sup}</td><td>${st}</td>
          ${isBuilding ? '<td>' + contentsCell(a) + '</td>' : ''}</tr>`;
      }).join('')}</tbody></table></div>`}
    ${isBuilding ? `<p class="norate">${esc(DATA.accessory_authority)}</p>` : ''}
  </div>`;
}
function contentsCell(a){
  const accs = a.accessories || [];
  if (!accs.length) return '<span class="chip">nothing recorded with it</span>';
  return accs.map(c => `<b>${esc(c.qty)}×</b> ${esc(c.type)}` +
    (c.qty_stated === false ? ' <span class="chip cand" title="the note gave no number, so one was assumed">qty assumed</span>' : '') +
    (c.asset_no ? ' ' + assetNo(c.asset_no)
                : ' <span class="todo" title="no asset number recorded against this item">—</span>')).join('<br>');
}

/* ------------------------------------------------------------------ fencing
   Fencing has no asset references, so nothing on the register can carry it. What it has is dockets: a crew did
   so many metres of this and so many gates of that on a day, against a week sheet and a drawing. This tab is
   that record, charged at the 2026 card and, beside it, costed at what the crew bill on their own sheet (v5.60;
   off in v5.79 on his word that fencing shows only what we charge; back in v5.80 on Andrew Fisher's word of 24 Sep
   2026 that fencing shows charged and paid again — the two never added, every total the charge), rolled up by day and by week against the 2026
   programme's totals so the remaining work is visible, and kept — like everything typed here — apart from what
   the office has committed. The rates and the arithmetic mirror pipeline/ops_layer.py exactly; the test feeds
   the export to the build and compares. */
const FENCE = DATA.fence || {columns:[], rate_gaps:[], week_sheets:[]};
const FCOL = FENCE.columns || [];
/* v5.98 - settled 25 Sep 2026: Advanced bill relocation by the hour; the card charges it by the metre. The tracker's
   $100 on that line is an hourly rate and is never a per-metre cost. */
FCOL.forEach(c => { if (c.key === 'relocation' && c.cost_unit == null && c.unit !== 'hr') c.cost_unit = 'hr'; });
const FCOM = (COMMITTED.fencing || {dockets:[], by_week:[], totals:{}});
const fmtQty = (n, unit) => (n == null ? '—' : (Number.isInteger(n) ? String(n) : n.toFixed(1)) + (unit === 'm' ? ' m' : ''));
/* the number on its own, so a unit can be written once at the end of a pair rather than twice in the middle */
/* a figure the eye can read: 11,890 not 11890; one decimal where the source has one */
const fmtNum = n => (n == null ? '—' : Number.isInteger(n) ? n.toLocaleString('en-AU') : Number(n).toLocaleString('en-AU', {minimumFractionDigits: 1, maximumFractionDigits: 1}));
/* the 2026 programme sheet a 2026 schedule week is planned from (CON WK6 … DECON WK3), as the rate workbook maps them */
function progSheet(week){ const w = (FENCE.week_map || []).find(x => x.week_2026 === week); return w ? w.programme_sheet : null; }
function progSheetOf(week){ const sh = progSheet(week); return (DATA.fencing.week_sheets || []).find(x => x.sheet === sh) || null; }
function plannedFor(week){ const p = progSheetOf(week); return p ? (p.totals || {}) : null; }
/* what the plan says up to and including a day: for a sheet carrying the programme's own dates, the rows dated on or
   before that day; for a sheet not rolled forward, nothing — last year's sequence is not a 2026 plan */
function plannedToDay(sheet, iso, type){
  if (!sheet || !sheet.rolled_forward || !type) return null;
  let s = 0, any = false;
  (sheet.days || []).forEach(d => { if (d.date <= iso && d.totals && d.totals[type] != null) { s += d.totals[type]; any = true; } });
  return any ? Math.round(s * 100) / 100 : (sheet.days || []).length ? 0 : null;
}
/* v5.59 — THE RATE A DOCKET COLUMN IS PRICED AT. The 2026 card's line for the column (matched by hand in
   pipeline/fence_costs.py, named there), unless somebody has typed a rate on the Fencing tab — a typed rate is
   per the column's unit, wins over the card, and carries the typer's name and the time. Andrew Fisher, 19 Sep
   2026: update the fencing pricing — it is all 2026, and it is on the street race card; fencing at 2026 rates
   only. Nothing here reads the tracker's rates; the card's 2026 column is the only one read. */
function fenceRateFor(key){
  const c = FCOL.find(x => x.key === key) || {};
  const typed = safeNum((S.fenceRates || {})[key], MAX_RATE);
  if (typed != null) return {value: typed, source: 'typed', by: stampBy('fenceRates', key), at: (S.stamps || {})['fenceRates/' + key] || null, card: c};
  if (c.rate != null) return {value: c.rate, source: 'card', by: null, at: null, card: c};
  return {value: null, source: null, by: null, at: null, card: c};
}
/* v5.80 — WHAT COATES PAYS, BACK BESIDE WHAT COATES CHARGES. v5.60 priced every docket a second time at the
   crew's own sheet (Brenden Meek's cost tracker — what Advanced bill each line at — or a rate typed over it) and
   showed the two side by side with a margin; v5.79 took the paid side off on Andrew Fisher's word of 23 Sep 2026
   (fencing to show only what we charge); on 24 Sep 2026 he asked for it back — fencing shown charged and paid.
   So the FENCING TAB carries both again — Charged (the 2026 card) and Paid (the tracker's
   rate, or one typed here in the typer's name), never added together, the margin only where both sides are known
   on every line — and the paid figure also follows the printed summary and the email on its own line, outside
   every total, as v5.60 carried it. The paid side goes no further than that: the Costs tab, the branch plates and
   Where we are stay what Coates charges the V8s (his rule of 23 Sep: everything on them is what we are charging
   the V8s), and the purchase orders on the Fencing tab are still what is actually committed to Advanced (the
   fencing purchase orders are what we pay Advanced Fencing). The record key `fenceCosts` — a paid rate typed on
   the Fencing tab — reads as it did in v5.60 and is carried through import, export and merge as before. */
function fenceCostFor(key){
  const c = FCOL.find(x => x.key === key) || {};
  const typed = safeNum((S.fenceCosts || {})[key], MAX_RATE);
  if (typed != null) return {value: typed, source: 'typed', by: stampBy('fenceCosts', key), at: (S.stamps || {})['fenceCosts/' + key] || null, card: c};
  if (c.cost_unit && c.cost_unit !== c.unit && c.cost_rate != null) return {value: null, source: 'hourly', hourly: c.cost_rate, by: null, at: null, card: c};   /* v5.98 - a rate in another unit is not a per-unit cost */
  if (c.cost_rate != null) return {value: c.cost_rate, source: 'tracker', by: null, at: null, card: c};
  return {value: null, source: null, by: null, at: null, card: c};
}
/* One reading of a docket's quantity, used by costing, by grading and by import, so the three cannot disagree.
   A blank cell is nothing done — zero. Anything else that is not a plain number is not a quantity at all, and
   Andrew Fisher's audit of 12 Sep 2026 found that one bad cell beside one good one still graded the docket
   usable while only the good one was costed: metres missing from the total with nothing on the page to say so. */
function docketQuantity(v){
  if (v == null || v === '' || (typeof v === 'string' && v.trim() === '')) return 0;
  if (typeof v === 'boolean' || (typeof v !== 'number' && typeof v !== 'string')) return null;
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
}
/* GATES ARE CHARGED, like every other column — at the card's Pedestrian Gate line, and for vehicle gates (no line on the 2026 card) at whatever rate is typed on the Fencing tab. The trail,
   because this one turned around: Andrew Fisher, 15 Sep 2026, said gates are still fencing panels — read
   as a gate standing in the line in a panel's place and so already inside the docket's metres, and taken off the
   charge. He corrected it the same day: a gate is charged.
   This function and `cost_docket` in pipeline/ops_layer.py price a docket the SAME way — a docket typed here and
   the same docket costed by the build must come to the same money, to the cent, or the page is lying about an
   invoice. Change one and you change the other. */
/* `cost_total` is what the customer is CHARGED — the name is the one every surface has read since the first
   build and it is not worth breaking; `paid_total` beside it is what Coates pays Advanced at the crew's own sheet
   (v5.80, back on Andrew Fisher's word of 24 Sep 2026), and `margin` is the difference, worked out only where BOTH
   are known on every priced line. Every total on the page reads `cost_total`; nothing adds the two. */
function costDocket(d){
  const lines = [], unpriced = [], paidUnpriced = []; let total = 0, paid = 0;
  Object.keys(d.quantities || {}).sort().forEach(k => {
    const v = docketQuantity(d.quantities[k]); if (v == null || !(v > 0)) return;
    const c = FCOL.find(x => x.key === k) || {};
    const r = fenceRateFor(k), pr = fenceCostFor(k);
    const cost = r.value != null ? Math.round(v * r.value * 100) / 100 : null;
    const paidLine = pr.value != null ? Math.round(v * pr.value * 100) / 100 : null;
    lines.push({column:k, name:c.name_as_written || k, unit:c.unit, qty:v, rate:r.value, rate_source:r.source,
                card_line:c.card_line || null, cost, paid_rate: pr.value, paid_rate_source: pr.source, paid: paidLine,
                margin: (cost != null && paidLine != null) ? Math.round((cost - paidLine) * 100) / 100 : null});
    if (cost == null) unpriced.push(k); else total += cost;
    if (paidLine == null) paidUnpriced.push(k); else paid += paidLine;
  });
  const charged = Math.round(total * 100) / 100, paidT = Math.round(paid * 100) / 100;
  const both = lines.length && !unpriced.length && !paidUnpriced.length;
  return {lines, cost_total: charged, unpriced,
          cost_state: lines.length && !unpriced.length ? 'priced' : lines.length ? 'partly priced' : 'nothing to price',
          paid_total: paidT, paid_unpriced: paidUnpriced,
          paid_state: lines.length && !paidUnpriced.length ? 'priced' : lines.length ? 'partly priced' : 'nothing to price',
          /* a margin on a half-priced docket is not a margin, it is a guess — so it is only ever a number when
             every line on the docket carries both a charge and a cost */
          margin: both ? Math.round((charged - paidT) * 100) / 100 : null};
}
function docketProblems(d){
  const bad = [];
  if (!d.date) bad.push('no date');
  const q = d.quantities || {};
  const vals = Object.entries(q).map(([k, v]) => [k, docketQuantity(v)]);
  const unreadable = vals.filter(([, n]) => n === null).map(([k]) => k);
  if (unreadable.length) bad.push('a quantity that is not a number (' + unreadable.slice(0, 3).join(', ') + ')');
  if (!vals.some(([, n]) => (n || 0) > 0)) bad.push('no quantity above zero');
  if (vals.some(([, n]) => (n || 0) < 0)) bad.push('a negative quantity');
  if (!d.recorded_by) bad.push('nobody named as recording it');
  if (d.week && !(DATA.weeks || []).some(w => w.sheet === d.week)) bad.push(`week ${d.week} is not on the 2026 schedule`);
  return bad;
}
function allDockets(){
  /* v5.59 — a committed docket is priced HERE, by the same costDocket() a typed one is, so a rate typed on the
     Fencing tab reaches every docket; the build's own figure travels beside it as cost_total_build */
  const com = (FCOM.dockets || []).map(d => Object.assign({}, d, {cost_total_build: d.cost_total}, costDocket(d),
    {_where: d.origin === 'workbook' ? 'workbook' : 'committed'}));
  const loc = (S.fenceDockets || []).map(d => {
    const w = weekOf(d.date || '');
    const week = d.week || (w ? w.sheet : null);
    const bad = docketProblems(Object.assign({}, d, {week}));
    return Object.assign({}, d, {week, programme_sheet: progSheet(week)}, costDocket(d),
                         {usable: !bad.length, problems: bad, _where:'local', origin:'captured'});
  });
  return com.concat(loc).sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')) || String(a.id).localeCompare(String(b.id)));
}
/* ------------------------------------------------------------------ v5.81 — the three books
   Andrew Fisher, 25 Sep 2026: three books — red, the hire agreements; green, the labour book; blue, the finish /
   collection book. The red book is the docket register above —
   charged to the V8s at the card and costed at what Advanced bill. The GREEN book is Advanced's service notes,
   labour and truck hours, and it is a COST ONLY — what Coates pays Advanced; the V8s pay for that labour inside
   the fencing installation rates, never on a line of its own (Andrew Fisher, 25 Sep 2026).
   So a note is priced at the Labour column's PAID rate — what Advanced bill, from
   their own sheet, or a paid rate typed on this tab — and never at a charge rate, and it never reaches the charge
   side. The BLUE book is the collection form / charge sheet: counts collected, never priced from a blank cost
   column; a hire agreement with the same counts in the same place is named as a match, not as the paper's word.
   pipeline/ops_layer.py (build_books) reads them the same way. */
const FBOOKS = FCOM.books || null;
function serviceNoteRows(){
  const pr = fenceCostFor('labour');
  return (FCOM.service_notes || []).map(n => {
    const h = typeof n.labour_hours === 'number' && Number.isFinite(n.labour_hours) ? n.labour_hours : null;
    const cost = h != null && pr.value != null ? Math.round(h * pr.value * 100) / 100 : null;
    return Object.assign({}, n, {docket_no: n.note_no, book: 'green', cost, cost_rate: pr.value, cost_rate_source: pr.source});
  }).sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')) || String(a.note_no).localeCompare(String(b.note_no)));
}
function greenBookTotals(){
  const rows = serviceNoteRows().filter(r => r.usable !== false), pr = fenceCostFor('labour');
  const priced = rows.filter(r => r.cost != null);
  return {notes: rows.length, hours: Math.round(rows.reduce((s, r) => s + (r.labour_hours || 0), 0) * 100) / 100,
          amount: Math.round(priced.reduce((s, r) => s + r.cost, 0) * 100) / 100, unpriced: rows.length - priced.length,
          rate: pr.value, rate_source: pr.source, rate_by: pr.by};
}
function collectionRows(){
  return (FCOM.collections || []).map(c => Object.assign({}, c, {docket_no: c.collection_no, book: 'blue'}))
    .sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')) || String(a.collection_no).localeCompare(String(b.collection_no)));
}
/* every paper number on the three books — what a file name is matched against */
function bookNumbers(){
  return (allDockets() || []).map(d => d.docket_no).concat(serviceNoteRows().map(n => n.note_no), collectionRows().map(c => c.collection_no));
}
const COLLECT_WORDS = {mesh_panel: ['mesh panel', 'mesh panels'], hoarding_panel: ['hoarding panel', 'hoarding panels'], cc_barrier: ['CC barrier', 'CC barriers'],
  base: ['base', 'bases'], clamp: ['clamp', 'clamps'], brace: ['brace', 'braces'], dog_bar: ['dog bar', 'dog bars'], hand_rail: ['hand rail', 'hand rails'],
  ped_gate: ['pedestrian gate', 'pedestrian gates'], wheels: ['wheel', 'wheels']};
/* hours as the note writes them — 0.75 h is 0.75, not 0.8 (fmtNum rounds to one place; a quarter hour is not a rounding) */
const hoursTxt = h => h == null || !Number.isFinite(Number(h)) ? '—' : String(Math.round(Number(h) * 100) / 100);
const collectWords = q => Object.entries(q || {}).map(([k, v]) => `${fmtNum(v)} ${(COLLECT_WORDS[k] || [k, k])[Number(v) === 1 ? 0 : 1]}`).join(', ');
function bookPapersLine(rows, noun){
  const withP = rows.filter(d => docketPapersOf(d.id).length || docketPapersByName(d).length);
  const without = rows.filter(d => !(docketPapersOf(d.id).length || docketPapersByName(d).length));
  if (!rows.length) return '';
  return `<p class="norate"><b>Signed papers: ${withP.length} of ${rows.length} ${noun} have one.</b>${without.length ? ` No paper yet against ${without.map(d => esc(d.docket_no || d.id)).join(', ')} — the photograph is in the package under its number, ready to upload on the Documents tab.` : ''}</p>`;
}
function greenBookCard(){
  const rows = serviceNoteRows(); if (!rows.length) return '';
  const T = greenBookTotals(), B = (FBOOKS || {}).green || {};
  return `<div class="card" id="greenBook">
    <h3>Green book — labour <span class="chip ref">${rows.length}</span> <span class="chip">cost only</span></h3>
    <p class="sub">${esc(B.paper || 'Advanced Environmental Services — Service Note')} (${esc(B.series || '24451 upward')}): labour and truck hours.
      <b>What Coates pays Advanced</b> — ${esc(hoursTxt(T.hours))} h at their Labour rate${T.rate != null ? ` of ${esc(money(T.rate))} an hour ${T.rate_source === 'typed' ? `(typed on this tab by ${esc(T.rate_by || 'unnamed')})` : '(their own cost sheet)'}` : ' — none on file yet'}
      = <b>${T.rate != null ? esc(money(T.amount)) : '—'}</b> ex GST. It is charged to the V8s inside the fencing installation rates and never on a line of its own
      (Andrew Fisher, 25 Sep 2026).</p>
    ${bookPapersLine(rows, 'notes')}
    <div class="tblwrap"><table class="booktbl"><thead><tr><th>Note</th><th>Date</th><th>Where</th><th class="num">Hours</th><th>What the note says</th><th class="num">Cost to Coates</th><th>Recorded by</th><th></th></tr></thead><tbody>
    ${rows.map(n => `<tr${n.usable === false ? ' class="stop"' : ''}>
      <td>${docketNoLink(n)}<br><span class="mono">${esc(n.id)}</span>${n.usable === false ? ` <span class="chip crit" title="${esc((n.problems || []).join('; '))}">not usable</span>` : ''}</td>
      <td style="white-space:nowrap">${esc(n.date || '—')}${n.week ? '<br><span class="w" style="font-size:11px;color:var(--mute)">' + esc(n.week) + '</span>' : ''}</td>
      <td>${esc(n.location || '—')}</td>
      <td class="num"><b>${n.labour_hours != null ? esc(hoursTxt(n.labour_hours)) : '—'}</b></td>
      <td>${esc(n.crew_note || '')}${n.note ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(n.note)}</span>` : ''}${docketPaperBlock(n)}</td>
      <td class="num">${n.cost != null ? esc(money(n.cost)) : '<span class="todo">no rate</span>'}</td>
      <td>${esc(n.recorded_by || '—')}${n.recorded_on ? '<br><span class="w" style="font-size:11px;color:var(--mute)">' + esc(n.recorded_on) + '</span>' : ''}</td>
      <td>${docketAttachBtn(n)}</td></tr>`).join('')}
      <tr class="total"><td colspan="3"><b>Green book</b></td><td class="num"><b>${esc(hoursTxt(T.hours))}</b></td><td></td><td class="num"><b>${T.rate != null ? esc(money(T.amount)) : '—'}</b></td><td colspan="2"></td></tr></tbody></table></div>
  </div>`;
}
function blueBookCard(){
  const rows = collectionRows(); if (!rows.length) return '';
  const B = (FBOOKS || {}).blue || {};
  return `<div class="card" id="blueBook">
    <h3>Blue book — collections <span class="chip ref">${rows.length}</span> <span class="chip">counted, not priced</span></h3>
    <p class="sub">${esc(B.paper || 'Advanced Temporary Fencing — Collection Form / Charge Sheet')} (${esc(B.series || '28551 upward')}): what came back off the job,
      item by item. Recorded as the counts written; the form's agreed-cost and total columns are blank, so nothing here is charged or costed, and a
      collection never takes metres off a hire agreement already charged. The finish / collection book — Andrew Fisher, 25 Sep 2026.</p>
    ${bookPapersLine(rows, 'forms')}
    <div class="tblwrap"><table class="booktbl"><thead><tr><th>Form</th><th>Removal date</th><th>Where</th><th>Collected</th><th>Hire agreement</th><th>Recorded by</th><th></th></tr></thead><tbody>
    ${rows.map(c => `<tr${c.usable === false ? ' class="stop"' : ''}>
      <td>${docketNoLink(c)}<br><span class="mono">${esc(c.id)}</span></td>
      <td style="white-space:nowrap">${esc(c.date || '—')}</td>
      <td>${esc(c.location || '—')}</td>
      <td><b>${esc(collectWords(c.collected) || '—')}</b>${c.issued ? `<br><span class="w">issued: ${esc(collectWords(c.issued))}</span>` : ''}${c.note ? `<br><span class="w" style="font-size:11.5px;color:var(--mute)">${esc(c.note)}</span>` : ''}${docketPaperBlock(c)}</td>
      <td>${c.hire_agreements_written ? esc(String(c.hire_agreements_written)) : '<span class="todo">not written</span>'}${(c.matches || []).length ? `<br><span class="chip cand" title="the counts collected and the place are exactly those on this hire agreement — a match, not the paper's word">matches ${(c.matches || []).map(esc).join(', ')}</span>` : ''}</td>
      <td>${esc(c.recorded_by || '—')}${c.recorded_on ? '<br><span class="w" style="font-size:11px;color:var(--mute)">' + esc(c.recorded_on) + '</span>' : ''}</td>
      <td>${docketAttachBtn(c)}</td></tr>`).join('')}</tbody></table></div>
  </div>`;
}
/* ------------------------------------------------------------------ the signed paper behind a docket
   Andrew Fisher, 15 Sep 2026: the fencing crew give him a sheet to sign. Fifteen Advanced hire agreements came
   in as photographs of the signed book, and the docket record and the paper it was transcribed from had no
   connection at all — so settling an argument about 577.5 metres meant scrolling a list of everything anybody
   had ever uploaded looking for the right number in the corner.

   The association is made by a PERSON, on a named docket, pressing Attach. It is never inferred from the file
   name. A fencing docket number in a filename looks like an identifier and is not one: the same lesson the
   V12 audit taught on the drop photographs, where a name that merely resembled another put one unit's picture
   against another unit's record. Here it would put one area's paper behind another area's quantities, which is
   the one thing a signed docket exists to prevent. */
function docketPapersOf(id){
  const all = S.docketPapers || {};
  return (all[id] || []).filter(p => p && p.id);
}
/* A SIGNED PAPER UPLOADED BY ITS DOCKET NUMBER. Andrew Fisher, 15 Sep 2026: he has them, named by their docket
   numbers. So a file on the Documents tab whose name carries the docket's number —
   36503.jpg, IMG_36503.pdf — is that docket's paper, without anybody pressing Attach on the row.

   IT LOOKS AT EVERY UPLOADED FILE, WHATEVER KIND IT WAS FILED UNDER. This first read only looked at files
   uploaded AS dockets, and the day he uploaded them he said they had gone in as Other on the admin page and
   matched nothing, and showed as the number with .jpg on the end. The name is the evidence; the kind box on
   the upload form is filing, and filing it in the wrong drawer should never lose the paper. Where the kind is
   something else the row says so, so the record can be tidied later without pretending it already is.

   The number must stand on its own in the name (136503 is not 36503), and a number that is also an asset
   number on this job is left alone unless a person filed the file as a docket themselves — a photograph of
   machine 1327224 is not a docket, however the numbers fall. Every match is labelled as a match by name, so
   nobody takes it for a link a person made. */
/* the docket number a file name carries, or null — the whole number, standing on its own, and only a number
   this record actually has a docket for. A number that is also an asset number on this job is not one. */
function docketNoInName(nm){
  const s = String(nm || ''); if (!s) return null;
  /* v5.81 — all three books: a hire agreement (red), a service note (green) or a collection form (blue) */
  const got = bookNumbers().find(n => { const no = String(n || '').trim();
    if (!/^\d{4,7}$/.test(no)) return false;
    if (allAssets().some(a => (a.asset_numbers || []).some(x => String(x).trim() === no))) return false;
    return new RegExp('(^|\\D)' + no + '(\\D|$)').test(s); });
  return got ? String(got).trim() : null;
}
/* v5.66 — ASKING IS WHAT LOADS IT, HERE TOO. Andrew Fisher, 22 Sep 2026, having just uploaded all nineteen
   signed dockets: the fencing dockets were not attaching on the Fencing page.

   They were on the service and they were named after their own docket numbers, which is exactly what this
   function matches on. The fault was one line above the matching: this read DOCS.files and, finding it not yet
   loaded, returned nothing — silently, and without asking anybody to load it. The service's file index is
   fetched when the DOCUMENTS tab opens, so whether a docket showed its paper depended entirely on whether you
   had happened to visit Documents first in that session. Open the page and go straight to Fencing and every
   docket said it had no paper.

   photoIndex() is the rule the rest of the page already follows — "any route that wants to know about a
   photograph asks the registry, and asking it is what loads it" — and it starts the fetch on a cold registry
   and redraws whatever pane is open when the answer arrives. This route asks it now, like the others. */
function docketPapersByName(d){
  const no = String((d && d.docket_no) || '').trim();
  if (!/^\d{4,7}$/.test(no)) return [];
  /* Ask the registry — asking is what loads it. A registry the page already holds is used whatever the
     service says, which is how the FILE edition, which has no service at all, still matches a docket to a
     paper it was handed. While a fetch is in flight this answers with nothing and the pane redraws when it
     lands, rather than stating that a docket has no paper on the strength of not having looked. */
  const idx = photoIndex();
  const files = idx.state === 'ready' ? idx.files : (idx.state === 'none' ? DOCS.files : null);
  if (!files) return [];
  const re = new RegExp('(^|\\D)' + no + '(\\D|$)');
  const isAssetNo = allAssets().some(a => (a.asset_numbers || []).some(n => String(n).trim() === no));
  const linked = new Set(docketPapersOf(d.id).map(p => p.id));
  return Object.values(files).filter(f => f && !linked.has(f.id)
      && (f.kind === 'docket' || !isAssetNo)
      && (re.test(String(f.name || '')) || re.test(String(f.title || ''))))
    .map(f => ({id: f.id, by: f.by || null, at: f.uploaded || null, byName: true,
                filedAs: f.kind && f.kind !== 'docket' ? f.kind : null}));
}
function docketPaperBlock(d){
  const ps = docketPapersOf(d.id).concat(docketPapersByName(d));
  /* and when there is nothing to show, say WHY rather than showing nothing: a docket with no paper yet and a
     docket whose paper the page has not managed to ask about are different states, and only one of them is
     something to do anything about */
  if (!ps.length) {
    const no = String((d && d.docket_no) || '').trim();
    if (!/^\d{4,7}$/.test(no)) return '';
    const idx = photoIndex();
    if (idx.state === 'loading') return `<div class="dpaper"><span class="meta">Looking for the signed paper for docket ${esc(no)}\u2026</span></div>`;
    if (idx.state === 'failed') return `<div class="dpaper"><span class="meta">The service could not be asked about the signed paper for docket ${esc(no)}. This does not mean it is not there.</span></div>`;
    return '';
  }
  return `<div class="dpaper">${ps.map((p, i) => {
    const r = photoFor(p);
    const open = r.state === 'ready' ? r.url : (SYNC.backend && SYNC.backend.fileUrl ? SYNC.backend.fileUrl(p.id) : null);
    return `<span class="dpaperone">${open
      ? `<a href="${esc(open)}" target="_blank" rel="noopener noreferrer">${i ? 'Paper ' + (i + 1) : 'Signed paper'}</a>`
      : '<span class="todo">Signed paper — checking the service</span>'}<em>${
      esc(p.by || 'unnamed')}${p.at ? ' · ' + esc(fmtStamp(p.at)) : ''}${p.byName ? ' · matched by the docket number in its file name' : ''}${
      p.filedAs ? ' · filed under ' + esc(p.filedAs) + ', not Fencing docket' : ''}</em></span>`;
  }).join('')}</div>`;
}
/* v5.60 — THE DOCKET NUMBER IS THE LINK. Andrew Fisher, 19 Sep 2026: pressing the docket number opens the docket.
   The signed paper was already reachable, from a separate "Signed paper"
   link further along the row — which is a second thing to find when the number is the thing a person is
   already looking at. The number now opens the scan itself, in a new tab.

   Where there is no paper the number is NOT a link and says so, because a number that looks clickable and does
   nothing is worse than one that never offered. Where there is more than one paper the number opens the first
   and says how many there are; the rest stay listed under the row. */
function docketNoLink(d, opts){
  const no = esc(String((d && (d.docket_no || d.id)) || '—'));
  const ps = docketPapersOf(d.id).concat(docketPapersByName(d));
  if (!ps.length) return `<b>${no}</b><br><span class="todo dknop" title="no signed paper on the service against this docket yet — Attach signed paper puts one there">no paper yet</span>`;
  const r = photoFor(ps[0]);
  const open = r.state === 'ready' ? r.url : (SYNC.backend && SYNC.backend.fileUrl ? SYNC.backend.fileUrl(ps[0].id) : null);
  if (!open) return `<b>${no}</b><br><span class="todo dknop">paper on the service — checking</span>`;
  return `<a class="dkno" href="${esc(open)}" target="_blank" rel="noopener noreferrer"
    title="Open the signed paper for docket ${no}${ps[0].byName ? ' — matched by the docket number in its file name' : ''}"><b>${no}</b></a>${
    ps.length > 1 ? `<span class="w dkn2"> ${ps.length} papers</span>` : ''}${(opts && opts.sub) || ''}`;
}
function docketAttachBtn(d){
  if (!(SYNC.backend && SYNC.backend.upload)) return '';
  const id = 'dkp_' + String(d.id).replace(/[^A-Za-z0-9_-]+/g, '_');
  return `<input type="file" id="${id}" class="dphin" accept="image/*,application/pdf" data-dkp="${esc(d.id)}">
    <label class="btn ghost dphpick editonly" for="${id}">${docketPapersOf(d.id).length || docketPapersByName(d).length ? 'Attach another' : 'Attach signed paper'}</label>`;
}
/* Same order as a drop photograph: the bytes reach the service FIRST, and the record only points at the file
   once the service has said it has it. A pointer written before the upload lands is a pointer to nothing. */
async function docketPaperAdd(docketId, file){
  if (!mayWrite('the signed paper for that docket')) return;
  const who = whoAmI(); if (!who) return;
  if (!(SYNC.backend && SYNC.backend.upload))
    return flash('Signed paper is kept on the shared record\u2019s service. This copy of the page has no service behind it.');
  /* v5.81 \u2014 a paper for any of the three books: a hire agreement, a service note or a collection form */
  /* (this read `docketRows().all`, a helper that no longer exists — Attach signed paper threw on every docket and said
     so in a flash; found and fixed here, v5.81) */
  const d = (allDockets() || []).find(x => x.id === docketId) || serviceNoteRows().find(x => x.id === docketId) || collectionRows().find(x => x.id === docketId);
  const no = (d && d.docket_no) || docketId;
  const paper = d && d.book === 'green' ? ['Advanced service note', 'Signed Advanced Environmental Services service note (green book, labour)']
              : d && d.book === 'blue' ? ['Advanced collection form', 'Signed Advanced Temporary Fencing collection form / charge sheet (blue book)']
              : ['Fencing docket', 'Signed Advanced Temporary Fencing hire agreement for docket'];
  let up;
  try {
    up = await SYNC.backend.upload(file, {kind: 'docket',
      title: paper[0] + ' ' + no + (d && d.location ? ' \u00b7 ' + d.location : ''),
      note: paper[1] + ' ' + no + ', attached by ' + who + '.'});
  } catch (e) { return flash(String((e && e.message) || e) + ' \u2014 nothing was changed.'); }
  if (!(up && typeof up.id === 'string' && up.id.trim()))
    return flash('The service did not return a file id. The upload may have reached it \u2014 check Documents before trying again.');
  if (up && up.id) { DOCS.files = DOCS.files || {}; DOCS.files[up.id] = Object.assign({id: up.id, kind: 'docket'}, up); }
  S.docketPapers = S.docketPapers || {};
  S.docketPapers[docketId] = docketPapersOf(docketId).concat([
    {id: up.id, name: up.name || file.name || null, at: new Date().toISOString(), by: who}]);
  stampIt('docketPapers', docketId);
  bump();
  flash('Signed paper attached to ' + (d && d.book === 'green' ? 'service note ' : d && d.book === 'blue' ? 'collection form ' : 'docket ') + no + '.' + uploadPreviewNote(up));
}
function nextDocketId(){ return nextIdFor('F', [S.fenceDockets, FCOM.dockets]); }
/* an installation plan laid over a programme week: what it changed, what it flags on its own pages, and its notes */
function planUpdateCard(u){
  const fq = (fields) => Object.entries(fields || {}).map(([k, v]) => { const c = FCOL.find(x => x.programme_type === k); return `${esc(fmtQty(v, c ? c.unit : ''))} ${esc(c ? c.name_as_written : k)}`; }).join(', ') || '—';
  const kind = k => k === 'changed' ? '<span class="chip act">changed</span>' : k === 'only in the programme' ? '<span class="chip cand">in the programme, not in the plan</span>' : k === 'only in the plan' ? '<span class="chip cand">in the plan, not in the programme</span>' : `<span class="chip">${esc(k)}</span>`;
  return `<div class="planupd"><h3>${esc(u.title)} — the update, ${esc(u.created_display)}</h3>
    <p class="sub">${esc(u.basis)} ${u.days_covered.length ? `Days covered: ${u.days_covered.map(d => esc(fmtDate(d).slice(0, 10))).join(', ')}.` : ''} <button class="linkish" data-go="docs">Open the plan on the Documents tab</button></p>
    ${u.differences.length ? `<div class="sect">Against the programme workbook — ${u.differences.length} difference${u.differences.length === 1 ? '' : 's'}</div>
    <div class="tblwrap"><table class="daytbl"><thead><tr><th>Day</th><th>Line</th><th>Programme said</th><th>The plan says</th><th></th></tr></thead><tbody>${
      u.differences.map(x => `<tr><td style="white-space:nowrap">${esc(fmtDate(x.date).slice(0, 10))}</td><td><b>${esc(x.location)}</b><br><span class="w">${esc(x.description || '')}</span>${x.comment ? `<br><span class="w" style="color:var(--mute)">workbook comment: ${esc(x.comment)}</span>` : ''}</td>
        <td>${x.programme ? fq(x.programme) : '<span class="todo">—</span>'}</td><td>${x.plan ? fq(x.plan) : '<span class="todo">not on the plan</span>'}${x.flag ? `<br><span class="w" style="color:var(--mute)">${esc(x.flag)}</span>` : ''}</td><td>${kind(x.kind)}</td></tr>`).join('')}</tbody></table></div>` : '<p class="sub">Every figure matches the programme workbook.</p>'}
    ${u.flags.length ? `<div class="sect">What the plan flags on its own pages</div><ul class="hublist compact">${u.flags.map(f => `<li><span class="tm">${esc(fmtDate(f.date).slice(0, 6))}</span><b>${esc(f.location)}</b> · ${esc(f.description)} <span class="w" style="color:var(--mute)">— ${esc(f.flag)}${f.page ? ' (p. ' + f.page + ')' : ''}</span></li>`).join('')}</ul>` : ''}
    ${u.notes.length ? `<div class="sect">Notes on the plan's pages</div><ul class="hublist compact">${u.notes.map(n => `<li><span class="tm">${esc(fmtDate(n.date).slice(0, 6))}</span>${esc(n.text)} <span class="w" style="color:var(--mute)">(p. ${n.page})</span></li>`).join('')}</ul>` : ''}
    <p class="norate">Nothing here is resolved by the page: a changed figure is shown with both values, a line the plan drops stays listed, and the plan's own flags are carried as written. The transcript is checked against the PDF's text; the PDF is the document.</p>
  </div>`;
}
function fenceByWeek(dockets){
  return (DATA.weeks || []).map(w => {
    const mine = dockets.filter(d => d.week === w.sheet && d.usable);
    const planned = plannedFor(w.sheet);
    const lines = FCOL.map(c => {
      const done = Math.round(mine.reduce((s, d) => s + (Number((d.quantities || {})[c.key]) || 0), 0) * 100) / 100;
      /* WHAT THE PLAN IS ACTUALLY FOR. Three dockets name a COMPOUND in the site address the installer wrote —
         Advanced's Phillip Park yard, BSF's Helen Park yard, iEDM's event operations compound. The programme
         workbook's SUMMARY sheet is the works fence and has never listed anybody's yard, so adding the two
         together made Week 6 read 525 m ahead of a plan that was simply short of the job. Done keeps every
         metre; what is still to do is measured against the work the plan is for. */
      const onPlan = Math.round(mine.filter(d => (d.scope || 'programme') === 'programme')
        .reduce((s, d) => s + (Number((d.quantities || {})[c.key]) || 0), 0) * 100) / 100;
      const offPlan = Math.round((done - onPlan) * 100) / 100;
      const plan = planned && c.programme_type ? planned[c.programme_type] : null;
      const cost = c.rate != null ? Math.round(mine.reduce((s, d) => s + d.lines.filter(l => l.column === c.key).reduce((t, l) => t + (l.cost || 0), 0), 0) * 100) / 100 : null;
      const ps0 = progSheetOf(w.sheet);
      const prog = ps0 && ps0.programme_totals && c.programme_type ? ps0.programme_totals[c.programme_type] : null;
      return {column:c.key, name:c.name_as_written, unit:c.unit, planned:(plan == null ? null : plan), done,
              onPlan, offPlan,
              remaining:(plan == null ? null : Math.round((plan - onPlan) * 100) / 100), cost,
              programme:(ps0 && ps0.plan_update && prog != null && prog !== plan) ? prog : null};
    });
    const ps = progSheetOf(w.sheet);
    return {week:w.sheet, phase:w.phase, start:w.start, end:w.end, progSheet: ps ? ps.sheet : null,
            span: ps ? ps.span : null, planYear: ps ? ps.year : null, rolled: !!(ps && ps.rolled_forward),
            planWords: ps ? (ps.rolled_forward ? `${ps.sheet} · ${DATA.fencing.programme_year} programme, ${ps.span}` : `${ps.sheet} · ${ps.year} dates in the 2026 file — not rolled forward`) : null,
            update: ps ? (ps.plan_update || null) : null,
            dockets:mine.length, lines, cost:Math.round(mine.reduce((s, d) => s + d.cost_total, 0) * 100) / 100,
            outside: mine.filter(d => (d.scope || 'programme') !== 'programme')
              .map(d => ({no: d.docket_no, scope: d.scope, where: d.location}))};
  });
}
/* Dockets rolled up by the area written on them. The crew write one docket per area, so this is the view of a
   place: everything done there, on which days, against which drawing, and what it has cost. */
function fenceByArea(dockets){
  const norm = t => String(t || '').trim().toLowerCase().replace(/\s+/g, ' ');
  const by = new Map();
  dockets.filter(d => d.location).forEach(d => {
    const k = norm(d.location);
    const a = by.get(k) || by.set(k, {name: String(d.location).trim(), refs: [], dockets: 0, first: null, last: null, cost: 0, unpriced: 0, q: {}}).get(k);
    a.dockets++; a.cost += d.cost_total; a.unpriced += d.unpriced.length;
    if (d.map_ref && !a.refs.includes(d.map_ref)) a.refs.push(d.map_ref);
    if (d.date) { if (!a.first || d.date < a.first) a.first = d.date; if (!a.last || d.date > a.last) a.last = d.date; }
    d.lines.forEach(l => { a.q[l.column] = (a.q[l.column] || 0) + l.qty; });
  });
  return [...by.values()].map(a => Object.assign(a, {
    cost: Math.round(a.cost * 100) / 100,
    lines: FCOL.filter(c => a.q[c.key]).map(c => ({column: c.key, name: c.name_as_written, unit: c.unit, qty: Math.round(a.q[c.key] * 100) / 100})),
  })).sort((x, y) => (y.last || '').localeCompare(x.last || '') || x.name.localeCompare(y.name));
}
/* An area's Complete tick — the crew say the area is done. Keyed the way areas are grouped (case and spacing
   ignored). Local over committed when the local record says anything; an un-tick is a record. */
function fenceAreaKey(name){ return String(name || '').trim().toLowerCase().replace(/\s+/g, ' '); }
function fenceAreaDone(name){
  const k = fenceAreaKey(name);
  const loc = (S.fenceDone || {})[k], com = ((FCOM.areas_done || {})[k]);
  const src = (loc && typeof loc.done === 'boolean') ? loc : (com && com.done) ? com : null;
  return {done: !!(src && src.done), by: src ? (src.by || null) : null, at: src ? (src.at || null) : null,
          where: src === loc && src ? 'local' : src ? 'committed' : null};
}
function setFenceAreaDone(name, on){
  if (!mayWrite('the fencing area')) return false;
  const who = whoAmI(); if (!who) return false;
  S.fenceDone = S.fenceDone || {};
  S.fenceDone[fenceAreaKey(name)] = {done: !!on, by: who, at: new Date().toISOString(), name: String(name || '').trim()};
  bump();
  flash((on ? 'Area ticked complete: ' : 'Area un-ticked: ') + String(name || '').trim() + ' — ' + who + '.');
  return true;
}
function fenceAreaBtn(name){
  const d = fenceAreaDone(name);
  return `<button type="button" class="tickbtn sm${d.done ? ' on' : ''}" data-fdone="${esc(name)}" aria-pressed="${d.done}"
    title="${d.done ? 'Un-tick — area no longer complete' : 'Tick — the crew say this area is complete'}" aria-label="${d.done ? 'Un-tick area complete for ' : 'Tick area complete for '}${esc(name)}">✓</button>`;
}
/* The quoted quantities: local if typed here, else what the last rebuild committed. */
function fenceQuote(){
  if (S.fenceQuote && S.fenceQuote.qty) return Object.assign({_where:'local'}, S.fenceQuote);
  const c = FCOM.quote; return c && c.qty ? Object.assign({_where:'committed'}, c) : null;
}
/* the build's quote_watch, line for line: done across every usable docket against the quoted quantity */
function quoteWatch(dockets){
  const q = fenceQuote(), qty = (q && q.qty) || {};
  const usable = dockets.filter(d => d.usable);
  return FCOL.map(c => {
    const quoted = Number.isFinite(Number(qty[c.key])) && qty[c.key] !== '' && qty[c.key] != null ? Number(qty[c.key]) : null;
    const done = Math.round(usable.reduce((s, d) => s + (Number((d.quantities || {})[c.key]) || 0), 0) * 100) / 100;
    return {column:c.key, name:c.name_as_written, unit:c.unit, quoted, done,
            over_by: quoted == null ? null : done > quoted ? Math.round((done - quoted) * 100) / 100 : 0,
            state: quoted == null ? 'no quote entered' : done > quoted ? 'over quote' : 'within quote'};
  });
}
function whereChipF(w){
  return w === 'workbook' ? '<span class="chip ref" title="a row already in the rate workbook — no date and no docket number against it">from the workbook</span>' : whereChip(w);
}
/* A gate line is shown with its count and marked as carried by the metres, not priced beside them. Andrew
   Fisher, 15 Sep 2026: gates are still fencing panels — the opening stands in a panel's place and
   its width is already inside the metres on the same docket, so a gate charge on top bills it twice. The count
   stays because somebody still has to hang it and take it back. */
/* WHAT A DOCKET WITH NOTHING PRICED IS. Two different things, and calling them the same was a wrong label on
   Andrew's page. A docket can be OWED with something missing before it can be priced — and on 36503 and 36510
   the thing missing is the METRES, not the rate: braced fence is charged as scrim ($24.40/m) and relocation is
   charged per metre ($100/m), both rates known, the length not yet written on the docket. Or a docket can be
   deliberately not on this sheet at all — 36511 is a yard transfer, and Andrew Fisher, 15 Sep 2026: there is no
   transport line — Coates organise the trucks and Krystal keeps those costs. That is not a gap to chase; it is a
   cost that sits somewhere else. Neither is ever shown as free. */
function docketOwedBlock(d){
  const t = d.to_be_charged;
  if (t && t.says) {
    const col = t.charge_as ? FCOL.find(c => c.key === t.charge_as) : null;
    /* v5.54 — A READING FROM THE RECORD, SHOWN AS A READING. Andrew Fisher, 19 Sep 2026: these should all be
       answerable. Where the length the docket does not carry can be read off the other
       dockets and the customer's own plan for the same run, the figure is put here with its working — and it
       stays OUT of the costed total until he says the word, because a chargeable metre is signed for, not
       inferred. `candidate.confirmed_by` is the word. */
    const cand = t.candidate;
    const candHtml = cand && cand.metres != null ? `<div class="candread"><b>Reading from the record: ${esc(fmtQty(cand.metres, 'm'))}${
        col && col.rate != null ? ' \u2248 ' + esc(money(Math.round(cand.metres * col.rate * 100) / 100)) : ''}</b>${
        cand.confirmed_by ? ` <span class="chip ok">confirmed by ${esc(cand.confirmed_by)}</span>` : ' <span class="chip cand" title="not in the costed total until Andrew Fisher confirms it">awaiting his word</span>'}<br>${esc(cand.basis || '')}</div>` : '';
    return `<div class="nocharge"><b>To be charged \u2014 ${esc(t.missing || 'something')} needed</b>${
      col ? ` <span class="chip ref" title="the rate is settled; this is the line it lands on once it can be measured">as ${esc(col.name_as_written)}${
        col.rate != null ? ' \u00b7 ' + money(col.rate) + (col.unit === 'm' ? ' / m' : col.unit === 'each' ? ' each' : '') : ''}</span>` : ''
      } ${esc(t.says)}${candHtml}</div>`;
  }
  if (d.not_charged_here) return `<div class="nocharge"><b>Not charged on this sheet</b> ${esc(d.not_charged_here)}</div>`;
  return '';
}
/* v5.54 — THE CW4 PLAN AGAINST ITS SUMMARY, AND HOW EACH DIFFERENCE SETTLES. Two iEDM documents for the same
   week arrived together on 18 Sep 2026 and do not agree; both are on the record as they came. Nothing is
   averaged: the day plan is what the crew builds to, and what is charged is what the crew signs for on the
   docket on the day, so each difference settles itself when its docket arrives — and one already has. */
function cw4OpenCard(){
  const ip = (DATA.fencing || {}).installation_plans || {}; const dis = ip.disagreements_CW4; if (!dis || !(dis.items || []).length) return '';
  const settled = dis.items.filter(i => i.settled).length;
  return `<div class="card cw4open"><h3>The CW4 plan against its summary \u2014 ${dis.items.length} differences, ${settled} settled</h3>
    <p class="sub">${esc(dis.what || '')} ${esc(dis.how_they_settle || '')}</p>
    <div class="tblwrap"><table><thead><tr><th>Where</th><th>The plan</th><th>The summary</th><th>Reading</th></tr></thead><tbody>${
      dis.items.map(i => `<tr class="${i.settled ? 'done' : ''}"><td><b>${esc(i.ref)}</b></td><td>${esc(i.plan)}</td><td>${esc(i.summary)}</td>
        <td>${i.settled ? '<span class="chip ok">settled</span> ' : '<span class="chip cand" title="the docket on the day settles it">on the day</span> '}${esc(i.reading || i.difference || '')}</td></tr>`).join('')}</tbody></table></div>
  </div>`;
}
function docketLines(d){
  return d.lines.length ? d.lines.map(l => `<b>${esc(fmtQty(l.qty, l.unit))}</b> ${esc(l.name)}${
    l.cost == null ? ' <span class="chip crit" title="no rate on the sheet for this column">no rate</span>' : ''}`).join('<br>')
    : '<span class="todo">—</span>';
}
/* ------------------------------------------------------------------ purchase orders — the fencing subhire
   Andrew Fisher, 12 Sep 2026: purchase orders for the job run week 6 to week 1, then Event week and Demob; he holds
   the numbers from week 6 down, for ZINC001 Advanced Temporary Fencing on branch STPS — "subhired fencing by the
   looks of it … somewhere for an invoice no too … this needs to align with what the fencing data plate is doing".
   So each order sits against the week its period names, beside what the crew billed on that week's dockets; the
   invoice number is typed on the order; an invoice with an amount is a cost line that names the order. The pairing
   of number to period is in the order he listed them and is marked so until a person confirms it. */
/* the schedule weeks an order's period covers: one construction or event week; "Demob" is every demob week,
   because Andrew named demob as one period and the programme splits it into three */
function poWeeksOf(o){
  if (!o.programme_sheet) return [];
  if (/^DECON/i.test(o.programme_sheet) || /demob/i.test(o.period || '')) return (DATA.weeks || []).filter(w => w.phase === 'Demob');
  return (DATA.weeks || []).filter(w => { const ps = progSheetOf(w.sheet); return ps && ps.sheet === o.programme_sheet; });
}
function poCard(byWeek){
  const pos = poAll();
  const sup = PO_SRC.supplier || {};
  if (!pos.length && !sup.code) return '';
  const periods = PO_SRC.periods_as_described || [];
  const confirmed = pos.filter(o => o.confirmed).length, invoiced = pos.filter(o => o.invoice_no || poCostLines(o.number).length).length;
  const row = o => { const ws = poWeeksOf(o); const w = ws[0] || null; const wks = ws.map(x => byWeek.find(y => y.week === x.sheet)).filter(Boolean);
    const wk = wks.length ? {dockets: wks.reduce((n, x) => n + x.dockets, 0), cost: wks.reduce((n, x) => n + x.cost, 0)} : null;
    const inv = poCostLines(o.number); const invAmt = inv.filter(c => c.usable).reduce((s, c) => s + (c.amount || 0), 0);
    return `<tr class="${o.confirmed ? 'done' : ''}">
      <td><b class="mono">${esc(o.number)}</b>${o._local && !o._src ? '<br><span class="chip act">added here</span>' : ''}</td>
      <td><select data-po-period="${esc(o.number)}" aria-label="period for PO ${esc(o.number)}">${periods.map(pd => `<option value="${esc(pd)}"${o.period === pd ? ' selected' : ''}>${esc(pd)}</option>`).join('')}${o.period && !periods.includes(o.period) ? `<option value="${esc(o.period)}" selected>${esc(o.period)}</option>` : ''}</select>
        <div class="w" style="font-size:11px;color:var(--mute)">${o.confirmed ? `confirmed by ${esc(o.updated_by || o.by || 'a person')}${o.updated_at ? ' · ' + esc(fmtStamp(o.updated_at)) : ''}` : esc(o._pairing || 'to confirm')}</div></td>
      <td>${w ? `<b>${esc(ws.length > 1 ? ws[0].sheet.replace(/\s*\d+$/, '') + ' weeks ' + ws[0].sheet.replace(/^\D+/, '') + '–' + ws[ws.length - 1].sheet.replace(/^\D+/, '') : w.sheet)}</b><br><span class="w" style="font-size:11px;color:var(--mute)">${esc(fmtDay(w.start).dm)} → ${esc(fmtDay(ws[ws.length - 1].end).dm)}</span>` : '<span class="todo">no schedule week matches</span>'}</td>
      <td class="num">${wk ? `${wk.dockets}<br><span class="w" style="font-size:11px;color:var(--mute)">${esc(money0(wk.cost) || '—')} derived</span>` : '—'}</td>
      <td><input data-po-inv="${esc(o.number)}" value="${esc(o.invoice_no || '')}" placeholder="invoice no." aria-label="invoice number for PO ${esc(o.number)}" style="max-width:130px">
        ${inv.length ? `<div class="w" style="font-size:11px;color:var(--mute)">${inv.length} cost line${inv.length === 1 ? '' : 's'} · ${esc(money0(invAmt) || '$0')}</div>` : ''}</td>
      <td class="num"><input data-po-amt="${esc(o.number)}" type="number" min="0" step="0.01" inputmode="decimal" value="${o.amount != null ? esc(o.amount) : ''}" placeholder="PO value" aria-label="value of PO ${esc(o.number)}" style="max-width:110px"></td>
      <td><div class="acts"><button class="btn" data-po-save="${esc(o.number)}">${o.confirmed ? 'Save' : 'Confirm'}</button></div></td></tr>`; };
  return `<div class="card">
    <div class="hubtitle"><h3>Purchase orders <span class="chip ref">${pos.length}</span></h3>
      <span class="w" style="font-size:12px;color:var(--mute)">${confirmed} of ${pos.length} pairings confirmed · ${invoiced} with an invoice</span></div>
    <p class="sub">${sup.name ? `<b>${esc(sup.name)}</b> (supplier code <span class="mono">${esc(sup.code || '—')}</span>) on branch <b class="mono">${esc(sup.branch_code || '—')}</b>${sup.kind ? ' — ' + esc(sup.kind) : ''}. ` : ''}${esc(PO_SRC.periods_basis || '')} ${esc(PO_SRC.pairing_basis || '')}</p>
    <div class="tblwrap"><table><thead><tr><th>PO</th><th>Period</th><th>Schedule week</th><th class="num">Dockets that week</th><th>Invoice</th><th class="num">Value</th><th></th></tr></thead>
      <tbody>${pos.map(row).join('')}</tbody></table></div>
    <div class="form" style="margin-top:10px"><div class="row2">
      <div class="f"><label for="poNew">Add a purchase order</label><input id="poNew" inputmode="numeric" placeholder="the PO number, 4 to 12 digits"></div>
      <div style="align-self:end"><button class="btn" id="poAdd">Add</button></div></div></div>
    <p class="norate">A purchase order is a Coates commercial reference; nothing here says what an order is worth until a person types it. The week's dockets are priced at the
      2026 card and shown beside the order — what Coates charges the V8s for that week's fencing. The order's own value and invoice number, typed here, are what Coates pays ${esc(sup.name || 'the fencing contractor')} (a fencing purchase order is what Coates pays Advanced — Andrew Fisher, 23 Sep 2026); they stay on the order and are not on the Costs tab, where every figure is a charge.</p>
  </div>`;
}
function wirePoCard(pane){
  const val = sel => { const el = pane.querySelector(sel); return el ? el.value.trim() : ''; };
  pane.querySelectorAll('[data-po-save]').forEach(b => b.onclick = () => { const no = b.dataset.poSave;
    const period = val(`[data-po-period="${no}"]`), inv = val(`[data-po-inv="${no}"]`), amt = val(`[data-po-amt="${no}"]`);
    if (amt && !(Number.isFinite(Number(amt)) && Number(amt) >= 0)) { flash('The PO value is not a number.'); return; }
    const o = poOf(no) || {};
    const sheet = (PO_SRC.orders || []).find(x => x.period === period); 
    if (setPo(no, {period, programme_sheet: sheet ? sheet.programme_sheet : (o.programme_sheet || null), invoice_no: inv || null, amount: amt === '' ? null : Number(amt), confirmed: true,
                   supplier_code: o.supplier_code || (PO_SRC.supplier || {}).code || null, supplier_name: o.supplier_name || (PO_SRC.supplier || {}).name || null, branch: o.branch || normBranch((PO_SRC.supplier || {}).branch_code || '')})) { bump(); flash(`PO ${no} saved — ${period}${inv ? ', invoice ' + inv : ''}.`); } });
  const add = pane.querySelector('#poAdd'); if (add) add.onclick = () => { const no = val('#poNew').replace(/\D/g, '');
    if (!/^\d{4,12}$/.test(no)) { flash('A purchase order number is 4 to 12 digits.'); return; }
    if (poOf(no)) { flash('PO ' + no + ' is already listed.'); return; }
    const sup = PO_SRC.supplier || {};
    if (setPo(no, {supplier_code: sup.code || null, supplier_name: sup.name || null, branch: normBranch(sup.branch_code || ''), period: null, confirmed: false})) { bump(); flash('PO ' + no + ' added — set its period and confirm.'); } };
}
/* v5.60 — RACE WEEKEND, FOR THE PEOPLE ON THE FENCE. Andrew Fisher, 19 Sep 2026: the gate closures go in here too,
   so the fencing crew know the areas closed over the race weekend. He sent a photograph of
   iEDM's master layout with the closure windows and the closure order written on it in his own hand.

   Three things this card will not do. It will not round his times — 5.53pm is copied as 5.53pm, because an
   odd-looking time is far more likely to be a real session time than a slip. It will not say what the colours
   mean, because the photograph does not. And it will not let anybody forget that the sheet underneath the
   handwriting is the 2019 master layout: the times are this year's, the gates printed under them are last
   year's arrangement, and a gate is worth checking against the 2026 drawings before somebody is sent to it. */
const CLO = DATA.closures || null;
function closureDayRows(){
  return (CLO.windows_as_written || []).map(w => {
    const iso = w.date || null, today = iso && iso === todayIso();
    return `<tr${today ? ' class="on"' : ''}><td><b>${esc(w.day)}</b>${iso ? `<br><span class="w" style="font-size:11px;color:var(--mute)">${esc(fmtDate(iso))}</span>` : ''}${
      today ? ' <span class="chip act">today</span>' : ''}</td>
      <td>${(w.windows || []).map(x => `<b class="clowin">${esc(x)}</b>`).join(' <span class="w">and</span> ')}</td></tr>`;
  }).join('');
}
function closureCard(){
  if (!CLO || !(CLO.marks || []).length) return '';
  const bd = CLO.base_drawing || {};
  const byOrder = new Map();
  (CLO.marks || []).forEach(m => { const k = m.order; if (!byOrder.has(k)) byOrder.set(k, []); byOrder.get(k).push(m); });
  const orders = [...byOrder.keys()].sort((a, b) => a - b);
  return `<div class="card clocard">
    <div class="hubtitle"><h3>Race weekend — what closes, in what order</h3>
      <span class="w" style="font-size:12px;color:var(--mute)">${CLO.received ? esc(CLO.received) : ''}</span></div>
    <p class="sub">${esc(CLO.for_whom || '')}. Times and order are written by hand on the plan; everything here is copied as written.</p>

    <div class="tblwrap"><table class="clotbl"><thead><tr><th>Day</th><th>Closed</th></tr></thead><tbody>${closureDayRows()}</tbody></table></div>
    <p class="norate">${esc(CLO.windows_note || '')}</p>

    <div class="sect">The order it closes in</div>
    <p class="hint" style="margin:0 0 8px">${esc(CLO.order_basis || '')} ${esc(CLO.colour_basis || '')}</p>
    <ol class="clolist">${orders.map(o => `<li><span class="cloord">${esc(String(o))}</span>
      <span class="clowhere">${byOrder.get(o).map(m => `<span class="clomark"><i class="clodot clo-${esc(m.colour)}" aria-hidden="true"></i>${esc(m.colour)} — ${esc(m.where_as_read)}</span>`).join('')}</span></li>`).join('')}</ol>
    <p class="norate">${esc(CLO.marks_note || '')}</p>

    ${CLO.plate ? `<div class="sect">The plan as it was marked</div>
      <figure class="cloplate"><img src="${esc(CLO.plate)}" alt="iEDM master layout ${esc(bd.drawing_no || '')} with the race-weekend closure times and closure order written on it by hand" loading="lazy" data-dphopen="${esc(CLO.plate)}">
      <figcaption>${esc(bd.title || 'Master layout')} · ${esc(bd.drawing_no || '')}${bd.project_no ? ' · project ' + esc(bd.project_no) : ''}${bd.revision ? ' · rev ' + esc(bd.revision) : ''}${bd.issued_by ? ' · ' + esc(bd.issued_by) : ''}. Tap to open it full size.</figcaption></figure>` : ''}

    <div class="notice warn"><b>The sheet under the handwriting is ${esc(bd.drawn_for || 'an earlier year')}.</b>${esc(bd.caveat || '')}</div>
    ${(CLO.open_questions || []).length ? `<p class="norate"><b>Not on the photograph, so not answered here:</b> ${CLO.open_questions.map(esc).join(' · ')}</p>` : ''}
  </div>`;
}
/* ------------------------------------------------------------------ pre-starts
   Andrew Fisher, 22 Sep 2026: a page called Prestarts in two parts — Coates installs pre-starts and Advanced
   Temporary Fencing pre-starts — with the option to load and upload, each dated by its day.

   Two crews, two lists, each one a day at a time and newest first. A pre-start belongs to a DAY and to a
   CREW, and both are carried in the document's own title — "Pre-start · Coates Installs · 2026-09-14" — so
   nothing here depends on a new kind of file existing on the service. That matters: the service files under a
   fixed list of kinds, adding one is a change to the service itself, and this page works today without it.
   Where a title says nothing, the FILE NAME is read the same way, so a page dropped in from the package or
   named by hand on somebody's laptop still lands on its own day.

   What is NOT done here: nothing is invented about who attended or what was covered. This page lists, dates
   and opens the documents. What is inside one of them is whatever was signed on the day. */
/* ATF needs a non-letter each side rather than a word boundary: a file name reads ..._ATF_14-18Sep2026, and
   an underscore beside a letter is not a boundary, so \bATF\b missed the very files this page exists for.
   The non-letter test also keeps PLATFORM and the like out of the fencing crew's list. */
const PRE_IS_FENCING = /fenc|(?:^|[^A-Za-z])ATF(?![A-Za-z])|advanced temporary/i;
const PRESTART_CREWS = [
  {key: 'coates', label: 'Coates Installs', what: 'buildings, toilets, loads and plant — the install crew',
   is: s => !PRE_IS_FENCING.test(s)},
  {key: 'fencing', label: 'Advanced Temporary Fencing', what: 'the fence line, crowd control barriers and gates',
   is: s => PRE_IS_FENCING.test(s)},
,
];
/* v5.67 — THE DOCUMENT THE PRE-START RUNS OFF. Andrew Fisher, 22 Sep 2026: the SWMS belongs in here too. A
   pre-start is not a standalone thing; it is the daily reading of a SWMS, and the crew who
   have to follow it should not have to go and find it on another page. So each crew's section carries the
   SWMS it works to, opened from the same place \u2014 Advanced's own for the fencing crew, because a
   subcontractor works to theirs, and Coates's for the install crew. */
const PRESTART_SWMS = {
  fencing: {match: /advanced temporary fencing swms|installation.{0,30}relocation.{0,30}removal/i,
            say: 'Installation, relocation and removal of temporary fencing \u2014 revision 18/09/2026',
            who: 'Advanced Temporary Fencing\u2019s own. Everything in Hazards and Controls on the pre-start comes off it.'},
  coates:  {match: /portable buildings and toilets/i,
            say: 'Portable buildings and toilets \u2014 SWMS',
            who: 'The Coates SWMS the install crew work to.'},
};
function prestartSwmsFor(crew){
  const m = PRESTART_SWMS[crew]; if (!m) return null;
  const hit = ((DATA.docs || {}).docs || []).find(d => d.kind === 'swms'
    && m.match.test([d.title, d.name, d.file].filter(Boolean).join(' ')));
  if (!hit) return null;
  return {say: m.say, who: m.who, href: docHref(hit), title: hit.title || hit.name || hit.id};
}
const PRE_MONTHS = {jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12};
/* the day a pre-start is for, read out of its title or its file name. One day, or a range where a file covers
   a week — a week's pre-starts bound into one document is how they actually come off the printer. */
function prestartDates(text){
  const s = String(text || '');
  const iso = s.match(/(20\d\d)[-_.\/](\d{1,2})[-_.\/](\d{1,2})/);
  const pad = (y, m, d) => y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0');
  if (iso) { const one = pad(iso[1], iso[2], iso[3]); return {from: one, to: one}; }
  const au = s.match(/\b(\d{1,2})[-_.\/](\d{1,2})[-_.\/](20\d\d)\b/);
  if (au) { const one = pad(au[3], au[2], au[1]); return {from: one, to: one}; }
  /* no \b in front: a file name reads ATF_14-18Sep2026, and an underscore beside a digit is not a boundary */
  const range = s.match(/(\d{1,2})\s*[-–]\s*(\d{1,2})\s*([A-Za-z]{3})[a-z]*\s*(20\d\d)/);
  if (range) { const m = PRE_MONTHS[range[3].toLowerCase()];
    if (m) return {from: pad(range[4], m, range[1]), to: pad(range[4], m, range[2])}; }
  const one = s.match(/(\d{1,2})\s*([A-Za-z]{3})[a-z]*\s*(20\d\d)/);
  if (one) { const m = PRE_MONTHS[one[2].toLowerCase()];
    if (m) { const d = pad(one[3], m, one[1]); return {from: d, to: d}; } }
  return null;
}
function isPrestartText(s){ return /pre[\s._-]?start/i.test(String(s || '')); }
/* every pre-start the page can see: the ones the package was built with, and the ones uploaded to the service */
function prestartsAll(){
  const out = [];
  ((DATA.docs || {}).docs || []).forEach(d => {
    const text = [d.title, d.name, d.file].filter(Boolean).join(' ');
    if (!isPrestartText(text)) return;
    out.push({id: d.id, title: d.title || d.name || d.id, text: text, from: 'package',
              href: docHref(d), dates: prestartDates(text), by: null, at: null, doc: d});
  });
  const idx = photoIndex();
  if (idx.state === 'ready' && idx.files) {
    Object.values(idx.files).forEach(f => {
      const text = [f.title, f.name].filter(Boolean).join(' ');
      if (!isPrestartText(text)) return;
      if (out.some(x => x.id === f.id)) return;
      out.push({id: f.id, title: f.title || f.name || f.id, text: text, from: 'service',
                href: SYNC.backend && SYNC.backend.fileUrl ? SYNC.backend.fileUrl(f.id) : null,
                dates: prestartDates(text), by: f.by || null, at: f.uploaded || null, doc: null});
    });
  }
  /* v5.67 — ONE ROW A DAY, NOT TWO. Andrew Fisher, 22 Sep 2026: it had doubled up. Every day was listed
     twice — once as the copy built into the package and once as the same document after he uploaded it. They
     are the same pre-start; the ids differ only because the service gives an uploaded file an id of its own,
     so matching on id could never have caught it. A pre-start is identified by its CREW and its DAY, which is
     what a person means by "the Monday one", so that is the key. The uploaded copy wins, because it is the one
     everybody on a view link can open; the package copy is remembered on it so the row can still say the
     package carries it too. */
  const key = p => {
    const c = PRESTART_CREWS.find(x => x.is(p.text));
    const d = p.dates ? p.dates.from + '..' + p.dates.to : (isPrestartMaster(p) ? 'master' : null);
    return d ? (c ? c.key : '?') + '|' + d : null;
  };
  const seen = {}, merged = [];
  out.forEach(p => {
    const k = key(p);
    if (!k) { merged.push(p); return; }
    const had = seen[k];
    if (!had) { seen[k] = p; merged.push(p); return; }
    /* the service copy is the one that opens for everybody; keep it and note the other */
    if (p.from === 'service' && had.from === 'package') {
      p.alsoInPackage = true;
      merged[merged.indexOf(had)] = p;
      seen[k] = p;
    } else if (p.from === 'package' && had.from === 'service') {
      had.alsoInPackage = true;
    }
  });
  return merged;
}
/* v5.67 — THE MASTER IS NOT A DAY. Andrew Fisher, 22 Sep 2026 asked for a master with the day taken out of
   it, so it carries no date and must not sit in the dated list looking like a record nobody dated. It is the
   blank the crew fill in on the morning, so it goes at the top, said as what it is. */
function isPrestartMaster(p){ return /master/i.test(String(p && p.text || '')); }
function prestartsFor(crew, withMaster){
  const c = PRESTART_CREWS.find(x => x.key === crew);
  return prestartsAll().filter(p => c.is(p.text) && (withMaster || !isPrestartMaster(p)))
    .sort((a, b) => String((b.dates || {}).from || '').localeCompare(String((a.dates || {}).from || ''))
                 || String(b.at || '').localeCompare(String(a.at || '')));
}
function prestartMasterFor(crew){
  const c = PRESTART_CREWS.find(x => x.key === crew);
  return prestartsAll().find(p => c.is(p.text) && isPrestartMaster(p)) || null;
}
/* fmtDay hands back {dow, dm} for the tables elsewhere; a pre-start wants it as words with the year on it,
   because these are filed and read months later and "Mon 14 Sep" on its own is not a date in a record. */
function preDayWords(iso){
  const f = fmtDay(iso), y = String(iso).slice(0, 4);
  return f.dow ? `${f.dow} ${f.dm} ${y}` : String(iso);
}
function prestartWhen(p){
  const d = p.dates;
  if (!d) return '<span class="todo" title="A pre-start is filed against a day by the date in its title or its file name. This one carries none, so it sits here undated.">not dated</span>';
  if (d.from === d.to) return esc(preDayWords(d.from));
  return esc(preDayWords(d.from)) + '<span class="w"> to ' + esc(preDayWords(d.to)) + '</span>';
}
function prestartRow(p){
  const open = p.href;
  return `<li class="prerow">
    <span class="preday">${prestartWhen(p)}</span>
    <span class="pretitle">${open ? `<a href="${esc(open)}" target="_blank" rel="noopener">${esc(p.title)}</a>` : esc(p.title)}
      <span class="w">${p.from === 'package' ? 'built with this package' : 'uploaded to the shared record'}${
        p.by ? ' · ' + esc(p.by) : ''}${p.at ? ' · ' + esc(fmtStamp(p.at)) : ''}${
        p.alsoInPackage ? ' · also built with this package' : ''}</span></span>
    <span class="preopen">${open ? `<a class="btn tiny" href="${esc(open)}" target="_blank" rel="noopener">Open</a>`
      : '<span class="todo">not on the service yet</span>'}</span></li>`;
}
/* ------------------------------------------------------------------ The Coates Way
   Andrew Fisher, 22 Sep 2026, with The Coates Way presented to the CMG in June 2026: it matters to the business —
   the business works off the cog, everyone working as one team — and it belongs in this page and in how we
   work.

   THIS IS NOT A POSTER OF THE COG. A page that reprints the model teaches nobody anything they could not read
   on the card. What this does is lay THIS JOB against the cog, ring by ring, out of numbers the record already
   holds — because the page was most of the way there before anyone called it this. The delivery light is a RAG
   scorecard. Overdue, variances and breakdowns are Operations. On hire against on site is Assets. Charged
   against paid is Financials. The crews and their pre-starts are People. Today is the daily cadence and Where
   we are the weekly one.

   AND IT SAYS WHERE IT CANNOT ANSWER. Four of the eight KPI targets — return on capital, EBIT margin, NPS and
   employee engagement — are measures of the business, not of one job, and this record cannot speak to them. A
   number against those would be invented, so there is none: the target is shown as Coates's target and the
   page says plainly that this record does not measure it. The same goes for recordable injuries: this record
   holds equipment breakdowns, not injury records, and "none recorded here" is not the same statement as "zero
   injuries", so only the first is made. Four honest readings beat eight with half of them made up. */
/* ---------------------------------------------------------------- THE COG THAT TURNED, AND WENT
   v5.69 drew a 4:1 gear train here — six 14-tooth drivers round a 56-tooth wheel, real meshing, a WebGL2 canvas
   of its own. Andrew Fisher, 23 Sep 2026, with a picture of it, asked for another picture in its place.
   The whole of that code went with it (nothing is kept switched off), and its place is taken by the
   machine itself — the still below, and the machine that opens from it. */

const CW_VALUES = [
  ['Care Deeply', 'Safety and wellbeing first, always'],
  ['Customer Focused', 'Listen, anticipate, exceed expectations'],
  ['Be Our Best', 'Accountability, learning, determination'],
  ['One Team', 'Collaborative, trusted, inclusive'],
  ['Competitive Spirit', 'Set stretch goals, be THE best'],
];
const CW_DISCIPLINES = [
  ['Safety First', 'Every job, every load, every person is safe. Stop tasks when something is not right.'],
  ['Customer Centric', 'Keep the customer at the centre. Own issues until resolved. Sell value, not price.'],
  ['Pace', 'Resolve issues within hours. Quotes out same day — speed wins in hire.'],
  ['Open to Feedback', "Ask what we could do better. Listen, acknowledge and act, even when it is uncomfortable."],
  ['Reduce Friction', 'Make it easy to do business with Coates and with each other. Flag workarounds, do not normalise them.'],
  ['Cadence', 'Meetings on schedule and structured. Actions tracked and closed out.'],
];
const CW_TRAITS = [
  ['Customer Solutions', 'The right combination of equipment, expertise and specialist services, delivered safely and efficiently.'],
  ['Targeted Growth', 'Deliberate focus where Coates can lead and grow; invest where the returns justify it.'],
  ['Performance-led Results', 'Measure what matters and act when performance is off track — why, who owns it, what fixes it.'],
  ['Operational Excellence', 'Every stage of the hire cycle executed to a standard every customer can expect.'],
  ['Resilient Processes', 'Standardised, documented, followed. When a process does not work we fix it — we do not work around it.'],
  ['Customer-led Innovation', 'Data, tools and frontline feedback solving real problems. Innovation starts with a customer problem.'],
  ['Ease of Doing Business', 'One interaction delivers what is needed. Handovers clean, systems working, no friction.'],
];
/* Coates's eight, as the card states them. `here` is what THIS record can honestly show against one, or null
   where it cannot — and where it is null the page says so rather than reaching for something that looks close. */
function cwTargets(){
  const P = progressAsOf(todayIso());
  const all = P.all;
  const bdOpen = allBreakdowns().filter(b => b.open);
  const onSite = all.onsite, due = all.due;
  const pct = (n, d) => d > 0 ? Math.round(n / d * 1000) / 10 : null;
  const out = [];
  if (onSite) out.push({n: '15', unit: '%', what: 'Redline — fleet unavailable', why: 'Daily management discipline.',
    here: pct(bdOpen.length, onSite), good: v => v !== null && v < 15,
    says: `${fmtNum(bdOpen.length)} open breakdown${bdOpen.length === 1 ? '' : 's'} against ${fmtNum(onSite)} reference${onSite === 1 ? '' : 's'} on site. A job-level reading, not the fleet redline.`});
  if (due) out.push({n: '65', unit: '%', what: 'Fleet time utilisation', why: 'Fleet matched to demand.',
    here: pct(onSite, due), good: v => v !== null && v >= 65,
    says: `${fmtNum(onSite)} of ${fmtNum(due)} reference${due === 1 ? '' : 's'} due by today are on site. Delivery against plan on one job, not fleet utilisation.`});
  return out;
}
/* The third ring asks four things of anything that is red: a root cause, a corrective action, an owner and a
   deadline. This gathers every red thing on the job into that shape and, where one of the four is missing,
   says which — because a red with no owner is the thing the model exists to stop. */
function cwReds(){
  const out = [];
  allBreakdowns().filter(b => b.open).forEach(b => out.push({
    what: `Breakdown — ${esc(b.ref || 'unreferenced')}${b.severity ? ' · ' + esc(b.severity) : ''}`,
    cause: b.fault || b.what || null, action: b.action || b.fix || null,
    owner: b.by || b.reported_by || null, when: b.due || null,
    pillar: 'Operations', go: () => { state.tab = 'breakdowns'; render(); }}));
  allVariances().filter(v => v.authority_state === 'unattributed').forEach(v => out.push({
    what: `Variance with no authority — ${esc(v.ref || v.key || 'unreferenced')}`,
    cause: v.why || v.note || null, action: null,
    owner: null, when: null,
    pillar: 'Financials', go: () => { state.tab = 'variances'; render(); }}));
  const P = progressAsOf(todayIso());
  if (P.all.overdue) out.push({
    what: `${fmtNum(P.all.overdue)} reference${P.all.overdue === 1 ? '' : 's'} overdue against the programme`,
    cause: 'Due by today with nothing recorded on site.', action: null,
    owner: null, when: null, pillar: 'Operations', go: () => { state.tab = 'progress'; render(); }});
  if (fenceQuote()) {
    const over = quoteWatch(allDockets()).filter(w => w.state === 'over quote');
    over.forEach(w => out.push({
      what: `Fencing over quote — ${esc(w.column || w.name || '')}`,
      cause: `${fmtNum(Math.round(w.done || 0))} against ${fmtNum(Math.round(w.quoted || 0))} quoted.`,
      action: null, owner: null, when: null, pillar: 'Financials',
      go: () => { state.tab = 'fencing'; render(); }}));
  }
  return out;
}
function cwPillars(){
  const P = progressAsOf(todayIso()), all = P.all;
  const t = lightTally(allAssets());
  const dockets = allDockets(), usable = dockets.filter(d => d.usable);
  const crew = crewCount();
  return [
    {k: 'P', name: 'People', line: 'Our people are the foundation of everything we deliver.',
     rows: [['On this job', `${fmtNum(crew.total)} named — ${fmtNum(crew.coates)} Coates, ${fmtNum(crew.fencing)} Advanced Temporary Fencing`],
            ['Pre-starts on the record', `${fmtNum(prestartsAll().length)} document${prestartsAll().length === 1 ? '' : 's'}, dated and open to read`],
            ['Crews on the record', `${fmtNum(prestartsFor('coates').length)} Coates · ${fmtNum(prestartsFor('fencing').length)} Advanced Temporary Fencing`]],
     go: 'prestarts'},
    {k: 'O', name: 'Operations', line: 'How we execute the hire cycle — safely, reliably, consistently.',
     rows: [['Due by today', `${fmtNum(all.due)} · ${fmtNum(all.onsite)} on site, ${fmtNum(all.overdue)} overdue, ${fmtNum(all.norecord)} nothing recorded`],
            ['Delivery light', `${fmtNum(t.green)} green · ${fmtNum(t.amber)} amber · ${fmtNum(t.red)} red · ${fmtNum(t.none)} not recorded`],
            ['Breakdowns open', `${fmtNum(allBreakdowns().filter(b => b.open).length)} of ${fmtNum(allBreakdowns().length)} recorded`]],
     go: 'progress'},
    {k: 'A', name: 'Assets', line: 'Our fleet is our business — every asset must earn its return.',
     rows: [['References on the job', `${fmtNum(allAssets().filter(a => !a._cancelled).length)} live · ${fmtNum(allAssets().filter(a => a._cancelled).length)} cancelled`],
            ['On site now', `${fmtNum(all.onsite)} of ${fmtNum(all.due)} due by today`],
            ['Off site again', `${fmtNum(all.off)} · ${fmtNum(all.out_overdue)} past their off-hire date`]],
     go: 'register'},
    {k: 'F', name: 'Financials', line: 'Disciplined financial performance that funds the flywheel.',
     rows: [['Fencing charged, 2026 card', usable.length ? money(usable.reduce((a, d) => a + d.cost_total, 0)) : 'nothing priced yet'],
            ['Dockets signed', `${fmtNum(dockets.length)} · ${fmtNum(usable.length)} priced`],
            ['Variances with no authority', `${fmtNum(allVariances().filter(v => v.authority_state === 'unattributed').length)}`]],
     go: 'costs'},
  ];
}
function crewCount(){
  const people = (DATA.team || {}).people || [];
  const fencing = people.filter(p => p.group === 'fencing').length;
  return {total: people.length, fencing: fencing, coates: people.length - fencing - people.filter(p => p.group === 'other').length};
}
function renderCoatesWay(){
  const T = cwTargets(), reds = cwReds(), pillars = cwPillars();
  const missing = r => [!r.cause && 'a root cause', !r.action && 'a corrective action', !r.owner && 'an owner',
                        !r.when && 'a deadline'].filter(Boolean);
  $('#pane-coatesway').innerHTML = paneHeadingHtml('coatesway') + `
  <p class="maphint"><b>This job, laid against the cog.</b> Not a copy of the model — the record's own numbers
    arranged the way The Coates Way arranges them, from Best Service &amp; Value at the centre out to the
    behaviours at the teeth. A measure this record cannot answer is left out, not estimated.</p>

  ${machineCardHtml()}

  <div class="card cwc"><h3>The centre — Best Service &amp; Value</h3>
    <p class="sub">The targets of Coates's eight that this job's own record can read.</p>
    ${T.length ? `<div class="cwk">${T.map(k => {
      const ok = k.good && k.good(k.here);
      return `<div class="cwkpi${ok ? ' good' : ' watch'}">
        <div class="cwkn">${esc(k.n)}<small>${esc(k.unit)}</small></div>
        <div class="cwkw"><b>${esc(k.what)}</b><span>${esc(k.why)}</span></div>
        <div class="cwkh"><b class="cwkv">${esc(String(k.here))}${esc(k.unit)}</b>
          <span class="cwks">${esc(k.says)}</span></div></div>`; }).join('')}</div>`
      : '<div class="notice"><b>Nothing due yet</b>Neither reading can be taken until references are due against the programme.</div>'}
    <p class="norate">The other six — zero recordable injuries, ROCE, EBIT margin, sales win rate, NPS and
      employee engagement — belong to the business and to the safety system. This record does not hold them,
      so they are not shown here rather than shown empty.</p>
  </div>

  <div class="card cwc"><h3>The second ring — People, Operations, Assets, Financials</h3>
    <p class="sub">The four pillars, on this job. They only work together — a green Operations column on the back of an unpriced Financials one is not a job going well.</p>
    <div class="cwp">${pillars.map(p => `<div class="cwpill" data-cwgo="${esc(p.go)}" role="button" tabindex="0">
      <div class="cwph"><span class="cwpk">${esc(p.k)}</span><b>${esc(p.name)}</b></div>
      <p class="cwpl">${esc(p.line)}</p>
      <table class="cwpt"><tbody>${p.rows.map(r => `<tr><td>${esc(r[0])}</td><td><b>${esc(r[1])}</b></td></tr>`).join('')}</tbody></table>
    </div>`).join('')}</div>
  </div>

  <div class="card cwc"><h3>The third ring — the scorecard, and what is red</h3>
    <p class="sub">Red needs a documented root cause, a corrective action, an owner and a deadline. Here is everything red on this job, in that shape — and where one of the four is missing, it says which.</p>
    ${reds.length ? `<table class="cwred"><thead><tr><th>What</th><th>Pillar</th><th>Root cause</th><th>Action</th><th>Owner</th><th>By when</th></tr></thead>
      <tbody>${reds.map((r, i) => {
        const gaps = missing(r);
        return `<tr data-cwred="${i}"><td><b>${r.what}</b>${gaps.length ? `<br><span class="cwgap">missing ${esc(gaps.join(', '))}</span>` : ''}</td>
          <td data-l="Pillar">${esc(r.pillar)}</td>
          <td data-l="Root cause">${r.cause ? esc(r.cause) : '<span class="todo">not recorded</span>'}</td>
          <td data-l="Action">${r.action ? esc(r.action) : '<span class="todo">not recorded</span>'}</td>
          <td data-l="Owner">${r.owner ? esc(r.owner) : '<span class="todo">nobody named</span>'}</td>
          <td data-l="By when">${r.when ? esc(fmtDay(r.when).dm) : '<span class="todo">no date</span>'}</td></tr>`; }).join('')}</tbody></table>`
      : '<div class="notice"><b>Nothing is red on this job today</b>No open breakdown, no overdue reference, no variance without authority and no fencing line over its quote. That is the scorecard saying green, not the page saying nothing.</div>'}
    <p class="norate">Cadence: <b>Today</b> is the daily review, <b>Where we are</b> the weekly one. A red that stays red is the one that escalates.</p>
  </div>

  <div class="card cwc"><h3>The fourth ring — the seven traits</h3>
    <p class="sub">The teeth of the cog. Without them it does not turn.</p>
    <div class="cwt">${CW_TRAITS.map((t, i) => `<div class="cwtrait"><span class="cwtn">${String(i + 1).padStart(2, '0')}</span>
      <div><b>${esc(t[0])}</b><span>${esc(t[1])}</span></div></div>`).join('')}</div>
  </div>

  <div class="card cwc" id="cwdisc"><h3>How we show up — the six disciplines</h3>
    <div class="cwt cwt6">${CW_DISCIPLINES.map((d, i) => `<div class="cwtrait"><span class="cwtn cwdn">${i + 1}</span>
      <div><b>${esc(d[0])}</b><span>${esc(d[1])}</span></div></div>`).join('')}</div>
    <h4 class="cwvh">Our values</h4>
    <div class="cwv">${CW_VALUES.map(v => `<div class="cwval"><b>${esc(v[0])}</b><span>${esc(v[1])}</span></div>`).join('')}</div>
    <p class="norate">The Coates Way, presented to the CMG in June 2026. The words in this section are Coates's own; everything above them is this job's record.</p>
  </div>`;
  const pane = $('#pane-coatesway');
  pane.querySelectorAll('[data-cwgo]').forEach(b => {
    const go2 = () => { state.tab = b.dataset.cwgo; render(); };
    b.onclick = go2;
    b.onkeydown = ev => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); go2(); } };
  });
  pane.querySelectorAll('[data-cwred]').forEach(tr => { const r = reds[Number(tr.dataset.cwred)];
    if (r && r.go) { tr.style.cursor = 'pointer'; tr.onclick = r.go; } });
  machineCardWire();
}

/* ---------------------------------------------------------------- THE MACHINE, INSIDE THE PAGE (v5.77)
   Andrew Fisher, 23 Sep 2026: it is all part of the GC500, not a separate build, and the whole thing is fully
   reachable on the view page, even with everything uploaded to Railway.

   The Coates Way · V8 Connected — the cutaway #26 car with its V8 and running gear, the cog as its steering
   wheel (v5.79; it was in the nose), 279 parts each linked to what it drives, 138 of them the machine's with a
   Coates Way link each, and the sound — is built with this page (pipeline/build_machine.py) and served by the same
   service at /w/<key>/. It opens HERE, over the page, in a frame of its own: it has its own document, its own
   styles and its own WebGL context, and a frame is the one honest way to run it inside this page without the
   two fighting over the window. The frame is made when the button is pressed and destroyed when the panel
   closes, so nothing of it — sound, GPU, timers — runs on behind the page.

   What the card says is what the service says: /api/machine is asked once when the tab is drawn, and "not on
   this service yet" is a state of its own rather than a broken button. The file edition, with no service
   behind it, says where the machine runs. Motion: Off is respected the way the showcase respects it — the
   machine opens only when a person presses the button, never on its own. */
const MACHINE = {open: false, ret: null, inert: [], onKey: null, status: null, kind: 'machine'};
/* v5.90 - every map starts the way D001 is drawn: the sheet's top bears this (the georef says 89.84°), so a map
   turned to it has the beach along the top, the way the crew reads the printed plan; the compass on each map says
   where north is */
function sheetBearing(){ const o = DATA.georef && DATA.georef.orientation; return o && Number.isFinite(o.sheet_top_bearing_deg) ? o.sheet_top_bearing_deg : 89.84; }
/* v5.90 - one press opens a page of the hosted set in the full-screen frame; the frame's own header switches between them */
/* v5.97 - folded prose opens and closes on its own "more" */
document.addEventListener('click', e => { const b = e.target.closest('[data-clamp]'); if (!b) return; const c = b.previousElementSibling; if (!c || !c.classList.contains('clamp') && !c.classList.contains('open')) return; c.classList.toggle('open'); b.textContent = c.classList.contains('open') ? 'less' : 'more'; });
document.addEventListener('click', e => { const b = e.target.closest('[data-mopen],[data-mpage]'); if (!b || b.disabled) return; const k = b.dataset.mopen || b.dataset.mpage; if (!MACHINE_PAGES[k]) return; e.preventDefault(); machineOpen(k); });
function machineHosted(){ return !!(SYNC.backend && SYNC.backend.machineUrl); }
function machineCardHtml(){
  const m = DATA.machine;
  const parts = m && m.parts ? m.parts + ' parts' : '279 parts';
  const size = m && m.bytes ? ' · ' + (m.bytes / 1e6).toFixed(0) + ' MB' : '';
  const hero = m && m.hero && m.hero.src ? m.hero : null;
  const opens = DATA.edition === 'hosted';
  return `<div class="card cwmcard" id="cwmachine">
    ${hero ? `<${opens ? 'button type="button"' : 'div'} class="cwhero${opens ? ' opens' : ''}" id="cwHero"${opens ? ' aria-label="Open the machine" disabled' : ''} style="aspect-ratio:${hero.width}/${hero.height}">
      ${hero.webm || hero.mp4 ? `<video class="cwloop" muted loop playsinline preload="metadata" width="${hero.width}" height="${hero.height}" poster="${hero.poster || hero.src}" aria-label="${esc(hero.is || 'The Coates Way cog, running, coming apart and going back together')}">${
        hero.mp4 ? `<source src="${hero.mp4}" type="video/mp4">` : ''}${hero.webm ? `<source src="${hero.webm}" type="video/webm">` : ''}</video>`
      : `<img src="${hero.src}" width="${hero.width}" height="${hero.height}" alt="The Coates Way cog as the steering wheel of the Coates #26, from the driver's seat — every word on it readable, the hall beyond the windscreen">`}   /* v6.00 - the hero is the cog's own loop; the still is its poster */
      <span class="cwherotag"><i></i>${opens ? 'THE MACHINE · OPENS HERE' : 'THE MACHINE · ON THE HOSTED PAGE'}</span>
    </${opens ? 'button' : 'div'}>` : ''}
    <h3>The machine — V8 Connected</h3>
    <div class="cwm">
      ${hero ? '' : '<div class="cwmpic" aria-hidden="true"><span>V8</span><small>CONNECTED</small></div>'}
      <div class="cwmtxt">
        <p class="sub"><b>The Coates Way sets our direction.</b> The cog is the steering wheel of the Coates #26 — in the driver's hands, on the column, its shaft to the rack: ${esc(parts)}, every one linked to what it drives, the 138 of the wheel's own each with its Coates Way link. Start the V8 on the dyno, open the cutaway, lift the wheel off its quick-release, pull it apart, put it back.</p>
        <div class="cwmact">
<button class="btn primary" id="cwOpenMachine" type="button"${DATA.edition === 'hosted' ? '' : ' hidden'}>Open the machine</button>   /* v6.01 - the plan-on-satellite and 3D-proof buttons live on the Map tab only */
          <span class="cwmst" id="cwMachineState">${DATA.edition === 'hosted' ? 'Asking the service…' : 'Part of this build' + size + '. It runs on the hosted page — open The Coates Way there.'}</span>
        </div>
      </div>
    </div>
  </div>`;
}
function machineCardWire(){
  const b = $('#cwOpenMachine'), st = $('#cwMachineState'), pic = $('#cwHero');
  if (!b || !st) return;
  b.onclick = () => machineOpen();
  if (pic && pic.tagName === 'BUTTON') pic.onclick = () => machineOpen();
  /* v6.00 - the loop plays by itself, muted, once it is on screen; it rests when the card is scrolled away, and stays on its
     poster for anyone who asked their device for reduced motion */
  const loop = pic && pic.querySelector('video.cwloop');
  if (loop) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!still) {
      const play = () => { const p = loop.play(); if (p && p.catch) p.catch(() => {}); };
      if ('IntersectionObserver' in window) new IntersectionObserver(es => es.forEach(e => e.isIntersecting ? play() : loop.pause()), {threshold: .15}).observe(loop);
      else play();
    }
  }
  b.disabled = true;
  /* the hosted page draws once before the service has answered /api/version; the tab is drawn again when it
     has, and the card is asked again then — until then the button waits and the line says so */
  if (!machineHosted()) { if (DATA.edition !== 'hosted') b.hidden = true; return; }
  SYNC.backend.machine().then(j => {
    MACHINE.status = j;
    if (!document.contains(st)) return;
    if (j && j.ready) {
      b.disabled = false; if (pic && pic.tagName === 'BUTTON') pic.disabled = false;
      const built = DATA.machine && DATA.machine.version;
      st.textContent = 'On this service: build ' + j.version + (built && built !== j.version ? ' (this page was built with ' + built + ')' : '') + ' · ' + j.files + ' files · ' + (j.bytes / 1e6).toFixed(0) + ' MB. Opens here, on this link.';
    } else {
      st.textContent = 'Part of this build, but not on this service yet — the owner imports it on the admin page from print/out/machine. Nothing else on the page is affected.';
    }
  }).catch(() => { if (document.contains(st)) st.textContent = 'The service did not answer about the machine. Try again in a moment.'; });
}
function machineFocusable(){
  const el = $('#machine'); if (!el) return [];
  return [...el.querySelectorAll('button, [href], iframe, [tabindex]:not([tabindex="-1"])')].filter(x => !x.disabled && !x.hidden && x.offsetParent !== null);
}
/* v5.90 - the one full-screen frame carries three pages of the hosted set: The Coates Way machine, the satellite plan
   explorer (D001 on real satellite, 64,000 per cent, find-on-drawing) and the 3D proof (Google photorealistic tiles
   in CesiumJS). Its header switches between them without leaving this page; each is fetched only when pressed. */
const MACHINE_PAGES = {
  machine: {name: 'The Coates Way · V8 Connected', path: '', wait: 'Loading the machine…', ref: 'no-referrer', sub: ''},
  explorer: {name: 'Satellite plan explorer', path: 'explorer/index.html', wait: 'Loading the plan explorer…', ref: 'strict-origin-when-cross-origin', sub: 'D001 rev 03 on real satellite · the plan itself, to 64,000 per cent'},
  proof3d: {name: '3D proof', path: 'poc3d/index.html', wait: 'Loading the 3D proof — Google\'s tiles are fetched now, on this press…', ref: 'strict-origin-when-cross-origin', sub: 'Google photorealistic 3D tiles in CesiumJS · billed per opening'}};
function machineFrameLoad(kind){
  const pg = MACHINE_PAGES[kind] || MACHINE_PAGES.machine, base = SYNC.backend.machineUrl();
  const url = base + pg.path + (pg.path ? '?back=' + (canEdit() ? 'e' : 'v') : '') + (kind === 'explorer' && MACHINE.find ? '&find=' + encodeURIComponent(MACHINE.find) : '');   /* v6.20 - the explorer opened on a reference */
  MACHINE.find = null;
  MACHINE.kind = kind;
  const holder = $('#machineFrame'), wait = $('#machineWait');
  holder.querySelectorAll('iframe').forEach(f => { try { f.src = 'about:blank'; } catch (e) {} f.remove(); });
  const meta = MACHINE.status && MACHINE.status.ready ? MACHINE.status : (DATA.machine || {});
  $('#machineName').textContent = pg.name;
  $('#machineBuild').textContent = kind === 'machine' ? (meta.version ? 'build ' + meta.version : '') + (meta.files ? ' · ' + meta.files + ' files' : '') : pg.sub;
  $$('#machine [data-mpage]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.mpage === kind)));
  const own = $('#machineOwn'); if (own) own.href = url;
  const f = document.createElement('iframe');
  f.title = pg.name; f.src = url; f.allow = 'fullscreen; autoplay'; f.setAttribute('allowfullscreen', '');
  f.setAttribute('referrerpolicy', pg.ref);
  wait.textContent = pg.wait; wait.hidden = false;
  f.addEventListener('load', () => { wait.hidden = true; });
  holder.appendChild(f);
}
function machineOpen(kind){
  kind = MACHINE_PAGES[kind] ? kind : 'machine';
  if (!machineHosted()) return;
  if (MACHINE.status && MACHINE.status.ready === false) { flash('That page is not on this service yet.'); return; }
  if (MACHINE.open) { if (MACHINE.kind !== kind) machineFrameLoad(kind); return; }
  MACHINE.open = true; MACHINE.ret = document.activeElement;
  const panel = $('#machine');
  machineFrameLoad(kind);
  panel.hidden = false;
  document.body.classList.add('machining');
  /* the room behind it is shut, the same way the showcase shuts it (B06) */
  MACHINE.inert = [...document.body.children].filter(el => el.id !== 'machine' && el.id !== 'flash' && el.id !== 'damaged' && el.tagName !== 'SCRIPT' && !el.hasAttribute('inert'));
  MACHINE.inert.forEach(el => { try { el.setAttribute('inert', ''); } catch (e) {} });
  try { if (!routing) { const st = history.state && typeof history.state.gc === 'number' ? history.state : {gc: 0};
    history.pushState({gc: st.gc + 1, machine: 1}, '', location.href);
    NAV.cur = location.hash; NAV.curGc = st.gc + 1; navBackShow(); } } catch (e) {}
  MACHINE.onKey = ev => {
    if (!MACHINE.open) return;
    if (ev.key === 'Escape') { ev.preventDefault(); machineClose(); return; }
    if (ev.key === 'Tab') { const list = machineFocusable(); if (!list.length) return;
      const first = list[0], last = list[list.length - 1], cur = document.activeElement;
      if (!panel.contains(cur)) { ev.preventDefault(); (ev.shiftKey ? last : first).focus(); return; }
      if (ev.shiftKey && cur === first) { ev.preventDefault(); last.focus(); return; }
      if (!ev.shiftKey && cur === last) { ev.preventDefault(); first.focus(); return; } }
  };
  document.addEventListener('keydown', MACHINE.onKey);
  const c = $('#machineClose'); if (c) c.focus();
}
function machineClose(){
  if (!MACHINE.open) return;
  MACHINE.open = false;
  const holder = $('#machineFrame'); if (holder) holder.querySelectorAll('iframe').forEach(f => { try { f.src = 'about:blank'; } catch (e) {} f.remove(); });
  const wait = $('#machineWait'); if (wait) wait.hidden = true;
  $('#machine').hidden = true;
  document.body.classList.remove('machining');
  (MACHINE.inert || []).forEach(el => { try { el.removeAttribute('inert'); } catch (e) {} }); MACHINE.inert = [];
  if (MACHINE.onKey) { document.removeEventListener('keydown', MACHINE.onKey); MACHINE.onKey = null; }
  const r = MACHINE.ret; MACHINE.ret = null;
  if (r && r.focus && document.contains(r)) try { r.focus(); } catch (e) {}
}

function renderPrestarts(){
  const hosted = !!(SYNC.backend && SYNC.backend.fileUrl);
  const canAdd = hosted && !SYNC.readonly;
  const today = todayIso();
  const card = c => {
    const rows = prestartsFor(c.key);
    const add = canAdd ? `<div class="preadd">
        <label class="f"><span>The day it was held</span><input type="date" id="preDate_${c.key}" value="${esc(today)}" max="${esc(today)}"></label>
        <label class="f"><span>The signed pre-start</span><input type="file" id="preFile_${c.key}" accept=".pdf,.jpg,.jpeg,.png,.webp,.docx"></label>
        <button class="btn primary" data-preup="${c.key}">Upload it</button>
        <p class="norate" id="preMsg_${c.key}">Goes to the shared record under that day, for ${esc(c.label)}. ${
          S.operator ? 'Recorded as ' + esc(S.operator) + '.' : 'Put your name in “Recording as” first so the upload carries it.'}</p>
      </div>` : hosted ? '<p class="norate">This link can read the record but not add to it. Open the edit link to upload a pre-start.</p>'
        : '<p class="norate">This copy has no service behind it, so pre-starts can only be read from the package folder beside it.</p>';
    /* the master leads, because it is the one somebody opens on the morning; the records follow, newest first */
    const mst = prestartMasterFor(c.key);
    const sw = prestartSwmsFor(c.key);
    const swHtml = sw ? `<div class="preswms">
        <div><b>The SWMS it runs to</b><span>${esc(sw.say)} \u00b7 ${esc(sw.who)}</span></div>
        ${sw.href ? `<a class="btn" href="${esc(sw.href)}" target="_blank" rel="noopener noreferrer">Open the SWMS</a>`
          : '<span class="todo">not uploaded yet</span>'}
      </div>` : '';
    const mstHtml = mst ? `<div class="premaster">
        <div><b>The master</b><span>Blank, with the date and the docket number to fill in. Print it as needed.</span></div>
        ${mst.href ? `<a class="btn" href="${esc(mst.href)}" target="_blank" rel="noopener noreferrer">Open the master</a>`
          : '<span class="todo">not uploaded yet</span>'}
      </div>` : '';
    return `<div class="card" id="pre-${esc(c.key)}">
      <h3>${esc(c.label)}</h3>
      <p class="sub">${esc(c.what)} · <b>${fmtNum(rows.length)}</b> ${rows.length === 1 ? 'document' : 'documents'}${
        mst ? ' · and the master' : ''}</p>
      ${swHtml}
      ${mstHtml}
      ${add}
      ${rows.length ? `<ul class="prelist">${rows.map(prestartRow).join('')}</ul>`
        : `<div class="notice"><b>Nothing here yet for ${esc(c.label)}</b>A pre-start lands on its own day as soon as it is uploaded. Name it with the day — <span class="mono">2026-09-14</span> or <span class="mono">14Sep2026</span> — or pick the day above and this page writes it into the title for you.</div>`}
    </div>`;
  };
  $('#pane-prestarts').innerHTML = paneHeadingHtml('prestarts') + `
    <p class="maphint"><b>The daily pre-start, one a day, for each crew.</b> This page lists, dates and opens
      them; what is inside one is whatever was signed on the day. A document is filed against a day by the
      date in its title or its file name — upload it here and the day you pick is written in for you.</p>
    ${PRESTART_CREWS.map(card).join('')}`;
  const pane = $('#pane-prestarts');
  pane.querySelectorAll('[data-preup]').forEach(b => b.onclick = () => prestartUpload(b.dataset.preup));
}
async function prestartUpload(crew){
  const c = PRESTART_CREWS.find(x => x.key === crew); if (!c) return;
  const msg = $('#preMsg_' + crew), inp = $('#preFile_' + crew), day = ($('#preDate_' + crew) || {}).value || '';
  const file = inp && inp.files && inp.files[0];
  const say = t => { if (msg) msg.textContent = t; };
  if (!day) return say('Pick the day it was held first.');
  if (!file) return say('Choose the signed pre-start to upload.');
  if (!(SYNC.backend && SYNC.backend.upload)) return say('There is no service behind this copy to upload to.');
  if (DOCS.uploading) return;
  DOCS.uploading = true;
  const btn = pane_btn(crew); if (btn) btn.disabled = true;
  say('Uploading ' + file.name + ' (' + fmtBytes(file.size) + ')…');
  try {
    /* the title carries the crew and the day, because that is what this page reads a pre-start's day out of.
       Filed under Pack / report, which is the kind the service already has for a document like this one. */
    const title = 'Pre-start · ' + c.label + ' · ' + day;
    const saved = await SYNC.backend.upload(file, {kind: 'pack', title: title});
    if (saved && saved.id) { DOCS.files = DOCS.files || {}; DOCS.files[saved.id] = Object.assign({title: title}, saved); }
    if (inp) inp.value = '';
    flash('Pre-start filed under ' + fmtDay(day) + ' for ' + c.label + '.');
    await docsRefresh(true);
    if (state.tab === 'prestarts') renderPrestarts();
  } catch (e) {
    say('It did not go up: ' + (e && e.message || e) + '. Check Documents before trying again.');
  } finally {
    DOCS.uploading = false;
    const b2 = pane_btn(crew); if (b2) b2.disabled = false;
  }
}
function pane_btn(crew){ return document.querySelector('[data-preup="' + crew + '"]'); }

/* v5.80 — A DOCKET RECORDED IN THIS BROWSER, without a form. The Add-a-docket card is gone from the Fencing tab
   (Andrew Fisher, 24 Sep 2026: the add-a-docket form comes out — the dockets are what Advanced write and
   what he gives the build); this is the save that card made, kept as a function so the record's own tests can
   still put a docket on the page and hold the page's pricing to the build's, to the cent. It takes the same
   fields the card took, applies the same checks, and returns the docket or null with the reason flashed. */
function recordDocket(f){
  const who = whoAmI(); if (!who) return null;
  const date = f.date;
  if (!date) { flash('A date is needed — it is what puts the docket on a day and in a week.'); return null; }
  if (!String(f.location || '').trim()) { flash('Say which area the docket covers — the crew write one per area, and that is how the work is found again.'); return null; }
  const quantities = {};
  Object.entries(f.quantities || {}).forEach(([k, v]) => { const n = Number(v); if (String(v).trim() !== '' && n > 0) quantities[k] = n; });
  if (!Object.keys(quantities).length) { flash('Put a quantity against at least one line — a docket has to say how much was done.'); return null; }
  const w = weekOf(date);
  const d = {id: nextDocketId(), date, week: w ? w.sheet : null, docket_no: String(f.docket_no || '').trim() || null,
             crew: String(f.crew || (DATA.fence_contractor || {}).name || '').trim() || null, map_ref: f.map_ref || null,
             location: String(f.location).trim() || null, quantities, note: String(f.note || '').trim() || null,
             recorded_by: who, recorded_on: todayIso()};
  S.fenceDockets = (S.fenceDockets || []).concat([d]);
  state.fenceDay = date; state.fenceWeek = d.week;
  bump();
  flash(d.id + ' saved in this browser — ' + (money(costDocket(d).cost_total) || '$0.00') + ' charged at the 2026 card, ' + (money(costDocket(d).paid_total) || '$0.00') + ' paid. Export and rebuild to put it on the record.');
  return d;
}
/* v5.83 — WHERE THE SCHEDULE'S FENCING ROWS WENT. Andrew Fisher, 25 Sep 2026: fencing had come onto the Timeline as
   though it were a delivery — take it off. The seven rows the 24 Sep 2026 workbook carries under the Fencing
   discipline (semis of fencing to Phillip Park) are held apart by the build (plant_lines.fencing_rows_not_plant) and
   are on no day, list or count. Said here, once, so they are not simply gone: the fencing is measured on this tab,
   off the crew's own dockets. */
function schedFenceNote(){
  const rows = ((DATA.plant_lines || {}).fencing_rows_not_plant) || [];
  if (!rows.length) return '';
  const ids = rows.map(r => r.task_id).filter(Boolean);
  const span = ids.length > 1 ? ids[0] + '–' + ids[ids.length - 1] : ids[0];
  return `<p class="norate">The delivery schedule also carries ${fmtNum(rows.length)} fencing run${rows.length === 1 ? '' : 's'} by semi to Phillip Park
    (${esc(span)}). They are the crew's stock moving, not deliveries, so they are on no day of the Timeline, no list and no
    count — the fencing is measured here, off the dockets (Andrew Fisher, 25 Sep 2026).</p>`;
}
function renderFencing(){
  const q = state.q.trim().toLowerCase();
  const all = allDockets();
  const hay = d => [d.id, d.date, d.week, d.docket_no, d.crew, d.map_ref, d.location, d.note, d.recorded_by,
                    d.lines.map(l => l.name).join(' ')].filter(Boolean).join(' ').toLowerCase();
  const shown = all.filter(d => !q || q.split(/\s+/).filter(Boolean).every(t => hay(d).includes(t)));
  const usable = all.filter(d => d.usable);
  const cost = Math.round(usable.reduce((s, d) => s + d.cost_total, 0) * 100) / 100;
  const local = all.filter(d => d._where === 'local').length;
  const unpriced = usable.reduce((s, d) => s + d.unpriced.length, 0);
  const sum = key => Math.round(usable.reduce((s, d) => s + (Number((d.quantities || {})[key]) || 0), 0) * 10) / 10;
  const byWeek = fenceByWeek(all);
  const weekSel = state.fenceWeek && byWeek.some(w => w.week === state.fenceWeek) ? state.fenceWeek
                : (byWeek.find(w => w.dockets) || byWeek.find(w => w.end >= todayIso()) || byWeek[0] || {}).week;
  const wk = byWeek.find(w => w.week === weekSel);
  const gaps = FENCE.rate_gaps || [];
  // the days, for the strip: every date a docket names
  const days = new Map();
  usable.filter(d => d.date).forEach(d => { const x = days.get(d.date) || days.set(d.date, {iso:d.date, dockets:[], cost:0}).get(d.date);
    x.dockets.push(d); x.cost += d.cost_total; });
  const dayList = [...days.values()].sort((a, b) => a.iso.localeCompare(b.iso));
  const daySel = state.fenceDay && days.has(state.fenceDay) ? state.fenceDay : (dayList[dayList.length - 1] || {}).iso;
  const dayNow = days.get(daySel);
  const sheets = DATA.fence_sheets || [];
  const areas = fenceByArea(usable);
  const quote = fenceQuote();
  const fdAll = fenceDerived();
  const watch = quoteWatch(all);
  const over = watch.filter(w => w.state === 'over quote');
  const mapBtn = d => { const sh = sheets.find(x => x.sheet_id === d.map_ref); return sh && sh.map_key
    ? `<button class="linkish" data-fmap="${esc(sh.map_key)}">on the map</button>` : ''; };

  $('#pane-fencing').innerHTML = paneHeadingHtml('fencing') + `
  <div class="kpis">
    ${kpi(all.length, 'dockets' + (local ? ' · ' + local + ' ' + LW() : ''))}
    ${kpi(money(cost) || '$0.00', 'charged at the 2026 card', false)}
    ${kpi(money(fdAll.cost) || '$0.00', 'paid to the crew, their own sheet', false)}
    ${kpi(fmtQty(sum('clean'), 'm'), 'clean fence done')}
    ${kpi(fmtQty(sum('scrim'), 'm'), 'scrim fence done')}
    ${kpi(fmtQty(Math.round((sum('ccb_event') + sum('ccb_demarc')) * 10) / 10, 'm'), 'crowd control barrier done')}
    ${kpi(unpriced, 'lines with no rate', unpriced > 0)}
    ${kpi(quote ? over.length : '—', quote ? 'lines over the quote' : 'no quote entered', over.length > 0)}
  </div>
  <div class="notice warn"><b>What the money means</b>
   ${esc(FENCE.authority || 'No fencing rate has been supplied.')} The money on a docket is quantity × the card's 2026 rate, nothing more —
   no margin, no minimums, no travel; <b>paid</b> beside it is the same quantity × what ${esc((DATA.fence_contractor || {}).name || 'the crew')} bill Coates on their own sheet, never added to the charge.
   A rate typed in the table below is per the column's unit, overrides that side for that column on every
   docket, and carries your name. ${gaps.length ? `<b style="display:inline">${gaps.length} gap${gaps.length > 1 ? 's' : ''}:</b> ${
     gaps.map(g => esc(g.problem)).join(' · ')}` : ''}</div>
  <div class="notice info"><b>What "planned" means</b>
   ${esc(DATA.fencing.reference_basis || DATA.fencing.authority || '')} The planned figures below are that programme's stated week totals
   set against the matching 2026 week; on <i>Where we are</i> the plan is read by the day.</div>

  ${closureCard()}

  <!-- v5.80 — NO ADD-A-DOCKET CARD (Andrew Fisher, 24 Sep 2026). The dockets
       are what Advanced write and what he gives the build to work out the charge to the client, so nothing is typed here; a docket recorded on an older copy of the page is still carried
       through import, export and merge, still priced live, and still opens from its number. The blank docket for the
       crew is the master on the Documents tab. recordDocket() below is the same save the card used, kept for the
       record's own tests. -->

  <div class="card">
    <h3>Rates — what we charge, what we pay</h3>
    <p class="sub">${(() => { const pa = FENCE.priced_at || {}; const w = k => String(k || '').replace('_2026', '');
      return `<b>Charged</b> at the <b>2026 ${esc(w(pa.card))} card</b> — ${esc(pa.why || '')} — matched by hand to the card line named on each row, or settled by name where the card has no line.
        <b>Paid</b> is what ${esc((DATA.fence_contractor || {}).name || 'the fencing crew')} bill Coates, off <b>${esc((FENCE.source_file || '').split('/').pop() || 'the cost tracker')}</b>${FENCE.workbook_creator ? ' (' + esc(FENCE.workbook_creator) + ')' : ''}.
        The two are never added together and a margin is only worked out where both are known. Back side by side on Andrew Fisher's word of 24 Sep 2026;
        every total on this page, the Costs tab and the branches stays what Coates charges the V8s, and what is actually committed to ${esc((DATA.fence_contractor || {}).name || 'the contractor')} is on the purchase orders below.
        A rate typed on either side is per the column's unit, overrides that side for that column on every docket, and carries your name.`; })()}</p>
    <div class="tblwrap"><table class="fratetbl"><thead><tr><th>Column</th><th class="num">Charged</th><th class="num">Paid</th><th class="num">Margin</th><th>Where it comes from</th></tr></thead><tbody>${
      FCOL.map(c => { const r = fenceRateFor(c.key), pr = fenceCostFor(c.key);
        const tCharge = (S.fenceRates || {})[c.key], tCost = (S.fenceCosts || {})[c.key];
        const stateChip = c.settled_by ? `<span class="chip ok" title="${esc(c.settled_said || '')}">settled · ${esc(fmtDate(c.settled_on) || c.settled_on || '')}</span>`
          : c.card_state === 'matched' ? '<span class="chip ok">matched</span>' : c.card_state === 'ambiguous' ? '<span class="chip act">ambiguous</span>' : '<span class="chip crit">no line</span>';
        const per = c.unit === 'm' ? ' a metre' : c.unit === 'each' ? ' each' : c.unit === 'hr' ? ' an hour' : '';
        /* the margin is per unit, and it is only a figure when both sides are known. A negative one is not
           hidden: the relocation line reads red on purpose until somebody settles whether Advanced's $100 is
           an hour or a metre. */
        const m = (r.value != null && pr.value != null) ? Math.round((r.value - pr.value) * 10000) / 10000 : null;
        return `<tr><td><b>${esc(c.name_as_written)}</b><div class="w" style="font-size:11px;color:var(--mute)">${esc(c.programme_type || '')}</div>
        <div class="w" style="font-size:11px;color:var(--mute)">${c.card_line ? esc(c.card_line) + ' ' : ''}${stateChip}</div></td>
        <td class="num frs">${c.rate != null ? `<span class="w">${c.settled_by ? 'settled' : 'card'} ${esc(money(c.rate))}</span>` : '<span class="norate">no card line</span>'}
          <input class="rate" type="number" min="0" step="0.01" data-fk="${esc(c.key)}" value="${esc(tCharge ?? '')}" placeholder="type over" title="what Coates charges for ${esc(c.name_as_written)} — per ${esc(c.unit || 'unit')}, on every docket">
          ${r.value != null ? `<b>${esc(money(r.value))}</b><span class="w">${esc(per)}${r.source === 'typed' ? ' · typed' : ''}</span>` : '<span class="norate">not charged</span>'}
          ${tCharge != null && String(tCharge).trim() !== '' ? editByLine({by: r.by, at: r.at}) : ''}
          ${c.issued_card_differs ? `<div class="w" style="font-size:11px;color:var(--mute)">the issued card PDF prints ${esc(money(c.issued_card_rate))}</div>` : ''}</td>
        <td class="num frs">${pr.source === 'hourly' ? `<span class="w">tracker ${esc(money(pr.hourly))} an hour</span>` : c.cost_rate != null ? `<span class="w">tracker ${esc(money(c.cost_rate))}</span>` : '<span class="norate">no tracker rate</span>'}
          <input class="rate" type="number" min="0" step="0.01" data-fck="${esc(c.key)}" value="${esc(tCost ?? '')}" placeholder="type over" title="what ${esc((DATA.fence_contractor || {}).name || 'the crew')} bill Coates for ${esc(c.name_as_written)} — per ${esc(c.unit || 'unit')}, on every docket">
          ${pr.value != null ? `<b>${esc(money(pr.value))}</b><span class="w">${esc(per)}${pr.source === 'typed' ? ' · typed' : ''}</span>` : pr.source === 'hourly' ? `<b>${esc(money(pr.hourly))}</b><span class="w"> an hour · by the hour, not the metre</span>` : '<span class="norate">not costed</span>'}
          ${tCost != null && String(tCost).trim() !== '' ? editByLine({by: pr.by, at: pr.at}) : ''}</td>
        <td class="num">${m == null ? '<span class="norate">—</span>' : `<b class="${m < 0 ? 'fmneg' : ''}">${esc(money(m))}</b><span class="w">${esc(per)}</span>`}</td>
        <td class="fwhy" style="font-size:12px;color:var(--mute)">${(() => { const t = (c.settled_by ? 'settled ' + esc(fmtDate(c.settled_on) || c.settled_on || '') + ': ' + esc(c.settled_said || '') + (c.settled_note ? ' — ' + esc(c.settled_note) : '') + (c.card_why ? ' · ' : '') : '') + esc(c.card_why || '') + (c.unit_basis ? ' · ' + esc(c.unit_basis) : '') + (c.cost_basis ? ' · ' + esc(c.cost_basis) : '');
          const tt = pr.source === 'hourly' ? t + ' · the crew bill this by the hour and the card charges it by the metre, so no per-metre cost is put on it; the hours are on the green book. Type a per-metre cost over it if one is agreed.' : t;
          return tt.length > 160 ? `<div class="clamp">${tt}</div><button type="button" class="linkish clampbtn" data-clamp>more</button>` : tt; })()}</td></tr>`; }).join('')}</tbody></table></div>
    ${(() => { const neg = FCOL.filter(c => { const r = fenceRateFor(c.key), pr = fenceCostFor(c.key); return r.value != null && pr.value != null && r.value < pr.value; });
      return neg.length ? `<p class="norate"><b>${neg.length === 1 ? 'One line costs more than it charges' : neg.length + ' lines cost more than they charge'}:</b> ${
        neg.map(c => esc(c.name_as_written) + ' — paid ' + esc(money(fenceCostFor(c.key).value)) + ' against ' + esc(money(fenceRateFor(c.key).value)) + ' charged').join('; ')}.
        That is what the two documents say, not a calculation error. ${neg.some(c => c.key === 'relocation') ? 'Relocation is the known one: Advanced charge Coates by the hour and Coates charge by the metre (Andrew Fisher, 15 Sep 2026) — so the tracker’s figure may be an hourly rate sitting in a per-metre column. Settle it before a relocation line is paid.' : ''}</p>` : ''; })()}
  </div>

  <div class="card">
    <h3>Fencing by day</h3>
    ${dayList.length ? `
    <div class="daystrip">${dayList.map(d => { const f = fmtDay(d.iso); const w = weekOf(d.iso);
      return `<button type="button" class="day ${w && w.phase === 'Event' ? 'event' : w && w.phase === 'Demob' ? 'demob' : ''}${d.iso === todayIso() ? ' today' : ''}" data-fday="${d.iso}" aria-pressed="${d.iso === daySel}">
        <span class="dow">${esc(f.dow)}</span><span class="dt">${esc(f.dm)}</span><span class="ph">${esc(w ? w.sheet : '—')}</span>
        <span class="cnt"><span>${d.dockets.length} docket${d.dockets.length === 1 ? '' : 's'}</span></span>
        <span class="ph" style="margin-top:4px;font-weight:700;color:var(--ink)">${esc(money(d.cost) || '')}</span></button>`; }).join('')}</div>
    ${dayNow ? `<div class="dayhead"><div><h3>${esc(fmtDate(dayNow.iso))}</h3><div class="sub">${dayNow.dockets.length} docket${dayNow.dockets.length === 1 ? '' : 's'} · ${esc(money(dayNow.cost) || '')}</div></div></div>
    <div class="tblwrap"><table><thead><tr><th>Docket</th><th>Crew</th><th>Where</th><th>What was done</th><th class="num">Cost</th></tr></thead><tbody>${
      dayNow.dockets.map(d => `<tr><td>${docketNoLink(d)}<br>${whereChipF(d._where)}</td><td>${esc(d.crew || '—')}</td>
        <td>${esc(d.map_ref || '')}${d.location ? (d.map_ref ? ' · ' : '') + esc(d.location) : ''}${mapBtn(d) ? '<br>' + mapBtn(d) : ''}</td>
        <td>${docketLines(d)}</td><td class="num"><b>${esc(money(d.cost_total) || '')}</b></td></tr>`).join('')}</tbody></table></div>` : ''}`
    : '<p class="norate">No dated docket yet. The row carried in the workbook has no date, so it appears under its week below and in the register, not here.</p>'}
  </div>

  <div class="card">
    <h3>Quoted quantities — and when a variation is needed</h3>
    <p class="sub">Type the metres and gates the quote covers, line by line, from ${esc((DATA.fence_contractor || {}).name || 'the contractor')}'s quote. Done is added up
      across every usable docket on the job; the moment a line goes past its quoted quantity it is flagged here and a variation can be raised
      on it with the figures already filled in. ${quote ? `Quote ${quote.ref ? '<b>' + esc(quote.ref) + '</b> ' : ''}entered by ${esc(quote.by || 'unnamed')}${quote.on ? ' on ' + esc(quote.on) : ''} ${whereChip(quote._where)}`
        : '<span class="chip crit">no quote entered</span> — until it is, nothing here can say whether the job is over or under.'}</p>
    <div class="form" style="max-width:none">
      <div class="row2">
        <div class="f"><label for="fqRef">Quote reference</label><input id="fqRef" value="${esc((quote || {}).ref || '')}" placeholder="quote number or date, as on the document"></div>
        <div class="f"><label>Entered by</label><div>${esc(S.operator || '(put your name in “Recording as”)')}</div></div>
      </div>
      <div class="fqgrid">${FCOL.filter(c => c.programme_type).map(c => `<div class="f"><label for="fquote-${c.key}">${esc(c.name_as_written)}${c.unit ? ' (' + esc(c.unit) + ')' : ''}</label>
        <input id="fquote-${c.key}" data-fquote="${c.key}" type="number" min="0" step="0.5" inputmode="decimal" value="${esc(((quote || {}).qty || {})[c.key] ?? '')}" placeholder="quoted"></div>`).join('')}</div>
      <div><button class="btn" id="fqSave">Save quoted quantities</button> <span class="hint">Leave a line blank if the quote does not cover it — blank is unknown, not zero.</span></div>
    </div>
    <div class="tblwrap" style="margin-top:12px"><table><thead><tr><th>Line</th><th class="num">Quoted</th><th class="num">Done to date</th><th class="num">Headroom</th><th>State</th><th></th></tr></thead><tbody>${
      watch.filter(w => FCOL.find(c => c.key === w.column).programme_type).map(w => `<tr class="${w.state === 'over quote' ? 'moving' : ''}">
        <td><b>${esc(w.name)}</b>${w.unit ? ' <span class="w" style="color:var(--mute)">' + esc(w.unit) + '</span>' : ''}</td>
        <td class="num">${w.quoted == null ? '<span class="todo">—</span>' : esc(fmtQty(w.quoted, w.unit))}</td>
        <td class="num"><b>${esc(fmtQty(w.done, w.unit))}</b></td>
        <td class="num">${w.quoted == null ? '<span class="todo">—</span>' : w.over_by > 0 ? `<span class="chip act">${esc(fmtQty(w.over_by, w.unit))} over</span>` : esc(fmtQty(Math.round((w.quoted - w.done) * 100) / 100, w.unit))}</td>
        <td>${w.state === 'over quote' ? '<span class="chip crit">variation needed</span>' : w.state === 'within quote' ? '<span class="chip ok">within quote</span>' : '<span class="chip">no quote</span>'}</td>
        <td>${w.state === 'over quote' ? `<button class="btn" data-fqvar="${esc(w.column)}">Raise variation</button>` : ''}</td></tr>`).join('')}</tbody></table></div>
    <p class="norate">Done here is the whole job, every week, against the quoted total. The week table below measures against the 2026 fencing programme instead — the plan, not the quote.</p>
  </div>

  <div class="card">
    <h3>By area — what has been done where</h3>
    ${areas.length ? `<div class="tblwrap"><table><thead><tr><th>Area</th><th>Complete</th><th>Drawing</th><th class="num">Dockets</th><th>Days</th><th>Done</th><th class="num">Cost</th></tr></thead><tbody>${
      areas.map(a => { const fd = fenceAreaDone(a.name); return `<tr class="${fd.done ? 'complete' : ''}"><td><b>${esc(a.name)}</b>${(() => { const o = breakdownsForArea(a.name).filter(b => b.open); return o.length ? `<br><button class="linkish" data-bdarea="${esc(a.name)}"><span class="chip crit">${o.length} open breakdown${o.length > 1 ? 's' : ''}</span></button>` : ''; })()}</td>
        <td><div class="lcell">${fd.done ? `<span class="tick" title="ticked ${esc(fmtStamp(fd.at))} by ${esc(fd.by || 'unnamed')}">✓ Complete</span> ${whereChip(fd.where)}` : fd.at ? `<span class="w" style="color:var(--mute)">un-ticked ${esc(fmtStamp(fd.at))}</span>` : '<span class="todo">—</span>'}${fenceAreaBtn(a.name)}</div></td>
        <td>${a.refs.length ? a.refs.map(esc).join('<br>') : '<span class="todo">—</span>'}</td>
        <td class="num">${a.dockets}</td><td style="white-space:nowrap">${esc(a.first || '—')}${a.last && a.last !== a.first ? ' → ' + esc(a.last) : ''}</td>
        <td>${a.lines.length ? a.lines.map(l => `<b>${esc(fmtQty(l.qty, l.unit))}</b> ${esc(l.name)}`).join('<br>') : '—'}</td>
        <td class="num"><b>${esc(money(a.cost) || '')}</b>${a.unpriced ? '<br><span class="chip crit">' + a.unpriced + ' unpriced line' + (a.unpriced > 1 ? 's' : '') + '</span>' : ''}</td></tr>`; }).join('')}</tbody></table></div>
    <p class="norate">Areas are the words written on the dockets, matched ignoring case and spacing. A row per area the crew has named; nothing here is a programme figure. The tick is the crew saying the area is finished — it carries their name and time, and it never hides a docket or a breakdown.</p>`
    : '<p class="norate">No docket names an area yet. The row carried in the workbook has none.</p>'}
  </div>

  <div class="card">
    <h3>By week — planned, done, still to do</h3>
    <div class="filters">${byWeek.map(w => `<button data-fweek="${esc(w.week)}" aria-pressed="${w.week === weekSel}">${esc(w.week.replace('Demob Week', 'Demob'))}${w.dockets ? ' · ' + w.dockets : ''}</button>`).join('')}</div>
    ${wk ? `<div class="dayhead"><div><h3>${esc(wk.week)} <span class="w" style="font-weight:400;font-size:13px;color:var(--mute)">${esc(wk.start)} → ${esc(wk.end)} · ${esc(wk.phase || '')}</span></h3>
      <div class="sub">planned from ${wk.progSheet ? '<b>' + esc(wk.progSheet) + '</b> (' + (wk.rolled ? esc(wk.span || '') : '<span class="chip act" title="the 2026 file still carries ' + esc(String(wk.planYear || 'last year’s')) + ' dates on this sheet">' + esc(String(wk.planYear || 'last year’s')) + ' dates — not rolled forward</span>') + ')' : 'nothing — no matching programme sheet'} · ${wk.dockets} docket${wk.dockets === 1 ? '' : 's'} · ${esc(money(wk.cost) || '$0.00')}</div></div></div>
    <div class="tblwrap"><table><thead><tr><th>Line</th><th class="num">Planned</th><th class="num">Done</th><th class="num">Still to do</th><th class="num">Cost</th></tr></thead><tbody>${
      wk.lines.map(l => { const over = l.remaining != null && l.remaining < 0;
        return `<tr class="${l.done > 0 && l.remaining != null && l.remaining <= 0 ? 'done' : l.done > 0 ? 'moving' : ''}">
          <td><b>${esc(l.name)}</b>${l.unit ? ' <span class="w" style="color:var(--mute)">' + esc(l.unit) + '</span>' : ''}</td>
          <td class="num">${l.planned == null ? '<span class="todo" title="the programme has no line for this">—</span>' : esc(fmtQty(l.planned, l.unit))}${l.programme != null ? `<br><span class="w" style="color:var(--mute)" title="the programme workbook's stated total for the week, before the installation plan">programme ${esc(fmtQty(l.programme, l.unit))}</span>` : ''}</td>
          <td class="num"><b>${esc(fmtQty(l.done, l.unit))}</b>${l.offPlan ? `<br><span class="w" style="color:var(--mute)" title="compound and yard work the programme sheet does not list — counted and costed, with no planned figure to measure it against">${esc(fmtQty(l.offPlan, l.unit))} outside the plan</span>` : ''}</td>
          <td class="num">${l.remaining == null ? '<span class="todo">—</span>' : over ? `<span class="chip act" title="more done than the programme's stated total">${esc(fmtQty(-l.remaining, l.unit))} over</span>` : esc(fmtQty(l.remaining, l.unit))}</td>
          <td class="num">${l.cost == null ? '<span class="chip crit">no rate</span>' : esc(money(l.cost))}</td></tr>`; }).join('')}
      <tr><td><b>Week total</b></td><td></td><td></td><td></td><td class="num"><b>${esc(money(wk.cost) || '$0.00')}</b></td></tr></tbody></table></div>
    ${wk.outside.length ? `<p class="norate"><b>Outside the plan this week:</b> ${wk.outside.map(o =>
        `${esc(o.no || '—')} <span class="w" style="color:var(--mute)">${esc(o.scope === 'yard' ? 'yard and stock work' : o.scope === 'compound' ? 'compound work' : 'work the programme sheet does not list')}${o.where ? ' — ' + esc(o.where) : ''}</span>`).join(' · ')}.
      Every metre on ${wk.outside.length === 1 ? 'it is' : 'them is'} counted in Done and costed. The programme sheet has no line for ${wk.outside.length === 1 ? 'it' : 'them'}, so there is nothing to measure ${wk.outside.length === 1 ? 'it' : 'them'} against.</p>` : ''}
    <p class="norate">Done is the sum of usable dockets in this week. Planned is the ${wk.update ? `<b>${esc(wk.update.title)}</b> (${esc(wk.update.created_display)}), summed by the day — the later document from the programme's author; where it changed a figure the programme's stated total is shown under it` : wk.rolled ? '2026 fencing programme\'s stated total for the sheet — a plan, not an order' : 'stated total of a sheet the 2026 file has not rolled forward — last year\'s sequence, shown for reference'}. Never add metres, gates and crew lines together. <b>Still to do</b> measures the plan against the work the plan is
      for: the programme sheet is the works fence and does not list the contractor and event compounds, so compound
      metres are counted in Done, costed, and shown separately rather than read as being ahead of schedule. No planned
      figure is invented for them — a plan nobody wrote is not a plan.</p>
    ${wk.update ? planUpdateCard(wk.update) : ''}` : ''}
    ${schedFenceNote()}
  </div>

  ${poCard(byWeek)}

  <div class="card">
    <h3>Docket register <span class="chip ref">${all.length}</span> <span class="chip" title="the hire agreement book — Andrew Fisher, 25 Sep 2026">red book · hire agreements</span></h3>
    <p class="sub">Every docket, whoever entered it. <span class="chip ref">from the workbook</span> rows came with the cost tracker;
      <span class="chip cand">${LW()}</span> rows have not been exported yet; <span class="chip ok">committed</span> rows are on the record.
      The red book is Advanced's hire agreements (36501 upward) — charged to the V8s at the card and costed at what Advanced bill. The green book
      (labour, what we pay Advanced) and the blue book (collections) follow below.</p>
    ${(() => { /* THE SIGNED PAPERS, ANSWERED PLAINLY. Andrew Fisher, 15 Sep 2026, asked whether every fencing
         docket had been uploaded. A count of the papers on the service is not the answer; the answer is which
         dockets have one and which do not, by number, so the gap is a list he can work from. */
      const withP = all.filter(d => docketPapersOf(d.id).length || docketPapersByName(d).length);
      const without = all.filter(d => !(docketPapersOf(d.id).length || docketPapersByName(d).length));
      const misfiled = [...new Set(all.flatMap(d => docketPapersByName(d).filter(p => p.filedAs).map(p => p.filedAs)))];
      if (!all.length) return '';
      return `<p class="norate"><b>Signed papers: ${withP.length} of ${all.length} dockets have one.</b>${
        without.length ? ` No paper yet against ${without.map(d => esc(d.docket_no || d.id)).join(', ')} — a docket with no signed paper behind it is a cost nobody can stand up in front of the customer.`
                       : ' Every docket on this register has its signed paper.'}${
        misfiled.length ? ` <span class="nomark">${noGlyph(11)}</span> Some were uploaded under <b>${misfiled.map(esc).join('</b>, <b>')}</b> rather than <b>Fencing docket</b> — they are matched here by the number in the file name and counted, so nothing is lost; re-file them on the admin page when you get a minute and the Documents tab will tidy itself.` : ''}</p>`; })()}
    <div class="tblwrap"><table><thead><tr><th>Docket</th><th>Date</th><th>Week</th><th>Crew</th><th>Where</th><th>What was done</th><th class="num">Cost</th><th>Recorded by</th><th></th></tr></thead>
    <tbody>${shown.length ? shown.map(d => `<tr class="${d.usable ? '' : ''}">
      <td>${docketNoLink(d)} <span class="mono" style="font-size:11px;color:var(--mute)">${esc(d.id)}</span><br>${whereChipF(d._where)}${d.usable ? '' : ' <span class="chip crit" title="' + esc(d.problems.join('; ')) + '">not usable</span>'}</td>
      <td style="white-space:nowrap">${d.date ? esc(d.date) : '<span class="todo" title="no date on this row">—</span>'}</td>
      <td style="white-space:nowrap">${esc(d.week || '—')}${d.programme_sheet ? '<br><span class="w" style="font-size:11px;color:var(--mute)">' + esc(d.programme_sheet) + '</span>' : ''}</td>
      <td>${esc(d.crew || '—')}</td>
      <td>${esc(d.map_ref || '')}${d.location ? (d.map_ref ? '<br>' : '') + esc(d.location) : ''}${mapBtn(d) ? '<br>' + mapBtn(d) : ''}${!d.map_ref && !d.location ? '<span class="todo">—</span>' : ''}</td>
      <td>${docketLines(d)}${docketOwedBlock(d)}${
        d.note ? '<div class="w' + (d.note.length > 140 ? ' clamp' : '') + '" style="font-size:11.5px;color:var(--mute)">' + esc(d.note) + '</div>' + (d.note.length > 140 ? '<button type="button" class="linkish clampbtn" data-clamp>more</button>' : '') : ''}${docketPaperBlock(d)}</td>
      <td class="num"><b>${esc(money(d.cost_total) || '')}</b>${d.cost_state === 'partly priced' ? '<br><span class="chip crit">partly priced</span>' : ''}</td>
      <td>${esc(d.recorded_by || '—')}${d.recorded_on ? '<br><span class="w" style="font-size:11px;color:var(--mute)">' + esc(d.recorded_on) + '</span>' : ''}</td>
      <td>${d._where === 'local' ? `<button class="btn ghost" data-fdel="${esc(d.id)}">Set aside</button>` : ''}
        <button class="btn ghost editonly" data-fvar="${esc(d.id)}">Variance</button>${docketAttachBtn(d)}</td></tr>`).join('')
      : `<tr><td colspan="9" class="empty">${all.length ? 'Nothing matches that search.' : 'No dockets yet.'}</td></tr>`}</tbody></table></div>
  </div>
  ${greenBookCard()}
  ${blueBookCard()}
  ${cw4OpenCard()}`;

  const pane = $('#pane-fencing');
  /* v5.59 — a fence rate typed over the card: per the column's unit, stamped with who and when, applied to every
     docket by costDocket(); blank takes it back to the card */
  pane.querySelectorAll('[data-fk]').forEach(i => i.onchange = () => {
    if (!mayWrite('a fence rate')) { renderFencing(); return; }
    const who = whoAmI(); if (!who) { renderFencing(); return; }
    S.fenceRates = S.fenceRates || {};
    if (String(i.value).trim() === '') delete S.fenceRates[i.dataset.fk]; else S.fenceRates[i.dataset.fk] = i.value;
    stampIt('fenceRates', i.dataset.fk, who); save(); renderFencing();
  });
  /* v5.60, back in v5.80 — the paid side, typed over the same way and kept in its own field so a charge and a
     cost can never land in one another's column */
  pane.querySelectorAll('[data-fck]').forEach(i => i.onchange = () => {
    if (!mayWrite('a fence cost')) { renderFencing(); return; }
    const who = whoAmI(); if (!who) { renderFencing(); return; }
    S.fenceCosts = S.fenceCosts || {};
    if (String(i.value).trim() === '') delete S.fenceCosts[i.dataset.fck]; else S.fenceCosts[i.dataset.fck] = i.value;
    stampIt('fenceCosts', i.dataset.fck, who); save(); renderFencing();
  });
  pane.querySelectorAll('[data-dkp]').forEach(i => i.onchange = () => {
    const f = i.files && i.files[0]; if (!f) return;
    docketPaperAdd(i.dataset.dkp, f).catch(e => flash(String((e && e.message) || e)));
    i.value = '';
  });
  $('#fqSave').onclick = () => {
    const who = whoAmI(); if (!who) return;
    const qty = {};
    pane.querySelectorAll('[data-fquote]').forEach(i => { const v = i.value.trim(); if (v !== '' && Number(v) >= 0) qty[i.dataset.fquote] = Number(v); });
    if (!Object.keys(qty).length) { S.fenceQuote = null; bump(); flash('Quote cleared — no quantities entered.'); return; }
    S.fenceQuote = {qty, ref: $('#fqRef').value.trim() || null, by: who, on: todayIso()};
    bump();
    const o = quoteWatch(allDockets()).filter(w => w.state === 'over quote');
    flash('Quoted quantities saved in this browser.' + (o.length ? ' ' + o.length + ' line' + (o.length > 1 ? 's are' : ' is') + ' already over the quote.' : ''));
  };
  pane.querySelectorAll('[data-fqvar]').forEach(b => b.onclick = () => {
    const w = watch.find(x => x.column === b.dataset.fqvar); if (!w) return;
    const col = FCOL.find(c => c.key === w.column) || {};
    const wk = weekOf(todayIso());
    varDialog({scope:'fencing', sheet: progSheet(wk ? wk.sheet : '') || '', fence_type: col.programme_type || '', type:'quantity',
               asked: String(w.quoted), supplied: String(w.done), qty_asked: w.quoted, qty_supplied: w.done,
               recorded_by: S.operator || '', chargeable: 'to be agreed',
               reason: `${w.name} done to date (${fmtQty(w.done, w.unit)}) exceeds the quoted quantity (${fmtQty(w.quoted, w.unit)}) by ${fmtQty(w.over_by, w.unit)}${quote && quote.ref ? ' — quote ' + quote.ref : ''}, as at ${todayIso()}.`});
  });
  pane.querySelectorAll('[data-fday]').forEach(b => b.onclick = () => { state.fenceDay = b.dataset.fday; renderFencing(); });
  pane.querySelectorAll('[data-bdarea]').forEach(b => b.onclick = () => { state.q = b.dataset.bdarea; const qb = $('#q'); if (qb) { qb.value = state.q; $('#qx').hidden = false; } state.bdFilter = 'all'; go('breakdowns'); });
  pane.querySelectorAll('[data-fweek]').forEach(b => b.onclick = () => { state.fenceWeek = b.dataset.fweek; renderFencing(); });
  wirePoCard(pane);
  pane.querySelectorAll('.planupd [data-go]').forEach(b => b.onclick = () => { state.docsec = 'fencing'; go(b.dataset.go); });
  pane.querySelectorAll('[data-fmap]').forEach(b => b.onclick = () => { state.sheet = b.dataset.fmap; state.sel = null; go('map'); });
  pane.querySelectorAll('[data-fdel]').forEach(b => b.onclick = () => {
    const id = b.dataset.fdel;
    const who = whoAmI(); if (!who) return;
    if (!confirm('Set aside docket ' + id + '? It is kept, with your name and the time, and can be put back from Tools → Edit.')) return;
    if (!setAside('fenceDockets', id, who)) return;
    bump(); flash(id + ' set aside by ' + who + ' — Put back is under Tools → Edit.');
  });
  pane.querySelectorAll('[data-fvar]').forEach(b => b.onclick = () => {
    const d = all.find(x => x.id === b.dataset.fvar); if (!d) return;
    const first = d.lines[0] || {};
    const col = FCOL.find(c => c.key === first.column) || {};
    varDialog({scope:'fencing', sheet: d.programme_sheet || '', fence_type: col.programme_type || '',
               asked: '', supplied: first.qty != null ? String(first.qty) : '', recorded_by: S.operator || '',
               reason: 'Docket ' + (d.docket_no || d.id) + (d.date ? ' on ' + d.date : '') + (d.location ? ' at ' + d.location : '')});
  });
}

/* ------------------------------------------------------------------ breakdowns
   Anything that broke, failed, got damaged or needs attention — a generator that will not start, a building
   delivered with a smashed window, a run of fence that has been driven through. Each one is tied to a GC500
   reference or a fencing area, so whoever is sent to look at it is sent to the right place: the record opens
   the asset, shows the marker, prints the drop sheet with the aerial pictures, or points at the fencing area.
   It carries who owns the fix, what is being done and by when, and it is closed with what fixed it. Like every
   other record here it is a person's entry with their name on it, kept apart from the committed copy. */
const BD_TYPES = ['breakdown', 'damage', 'fault', 'safety', 'access', 'other'];
const BD_SEVERITY = ['stops work', 'needs attention', 'note'];
const BD_STATUS = ['open', 'being fixed', 'fixed', 'closed'];
const BD_CHIP = {'stops work':'crit', 'needs attention':'act', 'note':''};
const BD_STATUS_CHIP = {'open':'crit', 'being fixed':'cand', 'fixed':'ok', 'closed':''};
function gradeBreakdown(b){
  return Object.assign({}, b, {open: b.status === 'open' || b.status === 'being fixed',
    problems: [!b.what ? 'nothing says what happened' : null, !b.ref && !b.area ? 'no reference and no area — nobody can be sent anywhere' : null,
               !b.by ? 'nobody named as reporting it' : null].filter(Boolean)});
}
function allBreakdowns(){
  const com = ((COMMITTED.breakdowns) || []).map(b => Object.assign(gradeBreakdown(b), {_where:'committed'}));
  const loc = (S.breakdowns || []).map(b => Object.assign(gradeBreakdown(b), {_where:'local'}));
  const order = {'stops work':0, 'needs attention':1, 'note':2};
  return com.concat(loc).sort((x, y) => (y.open - x.open) || ((order[x.severity] ?? 9) - (order[y.severity] ?? 9)) || String(y.at || '').localeCompare(String(x.at || '')));
}
function breakdownsFor(key){ return allBreakdowns().filter(b => b.ref === key); }

/* ------------------------------------------------------------------ the journal, and what is owed
   Andrew Fisher, 14 Sep 2026, asked where the journal was. It did not exist. The record has held every event
   on this job since the first day — who set a light and when, who ticked something complete, who typed a branch
   code, who moved a drop to another day, who took an asset number off — and there was nowhere that put them in
   one place, in the order they happened, with the name of whoever did it.

   Nothing in the journal is written by the journal. Every line is read back out of the record somebody else
   already wrote: the light histories, the tick stamps, the breakdowns, the variances, the dockets, the cost
   lines, the tombstones, the field stamps. So it cannot disagree with the pages it reports on, and it cannot be
   edited into saying something that did not happen — to change the journal you have to change the thing.

   Two kinds of entry have a shape of their own and are marked as such:
     · an entry whose time is the moment a FIELD was last changed carries the stamp, not a history, so it says
       "last changed" rather than pretending to be the only time it ever was
     · an entry read from a light history carries the state it moved TO, and the one before it where there is one
*/
const JOURNAL_KINDS = {
  light:    {word: 'Light',      tone: 'plan'},
  done:     {word: 'Complete',   tone: 'good'},
  location: {word: 'Location',   tone: 'change'},
  date:     {word: 'Date',       tone: 'change'},
  number:   {word: 'Asset no.',  tone: 'change'},
  branch:   {word: 'Branch',     tone: 'plan'},
  rental:   {word: 'Rental ID',  tone: 'plan'},
  eta:      {word: 'Time',       tone: 'plan'},
  supplied: {word: 'Supplied',   tone: 'good'},
  breakdown:{word: 'Breakdown',  tone: 'stop'},
  variance: {word: 'Variance',   tone: 'gap'},
  docket:   {word: 'Fencing',    tone: 'good'},
  cost:     {word: 'Cost',       tone: 'plan'},
  po:       {word: 'Order',      tone: 'plan'},
  action:   {word: 'Action',     tone: 'gap'},
  added:    {word: 'Added',      tone: 'change'},
  schedule: {word: 'Schedule',   tone: 'change'},
  removed:  {word: 'Set aside',  tone: 'change'},
  moved:    {word: 'Moved',      tone: 'change'},
  deleted:  {word: 'Deleted',    tone: 'stop'},
};
/* One chip, one meaning, always with a mark and always with words. The mark is a character rather than an icon
   font so it survives a print, a paste into an email and a screen reader reading it out. */
const SEM_MARK = {good: '✓', gap: '?', stop: '!', plan: '›', change: '⤳', none: '–'};
function sem(tone, words, title){
  const k = SEM_MARK[tone] ? tone : 'none';
  return `<span class="sem ${k}"${title ? ` title="${esc(title)}"` : ''}><i aria-hidden="true">${SEM_MARK[k]}</i>${esc(words)}</span>`;
}
function semKey(){
  return `<div class="semkey" role="list" aria-label="what the colours mean">
    ${[['good', 'Confirmed'], ['gap', 'Needs checking'], ['stop', 'Stops work'],
       ['plan', 'Planned, not observed'], ['change', 'Changed'], ['none', 'No record']]
      .map(([k, w]) => `<span role="listitem">${sem(k, w)}</span>`).join('')}</div>`;
}
function journal(opts){
  const o = opts || {};
  const rows = [];
  const at = x => (x && String(x)) || null;
  const nameOf = k => { const a = assetOf(k); return a && a.name ? k + ' — ' + a.name : k; };
  const push = (when, kind, ref, what, who, extra) => {
    if (!when) return;
    rows.push(Object.assign({at: when, kind, ref: ref || null, what, who: who || null}, extra || {}));
  };
  /* the lights, every step of every one of them */
  Object.entries(S.delivery || {}).forEach(([k, d]) => {
    const hist = Array.isArray(d.history) ? d.history : [];
    hist.forEach((h, i) => {
      const from = i > 0 ? hist[i - 1].state : null;
      push(at(h.at), 'light', k, (LIGHT[h.state] || {word: h.state}).word
        + (from ? ' (was ' + (LIGHT[from] || {word: from}).word.toLowerCase() + ')' : ''), h.by);
    });
    if (!hist.length && d.set_at) push(at(d.set_at), 'light', k, (LIGHT[d.state] || {word: d.state}).word, d.by);
    if (d.done && d.done_at) push(at(d.done_at), 'done', k, 'Ticked complete — in position, set up, checked', d.done_by);
    if (d.levelled && d.levelled_at) push(at(d.levelled_at), 'done', k, 'Positioned and levelled — closed off', d.levelled_by);
    if (d.steps && d.steps_at) push(at(d.steps_at), 'done', k, 'Steps installed', d.steps_by);
    if (d.date && d.date_at) push(at(d.date_at), 'date', k,
      'Moved to ' + fmtDate(d.date) + (d.date_where ? ' (' + d.date_where + ')' : ''), d.date_by);
  });
  /* the field stamps: the LAST time each of these was changed, and the journal says so */
  const stampWord = {locations: 'location', descs: 'description', branch: 'branch', rental: 'rental', eta: 'eta', supplied: 'supplied',
                     items: 'item', qtys: 'qty', hireStart: 'hire', mapRef: 'map', moves: 'moved', labour: 'labour', eventHours: 'hours', minDays: 'minimum'};
  Object.entries(S.stamps || {}).forEach(([key, when]) => {
    const cut = key.indexOf('/'); if (cut < 0) return;
    const field = key.slice(0, cut), ref = key.slice(cut + 1);
    const kind = stampWord[field]; if (!kind) return;
    const say = kind === 'location' ? 'Where it goes set to "' + ((S.locations || {})[ref] || '—') + '"'
      : kind === 'description' ? 'Description typed over: "' + ((S.descs || {})[ref] || '—') + '"'
      : kind === 'branch' ? 'Branch set to ' + ((S.branch || {})[ref] || '—')
      : kind === 'rental' ? 'Put on Rental ID ' + ((S.rental || {})[ref] || '—')
      : kind === 'eta' ? 'Planned time on site set to ' + (((S.delivery || {})[ref] || {}).eta || '—')
      : kind === 'item' ? 'Item type typed over: "' + ((S.items || {})[ref] || '— back to the schedule\'s') + '"'
      : kind === 'qty' ? 'Quantity typed over: ' + ((S.qtys || {})[ref] != null ? (S.qtys || {})[ref] : '— back to the schedule\'s')
      : kind === 'hire' ? 'Hire charged from ' + ((S.hireStart || {})[ref] ? fmtDate((S.hireStart || {})[ref]) : '— cleared, the schedule\'s span again')
      : kind === 'map' ? 'Map attached: ' + (((S.mapRef || {})[ref] || {}).name || '— none now')
      : kind === 'labour' ? (() => { const q = ref.split('|'); const name = (q[3] || '').replace('_', ' ');
          return ((S.labour || {})[ref] ? 'Labour ticked: ' : 'Labour unticked: ') + name + ' on ' + (q[2] || ''); })()
      : kind === 'minimum' ? (() => { const q = ref.split('|'); const v = (S.minDays || {})[ref];
          return 'Minimum hire typed for ' + (q[1] || '') + ': ' + (v != null && v !== '' ? v + ' days' : '— cleared, the card\'s own minimum again'); })()
      : kind === 'hours' ? (() => { const q = ref.split('|'); const v = (S.eventHours || {})[ref];
          const sw = /^scope-/.test(ref) ? scopeChangeWords(ref, v) : null; if (sw) return sw;
          return 'Hours over the event: ' + (v != null && v !== '' ? v + ' h' : '— cleared') + ' for ' + (q[0] || '') + ' on ' + (q[1] ? fmtDate(q[1]) : ''); })()
      : kind === 'moved' ? ((S.moves || {})[ref] && (S.moves || {})[ref].to ? 'Record moved to ' + (S.moves || {})[ref].to
          : (Object.entries(S.moves || {}).find(([k, m]) => m && m.to === ref) ? 'Record moved here from ' + Object.entries(S.moves || {}).find(([k, m]) => m && m.to === ref)[0] : 'Record back on ' + ref))
      : 'What turned up was typed in';
    push(at(when), kind === 'location' ? 'location' : kind === 'description' ? 'location' : kind === 'eta' ? 'eta' : kind === 'item' || kind === 'qty' ? 'location' : kind === 'hire' || kind === 'labour' || kind === 'hours' || kind === 'minimum' ? 'rental' : kind === 'map' ? 'location' : kind === 'moved' ? 'moved' : kind,
         kind === 'labour' ? ref.split('|')[0] : kind === 'hours' || kind === 'minimum' ? '' : ref.split('/')[0], say, stampBy(field, ref), {lastOnly: true});
  });
  /* the numbers taken off — and the ones put back, because a putting-back is a record too (TR-07) */
  /* a removal and a putting-back each carry a name since the master edit of 16 Sep 2026 (tomb/untomb) */
  const tombWho = e => e.back ? untombBy(e.id) : tombBy(e.id);
  const tombLine = (e, who, where) => {
    const m = String(e.id).match(/^num\/([^/]+)\/(.+)$/);
    if (m) { if (numberErased(e.id)) return true; push(at(e.at), 'number', m[1], 'Asset no. ' + m[2] + (e.back ? ' typed back on' : ' removed for good'), who, where); return true; }
    const ac = String(e.id).match(/^acc\/([^/]+)\/(.+)$/);
    if (ac) { const what = String(ac[2]).split('|')[0] || 'accessory';
      push(at(e.at), 'number', ac[1], what + (e.back ? ' put back inside' : ' taken out of') + ' ' + ac[1], who, where); return true; }
    const asd = (S.aside || {})[e.id];
    if (asd && !e.back) { const w = asideWords(asd); push(at(e.at), 'removed', w.ref || null, (w.what + ' ' + e.id + ' set aside' + (w.desc ? ' — ' + w.desc : '')), who, where); return true; }
    if (e.back && String(e.id).indexOf('/') < 0) { push(at(e.at), 'removed', null, e.id + ' put back', who, where); return true; }
    return false;
  };
  tombEvents(S).forEach(e => {
    if (tombLine(e, tombWho(e))) return;
    const rw = String(e.id).match(/^row\/(.+)$/);
    if (rw) push(at(e.at), 'schedule', null, 'Schedule row ' + rw[1] + (e.back ? ' put back on its day' : ' taken off its day — moved')
      + ((S.notes || {})[e.id] ? ' · ' + (S.notes || {})[e.id] : ''), null);
    /* a deletion is the one removal with no putting-back, and the Journal is the one place it is still said */
    const dx = String(e.id).match(/^asset\/(.+)$/);
    if (dx && !e.back) push(at(e.at), 'deleted', dx[1], 'Deleted from the register for good' + ((S.notes || {})[e.id] ? ' · ' + (S.notes || {})[e.id] : ''), tombWho(e));
  });
  /* everything that is already a record with its own time on it */
  (S.breakdowns || []).forEach(b => push(at(b.at), 'breakdown', b.ref || null,
    (b.open ? 'Open: ' : 'Closed: ') + (b.what || 'breakdown'), b.by));
  (S.variances || []).forEach(v => push(at(v.at), 'variance', v.ref || null, v.what || v.type || 'variance', v.by));
  (S.fenceDockets || []).forEach(d => push(at(d.at || d.date), 'docket', null,
    'Docket ' + (d.id || '') + (d.area ? ' — ' + d.area : ''), d.by));
  (S.costs || []).forEach(c => isOurs(c)
    ? push(at(c.updated_at || c.at), 'cost', c.ref || null, `Our cost — ${(OUR_KIND[c.kind] || {label: 'line'}).label.toLowerCase()}: ${ourLineWords(c)}${OUR_KIND[c.kind] && OUR_KIND[c.kind].money ? (c.amount != null && c.amount !== '' ? ' · ' + money(c.amount) : ' · awaiting the figure') : ''}${c.from === 'tracker' ? ' (the tracker\'s line, changed)' : ''}`, c.updated_by || c.by)
    : push(at(c.at), 'cost', c.ref || null, (c.what || c.description || 'cost') + (c.amount != null ? ' · ' + money(c.amount) : ''), c.by));
  (S.added || []).forEach(a => push(at(a.at), 'added', a.key, 'Added to the register — ' + (a.name || a.item || ''), a.by));
  (S.actions || []).forEach(a => {
    push(at(a.at), 'action', a.ref || null, 'Raised: ' + (a.what || ''), a.by);
    if (a.done_at) push(at(a.done_at), 'action', a.ref || null,
      (a.state === 'dropped' ? 'Dropped: ' : 'Done: ') + (a.what || ''), a.done_by);
  });
  /* THE COMMITTED RECORD IS ON THE JOB TOO. The tester audit of 16 Sep 2026 opened the file edition fresh from
     the build and the Journal read "0 entries" under a heading that promised everything that has happened on
     this job — while six buildings had been lit, levelled and numbered on site the day before and were in the
     committed record (sources/ops/as_supplied.json) the page was built from. This browser's own copy is what
     the lines above read; the committed rows are read here the same way, marked as committed, and a line the
     browser already holds with the same time and words is not listed twice. */
  const seen = new Set(rows.map(r => [r.kind, r.ref || '', String(r.at), r.what].join('|')));
  const pushC = (when, kind, ref, what, who) => {
    if (!when) return; const k = [kind, ref || '', String(when), what].join('|');
    if (seen.has(k)) return; seen.add(k);
    /* a record that holds only the DAY is listed on its day with no time — never a made-up 00:00 */
    rows.push({at: when, kind, ref: ref || null, what, who: who || null, where: 'committed', dateOnly: /^\d{4}-\d{2}-\d{2}$/.test(String(when))});
  };
  try {
    CROW.forEach((r, k) => {
      const d = r.delivery || {}; if (!d) return;
      const hist = Array.isArray(d.history) ? d.history : [];
      hist.forEach((h, i) => { const from = i > 0 ? hist[i - 1].state : null;
        pushC(at(h.at), 'light', k, (LIGHT[h.state] || {word: h.state}).word
          + (from ? ' (was ' + (LIGHT[from] || {word: from}).word.toLowerCase() + ')' : ''), h.by); });
      if (!hist.length && d.set_at && d.recorded) pushC(at(d.set_at), 'light', k, (LIGHT[d.state] || {word: d.state}).word, d.by);
      if (d.done && d.done_at) pushC(at(d.done_at), 'done', k, 'Ticked complete — in position, set up, checked', d.done_by);
      if (d.levelled && d.levelled_at) pushC(at(d.levelled_at), 'done', k, 'Positioned and levelled — closed off', d.levelled_by);
      if (d.steps && d.steps_at) pushC(at(d.steps_at), 'done', k, 'Steps installed', d.steps_by);
      if (d.date && d.date_at) pushC(at(d.date_at), 'date', k, 'Moved to ' + fmtDate(d.date), d.date_by);
      (r.asset_numbers_supplied || []).forEach(n => { if (r.recorded_on) pushC(at(r.recorded_on), 'supplied', k, 'Asset no. ' + n + ' recorded on site', r.recorded_by); });
    });
    tombEvents(COMMITTED).forEach(e => {
      const m = String(e.id).match(/^num\/([^/]+)\/(.+)$/);
      if (m) { if (numberErased(e.id)) return; pushC(at(e.at), 'number', m[1], 'Asset no. ' + m[2] + (e.back ? ' typed back on' : ' removed for good'), null); return; }
      const ac = String(e.id).match(/^acc\/([^/]+)\/(.+)$/);
      if (ac) { pushC(at(e.at), 'number', ac[1], (String(ac[2]).split('|')[0] || 'accessory') + (e.back ? ' put back inside' : ' taken out of') + ' ' + ac[1], null); return; }
      const rw = String(e.id).match(/^row\/(.+)$/);
      if (rw) { pushC(at(e.at), 'schedule', null, 'Schedule row ' + rw[1] + (e.back ? ' put back on its day' : ' taken off its day'), null); return; }
      const dx = String(e.id).match(/^asset\/(.+)$/);
      if (dx && !e.back) pushC(at(e.at), 'deleted', dx[1], 'Deleted from the register for good' + (((COMMITTED.notes || {})[e.id]) ? ' · ' + (COMMITTED.notes || {})[e.id] : ''), ((COMMITTED.by || {})['deleted/' + e.id]) || null);
    });
    (COMMITTED.cancelled_rows || []).forEach(c => { const why = String(c.why || 'no reason recorded').trim();
      pushC(at(c.on || c.at || null), 'schedule', String(c.task_id || '').toUpperCase() || null,
        (/^cancelled/i.test(why) ? why : 'Cancelled — ' + why), c.said_by); });
    (COMMITTED.variances || []).forEach(v => pushC(at(v.at || v.recorded_at || v.recorded_on || null), 'variance', v.ref || v.gc500_id || null, v.what || v.type || 'variance', v.by || v.recorded_by));
    (COMMITTED.breakdowns || []).forEach(b => pushC(at(b.at), 'breakdown', b.ref || null, (b.open ? 'Open: ' : 'Closed: ') + (b.what || 'breakdown'), b.by));
    /* v5.79 — a line the build worked out from a docket is the docket's arithmetic, not an event; the docket is the event */
    (COMMITTED.costs || []).filter(c => c.from !== 'record').forEach(c => pushC(at(c.at || c.recorded_on), 'cost', c.ref || null, (c.what || c.description || 'cost') + (c.amount != null ? ' · ' + money(c.amount) : ''), c.by || c.recorded_by));
  } catch (e) { /* a record this page cannot read is not a reason to lose the browser's own lines */ }
  let out = rows.filter(r => r.at).sort((a, b) => String(b.at).localeCompare(String(a.at)));
  if (o.ref) out = out.filter(r => r.ref === o.ref);
  if (o.kind && o.kind !== 'all') out = out.filter(r => r.kind === o.kind);
  if (o.since) out = out.filter(r => String(r.at).slice(0, 10) >= o.since);
  if (o.q) { const q = o.q.toLowerCase();
    out = out.filter(r => (r.ref || '').toLowerCase().includes(q) || (r.what || '').toLowerCase().includes(q)
      || (r.who || '').toLowerCase().includes(q)); }
  return out;
}
/* what is owed — the actions, in the order somebody would work them */
const ACTION_STATES = {open: {word: 'Open', tone: 'gap'}, doing: {word: 'Doing', tone: 'plan'},
                      done: {word: 'Done', tone: 'good'}, dropped: {word: 'Dropped', tone: 'none'}};
const ACTION_PRIORITY = {stop: 'Stops work', soon: 'Needed soon', watch: 'Watch'};
function actionsOf(opts){
  const o = opts || {};
  const pri = {stop: 0, soon: 1, watch: 2};
  let list = (S.actions || []).slice();
  if (o.ref) list = list.filter(a => a.ref === o.ref);
  if (o.state && o.state !== 'all') list = list.filter(a => (a.state || 'open') === o.state);
  else if (!o.state) list = list.filter(a => (a.state || 'open') === 'open' || a.state === 'doing');
  return list.sort((a, b) => {
    const ao = (a.state || 'open') === 'done' || a.state === 'dropped', bo = (b.state || 'open') === 'done' || b.state === 'dropped';
    if (ao !== bo) return ao ? 1 : -1;
    const ap = pri[a.priority] != null ? pri[a.priority] : 3, bp = pri[b.priority] != null ? pri[b.priority] : 3;
    if (ap !== bp) return ap - bp;
    const ad = a.due || '9999', bd = b.due || '9999';
    if (ad !== bd) return ad.localeCompare(bd);
    return String(b.at || '').localeCompare(String(a.at || ''));
  });
}
function actionOverdue(a){
  return (a.state || 'open') !== 'done' && a.state !== 'dropped' && a.due && a.due < todayIso();
}

function breakdownsForArea(area){ const n = String(area || '').trim().toLowerCase().replace(/\s+/g, ' ');
  return allBreakdowns().filter(b => b.area && String(b.area).trim().toLowerCase().replace(/\s+/g, ' ') === n); }
function nextBreakdownId(){ return nextIdFor('B', [S.breakdowns, COMMITTED.breakdowns]); }
function bdChip(b){ return `<span class="chip ${BD_STATUS_CHIP[b.status] || ''}">${esc(b.status)}</span> <span class="chip ${BD_CHIP[b.severity] || ''}">${esc(b.severity)}</span>`; }
/* the dialog: raise one (seeded with a reference or an area) or update one */

/* ------------------------------------------------------------------ rental contracts
   Every asset on the job belongs to a Rental ID in the Coates rental system, which carries the contract number and
   type, the customer's code and name, and the site. None of that is in any drawing or schedule, so it is typed in
   here from the rental screen (Andrew Fisher, 11 Sep 2026) and kept with the record: the contracts once each, and
   for each asset the Rental ID it belongs to. A contract can be put on every asset the register lists at once. */
const CONTRACT_FIELDS = [
  ['rental_id', 'Rental ID *', 'e.g. 9968955'], ['contract_no', 'Contract no.', 'usually the same as the Rental ID'],
  ['contract_type', 'Contract type', 'e.g. CASUAL'], ['customer_code', 'Customer code', 'e.g. V8SU0845'],
  ['customer_name', 'Customer name', 'as the rental system shows it'], ['site', 'Site', 'e.g. QLD_GOLD COAST 600'],
  ['po_no', 'PO no.', 'if there is one'], ['customer_ref', 'Customer ref.', 'if there is one']];
const ID_RE = /^[A-Z0-9][A-Z0-9-]{1,19}$/;
/* trimmed, codes and ids upper-case — one shape whoever typed it */
function normContract(c){
  const t = v => String(v == null ? '' : v).replace(/\s+/g, ' ').trim();
  const u = v => t(v).toUpperCase();
  return {rental_id: u(c.rental_id), contract_no: u(c.contract_no) || u(c.rental_id), contract_type: u(c.contract_type) || null,
          customer_code: u(c.customer_code) || null, customer_name: t(c.customer_name) || null, site: t(c.site) || null,
          po_no: t(c.po_no) || null, customer_ref: t(c.customer_ref) || null, note: t(c.note) || null};
}
function checkContract(c){
  const bad = [];
  if (!c.rental_id) bad.push('a Rental ID is needed');
  else if (!ID_RE.test(c.rental_id)) bad.push('the Rental ID should be letters, digits and dashes (2–20)');
  if (c.contract_no && !ID_RE.test(c.contract_no)) bad.push('the contract number should be letters, digits and dashes (2–20)');
  if (c.customer_code && !ID_RE.test(c.customer_code)) bad.push('the customer code should be letters, digits and dashes (2–20)');
  [['customer_name', 120], ['site', 80], ['contract_type', 30], ['po_no', 40], ['customer_ref', 60], ['note', 300]].forEach(([f, n]) => { if (c[f] && c[f].length > n) bad.push(f.replace('_', ' ') + ' is longer than ' + n + ' characters'); });
  return bad;
}
/* the contract an asset belongs to: the record here first, then what the last rebuild committed */
/* ------------------------------------------------------------------ what the rental system has on hire
   The extract Andrew Fisher supplied on 11 Sep 2026: branch code, contract, plant number, delivery number, hire
   start and off-hire day. It is a second document about the same plant, not a second opinion about the site — it
   says what is on hire, and it never says anything arrived. The lights remain the only record of that.

   A line reaches an asset or a schedule row only where the build could match it: the same plant number in both
   documents, or the same day, kind and count. `MISCITEM` is the extract's placeholder on a miscellaneous line and
   is never treated as a plant number. */
const ONHIRE = DATA.rental_on_hire || null;
const ONHIRE_ROWS = ONHIRE ? ONHIRE.rows : [];
/* when the contracts were exported — the stamp a branch or a contract taken from them carries */
const ONHIRE_AT = ONHIRE && ONHIRE.supplied_on ? new Date(ONHIRE.supplied_on + 'T00:00:00+10:00').toISOString() : null;
function onhireByNumber(no){
  const n = String(no || '').trim();
  return n ? ONHIRE_ROWS.filter(r => r.asset_no_is_plant_number && r.asset_no === n) : [];
}
function onhireForAsset(a){
  const nums = (a.asset_numbers || []);
  return ONHIRE_ROWS.filter(r => r.match && r.match.to === 'asset' && r.match.key === a.key)
    .concat(ONHIRE_ROWS.filter(r => r.asset_no_is_plant_number && nums.includes(r.asset_no)
      && !(r.match && r.match.to === 'asset' && r.match.key === a.key)));
}
function onhireForRow(taskId){
  return ONHIRE_ROWS.filter(r => r.match && r.match.task_id === taskId);
}
const ONHIRE_STATE = {
  'same asset number': {chip: 'ok', word: 'same asset number'},
  'same delivery docket': {chip: 'ok', word: 'same delivery docket'},
  'same day and kind': {chip: 'ok', word: 'same day and kind'},
  'settled by tonnage': {chip: 'ok', word: 'settled by tonnage'},
  'candidate': {chip: 'cand', word: 'candidate'},
  'ambiguous': {chip: 'crit', word: 'more than one row could be this'},
  'unmatched': {chip: '', word: 'nothing in the schedule matches it'},
};
/* one on-hire line as a sentence a person can check against the rental screen */
function onhireLine(r){
  const went = r.start_date ? `delivered ${esc(fmtDay(r.start_date).dm)}${r.start_time ? ' ' + esc(r.start_time) : ''}${r.delivery_number ? ' · docket <span class="mono">' + esc(r.delivery_number) + '</span>' : ''}`
    : r.delivery_number ? `delivery docket <span class="mono">${esc(r.delivery_number)}</span> raised${r.booked_delivery_date ? ' for ' + esc(fmtDay(r.booked_delivery_date).dm) : ''}`
    : `on the contract from ${esc(fmtDay(r.contract_start || r.start_date).dm)}`;
  return `${r.asset_no ? '<span class="mono">' + esc(r.asset_no) + '</span>' : '<span class="w" style="color:var(--mute)">no plant number on the line</span>'}${r.asset_no && !r.asset_no_is_plant_number ? ' <span class="chip" title="the contract\'s own code on a bulk or miscellaneous line — not a plant number">not a plant number</span>' : ''}
    · ${esc(r.what || r.description)}${r.quantity && r.quantity !== 1 ? ' × ' + esc(String(r.quantity)) : ''}
    · branch <b class="mono">${esc(r.branch_code)}</b> · contract <span class="mono">${esc(r.rental_contract)}</span>${r.line ? ' line ' + esc(String(r.line)) : ''}
    · ${went} · off-hire ${esc(fmtDay(r.demob_date).dm)}
    ${r.location ? '· <span class="w" style="color:var(--mute)">' + esc(r.location) + '</span>' : ''}
    ${contractMoneyWords(r)}`;
}
/* v5.81 — the line's money: the rates exactly as Baseplan exported them, under their rate type, and what the line
   CHARGES by Andrew Fisher's rule (contractCharge — by the rate, never by the prebill amount, 24 Sep 2026).
   The prebill is in the hover for comparison and nowhere else; a line whose prebill reads differently wears a
   chip that says so. A SUB item is a subhire; a transport or delivery line is a charge, not plant. */
function contractMoneyWords(r){
  const bits = [];
  const rt = r.rate_type ? ' ' + esc(String(r.rate_type)) : '';
  if (typeof r.rate_1 === 'number') bits.push('rate 1 <b>' + esc(money(r.rate_1)) + '</b>' + rt);
  if (typeof r.rate_2 === 'number') bits.push('rate 2 ' + esc(money(r.rate_2)));
  if (typeof r.rate_3 === 'number') bits.push('rate 3 ' + esc(money(r.rate_3)));
  if (typeof r.flat_monthly_charge === 'number') bits.push('flat monthly ' + esc(money(r.flat_monthly_charge)));
  const ch = contractCharge(r);
  if (typeof ch.amount === 'number') bits.push(`<b title="${esc(ch.basis + (ch.prebill != null ? ' · Baseplan prebilled ' + money(ch.prebill) : ''))}">charges ${esc(money(ch.amount))}</b> <span class="w">${esc(ch.how === 'per day' ? ch.days + ' day' + (ch.days === 1 ? '' : 's') + ' from when it went in' : ch.how === 'whole event' ? 'the whole event' : ch.how === 'charge line' ? 'a charge line' : ch.how)}</span>${ch.differs ? ` <span class="chip crit" title="${esc(ch.reads + ' — ' + money(ch.prebill) + '. Settle with the branch; the page goes by the rate.')}">prebill differs</span>` : ''}`);
  else if (typeof r.rate_1 === 'number' || r.charge_line) bits.push(`<span class="w" title="${esc(ch.basis)}">${esc(ch.how === 'no dates' || ch.how === 'no days' ? 'no days to charge — ' + ch.basis : 'no charge worked out')}</span>`);
  if (typeof r.billed_amount === 'number') bits.push('billed ' + esc(money(r.billed_amount)));
  if (typeof r.minimum_days === 'number' && r.minimum_days > 0) bits.push('min ' + esc(String(r.minimum_days)) + ' day' + (r.minimum_days === 1 ? '' : 's'));
  const chips = (r.subhired ? ` <span class="chip cand" title="${esc(r.subhire_rule || 'the item code starts with SUB')}">subhired${r.supplier_sub_rental ? ' · ' + esc(r.supplier_sub_rental) : ''}</span>` : '')
              + (r.charge_line ? ' <span class="chip" title="a transport or delivery line on the contract — a charge, not a thing on site">charge line</span>' : '');
  return `<div class="w" style="font-size:11.5px;color:var(--mute)">${bits.length ? 'On the contract: ' + bits.join(' · ') : 'On the contract: no rate on this line yet'}${chips}</div>`;
}
/* the block that hangs under a schedule row or an asset: what the rental system holds, and the offer to take the
   branch and the plant number off it. Nothing here is a record until somebody presses the button. */
function onhireBlock(rows, opts){
  if (!rows.length) return '';
  const o = opts || {};
  const st = ONHIRE_STATE[rows[0].match ? rows[0].match.state : 'unmatched'] || ONHIRE_STATE.unmatched;
  const codes = [...new Set(rows.map(r => r.branch_code))];
  const nums = rows.filter(r => r.asset_no_is_plant_number).map(r => r.asset_no);
  return `<div class="onhire">
    <div class="onhire-h">On the rental contract <span class="chip ${st.chip}">${esc(st.word)}</span>
      <span class="w" style="color:var(--mute);font-weight:400">${esc(ONHIRE.supplied_by)}, ${esc(ONHIRE.supplied_on)}</span></div>
    <ul class="onhire-l">${rows.map(r => `<li>${onhireLine(r)}</li>`).join('')}</ul>
    <p class="onhire-w">${esc(rows[0].match ? rows[0].match.basis : '')}. The branch and the contract on this line are on the asset; a delivered docket's date is the day it went (Andrew Fisher, 23 Sep 2026), and a light set on the ground overrides it.</p>
    ${(() => { if (!o.take) return ''; const have = new Set(((assetOf(o.take) || {}).asset_numbers || []).map(String)); const missing = nums.filter(x => !have.has(String(x)));
        return missing.length ? `<div class="acts"><button class="btn tiny" data-take-nos="${esc(missing.join(','))}" data-take-key="${esc(o.take)}"
        title="Put ${missing.length === 1 ? 'this plant number' : 'these plant numbers'} on ${esc(o.take)}">Add asset number${missing.length === 1 ? '' : 's'} ${esc(missing.join(', '))}</button></div>` : ''; })()}
  </div>`;
}
/* ------------------------------------------------------------------ the branch an asset belongs to
   Every asset on hire sits against a Coates branch. Nothing in the schedule, the drawings or the carrier's list
   carries a branch code, so there is nothing to derive one from: it is typed by a person, per asset, and blank
   means nobody has recorded one yet — never "Kingston because the trucks leave from there". The code is kept as
   typed (tidied to upper case), stamped like a rate so two copies of the record merge by time. */
const BRANCH_MAX = 24;
function normBranch(v){
  return String(v == null ? '' : v).toUpperCase().replace(/[^A-Z0-9 \-\/&.]/g, '').replace(/\s+/g, ' ').trim().slice(0, BRANCH_MAX);
}
/* Andrew Fisher, 12 Sep 2026: each rental contract has a branch code — and so do the VMS boards, forklifts, slippers
   and everything already turned up; the information is all there. It is: the rental extract carries a branch
   code on every line it has on hire. So a line the rental system has on hire carries that branch, credited to the
   rental system — the way its hire start counts as on site — until a person records a different one. */
function branchOf(key){
  const loc = movedAway(key) ? '' : normBranch((S.branch || {})[key] || '');
  if (loc) return {code: loc, where: 'local', at: ((S.stamps || {})['branch/' + key]) || null};
  const com = movedAway(key) ? null : (CROW.get(key) || {}).branch;
  const c = normBranch(typeof com === 'string' ? com : (com && com.code) || '');
  if (c) return {code: c, where: 'committed', at: (com && com.at) || null};
  /* THE CONTRACTS PUT THE BRANCH ON. Andrew Fisher, 23 Sep 2026, with the nine Baseplan contracts: put the branch
     codes where they belong, without asking for confirmation. pipeline/baseplan_contracts.py joins every
     asset it can to a contract — by asset number, by docket, by day, or by what the thing is — and the branch
     comes with it, credited to the rental system. A code a person records above still wins. */
  /* a reference that has been called off is out of the money and off the contracts' assignment too */
  const asg = ONHIRE && ONHIRE.assignments && !(typeof rowOff === 'function' && rowOff(key)) ? ONHIRE.assignments[key] : null;
  if (asg && normBranch(asg.branch_code)) return {code: normBranch(asg.branch_code), where: 'rental', at: ONHIRE_AT, contracts: [String(asg.rental_contract)], via: asg.via, basis: asg.basis};
  const r = typeof rentalOf === 'function' && !(typeof rowOff === 'function' && rowOff(key)) ? rentalOf(key) : null;
  if (r) { const codes = [...new Set(r.lines.map(x => normBranch(x.branch_code || '')).filter(Boolean))];
    if (codes.length === 1) return {code: codes[0], where: 'rental', at: r.from_at || null, contracts: r.contracts}; }
  return {code: null, where: null, at: null};
}
/* Put a branch code on one asset or on every asset a list names. Carries a name, like a light. */
function setBranch(keys, code, quiet){
  if (!mayWrite('the branch')) return false;
  const v = normBranch(code);
  if (code && !v) { flash('That branch code has nothing in it a code can be made of — letters, numbers, a hyphen or a slash.'); return false; }
  const who = whoAmI(); if (!who) return false;
  S.branch = S.branch || {};
  keys.forEach(k => { if (!isRef(k)) return; if (v) S.branch[k] = v; else delete S.branch[k]; stampIt('branch', k); });
  save();
  if (!quiet) flash(v ? `${keys.length} asset${keys.length === 1 ? '' : 's'} put on branch ${v} by ${who}.`
                     : `Branch taken off ${keys.length} asset${keys.length === 1 ? '' : 's'} by ${who}.`);
  return true;
}
/* Every branch code anybody has typed into this record, with how many assets carry it — the list the drawer
   offers back so the same branch is not typed three different ways. Derived from the record, never invented. */
function branchesUsed(){
  const n = new Map();
  allAssets().forEach(a => { const b = branchOf(a.key); if (b.code) n.set(b.code, (n.get(b.code) || 0) + 1); });
  return [...n.entries()].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0])).map(([code, count]) => ({code, count}));
}
/* the codes to offer back: every code typed on this record, then the branches Andrew Fisher named, each with
   its name — one list, so a branch is not typed three ways */
function branchOptions(){
  const used = branchesUsed().map(x => x.code);
  (BRANCHES.branches || []).forEach(b => { if (!used.includes(b.code)) used.push(b.code); });
  return used.map(c => `<option value="${esc(c)}">${esc(branchWords(c))}</option>`).join('');
}
/* the guide's offer for one asset, in words — never applied by itself */
function branchGuideWords(disc){
  const g = branchGuide(disc);
  if (!g.length) return '';
  return `${g.length === 1 ? 'Usually' : 'Usually one of'} ${g.map(b => `<strong class="mono">${esc(b.code)}</strong> (${esc(b.name)})`).join(' or ')} for ${esc(disc.toLowerCase())} — Andrew Fisher's guide, 12 Sep 2026; ${g.length === 1 ? 'confirm it here' : 'the rental extract has the Molendinar towers and the Phillip Park forklifts on NVAC'}.`;
}
function branchChip(key){
  const b = branchOf(key);
  if (!b.code) return '<span class="todo" title="no branch recorded for this asset">—</span>';
  const title = b.where === 'rental' ? `Branch ${b.code} — from the Coates rental contract${b.contracts && b.contracts.length ? ' ' + b.contracts.join(', ') : ''}${b.basis ? ' (' + b.basis + ')' : ''}; a code you record overrides it`
    : `Branch ${b.code} — recorded ${b.at ? fmtStamp(b.at) + ' ' : ''}${b.where === 'local' ? '(' + LW() + ')' : '(committed)'}`;
  return `<span class="chip ref mono${b.where === 'rental' ? ' hire' : ''}" title="${esc(title)}">${esc(b.code)}</span>`;
}
/* ------------------------------------------------------------------ branches, cost kinds and purchase orders
   Andrew Fisher, 12 Sep 2026: each rental contract has a branch code — the branch that gets the revenue — and each
   branch can have labour, transport, damages and subhire (subhire above all), with a data plate of all the
   branches together, so we know the whole and the breakdown too. The branches and what each usually supplies
   are as he gave them (sources/team/branches.json);
   they guide a person putting a branch on an asset and never put one on by themselves. */
const BRANCHES = DATA.branches || {branches: [], cost_kinds: []};
const COST_KINDS = (BRANCHES.cost_kinds && BRANCHES.cost_kinds.length) ? BRANCHES.cost_kinds
  : [{key: 'labour', label: 'Labour'}, {key: 'transport', label: 'Transport'}, {key: 'damages', label: 'Damages'}, {key: 'subhire', label: 'Subhire'},
     {key: 'installation', label: 'Installation'}, {key: 'consumables', label: 'Consumables'}, {key: 'other', label: 'Other'}];
const kindLabel = k => (COST_KINDS.find(x => x.key === k) || {}).label || (k ? String(k) : '—');
function branchInfo(code){ const c = normBranch(code); return (BRANCHES.branches || []).find(b => b.code === c) || null; }
function branchName(code){ const b = branchInfo(code); return b ? b.name : null; }
/* "STPS · Brisbane Traffic" — the code, and the name where Andrew gave one */
function branchWords(code){ const b = branchInfo(code); return b ? `${b.code} · ${b.name}` : (normBranch(code) || '—'); }
/* the branches his guide names for a register discipline — one, two, or none */
function branchGuide(disc){ return (BRANCHES.branches || []).filter(b => (b.groups || []).includes(disc)); }
/* the kind a cost line is, for the branch breakdown: on the line, else read off its category the way the
   expectation's words read — rehire and contractors are hired in, internal labour is labour, installation is
   installation. Anything else is 'other' until a person says. */
function costKindOf(c){
  if (c.kind && COST_KINDS.some(k => k.key === c.kind)) return c.kind;
  const cat = String(c.category || '');
  if (/internal labour/i.test(cat)) return 'labour';
  if (/rehire|contractor|fencing/i.test(cat)) return 'subhire';
  if (/installation/i.test(cat)) return 'installation';
  return 'other';
}
function costKindWhy(c){ return c.kind && COST_KINDS.some(k => k.key === c.kind) ? 'on the line' : 'read off the category'; }
/* the branch a cost line sits against: on the line, else the branch of the asset it names, else none */
function costBranchOf(c){
  const onLine = normBranch(c.branch || '');
  if (onLine) return {code: onLine, why: 'on the line'};
  if (c.ref) { const b = branchOf(c.ref); if (b.code) return {code: b.code, why: 'the branch on ' + c.ref}; }
  return {code: null, why: 'no branch on the line and none on the asset it names'};
}
/* The purchase orders: the ones supplied in the build, overlaid by anything typed on the page (the invoice number,
   a confirmed period, an amount), plus any added here. Keyed by PO number. */
const PO_SRC = DATA.purchase_orders || {orders: [], supplier: null};
function poAll(){
  const sup = PO_SRC.supplier || {};
  const out = new Map();
  (PO_SRC.orders || []).forEach(o => out.set(String(o.number), {number: String(o.number), supplier_code: sup.code || null, supplier_name: sup.name || null,
    branch: normBranch(sup.branch_code || ''), period: o.period || null, programme_sheet: o.programme_sheet || null, kind: sup.kind || 'subhire',
    invoice_no: null, amount: null, note: null, confirmed: false, _src: true, _pairing: PO_SRC.pairing || null}));
  /* the committed record's orders (the last rebuild), then this record's — the later typed value wins the field */
  const lay = (rows, where) => Object.entries(rows || {}).forEach(([no, r]) => { if (!r || typeof r !== 'object') return;
    const base = out.get(String(no)) || {number: String(no), _src: false, kind: 'subhire'};
    const m = Object.assign({}, base);
    ['supplier_code', 'supplier_name', 'branch', 'period', 'programme_sheet', 'invoice_no', 'amount', 'note', 'by', 'at', 'updated_at', 'updated_by'].forEach(f => { if (r[f] != null && r[f] !== '') m[f] = r[f]; });
    if (typeof r.confirmed === 'boolean') m.confirmed = r.confirmed;
    m.branch = normBranch(m.branch || '');
    m['_' + where] = true; out.set(String(no), m); });
  lay(COMMITTED.purchase_orders, 'committed');
  lay(S.purchaseOrders, 'local');
  return [...out.values()].filter(o => !tombedHere('po/' + o.number)).sort((a, b) => a.number.localeCompare(b.number));
}
function poOf(no){ return poAll().find(o => o.number === String(no)) || null; }
/* the cost lines that name a PO — an invoice recorded against it */
function poCostLines(no){ return allCosts().filter(c => String(c.po_no || '') === String(no)); }
function setPo(no, patch){
  if (!mayWrite('the purchase order')) return false;
  const who = whoAmI(); if (!who) return false;
  const n = String(no || '').replace(/\D/g, '');
  if (!/^\d{4,12}$/.test(n)) { flash('A purchase order number is 4 to 12 digits.'); return false; }
  S.purchaseOrders = S.purchaseOrders || {};
  const now = new Date().toISOString();
  const cur = S.purchaseOrders[n] || {number: n, by: who, at: now};
  S.purchaseOrders[n] = Object.assign({}, cur, patch, {number: n, updated_at: now, updated_by: who});
  stampIt('po', n); save();
  return true;
}
/* Everything a branch carries, as at the day: the lines put on it, their units, what is on site, hire at the card,
   the transport charge, every cost line by kind (v5.79: the fencing dockets at the crew's sheet are cost lines on
   the fencing contractor's branch, so they reach a plate through the lines like any other subhire — once; the
   separate 'derived' figure a plate used to add on top is gone with them), and its purchase orders. One function,
   read by the plates, the Costs tab, the email and the printed page, so no two of them can disagree. */
/* v5.81 — WHAT A CONTRACT LINE CHARGES, BY THE RATE. Andrew Fisher, 24 Sep 2026: forklifts, VMS and water barriers
   are charged from when they go in; everything else only over the event; go by the rate, never by the prebill
   amount — for anything that is not a VMS, forklift or water barrier, the rate is the whole-event bill for that
   item. So: a VMS, forklift or water-barrier
   line charges Rate 1 × quantity × the days from the contract's start (or its booked delivery) to its term (or
   its expected term), never fewer than the line's own minimum days; every other line charges Rate 1 × quantity,
   once, as the whole-event bill; a transport or delivery line is a charge in itself, and the amount on it is the
   charge; a line with no rate is unknown, never nought. Baseplan's prebill is kept beside the figure for
   comparison only — it is in a hover, never a headline — and a line where the two disagree is named, with what
   the prebill's arithmetic looks like, for the branch to settle. The contract's own dates are used, because the
   charge is the contract's; a light a person set on the ground is the delivery record, not the bill. */
const CONTRACT_DAILY_KINDS = new Set(['vms', 'forklift', 'barrier']);
function contractCharge(r){
  const cents = n => Math.round(n * 100) / 100;
  const q = typeof r.quantity === 'number' && r.quantity > 0 ? r.quantity : 1;
  const pre = typeof r.prebill_amount === 'number' ? r.prebill_amount : null;
  const out = {amount: null, basis: '', how: null, days: null, prebill: pre, differs: false, reads: '', daily: CONTRACT_DAILY_KINDS.has(r.kind)};
  if (r.charge_line) { out.amount = pre; out.how = 'charge line'; out.basis = pre != null ? 'a transport or delivery charge line — the amount on it is the charge' : 'a charge line with no amount on it yet'; return out; }
