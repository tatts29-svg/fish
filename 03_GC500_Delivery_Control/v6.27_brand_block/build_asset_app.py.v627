function foldContents(key, accessories, units){
  const out = (accessories || []).map(x => Object.assign({}, x));
  const numbered = () => new Map(out.filter(x => x.asset_no).map(x => [String(x.asset_no).trim(), x]));
  const openOfType = (t, notThis) => out.find(y => y !== notThis && !y.asset_no && sameType(y.type, t) && (y.qty || 1) > 0);
  /* 1. a numbered accessory added here identifies the schedule's unnumbered one of the same type — one thing */
