function moveRecord(from, to){
  if (!mayWrite('a move')) return false;
  from = String(from || '').trim().toUpperCase(); to = String(to || '').trim().toUpperCase();
  if (!isRef(from) || !isRef(to)) { flash('Both ends of a move have to be references on this job — nothing moved.'); return false; }
  if (from === to) { flash('That is the same reference — nothing moved.'); return false; }
  const who = whoAmI(); if (!who) return false;
  if (movedAway(from)) { flash(from + ' has already been moved to ' + movedAway(from).to + ' — nothing to move.'); return false; }
  const returning = movedAway(to) && movedAway(to).to === from;   // the way back: the target is where this record came from
  if (movedAway(to) && !returning) { flash(to + ' was itself moved to ' + movedAway(to).to + ' — move to where that record is now, or put it back first.'); return false; }
  const carries = recordOn(to);
  if (carries.length) { flash(to + ' already carries ' + carries.join(', ') + '. A move never writes over a record — set ' + to + '\'s aside or pick another reference. Nothing moved.'); return false; }
  const now = new Date().toISOString();
  const fromRow = CROW.get(from) || {};
  const J = v => JSON.parse(JSON.stringify(v));
  /* the light, its history and the ticks — this browser's copy, else the committed one */
  const dl = (S.delivery || {})[from], dc = fromRow.delivery;
  let d = dl ? J(dl) : (dc && dc.recorded ? J(dc) : null);
  if (d) {
    delete d.rescheduled; delete d.light;
    d.history = (Array.isArray(d.history) ? d.history : []).concat([{state: d.state || 'on site', at: now, by: who, note: 'moved from ' + from}]);
    S.delivery = S.delivery || {}; S.delivery[to] = d;
  }
  /* what turned up: the supplied record, item by item, with the numbers on the machines */
  const sl = (S.supplied || {})[from] || null;
  /* what turned up is recorded against what the SOURCE asked for; on the target it is recorded against what the
     TARGET asks for — the same asked item where the target has it, else its one item, else the first — and the
     wording of what was supplied travels unchanged, so a 6m that stood on a 4.8m line is still a 6m */
  const srcItems = itemRows(assetOf(from) || {key: from, item_types: []}).filter(r => r.supplied);
  const toAsked = ((assetOf(to) || {}).item_types || []);
  const items = srcItems.map(r => { const asked = toAsked.includes(r.asked) ? r.asked : (toAsked[0] || r.asked);
    return {asked, supplied: r.supplied, qty_asked: r.qty_asked == null ? null : r.qty_asked, qty_supplied: r.qty_supplied == null ? null : r.qty_supplied,
