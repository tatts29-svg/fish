   the sheet's key), or a file in the service's document library (kind 'file', the file's id — a map uploaded on
   the admin page or the Documents tab, filed against this reference or not). The record holds the pointer and the
   name, so the drawer and the drop sheet can say which map even if the library changes. */
function setMapRef(key, id, name, kind){
  if (!mayWrite('the map on a reference')) return false;
  if (!isRef(key)) { flash(String(key || '') + ' is not a reference in this file — nothing recorded.'); return false; }
  const who = whoAmI(); if (!who) return false;
  S.mapRef = S.mapRef || {};
  const v = String(id || '').trim();
  const had = S.mapRef[key] || null;
  if (!v) { if (!had) return false; delete S.mapRef[key]; }
  else { if (had && had.id === v && had.kind === kind) return false;
    S.mapRef[key] = {id: v, name: String(name || v).slice(0, 160), kind: kind === 'file' ? 'file' : 'sheet', by: who, at: new Date().toISOString()}; }
  stampIt('mapRef', key, who); bump();
