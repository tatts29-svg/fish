      if (l.quantity != null && !(typeof l.quantity === 'number' && Number.isFinite(l.quantity) && l.quantity >= 0)) bad.push(a.key + ' charge line #' + (n + 1) + ' has a quantity that is not a number');
      text(l.item, a.key + ' charge line #' + (n + 1) + ' item'); text(l.discipline, a.key + ' charge line #' + (n + 1) + ' trade'); });
    if (!day(a.first_date) || !day(a.last_date)) bad.push(a.key + ' has a date that is not a day');
    else if (a.first_date && a.last_date && a.last_date < a.first_date) bad.push(a.key + ' has a last day before its first day'); });
  const ids = new Set();
  const nonneg = v => v == null || v === '' || (typeof v === 'number' && Number.isFinite(v) && v >= 0) || (typeof v === 'string' && v.trim() !== '' && Number.isFinite(Number(v)) && Number(v) >= 0);
  ['variances', 'fenceDockets', 'breakdowns', 'costs'].forEach(k => (Array.isArray(rec[k]) ? rec[k] : []).forEach((x, i) => {
    if (!isObj(x) || typeof x.id !== 'string' || !x.id.trim()) { bad.push(k + ' #' + (i + 1) + ' has no id'); return; }
    if (ids.has(k + '/' + x.id)) bad.push(k + ' ' + x.id + ' appears twice'); ids.add(k + '/' + x.id);
    Object.entries(x).forEach(([f, v]) => { if (typeof v === 'string') text(v, k + ' ' + x.id + ' ' + f); });
    if (k === 'fenceDockets' && !day(x.date)) bad.push('docket ' + x.id + ' has a date that is not a day');
    if (k === 'breakdowns' && (!iso(x.at) || !iso(x.updated_at) || !iso(x.resolved_at))) bad.push('breakdown ' + x.id + ' has a time that is not a timestamp');
    if (k === 'costs' && x.side === 'ours') {
