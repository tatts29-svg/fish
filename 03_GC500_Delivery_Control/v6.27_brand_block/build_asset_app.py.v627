    out.days = days; out.amount = cents(r.rate_1 * q * days); out.how = 'per day';
    out.basis = `${money(r.rate_1)} a day${q !== 1 ? ' × ' + q : ''} × ${days} day${days === 1 ? '' : 's'} — ${fmtDay(from).dm} to ${fmtDay(to).dm}${r.term_date ? ' (off-rented)' : ' (expected term)'}${min > span ? ', lifted to the line\'s minimum of ' + min : ''} — from when it went in`;
  } else {
