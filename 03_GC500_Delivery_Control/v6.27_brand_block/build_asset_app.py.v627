function photoBlock(r, ph, what){
  if (r.state === 'ambiguous') return `<div class="dphgone ambiguous" role="img" aria-label="Photograph association needs review">
    <b>Photograph needs review</b><span>More than one service file matches this stored pointer. No picture has been selected.</span>
    <span class="w">Check the original and confirm its exact file ID against this drop.</span></div>`;
  if (r.state === 'checking') return `<div class="dphgone checking" role="img" aria-label="Checking whether this photograph is on the service">
    <b>Checking availability…</b>
    <span>Asking the service what it holds for ${esc(what || 'this drop')}.</span></div>`;
  if (r.state === 'unchecked') return `<div class="dphgone unchecked" role="img" aria-label="Unable to check this photograph">
    <b>Unable to check photograph</b>
    <span>The service did not answer${r.why ? ': ' + esc(String(r.why).slice(0, 80)) : ''}. This does <b>not</b> mean the photograph is missing — it means nobody could ask.</span>
    <span class="w">Try again when the service is back.</span></div>`;
