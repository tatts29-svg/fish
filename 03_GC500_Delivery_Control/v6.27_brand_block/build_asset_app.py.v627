def gc3d_bundle() -> str:
    """The 3D scene, one script (print/web/gc3d_bundle.js from print/gc3d/src/), inlined after the showcase's
    own script so the file edition still opens from file://. Empty when the scene source is not in the package."""
    f = ROOT / 'print/web/gc3d_bundle.js'
    if not f.exists() and (ROOT / 'print/gc3d/src').is_dir():
        subprocess.run([sys.executable, str(ROOT / 'pipeline/gc3d/build_bundle.py')], check=True)
    return f.read_text(encoding='utf-8') if f.exists() else ''


def geo_runtime() -> str:
    """Astra's geospatial showcase runtime, inlined (print/web/gc500_runtime.js).

    It arrives as an ES module and cannot be inlined as one — the file edition opens from file:// with no
    module loader and no server — so pipeline/gc3d/build_geo_runtime.py replaces its export list, by name, with
    one global and changes nothing else. That step also refuses to build if the bundle ever carries an address
    it has not been told about, because a hard-coded outside origin is how a CDN or a map provider gets into a
    file that is supposed to work with nothing behind it.

    Empty when the supplied runtime is not in this tree, and then no geospatial backdrop is offered at all.
    """
    f = ROOT / 'print/web/gc500_runtime.js'
    if not f.exists() and (ROOT / 'sources/showcase/geospatial_runtime/gc500-runtime.js').is_file():
        subprocess.run([sys.executable, str(ROOT / 'pipeline/gc3d/build_geo_runtime.py')], check=True)
    return f.read_text(encoding='utf-8') if f.exists() else ''


