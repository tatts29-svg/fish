  if (!isObj(rec)) return ['not a records file (an object is expected)'];
  const known = ['operator', 'added', 'accessories', 'assetNumbers', 'notes', 'rates', 'accRates', 'fenceRates', 'fenceCosts', 'weeks', 'supplied', 'variances', 'fenceDockets', 'fenceQuote', 'fenceDone', 'deleted', 'breakdowns', 'delivery', 'stamps', 'saved', 'changes', 'lastExport', 'lastImport', 'syncId', 'contracts', 'rental', 'branch', 'loads', 'costs', 'purchaseOrders', 'crew', 'locations', 'descs', 'items', 'qtys', 'aside', 'moves', 'hireStart', 'mapRef', 'by', 'dropPhotos', 'units', 'docketPapers', 'actions', 'schema', 'labour', 'eventHours', 'minDays', 'fixes', 'entries', 'places', 'givenRefs'];
  /* v5.51 — the live map's key never travels in a record file (see LIVEMAP): one that arrives in an import is
