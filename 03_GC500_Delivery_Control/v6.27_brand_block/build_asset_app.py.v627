/* the one control for a move: which reference it goes to, picked from every reference on the job */
function moveDialog(from){
  if (!mayWrite('a move')) return;
  const who = whoAmI(); if (!who) return;
  const a = assetOf(from); if (!a) return;
  const refs = allAssets().filter(x => x.key !== from).map(x => x.key).sort((x, y) => x.localeCompare(y, undefined, {numeric: true}));
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', 'Move the record on ' + from);
  const carries = recordOn(from);
  d.innerHTML = `
   <div class="dh"><div><h2>Move what was recorded against ${esc(from)}</h2>
     <div class="sub">${esc(a.name || '')} · ${esc(a.discipline || '')}</div></div>
     <button class="close" id="mvClose" aria-label="Close" title="Close">&times;</button></div>
   <div class="db"><div class="form">
    <p class="hint">${carries.length ? 'On ' + esc(from) + ' now: ' + esc(carries.join(', ')) + '.' : 'Nothing has been recorded against ' + esc(from) + ' yet — there is nothing to move.'}</p>
    <div class="f"><label for="mvTo">To which reference</label><select id="mvTo"><option value="">— pick the reference —</option>${refs.map(k => { const x = assetOf(k); return `<option value="${esc(k)}">${esc(k)}${x && x.name ? ' · ' + esc(x.name) : ''}</option>`; }).join('')}</select></div>
    <div class="notice info"><b>What moves, and what stays.</b> The light and its history, the ticks, what turned up and the numbers on it, the things inside, accessories added here, the note, the branch, the Rental ID, the weeks, the hire start and the labour ticks go to the reference you pick. The schedule's own row, callout and allocated numbers, the photographs of the place, the map on the place, and any variance, breakdown, cost or action stay on ${esc(from)} — each of those has a reference box of its own. ${esc(from)} will say where its record went, with your name and the time, and the move can be made back the same way. Nothing is renamed and nothing is deleted.</div>
   </div></div>
   <div class="df"><button class="btn primary" id="mvGo" ${carries.length ? '' : 'disabled'}>Move it</button><button class="btn" id="mvCancel">Cancel</button></div>`;
  mounted(document.body.appendChild(d));
  const shut = () => { d.remove(); render(); };
  $('#mvClose', d).onclick = shut; $('#mvCancel', d).onclick = shut;
  d.addEventListener('keydown', e => { if (e.key === 'Escape') shut(); });
  $('#mvGo', d).onclick = () => { const to = $('#mvTo', d).value; if (!to) { flash('Pick the reference it goes to.'); return; }
    if (moveRecord(from, to)) { d.remove(); openAsset(to); } };
}
function asideWords(e){
  const r = e.rec || {}, c = e.coll;
  const what = c === 'costs' ? 'cost line' : c === 'variances' ? 'variance' : c === 'fenceDockets' ? 'fencing docket'
    : c === 'breakdowns' ? 'breakdown' : c === 'actions' ? 'action' : c === 'added' ? 'added asset' : c;
  const desc = r.description || r.reason || r.title || r.what || r.name || r.text || r.note || '';
