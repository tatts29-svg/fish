/* add or edit a contract; onDone(rental_id) after a save */
function contractDialog(editId, onDone){
  const editing = editId ? ((S.contracts || {})[editId] || allContracts().find(c => c.rental_id === editId)) : null;
  const seed = editing ? Object.assign({}, editing) : {};
  const d = document.createElement('div');
  d.className = 'drawer on'; d.style.zIndex = 30; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-label', editing ? 'Update rental contract ' + editing.rental_id : 'Add a rental contract');
