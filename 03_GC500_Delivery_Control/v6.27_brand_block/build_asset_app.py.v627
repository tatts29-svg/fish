document.addEventListener('error', e => photoImageFailed(e.target), true);
/* ------------------------------------------------------------------ opening and closing the phone's search
   V11 audit: on a phone the search could be opened and then not got out of. Clearing the box left it open;
   Escape did nothing; there was no visible way back. The only exit was finding something and going to it.

   One function closes it, and everything that should close it calls that one: the Close button, Escape, a
   successful navigation, and pressing the magnifier again. It puts the focus back where it came from, so a
   person on a keyboard is not dropped at the top of the document. */
let SEARCH_FROM = null;
function openSearch(on){
  const was = document.body.classList.contains('search-open');
  document.body.classList.toggle('search-open', on);
  const sb = $('#searchBtn'); if (sb) sb.setAttribute('aria-expanded', String(!!on));
  if (on && !was) SEARCH_FROM = document.activeElement;
  if (on) { const q = $('#q'); if (q) { q.focus(); q.select(); } }
}
function closeSearch(opts){
  const o = opts || {};
  if (!document.body.classList.contains('search-open') && !o.always) { finderClose(); return; }
  document.body.classList.remove('search-open');
  const sb = $('#searchBtn'); if (sb) sb.setAttribute('aria-expanded', 'false');
  finderClose();
  if (!o.keepQuery) { const q = $('#q'); if (q && q.value) { q.value = ''; state.q = ''; const x = $('#qx'); if (x) x.hidden = true; } }
  /* back where they were, not the top of the page */
  const back = o.focus || SEARCH_FROM || $('#searchBtn');
  SEARCH_FROM = null;
  if (back && back.isConnected && !o.noFocus) { try { back.focus(); } catch (e) {} }
}
$('#searchBtn').onclick = () => { if (document.body.classList.contains('search-open')) closeSearch(); else openSearch(true); };
$('#searchClose').onclick = () => closeSearch();
