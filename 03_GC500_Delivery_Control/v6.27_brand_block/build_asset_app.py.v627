const DROP_UPLOADS = new Set();
async function dropPhotoAdd(key, slot, file, say, unit){
  const id = key + '|' + unitKey(unit) + '|' + slot;
  if (DROP_UPLOADS.has(id)) return (say || flash)('That photograph is already uploading.');
  DROP_UPLOADS.add(id);
