/* one line where the rule and Baseplan's prebill disagree, in a breath, for the list the branch settles from */
function contractDiffWords(x){
  return `${x.branch || ''} contract ${x.contract} line ${x.line} — ${x.item ? x.item + ' ' : ''}${x.description || ''}${x.qty && x.qty !== 1 ? ' × ' + x.qty : ''}: by the rule ${money(x.charge)} (${x.basis}); ${x.reads} — ${money(x.prebill)}`;
}
function contractRowsByBranch(){
  const m = new Map();
  ONHIRE_ROWS.forEach(r => { const k = normBranch(r.branch_code || ''); if (!m.has(k)) m.set(k, []); m.get(k).push(r); });
  return m;
}
/* one subhire or charge line, said in a breath: "SUB-2131 refrigerated container 6.0 m × 2.4 m — $1,428.00 by the rate, contract 9974042" */
function contractItemWords(x){
  return `${x.item ? x.item + ' ' : ''}${x.description || ''}${x.qty && x.qty !== 1 ? ' × ' + x.qty : ''} — ${typeof x.charge === 'number' ? money(x.charge) + (x.how === 'charge line' ? '' : x.how === 'per day' ? ' by the rate (' + x.days + ' day' + (x.days === 1 ? '' : 's') + ')' : ' by the rate') : typeof x.rate_1 === 'number' ? money(x.rate_1) + ' rate 1' + (x.rate_type ? ' (' + x.rate_type + ')' : '') + ' — no charge worked out' : 'no figure on the line'}${x.supplier ? ' · ' + x.supplier : ''}, contract ${x.contract} line ${x.line}`;
}
function branchRollup(asOf, X){
  if (X !== undefined) return branchRollup_(asOf, X);   /* a roll-up over a chosen set is not remembered */
  const mk = 'rollup:' + (asOf || ''); if (RENDER_MEMO.has(mk)) return RENDER_MEMO.get(mk); const v = branchRollup_(asOf); RENDER_MEMO.set(mk, v); return v; }
function branchRollup_(asOf, X){
  X = X || dsnState(asOf);
  const rows = X.rows;
  const byCode = new Map();
  const get = code => { const k = code || ''; if (!byCode.has(k)) byCode.set(k, {code: code || null, name: branchName(code), info: branchInfo(code),
    /* every kind is on every group from the moment the group exists — a cost with no branch used to be the first
       thing to make the "no branch" group once every line carried one (v5.78), and it fell over on kinds[k] */
    lines: [], hire: 0, transport: 0, costs: [], kinds: Object.fromEntries(COST_KINDS.map(x => [x.key, {amount: 0, hours: 0, lines: 0}])), spend: 0, hours: 0, pos: [], contracts: new Set(), groups: new Map()});
    return byCode.get(k); };
  (BRANCHES.branches || []).forEach(b => get(b.code));
  rows.forEach(r => { const b = branchOf(r.a.key); const g = get(b.code);
    g.lines.push(r); g.hire += r.t.known || 0; g.transport += r.t.transport || 0;
    if (b.where === 'rental') g.fromRental = (g.fromRental || 0) + 1;
    const c = contractOf(r.a.key); if (c.id) g.contracts.add(c.id);
    (b.contracts || []).forEach(x => g.contracts.add(x));
    const d = r.a.discipline; const gg = g.groups.get(d) || {lines: 0, asked: 0, on: 0, onLines: 0, rows: []}; gg.lines++; gg.rows.push(r);
    gg.asked += r.asked; gg.on += r.unitsOn; if (r.on) gg.onLines++; g.groups.set(d, gg); });
  allCosts().filter(c => c.usable && (!asOf || asOf >= todayIso() || (c.date || '') <= asOf)).forEach(c => {
    const g = get(costBranchOf(c).code), k = costKindOf(c);
    g.costs.push(c); g.kinds[k].lines++; g.kinds[k].amount += c.amount || 0; g.kinds[k].hours += (c.hours || 0) + (c.overtime_hours || 0);
    g.spend += c.amount || 0; g.hours += (c.hours || 0) + (c.overtime_hours || 0); });
  /* the fencing contractor's branch gets its plate even before a docket lands on it */
  const sup = PO_SRC.supplier || {};
  if (sup.branch_code) get(sup.branch_code);
  poAll().forEach(o => get(o.branch).pos.push(o));
  /* v5.81 — the contracts' own money, by the branch on the contract tab; a branch the contracts name gets a plate */
  const CR = contractRowsByBranch();
  CR.forEach((rows, code) => { if (code) get(code); });
  byCode.forEach((g, k) => { g.contract = contractFigures(CR.get(k) || []); (g.contract.contracts || []).forEach(c => g.contracts.add(c)); });
  /* v5.81 — our own costs, by the branch typed on the line (a cost line names its branch itself); a branch with a
     cost on it gets a plate, and a line with no branch goes to the no-branch group so it is never lost */
  const OC = ourCosts().filter(c => c.kind === 'transport');   /* only transport of ours carries a branch; the tracker's lines are the job's */
  OC.forEach(c => get(normBranch(c.branch || '') || null));
  byCode.forEach((g, k) => { const mine = OC.filter(c => (normBranch(c.branch || '') || '') === k); g.ours = {transport: ourTotals(mine.filter(c => c.kind === 'transport')), lines: mine}; });
  const list = [...byCode.values()].map(g => Object.assign(g, {
    contracts: [...g.contracts].sort(), unitsOn: g.lines.reduce((s, r) => s + r.unitsOn, 0), onLines: g.lines.filter(r => r.on).length,
    asked: g.lines.reduce((s, r) => s + r.asked, 0),
    invoiced: g.pos.filter(o => o.invoice_no || poCostLines(o.number).length).length,
