        extra.rental.includes(n) ? ['the rental system'] : [])])),
      _locationMoved: moved ? {to: moved, from: asPlanned.find(l => l && l !== a.key) || null,
                               at: (S.stamps || {})['locations/' + a.key] || null,
                               by: ((S.by || {})['locations/' + a.key]) || null} : null,
      _addedAccessories: own.length, _addedNumbers: nums.length,
      /* CANCELLED IS A STATE, NOT AN ABSENCE. Andrew Fisher, 15 Sep 2026: P27 and P29, due the next day, were
