  col(g => g.spend, (g, v) => g.spend0 = v);
  COST_KINDS.forEach(k => col(g => g.kinds[k.key].amount, (g, v) => g.kinds[k.key].amount0 = v));
  list.forEach(g => { g.total0 = g.hire0 + g.transport0; g.out0 = g.spend0; });
  /* v5.81 — the contracts column and our transport column are split to the dollar the same way, so each adds to its total row */
  col(g => g.contract.charge, (g, v) => g.contract.charge0 = v);
  col(g => g.ours.transport.amount, (g, v) => g.ours.transport.amount0 = v);
  /* v5.83 — what each branch charges the V8s, on the one basis the headline uses: its contract lines by the rate and
     the charge lines on the record by kind (the fencing dockets at the 2026 card among them). The two columns are
     already split to the dollar, so their sum adds across the branches to the all-branches figure exactly. The hire
     and transport at the card (hire0, transport0) stay on the roll-up as the comparison, never as a charge. */
  list.forEach(g => { g.charged = cents((g.contract.charge || 0) + (g.spend || 0)); g.charged0 = g.contract.charge0 + g.spend0; });
  all.charged = cents((all.contract.charge || 0) + (all.spend || 0));
  all.charged0 = list.reduce((s, g) => s + g.charged0, 0);
  all.contract.charge0 = list.reduce((s, g) => s + g.contract.charge0, 0);
  all.ours.transport.amount0 = list.reduce((s, g) => s + g.ours.transport.amount0, 0);
  all.hire0 = list.reduce((s, g) => s + g.hire0, 0); all.transport0 = list.reduce((s, g) => s + g.transport0, 0);
  all.spend0 = list.reduce((s, g) => s + g.spend0, 0);
