      if (vs.length === 1) { out[field].push(vs[0].x); if (vs[0].fromB) rep[counter]++; return; }
      vs.sort((p, q) => J(p.x).localeCompare(J(q.x)));
      vs.forEach(v => { const copy = Object.assign({}, v.x, {id: base + '·' + h4(J(v.x))}); out[field].push(copy); if (v.fromB) rep[counter]++; });
      rep.clashes.push(`${base} is in both copies with different content — both kept, as ${vs.map(v => base + '·' + h4(J(v.x))).join(' and ')}`); }); };
  union('variances', 'variances');
