    const ticked = info.lines.filter(x => x.ticked);
    if (!ticked.length) return {total: 0, ticked: [], info: info, blocked: false, units: []};
    const unpriced = ticked.filter(x => x.money !== 'rate' && x.money !== 'zero' && x.money !== 'included');
    if (unpriced.length) return {total: null, ticked: ticked, info: info, blocked: true, units: [],
                                 why: 'ticked work the card carries no figure for: ' + unpriced.map(x => x.name).join(', ')};
    if (qty == null) return {total: null, ticked: ticked, info: info, blocked: true, units: [],
                             why: 'this line has no readable quantity, so labour on it cannot be worked out'};
