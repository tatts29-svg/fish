    const la = typeof a.levelled === 'boolean' ? {levelled: a.levelled, levelled_by: a.levelled_by, levelled_at: a.levelled_at} : null;
    const lb = typeof b.levelled === 'boolean' ? {levelled: b.levelled, levelled_by: b.levelled_by, levelled_at: b.levelled_at} : null;
