    const H = hist(a.history, b.history, h => h.state + '|' + h.at); if (H.length) m.history = H;
    const DH = hist(a.done_history, b.done_history, h => h.done + '|' + h.at); if (DH.length) m.done_history = DH;
    const LH = hist(a.levelled_history, b.levelled_history, h => h.levelled + '|' + h.at); if (LH.length) m.levelled_history = LH;
    const PH = hist(a.steps_history, b.steps_history, h => h.steps + '|' + h.at); if (PH.length) m.steps_history = PH;
    if (!deliveryEmpty(m)) out.delivery[k] = m; });
  /* a fencing area's tick: the later wins */
  out.fenceDone = {};
  keysOf(A.fenceDone, B.fenceDone).forEach(k => { const a = (A.fenceDone || {})[k], b = (B.fenceDone || {})[k];
    const r = pick(`fencing area ${k} tick`, a, a && a.at, b, b && b.at, 'dockets'); if (r.v) out.fenceDone[k] = r.v; });
  /* the fencing quote: one record, the later dated wins */
