    const a = (A.breakdowns || []).find(x => x.id === id), b = (B.breakdowns || []).find(x => x.id === id);
    const r = pick(`${id} (breakdown)`, a, a && a.updated_at, b, b && b.updated_at, 'breakdowns'); if (r.v) out.breakdowns.push(r.v); });
  /* actions: the same — two people can both pick one up, and the later update is the one that stands */
