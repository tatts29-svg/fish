  Object.entries(isObj(rec.rental) ? rec.rental : {}).forEach(([k, v]) => { if (typeof v !== 'string' || !ID_RE.test(v)) bad.push('Rental ID of ' + k + ' is not a Rental ID'); });
  Object.entries(isObj(rec.loads) ? rec.loads : {}).forEach(([id, r]) => {
    if (!isObj(r)) { bad.push('load ' + id + ' is not an object'); return; }
