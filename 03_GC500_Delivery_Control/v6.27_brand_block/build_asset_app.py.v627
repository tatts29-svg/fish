    return json.loads(f.read_text(encoding='utf-8'))


def geo_frame_payload() -> dict | None:
    """The transform that puts the surroundings pack into the geospatial runtime's own metres.

    It is not derived here. Astra's runtime ships schematic-registration.json, whose recorded source hashes are
    this package's `print/surrounds_pack.json`, `print/circuit_keyplan.json` and `print/gc3d_registration.json`
    byte for byte — so both sides are working from the same registration, and this carries its constants across
    rather than re-deriving numbers that would then be free to drift. The hashes are checked on every build: a
    pack rebuilt without the runtime being re-registered stops being silently compatible and says so.

    What travels is the formula's constants and its limitations, never a claim of survey accuracy. The
    registration is a schematic one and the file says so in its own words, which are carried with it.
    """
    f = ROOT / 'sources/showcase/geospatial_runtime/schematic-registration.json'
    if not f.is_file():
        return None
    reg = json.loads(f.read_text(encoding='utf-8'))
    tr = reg.get('transform') or {}
    # Only the files that DEFINE the frame are checked. The registration also lists the TomTom snapshot among
    # the files it read, and that one is a dated record of what the roads were doing — it moves whenever the
    # snapshot is retaken (it moved on 21 Sep 2026 when a lookup taken from a wrong position was withdrawn) and
    # it has no bearing on where a building sits. Treating it as part of the frame would mean a traffic refresh
    # silently disabling the backdrop, which is a false alarm of exactly the kind that teaches people to ignore
    # alarms. The three that do define it are the pack, the key plan and the registration.
    FRAME_FILES = ('print/surrounds_pack.json', 'print/circuit_keyplan.json', 'print/gc3d_registration.json')
    stale = []
    for rel, want in (reg.get('source_files') or {}).items():
        if rel not in FRAME_FILES:
            continue
        p_ = ROOT / rel
        got = hashlib.sha256(p_.read_bytes()).hexdigest() if p_.is_file() else None
        if got != want:
            stale.append({'file': rel, 'registered': want[:16], 'now': (got or 'missing')[:16]})
    return {
        'unit': tr.get('unit'), 'origin': tr.get('origin'), 'ring_centre_pt': tr.get('ring_centre_pt'),
        'metres_per_point': tr.get('metres_per_point'), 'formula': tr.get('formula'),
        'new_geographic_fit': tr.get('new_geographic_fit'),
        'registration': {k: reg.get('registration', {}).get(k) for k in ('s', 'th_deg', 'trimmed_mean_m', 'p95_m', 'max_m')},
        'limitations': reg.get('limitations'),
        # empty on a build where the pack and the registration still agree; a list when they no longer do, and
        # the backdrop refuses to place anything rather than place it on a frame nobody has checked
        'sources_changed': stale,
        'basis': ('Registered schematic, not survey. The circuit and its surroundings are placed by the key-plan '
                  'registration in print/gc3d_registration.json; no new geographic fit was made for the '
                  'showcase, and nothing here is a Coates asset position.'),
    }


